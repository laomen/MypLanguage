// test.myp — mypview M3 验收测试：事件 → mapping → 绑定 → 文本更新
//
// 注意：mapping 目标实例（__myp_inst_TestApp）在 main 创建 TestApp 之后才
// 注册，因此事件触发必须放在构造完成后（真实 counter 在事件循环里触发，
// 本测试用一个 Driver 类在 TestApp 注册后调用 fire()）。

import env;
import "../src/core.myp";
import "../src/widgets.myp";
import "../src/layout.myp";
import "../src/binding.myp";

class TestApp {
    action:
        @constructor TestApp() {
            label = new Label("Count: 0");
            button = new Button("+1");
            counter = new Counter(0);
            bind = new Binding(counter, label);
        }

        // 在实例注册后由 Driver 调用：模拟两次点击 → 绑定泵 → 打印
        void fire() {
            button.key(13);   // 回车
            button.key(32);   // 空格
            int up = bind.pump();
            Console.writeString("label=");
            Console.writeString(label.getText());
            Console.writeLine("");
            Console.writeString("counter=");
            Console.write(counter.get());
            Console.writeLine("");
            Console.writeString("updates=");
            Console.write(up);
            Console.writeLine("");
        }

        // 由 mapping 接入
        void onIncrement() {
            counter.set(counter.get() + 1);
        }

    property:
        Label label;
        Button button;
        Counter counter;
        Binding bind;
}

// 构造器接收 TestApp，在其注册后触发事件（main 内先建 TestApp 再建 Driver）
class Driver {
    action:
        @constructor Driver(TestApp app) {
            app.fire();
        }
}

mapping() {
    Button.clicked -> TestApp.onIncrement;
}

int main() {
    TestApp a = new TestApp();
    Driver d = new Driver(a);
    return 0;
}
