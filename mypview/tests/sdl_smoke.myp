// sdl_smoke.myp — mypview M5 无头冒烟测试
//
// 打开 SDL 窗口（dummy 驱动下用软件渲染），画 30 帧组件树后退出。
// 非交互：无需键盘，直接验证 SdlRenderer + 5×7 字体 + 布局在 SDL 后端可用。
//
// 运行: SDL_VIDEODRIVER=dummy ./build/mypc -O2 mypview/tests/sdl_smoke.myp -o /tmp/sdl_smoke && SDL_VIDEODRIVER=dummy /tmp/sdl_smoke
// 期望输出: SDL SMOKE OK

import env;
import sdl;
import "../src/core.myp";
import "../src/sdlrender.myp";
import "../src/widgets.myp";
import "../src/layout.myp";

class SdlSmokeApp {
    action:
        @constructor SdlSmokeApp() {
            // 组件树：标题 + 两行 Label + 按钮（+ 未接线的计数按钮）
            root = new Box();
            Label title = new Label("SDL SMOKE");
            Label a = new Label("line one");
            Label b = new Label("line two");
            Button btn = new Button("[ OK ]");
            root.add(title);
            root.add(a);
            root.add(b);
            root.add(btn);

            // SDL 窗口渲染
            r = new SdlRenderer("mypview smoke", 480, 360);
            root.layout(12, 8, 36, 8);

            int f = 0;
            while (f < 30) {
                r.clear();
                root.draw(r);
                r.flush();
                SDL.delay(16);
                f = f + 1;
            }
            // 保存最后一帧用于可视化验证（调试用）
            int saved = SDL.saveBmp("/tmp/sdl_smoke.bmp");
            SDL.close();
            if (saved == 0) Console.writeLine("SDL SMOKE OK (saved)");
            else Console.writeLine("SDL SMOKE OK (no save)");
        }

    property:
        Box root;
        SdlRenderer r;
}

int main() {
    SdlSmokeApp a = new SdlSmokeApp();
    return 0;
}
