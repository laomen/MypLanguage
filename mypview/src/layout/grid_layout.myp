// grid_layout.myp — uikit 布局：GridLayout（网格布局）
// ---------------------------------------------------------------------------
// 按固定列数把子控件排成网格（如 4×4）。两种格子尺寸模式：
//   - 自动模式：由 (w,h,cols,rows,padding,spacing) 等分计算每格尺寸
//   - 固定模式：setFixedCell(cw,ch) 指定每格尺寸（与数据源坐标严格一致，
//     如桌面图标网格用 Launcher 计算的 cellW/cellH），spacing 作为格间距
// 布局也是 View（可嵌套）：draw 遍历子控件、onTouch 从后往前命中分发。
// 纯逻辑，不依赖 SDL，可 headless 测试（tests/grid_layout_logic.myp）。
class GridLayout {
    interface class View;

    property:
        int x_;
        int y_;
        int w_;
        int h_;
        int cols_;           // 固定列数
        int padding_;
        int spacing_;
        int fixedW_;         // 固定格子宽（0=自动等分）
        int fixedH_;         // 固定格子高（0=自动等分）
        int cellW_;          // 布局后实际格子宽（自动/固定模式均记录）
        int cellH_;          // 布局后实际格子高
        View[] kids_;
        int kidCount_;

    action:
        @constructor GridLayout(int cols, int w, int h) {
            cols_ = cols;
            w_ = w;
            h_ = h;
            padding_ = 8;
            spacing_ = 8;
            fixedW_ = 0;
            fixedH_ = 0;
            cellW_ = 0;
            cellH_ = 0;
            kids_ = new View[128];
            kidCount_ = 0;
        }

        void setPadding(int p) { padding_ = p; }
        void setSpacing(int s) { spacing_ = s; }
        int getPadding() { return padding_; }
        // 布局后格子尺寸（自动模式计算值 / 固定模式固定值）
        int cellWidth() { return cellW_; }
        int cellHeight() { return cellH_; }
        // 固定格子尺寸（0=自动等分）
        void setFixedCell(int cw, int ch) { fixedW_ = cw; fixedH_ = ch; }
        int fixedW() { return fixedW_; }
        int fixedH() { return fixedH_; }

        void add(View v) {
            if (kidCount_ >= 128) return;
            kids_[kidCount_] = v;
            kidCount_ = kidCount_ + 1;
        }

        // 清空子控件（动态重建场景：安装/卸载后重新填充）
        void clear() {
            kidCount_ = 0;
        }

        int childCount() { return kidCount_; }
        int colCount() { return cols_; }
        // 行数（按子控件数向上取整，至少 1）
        int rowCount() {
            int r = (kidCount_ + cols_ - 1) / cols_;
            if (r < 1) r = 1;
            return r;
        }

        // 布局：为每个子控件 setFrame 到对应格子。
        // 固定模式：cell=(fixedW,fixedH)，坐标 = x_ + padding_ + col*(cellW+spacing_)
        // 自动模式：cell 由 (w,h,cols,rows) 等分。
        void layout() {
            int cellW = fixedW_;
            int cellH = fixedH_;
            if (cellW <= 0 || cellH <= 0) {
                int rows = rowCount();
                cellW = (w_ - 2 * padding_ - (cols_ - 1) * spacing_) / cols_;
                cellH = (h_ - 2 * padding_ - (rows - 1) * spacing_) / rows;
                if (cellW < 1) cellW = 1;
                if (cellH < 1) cellH = 1;
            }
            cellW_ = cellW;
            cellH_ = cellH;
            for (int i = 0; i < kidCount_; i = i + 1) {
                View kid = kids_[i];
                int c = i % cols_;
                int r = i / cols_;
                int cx = x_ + padding_ + c * (cellW + spacing_);
                int cy = y_ + padding_ + r * (cellH + spacing_);
                kid.setFrame(cx, cy, cellW, cellH);
            }
        }

        // View 接口
        int width() { return w_; }
        int height() { return h_; }
        void setFrame(int x, int y, int w, int h) {
            x_ = x;
            y_ = y;
            w_ = w;
            h_ = h;
        }

        void draw(Renderer r) {
            for (int i = 0; i < kidCount_; i = i + 1) {
                View kid = kids_[i];
                if (kid.visible() == 0) continue;
                kid.draw(r);
            }
        }

        int hit(int x, int y) {
            if (x >= x_ && x < x_ + w_ && y >= y_ && y < y_ + h_) return 1;
            return 0;
        }

        // 触摸分发：从后往前命中测试，命中则回调子控件；跳过隐藏控件
        void onTouch(int x, int y) {
            for (int i = kidCount_ - 1; i >= 0; i = i - 1) {
                View kid = kids_[i];
                if (kid.visible() == 0) continue;
                if (kid.hit(x, y) != 0) {
                    kid.onTouch(x, y);
                    return;
                }
            }
        }
}
