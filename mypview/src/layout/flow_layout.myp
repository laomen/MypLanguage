// flow_layout.myp — uikit 布局：FlowLayout（流式换行布局）
// ---------------------------------------------------------------------------
// 子控件按从左到右排列，一行放不下时自动换行（wrap）。常用于标签云、
// 筛选按钮组、仪表盘卡片网格等。行高取当前行最高子控件。
// 纯逻辑，不依赖 SDL，可 headless 测试。
import text;

class FlowLayout {
    interface class View;

    property:
        int x_;
        int y_;
        int w_;
        int h_;
        int padding_;
        int spacing_;      // 水平间距
        int rowGap_;       // 行间距
        View[] kids_;
        int kidCount_;

    action:
        @constructor FlowLayout(int w, int h) {
            w_ = w;
            h_ = h;
            padding_ = 8;
            spacing_ = 8;
            rowGap_ = 8;
            kids_ = new View[64];
            kidCount_ = 0;
        }

        void setPadding(int p) { padding_ = p; }
        void setSpacing(int s) { spacing_ = s; }
        void setRowGap(int g) { rowGap_ = g; }
        int getPadding() { return padding_; }

        void add(View v) {
            if (kidCount_ >= 64) return;
            kids_[kidCount_] = v;
            kidCount_ = kidCount_ + 1;
        }

        int childCount() { return kidCount_; }

        // 清空子控件（动态重建场景：搜索过滤后重新填充）
        void clear() {
            kidCount_ = 0;
        }

        // 布局：从左到右排布，超过右边界则换行。
        // 注意：interface 数组元素经局部变量再调（安全模式）。
        void layout() {
            int cx = x_ + padding_;
            int cy = y_ + padding_;
            int rowMaxH = 0;
            int left = x_ + padding_;
            int right = x_ + w_ - padding_;
            for (int i = 0; i < kidCount_; i = i + 1) {
                View kid = kids_[i];
                int kw = kid.width();
                int kh = kid.height();
                // 需要换行？（当前行已有子项且放不下）
                if (cx > left && cx + kw > right) {
                    cy = cy + rowMaxH + rowGap_;
                    cx = left;
                    rowMaxH = 0;
                }
                kid.setFrame(cx, cy, kw, kh);
                cx = cx + kw + spacing_;
                if (kh > rowMaxH) rowMaxH = kh;
            }
        }

        // View 接口
        int width() { return w_; }
        int height() { return h_; }
        void setFrame(int x, int y, int w, int h) {
            x_ = x;
            y_ = y;
            w_ = w;
            h_ = h;
        }

        void draw(Renderer r) {
            for (int i = 0; i < kidCount_; i = i + 1) {
                View kid = kids_[i];
                if (kid.visible() == 0) continue;
                kid.draw(r);
            }
        }

        int hit(int x, int y) {
            if (x >= x_ && x < x_ + w_ && y >= y_ && y < y_ + h_) return 1;
            return 0;
        }

        void onTouch(int x, int y) {
            for (int i = kidCount_ - 1; i >= 0; i = i - 1) {
                View kid = kids_[i];
                if (kid.visible() == 0) continue;
                if (kid.hit(x, y) != 0) {
                    kid.onTouch(x, y);
                    return;
                }
            }
        }

        // 声明式引擎入口：容器加子 + 布局 + 属性（UixLoader 统一调用）
        void addChild(View v) { add(v); }
        void relayout() { layout(); }
        void setAttr(string name, string value) {
            if (name == "padding") setPadding(Str.toInt(value));
            else if (name == "spacing") setSpacing(Str.toInt(value));
            else if (name == "rowGap") setRowGap(Str.toInt(value));
        }
}
