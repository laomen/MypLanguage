// widgets.myp — mypview 基础控件：Label / Button / TextBox
//
// 每个控件实现 IWidget。属性用 property:（外部只读），改值走公开 action
// （setXxx），绑定引擎经公开 action 写入。

import "./core.myp";

// ---- Label 文本标签 ----
class Label {
    interface class IWidget;
    action:
        @constructor Label(string t) { text_ = t; }

        void setText(string t) { text_ = t; }
        string getText() { return text_; }

        void layout(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
        }
        void draw(IRenderer r) {
            r.rect(x_, y_, w_, h_, fg_, bg_);
            r.text(x_ + 1, y_, text_, fg_, bg_);
        }
        void key(int ch) {}
        int focusable() { return 0; }

    property:
        string text_;
        int x_;
        int y_;
        int w_;
        int h_;
        int fg_ = 7;
        int bg_ = 0;
}

// ---- Button 按钮：可聚焦，回车/空格激活 → 触发 clicked 事件 ----
class Button {
    interface class IWidget;
    action:
        @constructor Button(string t) { text_ = t; }

        void setText(string t) { text_ = t; }
        void setFocused(int f) { focused_ = f; }

        void layout(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
        }
        void draw(IRenderer r) {
            // 聚焦时用高亮前景色画边框
            r.rect(x_, y_, w_, h_, focused_ == 1 ? 11 : fg_, bg_);
            r.text(x_ + 1, y_, text_, fg_, bg_);
        }
        void key(int ch) {
            // 回车(13/10)或空格(32) → 激活
            if (ch == 13 || ch == 10 || ch == 32) {
                clicked();
            }
        }
        int focusable() { return 1; }

    event:
        clicked();

    property:
        string text_;
        int x_;
        int y_;
        int w_;
        int h_;
        int fg_ = 7;
        int bg_ = 0;
        int focused_ = 0;
}

// ---- Bar 进度条：显示 label + 百分比 + 填充条 ----
class Bar {
    interface class IWidget;
    action:
        @constructor Bar(string label, int pct) {
            label_ = label;
            pct_ = pct;
        }

        void setPct(int p) { pct_ = p; }
        int getPct() { return pct_; }

        void layout(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
        }
        void draw(IRenderer r) {
            r.rect(x_, y_, w_, h_, fg_, bg_);
            // 填充条：按百分比画 "█"（高亮绿）
            int filled = (w_ - 2) * pct_ / 100;
            string bar = "";
            int k = 0;
            while (k < filled) {
                bar = bar + "█";
                k = k + 1;
            }
            r.text(x_ + 1, y_, bar, 10, bg_);
            // 标签覆盖在条上（亮白）
            r.text(x_ + 1, y_, label_ + " " + pct_ + "%", 15, bg_);
        }
        void key(int ch) {}
        int focusable() { return 0; }

    property:
        string label_;
        int pct_;
        int x_;
        int y_;
        int w_;
        int h_;
        int fg_ = 7;
        int bg_ = 0;
}
