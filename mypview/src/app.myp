// app.myp — mypview 应用入口：事件循环（输入泵 + 绑定泵 + 重绘）
//
// Application 持有根组件 + 渲染器，run() 每帧：
//   1. 读键盘 → 转发给根组件（Button 激活 → clicked 事件 → mapping）
//   2. 绑定泵：Binding.pump() 检测属性变化
//   3. 布局 + 清屏 + 绘制 + 刷新
// ESC(27) 退出。

import env;
import time;
import "./core.myp";
import "./binding.myp";

class Application {
    action:
        @constructor Application(IWidget root, IRenderer r, int refreshMs) {
            root_ = root;
            r_ = r;
            refreshMs_ = refreshMs;
            b_ = null;
        }

        void setBinding(Binding b) { b_ = b; }

        void run() {
            int running = 1;
            while (running == 1) {
                // 输入泵
                if (Console.kbhit() == 1) {
                    int ch = Console.getch();
                    if (ch == 27) { running = 0; break; }
                    root_.key(ch);
                }
                // 绑定泵
                if (b_ != null) {
                    b_.pump();
                }
                // 布局 + 重绘
                root_.layout(1, 1, 24, 6);
                r_.clear();
                root_.draw(r_);
                r_.flush();
                Time.sleep(long(refreshMs_));
            }
        }

    property:
        IWidget root_;
        IRenderer r_;
        int refreshMs_;
        Binding b_;
}
