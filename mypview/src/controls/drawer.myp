// drawer.myp — uikit 控件：Drawer（侧边抽屉面板）
// ---------------------------------------------------------------------------
// 侧滑抽屉：一个可开合的面板容器。open(x,y) 显示在指定位置，close 隐藏。
// 可 addChild 放内容（View[]，用具体类型数组持有避免接口悬垂）。
// 纯逻辑 headless 可测（open/close/visible 状态）。
import text;

class Drawer {
    interface class View;

    property:
        int x_;
        int y_;
        int w_;
        int h_;
        int visible_;
        int color_;
        View[] kids_;
        int kidCount_;

    action:
        @constructor Drawer(int w, int h) {
            x_ = 0;
            y_ = 0;
            w_ = w;
            h_ = h;
            visible_ = 0;
            color_ = Color.dark();
            kids_ = new View[32];
            kidCount_ = 0;
        }

        void open(int x, int y) {
            x_ = x;
            y_ = y;
            visible_ = 1;
        }
        void close() { visible_ = 0; }
        void toggle(int x, int y) {
            if (visible_ != 0) close();
            else open(x, y);
        }
        int visible() { return visible_; }
        void setColor(int c) { color_ = c; }
        int getColor() { return color_; }
        int getX() { return x_; }
        int getY() { return y_; }
        // 内容子项
        void add(View v) {
            if (kidCount_ >= 32) return;
            kids_[kidCount_] = v;
            kidCount_ = kidCount_ + 1;
        }
        int childCount() { return kidCount_; }
        void addChild(View v) { add(v); }

        void setAttr(string name, string value) {
            if (name == "color") setColor(Color.fromHex(value));
        }

        // View 接口：固定尺寸
        int width() { return w_; }
        int height() { return h_; }
        void setFrame(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
        }

        void draw(Renderer r) {
            if (visible_ == 0) return;
            // 遮罩（整个抽屉区域）+ 面板
            r.fillRect(x_, y_, w_, h_, color_);
            r.outlineRect(x_, y_, w_, h_, Color.gray());
            for (int i = 0; i < kidCount_; i = i + 1) {
                kids_[i].draw(r);
            }
        }

        int hit(int x, int y) {
            if (visible_ == 0) return 0;
            if (x >= x_ && x < x_ + w_ && y >= y_ && y < y_ + h_) return 1;
            return 0;
        }

        void onTouch(int x, int y) {
            if (visible_ == 0) return;
            for (int i = kidCount_ - 1; i >= 0; i = i - 1) {
                View kid = kids_[i];
                if (kid.hit(x, y) != 0) {
                    kid.onTouch(x, y);
                    return;
                }
            }
        }
}
