// banner.myp — uikit 控件：Banner（顶部横幅提示）
// ---------------------------------------------------------------------------
// 顶部提示条：show(text, kind) 显示（info/warn/error 配色），tick 帧驱动倒
// 计时自动隐藏，或 showFixed 常驻。纯逻辑 headless 可测。
import text;

class Banner {
    interface class View;

    property:
        string text_;
        int x_;
        int y_;
        int w_;
        int h_;
        int visible_;
        int frames_;
        int fixed_;
        int color_;

    action:
        @constructor Banner(int w, int h) {
            text_ = "";
            x_ = 0;
            y_ = 0;
            w_ = w;
            h_ = h;
            visible_ = 0;
            frames_ = 0;
            fixed_ = 0;
            color_ = Color.blue();
        }

        // 显示提示（kind：0=info 蓝 1=warn 橙 2=error 红），120 帧后自动隐藏
        void show(string text, int kind) {
            text_ = text;
            visible_ = 1;
            frames_ = 120;
            fixed_ = 0;
            if (kind == 1) color_ = Color.orange();
            else if (kind == 2) color_ = Color.red();
            else color_ = Color.blue();
        }
        void showFixed(string text) {
            text_ = text;
            visible_ = 1;
            fixed_ = 1;
        }
        void hide() { visible_ = 0; frames_ = 0; fixed_ = 0; }
        // 帧驱动倒计时
        void tick(int dt) {
            if (visible_ == 0 || fixed_ != 0) return;
            frames_ = frames_ - dt;
            if (frames_ <= 0) { visible_ = 0; frames_ = 0; }
        }
        int visible() { return visible_; }
        int frames() { return frames_; }
        string text() { return text_; }
        void setColor(int c) { color_ = c; }
        int getColor() { return color_; }

        void setAttr(string name, string value) {
            if (name == "text") text_ = value;
            else if (name == "color") setColor(Color.fromHex(value));
        }

        // View 接口
        int width() { return w_; }
        int height() { return h_; }
        void setFrame(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
        }

        void draw(Renderer r) {
            if (visible_ == 0) return;
            r.fillRect(x_, y_, w_, h_, color_);
            r.drawText(x_ + 10, y_ + h_ / 2 - r.textH(1) / 2,
                       text_, 1, Color.white());
        }

        int hit(int x, int y) {
            if (visible_ == 0) return 0;
            if (x >= x_ && x < x_ + w_ && y >= y_ && y < y_ + h_) return 1;
            return 0;
        }

        void onTouch(int x, int y) {}
}
