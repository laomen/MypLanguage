// text_field.myp — uikit 控件：TextField（文本输入框）
// ---------------------------------------------------------------------------
// 持有文本；append(ch)/setText/clear；focus 状态；点击聚焦触发 Focused。
// 纯逻辑 headless 可测（真实键盘输入由应用层把按键转 append）。
class TextField {
    interface class View;

    property:
        string text_;
        int x_;
        int y_;
        int w_;
        int h_;
        int focused_;
        int color_;
        int enabled_;
        int masked_;      // 密码掩码：1=显示 *（getText 仍返回真实文本）

    event:
        Focused(int x, int y);
        Edited(string text);

    action:
        @constructor TextField(string text, int x, int y, int w, int h) {
            text_ = text;
            x_ = x;
            y_ = y;
            w_ = w;
            h_ = h;
            focused_ = 0;
            color_ = Color.dark();
            enabled_ = 1;
            masked_ = 0;
        }

        void setText(string t) { text_ = t; }
        string getText() { return text_; }
        void clear() { text_ = ""; }
        // 追加一个字符（键盘输入）
        void append(string ch) { text_ = text_ + ch; }
        // 删除末尾一个字符（UTF-8 感知：向后跳过 10xxxxxx 续字节，整字符删除，
        // 避免中文等多字节字符被截断成半个字节 → 显示乱码 "□"）
        void backspace() {
            int n = Str.len(text_);
            if (n <= 0) return;
            int i = n - 1;
            while (i > 0) {
                int b = __myp_ord(Str.substring(text_, i, i + 1));
                if ((b & 0xC0) != 0x80) break;   // 非续字节 = 字符起始字节
                i = i - 1;
            }
            text_ = Str.substring(text_, 0, i);
        }
        // 焦点（键盘导航；同时用于输入聚焦——focused() 已存在）
        int focusable() { return 1; }
        void setFocus(int on) { focused_ = on; }
        int focused() { return focused_; }
        void setColor(int c) { color_ = c; }
        int getColor() { return color_; }
        // 密码掩码开关：1=绘制时以 * 显示（getText 返回真实文本）
        void setMask(int on) { masked_ = on; }
        int getMask() { return masked_; }
        int masked() { return masked_; }
        // 逐 UTF-8 字符替换为 *（掩码显示；中文等多字节按字符计）
        string maskText(string t) {
            StringBuilder sb = new StringBuilder();
            int i = 0;
            int n = Str.len(t);
            while (i < n) {
                int b = __myp_ord(Str.substring(t, i, i + 1));
                int adv = 1;
                if ((b & 0xE0) == 0xC0) adv = 2;
                else if ((b & 0xF0) == 0xE0) adv = 3;
                else if ((b & 0xF8) == 0xF0) adv = 4;
                sb.append("*");
                i = i + adv;
            }
            return sb.toString();
        }
        int getX() { return x_; }
        int getY() { return y_; }
        void setEnabled(int on) { enabled_ = on; }
        int enabled() { return enabled_; }

        // 声明式属性入口（UixLoader 调用）
        void setAttr(string name, string value) {
            if (name == "text") setText(value);
            else if (name == "color") setColor(Color.fromHex(value));
        }

        // View 接口
        int width() { return w_; }
        int height() { return h_; }
        void setFrame(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
        }

        void draw(Renderer r) {
            // 输入框背景 + 边框（聚焦高亮）
            r.fillRect(x_, y_, w_, h_, color_);
            if (focused_ != 0)
                r.outlineRect(x_, y_, w_, h_, Color.green());
            else
                r.outlineRect(x_, y_, w_, h_, Color.gray());
            string disp = masked_ != 0 ? maskText(text_) : text_;
            r.drawText(x_ + 6, y_ + h_ / 2 - r.textH(2) / 2, disp, 2, Color.white());
        }

        int hit(int x, int y) {
            if (x >= x_ && x < x_ + w_ && y >= y_ && y < y_ + h_) return 1;
            return 0;
        }

        // 点击聚焦（禁用时不聚焦）
        void onTouch(int x, int y) {
            if (enabled_ == 0) return;
            focused_ = 1;
            Focused(x, y);
        }
        void unfocus() { focused_ = 0; }
}
