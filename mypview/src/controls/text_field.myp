// text_field.myp — uikit 控件：TextField（文本输入框）
// ---------------------------------------------------------------------------
// 持有文本；append(ch)/setText/clear；focus 状态；点击聚焦触发 Focused。
// 纯逻辑 headless 可测（真实键盘输入由应用层把按键转 append）。
class TextField {
    interface class View;

    property:
        string text_;
        int x_;
        int y_;
        int w_;
        int h_;
        int focused_;
        int color_;
        int enabled_;

    event:
        Focused(int x, int y);
        Edited(string text);

    action:
        @constructor TextField(string text, int x, int y, int w, int h) {
            text_ = text;
            x_ = x;
            y_ = y;
            w_ = w;
            h_ = h;
            focused_ = 0;
            color_ = Color.dark();
            enabled_ = 1;
        }

        void setText(string t) { text_ = t; }
        string getText() { return text_; }
        void clear() { text_ = ""; }
        // 追加一个字符（键盘输入）
        void append(string ch) { text_ = text_ + ch; }
        // 删除末尾字符
        void backspace() {
            int n = Str.len(text_);
            if (n > 0) text_ = Str.substring(text_, 0, n - 1);
        }
        int focused() { return focused_; }
        void setColor(int c) { color_ = c; }
        int getColor() { return color_; }
        int getX() { return x_; }
        int getY() { return y_; }
        void setEnabled(int on) { enabled_ = on; }
        int enabled() { return enabled_; }

        // 声明式属性入口（UixLoader 调用）
        void setAttr(string name, string value) {
            if (name == "text") setText(value);
            else if (name == "color") setColor(Color.fromHex(value));
        }

        // View 接口
        int width() { return w_; }
        int height() { return h_; }
        void setFrame(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
        }

        void draw(Renderer r) {
            // 输入框背景 + 边框（聚焦高亮）
            r.fillRect(x_, y_, w_, h_, color_);
            if (focused_ != 0)
                r.outlineRect(x_, y_, w_, h_, Color.green());
            else
                r.outlineRect(x_, y_, w_, h_, Color.gray());
            r.drawText(x_ + 6, y_ + h_ / 2 - 16, text_, 2, Color.white());
        }

        int hit(int x, int y) {
            if (x >= x_ && x < x_ + w_ && y >= y_ && y < y_ + h_) return 1;
            return 0;
        }

        // 点击聚焦（禁用时不聚焦）
        void onTouch(int x, int y) {
            if (enabled_ == 0) return;
            focused_ = 1;
            Focused(x, y);
        }
        void unfocus() { focused_ = 0; }
}
