// tooltip.myp — uikit 控件：Tooltip（悬停提示气泡）
// ---------------------------------------------------------------------------
// 气泡提示：show(text, x, y) 显示在指定位置，hide 隐藏。draw 画圆角气泡 +
// 文本（小三角指向锚点可选）。应用层按需 show/hide（如 hover 命中）。
import text;

class Tooltip {
    interface class View;

    property:
        string text_;
        int x_;
        int y_;
        int w_;
        int h_;
        int visible_;
        int color_;

    action:
        @constructor Tooltip(int w, int h) {
            text_ = "";
            x_ = 0;
            y_ = 0;
            w_ = w;
            h_ = h;
            visible_ = 0;
            color_ = Color.dark();
        }

        void show(string text, int x, int y) {
            text_ = text;
            x_ = x;
            y_ = y;
            visible_ = 1;
        }
        void hide() { visible_ = 0; }
        int visible() { return visible_; }
        string text() { return text_; }
        void setColor(int c) { color_ = c; }
        int getColor() { return color_; }
        int getX() { return x_; }
        int getY() { return y_; }

        void setAttr(string name, string value) {
            if (name == "text") text_ = value;
            else if (name == "color") setColor(Color.fromHex(value));
        }

        // View 接口：固定尺寸
        int width() { return w_; }
        int height() { return h_; }
        void setFrame(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
        }

        void draw(Renderer r) {
            if (visible_ == 0) return;
            r.fillRoundedRect(x_, y_, w_, h_, 8, color_);
            // 小三角（顶部，指向锚点）
            int tri = w_ / 2;
            r.drawLine(x_ + tri - 5, y_, x_ + tri, y_ - 6, color_);
            r.drawLine(x_ + tri + 5, y_, x_ + tri, y_ - 6, color_);
            r.drawLine(x_ + tri - 5, y_, x_ + tri + 5, y_, color_);
            // 文本（居中，省略超出宽度）
            string t = text_;
            if (r.textWidth(t, 1) > w_ - 16)
                t = Str.substring(t, 0, 1);   // 超宽简单截断（完整省略逻辑略）
            r.drawText(x_ + w_ / 2 - r.textWidth(t, 1) / 2,
                       y_ + h_ / 2 - r.textH(1) / 2,
                       t, 1, Color.white());
        }

        int hit(int x, int y) {
            if (visible_ == 0) return 0;
            if (x >= x_ && x < x_ + w_ && y >= y_ && y < y_ + h_) return 1;
            return 0;
        }

        void onTouch(int x, int y) {}
}
