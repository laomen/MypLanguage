// popover.myp — uikit 控件：Popover（气泡弹层）
// ---------------------------------------------------------------------------
// 锚点弹层：show(text, x, y) 在锚点附近显示气泡 + 文本，hide 隐藏。
// 比 Tooltip 更大、可多次显示。纯逻辑 headless 可测。
import text;

class Popover {
    interface class View;

    property:
        string text_;
        int x_;
        int y_;
        int w_;
        int h_;
        int visible_;
        int color_;

    action:
        @constructor Popover(int w, int h) {
            text_ = "";
            x_ = 0;
            y_ = 0;
            w_ = w;
            h_ = h;
            visible_ = 0;
            color_ = Color.dark();
        }

        void show(string text, int x, int y) {
            text_ = text;
            x_ = x;
            y_ = y;
            visible_ = 1;
        }
        void hide() { visible_ = 0; }
        int visible() { return visible_; }
        string text() { return text_; }
        void setColor(int c) { color_ = c; }
        int getColor() { return color_; }
        int getX() { return x_; }
        int getY() { return y_; }

        void setAttr(string name, string value) {
            if (name == "text") text_ = value;
            else if (name == "color") setColor(Color.fromHex(value));
        }

        // View 接口
        int width() { return w_; }
        int height() { return h_; }
        void setFrame(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
        }

        void draw(Renderer r) {
            if (visible_ == 0) return;
            r.fillRoundedRect(x_, y_, w_, h_, 10, color_);
            r.outlineRect(x_, y_, w_, h_, Color.white());
            // 小三角（顶部）
            int tri = w_ / 2;
            r.drawLine(x_ + tri - 6, y_, x_ + tri, y_ - 7, color_);
            r.drawLine(x_ + tri + 6, y_, x_ + tri, y_ - 7, color_);
            r.drawLine(x_ + tri - 6, y_, x_ + tri + 6, y_, color_);
            r.drawText(x_ + w_ / 2 - r.textWidth(text_, 1) / 2,
                       y_ + h_ / 2 - r.textH(1) / 2,
                       text_, 1, Color.white());
        }

        int hit(int x, int y) {
            if (visible_ == 0) return 0;
            if (x >= x_ && x < x_ + w_ && y >= y_ && y < y_ + h_) return 1;
            return 0;
        }

        void onTouch(int x, int y) {}
}
