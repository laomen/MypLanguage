// radio_button.myp — uikit 控件：RadioButton（单选按钮）
// ---------------------------------------------------------------------------
// label + 选中态（圆点）。点击勾选并触发 Changed(value)。同组互斥由外部管理
// （容器/测试把组内其它置 0），本控件只维护自身 checked。纯逻辑 headless 可测。
import text;

class RadioButton {
    interface class View;

    property:
        string label_;
        int x_;
        int y_;
        int w_;
        int h_;
        int checked_;
        int group_;        // 组 id（互斥分组用）
        int color_;

    event:
        Changed(int value);

    action:
        @constructor RadioButton(string label, int x, int y, int w, int h) {
            label_ = label;
            x_ = x;
            y_ = y;
            w_ = w;
            h_ = h;
            checked_ = 0;
            group_ = 0;
            color_ = Color.blue();
        }

        void setChecked(int v) { checked_ = v; }
        int getChecked() { return checked_; }
        void setGroup(int g) { group_ = g; }
        int getGroup() { return group_; }
        void setLabel(string s) { label_ = s; }
        string getLabel() { return label_; }
        void setColor(int c) { color_ = c; }
        int getColor() { return color_; }
        // 声明式属性入口
        void setAttr(string name, string value) {
            if (name == "text") setLabel(value);
            else if (name == "checked") setChecked(Str.toInt(value));
            else if (name == "color") setColor(Color.fromHex(value));
        }
        int getX() { return x_; }
        int getY() { return y_; }

        // View 接口
        int width() { return w_; }
        int height() { return h_; }
        void setFrame(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
        }

        void draw(Renderer r) {
            int rad = 7;
            int cx = x_ + 10;
            int cy = y_ + h_ / 2;
            r.outlineRect(cx - rad, cy - rad, rad * 2, rad * 2, Color.gray());
            if (checked_ != 0)
                r.fillRect(cx - rad + 3, cy - rad + 3, rad * 2 - 6, rad * 2 - 6, color_);
            r.drawText(x_ + 24, y_ + h_ / 2 - r.textH(1) / 2, label_, 1, Color.white());
        }

        int hit(int x, int y) {
            if (x >= x_ && x < x_ + w_ && y >= y_ && y < y_ + h_) return 1;
            return 0;
        }

        // 点击勾选 + 触发 Changed
        void onTouch(int x, int y) {
            setChecked(1);
            Changed(checked_);
        }
}
