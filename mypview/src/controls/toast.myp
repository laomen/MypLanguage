// toast.myp — uikit 控件：Toast（轻提示，底部短条）
// ---------------------------------------------------------------------------
// show(text) 显示一条提示，帧驱动 tick(dt) 自动消失（默认 90 帧）；showFixed
// 常驻直到 hide。纯逻辑 headless 可测。
import text;

class Toast {
    interface class View;

    property:
        string text_;
        int x_;
        int y_;
        int w_;
        int h_;
        int visible_;
        int frames_;
        int fixed_;
        int color_;

    action:
        @constructor Toast(int w, int h) {
            text_ = "";
            x_ = 0;
            y_ = 0;
            w_ = w;
            h_ = h;
            visible_ = 0;
            frames_ = 0;
            fixed_ = 0;
            color_ = Color.dark();
        }

        // 显示一条提示（重置倒计时；fixed 状态取消——新提示重新可见）
        void show(string text) {
            text_ = text;
            visible_ = 1;
            frames_ = 90;
            fixed_ = 0;
        }
        // 常驻显示（直到 hide）
        void showFixed(string text) {
            text_ = text;
            visible_ = 1;
            fixed_ = 1;
        }
        void hide() { visible_ = 0; frames_ = 0; fixed_ = 0; }
        // 帧驱动：非固定时递减剩余帧数，耗尽后隐藏
        void tick(int dt) {
            if (visible_ == 0 || fixed_ != 0) return;
            frames_ = frames_ - dt;
            if (frames_ <= 0) { visible_ = 0; frames_ = 0; }
        }
        int visible() { return visible_; }
        int frames() { return frames_; }
        int fixed() { return fixed_; }
        string text() { return text_; }
        void setColor(int c) { color_ = c; }
        int getColor() { return color_; }
        // 声明式属性入口
        void setAttr(string name, string value) {
            if (name == "text") text_ = value;
            else if (name == "color") setColor(Color.fromHex(value));
        }
        int getX() { return x_; }
        int getY() { return y_; }

        // View 接口
        int width() { return w_; }
        int height() { return h_; }
        void setFrame(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
        }

        void draw(Renderer r) {
            if (visible_ == 0) return;
            r.fillRoundedRect(x_, y_, w_, h_, h_ / 2, color_);
            r.drawText(x_ + 6, y_ + h_ / 2 - r.textH(1) / 2, text_, 1, Color.white());
        }

        int hit(int x, int y) {
            if (visible_ == 0) return 0;
            if (x >= x_ && x < x_ + w_ && y >= y_ && y < y_ + h_) return 1;
            return 0;
        }

        void onTouch(int x, int y) {}
}
