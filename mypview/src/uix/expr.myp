// expr.myp — UIX 框架：属性绑定表达式求值器（QML 风格计算属性）
// ---------------------------------------------------------------------------
// UIX 的 `expr` 属性 = 字符串表达式，如：
//   "width / 2"                      当前节点宽度的一半
//   "vol.value * 2"                  节点 vol 的 value 属性 × 2
//   "status == \"ok\" ? \"ready\" : \"wait\""   条件选择
//   "\"count: \" + count"            字符串拼接
// 语法（递归下降，纯 MYP 实现，headless 可测）：
//   expr    := ternary
//   ternary := or ('?' expr ':' expr)?
//   or      := and ('||' and)*
//   and     := cmp ('&&' cmp)*
//   cmp     := add (('=='|'!='|'<'|'<='|'>'|'>=') add)*
//   add     := mul (('+'|'-') mul)*
//   mul     := unary (('*'|'/'|'%') unary)*
//   unary   := ('-'|'!'|'(' expr ')') unary | primary
//   primary := number | "string" | 标识符路径 | '(' expr ')'
// 标识符路径（QML 风格，UixLoader 提供节点/属性解析）：
//   width / height        → 当前节点尺寸
//   parent.X / root.X     → 父节点 / 根节点的尺寸或属性
//   节点id.属性           → 其它节点属性（读 UixLoader 属性袋）
//   属性名                → 当前节点属性
// 值类型：number/string 双态（UixVal）；算术按 double，输出经 Fmt.g 转字符串。
import text;
import fmt;

// 求值结果：kind 0=number 1=string
class UixVal {
    property:
        int kind_;
        double d_;
        string s_;
    action:
        @constructor UixVal() { kind_ = 0; d_ = 0.0; s_ = ""; }
        void num(double d) { kind_ = 0; d_ = d; s_ = ""; }
        void str(string s) { kind_ = 1; d_ = 0.0; s_ = s; }
        int isNum() {
            if (kind_ == 0) return 1;
            return 0;
        }
        double toNum() {
            if (kind_ == 0) return d_;
            // 内联字符串→double 解析（不依赖 UixExpr）
            return strToNum(s_);
        }
        string toStr() {
            if (kind_ == 0) return Fmt.g(d_, 6);
            return s_;
        }
        // 字符串 → double（支持符号、小数点；非数字返回 0）
        int isDigitS(string c) {
            int o = Str.ord(c);
            if (o >= 48 && o <= 57) return 1;
            return 0;
        }
        double strToNum(string s) {
            int i = 0;
            int n = Str.len(s);
            int sign = 1;
            if (i < n) {
                string c = Str.substring(s, i, i + 1);
                if (c == "-") { sign = -1; i = i + 1; }
                else if (c == "+") { i = i + 1; }
            }
            double v = 0.0;
            int anyDigit = 0;
            while (i < n && isDigitS(Str.substring(s, i, i + 1)) != 0) {
                int d = Str.ord(Str.substring(s, i, i + 1)) - 48;
                v = v * 10.0 + double(d);
                i = i + 1;
                anyDigit = 1;
            }
            if (i < n && Str.substring(s, i, i + 1) == ".") {
                i = i + 1;
                double f = 1.0;
                while (i < n && isDigitS(Str.substring(s, i, i + 1)) != 0) {
                    int d = Str.ord(Str.substring(s, i, i + 1)) - 48;
                    f = f * 0.1;
                    v = v + double(d) * f;
                    i = i + 1;
                    anyDigit = 1;
                }
            }
            if (anyDigit == 0) return 0.0;
            return double(sign) * v;
        }
}

// 表达式求值器（状态：token 流 + 游标；结果经各 eval 方法返回）
class UixExpr {
    property:
        string[] tk_;       // token 文本
        int[] tkK_;         // 0=number 1=id 2=op 3=string
        int tkCount_;
        int pos_;

    action:
        @constructor UixExpr(string src) {
            tk_ = new string[64];
            tkK_ = new int[64];
            tkCount_ = 0;
            pos_ = 0;
            tokenize(src);
        }

        // 入口：求值整个表达式
        UixVal eval(UixLoader loader, string selfId) {
            pos_ = 0;
            return evalTernary(loader, selfId);
        }

        // ---- 分词 ----
        void tokenize(string src) {
            int i = 0;
            int n = Str.len(src);
            while (i < n) {
                string c = Str.substring(src, i, i + 1);
                if (c == " " || c == "\t") { i = i + 1; continue; }
                if (isDigitC(c) != 0) {
                    int j = i;
                    while (j < n && isDigitC(Str.substring(src, j, j + 1)) != 0) j = j + 1;
                    if (j < n && Str.substring(src, j, j + 1) == ".") {
                        j = j + 1;
                        while (j < n && isDigitC(Str.substring(src, j, j + 1)) != 0) j = j + 1;
                    }
                    addTok(Str.substring(src, i, j), 0);
                    i = j;
                    continue;
                }
                if (isAlphaC(c) != 0) {
                    int j = i;
                    while (j < n && isIdentC(Str.substring(src, j, j + 1)) != 0) j = j + 1;
                    addTok(Str.substring(src, i, j), 1);
                    i = j;
                    continue;
                }
                if (c == "\"") {
                    int j = i + 1;
                    string acc = "";
                    while (j < n && Str.substring(src, j, j + 1) != "\"") {
                        string cc = Str.substring(src, j, j + 1);
                        if (cc == "\\" && j + 1 < n) {
                            j = j + 1;
                            string e = Str.substring(src, j, j + 1);
                            if (e == "n") acc = acc + "\n";
                            else if (e == "t") acc = acc + "\t";
                            else acc = acc + e;
                        } else {
                            acc = acc + cc;
                        }
                        j = j + 1;
                    }
                    addTok(acc, 3);
                    i = j + 1;
                    continue;
                }
                if (i + 1 < n) {
                    string two = Str.substring(src, i, i + 2);
                    if (two == "==" || two == "!=" || two == "<=" || two == ">="
                        || two == "&&" || two == "||") {
                        addTok(two, 2);
                        i = i + 2;
                        continue;
                    }
                }
                addTok(c, 2);
                i = i + 1;
            }
        }
        void addTok(string t, int k) {
            if (tkCount_ >= 64) return;
            tk_[tkCount_] = t;
            tkK_[tkCount_] = k;
            tkCount_ = tkCount_ + 1;
        }

        // ---- 解析 ----
        UixVal evalTernary(UixLoader loader, string selfId) {
            UixVal c = evalOr(loader, selfId);
            if (opIs("?") != 0) {
                pos_ = pos_ + 1;
                UixVal t = evalTernary(loader, selfId);
                if (opIs(":") != 0) pos_ = pos_ + 1;
                UixVal e = evalTernary(loader, selfId);
                if (c.toNum() != 0.0) return t;
                return e;
            }
            return c;
        }
        UixVal evalOr(UixLoader loader, string selfId) {
            UixVal a = evalAnd(loader, selfId);
            while (opIs("||") != 0) {
                pos_ = pos_ + 1;
                UixVal b = evalAnd(loader, selfId);
                UixVal r = new UixVal();
                if (a.toNum() != 0.0 || b.toNum() != 0.0) r.num(1.0);
                else r.num(0.0);
                a = r;
            }
            return a;
        }
        UixVal evalAnd(UixLoader loader, string selfId) {
            UixVal a = evalCmp(loader, selfId);
            while (opIs("&&") != 0) {
                pos_ = pos_ + 1;
                UixVal b = evalCmp(loader, selfId);
                UixVal r = new UixVal();
                if (a.toNum() != 0.0 && b.toNum() != 0.0) r.num(1.0);
                else r.num(0.0);
                a = r;
            }
            return a;
        }
        UixVal evalCmp(UixLoader loader, string selfId) {
            UixVal a = evalAdd(loader, selfId);
            int go = 1;
            while (go == 1) {
                string op = "";
                if (opIs("==") != 0) op = "==";
                else if (opIs("!=") != 0) op = "!=";
                else if (opIs("<=") != 0) op = "<=";
                else if (opIs(">=") != 0) op = ">=";
                else if (opIs("<") != 0) op = "<";
                else if (opIs(">") != 0) op = ">";
                if (op == "") {
                    go = 0;
                } else {
                    pos_ = pos_ + 1;
                    UixVal b = evalAdd(loader, selfId);
                    UixVal r = new UixVal();
                    if (cmpVal(a, b, op) != 0) r.num(1.0);
                    else r.num(0.0);
                    a = r;
                }
            }
            return a;
        }
        UixVal evalAdd(UixLoader loader, string selfId) {
            UixVal a = evalMul(loader, selfId);
            while (opIs("+") != 0 || opIs("-") != 0) {
                string op = tk_[pos_];
                pos_ = pos_ + 1;
                UixVal b = evalMul(loader, selfId);
                if (op == "+") {
                    if (a.isNum() != 0 && b.isNum() != 0) {
                        UixVal r = new UixVal();
                        r.num(a.toNum() + b.toNum());
                        a = r;
                    } else {
                        UixVal r = new UixVal();
                        r.str(a.toStr() + b.toStr());
                        a = r;
                    }
                } else {
                    UixVal r = new UixVal();
                    r.num(a.toNum() - b.toNum());
                    a = r;
                }
            }
            return a;
        }
        UixVal evalMul(UixLoader loader, string selfId) {
            UixVal a = evalUnary(loader, selfId);
            while (opIs("*") != 0 || opIs("/") != 0 || opIs("%") != 0) {
                string op = tk_[pos_];
                pos_ = pos_ + 1;
                UixVal b = evalUnary(loader, selfId);
                UixVal r = new UixVal();
                if (op == "*") {
                    r.num(a.toNum() * b.toNum());
                } else if (op == "/") {
                    r.num(a.toNum() / b.toNum());
                } else {
                    int x = int(a.toNum());
                    int y = int(b.toNum());
                    if (y == 0) r.num(0.0);
                    else r.num(double(x % y));
                }
                a = r;
            }
            return a;
        }
        UixVal evalUnary(UixLoader loader, string selfId) {
            if (opIs("-") != 0) {
                pos_ = pos_ + 1;
                UixVal v = evalUnary(loader, selfId);
                UixVal r = new UixVal();
                r.num(-v.toNum());
                return r;
            }
            if (opIs("!") != 0) {
                pos_ = pos_ + 1;
                UixVal v = evalUnary(loader, selfId);
                UixVal r = new UixVal();
                if (v.toNum() == 0.0) r.num(1.0);
                else r.num(0.0);
                return r;
            }
            return evalPrimary(loader, selfId);
        }
        UixVal evalPrimary(UixLoader loader, string selfId) {
            UixVal r = new UixVal();
            if (pos_ >= tkCount_) {
                r.num(0.0);
                return r;
            }
            if (tkK_[pos_] == 0) {
                string t = tk_[pos_];
                pos_ = pos_ + 1;
                r.num(parseNum(t));
                return r;
            }
            if (tkK_[pos_] == 3) {
                string t = tk_[pos_];
                pos_ = pos_ + 1;
                r.str(t);
                return r;
            }
            if (tkK_[pos_] == 1) {
                string t = tk_[pos_];
                pos_ = pos_ + 1;
                return resolveId(t, loader, selfId);
            }
            if (opIs("(") != 0) {
                pos_ = pos_ + 1;
                UixVal v = evalTernary(loader, selfId);
                if (opIs(")") != 0) pos_ = pos_ + 1;
                return v;
            }
            r.num(0.0);
            return r;
        }

        // 标识符路径解析（QML 风格）
        UixVal resolveId(string token, UixLoader loader, string selfId) {
            string base = token;
            string prop = "";
            int dot = Str.indexOf(token, ".");
            if (dot >= 0) {
                base = Str.substring(token, 0, dot);
                prop = Str.substring(token, dot + 1, Str.len(token));
            }
            UixVal r = new UixVal();
            if (base == "parent") {
                string pid = loader.parentIdOf(selfId);
                return resolveNodeProp(loader, pid, prop);
            }
            if (base == "root") {
                string rid = loader.rootId();
                return resolveNodeProp(loader, rid, prop);
            }
            if (loader.hasId(base) != 0) {
                return resolveNodeProp(loader, base, prop);
            }
            // 当前节点属性
            return resolveNodeProp(loader, selfId, base);
        }
        // 在指定节点上解析属性（空属性 = 节点存在，返回 1）
        UixVal resolveNodeProp(UixLoader loader, string nodeId, string prop) {
            UixVal r = new UixVal();
            if (prop == "") {
                r.num(1.0);
                return r;
            }
            if (prop == "width") {
                r.num(loader.nodeWidth(nodeId));
                return r;
            }
            if (prop == "height") {
                r.num(loader.nodeHeight(nodeId));
                return r;
            }
            string v = loader.propOf(nodeId, prop);
            r.str(v);
            return r;
        }

        // ---- 工具 ----
        int opIs(string o) {
            if (pos_ >= tkCount_) return 0;
            if (tkK_[pos_] != 2) return 0;
            if (tk_[pos_] == o) return 1;
            return 0;
        }
        int cmpVal(UixVal a, UixVal b, string op) {
            if (a.isNum() != 0 && b.isNum() != 0) {
                double x = a.toNum();
                double y = b.toNum();
                if (op == "==" && x == y) return 1;
                if (op == "!=" && x != y) return 1;
                if (op == "<" && x < y) return 1;
                if (op == "<=" && x <= y) return 1;
                if (op == ">" && x > y) return 1;
                if (op == ">=" && x >= y) return 1;
                return 0;
            }
            string x = a.toStr();
            string y = b.toStr();
            if (op == "==" && x == y) return 1;
            if (op == "!=" && x != y) return 1;
            int c = Str.cmp(x, y);
            if (op == "<" && c < 0) return 1;
            if (op == "<=" && c <= 0) return 1;
            if (op == ">" && c > 0) return 1;
            if (op == ">=" && c >= 0) return 1;
            return 0;
        }
        int isDigitC(string c) {
            int o = Str.ord(c);
            if (o >= 48 && o <= 57) return 1;
            return 0;
        }
        int isAlphaC(string c) {
            int o = Str.ord(c);
            if (o >= 97 && o <= 122) return 1;
            if (o >= 65 && o <= 90) return 1;
            if (o == 95) return 1;
            return 0;
        }
        int isIdentC(string c) {
            if (isAlphaC(c) != 0) return 1;
            if (isDigitC(c) != 0) return 1;
            if (c == ".") return 1;
            return 0;
        }
        // 字符串 → double（支持符号、小数点；非数字返回 0）
        double parseNum(string s) {
            int i = 0;
            int n = Str.len(s);
            int sign = 1;
            if (i < n) {
                string c = Str.substring(s, i, i + 1);
                if (c == "-") { sign = -1; i = i + 1; }
                else if (c == "+") { i = i + 1; }
            }
            double v = 0.0;
            int anyDigit = 0;
            while (i < n && isDigitC(Str.substring(s, i, i + 1)) != 0) {
                int d = Str.ord(Str.substring(s, i, i + 1)) - 48;
                v = v * 10.0 + double(d);
                i = i + 1;
                anyDigit = 1;
            }
            if (i < n && Str.substring(s, i, i + 1) == ".") {
                i = i + 1;
                double f = 1.0;
                while (i < n && isDigitC(Str.substring(s, i, i + 1)) != 0) {
                    int d = Str.ord(Str.substring(s, i, i + 1)) - 48;
                    f = f * 0.1;
                    v = v + double(d) * f;
                    i = i + 1;
                    anyDigit = 1;
                }
            }
            if (anyDigit == 0) return 0.0;
            return double(sign) * v;
        }
}
