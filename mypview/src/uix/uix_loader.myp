// uix_loader.myp — UIX 框架：声明式界面加载器（UixLoader）
// ---------------------------------------------------------------------------
// UIX = UI eXtensible：MYP/MOS 自己的声明式 UI DSL（职责对标 Qt 的 QML/QSS，
// 但命名与实现完全独立，不借用 Qt 名字）。
//
//   .uix 文件 — 界面描述（JSON）：组件树 + 属性 + 绑定 + 命令
//   .usp 文件 — 样式表（JSON）：选择器（类型 / #id / .class）→ 属性集
//
// UixLoader 职责：
//   - 解析 .uix → 递归构建 View 树（工厂 dispatch；控件经统一 View.setAttr
//     接收声明式属性）
//   - 解析 .usp → 按选择器匹配并把样式属性应用到节点（构建时应用）
//   - 注册绑定表（控件 id + 目标属性 + VM 属性路径）→ sync(vm) 刷新
//   - 注册命令表（控件 id → 命令名）→ cmdFor(id) 供事件映射
//   - 保留类型化引用（labelAt/buttonAt/fieldAt 等），供应用层读控件状态
//
// ★ MYP 编译器 ARC 限制（探针验证，本文件刻意规避，详见底部注释）：
//   - 类方法返回接口引用（View）→ 崩溃。规避：绝不返回 View。
//   - 通过 View 接口方法 addChild 传对象 → 崩溃。规避：add 一律用具体类型
//     局部变量（col.add(l) / p.add(t)），构建逻辑内联在各容器分支。
//   - View 接口字段暂存对象再 add → 崩溃。规避：不用接口字段暂存，构建即 add。
//   - View[] 接口数组存储不可靠 retain。规避：所有控件由具体类型数组
//     （labels_/buttons_/fields_/cols_/panels_）持有，保证跨方法存活。
//
// 纯逻辑不依赖 SDL，可 headless 测试。
import env;
import text;
import fmt;
import json;

class UixLoader {
    property:
        Json uix_;        // 界面描述文档
        Json usp_;        // 样式表文档（可为空）
        // 节点注册表（id → View/type/class 并行数组；nodes_ 仅用于查找/命中）
        View[] nodes_;
        string[] ids_;
        string[] types_;
        string[] classes_;
        int nodeCount_;
        // 绑定表（控件 id, 目标属性, VM 属性路径）
        string[] bindIds_;
        string[] bindProps_;
        string[] bindPaths_;
        int bindCount_;
        // 命令表（控件 id → 命令名）
        string[] cmdIds_;
        string[] cmdNames_;
        int cmdCount_;
        // 选择器暂存（parseSel 输出）
        string selType_;
        string selId_;
        string selClass_;
        // 类型化引用（具体数组——ARC 可靠 retain，控件存活于此）
        Label[] labels_;
        string[] labelIds_;
        int labelCount_;
        Button[] buttons_;
        string[] buttonIds_;
        int buttonCount_;
        TextField[] fields_;
        string[] fieldIds_;
        int fieldCount_;
        LinearLayout[] cols_;
        string[] colIds_;
        int colCount_;
        Panel[] panels_;
        string[] panelIds_;
        int panelCount_;
        Switch[] switches_;
        string[] switchIds_;
        int switchCount_;
        Checkbox[] checkboxes_;
        string[] checkboxIds_;
        int checkboxCount_;
        Slider[] sliders_;
        string[] sliderIds_;
        int sliderCount_;
        ProgressBar[] progressbars_;
        string[] progressbarIds_;
        int progressbarCount_;
        FlowLayout[] flows_;
        string[] flowIds_;
        int flowCount_;
        StackLayout[] stacks_;
        string[] stackIds_;
        int stackCount_;
        // 控件注册表（UIX 扩展点：自定义控件类型 → ViewBuilder）
        string[] regTypes_;
        ViewBuilder[] regBuilders_;
        int regCount_;
        // 自定义控件持有（尽力持有；MYP 接口数组不 retain，构建器实现须持有实例）
        View[] held_;
        int heldCount_;
        // QML 风格计算属性（expr 表达式表）
        string[] exprIds_;
        string[] exprProps_;
        string[] exprSrcs_;
        int exprCount_;
        // 节点属性袋（"id:name" → value；供表达式读其它节点属性）
        string[] propKeys_;
        string[] propVals_;
        int propCount_;
        // 节点父映射（与 nodes_ 对齐；供 parent.X 表达式）
        string[] parentIds_;
        // 状态表（节点 id, 状态名 → 属性 k/v）
        string[] stIds_;
        string[] stNames_;
        string[] stKeys_;
        string[] stVals_;
        int stCount_;
        // 初始状态（构建后应用）
        string[] initStId_;
        string[] initStName_;
        int initStCount_;

    action:
        @constructor UixLoader(string uixJson, string uspJson) {
            uix_ = new Json(uixJson);
            if (Str.len(uspJson) > 0)
                usp_ = new Json(uspJson);
            else
                usp_ = null;
            nodes_ = new View[128];
            ids_ = new string[128];
            types_ = new string[128];
            classes_ = new string[128];
            nodeCount_ = 0;
            bindIds_ = new string[64];
            bindProps_ = new string[64];
            bindPaths_ = new string[64];
            bindCount_ = 0;
            cmdIds_ = new string[32];
            cmdNames_ = new string[32];
            cmdCount_ = 0;
            selType_ = "";
            selId_ = "";
            selClass_ = "";
            labels_ = new Label[64];
            labelIds_ = new string[64];
            labelCount_ = 0;
            buttons_ = new Button[64];
            buttonIds_ = new string[64];
            buttonCount_ = 0;
            fields_ = new TextField[64];
            fieldIds_ = new string[64];
            fieldCount_ = 0;
            cols_ = new LinearLayout[64];
            colIds_ = new string[64];
            colCount_ = 0;
            panels_ = new Panel[64];
            panelIds_ = new string[64];
            panelCount_ = 0;
            switches_ = new Switch[64];
            switchIds_ = new string[64];
            switchCount_ = 0;
            checkboxes_ = new Checkbox[64];
            checkboxIds_ = new string[64];
            checkboxCount_ = 0;
            sliders_ = new Slider[64];
            sliderIds_ = new string[64];
            sliderCount_ = 0;
            progressbars_ = new ProgressBar[64];
            progressbarIds_ = new string[64];
            progressbarCount_ = 0;
            flows_ = new FlowLayout[16];
            flowIds_ = new string[16];
            flowCount_ = 0;
            stacks_ = new StackLayout[16];
            stackIds_ = new string[16];
            stackCount_ = 0;
            regTypes_ = new string[16];
            regBuilders_ = new ViewBuilder[16];
            regCount_ = 0;
            held_ = new View[64];
            heldCount_ = 0;
            exprIds_ = new string[32];
            exprProps_ = new string[32];
            exprSrcs_ = new string[32];
            exprCount_ = 0;
            propKeys_ = new string[256];
            propVals_ = new string[256];
            propCount_ = 0;
            parentIds_ = new string[128];
            stIds_ = new string[64];
            stNames_ = new string[64];
            stKeys_ = new string[64];
            stVals_ = new string[64];
            stCount_ = 0;
            initStId_ = new string[16];
            initStName_ = new string[16];
            initStCount_ = 0;
        }

        // ---- 控件注册（UIX 扩展点）----
        // 注册自定义控件类型：.uix 中该 type 的节点由 builder.create 创建。
        // 实例加入 held_ 尽力持有；构建器实现须把实例存为字段（MYP 接口数组不 retain）。
        void registerControl(string type, ViewBuilder builder) {
            if (regCount_ >= 16) return;
            regTypes_[regCount_] = type;
            regBuilders_[regCount_] = builder;
            regCount_ = regCount_ + 1;
        }
        int regIdxOf(string type) {
            for (int i = 0; i < regCount_; i = i + 1) {
                if (regTypes_[i] == type) return i;
            }
            return -1;
        }

        // 构建整棵树：解析根节点并加入 rootView
        void buildInto(RootView rootView) {
            string rootType = uix_.getString("type");
            string id = getStr(uix_, "", "id");
            string cls = getStr(uix_, "", "class");
            if (rootType == "Column" || rootType == "Row") {
                int ori = rootType == "Row" ? 1 : 0;
                LinearLayout col = new LinearLayout(
                    ori, dim(uix_, "", "width", 200), dim(uix_, "", "height", 200));
                registerCol(col, id, rootType, cls);
                applyNode(uix_, "", col, id, cls);
                rootView.add(col);
                buildIntoCol(uix_, "", col);
                col.layout();
            } else if (rootType == "Panel") {
                Panel p = new Panel(getInt(uix_, "", "x"), getInt(uix_, "", "y"),
                                    dim(uix_, "", "width", 200), dim(uix_, "", "height", 200));
                registerPanel(p, id, rootType, cls);
                applyNode(uix_, "", p, id, cls);
                rootView.add(p);
                buildIntoPanel(uix_, "", p);
            } else if (rootType == "Label") {
                Label l = new Label(getStr(uix_, "", "text"),
                                    getInt(uix_, "", "x"), getInt(uix_, "", "y"),
                                    dim(uix_, "", "scale", 2));
                registerLabel(l, id, cls);
                applyNode(uix_, "", l, id, cls);
                rootView.add(l);
            } else if (rootType == "Button") {
                Button b = new Button(getStr(uix_, "", "text"),
                                      getInt(uix_, "", "x"), getInt(uix_, "", "y"),
                                      dim(uix_, "", "width", 120), dim(uix_, "", "height", 40));
                registerButton(b, id, cls);
                applyNode(uix_, "", b, id, cls);
                rootView.add(b);
            } else if (rootType == "TextField") {
                TextField t = new TextField(getStr(uix_, "", "text"),
                                            getInt(uix_, "", "x"), getInt(uix_, "", "y"),
                                            dim(uix_, "", "width", 240), dim(uix_, "", "height", 36));
                registerField(t, id, cls);
                applyNode(uix_, "", t, id, cls);
                rootView.add(t);
            } else if (rootType == "Switch") {
                Switch sw = new Switch(getInt(uix_, "", "x"), getInt(uix_, "", "y"),
                                       dim(uix_, "", "width", 60), dim(uix_, "", "height", 32));
                registerSwitch(sw, id, cls);
                applyNode(uix_, "", sw, id, cls);
                rootView.add(sw);
            } else if (rootType == "Checkbox") {
                Checkbox cb = new Checkbox(getStr(uix_, "", "text"),
                                           getInt(uix_, "", "x"), getInt(uix_, "", "y"),
                                           dim(uix_, "", "width", 80), dim(uix_, "", "height", 24));
                registerCheckbox(cb, id, cls);
                applyNode(uix_, "", cb, id, cls);
                rootView.add(cb);
            } else if (rootType == "Slider") {
                Slider sl = new Slider(getInt(uix_, "", "x"), getInt(uix_, "", "y"),
                                       dim(uix_, "", "width", 160), dim(uix_, "", "height", 24),
                                       dim(uix_, "", "min", 0), dim(uix_, "", "max", 100));
                registerSlider(sl, id, cls);
                applyNode(uix_, "", sl, id, cls);
                rootView.add(sl);
            } else if (rootType == "ProgressBar") {
                ProgressBar pb = new ProgressBar(getInt(uix_, "", "x"), getInt(uix_, "", "y"),
                                                 dim(uix_, "", "width", 160), dim(uix_, "", "height", 16),
                                                 dim(uix_, "", "min", 0), dim(uix_, "", "max", 100));
                registerProgressBar(pb, id, cls);
                applyNode(uix_, "", pb, id, cls);
                rootView.add(pb);
            } else if (rootType == "Flow") {
                FlowLayout f = new FlowLayout(
                    dim(uix_, "", "width", 200), dim(uix_, "", "height", 200));
                registerFlow(f, id, rootType, cls);
                applyNode(uix_, "", f, id, cls);
                rootView.add(f);
                buildIntoFlow(uix_, "", f);
                f.layout();
            } else if (rootType == "Stack") {
                StackLayout s = new StackLayout(
                    dim(uix_, "", "width", 200), dim(uix_, "", "height", 200));
                registerStack(s, id, rootType, cls);
                applyNode(uix_, "", s, id, cls);
                rootView.add(s);
                buildIntoStack(uix_, "", s);
                s.layout();
            }
            // 构建后处理：父映射 → 初始状态 → 重算计算属性
            indexParents();
            applyInitialStates();
            refresh();
        }

        // 构建 col 的所有子节点（add 一律用具体类型局部变量）
        void buildIntoCol(Json doc, string prefix, LinearLayout col) {
            int n = doc.arrayLen(prefix + "children");
            for (int i = 0; i < n; i = i + 1) {
                string cp = prefix + "children." + Fmt.i(i) + ".";
                string ct = doc.getString(cp + "type");
                string cid = getStr(doc, cp, "id");
                string ccls = getStr(doc, cp, "class");
                if (ct == "Label") {
                    Label l = new Label(getStr(doc, cp, "text"),
                                        getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                        dim(doc, cp, "scale", 2));
                    registerLabel(l, cid, ccls);
                    applyNode(doc, cp, l, cid, ccls);
                    col.add(l);
                } else if (ct == "Button") {
                    Button b = new Button(getStr(doc, cp, "text"),
                                          getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                          dim(doc, cp, "width", 120), dim(doc, cp, "height", 40));
                    registerButton(b, cid, ccls);
                    applyNode(doc, cp, b, cid, ccls);
                    col.add(b);
                } else if (ct == "TextField") {
                    TextField t = new TextField(getStr(doc, cp, "text"),
                                                getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                                dim(doc, cp, "width", 240), dim(doc, cp, "height", 36));
                    registerField(t, cid, ccls);
                    applyNode(doc, cp, t, cid, ccls);
                    col.add(t);
                } else if (ct == "Switch") {
                    Switch sw = new Switch(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                           dim(doc, cp, "width", 60), dim(doc, cp, "height", 32));
                    registerSwitch(sw, cid, ccls);
                    applyNode(doc, cp, sw, cid, ccls);
                    col.add(sw);
                } else if (ct == "Checkbox") {
                    Checkbox cb = new Checkbox(getStr(doc, cp, "text"),
                                               getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                               dim(doc, cp, "width", 80), dim(doc, cp, "height", 24));
                    registerCheckbox(cb, cid, ccls);
                    applyNode(doc, cp, cb, cid, ccls);
                    col.add(cb);
                } else if (ct == "Slider") {
                    Slider sl = new Slider(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                           dim(doc, cp, "width", 160), dim(doc, cp, "height", 24),
                                           dim(doc, cp, "min", 0), dim(doc, cp, "max", 100));
                    registerSlider(sl, cid, ccls);
                    applyNode(doc, cp, sl, cid, ccls);
                    col.add(sl);
                } else if (ct == "ProgressBar") {
                    ProgressBar pb = new ProgressBar(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                                     dim(doc, cp, "width", 160), dim(doc, cp, "height", 16),
                                                     dim(doc, cp, "min", 0), dim(doc, cp, "max", 100));
                    registerProgressBar(pb, cid, ccls);
                    applyNode(doc, cp, pb, cid, ccls);
                    col.add(pb);
                } else if (ct == "Column" || ct == "Row") {
                    int ori = ct == "Row" ? 1 : 0;
                    LinearLayout c2 = new LinearLayout(
                        ori, dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerCol(c2, cid, ct, ccls);
                    applyNode(doc, cp, c2, cid, ccls);
                    col.add(c2);
                    buildIntoCol(doc, cp, c2);
                    c2.layout();
                } else if (ct == "Panel") {
                    Panel p = new Panel(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                        dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerPanel(p, cid, ct, ccls);
                    applyNode(doc, cp, p, cid, ccls);
                    col.add(p);
                    buildIntoPanel(doc, cp, p);
                } else if (ct == "Flow") {
                    FlowLayout f2 = new FlowLayout(
                        dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerFlow(f2, cid, ct, ccls);
                    applyNode(doc, cp, f2, cid, ccls);
                    col.add(f2);
                    buildIntoFlow(doc, cp, f2);
                    f2.layout();
                } else if (ct == "Stack") {
                    StackLayout s2 = new StackLayout(
                        dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerStack(s2, cid, ct, ccls);
                    applyNode(doc, cp, s2, cid, ccls);
                    col.add(s2);
                    buildIntoStack(doc, cp, s2);
                    s2.layout();
                } else if (ct == "Repeater") {
                    buildRepeater(doc, cp, cid, 0, col, null, null, null);
                } else {
                    // 自定义控件（UIX 扩展点）：注册的 ViewBuilder 创建
                    int ri = regIdxOf(ct);
                    if (ri >= 0) {
                        View v = regBuilders_[ri].create(getStr(doc, cp, "text"), cid);
                        if (v != null) {
                            registerNode(v, cid, ct, ccls);
                            applyNode(doc, cp, v, cid, ccls);
                            if (heldCount_ < 64) {
                                held_[heldCount_] = v;
                                heldCount_ = heldCount_ + 1;
                            }
                            col.add(v);
                        }
                    }
                }
            }
        }

        // 构建 p 的所有子节点（同 buildIntoCol，add 目标为 Panel）
        void buildIntoPanel(Json doc, string prefix, Panel p) {
            int n = doc.arrayLen(prefix + "children");
            for (int i = 0; i < n; i = i + 1) {
                string cp = prefix + "children." + Fmt.i(i) + ".";
                string ct = doc.getString(cp + "type");
                string cid = getStr(doc, cp, "id");
                string ccls = getStr(doc, cp, "class");
                if (ct == "Label") {
                    Label l = new Label(getStr(doc, cp, "text"),
                                        getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                        dim(doc, cp, "scale", 2));
                    registerLabel(l, cid, ccls);
                    applyNode(doc, cp, l, cid, ccls);
                    p.add(l);
                } else if (ct == "Button") {
                    Button b = new Button(getStr(doc, cp, "text"),
                                          getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                          dim(doc, cp, "width", 120), dim(doc, cp, "height", 40));
                    registerButton(b, cid, ccls);
                    applyNode(doc, cp, b, cid, ccls);
                    p.add(b);
                } else if (ct == "TextField") {
                    TextField t = new TextField(getStr(doc, cp, "text"),
                                                getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                                dim(doc, cp, "width", 240), dim(doc, cp, "height", 36));
                    registerField(t, cid, ccls);
                    applyNode(doc, cp, t, cid, ccls);
                    p.add(t);
                } else if (ct == "Switch") {
                    Switch sw = new Switch(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                           dim(doc, cp, "width", 60), dim(doc, cp, "height", 32));
                    registerSwitch(sw, cid, ccls);
                    applyNode(doc, cp, sw, cid, ccls);
                    p.add(sw);
                } else if (ct == "Checkbox") {
                    Checkbox cb = new Checkbox(getStr(doc, cp, "text"),
                                               getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                               dim(doc, cp, "width", 80), dim(doc, cp, "height", 24));
                    registerCheckbox(cb, cid, ccls);
                    applyNode(doc, cp, cb, cid, ccls);
                    p.add(cb);
                } else if (ct == "Slider") {
                    Slider sl = new Slider(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                           dim(doc, cp, "width", 160), dim(doc, cp, "height", 24),
                                           dim(doc, cp, "min", 0), dim(doc, cp, "max", 100));
                    registerSlider(sl, cid, ccls);
                    applyNode(doc, cp, sl, cid, ccls);
                    p.add(sl);
                } else if (ct == "ProgressBar") {
                    ProgressBar pb = new ProgressBar(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                                     dim(doc, cp, "width", 160), dim(doc, cp, "height", 16),
                                                     dim(doc, cp, "min", 0), dim(doc, cp, "max", 100));
                    registerProgressBar(pb, cid, ccls);
                    applyNode(doc, cp, pb, cid, ccls);
                    p.add(pb);
                } else if (ct == "Column" || ct == "Row") {
                    int ori = ct == "Row" ? 1 : 0;
                    LinearLayout c2 = new LinearLayout(
                        ori, dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerCol(c2, cid, ct, ccls);
                    applyNode(doc, cp, c2, cid, ccls);
                    p.add(c2);
                    buildIntoCol(doc, cp, c2);
                    c2.layout();
                } else if (ct == "Panel") {
                    Panel p2 = new Panel(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                         dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerPanel(p2, cid, ct, ccls);
                    applyNode(doc, cp, p2, cid, ccls);
                    p.add(p2);
                    buildIntoPanel(doc, cp, p2);
                } else if (ct == "Flow") {
                    FlowLayout f2 = new FlowLayout(
                        dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerFlow(f2, cid, ct, ccls);
                    applyNode(doc, cp, f2, cid, ccls);
                    p.add(f2);
                    buildIntoFlow(doc, cp, f2);
                    f2.layout();
                } else if (ct == "Stack") {
                    StackLayout s2 = new StackLayout(
                        dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerStack(s2, cid, ct, ccls);
                    applyNode(doc, cp, s2, cid, ccls);
                    p.add(s2);
                    buildIntoStack(doc, cp, s2);
                    s2.layout();
                } else if (ct == "Repeater") {
                    buildRepeater(doc, cp, cid, 1, null, p, null, null);
                } else {
                    // 自定义控件（UIX 扩展点）：注册的 ViewBuilder 创建
                    int ri = regIdxOf(ct);
                    if (ri >= 0) {
                        View v = regBuilders_[ri].create(getStr(doc, cp, "text"), cid);
                        if (v != null) {
                            registerNode(v, cid, ct, ccls);
                            applyNode(doc, cp, v, cid, ccls);
                            if (heldCount_ < 64) {
                                held_[heldCount_] = v;
                                heldCount_ = heldCount_ + 1;
                            }
                            p.add(v);
                        }
                    }
                }
            }
        }

        // 构建 flow 的所有子节点（同 buildIntoCol，add 目标为 FlowLayout）
        void buildIntoFlow(Json doc, string prefix, FlowLayout flow) {
            int n = doc.arrayLen(prefix + "children");
            for (int i = 0; i < n; i = i + 1) {
                string cp = prefix + "children." + Fmt.i(i) + ".";
                string ct = doc.getString(cp + "type");
                string cid = getStr(doc, cp, "id");
                string ccls = getStr(doc, cp, "class");
                if (ct == "Label") {
                    Label l = new Label(getStr(doc, cp, "text"),
                                        getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                        dim(doc, cp, "scale", 2));
                    registerLabel(l, cid, ccls);
                    applyNode(doc, cp, l, cid, ccls);
                    flow.add(l);
                } else if (ct == "Button") {
                    Button b = new Button(getStr(doc, cp, "text"),
                                          getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                          dim(doc, cp, "width", 120), dim(doc, cp, "height", 40));
                    registerButton(b, cid, ccls);
                    applyNode(doc, cp, b, cid, ccls);
                    flow.add(b);
                } else if (ct == "TextField") {
                    TextField t = new TextField(getStr(doc, cp, "text"),
                                                getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                                dim(doc, cp, "width", 240), dim(doc, cp, "height", 36));
                    registerField(t, cid, ccls);
                    applyNode(doc, cp, t, cid, ccls);
                    flow.add(t);
                } else if (ct == "Switch") {
                    Switch sw = new Switch(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                           dim(doc, cp, "width", 60), dim(doc, cp, "height", 32));
                    registerSwitch(sw, cid, ccls);
                    applyNode(doc, cp, sw, cid, ccls);
                    flow.add(sw);
                } else if (ct == "Checkbox") {
                    Checkbox cb = new Checkbox(getStr(doc, cp, "text"),
                                               getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                               dim(doc, cp, "width", 80), dim(doc, cp, "height", 24));
                    registerCheckbox(cb, cid, ccls);
                    applyNode(doc, cp, cb, cid, ccls);
                    flow.add(cb);
                } else if (ct == "Slider") {
                    Slider sl = new Slider(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                           dim(doc, cp, "width", 160), dim(doc, cp, "height", 24),
                                           dim(doc, cp, "min", 0), dim(doc, cp, "max", 100));
                    registerSlider(sl, cid, ccls);
                    applyNode(doc, cp, sl, cid, ccls);
                    flow.add(sl);
                } else if (ct == "ProgressBar") {
                    ProgressBar pb = new ProgressBar(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                                     dim(doc, cp, "width", 160), dim(doc, cp, "height", 16),
                                                     dim(doc, cp, "min", 0), dim(doc, cp, "max", 100));
                    registerProgressBar(pb, cid, ccls);
                    applyNode(doc, cp, pb, cid, ccls);
                    flow.add(pb);
                } else if (ct == "Column" || ct == "Row") {
                    int ori = ct == "Row" ? 1 : 0;
                    LinearLayout c2 = new LinearLayout(
                        ori, dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerCol(c2, cid, ct, ccls);
                    applyNode(doc, cp, c2, cid, ccls);
                    flow.add(c2);
                    buildIntoCol(doc, cp, c2);
                    c2.layout();
                } else if (ct == "Panel") {
                    Panel p2 = new Panel(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                         dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerPanel(p2, cid, ct, ccls);
                    applyNode(doc, cp, p2, cid, ccls);
                    flow.add(p2);
                    buildIntoPanel(doc, cp, p2);
                } else if (ct == "Flow") {
                    FlowLayout f2 = new FlowLayout(
                        dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerFlow(f2, cid, ct, ccls);
                    applyNode(doc, cp, f2, cid, ccls);
                    flow.add(f2);
                    buildIntoFlow(doc, cp, f2);
                    f2.layout();
                } else if (ct == "Stack") {
                    StackLayout s2 = new StackLayout(
                        dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerStack(s2, cid, ct, ccls);
                    applyNode(doc, cp, s2, cid, ccls);
                    flow.add(s2);
                    buildIntoStack(doc, cp, s2);
                    s2.layout();
                } else if (ct == "Repeater") {
                    buildRepeater(doc, cp, cid, 2, null, null, flow, null);
                } else {
                    // 自定义控件（UIX 扩展点）：注册的 ViewBuilder 创建
                    int ri = regIdxOf(ct);
                    if (ri >= 0) {
                        View v = regBuilders_[ri].create(getStr(doc, cp, "text"), cid);
                        if (v != null) {
                            registerNode(v, cid, ct, ccls);
                            applyNode(doc, cp, v, cid, ccls);
                            if (heldCount_ < 64) {
                                held_[heldCount_] = v;
                                heldCount_ = heldCount_ + 1;
                            }
                            flow.add(v);
                        }
                    }
                }
            }
        }

        // 构建 stack 的所有子节点（同 buildIntoCol，add 目标为 StackLayout）
        void buildIntoStack(Json doc, string prefix, StackLayout stack) {
            int n = doc.arrayLen(prefix + "children");
            for (int i = 0; i < n; i = i + 1) {
                string cp = prefix + "children." + Fmt.i(i) + ".";
                string ct = doc.getString(cp + "type");
                string cid = getStr(doc, cp, "id");
                string ccls = getStr(doc, cp, "class");
                if (ct == "Label") {
                    Label l = new Label(getStr(doc, cp, "text"),
                                        getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                        dim(doc, cp, "scale", 2));
                    registerLabel(l, cid, ccls);
                    applyNode(doc, cp, l, cid, ccls);
                    stack.add(l);
                } else if (ct == "Button") {
                    Button b = new Button(getStr(doc, cp, "text"),
                                          getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                          dim(doc, cp, "width", 120), dim(doc, cp, "height", 40));
                    registerButton(b, cid, ccls);
                    applyNode(doc, cp, b, cid, ccls);
                    stack.add(b);
                } else if (ct == "TextField") {
                    TextField t = new TextField(getStr(doc, cp, "text"),
                                                getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                                dim(doc, cp, "width", 240), dim(doc, cp, "height", 36));
                    registerField(t, cid, ccls);
                    applyNode(doc, cp, t, cid, ccls);
                    stack.add(t);
                } else if (ct == "Switch") {
                    Switch sw = new Switch(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                           dim(doc, cp, "width", 60), dim(doc, cp, "height", 32));
                    registerSwitch(sw, cid, ccls);
                    applyNode(doc, cp, sw, cid, ccls);
                    stack.add(sw);
                } else if (ct == "Checkbox") {
                    Checkbox cb = new Checkbox(getStr(doc, cp, "text"),
                                               getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                               dim(doc, cp, "width", 80), dim(doc, cp, "height", 24));
                    registerCheckbox(cb, cid, ccls);
                    applyNode(doc, cp, cb, cid, ccls);
                    stack.add(cb);
                } else if (ct == "Slider") {
                    Slider sl = new Slider(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                           dim(doc, cp, "width", 160), dim(doc, cp, "height", 24),
                                           dim(doc, cp, "min", 0), dim(doc, cp, "max", 100));
                    registerSlider(sl, cid, ccls);
                    applyNode(doc, cp, sl, cid, ccls);
                    stack.add(sl);
                } else if (ct == "ProgressBar") {
                    ProgressBar pb = new ProgressBar(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                                     dim(doc, cp, "width", 160), dim(doc, cp, "height", 16),
                                                     dim(doc, cp, "min", 0), dim(doc, cp, "max", 100));
                    registerProgressBar(pb, cid, ccls);
                    applyNode(doc, cp, pb, cid, ccls);
                    stack.add(pb);
                } else if (ct == "Column" || ct == "Row") {
                    int ori = ct == "Row" ? 1 : 0;
                    LinearLayout c2 = new LinearLayout(
                        ori, dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerCol(c2, cid, ct, ccls);
                    applyNode(doc, cp, c2, cid, ccls);
                    stack.add(c2);
                    buildIntoCol(doc, cp, c2);
                    c2.layout();
                } else if (ct == "Panel") {
                    Panel p2 = new Panel(getInt(doc, cp, "x"), getInt(doc, cp, "y"),
                                         dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerPanel(p2, cid, ct, ccls);
                    applyNode(doc, cp, p2, cid, ccls);
                    stack.add(p2);
                    buildIntoPanel(doc, cp, p2);
                } else if (ct == "Flow") {
                    FlowLayout f2 = new FlowLayout(
                        dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerFlow(f2, cid, ct, ccls);
                    applyNode(doc, cp, f2, cid, ccls);
                    stack.add(f2);
                    buildIntoFlow(doc, cp, f2);
                    f2.layout();
                } else if (ct == "Stack") {
                    StackLayout s2 = new StackLayout(
                        dim(doc, cp, "width", 200), dim(doc, cp, "height", 200));
                    registerStack(s2, cid, ct, ccls);
                    applyNode(doc, cp, s2, cid, ccls);
                    stack.add(s2);
                    buildIntoStack(doc, cp, s2);
                    s2.layout();
                } else if (ct == "Repeater") {
                    buildRepeater(doc, cp, cid, 3, null, null, null, stack);
                } else {
                    // 自定义控件（UIX 扩展点）：注册的 ViewBuilder 创建
                    int ri = regIdxOf(ct);
                    if (ri >= 0) {
                        View v = regBuilders_[ri].create(getStr(doc, cp, "text"), cid);
                        if (v != null) {
                            registerNode(v, cid, ct, ccls);
                            applyNode(doc, cp, v, cid, ccls);
                            if (heldCount_ < 64) {
                                held_[heldCount_] = v;
                                heldCount_ = heldCount_ + 1;
                            }
                            stack.add(v);
                        }
                    }
                }
            }
        }

        // ---- QML 风格 Repeater（数据驱动列表）----
        // .uix 中 Repeater 节点：items（字符串或 {text} 数组）+ delegateType。
        // 对每个 item 构建一个 delegateType 控件（text=item），id = 节点id_序号。
        void buildRepeater(Json doc, string prefix, string id,
                           int kind, LinearLayout col, Panel p,
                           FlowLayout flow, StackLayout stack) {
            string dType = doc.getString(prefix + "delegateType");
            string dCls = getStr(doc, prefix, "delegateClass");
            if (doc.type(prefix + "items") < 0) return;
            int n = doc.arrayLen(prefix + "items");
            for (int k = 0; k < n; k = k + 1) {
                string ip = prefix + "items." + Fmt.i(k);
                string itemText = "";
                int it = doc.type(ip);
                if (it == 4) itemText = doc.getString(ip);
                else if (it == 6) itemText = doc.getString(ip + ".text");
                string cid = id + "_" + Fmt.i(k);
                if (dType == "Label") {
                    Label l = new Label(itemText, 0, 0, 2);
                    registerLabel(l, cid, dCls);
                    applyNode(doc, prefix, l, cid, dCls);
                    addToContainer(kind, col, p, flow, stack, l);
                } else if (dType == "Button") {
                    Button b = new Button(itemText, 0, 0, 120, 40);
                    registerButton(b, cid, dCls);
                    applyNode(doc, prefix, b, cid, dCls);
                    addToContainer(kind, col, p, flow, stack, b);
                } else if (dType == "Checkbox") {
                    Checkbox cb = new Checkbox(itemText, 0, 0, 80, 24);
                    registerCheckbox(cb, cid, dCls);
                    applyNode(doc, prefix, cb, cid, dCls);
                    addToContainer(kind, col, p, flow, stack, cb);
                } else if (dType == "Switch") {
                    Switch sw = new Switch(0, 0, 60, 32);
                    registerSwitch(sw, cid, dCls);
                    applyNode(doc, prefix, sw, cid, dCls);
                    addToContainer(kind, col, p, flow, stack, sw);
                }
            }
        }
        // add 到 kind 容器（0=col 1=panel 2=flow 3=stack）
        void addToContainer(int kind, LinearLayout col, Panel p,
                            FlowLayout flow, StackLayout stack, View v) {
            if (kind == 0) col.add(v);
            else if (kind == 1) p.add(v);
            else if (kind == 2) flow.add(v);
            else stack.add(v);
        }

        // ---- 查找（idxOf + At 模式，避免 return null）----
        int idxOf(string id) {
            for (int i = 0; i < nodeCount_; i = i + 1) {
                if (ids_[i] == id) return i;
            }
            return -1;
        }
        View nodeAt(int i) { return nodes_[i]; }
        string idAt(int i) { return ids_[i]; }
        string typeOf(string id) {
            int i = idxOf(id);
            if (i < 0) return "";
            return types_[i];
        }

        int labelIdxOf(string id) {
            for (int i = 0; i < labelCount_; i = i + 1) {
                if (labelIds_[i] == id) return i;
            }
            return -1;
        }
        Label labelAt(int i) { return labels_[i]; }
        int buttonIdxOf(string id) {
            for (int i = 0; i < buttonCount_; i = i + 1) {
                if (buttonIds_[i] == id) return i;
            }
            return -1;
        }
        Button buttonAt(int i) { return buttons_[i]; }
        int fieldIdxOf(string id) {
            for (int i = 0; i < fieldCount_; i = i + 1) {
                if (fieldIds_[i] == id) return i;
            }
            return -1;
        }
        TextField fieldAt(int i) { return fields_[i]; }
        int switchIdxOf(string id) {
            for (int i = 0; i < switchCount_; i = i + 1) {
                if (switchIds_[i] == id) return i;
            }
            return -1;
        }
        Switch switchAt(int i) { return switches_[i]; }
        int checkboxIdxOf(string id) {
            for (int i = 0; i < checkboxCount_; i = i + 1) {
                if (checkboxIds_[i] == id) return i;
            }
            return -1;
        }
        Checkbox checkboxAt(int i) { return checkboxes_[i]; }
        int sliderIdxOf(string id) {
            for (int i = 0; i < sliderCount_; i = i + 1) {
                if (sliderIds_[i] == id) return i;
            }
            return -1;
        }
        Slider sliderAt(int i) { return sliders_[i]; }
        int progressbarIdxOf(string id) {
            for (int i = 0; i < progressbarCount_; i = i + 1) {
                if (progressbarIds_[i] == id) return i;
            }
            return -1;
        }
        ProgressBar progressbarAt(int i) { return progressbars_[i]; }
        int flowIdxOf(string id) {
            for (int i = 0; i < flowCount_; i = i + 1) {
                if (flowIds_[i] == id) return i;
            }
            return -1;
        }
        FlowLayout flowAt(int i) { return flows_[i]; }
        int stackIdxOf(string id) {
            for (int i = 0; i < stackCount_; i = i + 1) {
                if (stackIds_[i] == id) return i;
            }
            return -1;
        }
        StackLayout stackAt(int i) { return stacks_[i]; }

        // 按 id 查命令名（未注册返回空串）
        string cmdFor(string id) {
            for (int i = 0; i < cmdCount_; i = i + 1) {
                if (cmdIds_[i] == id) return cmdNames_[i];
            }
            return "";
        }

        // 命中最上层节点的 id（后注册者优先）；未命中返回空串
        string hitId(int x, int y) {
            for (int i = nodeCount_ - 1; i >= 0; i = i - 1) {
                if (nodes_[i].hit(x, y) != 0) return ids_[i];
            }
            return "";
        }

        // 绑定刷新：把 VM 各绑定属性的当前值写入对应控件
        void sync(ViewModel vm) {
            for (int i = 0; i < bindCount_; i = i + 1) {
                int ni = idxOf(bindIds_[i]);
                if (ni < 0) continue;
                string val = vm.getProp(bindPaths_[i]);
                nodes_[ni].setAttr(bindProps_[i], val);
            }
        }

        // 统计（测试用）
        int nodeCount() { return nodeCount_; }
        int bindCount() { return bindCount_; }
        int cmdCount() { return cmdCount_; }

        // 构造后处理：非构造参数属性（setAttr）+ 样式 + 绑定/命令注册
        void applyNode(Json doc, string prefix, View v,
                       string id, string cls) {
            // 通用属性（color/bg）
            if (doc.type(prefix + "color") >= 0)
                v.setAttr("color", doc.getString(prefix + "color"));
            else if (doc.type(prefix + "bg") >= 0)
                v.setAttr("bg", doc.getString(prefix + "bg"));
            // 布局属性（padding/spacing）
            if (doc.type(prefix + "padding") >= 0)
                v.setAttr("padding", Fmt.i(doc.getInt(prefix + "padding")));
            if (doc.type(prefix + "spacing") >= 0)
                v.setAttr("spacing", Fmt.i(doc.getInt(prefix + "spacing")));
            // 专属/状态属性（各控件 setAttr 处理；控件不支持则静默忽略）
            if (doc.type(prefix + "text") >= 0)
                v.setAttr("text", doc.getString(prefix + "text"));
            if (doc.type(prefix + "scale") >= 0)
                v.setAttr("scale", Fmt.i(doc.getInt(prefix + "scale")));
            if (doc.type(prefix + "on") >= 0)
                v.setAttr("on", Fmt.i(doc.getInt(prefix + "on")));
            if (doc.type(prefix + "checked") >= 0)
                v.setAttr("checked", Fmt.i(doc.getInt(prefix + "checked")));
            if (doc.type(prefix + "value") >= 0)
                v.setAttr("value", Fmt.i(doc.getInt(prefix + "value")));
            if (doc.type(prefix + "min") >= 0)
                v.setAttr("min", Fmt.i(doc.getInt(prefix + "min")));
            if (doc.type(prefix + "max") >= 0)
                v.setAttr("max", Fmt.i(doc.getInt(prefix + "max")));
            // 样式表
            applyStyles(v, id, cls);
            // 绑定：bind = VM 属性路径；bindProp = 控件属性（缺省 text）
            if (doc.type(prefix + "bind") >= 0) {
                string path = doc.getString(prefix + "bind");
                string prop = "text";
                if (doc.type(prefix + "bindProp") >= 0)
                    prop = doc.getString(prefix + "bindProp");
                if (bindCount_ < 64) {
                    bindIds_[bindCount_] = id;
                    bindProps_[bindCount_] = prop;
                    bindPaths_[bindCount_] = path;
                    bindCount_ = bindCount_ + 1;
                }
            }
            // 命令：onCmd = VM 命令名（事件映射后经 cmdFor 查）
            if (doc.type(prefix + "onCmd") >= 0) {
                if (cmdCount_ < 32) {
                    cmdIds_[cmdCount_] = id;
                    cmdNames_[cmdCount_] = doc.getString(prefix + "onCmd");
                    cmdCount_ = cmdCount_ + 1;
                }
            }
            // 属性袋记录（供表达式读其它节点属性）
            recordProps(doc, prefix, id);
            // 计算属性（expr）：QML 风格表达式 → 控件属性（bindProp，缺省 text）
            if (doc.type(prefix + "expr") >= 0) {
                if (exprCount_ < 32) {
                    exprIds_[exprCount_] = id;
                    exprProps_[exprCount_] = "text";
                    if (doc.type(prefix + "bindProp") >= 0)
                        exprProps_[exprCount_] = doc.getString(prefix + "bindProp");
                    exprSrcs_[exprCount_] = doc.getString(prefix + "expr");
                    exprCount_ = exprCount_ + 1;
                }
            }
            // 状态（states 声明 + 初始 state）
            registerStates(doc, prefix, id);
        }

        // 把构造/声明属性写入属性袋（"id:name" → value）
        void recordProps(Json doc, string prefix, string id) {
            if (doc.type(prefix + "text") >= 0)
                storeProp(id, "text", doc.getString(prefix + "text"));
            if (doc.type(prefix + "color") >= 0)
                storeProp(id, "color", doc.getString(prefix + "color"));
            else if (doc.type(prefix + "bg") >= 0)
                storeProp(id, "color", doc.getString(prefix + "bg"));
            if (doc.type(prefix + "padding") >= 0)
                storeProp(id, "padding", Fmt.i(doc.getInt(prefix + "padding")));
            if (doc.type(prefix + "spacing") >= 0)
                storeProp(id, "spacing", Fmt.i(doc.getInt(prefix + "spacing")));
            if (doc.type(prefix + "scale") >= 0)
                storeProp(id, "scale", Fmt.i(doc.getInt(prefix + "scale")));
            if (doc.type(prefix + "on") >= 0)
                storeProp(id, "on", Fmt.i(doc.getInt(prefix + "on")));
            if (doc.type(prefix + "checked") >= 0)
                storeProp(id, "checked", Fmt.i(doc.getInt(prefix + "checked")));
            if (doc.type(prefix + "value") >= 0)
                storeProp(id, "value", Fmt.i(doc.getInt(prefix + "value")));
            if (doc.type(prefix + "min") >= 0)
                storeProp(id, "min", Fmt.i(doc.getInt(prefix + "min")));
            if (doc.type(prefix + "max") >= 0)
                storeProp(id, "max", Fmt.i(doc.getInt(prefix + "max")));
        }

        // ---- QML 风格计算属性（expr）+ 状态（states）----
        // 重算所有计算属性：表达式求值 → setAttr + 写属性袋。
        // 应用层在 VM 变化 / 状态切换后调用，实现类 QML 响应式刷新。
        void refresh() {
            for (int i = 0; i < exprCount_; i = i + 1) {
                UixExpr e = new UixExpr(exprSrcs_[i]);
                UixVal v = e.eval(this, exprIds_[i]);
                string val = v.toStr();
                int ni = idxOf(exprIds_[i]);
                if (ni >= 0) nodes_[ni].setAttr(exprProps_[i], val);
                storeProp(exprIds_[i], exprProps_[i], val);
            }
        }

        // 注册节点的 states 声明与初始 state
        void registerStates(Json doc, string prefix, string id) {
            if (doc.type(prefix + "states") >= 0) {
                int sn = doc.arrayLen(prefix + "states");
                for (int i = 0; i < sn; i = i + 1) {
                    string sp = prefix + "states." + Fmt.i(i) + ".";
                    string nm = doc.getString(sp + "name");
                    int pn = doc.arrayLen(sp + "props");
                    for (int j = 0; j < pn; j = j + 1) {
                        if (stCount_ >= 64) return;
                        stIds_[stCount_] = id;
                        stNames_[stCount_] = nm;
                        stKeys_[stCount_] = doc.getString(sp + "props." + Fmt.i(j) + ".k");
                        stVals_[stCount_] = doc.getString(sp + "props." + Fmt.i(j) + ".v");
                        stCount_ = stCount_ + 1;
                    }
                }
            }
            if (doc.type(prefix + "state") >= 0) {
                if (initStCount_ < 16) {
                    initStId_[initStCount_] = id;
                    initStName_[initStCount_] = doc.getString(prefix + "state");
                    initStCount_ = initStCount_ + 1;
                }
            }
        }

        // 应用节点状态：写入状态属性（setAttr + 属性袋），随后重算表达式
        void setState(string id, string name) {
            int ni = idxOf(id);
            for (int i = 0; i < stCount_; i = i + 1) {
                if (stIds_[i] != id) continue;
                if (stNames_[i] != name) continue;
                if (ni >= 0) nodes_[ni].setAttr(stKeys_[i], stVals_[i]);
                storeProp(id, stKeys_[i], stVals_[i]);
            }
            refresh();
        }

        // 应用初始 state（构建后，不触发多次 refresh）
        void applyInitialStates() {
            for (int i = 0; i < initStCount_; i = i + 1) {
                int ni = idxOf(initStId_[i]);
                string id = initStId_[i];
                string name = initStName_[i];
                for (int j = 0; j < stCount_; j = j + 1) {
                    if (stIds_[j] != id) continue;
                    if (stNames_[j] != name) continue;
                    if (ni >= 0) nodes_[ni].setAttr(stKeys_[j], stVals_[j]);
                    storeProp(id, stKeys_[j], stVals_[j]);
                }
            }
        }

        // 属性袋读写
        void storeProp(string id, string name, string val) {
            string key = id + ":" + name;
            for (int i = 0; i < propCount_; i = i + 1) {
                if (propKeys_[i] == key) { propVals_[i] = val; return; }
            }
            if (propCount_ >= 256) return;
            propKeys_[propCount_] = key;
            propVals_[propCount_] = val;
            propCount_ = propCount_ + 1;
        }
        string propOf(string id, string name) {
            string key = id + ":" + name;
            for (int i = 0; i < propCount_; i = i + 1) {
                if (propKeys_[i] == key) return propVals_[i];
            }
            return "";
        }

        // 表达式解析支撑（QML 标识符解析）
        int hasId(string id) {
            if (idxOf(id) >= 0) return 1;
            return 0;
        }
        string parentIdOf(string id) {
            int i = idxOf(id);
            if (i < 0) return "";
            return parentIds_[i];
        }
        string rootId() {
            if (nodeCount_ <= 0) return "";
            return ids_[0];
        }
        double nodeWidth(string id) {
            int i = idxOf(id);
            if (i < 0) return 0.0;
            return double(nodes_[i].width());
        }
        double nodeHeight(string id) {
            int i = idxOf(id);
            if (i < 0) return 0.0;
            return double(nodes_[i].height());
        }
        // 构建后遍历 uix_ 树记录每个节点的父 id（供 parent.X）
        void indexParents() {
            string rid = getStr(uix_, "", "id");
            int ri = idxOf(rid);
            if (ri >= 0) parentIds_[ri] = "";
            walkParents("");
        }
        void walkParents(string prefix) {
            string id = getStr(uix_, prefix, "id");
            int n = uix_.arrayLen(prefix + "children");
            for (int i = 0; i < n; i = i + 1) {
                string cp = prefix + "children." + Fmt.i(i) + ".";
                string cid = getStr(uix_, cp, "id");
                int ci = idxOf(cid);
                if (ci >= 0) parentIds_[ci] = id;
                walkParents(cp);
            }
        }


        // 应用样式：遍历 .usp 选择器，匹配则把 props 写入控件
        void applyStyles(View v, string id, string cls) {
            if (usp_ == null) return;
            int n = usp_.arrayLen("");
            for (int i = 0; i < n; i = i + 1) {
                string sel = usp_.getString(Fmt.i(i) + ".sel");
                parseSel(sel);
                if (selType_ != "" && selType_ != typeOf(id)) continue;
                if (selId_ != "" && selId_ != id) continue;
                if (selClass_ != "" && selClass_ != cls) continue;
                // 应用该选择器的属性集
                int pn = usp_.arrayLen(Fmt.i(i) + ".props");
                for (int j = 0; j < pn; j = j + 1) {
                    string k = usp_.getString(
                        Fmt.i(i) + ".props." + Fmt.i(j) + ".k");
                    string val = usp_.getString(
                        Fmt.i(i) + ".props." + Fmt.i(j) + ".v");
                    v.setAttr(k, val);
                }
            }
        }

        // 解析选择器字符串 → selType_/selId_/selClass_
        // 支持：Type / Type#id / Type.class / .class / #id
        void parseSel(string sel) {
            selType_ = "";
            selId_ = "";
            selClass_ = "";
            int hashAt = Str.indexOf(sel, "#");
            int dotAt = Str.indexOf(sel, ".");
            if (hashAt >= 0) {
                selId_ = Str.substring(sel, hashAt + 1, Str.len(sel));
                string before = Str.substring(sel, 0, hashAt);
                int dot2 = Str.indexOf(before, ".");
                if (dot2 >= 0) {
                    selType_ = Str.substring(before, 0, dot2);
                    selClass_ = Str.substring(before, dot2 + 1, Str.len(before));
                } else {
                    selType_ = before;
                }
            } else if (dotAt >= 0) {
                selType_ = Str.substring(sel, 0, dotAt);
                selClass_ = Str.substring(sel, dotAt + 1, Str.len(sel));
            } else {
                selType_ = sel;
            }
        }

        // 通用注册：仅进节点注册表（nodes_ 供查找/命中，不依赖其 retain）
        void registerNode(View v, string id, string type, string cls) {
            if (id == "") return;
            if (nodeCount_ >= 128) return;
            nodes_[nodeCount_] = v;
            ids_[nodeCount_] = id;
            types_[nodeCount_] = type;
            classes_[nodeCount_] = cls;
            nodeCount_ = nodeCount_ + 1;
        }
        void registerLabel(Label l, string id, string cls) {
            registerNode(l, id, "Label", cls);
            if (labelCount_ >= 64) return;
            labels_[labelCount_] = l;
            labelIds_[labelCount_] = id;
            labelCount_ = labelCount_ + 1;
        }
        void registerButton(Button b, string id, string cls) {
            registerNode(b, id, "Button", cls);
            if (buttonCount_ >= 64) return;
            buttons_[buttonCount_] = b;
            buttonIds_[buttonCount_] = id;
            buttonCount_ = buttonCount_ + 1;
        }
        void registerField(TextField t, string id, string cls) {
            registerNode(t, id, "TextField", cls);
            if (fieldCount_ >= 64) return;
            fields_[fieldCount_] = t;
            fieldIds_[fieldCount_] = id;
            fieldCount_ = fieldCount_ + 1;
        }
        void registerCol(LinearLayout c, string id, string type, string cls) {
            registerNode(c, id, type, cls);
            if (colCount_ >= 64) return;
            cols_[colCount_] = c;
            colIds_[colCount_] = id;
            colCount_ = colCount_ + 1;
        }
        void registerPanel(Panel p, string id, string type, string cls) {
            registerNode(p, id, type, cls);
            if (panelCount_ >= 64) return;
            panels_[panelCount_] = p;
            panelIds_[panelCount_] = id;
            panelCount_ = panelCount_ + 1;
        }
        void registerSwitch(Switch s, string id, string cls) {
            registerNode(s, id, "Switch", cls);
            if (switchCount_ >= 64) return;
            switches_[switchCount_] = s;
            switchIds_[switchCount_] = id;
            switchCount_ = switchCount_ + 1;
        }
        void registerCheckbox(Checkbox c, string id, string cls) {
            registerNode(c, id, "Checkbox", cls);
            if (checkboxCount_ >= 64) return;
            checkboxes_[checkboxCount_] = c;
            checkboxIds_[checkboxCount_] = id;
            checkboxCount_ = checkboxCount_ + 1;
        }
        void registerSlider(Slider s, string id, string cls) {
            registerNode(s, id, "Slider", cls);
            if (sliderCount_ >= 64) return;
            sliders_[sliderCount_] = s;
            sliderIds_[sliderCount_] = id;
            sliderCount_ = sliderCount_ + 1;
        }
        void registerProgressBar(ProgressBar p, string id, string cls) {
            registerNode(p, id, "ProgressBar", cls);
            if (progressbarCount_ >= 64) return;
            progressbars_[progressbarCount_] = p;
            progressbarIds_[progressbarCount_] = id;
            progressbarCount_ = progressbarCount_ + 1;
        }
        void registerFlow(FlowLayout f, string id, string type, string cls) {
            registerNode(f, id, type, cls);
            if (flowCount_ >= 16) return;
            flows_[flowCount_] = f;
            flowIds_[flowCount_] = id;
            flowCount_ = flowCount_ + 1;
        }
        void registerStack(StackLayout s, string id, string type, string cls) {
            registerNode(s, id, type, cls);
            if (stackCount_ >= 16) return;
            stacks_[stackCount_] = s;
            stackIds_[stackCount_] = id;
            stackCount_ = stackCount_ + 1;
        }

        // 读属性（不存在返回空串）
        string getStr(Json doc, string prefix, string name) {
            if (doc.type(prefix + name) < 0) return "";
            return doc.getString(prefix + name);
        }
        // 读整数（不存在返回 0）
        int getInt(Json doc, string prefix, string name) {
            if (doc.type(prefix + name) < 0) return 0;
            return doc.getInt(prefix + name);
        }
        // 读尺寸（不存在返回缺省 def）
        int dim(Json doc, string prefix, string name, int def) {
            if (doc.type(prefix + name) < 0) return def;
            return doc.getInt(prefix + name);
        }
}
