// bnct_cases.myp — BNCT 治疗计划系统：病例管理页（复刻 Web dashboard 结构）
// ---------------------------------------------------------------------------
// 结构（对应截图）：
//   Header：系统标题「BNCT 治疗计划系统」+ 页面标题「病例管理」+ 用户区
//   搜索/筛选区：SearchBar（患者名/ID）+ 排序/来源 Dropdown + 操作按钮行
//   病例/序列选择：Dropdown（病例+序列）+「进入勾画」按钮
//   病例卡片网格：Card 列表（患者名/ID/元信息/详情/进入）
//   dark blue 主题（SDL.clear 深蓝背景 + Card 深色表面 + accent）
// 双模式：
//   - 默认：SDL 窗口界面（bash build.sh bnct_cases，ESC/关窗退出）
//   - BNCT_HEADLESS=1：headless 逻辑验证（搜索过滤/卡片事件输出断言）
// 运行：bash build.sh bnct_cases（需 backend/sdl_renderer.myp，build.sh 自动加）
import env;
import fmt;
import sdl;

// 事件绑定：卡片主/次操作 → 页面 handler
mapping() {
    Card.PrimaryAction -> BnctCases.onCardPrimary;
    Card.SecondaryAction -> BnctCases.onCardSecondary;
    SearchBar.Edited -> BnctCases.onSearch;
}

class BnctCases {
    property:
        // 病例数据（mock，对齐截图）
        string[8] pids_;
        string[8] ids_;
        string[8] metas_;
        int caseCount_;
        // 卡片网格
        Card[8] cards_;
        int cardCount_;        // 当前显示卡片数（搜索过滤后）
        int selected_;         // 选中病例索引（进入勾画）
        string enterPatient_;  // 最近一次「进入勾画」的患者
        // 控件
        SearchBar search_;
        Dropdown sortDrop_;
        Dropdown sourceDrop_;
        Dropdown caseDrop_;
        Dropdown seqDrop_;
        Button enterBtn_;
        Button newBtn_;
        Button deleteBtn_;
        Button pacsBtn_;
        string userName_;
        // Header 控件（字段：relayout 需要引用）
        Label headerTitle_;
        Label pageTitle_;
        Avatar userAv_;
        Label userLabel_;

    action:
        @constructor BnctCases() {
            // 病例数据
            pids_[0] = "Patient-7736D7";  ids_[0] = "ID-C4A0";
            metas_[0] = "1 个序列 · DICOM · 更新于 2026/8/10 08:54:10";
            pids_[1] = "Patient-305891";  ids_[1] = "ID-21F0";
            metas_[1] = "1 个序列 · DICOM · 更新于 2026/7/14 15:38:03";
            caseCount_ = 2;
            cardCount_ = 0;
            selected_ = -1;
            enterPatient_ = "";
            userName_ = "Doctor demo";
            for (int i = 0; i < 8; i = i + 1) {
                cards_[i] = new Card("", 0, 0, 300, 140);
                cards_[i].setActions("详情", "进入");
            }
        }

        // ---- 构建页面（控件 + 布局）----
        void build() {
            // 搜索/筛选区（对齐 ref 截图：1880x956 逻辑尺寸）
            search_ = new SearchBar(28, 84, 440, 42);
            sortDrop_ = new Dropdown(488, 84, 180, 42);
            sortDrop_.addItem("最近更新");
            sortDrop_.addItem("患者姓名");
            sortDrop_.setSelected(0);
            sourceDrop_ = new Dropdown(688, 84, 140, 42);
            sourceDrop_.addItem("全部");
            sourceDrop_.addItem("DICOM");
            sourceDrop_.setSelected(0);
            // 操作按钮行
            newBtn_ = new Button("+ 新建病例", 28, 146, 140, 38);
            deleteBtn_ = new Button("X 删除病例", 184, 146, 140, 38);
            pacsBtn_ = new Button("PACS 查询", 340, 146, 140, 38);
            // 病例/序列选择 + 进入勾画
            caseDrop_ = new Dropdown(28, 204, 360, 40);
            caseDrop_.addItem("Patient-305891 (ID-21F0)");
            caseDrop_.setSelected(0);
            seqDrop_ = new Dropdown(408, 204, 620, 40);
            seqDrop_.addItem("RTSTRUCT - Imported RT-STRUCT (254 slices)");
            seqDrop_.setSelected(0);
            enterBtn_ = new Button("进入勾画", 1050, 204, 130, 40);
            // 卡片网格
            filterCards("");
        }

        // ---- 搜索过滤：按患者名 / ID 过滤，重排卡片 ----
        void filterCards(string kw) {
            int n = 0;
            for (int i = 0; i < caseCount_; i = i + 1) {
                int hit = 0;
                if (Str.len(kw) == 0) hit = 1;
                else if (Str.contains(pids_[i], kw) != 0) hit = 1;
                else if (Str.contains(ids_[i], kw) != 0) hit = 1;
                if (hit != 0) {
                    cards_[n].setTitle(pids_[i]);
                    cards_[n].setSubtitle(ids_[i]);
                    cards_[n].setMeta(metas_[i]);
                    cards_[n].setFrame(28 + (n % 2) * 432, 276 + (n / 2) * 190,
                                       412, 170);
                    n = n + 1;
                }
            }
            cardCount_ = n;
        }

        // ---- 事件：卡片主操作（进入）/ 次操作（详情）----
        void onCardPrimary(int x, int y) {
            // 反查命中卡片（headless：由调用方传入卡片坐标）
            for (int i = 0; i < cardCount_; i = i + 1) {
                if (cards_[i].hit(x, y) != 0) {
                    selected_ = i;
                    enterPatient_ = cards_[i].getTitle();
                    Console.writeLine("bnct enter=" + enterPatient_
                                      + " (" + cards_[i].getSubtitle() + ")");
                    return;
                }
            }
        }

        void onCardSecondary(int x, int y) {
            for (int i = 0; i < cardCount_; i = i + 1) {
                if (cards_[i].hit(x, y) != 0) {
                    Console.writeLine("bnct detail=" + cards_[i].getTitle());
                    return;
                }
            }
        }

        // 事件：搜索框编辑 → 过滤卡片
        void onSearch(string text) {
            filterCards(text);
            Console.writeLine("bnct search '" + text + "' shown=" + cardCount_);
        }

        // ---- headless 验证：构建 + 模拟交互 ----
        void runHeadless() {
            build();
            // 页面结构
            Console.writeLine("bnct header=BNCT 治疗计划系统 / 病例管理 / "
                              + userName_);
            Console.writeLine("bnct cards=" + cardCount_
                              + " first=" + cards_[0].getTitle()
                              + " (" + cards_[0].getSubtitle() + ")");
            Console.writeLine("bnct sort=" + sortDrop_.getItem(sortDrop_.getSelected())
                              + " source=" + sourceDrop_.getItem(sourceDrop_.getSelected()));
            Console.writeLine("bnct case=" + caseDrop_.getItem(0)
                              + " seq=" + seqDrop_.getItem(0));

            // 搜索过滤：输入 ID 片段 → 只剩 1 张卡
            onSearch("305891");
            Console.writeLine("bnct filtered_first=" + cards_[0].getTitle());

            // 清除搜索 → 恢复 2 张
            search_.setText("");
            onSearch("");

            // 模拟点卡片主操作「进入」：命中第 0 张卡主按钮区域
            cards_[0].onTouch(cards_[0].primaryX() + 5,
                              cards_[0].btnY() + 5);
            // 模拟点卡片次操作「详情」
            cards_[1].onTouch(cards_[1].secondaryX() + 5,
                              cards_[1].btnY() + 5);
        }
        // 窗口尺寸变化（全屏/最大化）→ 1:1 逻辑尺寸 + 重新布局（防拉伸模糊）
        void relayout(int W, int H) {
            userLabel_.setFrame(W - 262, 30, 0, 0);
            userAv_.setFrame(W - 320, 18, 44, 44);
            enterBtn_.setFrame(W - 158, 204, 130, 40);
            // 卡片网格：按窗口宽度排多列
            int cw = 412;
            int gap = 20;
            int cols = 1;
            if (W >= 3 * cw + 4 * gap + 28) cols = 3;
            else if (W >= 2 * cw + 3 * gap + 28) cols = 2;
            for (int i = 0; i < cardCount_; i = i + 1) {
                cards_[i].setFrame(28 + (i % cols) * (cw + gap),
                                   276 + (i / cols) * 190, cw, 170);
            }
        }

        // ---- SDL 窗口界面（复刻截图，窗口尺寸对齐 ref 参考图比例）----
        void runUi() {
            int W = 1880;   // 对齐 mypview/ref/粘贴的图像.png 逻辑尺寸（2x DPI 还原）
            int H = 956;
            int open = SDL.open("BNCT 病例管理", W, H);
            if (open != 0) {
                Console.writeLine("bnct ui sdl-open-fail=" + Fmt.i(open));
                return;
            }
            SDL.setLogicalSize(W, H);
            SdlRenderer r = new SdlRenderer();
            RootView rv = new RootView(16, W, H);
            build();

            // Header：标题 + 用户区（右上角，对齐截图）
            headerTitle_ = new Label("BNCT 治疗计划系统", 28, 16, 3);
            pageTitle_ = new Label("病例管理", 28, 52, 3);
            userAv_ = new Avatar("D", W - 320, 18, 44);
            userLabel_ = new Label(userName_, 0, 0, 2);
            userLabel_.setFrame(W - 262, 30, 0, 0);
            rv.add(headerTitle_);
            rv.add(pageTitle_);
            rv.add(userAv_);
            rv.add(userLabel_);

            // 搜索/筛选区 + 操作按钮 + 病例选择 + 卡片
            rv.add(search_);
            rv.add(sortDrop_);
            rv.add(sourceDrop_);
            rv.add(newBtn_);
            rv.add(deleteBtn_);
            rv.add(pacsBtn_);
            rv.add(caseDrop_);
            rv.add(seqDrop_);
            rv.add(enterBtn_);
            // 数组元素 → 接口参数需局部变量中转（mypc 对数组元素不自动接口上转）
            for (int i = 0; i < cardCount_; i = i + 1) {
                Card c = cards_[i];
                rv.add(c);
            }

            Console.writeLine("bnct ui running cards=" + Fmt.i(cardCount_));
            string mf = Console.getEnv("MYP_PLAYER_MAXFRAME");
            int maxFrame = mf == "" ? 0 : Str.toInt(mf);
            int frame = 0;
            int saved = -1;
            while (SDL.running()) {
                int key = SDL.getKey();
                if (key == 41) break;                       // ESC 退出
                if (maxFrame > 0 && frame >= maxFrame) break;

                // 点击：分发 + 卡片事件 + 进入按钮
                int mclick = SDL.getMouseClick();
                if (mclick >= 0) {
                    int mx = mclick & 0xFFFF;
                    int my = (mclick >> 16) & 0xFFFF;
                    rv.onPress(mx, my);
                    for (int i = 0; i < cardCount_; i = i + 1)
                        if (cards_[i].hit(mx, my) != 0) cards_[i].onTouch(mx, my);
                    if (enterBtn_.hit(mx, my) != 0) {
                        if (cardCount_ > 0) {
                            selected_ = 0;
                            enterPatient_ = cards_[0].getTitle();
                            Console.writeLine("bnct ui enter=" + enterPatient_);
                        }
                    }
                }

                // 键盘搜索：点击 SearchBar 聚焦后输入 → 实时过滤
                int c = SDL.getChar();
                while (c >= 0) {
                    if (search_.focused() != 0) {
                        if (c == 8) search_.backspace();
                        else if (c == 13) { onSearch(search_.getText()); search_.unfocus(); }
                        else if (c >= 32 && c != 127) search_.append(Str.chr(c));
                    }
                    c = SDL.getChar();
                }

                // hover：鼠标位置 → 卡片提亮
                int mpos = SDL.getMousePos();
                if (mpos >= 0) {
                    int hx = mpos & 0xFFFF;
                    int hy = (mpos >> 16) & 0xFFFF;
                    for (int i = 0; i < cardCount_; i = i + 1)
                        cards_[i].setHovered(cards_[i].hit(hx, hy));
                }

                // 窗口自适应：全屏/最大化 → 1:1 逻辑尺寸 + 重排（不缩放不模糊）
                int curW = SDL.width();
                int curH = SDL.height();
                if (curW != W || curH != H) {
                    W = curW;
                    H = curH;
                    SDL.setLogicalSize(W, H);
                    relayout(W, H);
                }

                // 绘制（dark blue 背景）
                SDL.clear(20, 24, 40, 255);
                rv.draw(r);
                SDL.present();
                // 离屏截图（预览渲染结果，headless 环境可见）
                if (frame == 60) {
                    saved = SDL.saveBmp("/tmp/bnct_cases.bmp");
                    Console.writeLine("bnct ui saved=" + Fmt.i(saved));
                }
                SDL.delay(16);
                frame = frame + 1;
            }
            SDL.close();
            Console.writeLine("bnct ui done frame=" + Fmt.i(frame)
                              + " saved=" + Fmt.i(saved));
        }
}

class Boot {
    action:
        @constructor Boot() {
            BnctCases a = new BnctCases();
            string h = Console.getEnv("BNCT_HEADLESS");
            if (h == "1") a.runHeadless();
            else a.runUi();
        }
}

int main() {
    Boot b = new Boot();
    return 0;
}
