// bnct_cases.myp — BNCT 治疗计划系统：病例管理页（复刻 Web dashboard 结构）
// ---------------------------------------------------------------------------
// 结构（对应截图）：mypview 布局控件组织（LinearLayout 行 + FlowLayout 卡片区）
//   root(垂直) ─ headerRow / searchRow / actionRow / selectRow / cardArea
// 本示例实现 UiApp 生命周期接口，由 AppRunner 框架运行：
//   - onCreate：构建布局树 + 用户区
//   - onResize：窗口/全屏自适应（框架已 setLogicalSize 1:1，这里重排布局）
//   - onKeyChar：SearchBar 聚焦后键盘输入 → 实时过滤
//   - onFrame：离屏截图（预览渲染）
// 双模式：
//   - 默认：SDL 窗口（bash build.sh bnct_cases，ESC/关窗退出）
//   - BNCT_HEADLESS=1：headless 逻辑验证（搜索过滤/卡片事件输出断言）
// 运行：bash build.sh bnct_cases（需 backend/sdl_renderer.myp，build.sh 自动加）
import env;
import fmt;
import sdl;

// 事件绑定：卡片主/次操作 → 页面 handler
mapping() {
    Card.PrimaryAction -> BnctCases.onCardPrimary;
    Card.SecondaryAction -> BnctCases.onCardSecondary;
    SearchBar.Edited -> BnctCases.onSearch;
}

class BnctCases {
    interface class UiApp;

    property:
        // 病例数据（mock，对齐截图）
        string[8] pids_;
        string[8] ids_;
        string[8] metas_;
        int caseCount_;
        // 卡片
        Card[8] cards_;
        int cardCount_;        // 当前显示卡片数（搜索过滤后）
        int selected_;         // 选中病例索引（进入勾画）
        string enterPatient_;  // 最近一次「进入勾画」的患者
        // 控件
        SearchBar search_;
        Dropdown sortDrop_;
        Dropdown sourceDrop_;
        Dropdown caseDrop_;
        Dropdown seqDrop_;
        Button enterBtn_;
        Button newBtn_;
        Button deleteBtn_;
        Button pacsBtn_;
        string userName_;
        // Header 控件
        Label headerTitle_;
        Label pageTitle_;
        Avatar userAv_;
        Label userLabel_;
        // 布局树（resize 需要引用）
        LinearLayout root_;
        LinearLayout headerRow_;
        LinearLayout searchRow_;
        LinearLayout actionRow_;
        LinearLayout selectRow_;
        FlowLayout cardArea_;

    action:
        @constructor BnctCases() {
            // 病例数据
            pids_[0] = "Patient-7736D7";  ids_[0] = "ID-C4A0";
            metas_[0] = "1 个序列 · DICOM · 更新于 2026/8/10 08:54:10";
            pids_[1] = "Patient-305891";  ids_[1] = "ID-21F0";
            metas_[1] = "1 个序列 · DICOM · 更新于 2026/7/14 15:38:03";
            caseCount_ = 2;
            cardCount_ = 0;
            selected_ = -1;
            enterPatient_ = "";
            userName_ = "Doctor demo";
            for (int i = 0; i < 8; i = i + 1) {
                cards_[i] = new Card("", 0, 0, 412, 170);   // 期望尺寸（FlowLayout 用）
                cards_[i].setActions("详情", "进入");
            }
        }

        // ---- 构建页面：布局树（LinearLayout 行 + FlowLayout 卡片区）----
        void build(int W, int H) {
            root_ = new LinearLayout(0, W, H);
            root_.setPadding(20);
            root_.setSpacing(12);

            // Header 行（水平）：系统标题 + 页面标题
            headerRow_ = new LinearLayout(1, W - 40, 60);
            headerRow_.setPadding(0);
            headerRow_.setSpacing(24);
            headerTitle_ = new Label("BNCT 治疗计划系统", 0, 0, 3);
            pageTitle_ = new Label("病例管理", 0, 0, 2);
            Label ht = headerTitle_;
            Label pt = pageTitle_;
            headerRow_.add(ht);
            headerRow_.add(pt);
            LinearLayout hr0 = headerRow_;
            root_.add(hr0);

            // 搜索行（水平）：SearchBar + 排序/来源
            searchRow_ = new LinearLayout(1, W - 40, 44);
            searchRow_.setPadding(0);
            searchRow_.setSpacing(16);
            search_ = new SearchBar(0, 0, 440, 42);
            sortDrop_ = new Dropdown(0, 0, 180, 42);
            sortDrop_.addItem("最近更新");
            sortDrop_.addItem("患者姓名");
            sortDrop_.setSelected(0);
            sourceDrop_ = new Dropdown(0, 0, 140, 42);
            sourceDrop_.addItem("全部");
            sourceDrop_.addItem("DICOM");
            sourceDrop_.setSelected(0);
            SearchBar sb = search_;
            Dropdown sd = sortDrop_;
            Dropdown srd = sourceDrop_;
            searchRow_.add(sb);
            searchRow_.add(sd);
            searchRow_.add(srd);
            LinearLayout hr1 = searchRow_;
            root_.add(hr1);

            // 操作按钮行（水平）
            actionRow_ = new LinearLayout(1, W - 40, 40);
            actionRow_.setPadding(0);
            actionRow_.setSpacing(16);
            newBtn_ = new Button("+ 新建病例", 0, 0, 140, 38);
            deleteBtn_ = new Button("X 删除病例", 0, 0, 140, 38);
            pacsBtn_ = new Button("PACS 查询", 0, 0, 140, 38);
            Button nb = newBtn_;
            Button db = deleteBtn_;
            Button pb = pacsBtn_;
            actionRow_.add(nb);
            actionRow_.add(db);
            actionRow_.add(pb);
            LinearLayout hr2 = actionRow_;
            root_.add(hr2);

            // 病例/序列选择行（水平）
            selectRow_ = new LinearLayout(1, W - 40, 42);
            selectRow_.setPadding(0);
            selectRow_.setSpacing(16);
            caseDrop_ = new Dropdown(0, 0, 340, 40);
            caseDrop_.addItem("Patient-305891 (ID-21F0)");
            caseDrop_.setSelected(0);
            seqDrop_ = new Dropdown(0, 0, 600, 40);
            seqDrop_.addItem("RTSTRUCT - Imported RT-STRUCT (254 slices)");
            seqDrop_.setSelected(0);
            enterBtn_ = new Button("进入勾画", 0, 0, 130, 40);
            Dropdown cd = caseDrop_;
            Dropdown qd = seqDrop_;
            Button eb = enterBtn_;
            selectRow_.add(cd);
            selectRow_.add(qd);
            selectRow_.add(eb);
            LinearLayout hr3 = selectRow_;
            root_.add(hr3);

            // 卡片区（流式换行，宽度自适应列数）
            cardArea_ = new FlowLayout(W - 40, 420);
            cardArea_.setPadding(0);
            cardArea_.setSpacing(20);
            cardArea_.setRowGap(16);
            FlowLayout ca = cardArea_;
            root_.add(ca);

            // 用户区（右上角，绝对定位；LinearLayout 无右对齐）
            userAv_ = new Avatar("D", W - 320, 18, 44);
            userLabel_ = new Label(userName_, 0, 0, 2);

            // 初始化卡片内容
            filterCards("");
        }

        // ---- 搜索过滤：按患者名 / ID 过滤（布局重排由 refresh 做）----
        void filterCards(string kw) {
            int n = 0;
            for (int i = 0; i < caseCount_; i = i + 1) {
                int hit = 0;
                if (Str.len(kw) == 0) hit = 1;
                else if (Str.contains(pids_[i], kw) != 0) hit = 1;
                else if (Str.contains(ids_[i], kw) != 0) hit = 1;
                if (hit != 0) {
                    cards_[n].setTitle(pids_[i]);
                    cards_[n].setSubtitle(ids_[i]);
                    cards_[n].setMeta(metas_[i]);
                    n = n + 1;
                }
            }
            cardCount_ = n;
        }

        // ---- 卡片区重排：重建子控件 + 流式布局 ----
        void refreshCards() {
            if (cardArea_ == null) return;
            cardArea_.clear();
            for (int i = 0; i < cardCount_; i = i + 1) {
                Card c = cards_[i];
                cardArea_.add(c);
            }
            cardArea_.layout();
        }

        // ---- 布局：设置布局树 frame + 全量 layout（初始 / 窗口 resize 共用）----
        void relayout(int W, int H) {
            root_.setFrame(0, 0, W, H);
            headerRow_.setFrame(0, 0, W - 40, 60);
            searchRow_.setFrame(0, 0, W - 40, 44);
            actionRow_.setFrame(0, 0, W - 40, 40);
            selectRow_.setFrame(0, 0, W - 40, 42);
            cardArea_.setFrame(0, 0, W - 40, 420);
            userAv_.setFrame(W - 320, 18, 44, 44);
            userLabel_.setFrame(W - 262, 30, 0, 0);
            root_.layout();
            headerRow_.layout();
            searchRow_.layout();
            actionRow_.layout();
            selectRow_.layout();
            refreshCards();
        }

        // ---- 事件：卡片主操作（进入）/ 次操作（详情）----
        void onCardPrimary(int x, int y) {
            for (int i = 0; i < cardCount_; i = i + 1) {
                if (cards_[i].hit(x, y) != 0) {
                    selected_ = i;
                    enterPatient_ = cards_[i].getTitle();
                    Console.writeLine("bnct enter=" + enterPatient_
                                      + " (" + cards_[i].getSubtitle() + ")");
                    return;
                }
            }
        }

        void onCardSecondary(int x, int y) {
            for (int i = 0; i < cardCount_; i = i + 1) {
                if (cards_[i].hit(x, y) != 0) {
                    Console.writeLine("bnct detail=" + cards_[i].getTitle());
                    return;
                }
            }
        }

        // 事件：搜索框编辑 → 过滤 + 卡片区重排
        void onSearch(string text) {
            filterCards(text);
            refreshCards();
            Console.writeLine("bnct search '" + text + "' shown=" + cardCount_);
        }

        // ---- UiApp 生命周期实现（AppRunner 框架调用）----
        void onCreate(RootView rv, SdlRenderer r, int w, int h) {
            build(w, h);
            relayout(w, h);
            LinearLayout root = root_;
            rv.add(root);
            Avatar av = userAv_;
            Label ul = userLabel_;
            rv.add(av);
            rv.add(ul);
            Console.writeLine("bnct ui running cards=" + Fmt.i(cardCount_));
        }

        // 窗口/全屏自适应：框架已 setLogicalSize 1:1，这里重排布局树
        void onResize(int w, int h) {
            relayout(w, h);
        }

        // 键盘字符：SearchBar 聚焦后输入 → 实时过滤
        void onKeyChar(int c) {
            if (search_.focused() != 0) {
                if (c == 8) search_.backspace();
                else if (c == 13) { onSearch(search_.getText()); search_.unfocus(); }
                else if (c >= 32 && c != 127) search_.append(Str.chr(c));
            }
        }

        // 每帧：离屏截图（预览渲染，headless 环境可见）
        void onFrame(int frame) {
            if (frame == 60) {
                int s = SDL.saveBmp("/tmp/bnct_cases.bmp");
                Console.writeLine("bnct ui saved=" + Fmt.i(s));
            }
        }

        // ---- headless 验证：构建 + 模拟交互 ----
        void runHeadless() {
            build(1880, 956);
            relayout(1880, 956);   // 布局确定坐标
            Console.writeLine("bnct header=BNCT 治疗计划系统 / 病例管理 / "
                              + userName_);
            Console.writeLine("bnct cards=" + cardCount_
                              + " first=" + cards_[0].getTitle()
                              + " (" + cards_[0].getSubtitle() + ")");
            Console.writeLine("bnct sort=" + sortDrop_.getItem(sortDrop_.getSelected())
                              + " source=" + sourceDrop_.getItem(sourceDrop_.getSelected()));
            Console.writeLine("bnct case=" + caseDrop_.getItem(0)
                              + " seq=" + seqDrop_.getItem(0));

            onSearch("305891");
            Console.writeLine("bnct filtered_first=" + cards_[0].getTitle());
            search_.setText("");
            onSearch("");

            cards_[0].onTouch(cards_[0].primaryX() + 5,
                              cards_[0].btnY() + 5);
            cards_[1].onTouch(cards_[1].secondaryX() + 5,
                              cards_[1].btnY() + 5);
        }
}

class Boot {
    action:
        @constructor Boot() {
            BnctCases a = new BnctCases();
            string h = Console.getEnv("BNCT_HEADLESS");
            if (h == "1") a.runHeadless();
            else {
                AppRunner rn = new AppRunner();
                rn.run(a, "BNCT 病例管理", 1880, 956, 0x14141C);
            }
        }
}

int main() {
    Boot b = new Boot();
    return 0;
}
