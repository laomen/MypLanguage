// sdl_counter.myp — mypview M5：SDL 窗口渲染同一组件树
//
// 同一棵组件树（Box + Label + Button）改用 SdlRenderer 渲染到窗口；
// 键盘（SDL scancode → Enter/Space/ESC）驱动交互；ESC 关闭窗口。
//
// 事件循环放在 runLoop()，由 Driver 在实例注册后驱动（mapping 目标
// __myp_inst_* 在 main 创建实例后才填充，构造器内触发无法派发）。
//
// 编译运行:
//   ./build/mypc -O2 mypview/examples/sdl_counter.myp -o /tmp/sdl_ui && /tmp/sdl_ui
// 无显示环境冒烟测试: SDL_VIDEODRIVER=dummy /tmp/sdl_ui

import sdl;
import "../src/core.myp";
import "../src/sdlrender.myp";
import "../src/widgets.myp";
import "../src/layout.myp";

class SdlCounterApp {
    action:
        @constructor SdlCounterApp() {
            // 声明式组件树（与 TUI 版相同）
            root = new Box();
            title = new Label("mypview SDL");
            label = new Label("Count: 0");
            button = new Button("+1");
            button.setFocused(1);
            root.add(title);
            root.add(label);
            root.add(button);

            renderer = new SdlRenderer("mypview SDL demo", 480, 360);
            root.layout(12, 6, 36, 6);
        }

        // 事件循环（实例注册后由 Driver 调用）
        void runLoop() {
            int running = 1;
            while (running == 1) {
                // SDL scancode → Button 期望的字符码
                int key = SDL.getKey();
                if (key == 41) { running = 0; break; }   // ESC 退出
                if (key == 40) { key = 13; }             // RETURN → Enter
                else if (key == 44) { key = 32; }        // SPACE → 空格
                else { key = 0; }
                if (key != 0) {
                    root.key(key);
                }
                renderer.clear();
                root.draw(renderer);
                renderer.flush();
                SDL.delay(16);
            }
            SDL.close();
        }

        // 由 mapping 接入：Button.clicked -> SdlCounterApp.onIncrement
        void onIncrement() {
            count = count + 1;
            label.setText("Count: " + count);
        }

    property:
        Box root;
        Label title;
        Label label;
        Button button;
        SdlRenderer renderer;
        int count = 0;
}

// 实例注册后驱动事件循环（main 先 new App 再 new Driver）
class Driver {
    action:
        @constructor Driver(SdlCounterApp app) {
            app.runLoop();
        }
}

mapping() {
    Button.clicked -> SdlCounterApp.onIncrement;
}

int main() {
    SdlCounterApp a = new SdlCounterApp();
    Driver d = new Driver(a);
    return 0;
}
