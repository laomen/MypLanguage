// uix_designer.myp — mypview 可视化界面设计器（所见即所得，对标 Qt Design Studio）
// ---------------------------------------------------------------------------
// 直接在画布上设计 mypview 界面：.uix 声明文档为源（可编辑 Json），UixLoader 实时
// 渲染画布（WYSIWYG），点选控件 → 属性面板改属性 → 重建画布即见效果；调色板
// 一键添加控件；保存输出 .uix 文档（可再被 buildInto 加载）。
//
//   .uix 文档 = 设计的唯一真源（Json，可 setValue/addChild/remove/serialize）
//   画布     = UixLoader.buildInto 渲染（所见即所得）
//   选中     = 画布点击 → loader.hitId(x,y) → 高亮框 + 属性面板回填
//   属性     = text/color/x/y/width/height → 写回文档 → 重建画布
//   调色板   = Label/Button/TextField/Switch/Slider/Panel 一键添加（addChild 注入）
//   保存     = serialize 输出 .uix JSON（打印 + 截图）
//
// 双模式：
//   - 默认：SDL 窗口（bash build.sh uix_designer，ESC/关窗退出）
//   - DESIGN_HEADLESS=1：headless 逻辑验证（命中/改属性/加控件/删除/序列化断言）
import env;
import fmt;
import sdl;
import json;
import io;
import error;
import process;

// 事件绑定：画布点击/拖拽 → 选中/移动；按钮点击 → 路由
mapping() {
    DesignCanvas.CanvasClick -> UixDesigner.onCanvasClick;
    DesignCanvas.CanvasPress -> UixDesigner.onCanvasPress;
    DesignCanvas.CanvasMove -> UixDesigner.onCanvasMove;
    DesignCanvas.CanvasRelease -> UixDesigner.onCanvasRelease;
    Button.Clicked -> UixDesigner.onButton;
}

// ---- 选中框（琥珀色描边，绘制在画布设计之上）----
class SelBox {
    interface class View;
    property:
        int x_; int y_; int w_; int h_;
    action:
        @constructor SelBox() {
            x_ = 0; y_ = 0; w_ = 0; h_ = 0;
        }
        int width() { return w_; }
        int height() { return h_; }
        void setFrame(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
        }
        void draw(Renderer r) {
            if (w_ <= 0 || h_ <= 0) return;
            r.outlineRect(x_ - 3, y_ - 3, w_ + 6, h_ + 6, Color.amber());
        }
        int hit(int x, int y) { return 0; }
        void onTouch(int x, int y) {}
}

// ---- 设计画布：只渲染设计树，点击不派发给控件（仅上报选中/拖拽事件）----
class DesignCanvas {
    interface class View;
    property:
        RootView inner_;
        int x_; int y_; int w_; int h_;
        int color_;
    event:
        CanvasClick(int x, int y);
        CanvasPress(int x, int y);
        CanvasMove(int x, int y);
        CanvasRelease(int x, int y);
    action:
        @constructor DesignCanvas(int x, int y, int w, int h) {
            inner_ = new RootView(64, w, h);
            x_ = x; y_ = y; w_ = w; h_ = h;
            color_ = Color.rgb(200, 200, 200);   // 亮色设计画布
        }
        // 重建设计后替换内层渲染树
        void setRoot(RootView rv) { inner_ = rv; }
        int getX() { return x_; }
        int getY() { return y_; }
        int width() { return w_; }
        int height() { return h_; }
        void setFrame(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
            inner_.setFrame(x, y, w, h);
        }
        void draw(Renderer r) {
            r.fillRect(x_, y_, w_, h_, color_);
            inner_.draw(r);
        }
        int hit(int x, int y) {
            if (x >= x_ && x < x_ + w_ && y >= y_ && y < y_ + h_) return 1;
            return 0;
        }
        void onTouch(int x, int y) { CanvasClick(x, y); }   // 点选（兼容）
        // 拖拽：按下 → 选中+开始拖；移动 → 持续拖；抬起 → 结束
        void onPress(int x, int y) { CanvasPress(x, y); }
        void onMove(int x, int y) { CanvasMove(x, y); }
        void onRelease(int x, int y) { CanvasRelease(x, y); }
}

// ---- 拖拽幽灵：调色板拖入画布时的预览框（琥珀描边 + 类型名）----
class DragGhost {
    interface class View;
    property:
        int x_; int y_; int w_; int h_;
        string label_;
    action:
        @constructor DragGhost() {
            x_ = 0; y_ = 0; w_ = 0; h_ = 0;
            label_ = "";
        }
        void setLabel(string t) { label_ = t; }
        int width() { return w_; }
        int height() { return h_; }
        void setFrame(int x, int y, int w, int h) {
            x_ = x; y_ = y; w_ = w; h_ = h;
        }
        void draw(Renderer r) {
            if (w_ <= 0 || h_ <= 0) return;
            r.outlineRect(x_, y_, w_, h_, Color.amber());
            r.drawText(x_ + 4, y_ + 4, label_, 1, Color.amber());
        }
        int hit(int x, int y) { return 0; }
        void onTouch(int x, int y) {}
}

class UixDesigner {
    interface class UiApp;

    property:
        // ---- chrome 布局（字段持有，规避接口数组不 retain）----
        LinearLayout root_;
        LinearLayout toolbar_;
        LinearLayout mainRow_;
        LinearLayout propPanel_;
        DesignCanvas canvas_;
        SelBox selBox_;
        DragGhost ghost_;
        Label status_;
        // 调色板拖放状态
        string paletteDrag_;   // 当前拖拽的调色板类型（""=无）
        int ghostW_;
        int ghostH_;
        // 工具栏按钮
        Button newBtn_;
        Button openBtn_;
        Button loadBtn_;
        Button saveBtn_;
        Button addLabelBtn_;
        Button addButtonBtn_;
        Button addFieldBtn_;
        Button addSwitchBtn_;
        Button addSliderBtn_;
        Button addPanelBtn_;
        Button delBtn_;
        Button fsBtn_;          // 全屏切换（F11 亦可）
        Button runBtn_;         // 运行：保存设计 → 弹 uix_run 独立新窗口跑当前 uix
        int curFrame_;          // 当前帧号（onFrame 记录，spawn 防抖用）
        int lastSpawnFrame_;    // 上次启动预览的帧号（AppRunner click+press 双路由防抖）
        // 属性面板
        Label propTitle_;
        Label propInfo_;
        Label textLabel_;
        Label colorLabel_;
        Label xLabel_;
        Label yLabel_;
        Label wLabel_;
        Label hLabel_;
        TextField textF_;
        TextField colorF_;
        TextField xF_;
        TextField yF_;
        TextField wF_;
        TextField hF_;
        Button applyBtn_;
        // ---- 设计状态 ----
        Json design_;          // .uix 文档（唯一真源）
        UixLoader loader_;     // 当前渲染
        string uixText_;
        RootView canvasRoot_;
        string selectedId_;
        int nextId_;
        // 拖拽状态
        int dragActive_;
        int dragOffX_;
        int dragOffY_;
        // id → 文档路径（对象路径，如 "children.2"；根为 ""）
        string[] pathIds_;
        string[] pathVals_;
        int pathCount_;
        int canvasW_;
        int canvasH_;

    action:
        @constructor UixDesigner() {
            selBox_ = new SelBox();
            ghost_ = new DragGhost();
            paletteDrag_ = "";
            ghostW_ = 0;
            ghostH_ = 0;
            canvas_ = new DesignCanvas(0, 0, 900, 600);
            canvasRoot_ = null;
            selectedId_ = "";
            nextId_ = 100;
            dragActive_ = 0;
            dragOffX_ = 0;
            dragOffY_ = 0;
            curFrame_ = 0;
            lastSpawnFrame_ = -100;
            pathIds_ = new string[512];
            pathVals_ = new string[512];
            pathCount_ = 0;
            canvasW_ = 900;
            canvasH_ = 600;
        }

        // ---- 布局树 ----
        void build(int W, int H) {
            root_ = new LinearLayout(0, W, H);
            root_.setPadding(10);
            root_.setSpacing(8);

            // 工具栏（水平）
            toolbar_ = new LinearLayout(1, W - 20, 40);
            toolbar_.setPadding(0);
            toolbar_.setSpacing(8);
            newBtn_ = new Button("新建", 0, 0, 72, 36);
            openBtn_ = new Button("打开文件", 0, 0, 96, 36);
            loadBtn_ = new Button("载入示例", 0, 0, 90, 36);
            saveBtn_ = new Button("保存 .uix", 0, 0, 96, 36);
            runBtn_ = new Button("运行", 0, 0, 72, 36);
            addLabelBtn_ = new Button("+ Label", 0, 0, 84, 36);
            addButtonBtn_ = new Button("+ Button", 0, 0, 90, 36);
            addFieldBtn_ = new Button("+ TextField", 0, 0, 108, 36);
            addSwitchBtn_ = new Button("+ Switch", 0, 0, 90, 36);
            addSliderBtn_ = new Button("+ Slider", 0, 0, 90, 36);
            addPanelBtn_ = new Button("+ Panel", 0, 0, 84, 36);
            delBtn_ = new Button("删除选中", 0, 0, 96, 36);
            fsBtn_ = new Button("全屏", 0, 0, 72, 36);
            Button nb = newBtn_;  toolbar_.add(nb);
            Button ob = openBtn_; toolbar_.add(ob);
            Button lb = loadBtn_;  toolbar_.add(lb);
            Button sb = saveBtn_;  toolbar_.add(sb);
            Button rb = runBtn_;   toolbar_.add(rb);
            Button ab = addLabelBtn_;  toolbar_.add(ab);
            Button bb = addButtonBtn_; toolbar_.add(bb);
            Button fb = addFieldBtn_;  toolbar_.add(fb);
            Button swb = addSwitchBtn_; toolbar_.add(swb);
            Button slb = addSliderBtn_; toolbar_.add(slb);
            Button pb = addPanelBtn_;  toolbar_.add(pb);
            Button db = delBtn_;  toolbar_.add(db);
            Button fbb = fsBtn_; toolbar_.add(fbb);
            LinearLayout tb = toolbar_;
            root_.add(tb);

            // 主行（水平）：画布 + 属性面板
            mainRow_ = new LinearLayout(1, W - 20, H - 40 - 8 - 20);
            mainRow_.setPadding(0);
            mainRow_.setSpacing(8);
            int cw = W - 20 - 320 - 8;
            int ch = H - 40 - 8 - 20;
            canvas_ = new DesignCanvas(0, 0, cw, ch);
            canvas_.setFrame(0, 0, cw, ch);
            DesignCanvas cd = canvas_;
            mainRow_.add(cd);

            // 属性面板（垂直）
            propPanel_ = new LinearLayout(0, 320, ch);
            propPanel_.setPadding(10);
            propPanel_.setSpacing(6);
            propTitle_ = new Label("属性面板", 0, 0, 2);
            propTitle_.setColor(Color.dark());
            propInfo_ = new Label("未选中控件", 0, 0, 1);
            propInfo_.setColor(Color.dark());
            textF_ = new TextField("", 0, 0, 290, 30);
            colorF_ = new TextField("", 0, 0, 290, 30);
            xF_ = new TextField("", 0, 0, 140, 30);
            yF_ = new TextField("", 0, 0, 140, 30);
            wF_ = new TextField("", 0, 0, 140, 30);
            hF_ = new TextField("", 0, 0, 140, 30);
            applyBtn_ = new Button("应用属性", 0, 0, 290, 36);
            Label pt = propTitle_;  propPanel_.add(pt);
            Label pi = propInfo_;   propPanel_.add(pi);
            textLabel_ = new Label("text", 0, 0, 1);
            textLabel_.setColor(Color.dark());
            Label l1 = textLabel_;
            TextField t1 = textF_;
            propPanel_.add(l1);  propPanel_.add(t1);
            colorLabel_ = new Label("color (#RRGGBB)", 0, 0, 1);
            colorLabel_.setColor(Color.dark());
            Label l2 = colorLabel_;
            TextField t2 = colorF_;
            propPanel_.add(l2);  propPanel_.add(t2);
            xLabel_ = new Label("x", 0, 0, 1);
            xLabel_.setColor(Color.dark());
            Label l3 = xLabel_;
            TextField t3 = xF_;
            propPanel_.add(l3);  propPanel_.add(t3);
            yLabel_ = new Label("y", 0, 0, 1);
            yLabel_.setColor(Color.dark());
            Label l4 = yLabel_;
            TextField t4 = yF_;
            propPanel_.add(l4);  propPanel_.add(t4);
            wLabel_ = new Label("width", 0, 0, 1);
            wLabel_.setColor(Color.dark());
            Label l5 = wLabel_;
            TextField t5 = wF_;
            propPanel_.add(l5);  propPanel_.add(t5);
            hLabel_ = new Label("height", 0, 0, 1);
            hLabel_.setColor(Color.dark());
            Label l6 = hLabel_;
            TextField t6 = hF_;
            propPanel_.add(l6);  propPanel_.add(t6);
            Button ap = applyBtn_;
            propPanel_.add(ap);
            LinearLayout pp = propPanel_;
            mainRow_.add(pp);

            LinearLayout mr = mainRow_;
            root_.add(mr);

            status_ = new Label("就绪", 0, 0, 1);
            status_.setColor(Color.dark());
        }

        void relayout(int W, int H) {
            // 重设所有容器尺寸（LinearLayout 的高度/宽度是构造时定死的，
            // 窗口缩放后必须显式 setFrame 更新，否则子控件被旧尺寸压住）
            int cw = W - 20 - 320 - 8;
            int ch = H - 40 - 8 - 20;
            root_.setFrame(0, 0, W, H);
            toolbar_.setFrame(0, 0, W - 20, 40);
            mainRow_.setFrame(0, 0, W - 20, ch);
            propPanel_.setFrame(0, 0, 320, ch);
            canvas_.setFrame(0, 0, cw, ch);
            // LinearLayout.layout() 不递归子容器：每个嵌套容器都要显式 layout()
            //（bnct 同款）。否则工具栏按钮/属性面板字段全叠在 (0,0) → 看不到。
            root_.layout();
            toolbar_.layout();
            mainRow_.layout();
            propPanel_.layout();
            if (loader_ != null) applyOffsetAll();   // 画布位置变化 → 设计重新平移
            updateSelBox();
        }

        // ---- 设计文档操作（唯一真源 design_）----
        // 载入默认示例设计
        void loadDefault() {
            string uix = "{\"type\":\"Panel\",\"id\":\"root\",\"x\":0,\"y\":0,"
                + "\"width\":900,\"height\":600,\"children\":["
                + "{\"type\":\"Label\",\"id\":\"title\",\"text\":\"BNCT 欢迎页\","
                + "\"x\":40,\"y\":30,\"scale\":3,\"color\":\"#1F1F1F\"},"
                + "{\"type\":\"Button\",\"id\":\"ok\",\"text\":\"确定\","
                + "\"x\":60,\"y\":120,\"width\":140,\"height\":44},"
                + "{\"type\":\"TextField\",\"id\":\"user\",\"text\":\"用户名\","
                + "\"x\":60,\"y\":190,\"width\":240,\"height\":36},"
                + "{\"type\":\"Slider\",\"id\":\"vol\",\"x\":60,\"y\":250,"
                + "\"width\":200,\"height\":24,\"min\":0,\"max\":100},"
                + "{\"type\":\"Switch\",\"id\":\"sw\",\"x\":60,\"y\":300,"
                + "\"width\":60,\"height\":32}]}";
            design_ = new Json(uix);
            uixText_ = uix;
            nextId_ = 100;
            selectedId_ = "";
            rebuildDesign();
        }

        // 重建画布：design_ 序列化 → 新 loader 渲染 → 平移到画布原点 → 重选中
        void rebuildDesign() {
            uixText_ = design_.serialize();
            canvasW_ = design_.type("width") >= 0 ? design_.getInt("width") : 900;
            canvasH_ = design_.type("height") >= 0 ? design_.getInt("height") : 600;
            canvasRoot_ = new RootView(64, canvasW_, canvasH_);
            loader_ = new UixLoader(uixText_, "");
            loader_.buildInto(canvasRoot_);
            canvasRoot_.add(selBox_);      // 选中框绘制在设计之上
            canvasRoot_.add(ghost_);       // 拖拽幽灵（调色板拖入预览）
            canvas_.setRoot(canvasRoot_);
            indexPaths();
            applyOffsetAll();              // 设计控件整体平移到画布原点（窗口坐标）
            if (Str.len(selectedId_) > 0) {
                if (loader_.idxOf(selectedId_) >= 0) updateSelBox();
                else { selectedId_ = ""; hideSelBox(); }
            }
        }

        // 把设计全部控件（设计局部坐标 0,0 基准）平移到画布原点，绘制在画布内
        void applyOffsetAll() {
            int ox = canvas_.getX();
            int oy = canvas_.getY();
            loader_.setOffset(ox, oy);
            for (int i = 0; i < loader_.nodeCount(); i = i + 1) {
                string id = loader_.idAt(i);
                string p = pathOf(id);
                int dx = design_.type(p + ".x") >= 0 ? design_.getInt(p + ".x") : 0;
                int dy = design_.type(p + ".y") >= 0 ? design_.getInt(p + ".y") : 0;
                loader_.moveNode(id, dx, dy);
            }
        }

        string serializeDesign() { return design_.serialize(); }
        int loaderNodeCount() { return loader_.nodeCount(); }
        string hitId(int x, int y) { return loader_.hitId(x, y); }

        // 构建 id → 文档路径映射（对象路径如 "children.2"，根为 ""；去尾点——
        // 带尾点会让 remove 的 strrchr 末段为空 token 删除失败）
        void indexPaths() {
            pathIds_ = new string[512];
            pathVals_ = new string[512];
            pathCount_ = 0;
            indexNode(design_, "");
        }
        void indexNode(Json doc, string prefix) {
            if (doc.type(prefix + "id") >= 0) {
                pathIds_[pathCount_] = doc.getString(prefix + "id");
                pathVals_[pathCount_] = stripDot(prefix);
                pathCount_ = pathCount_ + 1;
            }
            int n = doc.arrayLen(prefix + "children");
            for (int i = 0; i < n; i = i + 1)
                indexNode(doc, prefix + "children." + Fmt.i(i) + ".");
        }
        string stripDot(string p) {
            int n = Str.len(p);
            if (n > 0 && __myp_charcode(p, n - 1) == 46)
                return Str.substring(p, 0, n - 1);
            return p;
        }
        string pathOf(string id) {
            for (int i = 0; i < pathCount_; i = i + 1)
                if (pathIds_[i] == id) return pathVals_[i];
            return "";
        }

        // ---- 选中 / 属性 ----
        void selectId(string id) {
            selectedId_ = id;
            populateProps(id);
            updateSelBox();
        }
        void onCanvasClick(int x, int y) {
            // 控件已平移到画布原点 → 命中用窗口坐标
            string id = loader_.hitId(x, y);
            if (Str.len(id) > 0) selectId(id);
            else { selectedId_ = ""; hideSelBox(); propInfo_.setText("未选中控件"); }
        }

        // ---- 拖拽移动控件（Qt Design Studio 式：按住拖动即移动）----
        // 按下：命中选中 + 记录抓取偏移（窗口坐标）
        void onCanvasPress(int x, int y) {
            string id = loader_.hitId(x, y);
            if (Str.len(id) > 0) {
                selectId(id);
                string p = pathOf(id);
                int nx = design_.type(p + ".x") >= 0 ? design_.getInt(p + ".x") : 0;
                int ny = design_.type(p + ".y") >= 0 ? design_.getInt(p + ".y") : 0;
                dragActive_ = 1;
                dragOffX_ = x - (loader_.offsetX() + nx);   // 抓取点相对控件左上角
                dragOffY_ = y - (loader_.offsetY() + ny);
            } else {
                selectedId_ = "";
                hideSelBox();
                propInfo_.setText("未选中控件");
                dragActive_ = 0;
            }
        }
        // 移动：实时移动控件（不重建）+ 写回文档 + 选中框跟随
        void onCanvasMove(int x, int y) {
            if (dragActive_ == 0) return;
            int nx = x - loader_.offsetX() - dragOffX_;   // 设计局部坐标
            int ny = y - loader_.offsetY() - dragOffY_;
            string p = pathOf(selectedId_);
            if (p == "" && selectedId_ != design_.getString("id")) return;  // 根不可拖
            loader_.moveNode(selectedId_, nx, ny);
            setAttrIf(p, "x", Fmt.i(nx));
            setAttrIf(p, "y", Fmt.i(ny));
            selBox_.setFrame(loader_.offsetX() + nx, loader_.offsetY() + ny,
                             nodeW(selectedId_), nodeH(selectedId_));
            propInfo_.setText("拖动: " + selectedId_ + " (" + Fmt.i(nx) + ","
                              + Fmt.i(ny) + ")");
        }
        // 抬起：重建（树与文档一致）+ 属性面板回填
        void onCanvasRelease(int x, int y) {
            if (dragActive_ == 0) return;
            dragActive_ = 0;
            rebuildDesign();
            if (Str.len(selectedId_) > 0) populateProps(selectedId_);
        }

        // ---- 调色板拖放（窗口级手势：UiApp onPress/onMove/onRelease）----
        // 按调色板 +xxx 按钮 → 拖到画布 → 松开在该位置添加控件（Qt Design Studio 式）
        void onPress(int x, int y) {
            string t = paletteTypeAt(x, y);
            if (t != "") {
                paletteDrag_ = t;
                ghostW_ = defaultW(t);
                ghostH_ = defaultH(t);
                ghost_.setLabel("+" + t);
                ghost_.setFrame(x, y, ghostW_, ghostH_);
            }
        }
        void onMove(int x, int y) {
            if (paletteDrag_ != "")
                ghost_.setFrame(x, y, ghostW_, ghostH_);   // 幽灵跟随光标
        }
        void onRelease(int x, int y) {
            if (paletteDrag_ == "") return;
            string t = paletteDrag_;
            paletteDrag_ = "";
            ghost_.setFrame(0, 0, 0, 0);   // 隐藏幽灵
            if (canvas_.hit(x, y) != 0) {
                int lx = x - canvas_.getX();
                int ly = y - canvas_.getY();
                addControl(t, lx, ly);     // 落到画布内 → 落下位置添加
            } else {
                addControl(t, 40, 40);     // 简单点击（未拖到画布）→ 默认位置
            }
        }
        string paletteTypeAt(int x, int y) {
            if (addLabelBtn_.hit(x, y) != 0) return "Label";
            if (addButtonBtn_.hit(x, y) != 0) return "Button";
            if (addFieldBtn_.hit(x, y) != 0) return "TextField";
            if (addSwitchBtn_.hit(x, y) != 0) return "Switch";
            if (addSliderBtn_.hit(x, y) != 0) return "Slider";
            if (addPanelBtn_.hit(x, y) != 0) return "Panel";
            return "";
        }
        int defaultW(string t) {
            if (t == "Label") return 80;
            if (t == "TextField") return 240;
            if (t == "Switch") return 60;
            if (t == "Slider") return 200;
            if (t == "Panel") return 160;
            return 140;
        }
        int defaultH(string t) {
            if (t == "Label") return 24;
            if (t == "TextField") return 36;
            if (t == "Switch") return 32;
            if (t == "Slider") return 24;
            if (t == "Panel") return 120;
            return 44;
        }

        // 属性面板：编辑 → 写回文档 → 重建
        void setPropText(string v) { textF_.setText(v); }
        void setPropX(string v) { xF_.setText(v); }
        void applyProps() {
            if (Str.len(selectedId_) == 0) return;
            string p = pathOf(selectedId_);
            if (p == "" && selectedId_ != design_.getString("id")) return;
            setAttrIf(p, "text", textF_.getText());
            setAttrIf(p, "color", colorF_.getText());
            setAttrIf(p, "x", xF_.getText());
            setAttrIf(p, "y", yF_.getText());
            setAttrIf(p, "width", wF_.getText());
            setAttrIf(p, "height", hF_.getText());
            rebuildDesign();
            propInfo_.setText("已应用: " + selectedId_);
        }
        // 把 name=value 写入文档（已存在则改，否则新增键）
        void setAttrIf(string prefix, string name, string value) {
            string full;
            if (Str.len(prefix) == 0) full = name;
            else full = prefix + "." + name;
            if (design_.type(full) >= 0) design_.setValue(full, value);
            else design_.addChild(prefix, name, value);
        }

        void populateProps(string id) {
            string p = pathOf(id);
            textF_.setText(design_.type(p + ".text") >= 0 ? design_.getString(p + ".text") : "");
            colorF_.setText(design_.type(p + ".color") >= 0 ? design_.getString(p + ".color") : "");
            xF_.setText(design_.type(p + ".x") >= 0 ? Fmt.i(design_.getInt(p + ".x")) : "0");
            yF_.setText(design_.type(p + ".y") >= 0 ? Fmt.i(design_.getInt(p + ".y")) : "0");
            wF_.setText(design_.type(p + ".width") >= 0 ? Fmt.i(design_.getInt(p + ".width")) : "");
            hF_.setText(design_.type(p + ".height") >= 0 ? Fmt.i(design_.getInt(p + ".height")) : "");
            propInfo_.setText("选中: " + id + " (" + loader_.typeOf(id) + ")");
        }

        void updateSelBox() {
            if (Str.len(selectedId_) == 0) { hideSelBox(); return; }
            string p = pathOf(selectedId_);
            int sx = design_.type(p + ".x") >= 0 ? design_.getInt(p + ".x") : 0;
            int sy = design_.type(p + ".y") >= 0 ? design_.getInt(p + ".y") : 0;
            int sw = nodeW(selectedId_);
            int sh = nodeH(selectedId_);
            selBox_.setFrame(loader_.offsetX() + sx, loader_.offsetY() + sy, sw, sh);
        }
        void hideSelBox() {
            selBox_.setFrame(0, 0, 0, 0);
        }
        // 从 loader 具体类型数组取节点实际宽高
        int nodeW(string id) {
            int i = loader_.labelIdxOf(id);
            if (i >= 0) return loader_.labelAt(i).width();
            i = loader_.buttonIdxOf(id);
            if (i >= 0) return loader_.buttonAt(i).width();
            i = loader_.fieldIdxOf(id);
            if (i >= 0) return loader_.fieldAt(i).width();
            i = loader_.switchIdxOf(id);
            if (i >= 0) return loader_.switchAt(i).width();
            i = loader_.sliderIdxOf(id);
            if (i >= 0) return loader_.sliderAt(i).width();
            i = loader_.progressbarIdxOf(id);
            if (i >= 0) return loader_.progressbarAt(i).width();
            i = loader_.panelIdxOf(id);
            if (i >= 0) return loader_.panelAt(i).width();
            return 0;
        }
        int nodeH(string id) {
            int i = loader_.labelIdxOf(id);
            if (i >= 0) return loader_.labelAt(i).height();
            i = loader_.buttonIdxOf(id);
            if (i >= 0) return loader_.buttonAt(i).height();
            i = loader_.fieldIdxOf(id);
            if (i >= 0) return loader_.fieldAt(i).height();
            i = loader_.switchIdxOf(id);
            if (i >= 0) return loader_.switchAt(i).height();
            i = loader_.sliderIdxOf(id);
            if (i >= 0) return loader_.sliderAt(i).height();
            i = loader_.progressbarIdxOf(id);
            if (i >= 0) return loader_.progressbarAt(i).height();
            i = loader_.panelIdxOf(id);
            if (i >= 0) return loader_.panelAt(i).height();
            return 0;
        }

        // ---- 调色板：添加控件（x,y = 画布局部坐标；调色板拖放落下位置）----
        void addControl(string type, int x, int y) {
            string id = type + "_" + Fmt.i(nextId_);
            nextId_ = nextId_ + 1;
            string json;
            if (type == "Label")
                json = "{\"type\":\"Label\",\"id\":\"" + id
                    + "\",\"text\":\"新标签\",\"x\":" + Fmt.i(x)
                    + ",\"y\":" + Fmt.i(y) + ",\"scale\":2,\"color\":\"#1F1F1F\"}";
            else if (type == "TextField")
                json = "{\"type\":\"TextField\",\"id\":\"" + id
                    + "\",\"text\":\"\",\"x\":" + Fmt.i(x)
                    + ",\"y\":" + Fmt.i(y) + ",\"width\":240,\"height\":36}";
            else if (type == "Switch")
                json = "{\"type\":\"Switch\",\"id\":\"" + id
                    + "\",\"x\":" + Fmt.i(x) + ",\"y\":" + Fmt.i(y)
                    + ",\"width\":60,\"height\":32}";
            else if (type == "Slider")
                json = "{\"type\":\"Slider\",\"id\":\"" + id
                    + "\",\"x\":" + Fmt.i(x) + ",\"y\":" + Fmt.i(y)
                    + ",\"width\":200,\"height\":24}";
            else if (type == "Panel")
                json = "{\"type\":\"Panel\",\"id\":\"" + id
                    + "\",\"x\":" + Fmt.i(x) + ",\"y\":" + Fmt.i(y)
                    + ",\"width\":160,\"height\":120}";
            else
                json = "{\"type\":\"Button\",\"id\":\"" + id
                    + "\",\"text\":\"按钮\",\"x\":" + Fmt.i(x)
                    + ",\"y\":" + Fmt.i(y) + ",\"width\":140,\"height\":44}";
            if (design_.type("children") >= 0) design_.addChild("children", "", json);
            else design_.addChild("", "children", "[" + json + "]");
            selectedId_ = id;
            rebuildDesign();
            propInfo_.setText("已添加: " + id);
        }

        void removeSelected() {
            if (Str.len(selectedId_) == 0) return;
            string p = pathOf(selectedId_);
            if (p == "") { propInfo_.setText("根不可删"); return; }
            design_.remove(p);
            selectedId_ = "";
            rebuildDesign();
            propInfo_.setText("已删除");
        }

        // ---- 文件操作：新建 / 打开 .uix / 保存 .uix ----
        string filePath() {
            string p = Console.getEnv("MYPVIEW_UIX_FILE");
            if (Str.len(p) > 0) return p;
            return "design.uix";
        }

        void newDesign() {
            string uix = "{\"type\":\"Panel\",\"id\":\"root\",\"x\":0,\"y\":0,"
                + "\"width\":900,\"height\":600,\"children\":[]}";
            design_ = new Json(uix);
            uixText_ = uix;
            nextId_ = 100;
            selectedId_ = "";
            rebuildDesign();
            propInfo_.setText("新建空设计");
        }

        void openUix() {
            string path = filePath();
            try {
                File f = new File();
                f.open(path, "r");
                string content = f.readAll();
                f.close();
                if (Str.len(content) == 0) {
                    propInfo_.setText("文件为空: " + path);
                    return;
                }
                design_ = new Json(content);       // 无效 JSON 抛 JsonError
                uixText_ = content;
                nextId_ = 100;
                selectedId_ = "";
                rebuildDesign();
                propInfo_.setText("已打开: " + path);
                Console.writeLine("ds opened nodes=" + loader_.nodeCount());
            } catch (Error e) {
                propInfo_.setText("打开失败: " + path);
            }
        }

        void saveUix() {
            string s = design_.serialize();
            string path = filePath();
            try {
                File f = new File();
                f.open(path, "w");
                f.write(s);
                f.close();
                Console.writeLine("ds saved-file len=" + Str.len(s) + " path=" + path);
                propInfo_.setText("已保存: " + path);
            } catch (Error e) {
                propInfo_.setText("保存失败: " + path);
            }
            string h = Console.getEnv("DESIGN_HEADLESS");
            if (h != "1") SDL.saveBmp("/tmp/uix_designer.bmp");
        }

        // ---- 预览运行：保存设计 → 弹 uix_run 独立新窗口跑当前 uix ----
        // 点「运行」→ saveUix() 持久化当前（已修改）设计 → Process.spawn 后台
        // 启动 uix_run（MYPVIEW_UIX_FILE 指向刚保存的文件）→ 弹出新窗口跑当前
        // uix；设计器保持响应（双击 fork 分离子进程，不阻塞主循环）。
        // 防抖：AppRunner 对一次按下会 click+press 双路由（既有行为），再加
        // release 合成的 click → 一按可能触发 3 次；30 帧（≈0.5s）内只开一次。
        void enterRunMode() {
            int df = curFrame_ - lastSpawnFrame_;
            if (df < 30) {
                Console.writeLine("ds run debounce skip=" + df);
                return;
            }
            lastSpawnFrame_ = curFrame_;
            saveUix();
            // 显式 MYP_PLAYER_MAXFRAME=0：预览窗口跑到自己被关闭，不受设计器
            // 进程环境里的限帧变量影响（uix_run 0=不限帧）
            string cmd = "MYPVIEW_UIX_FILE=" + filePath()
                + " MYP_PLAYER_MAXFRAME=0 ./uix_run";
            string h = Console.getEnv("DESIGN_HEADLESS");
            if (h == "1") {
                Console.writeLine("ds run cmd=" + cmd + " skip=1");
                status_.setText("headless：仅打印预览命令");
                return;
            }
            int rc = Process.spawn(cmd);
            status_.setText(rc == 0 ? "已启动预览窗口 (uix_run)"
                                    : "预览启动失败: " + cmd);
            Console.writeLine("ds run spawn=" + rc);
        }

        // ---- 按钮路由（调色板 +xxx 按钮改由窗口级 onPress/onRelease 拖放处理）----
        void onButton(int x, int y) {
            if (newBtn_.hit(x, y) != 0) { newDesign(); return; }
            if (openBtn_.hit(x, y) != 0) { openUix(); return; }
            if (loadBtn_.hit(x, y) != 0) { loadDefault(); return; }
            if (saveBtn_.hit(x, y) != 0) { saveUix(); return; }
            if (runBtn_.hit(x, y) != 0) { enterRunMode(); return; }
            if (delBtn_.hit(x, y) != 0) { removeSelected(); return; }
            if (fsBtn_.hit(x, y) != 0) { SDL.setFullscreen(1); return; }
            if (applyBtn_.hit(x, y) != 0) { applyProps(); return; }
        }

        // ---- UiApp 生命周期（AppRunner 框架调用）----
        void onCreate(RootView rv, SdlRenderer r, int w, int h) {
            build(w, h);
            relayout(w, h);
            loadDefault();
            Console.writeLine("ds ui running nodes=" + loader_.nodeCount());
            LinearLayout root = root_;
            rv.add(root);
            Label st = status_;
            rv.add(st);
        }

        void onResize(int w, int h) {
            string tr = Console.getEnv("MYPVIEW_TEST_RESIZE");
            if (tr == "1")
                Console.writeLine("ds onResize " + w + "x" + h + " sdl="
                                  + SDL.width() + "x" + SDL.height());
            relayout(w, h);
        }

        void onKeyChar(int c) {
            // 属性面板聚焦字段输入
            if (textF_.focused() != 0 || colorF_.focused() != 0
                || xF_.focused() != 0 || yF_.focused() != 0
                || wF_.focused() != 0 || hF_.focused() != 0) {
                TextField f = focusedField();
                if (c == 8) f.backspace();
                else if (c == 13) { applyProps(); f.unfocus(); }
                else if (c >= 32 && c != 127) f.append(Str.chr(c));
            }
        }
        TextField focusedField() {
            if (textF_.focused() != 0) return textF_;
            if (colorF_.focused() != 0) return colorF_;
            if (xF_.focused() != 0) return xF_;
            if (yF_.focused() != 0) return yF_;
            if (wF_.focused() != 0) return wF_;
            return hF_;
        }

        void onFrame(int frame) {
            curFrame_ = frame;
            // resize 链路自测（MYPVIEW_TEST_RESIZE=1）：frame 5 自缩放窗口 →
            // AppRunner 检测到尺寸变化 → onResize → relayout → 画布变大
            string tr = Console.getEnv("MYPVIEW_TEST_RESIZE");
            if (tr == "1") {
                if (frame == 5)
                    SDL.setWindowSize(SDL.width() + 200, SDL.height() + 150);
                if (frame == 12)
                    Console.writeLine("ds resize canvas=" + canvas_.width()
                                      + "x" + canvas_.height());
            }
            // 拖拽链路自测（MYPVIEW_TEST_DRAG=1）：注入合成鼠标驱动 AppRunner
            // 按下→移动→抬起 完整手势分发，验证真实窗口拖拽移动 ok 到 (100,140)
            string td = Console.getEnv("MYPVIEW_TEST_DRAG");
            if (td == "1") {
                if (frame == 5) SDL.testMouse(1, 80, 190);    // 按下
                if (frame == 8) SDL.testMouse(1, 120, 210);   // 按住移动
                if (frame == 11) SDL.testMouse(0, 120, 210);  // 抬起
                if (frame == 15)
                    Console.writeLine("ds testdrag x100="
                        + (Str.contains(serializeDesign(), "\"x\": 100") != 0 ? 1 : 0)
                        + " y140="
                        + (Str.contains(serializeDesign(), "\"y\": 140") != 0 ? 1 : 0));
            }
            if (frame == 60) {
                int s = SDL.saveBmp("/tmp/uix_designer.bmp");
                Console.writeLine("ds ui saved=" + s);
            }
        }

        // ---- headless 验证 ----
        void runHeadless() {
            build(1400, 900);
            relayout(1400, 900);
            loadDefault();
            // 节点数：根 Panel + 5 子 = 6
            Console.writeLine("ds nodes=" + loader_.nodeCount());
            // 命中：Button ok 设计局部 (60,120,140,44)，画布原点 (10,58)
            // → 窗口 (70,178,140,44)，点 (80,190) 内部
            Console.writeLine("ds hit=" + loader_.hitId(80, 190));
            // 拖拽移动 ok：走【完整手势路由】root.onPress→mainRow→canvas→
            // CanvasPress→onCanvasPress（验证容器手势链在真实窗口可用）。
            // 按下 (80,190) → 移动 (120,210) → 抬起（抓取偏移 (10,12)
            // → 新设计局部位置 (100,140)）
            selectId("ok");
            root_.onPress(80, 190);
            root_.onMove(120, 210);
            root_.onRelease(120, 210);
            string s3 = serializeDesign();
            Console.writeLine("ds drag x100=" + (Str.contains(s3, "\"x\": 100") != 0 ? 1 : 0)
                              + " y140=" + (Str.contains(s3, "\"y\": 140") != 0 ? 1 : 0)
                              + " sel=" + selectedId_);
            // 选 ok → 改 text/x → 应用
            selectId("ok");
            setPropText("Login");
            setPropX("120");
            applyProps();
            string s1 = serializeDesign();
            Console.writeLine("ds text=" + (Str.contains(s1, "\"text\": \"Login\"") != 0 ? 1 : 0)
                              + " x120=" + (Str.contains(s1, "\"x\": 120") != 0 ? 1 : 0));
            // 加控件（默认位置）
            addControl("Button", 40, 40);
            Console.writeLine("ds nodes2=" + loader_.nodeCount());
            Console.writeLine("ds added-id=" + (loader_.idxOf(selectedId_) >= 0 ? 1 : 0));
            // 删选中
            removeSelected();
            string s2 = serializeDesign();
            Console.writeLine("ds nodes3=" + loader_.nodeCount()
                              + " no-ok=" + (Str.contains(s2, "\"id\": \"ok\"") != 0 ? 0 : 1));
            // 调色板拖放：按 +Button → 拖到画布 (150,250) → 落下 → 画布局部
            // (140,192) 添加（窗口级 onPress/onMove/onRelease）
            int bx = addButtonBtn_.getX() + 45;
            int by = addButtonBtn_.getY() + 20;
            onPress(bx, by);
            onMove(150, 250);
            onRelease(150, 250);
            string s4 = serializeDesign();
            Console.writeLine("ds palette x140=" + (Str.contains(s4, "\"x\": 140") != 0 ? 1 : 0)
                              + " y192=" + (Str.contains(s4, "\"y\": 192") != 0 ? 1 : 0)
                              + " nodes=" + loader_.nodeCount());            // 文件保存 → 打开 往返（MYPVIEW_UIX_FILE 由测试脚本设为 /tmp 路径）
            saveUix();
            openUix();
            Console.writeLine("ds file roundtrip nodes=" + loader_.nodeCount());
            // 预览运行：保存 → 生成 uix_run 启动命令（headless 不实际启动，
            // 仅断言命令指向当前设计文件 + skip=1）
            enterRunMode();
            Console.writeLine("ds done");
        }
}

class Boot {
    action:
        @constructor Boot() {
            UixDesigner a = new UixDesigner();
            string h = Console.getEnv("DESIGN_HEADLESS");
            if (h == "1") a.runHeadless();
            else {
                AppRunner rn = new AppRunner();
                rn.run(a, "mypview UI 设计器", 1400, 900, 0xD8D8D8);
            }
        }
}

int main() {
    Boot b = new Boot();
    return 0;
}
