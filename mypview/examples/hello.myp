// hello.myp — mypview M1 验收：画出嵌套组件树
//
// 编译运行:
//   ./build/mypc -O2 mypview/examples/hello.myp -o /tmp/hello_ui && /tmp/hello_ui

import env;
import time;
import "../src/core.myp";
import "../src/render.myp";
import "../src/widgets.myp";
import "../src/layout.myp";

class Hello {
    action:
        @constructor Hello() {
            // ---- 声明式组件树 ----
            Box root = new Box();
            Label title = new Label("mypview - hello");
            Box inner = new Box();
            Label a = new Label("item A");
            Label b = new Label("item B");
            root.add(title);
            root.add(inner);
            inner.add(a);
            inner.add(b);

            // ---- 布局 + 渲染 ----
            TuiRenderer r = new TuiRenderer();
            root.layout(1, 1, 40, 10);
            r.clear();
            root.draw(r);
            r.flush();

            // 停留 2 秒供查看（终端会立即清屏？不——TUI 不清屏，输出保留）
            Time.sleep(2000);
        }
}

int main() {
    Hello h = new Hello();
    return 0;
}
