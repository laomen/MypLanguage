// player.myp — MYP Player：真实 app 运行模式（大窗口 + 布局铺满 + 全控件）
// ---------------------------------------------------------------------------
// 按实际 app 模式构建完整界面：
//   - SDL 大窗口（900x660 "MYP Player"），根布局铺满窗口
//   - 采用布局控件组织：Column(根) / Row(顶栏·进度行·中部) / Flow(标签徽章) /
//     Grid(图标网格) + Panel(卡片)
//   - 全部控件加入界面：Label / Button / Switch / Checkbox / Slider /
//     ProgressBar / TextField / Panel / List / AppIcon / NotificationBanner
//   - 帧循环：输入(点击→控件响应+Play/Stop) → 动画(Tween 进度条 + seek 推进 +
//     表达式 pos 联动 + 通知横幅倒计时) → 绘制
// 运行：bash build.sh player（窗口一直停留；点 Play 播放动画，ESC/关窗退出）
import env;
import fmt;
import io;
import text;
import sdl;
import ttf;

// ---- ViewModel：播放器状态 + 命令 ----
class PlayerVM {
    interface class ViewModel;
    property:
        PropBag bag_;
    action:
        @constructor PlayerVM() {
            bag_ = new PropBag();
            bag_.set("status", "idle");
        }
        string getProp(string name) { return bag_.get(name); }
        void runCmd(string name) {
            if (name == "play") bag_.set("status", "playing");
            else if (name == "stop") bag_.set("status", "stopped");
        }
}

class Player {
    action:
        @constructor Player() {
            int W = 1280;
            int H = 800;
            int open = SDL.open("MYP Player", W, H);
            if (open != 0) {
                Console.writeLine("player sdl-open fail=" + Fmt.i(open));
                return;
            }
            // 初始逻辑尺寸：渲染 1:1 清晰；窗口 resize 时帧循环检测并同步逻辑
            // 尺寸 + 重新布局（自适应铺满，不缩放 → 不模糊）
            SDL.setLogicalSize(W, H);
            SdlRenderer r = new SdlRenderer();
            RootView rv = new RootView(16, W, H);

            // ============ 布局：根 Column 铺满窗口 ============
            LinearLayout root = new LinearLayout(0, W, H);   // 垂直
            root.setPadding(20);
            root.setSpacing(10);
            root.setFrame(0, 0, W, H);
            rv.add(root);

            // ---- 顶栏 Row：标题 + 封面 + 播放控制 + 图标 + 开关/勾选 ----
            LinearLayout top = new LinearLayout(1, W - 32, 56);   // 水平
            top.setPadding(12);
            top.setSpacing(16);
            Label title = new Label("MYP Player", 0, 0, 3);
            Image imgLogo = new Image(0, 0, 52, 52);
            int logoHandle = SDL.loadPng("../../logo/logo1.png");
            imgLogo.setHandle(logoHandle);
            Button play = new Button("Play", 0, 0, 140, 48);
            Button stop = new Button("Stop", 0, 0, 140, 48);
            IconButton ibPrev = new IconButton("◀", 0, 0, 44);
            IconButton ibNext = new IconButton("▶", 0, 0, 44);
            Switch loopSw = new Switch(0, 0, 72, 40);
            Checkbox agree = new Checkbox("I agree", 0, 0, 140, 30);
            Avatar userAv = new Avatar("M", 0, 0, 44);
            Badge msgBadge = new Badge("3", 0, 0);
            top.add(title);
            top.add(imgLogo);
            top.add(userAv);
            top.add(play);
            top.add(stop);
            top.add(ibPrev);
            top.add(ibNext);
            top.add(loopSw);
            top.add(agree);
            top.add(msgBadge);
            root.add(top);

            // ---- 进度行：Slider + pos 标签 + 加载指示器 ----
            LinearLayout seekRow = new LinearLayout(1, W - 32, 44);
            seekRow.setPadding(12);
            seekRow.setSpacing(12);
            Slider seek = new Slider(0, 0, 1050, 26, 0, 100);
            Label pos = new Label("0%", 0, 0, 2);
            ProgressSpinner sp = new ProgressSpinner(0, 0, 16);
            seekRow.add(seek);
            seekRow.add(pos);
            seekRow.add(sp);
            root.add(seekRow);

            // ---- 进度条（占满宽）----
            ProgressBar bar = new ProgressBar(0, 0, W - 32, 22, 0, 100);
            root.add(bar);

            // ---- Flow 标签徽章组 ----
            FlowLayout tags = new FlowLayout(W - 32, 64);
            tags.setPadding(10);
            tags.setSpacing(10);
            tags.setRowGap(8);
            Button t1 = new Button("fast", 0, 0, 120, 30);
            Button t2 = new Button("safe", 0, 0, 120, 30);
            Button t3 = new Button("auto", 0, 0, 120, 30);
            Chip c4 = new Chip("night", 0, 0, 110, 28);
            c4.setDeletable(1);
            Chip c5 = new Chip("pro", 0, 0, 100, 28);
            c5.setDeletable(1);
            Chip c6 = new Chip("lab", 0, 0, 100, 28);
            c6.setDeletable(1);
            tags.add(t1);
            tags.add(t2);
            tags.add(t3);
            tags.add(c4);
            tags.add(c5);
            tags.add(c6);
            root.add(tags);
            // 分隔线（Divider）
            Divider div1 = new Divider(0, 0, W - 32, 1);
            root.add(div1);

            // ---- Grid 图标网格：AppIcon ----
            GridLayout grid = new GridLayout(4, W - 32, 130);
            grid.setPadding(10);
            grid.setSpacing(14);
            AppIcon a1 = new AppIcon("Mail", 0, 0, 100, 108);
            AppIcon a2 = new AppIcon("Chat", 0, 0, 100, 108);
            AppIcon a3 = new AppIcon("Files", 0, 0, 100, 108);
            AppIcon a4 = new AppIcon("Music", 0, 0, 100, 108);
            grid.add(a1);
            grid.add(a2);
            grid.add(a3);
            grid.add(a4);
            root.add(grid);
            Divider div2 = new Divider(0, 0, W - 32, 1);
            root.add(div2);

            // ---- 控制行：模式 SegmentedControl + 音质 Dropdown + 收藏 Rating + 音量 Stepper + SearchBar ----
            LinearLayout ctrl = new LinearLayout(1, W - 32, 64);
            ctrl.setPadding(12);
            ctrl.setSpacing(12);
            SegmentedControl seg = new SegmentedControl(0, 0, 300, 32);
            seg.addSegment("单曲");
            seg.addSegment("循环");
            seg.addSegment("随机");
            Dropdown quality = new Dropdown(0, 0, 150, 32);
            quality.addItem("低");
            quality.addItem("中");
            quality.addItem("高");
            Rating stars = new Rating(0, 0, 200, 28);
            stars.setMax(5);
            Stepper vol = new Stepper(0, 0, 160, 32);
            vol.setRange(0, 10);
            vol.setValue(5);
            SearchBar sbar = new SearchBar(0, 0, 240, 34);
            ctrl.add(seg);
            ctrl.add(quality);
            ctrl.add(stars);
            ctrl.add(vol);
            ctrl.add(sbar);
            root.add(ctrl);

            // ---- 中部 Row：List 列表 + TabView（歌词/信息/日志页）----
            LinearLayout mid = new LinearLayout(1, W - 32, 178);
            mid.setPadding(10);
            mid.setSpacing(14);
            // 歌曲列表：SortableList 支持拖拽排序（长按拖动换位）
            SortableList songs = new SortableList(0, 0, 600, 178);
            songs.setRowHeight(26);
            songs.addItem("01 Intro");
            songs.addItem("02 The Journey");
            songs.addItem("03 Neon City");
            songs.addItem("04 Midnight");
            songs.addItem("05 Aurora");
            songs.addItem("06 Echoes");
            songs.addItem("07 Gravity");
            songs.addItem("08 Horizon");
            mid.add(songs);
            // 右侧 TabView：页面由 TabView 定位（点标签切换页）
            TabView tv = new TabView(0, 0, 560, 178);
            Label lyrics = new Label("Neon Night - The Journey", 0, 0, 2);
            Label status = new Label("idle", 0, 0, 2);
            TextArea logArea = new TextArea(0, 0, 560, 178);
            logArea.appendLine("-- 播放日志 --");
            tv.addTab("歌词", lyrics);
            tv.addTab("信息", status);
            tv.addTab("日志", logArea);
            mid.add(tv);
            root.add(mid);

            // ---- 工具行：触发浮层（菜单/抽屉/提示）----
            LinearLayout tools = new LinearLayout(1, W - 32, 36);
            tools.setPadding(8);
            tools.setSpacing(10);
            Button btnMenu = new Button("菜单", 0, 0, 120, 32);
            Button btnDrawer = new Button("工具", 0, 0, 120, 32);
            Button btnTip = new Button("提示", 0, 0, 120, 32);
            LongPressButton lpb = new LongPressButton("长按", 0, 0, 120, 32);
            tools.add(btnMenu);
            tools.add(btnDrawer);
            tools.add(btnTip);
            tools.add(lpb);
            root.add(tools);

            // ---- 底部导航 + 通知横幅 ----
            BottomNav bnav = new BottomNav(0, 0, W - 32, 44);
            bnav.addItem("首页");
            bnav.addItem("音乐");
            bnav.addItem("我的");
            root.add(bnav);

            // ---- 底部：通知横幅 ----
            NotificationBanner notif = new NotificationBanner(W - 32, 38);
            notif.post("Welcome to MYP Player");
            root.add(notif);

            // ---- 顶层覆盖：Toast（不参与布局，画在最上层；点收藏星触发）----
            Toast toast = new Toast(280, 36);
            toast.setFrame((W - 280) / 2, 16, 280, 36);
            rv.add(toast);

            // ---- 浮层：ContextMenu / Drawer(工具面板) / Tooltip ----
            ContextMenu cm = new ContextMenu(180);
            cm.addItem("复制");
            cm.addItem("重命名");
            cm.addItem("删除");
            Drawer dr = new Drawer(340, 560);
            ColorPicker cp = new ColorPicker(0, 0, 220, 80);
            DatePicker dpick = new DatePicker(0, 0, 280, 220);
            RefreshIndicator ri = new RefreshIndicator(0, 0, 120, 40);
            // Drawer 内容用绝对坐标（相对抽屉面板位置 400,100 偏移）
            Label drTitle = new Label("工具面板", 0, 0, 2);
            drTitle.setFrame(420, 108, 0, 0);
            cp.setFrame(420, 132, 220, 80);
            dpick.setFrame(420, 222, 280, 220);
            ri.setFrame(420, 452, 120, 40);
            dr.add(drTitle);
            dr.add(cp);
            dr.add(dpick);
            dr.add(ri);
            Tooltip tip = new Tooltip(200, 36);
            rv.add(cm);
            rv.add(dr);
            rv.add(tip);

            // ---- 全树布局（父先子后）----
            root.layout();
            top.layout();
            seekRow.layout();
            tags.layout();
            grid.layout();
            ctrl.layout();
            tools.layout();
            mid.layout();

            // ================= 帧循环 =================
            Tween tw = new Tween(0.0, 100.0, 2000.0);   // 进度条 0→100 循环(2s)
            // 键盘焦点导航（Tab 切换；Button 高亮，TextField 聚焦）
            FocusManager fm = new FocusManager();
            fm.register(play);
            fm.register(stop);
            fm.register(sbar);
            fm.register(quality);
            fm.register(seg);
            fm.register(vol);
            string mf = Console.getEnv("MYP_PLAYER_MAXFRAME");
            int maxFrame = mf == "" ? 0 : Str.toInt(mf);
            int frame = 0;
            int seekVal = 0;
            int playing = 0;                            // 0=停 1=播（Play/Stop 驱动）
            int saved = -1;
            int prevDown = 0;                           // 上一帧鼠标按下状态（拖拽事件流）
            Console.writeLine("player running (click Play, close window or ESC to exit)");
            while (SDL.running()) {
                int key = SDL.getKey();
                if (key == 41) break;                   // ESC 退出
                if (key == 43) fm.next();               // Tab → 下一焦点
                if (key == 40) fm.activate();           // 回车 → 激活当前焦点
                if (maxFrame > 0 && frame >= maxFrame) break;

                // ---- hover：鼠标位置 → 按钮悬停提亮（每帧刷新，成本低）----
                int mpos = SDL.getMousePos();
                if (mpos >= 0) {
                    int hx = mpos & 0xFFFF;
                    int hy = (mpos >> 16) & 0xFFFF;
                    play.setHovered(play.hit(hx, hy));
                    stop.setHovered(stop.hit(hx, hy));
                    t1.setHovered(t1.hit(hx, hy));
                    t2.setHovered(t2.hit(hx, hy));
                    t3.setHovered(t3.hit(hx, hy));
                    btnMenu.setHovered(btnMenu.hit(hx, hy));
                    btnDrawer.setHovered(btnDrawer.hit(hx, hy));
                    btnTip.setHovered(btnTip.hit(hx, hy));
                    ibPrev.setHovered(ibPrev.hit(hx, hy));
                    ibNext.setHovered(ibNext.hit(hx, hy));
                }

                // ---- 窗口自适应：检测尺寸变化 → 同步逻辑尺寸 + 重排布局 ----
                int curW = SDL.width();
                int curH = SDL.height();
                if (curW != W || curH != H) {
                    W = curW;
                    H = curH;
                    SDL.setLogicalSize(W, H);           // 逻辑跟随窗口（1:1 清晰）
                    int cw = W - 40;                    // root padding 20×2
                    root.setFrame(0, 0, W, H);
                    top.setFrame(0, 0, cw, 56);
                    seekRow.setFrame(0, 0, cw, 44);
                    bar.setFrame(0, 0, cw, 22);
                    tags.setFrame(0, 0, cw, 56);
                    div1.setFrame(0, 0, cw, 1);
                    grid.setFrame(0, 0, cw, 130);
                    div2.setFrame(0, 0, cw, 1);
                    ctrl.setFrame(0, 0, cw, 64);
                    tools.setFrame(0, 0, cw, 36);
                    mid.setFrame(0, 0, cw, 178);
                    bnav.setFrame(0, 0, cw, 44);
                    notif.setFrame(0, 0, cw, 38);
                    // 中部 List/TabView 按比例分配宽度
                    int listW = cw * 600 / 1248;
                    songs.setFrame(0, 0, listW, 178);
                    tv.setFrame(0, 0, cw - listW - 14, 178);
                    logArea.setFrame(0, 0, cw - listW - 14, 178);
                    root.layout();
                    top.layout();
                    seekRow.layout();
                    tags.layout();
                    grid.layout();
                    ctrl.layout();
                    tools.layout();
                    mid.layout();
                }

                // ---- 输入：点击 → 控件自身响应 + Play/Stop 命令 ----
                int mclick = SDL.getMouseClick();
                if (mclick >= 0) {
                    int mx = mclick & 0xFFFF;
                    int my = (mclick >> 16) & 0xFFFF;
                    // ---- 浮层优先：展开的下拉列表 / ContextMenu / Drawer / Tooltip ----
                    // 这些浮层可能延伸到后续布局控件之上，正常分发会被拦截，先处理
                    int fl = 0;
                    if (cm.visible() != 0 && cm.hit(mx, my) != 0) {
                        cm.onTouch(mx, my); fl = 1;
                        if (cm.getSelected() >= 0)
                            logArea.appendLine("> menu " + cm.itemAt(cm.getSelected()));
                    }
                    else if (dr.visible() != 0 && dr.hit(mx, my) != 0) { dr.onTouch(mx, my); fl = 1; }
                    else if (quality.isOpen() != 0 && quality.listHit(mx, my) != 0) {
                        quality.onTouch(mx, my); fl = 1;
                    }
                    if (fl == 0)
                        rv.onPress(mx, my);             // 按下（命中锁定；默认控件=一次点击）
                    if (play.hit(mx, my) != 0) { playing = 1; status.setText("playing"); logArea.appendLine("> play"); }
                    else if (stop.hit(mx, my) != 0) { playing = 0; status.setText("stopped"); logArea.appendLine("> stop"); }
                    // IconButton：上一曲/下一曲 → 写日志
                    if (ibPrev.hit(mx, my) != 0) { logArea.appendLine("> prev"); }
                    else if (ibNext.hit(mx, my) != 0) { logArea.appendLine("> next"); }
                    // 点收藏星 → Toast 提示
                    if (stars.hit(mx, my) != 0) {
                        toast.show("已收藏 " + Fmt.i(stars.getValue()) + " 星");
                    }
                    // 浮层触发：菜单/工具抽屉/提示
                    if (btnMenu.hit(mx, my) != 0) { cm.show(btnMenu.getX(), btnMenu.getY() + 40); }
                    else if (btnDrawer.hit(mx, my) != 0) { dr.toggle(400, 100); }
                    else if (btnTip.hit(mx, my) != 0) { tip.show("这是一个提示气泡", 320, 140); }
                    // 分段切换 → 日志
                    if (seg.hit(mx, my) != 0) {
                        logArea.appendLine("> mode " + seg.segmentAt(seg.getSelected()));
                    }
                    // 底部导航 → 日志
                    if (bnav.hit(mx, my) != 0) {
                        logArea.appendLine("> nav " + bnav.labelAt(bnav.getCurrent()));
                    }
                }

                // ---- 拖拽事件流：按住移动 → onMove（ScrollView/Slider 拖动）；
                //      抬起 → onRelease（结束拖拽，交给按下时锁定的控件）----
                int mdown = SDL.getMouseDown();
                // 复用上方 hover 块的 mpos（本帧鼠标位置）
                if (mdown != 0 && prevDown != 0 && mpos >= 0) {
                    rv.onMove(mpos & 0xFFFF, (mpos >> 16) & 0xFFFF);
                } else if (mdown == 0 && prevDown != 0) {
                    int rx = 0;
                    int ry = 0;
                    if (mpos >= 0) {
                        rx = mpos & 0xFFFF;
                        ry = (mpos >> 16) & 0xFFFF;
                    }
                    rv.onRelease(rx, ry);
                }
                prevDown = mdown;

                // ---- 长按手势：LongPressButton 长按 → 弹 ContextMenu（一次性消费）----
                if (lpb.lastGesture() == 2) {
                    cm.show(lpb.getX(), lpb.getY() + 40);
                    logArea.appendLine("> long-press menu");
                    lpb.consumeGesture();
                }

                // ---- 键盘文本输入 → 聚焦的 SearchBar（SDL.getChar 消费 UTF-8 队列）----
                int c = SDL.getChar();
                while (c >= 0) {
                    if (sbar.focused() != 0) {
                        if (c == 8) sbar.backspace();            // 退格
                        else if (c == 13) { sbar.unfocus(); }    // 回车失焦
                        else if (c >= 32 && c != 127) sbar.append(Str.chr(c));
                    }
                    c = SDL.getChar();
                }

                // ---- 动画推进（仅播放时）----
                if (playing == 1) {
                    double pv = tw.tick(16.0);
                    bar.setProgress(int(pv));
                    if (tw.done() != 0) tw.reset();
                    seekVal = seekVal + 1;              // 播放进度
                    if (seekVal > 100) seekVal = 0;
                    seek.setValue(seekVal);
                    pos.setText(Fmt.i(seekVal) + "%");  // 表达式联动 pos 标签
                }
                notif.tick(1);                          // 通知横幅帧驱动倒计时
                toast.tick(1);                          // Toast 帧驱动倒计时
                sp.tick(16);                            // ProgressSpinner 旋转

                // ---- 绘制 ----
                SDL.clear(20, 24, 40, 255);
                rv.draw(r);
                SDL.present();

                // 保存一帧供查看渲染结果
                if (frame == 60) {
                    saved = SDL.saveBmp("/tmp/myp_player.bmp");
                }
                SDL.delay(16);
                frame = frame + 1;
            }
            SDL.close();
            Console.writeLine("player done frame=" + Fmt.i(frame)
                              + " playing=" + Fmt.i(playing)
                              + " seek=" + Fmt.i(seek.getValue())
                              + " bar=" + Fmt.i(bar.getValue())
                              + " list=" + Fmt.i(songs.itemCount())
                              + " tab=" + Fmt.i(tv.getCurrent())
                              + " q=" + quality.getSelectedText()
                              + " stars=" + Fmt.i(stars.getValue())
                              + " seg=" + Fmt.i(seg.getSelected())
                              + " vol=" + Fmt.i(vol.getValue())
                              + " sbar=" + sbar.getText()
                              + " nav=" + Fmt.i(bnav.getCurrent())
                              + " img=" + Fmt.i(imgLogo.getHandle())
                              + " spin=" + Fmt.i(sp.getAngle())
                              + " saved=" + Fmt.i(saved));
            // TTF 文本纹理缓存命中统计（诊断：同文本重绘复用，避免每帧重建）
            Console.writeLine("player ttf-cache hits=" + Fmt.i(Ttf.cacheHits())
                              + " misses=" + Fmt.i(Ttf.cacheMisses()));
        }
}

int main() { Player p = new Player(); return 0; }
