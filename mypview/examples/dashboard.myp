// dashboard.myp — mypview M4：组合布局示例（Box + Flow + Stack + Bar）
//
// 演示：Box 垂直堆叠标题/区块；Flow 横排按钮超宽换行；Stack 重叠
// （背景标签 + 前景进度条）；Bar 进度条（填充 + 百分比）。
//
// 编译运行:
//   ./build/mypc -O2 mypview/examples/dashboard.myp -o /tmp/dash_ui && /tmp/dash_ui

import env;
import time;
import "../src/core.myp";
import "../src/render.myp";
import "../src/widgets.myp";
import "../src/layout.myp";

class Dashboard {
    action:
        @constructor Dashboard() {
            Box root = new Box();

            Label title = new Label("mypview dashboard");
            root.add(title);

            // Flow：横排按钮，超右边界自动换行
            Flow flow = new Flow();
            Button b1 = new Button("1");
            Button b2 = new Button("2");
            Button b3 = new Button("3");
            Button b4 = new Button("4");
            Button b5 = new Button("5");
            Button b6 = new Button("6");
            flow.add(b1);
            flow.add(b2);
            flow.add(b3);
            flow.add(b4);
            flow.add(b5);
            flow.add(b6);
            root.add(flow);

            // Stack：重叠（背景 Label + 前景 Bar）
            Stack stack = new Stack();
            Label bg = new Label("progress area");
            Bar bar = new Bar("task", 60);
            stack.add(bg);
            stack.add(bar);
            root.add(stack);

            // Bar 单独一行
            Bar bar2 = new Bar("cpu", 35);
            root.add(bar2);

            // 布局 + 渲染
            TuiRenderer r = new TuiRenderer();
            root.layout(1, 1, 40, 12);
            r.clear();
            root.draw(r);
            r.flush();

            Time.sleep(3000);
        }
}

int main() {
    Dashboard d = new Dashboard();
    return 0;
}
