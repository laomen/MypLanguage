{
  "name": "MYP",
  "scopeName": "source.myp",
  "fileTypes": [".myp"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#annotationParams" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#typeName" },
    { "include": "#newExpression" },
    { "include": "#typeIdentifier" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#propertyAccess" },
    { "include": "#mapping" },
    { "include": "#functionCall" },
    { "include": "#operators" },
    { "include": "#sections" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "begin": "//", "end": "$", "name": "comment.line.double-slash.myp" },
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.myp" }
      ]
    },
    "annotationParams": {
      "match": "@parallel\\s+\\b(for)\\b",
      "captures": {
        "0": { "name": "entity.other.attribute-name.myp" },
        "1": { "name": "keyword.control.myp" }
      }
    },
    "annotations": {
      "match": "@\\w+",
      "name": "entity.other.attribute-name.myp"
    },
    "keywords": {
      "match": "\\b(if|else|while|for|return|break|continue|import|mapping|new|this|null|true|false|var|class|interface|struct|enum|match|ffi|as|is|in|ref|out)\\b",
      "name": "keyword.control.myp"
    },
    "types": {
      "match": "\\b(void|byte|short|int|long|ubyte|ushort|uint|ulong|char|float|double|bool|string)\\b",
      "name": "storage.type.primitive.myp"
    },
    "sections": {
      "match": "^\\s*(action|event|property|function|static|struct|mapping)\\s*:",
      "name": "entity.name.section.myp"
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.myp",
          "patterns": [
            { "match": "\\\\[ntr0\"\\\\]", "name": "constant.character.escape.myp" },
            { "match": "\\$\\w+", "name": "variable.other.interpolation.myp" }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.myp",
          "patterns": [
            { "match": "\\\\[ntr0'\\\\]", "name": "constant.character.escape.myp" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b0[xX][0-9a-fA-F]+[uUlL]?\\b", "name": "constant.numeric.hex.myp" },
        { "match": "\\b\\d+\\.\\d*([eE][+-]?\\d+)?\\b", "name": "constant.numeric.float.myp" },
        { "match": "\\b\\d+[lL]\\b", "name": "constant.numeric.long.myp" },
        { "match": "\\b\\d+\\b", "name": "constant.numeric.myp" }
      ]
    },
    "propertyAccess": {
      "match": "\\b(this)\\s*\\.\\s*(\\w+)",
      "captures": {
        "1": { "name": "keyword.control.myp" },
        "2": { "name": "variable.other.property.myp" }
      }
    },
    "mapping": {
      "match": "([A-Z]\\w*(?:\\.[A-Z]\\w*)?)\\s*(->)\\s*([A-Z]\\w*(?:\\.[A-Z]\\w*)?)",
      "captures": {
        "1": { "name": "entity.name.function.myp" },
        "2": { "name": "keyword.operator.myp" },
        "3": { "name": "support.class.myp" }
      }
    },
    "typeName": {
      "match": "(?<=\\b(class|struct|interface|enum)\\s+)([A-Z]\\w*)",
      "captures": {
        "2": { "name": "entity.name.type.myp" }
      }
    },
    "newExpression": {
      "match": "\\b(new)\\s+([A-Z]\\w*)",
      "captures": {
        "1": { "name": "keyword.control.myp" },
        "2": { "name": "support.class.myp" }
      }
    },
    "typeIdentifier": {
      "match": "\\b([A-Z]\\w*)(?=\\s+\\w+\\b)",
      "name": "support.class.myp"
    },
    "functionCall": {
      "match": "\\b([A-Z]\\w*)\\s*(?=\\()",
      "name": "support.function.myp"
    },
    "operators": {
      "patterns": [
        { "match": "(->|=>|\\.\\.|\\+\\+|--|&&|\\|\\||==|!=|<=|>=|<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=)", "name": "keyword.operator.myp" },
        { "match": "[+\\-*/%<>=!&|^~?:]", "name": "keyword.operator.myp" }
      ]
    }
  }
}
