// mapping_demo.myp — BNCT 水模剂量引擎 (事件驱动 + GPU offload)
//
// 事件流:
//   DataLoader.load ──(DataReady)──► Source.start
//     (独立线程加载截面数据)         (收到信号后开始发射粒子批次)
//                                      │
//                                      ├─ batchReady ──► Transport.runBatch (GPU)
//                                      │                     │
//                                      │                     └─ Atomic.decrement pendingBatches
//                                      │
//                                      └─ allDone ──► Tally.writeResults
//                                                       (写到文件/控制台)
//
// GPU offload:
//   Transport.runBatch 改用 @gpu for
//   @static 数组(TallyData.depthDose等) 拷贝到局部变量传入 GPU
import env;
import "./transport.myp";
import "./source.myp";
import "./logger.myp";
import "./tally.myp";
import "./data_manager.myp";

mapping() {
    Source.batchReady -> Transport.runBatch;
}

class Main {
    action:
        @startup void run() {
            Console.writeString("============================================\n");
            Console.writeString("  BNCT GPU — 事件驱动引擎\n");
            Console.writeString("============================================\n");

            // ============================================
            // 配置参数
            // ============================================
            int nP = 500000, bs = 10000, nb = nP / bs;
            int[] ppms = new int[4];
            ppms[0] = 5; ppms[1] = 15; ppms[2] = 35; ppms[3] = 65;
            int nz = 30;
            double phantomSize = 30.0;

            // ============================================
            // 创建实例
            // ============================================
            Source source = new Source();
            Transport transport = new Transport();
            Tally tally = new Tally();

            // ============================================
            // 循环 B-10 浓度
            // ============================================
            for (int pi = 0; pi < 4; pi = pi + 1) {
                int ppm = ppms[pi];
                CrossSectionDB.setBDensity(ppm * 1.0);
                Console.writeString("\n--- "); Console.write(ppm);
                Console.writeString(" ppm ---\n");

                // 重置 tally
                TallyData.depthDose = new double[nz];
                TallyData.depthCap  = new int[nz];
                TallyData.depthBCap = new int[nz];
                TallyData.pendingBatches = new int[1];
                TallyData.pendingBatches[0] = nb;
                TallyData.nz = nz;
                TallyData.phantomSize = phantomSize;

                // 发射粒子批次 → Transport 通过 mapping 自动处理
                source.start(nb, bs);

                // 等待 GPU 计算完成
                while (TallyData.pendingBatches[0] > 0) {}

                // 显示结果
                tally.writeResults("gpu");
            }

            Console.writeString("\n[BNCT GPU Done]\n");
        }
}

int main() {
    Main m = new Main();
    Source source = new Source();
    Transport transport = new Transport();
    Tally tally = new Tally();
    return 0;
}
