// tally.myp — @static class 共享剂量数据 + 事件累计器
import env;
import atomic;

@static class TallyData {
    property:
        double[] depthDose;      // [nz] 每层沉积能量 (MeV)
        int[] depthCap;          // [nz] 每层俘获数
        int[] depthBCap;         // [nz] 每层 B-10 俘获数
        double[] depthFlux;      // [nz] 每层跟踪长度通量 (cm)
        double[] depthDoseKerma; // [nz] 每层 KERMA 剂量 (MeV)
        int[] pendingBatches;    // [1] 剩余批次数
        int nz;                  // 深度层数
        double phantomSize;      // 水模厚度 (cm)
}

// Tally — 事件驱动累计器
class Tally {
    action:
        void init(int nBatches, int nzIn, double ps) {
            TallyData.depthDose = new double[nzIn];
            TallyData.depthCap  = new int[nzIn];
            TallyData.depthBCap = new int[nzIn];
            TallyData.pendingBatches = new int[1];
            TallyData.pendingBatches[0] = nBatches;
            TallyData.nz = nzIn;
            TallyData.phantomSize = ps;
        }

        void addBatch(int cap, int bcap, double dose) {
            Atomic.addInt(TallyData.pendingBatches, 0, -1);
        }

        // 收到 allDone 信号后写入结果文件
        @thread void writeResults(string prefix) {
            // 汇总
            double td = 0.0; int tc = 0; int tbc = 0;
            double tflux = 0.0; double tkerma = 0.0;
            Console.writeString("\n========== Results ==========\n");
            Console.writeString(" depth  | dose      | cap  | B10   | flux      | kerma\n");
            for (int iz = 0; iz < TallyData.nz; iz = iz + 1) {
                td = td + TallyData.depthDose[iz];
                tc = tc + TallyData.depthCap[iz];
                tbc = tbc + TallyData.depthBCap[iz];
                tflux = tflux + TallyData.depthFlux[iz];
                tkerma = tkerma + TallyData.depthDoseKerma[iz];
                double d = (iz + 0.5) * TallyData.phantomSize / TallyData.nz;
                Console.writeFloat(d); Console.writeString(" | ");
                Console.writeFloat(TallyData.depthDose[iz]); Console.writeString(" | ");
                Console.write(TallyData.depthCap[iz]); Console.writeString(" | ");
                Console.write(TallyData.depthBCap[iz]); Console.writeString(" | ");
                Console.writeFloat(TallyData.depthFlux[iz]); Console.writeString(" | ");
                Console.writeFloat(TallyData.depthDoseKerma[iz]); Console.writeString("\n");
            }
            Console.writeString("  total: cap="); Console.write(tc);
            Console.writeString(" B10="); Console.write(tbc);
            Console.writeString(" dose="); Console.writeFloat(td);
            Console.writeString(" MeV flux="); Console.writeFloat(tflux);
            Console.writeString(" kerma="); Console.writeFloat(tkerma);
            if (tbc > 0) {
                Console.writeString(" H/B=");
                Console.writeFloat((tc - tbc) * 1.0 / tbc);
            }
            Console.writeString("\n=============================\n");
        }
}