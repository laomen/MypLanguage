// BNCT GPU 完整测试 - 简化版，跳过 Nuclide/Material 复杂结构
import env;
import math;
import atomic;
import "./random.myp";
import "./physics.myp";

class Tester {
    action:
        @startup void go() {
            Console.writeString("============================================\n");
            Console.writeString("  BNCT GPU — 简化版测试\n");
            Console.writeString("============================================\n");

            int nP = 128;
            int nz = 10;
            double phantomSize = 20.0;
            double voxSize = phantomSize / nz;

            double[] depthDose = new double[nz];
            int[] depthCap = new int[nz];
            double nH = 6.68e-2, nO = 3.34e-2;

            @gpu for (long i = 0L; i < nP; i = i + 1L) {
                long state = i * 152917L + 1L;
                double z = 0.0, E = 1.0e-3;
                double sigT = nH * 2.5 + nO * 1.5;
                double sigCap = nH * 0.5;

                while (z < phantomSize && E > 1.0e-6) {
                    state = Random.next(state);
                    double xi = Random.prn(state);
                    double d = -Math.log(xi) / sigT;

                    state = Random.next(state);
                    double rn_mu = Random.prn(state);
                    double mu = 2.0 * rn_mu - 1.0;
                    z = z + d * mu;
                    if (z < 0.0 || z >= phantomSize) break;

                    int iz = Math.trunc(z / voxSize);
                    if (iz < 0) iz = 0;
                    if (iz >= nz) iz = nz - 1;

                    state = Random.next(state);
                    double xi2 = Random.prn(state) * sigT;

                    if (xi2 < sigCap) {
                        Atomic.addDouble(depthDose, iz, 1.0);
                        Atomic.addInt(depthCap, iz, 1);
                        break;
                    } else {
                        state = Random.next(state);
                        double rn_h = Random.prn(state);
                        double mu2 = 2.0 * rn_h - 1.0;
                        E = E * (1.0 + mu2) / 2.0;
                        if (E < 1.0e-6) E = 0.0;
                    }
                }
            }

            long total = 0L;
            double totalDose = 0.0;
            Console.writeString("  depth  | dose    | cap\n");
            for (int iz = 0; iz < nz; iz = iz + 1) {
                total = total + depthCap[iz];
                totalDose = totalDose + depthDose[iz];
                double d = (iz + 0.5) * phantomSize / nz;
                Console.writeFloat(d);
                Console.writeString(" | ");
                Console.writeFloat(depthDose[iz]);
                Console.writeString(" | ");
                Console.writeLong(depthCap[iz]);
                Console.writeString("\n");
            }
            Console.writeString("  total: cap=");
            Console.writeLong(total);
            Console.writeString(" dose=");
            Console.writeFloat(totalDose);
            Console.writeString(" MeV\n");
            Console.writeString("\n[BNCT GPU Done]\n");
        }
}

int main() {
    Tester t = new Tester();
    return 0;
}
