// material_loader.myp — 材料加载器
// 参考: bnctDoseEngine/include/gemotry/material_loader.h
import "./material.myp";

struct MaterialLoadOptions {
    bool strict_require_xs;
    bool fallback_to_material_name_for_missing_element;
}

struct MaterialLoadReport {
    string material_name;
    string material_dir;
    string[] requested_components;
    long nRequested;
    string[] loaded_components;
    long nLoaded;
    string[] missing_components;
    long nMissing;
}

struct LoadedMaterial {
    Material material;
    MaterialLoadReport report;
}
