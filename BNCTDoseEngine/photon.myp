import "./partical.myp";

enum PhotonReaction {
    NONE;
    RAYLEIGH;
    COMPTON;
    PHOTOELECTRIC;
    PAIR_PRODUCTION;
}

struct PhotonInteractionData {
    double coherent_xs;
    double incoherent_xs;
    double photoelectric_xs;
    double pair_production_xs;
    bool doppler_broadening;
}
