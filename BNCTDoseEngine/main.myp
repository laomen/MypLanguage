// main.myp — BNCT 水模剂量引擎 v3 (@parallel for 深度剂量 + 浓度扫描)
// 真实 HDF5 截面 (ENDF/B-VIII.0) + BNCT 能谱 + 深度剂量分布
// 
// 功能:
//   1. 深度剂量分布 (Dose  vs Depth)
//   2. 多硼浓度对比 (5, 15, 35, 65 ppm)
//   3. 原子操作并行累加
import env;
import atomic;
import "./physics.myp";
import "./xs_loader.myp";

class Simulator {
    action:
        @startup void run() {
            string dataDir = "/home/xlkj/code/Data Libraries/Official Data Libraries/endfb80/endfb80_hdf5";

            Console.writeString("============================================\n");
            Console.writeString("  BNCT 水模剂量引擎 v3 — 深度剂量 + 浓度扫描\n");
            Console.writeString("============================================\n");

            // 加载截面数据 (一次加载, 多次复用)
            double[] eGrid  = XSInterp.loadData(dataDir + "/H1.h5", "/H1/energy/294K");
            double[] h1El   = XSInterp.loadData(dataDir + "/H1.h5", "/H1/reactions/reaction_002/294K/xs");
            double[] h1Cap  = XSInterp.loadData(dataDir + "/H1.h5", "/H1/reactions/reaction_102/294K/xs");
            double[] o16El  = XSInterp.loadData(dataDir + "/O16.h5", "/O16/reactions/reaction_002/294K/xs");
            double[] b10Cap = XSInterp.loadData(dataDir + "/B10.h5", "/B10/reactions/reaction_107/294K/xs");

            this.eGrid = eGrid; this.nE = 631;
            this.h1El = h1El; this.h1Cap = h1Cap;
            this.o16El = o16El; this.b10Cap = b10Cap;

            // 水模参数
            this.phantomSize = 30.0;
            int nx = 10, ny = 10, nz = 30;  // 1 mm 每层
            int totalVoxels = nx * ny * nz;
            this.nx = nx; this.ny = ny; this.nz = nz;

            // 浓度扫描
            int nParticles = 500000;
            int batchSize = 10000;
            this.batchSize = batchSize;

            // 5 ppm
            runPPMPass(5.0, nParticles, totalVoxels, nz);
            // 15 ppm
            runPPMPass(15.0, nParticles, totalVoxels, nz);
            // 35 ppm
            runPPMPass(35.0, nParticles, totalVoxels, nz);
            // 65 ppm
            runPPMPass(65.0, nParticles, totalVoxels, nz);
        }

        void runPPMPass(double ppm, int nParticles, int totalVoxels, int nz) {
            double nB = ppm * 1.0e-6 * 0.6022e24 * 0.199 / 10.8;

            // 重置体素数组
            this.pDose  = new double[totalVoxels];
            this.pCap   = new int[totalVoxels];
            this.pBCap  = new int[totalVoxels];
            this.depthDose  = new double[nz];
            this.depthCap   = new int[nz];
            this.depthBCap  = new int[nz];

            this.nB = nB;
            int nBatches = nParticles / this.batchSize;

            Console.writeString("\n--- 硼浓度: ");
            Console.writeFloat(ppm);
            Console.writeString(" ppm (");
            Console.write(nParticles);
            Console.writeString(" 粒子) ---\n");

            @parallel for (int b = 0; b < nBatches; b = b + 1) {
                runBatch(b, this.batchSize);
            }

            // 汇总
            double totDose = 0.0;
            int totCap = 0, totBCap = 0;
            for (int i = 0; i < totalVoxels; i = i + 1) {
                totDose = totDose + this.pDose[i];
                totCap  = totCap  + this.pCap[i];
                totBCap = totBCap + this.pBCap[i];
            }

            // 输出深度剂量
            Console.writeString("\n  深度(mm)  | 剂量(MeV)  | 总俘获 | B-10俘获\n");
            Console.writeString("  ----------+------------+--------+---------\n");
            for (int iz = 0; iz < nz; iz = iz + 1) {
                double depth = (iz + 0.5) * this.phantomSize / nz;
                Console.writeFloat(depth);
                Console.writeString("    | ");
                Console.writeFloat(this.depthDose[iz]);
                Console.writeString("   | ");
                Console.write(this.depthCap[iz]);
                Console.writeString("   | ");
                Console.write(this.depthBCap[iz]);
                Console.writeString("\n");
            }

            Console.writeString("\n  总结果: 俘获=");
            Console.write(totCap);
            Console.writeString("  B-10=");
            Console.write(totBCap);
            Console.writeString("  H-1=");
            Console.write(totCap - totBCap);
            Console.writeString("  剂量=");
            Console.writeFloat(totDose);
            Console.writeString(" MeV");
            Console.writeString("  H/B比=");
            Console.writeFloat((totCap - totBCap) * 1.0 / totBCap);
            Console.writeString("\n");
        }

        // 批处理: 输运一批粒子
        void runBatch(int batchId, int size) {
            double nB = this.nB;
            double phantomSize = this.phantomSize;
            int nx = this.nx, ny = this.ny, nz = this.nz;
            double[] eGrid = this.eGrid;
            double[] h1El = this.h1El, h1Cap = this.h1Cap;
            double[] o16El = this.o16El, b10Cap = this.b10Cap;
            long nE = this.nE;
            double voxSize = phantomSize / nz;
            double nH = 6.68e22;
            double nO = 3.34e22;
            double beamRadius = 5.0;

            for (int i = 0; i < size; i = i + 1) {
                long seed = (batchId * size + i) * 152917L + 1L;
                long state = seed;
                double r = Math.sqrt(Physics.toDouble(Physics.rngStep(state))) * beamRadius;
                double theta = 6.283185307 * Physics.toDouble(Physics.rngStep(state));
                double x = r * Math.cos(theta) + nx * 0.5;
                double y = r * Math.sin(theta) + ny * 0.5;
                double z = 0.0;
                state = Physics.rngStep(state);
                double E = Physics.sampleEnergy(state);

                while (z < phantomSize && E > 1.0e-5) {
                    double sHEl  = XSInterp.interp(E, eGrid, h1El,  nE) * 1.0e-24;
                    double sHCap = XSInterp.interp(E, eGrid, h1Cap, nE) * 1.0e-24;
                    double sOEl  = XSInterp.interp(E, eGrid, o16El,  nE) * 1.0e-24;
                    double sBCap = XSInterp.interp(E, eGrid, b10Cap, nE) * 1.0e-24;
                    double sigT   = nH * (sHEl + sHCap) + nO * sOEl + nB * sBCap;
                    double sigCap = nH * sHCap + nB * sBCap;
                    double sigBCap = nB * sBCap;
                    state = Physics.rngStep(state);
                    double d = -Math.log(Physics.toDouble(state)) / sigT;
                    state = Physics.rngStep(state);
                    double mu = Physics.sampleMu(state);
                    z = z + d * mu;
                    if (z < 0.0 || z >= phantomSize) break;
                    int iz = Math.trunc(z / voxSize);
                    int iy = Math.trunc(y);
                    int ix = Math.trunc(x);
                    if (ix < 0) ix = 0; if (ix >= nx) ix = nx - 1;
                    if (iy < 0) iy = 0; if (iy >= ny) iy = ny - 1;
                    if (iz < 0) iz = 0; if (iz >= nz) iz = nz - 1;
                    int idx = ix + iy * nx + iz * nx * ny;
                    state = Physics.rngStep(state);
                    double xi = Physics.toDouble(state) * sigT;
                    if (xi < sigBCap) {
                        double eDep = Physics.boronCaptureMeV();
                        Atomic.addDouble(this.pDose, idx, eDep);
                        Atomic.addDouble(this.depthDose, iz, eDep);
                        Atomic.addInt(this.pBCap, idx, 1);
                        Atomic.addInt(this.pCap, idx, 1);
                        Atomic.addInt(this.depthBCap, iz, 1);
                        Atomic.addInt(this.depthCap, iz, 1);
                        break;
                    } else if (xi < sigCap) {
                        double eDep = Physics.h1CaptureMeV();
                        Atomic.addDouble(this.pDose, idx, eDep);
                        Atomic.addDouble(this.depthDose, iz, eDep);
                        Atomic.addInt(this.pCap, idx, 1);
                        Atomic.addInt(this.depthCap, iz, 1);
                        break;
                    } else {
                        double xsRem = xi - sigCap;
                        double sigH = nH * sHEl;
                        if (xsRem < sigH) {
                            double mu2 = Physics.sampleMu(Physics.rngStep(state));
                            E = E * (1.0 + mu2) / 2.0;
                        } else {
                            double mu2 = Physics.sampleMu(Physics.rngStep(state));
                            double A = 16.0;
                            E = E * (A*A + 2.0*A*mu2 + 1.0) / ((A+1.0)*(A+1.0));
                        }
                        if (E < 1.0e-5) E = 0.0;
                    }
                }
            }
        }

    property:
        double[] eGrid; double[] h1El; double[] h1Cap;
        double[] o16El; double[] b10Cap;
        long nE;
        double nB; double phantomSize; int batchSize;
        int nx; int ny; int nz;
        double[] pDose; int[] pCap; int[] pBCap;
        double[] depthDose; int[] depthCap; int[] depthBCap;
}

int main() { Simulator s = new Simulator(); return 0; }
