// nuclide.myp — 核素定义 (MYP 移植)
// 参考: bnctDoseEngine/include/data_define/nuclide.h, cross_sections.h
import math;

// ============================================================
// CrossSectionTable — 截面表: 能量数组 + 截面值数组 (barn)
// ============================================================
struct CrossSectionTable {
    double[] energies;
    long nEnergies;
    double[] values;
    long nValues;

    // 初始化: 绑定数据指针和长度
    void setup(double[] eGrid, double[] xsVals, long n) {
        energies = eGrid;
        values = xsVals;
        nEnergies = n;
        nValues = n;
    }

    // 对数-对数线性插值: 给定能量 E (eV), 返回截面值 (barn)
    double interp(double E) {
        if (nEnergies <= 0L) return 0.0;
        if (E <= energies[0]) return values[0];
        if (E >= energies[nEnergies - 1L]) return values[nEnergies - 1L];

        long lo = 0L;
        long hi = nEnergies - 1L;
        while (hi - lo > 1L) {
            long mid = (lo + hi) / 2L;
            if (E < energies[mid]) hi = mid;
            else lo = mid;
        }

        double eLo = energies[lo];
        double eHi = energies[hi];
        double vLo = values[lo];
        double vHi = values[hi];

        if (vLo > 0.0 && vHi > 0.0) {
            double logE = Math.log(E);
            double logELo = Math.log(eLo);
            double logEHi = Math.log(eHi);
            double t = (logE - logELo) / (logEHi - logELo);
            return Math.exp(Math.log(vLo) + t * (Math.log(vHi) - Math.log(vLo)));
        }
        return vLo + (vHi - vLo) * (E - eLo) / (eHi - eLo);
    }
}

// ============================================================
// MicroscopicNeutronXs — 微观中子截面 (单能点)
// ============================================================
struct MicroscopicNeutronXs {
    double elastic_xs;
    double inelastic_xs;
    double thermal_scattering_xs;
    double thermal_elastic_xs;
    double thermal_inelastic_xs;
    double capture_xs;
    double fission_xs;
    double nu_bar;
    double elastic_mu;
    double inelastic_mu;
    double inelastic_energy_factor;
    bool create_capture_photon;
    double capture_photon_energy;

    void clear() {
        elastic_xs = 0.0; inelastic_xs = 0.0;
        thermal_scattering_xs = 0.0; thermal_elastic_xs = 0.0;
        thermal_inelastic_xs = 0.0; capture_xs = 0.0;
        fission_xs = 0.0; nu_bar = 0.0;
        elastic_mu = 0.0; inelastic_mu = 0.0;
        inelastic_energy_factor = 1.0;
        create_capture_photon = false;
        capture_photon_energy = 0.0;
    }

    double total() {
        return elastic_xs + inelastic_xs + thermal_scattering_xs
             + thermal_elastic_xs + thermal_inelastic_xs
             + capture_xs + fission_xs;
    }
}

// ============================================================
// MicroscopicPhotonXs — 微观光子截面 (单能点)
// ============================================================
struct MicroscopicPhotonXs {
    double coherent_xs;
    double incoherent_xs;
    double photoelectric_xs;
    double pair_production_xs;
    bool doppler_broadening;

    void clear() {
        coherent_xs = 0.0; incoherent_xs = 0.0;
        photoelectric_xs = 0.0; pair_production_xs = 0.0;
        doppler_broadening = false;
    }

    double total() {
        return coherent_xs + incoherent_xs + photoelectric_xs + pair_production_xs;
    }
}

// ============================================================
// NeutronXsTableSet — 中子截面表格集 (含所有反应道)
// ============================================================
struct NeutronXsTableSet {
    CrossSectionTable elastic;
    CrossSectionTable inelastic;
    CrossSectionTable thermal_elastic;
    double thermal_elastic_debye_waller;
    CrossSectionTable thermal_inelastic;
    double thermal_sab_fraction;
    CrossSectionTable capture;
    CrossSectionTable fission;
    CrossSectionTable nu_bar;
    CrossSectionTable elastic_mu;
    CrossSectionTable inelastic_mu;
    CrossSectionTable inelastic_energy_factor;
    bool create_capture_photon;
    double capture_photon_energy;
}

// ============================================================
// PhotonXsTableSet — 光子截面表格集
// ============================================================
struct PhotonXsTableSet {
    CrossSectionTable coherent;
    CrossSectionTable incoherent;
    CrossSectionTable photoelectric;
    CrossSectionTable pair_production;
    bool doppler_broadening;
}

// ============================================================
// Nuclide — 核素: 基本属性 + 微观截面数据
// ============================================================
struct Nuclide {
    string name;
    int Z;
    int A;
    double atomic_weight_ratio;
    MicroscopicNeutronXs neutron_xs;
    MicroscopicPhotonXs photon_xs;
    NeutronXsTableSet neutron_xs_table_set;
    PhotonXsTableSet photon_xs_table_set;

    void init(string n, int z, int a, double awr) {
        name = n;
        Z = z;
        A = a;
        atomic_weight_ratio = awr;
        neutron_xs.clear();
        photon_xs.clear();
    }

    // 在给定能量 E (eV) 处, 用截面表填充 neutron_xs 字段
    void fillNeutronXS(double E) {
        CrossSectionTable te = neutron_xs_table_set.elastic;
        neutron_xs.elastic_xs = te.interp(E);
        CrossSectionTable ti = neutron_xs_table_set.inelastic;
        neutron_xs.inelastic_xs = ti.interp(E);
        CrossSectionTable tte = neutron_xs_table_set.thermal_elastic;
        neutron_xs.thermal_elastic_xs = tte.interp(E);
        CrossSectionTable tti = neutron_xs_table_set.thermal_inelastic;
        neutron_xs.thermal_inelastic_xs = tti.interp(E);
        CrossSectionTable tc = neutron_xs_table_set.capture;
        neutron_xs.capture_xs = tc.interp(E);
        CrossSectionTable tf = neutron_xs_table_set.fission;
        neutron_xs.fission_xs = tf.interp(E);
        CrossSectionTable tn = neutron_xs_table_set.nu_bar;
        neutron_xs.nu_bar = tn.interp(E);
        CrossSectionTable tem = neutron_xs_table_set.elastic_mu;
        neutron_xs.elastic_mu = tem.interp(E);
        CrossSectionTable tim = neutron_xs_table_set.inelastic_mu;
        neutron_xs.inelastic_mu = tim.interp(E);
        CrossSectionTable tief = neutron_xs_table_set.inelastic_energy_factor;
        neutron_xs.inelastic_energy_factor = tief.interp(E);
        neutron_xs.create_capture_photon = neutron_xs_table_set.create_capture_photon;
        neutron_xs.capture_photon_energy = neutron_xs_table_set.capture_photon_energy;
    }

    // 在给定能量 E (eV) 处, 用截面表填充 photon_xs 字段
    void fillPhotonXS(double E) {
        CrossSectionTable tcoh = photon_xs_table_set.coherent;
        photon_xs.coherent_xs = tcoh.interp(E);
        CrossSectionTable tinc = photon_xs_table_set.incoherent;
        photon_xs.incoherent_xs = tinc.interp(E);
        CrossSectionTable tpe = photon_xs_table_set.photoelectric;
        photon_xs.photoelectric_xs = tpe.interp(E);
        CrossSectionTable tpp = photon_xs_table_set.pair_production;
        photon_xs.pair_production_xs = tpp.interp(E);
        photon_xs.doppler_broadening = photon_xs_table_set.doppler_broadening;
    }

    // 获取指定能量 E (eV) 处的中子微观截面（返回填充后的副本）
    MicroscopicNeutronXs getNeutronXS(double E) {
        fillNeutronXS(E);
        return neutron_xs;
    }

    // 获取指定能量 E (eV) 处的光子微观截面（返回填充后的副本）
    MicroscopicPhotonXs getPhotonXS(double E) {
        fillPhotonXS(E);
        return photon_xs;
    }

}