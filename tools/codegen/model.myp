// model.myp — tools/codegen schema 模型类型
// schema（JSON 声明）解析后的结构化表示，各生成器共享。

import collections;

class Field {
    action:
        @constructor Field() {
            name = "";
            type = "";
            array = 0;
        }
        void set(string n, string t, int a) {
            name = n;
            type = t;
            array = a;
        }
    property:
        string name;      // 字段名
        string type;      // 类型名（int/double/string/自定义类型…）
        int array;        // 1 = 动态数组（P0b 暂不支持，检测即告警跳过）
}

class TypeDecl {
    action:
        @constructor TypeDecl() {
            name = "";
            kind = "struct";            // struct / class / enum / op / ffi
            fields = new ArrayList<Field>();
        }
        void setName(string v) { name = v; }
        void setKind(string v) { kind = v; }
        void addField(Field f) { fields.add(f); }
        int fieldCount() { return fields.size(); }
        Field field(int i) { return fields.get(i); }
    property:
        string name;
        string kind;
        ArrayList<Field> fields;
}

class FfiParam {
    action:
        @constructor FfiParam() { type = ""; name = ""; }
        void set(string t, string n) { type = t; name = n; }
    property:
        string type;      // int/long/double/string/void…
        string name;
}

class FfiFunc {
    action:
        @constructor FfiFunc() {
            name = "";
            ret = "void";
            params = new ArrayList<FfiParam>();
        }
        void setName(string v) { name = v; }
        void setRet(string v) { ret = v; }
        void addParam(FfiParam p) { params.add(p); }
        int paramCount() { return params.size(); }
        FfiParam paramAt(int i) { return params.get(i); }
    property:
        string name;      // C 函数名
        string ret;       // 返回类型
        ArrayList<FfiParam> params;
}

class Resource {
    action:
        @constructor Resource() {
            name = "";
            handleType = "long";
            invalid = "0";
            openC = ""; openRet = ""; openParams = ""; openArgs = "";
            closeC = ""; closeRet = ""; closeArgs = "";
        }
        // open/close 以扁平字符串存储（避免跨类 FfiFunc 对象引用的编译器边界问题）
        void setName(string v) { name = v; }
        void setHandleType(string v) { handleType = v; }
        void setInvalid(string v) { invalid = v; }
        void setOpen(string c, string ret, string paramsDecl, string args) {
            openC = c; openRet = ret; openParams = paramsDecl; openArgs = args;
        }
        void setClose(string c, string ret, string args) {
            closeC = c; closeRet = ret; closeArgs = args;
        }
    property:
        string name;          // 包装类名
        string handleType;    // long / int
        string invalid;       // 无效句柄哨兵（barrier=-1，多数 C API=0）
        string openC;         // open C 函数名
        string openRet;
        string openParams;    // 参数声明串（"int count"）
        string openArgs;      // 调用实参串（"count"）
        string closeC;        // close C 函数名
        string closeRet;
        string closeArgs;     // 调用实参串（handle 参数已替换为 handle_）
}

class Schema {
    action:
        @constructor Schema() {
            types = new ArrayList<TypeDecl>();
            ffiFuncs = new ArrayList<FfiFunc>();
            resources = new ArrayList<Resource>();
        }
        void addType(TypeDecl t) { types.add(t); }
        int typeCount() { return types.size(); }
        TypeDecl typeAt(int i) { return types.get(i); }
        void addFfi(FfiFunc f) { ffiFuncs.add(f); }
        int ffiCount() { return ffiFuncs.size(); }
        FfiFunc ffiAt(int i) { return ffiFuncs.get(i); }
        void addResource(Resource r) { resources.add(r); }
        int resourceCount() { return resources.size(); }
        Resource resourceAt(int i) { return resources.get(i); }
    property:
        ArrayList<TypeDecl> types;
        ArrayList<FfiFunc> ffiFuncs;
        ArrayList<Resource> resources;
}
