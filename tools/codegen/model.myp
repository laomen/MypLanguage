// model.myp — tools/codegen schema 模型类型
// schema（JSON 声明）解析后的结构化表示，各生成器共享。

import collections;

class Field {
    action:
        @constructor Field() {
            name = "";
            type = "";
            array = 0;
            key = 0;
        }
        void set(string n, string t, int a) {
            name = n;
            type = t;
            array = a;
        }
        void setKey(int v) { key = v; }
    property:
        string name;      // 字段名
        string type;      // 类型名（int/double/string/自定义类型…）
        int array;        // 1 = 动态数组（P0b 暂不支持，检测即告警跳过）
        int key;          // 1 = 主键（ORM 用）
}

class TypeDecl {
    action:
        @constructor TypeDecl() {
            name = "";
            kind = "struct";            // struct / class / enum / op / ffi
            fields = new ArrayList<Field>();
        }
        void setName(string v) { name = v; }
        void setKind(string v) { kind = v; }
        void addField(Field f) { fields.add(f); }
        int fieldCount() { return fields.size(); }
        Field field(int i) { return fields.get(i); }
    property:
        string name;
        string kind;
        ArrayList<Field> fields;
}

class FfiParam {
    action:
        @constructor FfiParam() { type = ""; name = ""; }
        void set(string t, string n) { type = t; name = n; }
    property:
        string type;      // int/long/double/string/void…
        string name;
}

class FfiFunc {
    action:
        @constructor FfiFunc() {
            name = "";
            ret = "void";
            params = new ArrayList<FfiParam>();
        }
        void setName(string v) { name = v; }
        void setRet(string v) { ret = v; }
        void addParam(FfiParam p) { params.add(p); }
        int paramCount() { return params.size(); }
        FfiParam paramAt(int i) { return params.get(i); }
    property:
        string name;      // C 函数名
        string ret;       // 返回类型
        ArrayList<FfiParam> params;
}

class Resource {
    action:
        @constructor Resource() {
            name = "";
            handleType = "long";
            invalid = "0";
            openC = ""; openRet = ""; openParams = ""; openArgs = "";
            closeC = ""; closeRet = ""; closeArgs = "";
        }
        // open/close 以扁平字符串存储（避免跨类 FfiFunc 对象引用的编译器边界问题）
        void setName(string v) { name = v; }
        void setHandleType(string v) { handleType = v; }
        void setInvalid(string v) { invalid = v; }
        void setOpen(string c, string ret, string paramsDecl, string args) {
            openC = c; openRet = ret; openParams = paramsDecl; openArgs = args;
        }
        void setClose(string c, string ret, string args) {
            closeC = c; closeRet = ret; closeArgs = args;
        }
    property:
        string name;          // 包装类名
        string handleType;    // long / int
        string invalid;       // 无效句柄哨兵（barrier=-1，多数 C API=0）
        string openC;         // open C 函数名
        string openRet;
        string openParams;    // 参数声明串（"int count"）
        string openArgs;      // 调用实参串（"count"）
        string closeC;        // close C 函数名
        string closeRet;
        string closeArgs;     // 调用实参串（handle 参数已替换为 handle_）
}

class ExprDecl {
    action:
        @constructor ExprDecl() {
            name = "";
            expr = "";
            vars = new ArrayList<string>();
        }
        void setName(string v) { name = v; }
        void setExpr(string v) { expr = v; }
        void addVar(string v) { vars.add(v); }
        int varCount() { return vars.size(); }
        string varAt(int i) { return vars.get(i); }
    property:
        string name;       // 函数名
        string expr;       // 表达式源码串
        ArrayList<string> vars;   // 自变量（梯度按序）
}

class MethodDecl {
    action:
        @constructor MethodDecl() {
            name = "";
            ret = "void";
            params = new ArrayList<FfiParam>();
        }
        void setName(string v) { name = v; }
        void setRet(string v) { ret = v; }
        void addParam(FfiParam p) { params.add(p); }
        int paramCount() { return params.size(); }
        FfiParam paramAt(int i) { return params.get(i); }
    property:
        string name;      // 方法名
        string ret;       // 返回类型
        ArrayList<FfiParam> params;
}

class ServiceDecl {
    action:
        @constructor ServiceDecl() {
            name = "";
            methods = new ArrayList<MethodDecl>();
        }
        void setName(string v) { name = v; }
        void addMethod(MethodDecl m) { methods.add(m); }
        int methodCount() { return methods.size(); }
        MethodDecl methodAt(int i) { return methods.get(i); }
    property:
        string name;
        ArrayList<MethodDecl> methods;
}

class TableDecl {
    action:
        @constructor TableDecl() {
            name = "";
            table = "";
            fields = new ArrayList<Field>();
        }
        void setName(string v) { name = v; }
        void setTable(string v) { table = v; }
        void addField(Field f) { fields.add(f); }
        int fieldCount() { return fields.size(); }
        Field fieldAt(int i) { return fields.get(i); }
        // 主键下标（无标记 → 默认第一个字段）
        int keyIndex() {
            int i = 0;
            while (i < fields.size()) {
                if (fields.get(i).key == 1) return i;
                i = i + 1;
            }
            return 0;
        }
    property:
        string name;            // 实体类型名（struct 名）
        string table;           // SQL 表名
        ArrayList<Field> fields;
}

class EmbedDecl {
    action:
        @constructor EmbedDecl() {
            name = "";
            path = "";
        }
        void set(string n, string p) { name = n; path = p; }
    property:
        string name;      // 生成函数名
        string path;      // 源文件路径（相对 CWD）
}

class DslOp {
    action:
        @constructor DslOp() {
            sym = "";     // 内部符号名（二元 = 词法文本；一元 = 如 "neg"）
            text = "";    // 词法匹配文本（二元默认 = sym）
            prec = 0;
            assoc = "left";
            unary = 0;
        }
        void set(string s, string t, int p, string a, int u) {
            sym = s; text = t; prec = p; assoc = a; unary = u;
        }
    property:
        string sym;
        string text;
        int prec;
        string assoc;
        int unary;
}

class DslDecl {
    action:
        @constructor DslDecl() {
            name = "";
            lparen = "(";
            rparen = ")";
            ops = new ArrayList<DslOp>();
        }
        void setName(string v) { name = v; }
        void setParens(string l, string r) { lparen = l; rparen = r; }
        void addOp(DslOp o) { ops.add(o); }
        int opCount() { return ops.size(); }
        DslOp opAt(int i) { return ops.get(i); }
    property:
        string name;       // 生成前缀（Calc_xxx）
        string lparen;
        string rparen;
        ArrayList<DslOp> ops;
}

class Schema {
    action:
        @constructor Schema() {
            types = new ArrayList<TypeDecl>();
            ffiFuncs = new ArrayList<FfiFunc>();
            resources = new ArrayList<Resource>();
            exprs = new ArrayList<ExprDecl>();
            service = new ServiceDecl();
            hasService = 0;
            tables = new ArrayList<TableDecl>();
            embeds = new ArrayList<EmbedDecl>();
            dsl = new DslDecl();
            hasDsl = 0;
        }
        void addType(TypeDecl t) { types.add(t); }
        int typeCount() { return types.size(); }
        TypeDecl typeAt(int i) { return types.get(i); }
        void addFfi(FfiFunc f) { ffiFuncs.add(f); }
        int ffiCount() { return ffiFuncs.size(); }
        FfiFunc ffiAt(int i) { return ffiFuncs.get(i); }
        void addResource(Resource r) { resources.add(r); }
        int resourceCount() { return resources.size(); }
        Resource resourceAt(int i) { return resources.get(i); }
        void addExpr(ExprDecl d) { exprs.add(d); }
        int exprCount() { return exprs.size(); }
        ExprDecl exprAt(int i) { return exprs.get(i); }
        void setService(ServiceDecl s) { service = s; hasService = 1; }
        int hasServiceDecl() { return hasService; }
        void addTable(TableDecl t) { tables.add(t); }
        int tableCount() { return tables.size(); }
        TableDecl tableAt(int i) { return tables.get(i); }
        void addEmbed(EmbedDecl e) { embeds.add(e); }
        int embedCount() { return embeds.size(); }
        EmbedDecl embedAt(int i) { return embeds.get(i); }
        void setDsl(DslDecl d) { dsl = d; hasDsl = 1; }
        int hasDslDecl() { return hasDsl; }
        DslDecl dslDecl() { return dsl; }
    property:
        ArrayList<TypeDecl> types;
        ArrayList<FfiFunc> ffiFuncs;
        ArrayList<Resource> resources;
        ArrayList<ExprDecl> exprs;
        ServiceDecl service;
        int hasService;
        ArrayList<TableDecl> tables;
        ArrayList<EmbedDecl> embeds;
        DslDecl dsl;
        int hasDsl;
}
