// schema.myp — JSON schema → Schema 模型
// 复用 stdlib json.myp（C 端解析器，路径查询式）。

import json;
import "./model.myp";

class SchemaParser {
    action:
        @constructor SchemaParser() {}

        // 数组长度（路径缺失 → 0）。Json.type 缺失返回 -1。
        int arrLen(Json j, string path) {
            if (j.type(path) == -1) return 0;
            return j.arrayLen(path);
        }

        Schema parse(string text) {
            Json j = new Json(text);
            Schema s = new Schema();
            int n = arrLen(j, "types");
            int i = 0;
            while (i < n) {
                string p = "types." + i;
                TypeDecl t = new TypeDecl();
                t.setName(j.getString(p + ".name"));
                t.setKind(j.getString(p + ".kind"));
                int fn = arrLen(j, p + ".fields");
                int k = 0;
                while (k < fn) {
                    string fp = p + ".fields." + k;
                    Field f = new Field();
                    int arr = 0;
                    if (j.type(fp + ".array") != -1) {
                        arr = j.getInt(fp + ".array");
                    }
                    f.set(j.getString(fp + ".name"), j.getString(fp + ".type"), arr);
                    t.addField(f);
                    k = k + 1;
                }
                s.addType(t);
                i = i + 1;
            }
            // ffi 段：C 函数声明
            int fn2 = arrLen(j, "ffi");
            int k2 = 0;
            while (k2 < fn2) {
                FfiFunc f = parseFfiFunc(j, "ffi." + k2);
                s.addFfi(f);
                k2 = k2 + 1;
            }
            // resources 段：资源包装（open/close 对，扁平字符串）
            int rn = arrLen(j, "resources");
            int r = 0;
            while (r < rn) {
                string rp = "resources." + r;
                Resource res = new Resource();
                res.setName(j.getString(rp + ".name"));
                res.setHandleType(j.getString(rp + ".handle"));
                if (j.type(rp + ".invalid") != -1) {
                    res.setInvalid(j.getString(rp + ".invalid"));
                }
                // open：声明 "int count" + 实参 "count"
                res.setOpen(
                    j.getString(rp + ".open.c"),
                    j.getString(rp + ".open.ret"),
                    paramsDecl(j, rp + ".open.params", 0),
                    paramsArgs(j, rp + ".open.params", 0));
                // close：实参中 handle 参数替换为 handle_
                res.setClose(
                    j.getString(rp + ".close.c"),
                    j.getString(rp + ".close.ret"),
                    paramsArgs(j, rp + ".close.params", 1));
                s.addResource(res);
                r = r + 1;
            }
            // exprs 段：符号求导表达式
            int en = arrLen(j, "exprs");
            int ei = 0;
            while (ei < en) {
                string ep = "exprs." + ei;
                ExprDecl d = new ExprDecl();
                d.setName(j.getString(ep + ".name"));
                d.setExpr(j.getString(ep + ".expr"));
                int vn = arrLen(j, ep + ".vars");
                int vi = 0;
                while (vi < vn) {
                    d.addVar(j.getString(ep + ".vars." + vi));
                    vi = vi + 1;
                }
                s.addExpr(d);
                ei = ei + 1;
            }
            // service 段：IDL 服务（方法表）
            if (j.type("service") != -1) {
                ServiceDecl svc = new ServiceDecl();
                svc.setName(j.getString("service.name"));
                int mn = arrLen(j, "service.methods");
                int mi = 0;
                while (mi < mn) {
                    string mp = "service.methods." + mi;
                    MethodDecl md = new MethodDecl();
                    md.setName(j.getString(mp + ".name"));
                    md.setRet(j.getString(mp + ".ret"));
                    int pn = arrLen(j, mp + ".params");
                    int pi = 0;
                    while (pi < pn) {
                        string pp = mp + ".params." + pi;
                        FfiParam p = new FfiParam();
                        p.set(j.getString(pp + ".type"), j.getString(pp + ".name"));
                        md.addParam(p);
                        pi = pi + 1;
                    }
                    svc.addMethod(md);
                    mi = mi + 1;
                }
                s.setService(svc);
            }
            // tables 段：ORM 数据表（实体字段 + 主键）
            int tn = arrLen(j, "tables");
            int ti = 0;
            while (ti < tn) {
                string tp = "tables." + ti;
                TableDecl td = new TableDecl();
                td.setName(j.getString(tp + ".name"));
                td.setTable(j.getString(tp + ".table"));
                int tfn = arrLen(j, tp + ".fields");
                int tk = 0;
                while (tk < tfn) {
                    string fp2 = tp + ".fields." + tk;
                    Field f = new Field();
                    int key = 0;
                    if (j.type(fp2 + ".key") != -1) {
                        key = j.getInt(fp2 + ".key");
                    }
                    f.set(j.getString(fp2 + ".name"), j.getString(fp2 + ".type"), 0);
                    f.setKey(key);
                    td.addField(f);
                    tk = tk + 1;
                }
                s.addTable(td);
                ti = ti + 1;
            }
            j.free();
            return s;
        }

        // 参数声明串："int count, ..."
        string paramsDecl(Json j, string path, int subHandle) {
            int pn = arrLen(j, path);
            string s = "";
            int m = 0;
            while (m < pn) {
                string pp = path + "." + m;
                if (m > 0) s = s + ", ";
                s = s + j.getString(pp + ".type") + " " + j.getString(pp + ".name");
                m = m + 1;
            }
            return s;
        }

        // 调用实参串："count, ..."；subHandle=1 时名为 handle 的参数换成 handle_
        string paramsArgs(Json j, string path, int subHandle) {
            int pn = arrLen(j, path);
            string s = "";
            int m = 0;
            while (m < pn) {
                string pp = path + "." + m;
                string nm = j.getString(pp + ".name");
                if (m > 0) s = s + ", ";
                if (subHandle == 1 && nm == "handle") { s = s + "handle_"; }
                else { s = s + nm; }
                m = m + 1;
            }
            return s;
        }

        // 解析一个 FfiFunc（路径形如 "ffi.0" / "resources.0.open"；函数名字段
        // 兼容 "c"（resources）与 "name"（独立 ffi 段））
        FfiFunc parseFfiFunc(Json j, string path) {
            FfiFunc f = new FfiFunc();
            string nm = "";
            if (j.type(path + ".c") != -1) {
                nm = j.getString(path + ".c");
            } else {
                nm = j.getString(path + ".name");
            }
            f.setName(nm);
            f.setRet(j.getString(path + ".ret"));
            int pn = arrLen(j, path + ".params");
            int m = 0;
            while (m < pn) {
                string pp = path + ".params." + m;
                FfiParam p = new FfiParam();
                p.set(j.getString(pp + ".type"), j.getString(pp + ".name"));
                f.addParam(p);
                m = m + 1;
            }
            return f;
        }
}
