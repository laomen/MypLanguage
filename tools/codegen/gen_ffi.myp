// gen_ffi.myp — ffi 生成器（P1a：C 函数 → MYP ffi 声明）
// 生成：`ffi <ret> <name>(<params>);` 声明。
// 注：MYP 无用户析构器，资源 RAII 用显式 open/close 包装类（与 stdlib 惯例一致），
// 见 design.md §7.2 说明。

import env;
import "./model.myp";
import "./emit.myp";

class FfiGen {
    action:
        @constructor FfiGen() {}

        // ffi 函数 → 声明行
        string ffiLine(FfiFunc f) {
            string line = "ffi " + f.getRet() + " " + f.getName() + "(";
            int k = 0;
            while (k < f.paramCount()) {
                FfiParam p = f.paramAt(k);
                if (k > 0) line = line + ", ";
                line = line + p.getType() + " " + p.getName();
                k = k + 1;
            }
            return line + ");";
        }

        // 资源包装类：显式 open/close（MYP 无用户析构器 → RAII 用显式生命周期）
        void genResource(Emitter e, Resource r) {
            // open/close 的 ffi 声明（扁平字符串）
            e.line("ffi " + r.getOpenRet() + " " + r.getOpenC() + "(" + r.getOpenParams() + ");");
            e.line("ffi " + r.getCloseRet() + " " + r.getCloseC() + "(" + r.getHandleType() + " handle);");
            e.line("");
            string zero = r.getInvalid();
            e.block("class " + r.getName());
            e.line("action:");
            // 构造：handle 置 0
            e.block("@constructor " + r.getName() + "()");
            e.line("handle_ = " + zero + ";");
            e.endBlock();
            // open：调用 openC，存 handle，返回
            e.block(r.getHandleType() + " open(" + r.getOpenParams() + ")");
            e.line("handle_ = " + r.getOpenC() + "(" + r.getOpenArgs() + ");");
            e.line("return handle_;");
            e.endBlock();
            // close：handle 非 0 才调用 closeC，随后清零
            e.block("void close()");
            e.line("if (handle_ != " + zero + ") {");
            e.push();
            e.line(r.getCloseC() + "(" + r.getCloseArgs() + ");");
            e.line("handle_ = " + zero + ";");
            e.pop();
            e.line("}");
            e.endBlock();
            // 访问器
            e.block(r.getHandleType() + " getHandle()");
            e.line("return handle_;");
            e.endBlock();
            e.line("property:");
            e.line(r.getHandleType() + " handle_;");
            e.endBlock();
            e.line("");
        }

        string gen(Schema s) {
            Emitter e = new Emitter();
            e.line("// ── 由 tools/codegen 生成，勿手改 ──");
            e.line("");
            int i = 0;
            while (i < s.ffiCount()) {
                FfiFunc f = s.ffiAt(i);
                e.line(ffiLine(f));
                i = i + 1;
            }
            // 资源包装
            int r = 0;
            while (r < s.resourceCount()) {
                if (s.ffiCount() == 0 && r == 0) e.line("");
                genResource(e, s.resourceAt(r));
                r = r + 1;
            }
            return e.text();
        }
}
