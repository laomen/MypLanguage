// main.myp — myp_self CLI 驱动。入口 int selfMain()。
//
// myp_self 是全自举编译器（tools/selfhost，非 GPU）的命令行驱动。
// 各 mode 随里程碑推进：
//   F1 tokens ✅（本文件 + token/lexer/diag）
//   F2-F3 ast / F4 sema / G1+ compile / G4 run/fmt。
//
// 关联: tools/selfhost/design.md §3 D1、roadmap.md F1；
// 对拍: src/main.cpp（C++ mypc --frontend-dump），契约 format.md。

import env;
import args;
import io;
import fs;
import text;
import process;
import "./diag.myp";
import "./token.myp";
import "./lexer.myp";
import "./ast.myp";
import "./parser.myp";
import "./sema.myp";
import "./codegen.myp";
import "./link.myp";

// 去重集合：参数 ArrayList 方法调用会崩溃 → 用内部用 ArrayList 的辅助类
// （其方法在类内调用 list，正常）。
class LoadedSet {
    action:
        @constructor LoadedSet() { set_ = new ArrayList<string>(); }
        void add(string s) { set_.add(s); }
        int has(string s) {
            for (int i = 0; i < set_.size(); i = i + 1) {
                if (set_.get(i) == s) return 1;
            }
            return 0;
        }
        ArrayList<string> set() { return set_; }
    property:
        ArrayList<string> set_;
}

// dump 输出辅助 + 前端模式实现。
@static class Frontend {
    static:
        // 读文件为字符串（字节级；调用前须用 Fs.exists 判存在）。
        string readFile(string path) {
            File f = new File();
            f.open(path, "r");
            string s = f.readAll();
            f.close();
            return s;
        }

        // 确定性转义（format.md §2）：\n \t \r \" \\ \0。
        // 注：MYP 串无法承载 NUL 字节，lexer 用 0x01 哨兵表示 \0，此处映射回 \0。
        string escape(string s) {
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < Str.len(s); i = i + 1) {
                int c = __myp_charcode(s, i);
                if (c == 10) sb.append("\\n");
                else if (c == 9) sb.append("\\t");
                else if (c == 13) sb.append("\\r");
                else if (c == 34) sb.append("\\\"");
                else if (c == 92) sb.append("\\\\");
                else if (c == 1) sb.append("\\0");  // 0x01 哨兵 → \0
                else sb.append(__myp_chr(c));
            }
            return sb.toString();
        }

        // 诊断排序比较（line, col, msg 升序，与 C++ 一致）。
        int diagLess(Diag a, Diag b) {
            if (a.line() != b.line()) { if (a.line() < b.line()) return 1; return 0; }
            if (a.col() != b.col()) { if (a.col() < b.col()) return 1; return 0; }
            int cm = Str.cmp(a.msg(), b.msg());
            if (cm != 0) { if (cm < 0) return 1; return 0; }
            return 0;
        }

        void printDiagnostics(DiagEngine diag) {
            Console.writeLine("(Diagnostics)");
            ArrayList<Diag> list = diag.get();
            int n = list.size();
            // 插入排序（稳定升序）。
            for (int i = 1; i < n; i = i + 1) {
                Diag key = list.get(i);
                int j = i - 1;
                while (j >= 0 && Frontend.diagLess(key, list.get(j)) == 1) {
                    list.set(j + 1, list.get(j));
                    j = j - 1;
                }
                list.set(j + 1, key);
            }
            for (int i = 0; i < n; i = i + 1) {
                Diag d = list.get(i);
                Console.writeLine("  (Diag line=" + d.line() + " col=" + d.col()
                    + " sev=" + d.sev() + " msg=\"" + Frontend.escape(d.msg()) + "\")");
            }
        }

        // F1：tokens 模式（对拍 mypc --frontend-dump tokens）。
        int tokens(string file) {
            if (Fs.exists(file) == 0) {
                Console.writeLine("Error: cannot open file '" + file + "'");
                return 1;
            }
            string src = Frontend.readFile(file);
            Lexer lx = new Lexer(src);
            ArrayList<Tok> toks = lx.tokenize();
            DiagEngine diag = lx.diags();

            Console.writeLine("MYP_FRONTEND_DUMP v1");
            Console.writeLine("(Mode tokens)");
            for (int i = 0; i < toks.size(); i = i + 1) {
                Tok t = toks.get(i);
                Console.writeLine("token " + t.begin() + ":" + t.end() + " " + t.kind()
                    + " \"" + Frontend.escape(t.value()) + "\"");
            }
            Frontend.printDiagnostics(diag);
            int ok2 = 1;
            if (diag.errorCount() != 0) ok2 = 0;
            Console.writeLine("(Result ok=" + ok2 + " errors=" + diag.errorCount() + ")");
            if (diag.errorCount() != 0) return 1;
            return 0;
        }

        // 诊断段追加到 StringBuilder（排序后）。
        void appendDiagnostics(StringBuilder sb, DiagEngine diag) {
            sb.append("(Diagnostics)\n");
            ArrayList<Diag> list = diag.get();
            int n = list.size();
            for (int i = 1; i < n; i = i + 1) {
                Diag key = list.get(i);
                int j = i - 1;
                while (j >= 0 && Frontend.diagLess(key, list.get(j)) == 1) {
                    list.set(j + 1, list.get(j));
                    j = j - 1;
                }
                list.set(j + 1, key);
            }
            for (int i = 0; i < n; i = i + 1) {
                Diag d = list.get(i);
                sb.append("  (Diag line=" + d.line() + " col=" + d.col()
                    + " sev=" + d.sev() + " msg=\"" + Frontend.escape(d.msg()) + "\")\n");
            }
        }

        // 点分模块名 → 目录层级：gpu.backend → gpu/backend。
        string dotToSlash(string name) {
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < Str.len(name); i = i + 1) {
                int c = __myp_charcode(name, i);
                if (c == 46) sb.append("/");
                else sb.append(__myp_chr(c));
            }
            return sb.toString();
        }

        // stdlib 路径探测：MYP_STDLIB env → ./stdlib → ../stdlib →
        // 相对 myp_self 二进制位置（pm 工具从包目录调用 myp_self 时 cwd 不在地根）。
        string stdlibResolve() {
            string env = Console.getEnv("MYP_STDLIB");
            if (Str.len(env) != 0 && Fs.isDir(env) != 0) return env;
            if (Fs.exists("./stdlib/env.myp") != 0) return "./stdlib";
            if (Fs.exists("../stdlib/env.myp") != 0) return "../stdlib";
            return Cli.selfStdlib();
        }

        // 路径规范化：去掉 "./" 片段与空段，作为 dedup key（对齐 C++ normalizePath）。
        // 注意：必须保留前导 '/'（绝对路径）——否则 /home/x 会退化成 home/x，
        // Fs.exists 找不到文件、loadModule 中断整个 import 链（绝对路径根文件必挂）。
        string normalizePath(string p) {
            int hasRoot = 0;
            if (Str.len(p) != 0 && __myp_charcode(p, 0) == 47) hasRoot = 1;
            ArrayList<string> parts = new ArrayList<string>();
            int start = 0;
            for (int i = 0; i <= Str.len(p); i = i + 1) {
                if (i == Str.len(p) || __myp_charcode(p, i) == 47) {
                    string seg = Str.substring(p, start, i);
                    if (Str.len(seg) != 0 && seg != ".") parts.add(seg);
                    start = i + 1;
                }
            }
            StringBuilder sb = new StringBuilder();
            if (hasRoot != 0) sb.append("/");
            for (int i = 0; i < parts.size(); i = i + 1) {
                if (i != 0) sb.append("/");
                sb.append(parts.get(i));
            }
            return sb.toString();
        }

        // 递归加载 import 并合并（对齐 C++ loadModule：合并 7 类声明；imports/macros/typeAliases 不合并）。
        // packagePath：--package-path 冒号分隔的包搜索路径（myp_packages）。
        int loadModule(AstTU tu, AstImport imp, string sourceDir, string packagePath, LoadedSet loaded, DiagEngine diag) {
            string path = "";
            if (imp.isPath() != 0) {
                if (Str.len(imp.path()) != 0 && __myp_charcode(imp.path(), 0) == 47) {
                    path = imp.path();
                } else {
                    path = sourceDir + "/" + imp.path();
                }
            } else {
                string slash = Frontend.dotToSlash(imp.name());
                string stdlib = Frontend.stdlibResolve();
                string p1 = stdlib + "/" + slash + ".myp";
                string p2 = sourceDir + "/../stdlib/" + slash + ".myp";
                string p3 = sourceDir + "/stdlib/" + slash + ".myp";
                if (Fs.exists(p1) != 0) path = p1;
                else if (Fs.exists(p2) != 0) path = p2;
                else if (Fs.exists(p3) != 0) path = p3;
                else {
                    // 包搜索路径：<pkg>/<module>/src/<module>.myp 或
                    // <pkg>/<module>/<module>.myp（冒号分隔多路径）
                    int np = Str.splitCount(packagePath, ":");
                    for (int pi = 0; pi < np && Str.len(path) == 0; pi = pi + 1) {
                        string pp = Str.trim(Str.splitGet(packagePath, ":", pi));
                        if (Str.len(pp) == 0) continue;
                        string pkgSrc = pp + "/" + slash + "/src/" + imp.name() + ".myp";
                        string pkgRoot = pp + "/" + slash + "/" + imp.name() + ".myp";
                        if (Fs.exists(pkgSrc) != 0) path = pkgSrc;
                        else if (Fs.exists(pkgRoot) != 0) path = pkgRoot;
                    }
                    if (Str.len(path) == 0) path = p1;
                }
            }
            path = Frontend.normalizePath(path);
            string key = path;
            if (imp.isPath() == 0) key = imp.name();
            if (loaded.has(key) != 0) return 1;
            loaded.add(key);
            if (Fs.exists(path) == 0) {
                // 镜像 C++：路径 import 失败只打 stderr（stdout 不输出，也不加诊断）；
                // 名字 import 失败才加诊断。
                if (imp.isPath() == 0) {
                    diag.error(0, 0, "cannot find import '" + imp.name() + "'");
                }
                return 0;
            }
            string src = Frontend.readFile(path);
            Lexer lx = new Lexer(src);
            ArrayList<Tok> toks = lx.tokenize();
            DiagEngine subDiag = lx.diags();
            Parser pr = new Parser(toks, subDiag);
            AstTU sub = pr.parse();
            // 合并 7 类声明
            for (int i = 0; i < sub.classes().size(); i = i + 1) tu.classes().add(sub.classes().get(i));
            for (int i = 0; i < sub.interfaces().size(); i = i + 1) tu.interfaces().add(sub.interfaces().get(i));
            for (int i = 0; i < sub.mappings().size(); i = i + 1) tu.mappings().add(sub.mappings().get(i));
            for (int i = 0; i < sub.functions().size(); i = i + 1) tu.functions().add(sub.functions().get(i));
            for (int i = 0; i < sub.ffis().size(); i = i + 1) tu.ffis().add(sub.ffis().get(i));
            for (int i = 0; i < sub.enums().size(); i = i + 1) tu.enums().add(sub.enums().get(i));
            for (int i = 0; i < sub.structs().size(); i = i + 1) tu.structs().add(sub.structs().get(i));
            string subDir = Fs.dirname(path);
            for (int i = 0; i < sub.imports().size(); i = i + 1) {
                AstImport si = sub.imports().get(i);
                if (Frontend.loadModule(tu, si, subDir, packagePath, loaded, diag) == 0) return 0;
            }
            return 1;
        }

        // F2：ast 模式（对拍 mypc --frontend-dump ast，含 import 合并）。
        int ast(string file) {
            if (Fs.exists(file) == 0) {
                Console.writeLine("Error: cannot open file '" + file + "'");
                return 1;
            }
            string src = Frontend.readFile(file);
            Lexer lx = new Lexer(src);
            ArrayList<Tok> toks = lx.tokenize();
            DiagEngine diag = lx.diags();
            Parser pr = new Parser(toks, diag);
            AstTU tu = pr.parse();
            if (diag.errorCount() == 0) {
                LoadedSet loaded = new LoadedSet();
                string sourceDir = Fs.dirname(file);
                for (int i = 0; i < tu.imports().size(); i = i + 1) {
                    AstImport imp = tu.imports().get(i);
                    if (Frontend.loadModule(tu, imp, sourceDir, "", loaded, diag) == 0) break;
                }
            }
            StringBuilder sb = new StringBuilder();
            sb.append("MYP_FRONTEND_DUMP v1\n");
            sb.append("(Mode ast)\n");
            tu.dump(sb);
            Frontend.appendDiagnostics(sb, diag);
            int ok2 = 1;
            if (diag.errorCount() != 0) ok2 = 0;
            sb.append("(Result ok=" + ok2 + " errors=" + diag.errorCount() + ")\n");
            Console.writeString(sb.toString());
            if (diag.errorCount() != 0) return 1;
            return 0;
        }

        // F4：sema 模式（对拍 mypc --frontend-dump sema，含 import 合并 + 类型推断）。
        int sema(string file) {
            if (Fs.exists(file) == 0) {
                Console.writeLine("Error: cannot open file '" + file + "'");
                return 1;
            }
            string src = Frontend.readFile(file);
            Lexer lx = new Lexer(src);
            ArrayList<Tok> toks = lx.tokenize();
            DiagEngine diag = lx.diags();
            Parser pr = new Parser(toks, diag);
            AstTU tu = pr.parse();
            if (diag.errorCount() == 0) {
                LoadedSet loaded = new LoadedSet();
                string sourceDir = Fs.dirname(file);
                for (int i = 0; i < tu.imports().size(); i = i + 1) {
                    AstImport imp = tu.imports().get(i);
                    if (Frontend.loadModule(tu, imp, sourceDir, "", loaded, diag) == 0) break;
                }
            }
            // C++ Sema 构造 diag_.reset() 清除 parser/loadModule 的 diag
            diag.reset();
            Sema se = new Sema(diag);
            se.analyze(tu);
            StringBuilder sb = new StringBuilder();
            sb.append("MYP_FRONTEND_DUMP v1\n");
            sb.append("(Mode sema)\n");
            tu.dump(sb);
            Frontend.appendDiagnostics(sb, diag);
            int ok2 = 1;
            if (diag.errorCount() != 0) ok2 = 0;
            sb.append("(Result ok=" + ok2 + " errors=" + diag.errorCount() + ")\n");
            Console.writeString(sb.toString());
            if (diag.errorCount() != 0) return 1;
            return 0;
        }

        // G1：compile 模式——lexer→parser→import 合并→sema→codegen(.ll)→link。
        // emitLlvmOnly != 0 时只发射 .ll（跳过 link）。
        int compile(string file, string outPath, string stdlib, string packagePath, int emitLlvmOnly, int testMode, int autoMain) {
            if (Fs.exists(file) == 0) {
                Console.writeLine("Error: cannot open file '" + file + "'");
                return 1;
            }
            string src = Frontend.readFile(file);
            Lexer lx = new Lexer(src);
            ArrayList<Tok> toks = lx.tokenize();
            DiagEngine diag = lx.diags();
            Parser pr = new Parser(toks, diag);
            AstTU tu = pr.parse();
            if (diag.errorCount() == 0) {
                LoadedSet loaded = new LoadedSet();
                string sourceDir = Fs.dirname(file);
                for (int i = 0; i < tu.imports().size(); i = i + 1) {
                    AstImport imp = tu.imports().get(i);
                    if (Frontend.loadModule(tu, imp, sourceDir, packagePath, loaded, diag) == 0) break;
                }
            }
            // 语法/import 错误必须短路——之前 diag.reset() 把 parser 诊断清掉，
            // missing_semicolon 等负例被静默放行。
            if (diag.errorCount() != 0) {
                Frontend.printDiagnostics(diag);
                return 1;
            }
            Sema se = new Sema(diag);
            se.setAutoMain(autoMain);
            se.expandMacros(tu);
            se.analyze(tu);
            if (diag.errorCount() != 0) {
                Frontend.printDiagnostics(diag);
                return 1;
            }
            CodeGen cg = new CodeGen();
            cg.setTestMode(testMode);
            string ir = cg.generate(tu);
            string llPath = outPath + ".ll";
            File of = new File();
            of.open(llPath, "w");
            of.write(ir);
            of.close();
            if (emitLlvmOnly != 0) {
                Console.writeLine("LLVM IR saved: " + llPath);
                return 0;
            }
            return Link.link(llPath, outPath, stdlib);
        }
}

@static class Cli {
    static:
        string selfStdlib() {
            string s = Console.getEnv("MYP_STDLIB");
            if (Str.len(s) > 0 && Fs.isDir(s) != 0) return s;
            // 相对 myp_self 二进制位置推断仓库 stdlib（Args.get(0) = 程序路径）
            if (Args.count() > 0) {
                string self = Args.get(0);
                string root = Fs.dirname(Fs.dirname(self));
                string cand = Fs.join(root, "stdlib");
                if (Fs.exists(Fs.join(cand, "env.myp")) != 0) return cand;
            }
            if (Fs.exists("./stdlib/env.myp") != 0) return "./stdlib";
            if (Fs.exists("../stdlib/env.myp") != 0) return "../stdlib";
            return "";
        }

        string quoteShell(string s) {
            StringBuilder sb = new StringBuilder();
            sb.append("\"");
            for (int i = 0; i < Str.len(s); i = i + 1) {
                string ch = Str.substring(s, i, i + 1);
                if (ch == "\"") sb.append("\\\"");
                else if (ch == "\\") sb.append("\\\\");
                else sb.append(ch);
            }
            sb.append("\"");
            return sb.toString();
        }

        // myp_self run <file.myp> [args...] —— 仿 go run：编译(autoMain) + 运行 + 清理（原生实现，不再委托 mypc）。
        int runFile() {
            string file = Args.get(2);
            string stdlib = Cli.selfStdlib();
            string base = "/tmp/myp_self_run_" + Process.getPid();
            int rc = Frontend.compile(file, base, stdlib, "", 0, 0, 1);
            if (rc != 0) return rc;
            StringBuilder cmd = new StringBuilder();
            cmd.append(Cli.quoteShell(base));
            int i = 3;
            while (i < Args.count()) {
                cmd.append(" " + Cli.quoteShell(Args.get(i)));
                i = i + 1;
            }
            int erc = Process.run(cmd.toString());
            Fs.removeRecursive(base);
            Fs.removeRecursive(base + ".o");
            Fs.removeRecursive(base + ".ll");
            Fs.removeRecursive(base + ".opt.ll");
            return erc;
        }

        // myp_self fmt [--check] <file.myp> ... —— 调自举格式化器 myp_fmt2（tools/fmt/main.myp），不再委托 mypc。
        int fmt() {
            string fmtBin = Console.getEnv("MYP_FMT");
            if (Str.len(fmtBin) == 0) fmtBin = "./build/myp_fmt2";
            if (Fs.isFile(fmtBin) == 0) {
                fmtBin = "/tmp/myp_fmt2_self";
                if (Fs.isFile(fmtBin) == 0) {
                    string stdlib = Cli.selfStdlib();
                    int rc = Frontend.compile("tools/fmt/main.myp", fmtBin, stdlib, "", 0, 0, 0);
                    if (rc != 0) {
                        Console.writeLine("myp_self fmt: 无法定位/编译自举格式化器（设 MYP_FMT 或提供 tools/fmt/main.myp）");
                        return rc;
                    }
                }
            }
            StringBuilder cmd = new StringBuilder();
            cmd.append(Cli.quoteShell(fmtBin));
            int i = 2;
            while (i < Args.count()) {
                cmd.append(" " + Cli.quoteShell(Args.get(i)));
                i = i + 1;
            }
            return Process.run(cmd.toString());
        }

        int run() {
            int argc = Args.count();
            if (argc < 2) {
                Cli.printHelp();
                return 1;
            }
            string arg = Args.get(1);
            if (arg == "--version") {
                Console.writeLine("MYP Self-Hosted Compiler v0.1.0 (F1 lexer)");
                return 0;
            }
            if (arg == "--help" || arg == "-h") {
                Cli.printHelp();
                return 0;
            }
            if (arg == "run") {
                if (argc < 3) {
                    Console.writeLine("Usage: myp_self run <file.myp> [args...]");
                    return 1;
                }
                return Cli.runFile();
            }
            if (arg == "fmt") {
                return Cli.fmt();
            }
            if (arg == "--frontend-dump") {
                if (argc < 4) {
                    Console.writeLine("myp_self: --frontend-dump requires <mode> <file.myp>");
                    return 1;
                }
                string mode = Args.get(2);
                string file = Args.get(3);
                if (mode == "tokens") return Frontend.tokens(file);
                if (mode == "ast") return Frontend.ast(file);
                if (mode == "sema") return Frontend.sema(file);
                Console.writeLine("myp_self: unknown mode '" + mode + "'");
                return 1;
            }
            // 默认：compile 模式（G1）——myp_self [--test] <file.myp> [-o out] [--emit-llvm] [--stdlib path] [--package-path path]
            string file = arg;
            string outPath = "";
            string stdlib = "";
            string packagePath = "";
            int emitLlvm = 0;
            int testMode = 0;
            int i = 2;
            if (arg == "--test") {
                testMode = 1;
                if (i >= argc) { Cli.printHelp(); return 1; }
                file = Args.get(i);
                i = i + 1;
            }
            while (i < argc) {
                string a = Args.get(i);
                if (a == "-o") {
                    i = i + 1;
                    if (i < argc) outPath = Args.get(i);
                } else if (a == "--emit-llvm") {
                    emitLlvm = 1;
                } else if (a == "--test") {
                    testMode = 1;
                } else if (a == "--stdlib") {
                    i = i + 1;
                    if (i < argc) stdlib = Args.get(i);
                } else if (a == "--package-path") {
                    i = i + 1;
                    if (i < argc) packagePath = Args.get(i);
                }
                i = i + 1;
            }
            if (Str.len(outPath) == 0) {
                outPath = Cli.stripExt(file) + ".out";
            }
            return Frontend.compile(file, outPath, stdlib, packagePath, emitLlvm, testMode, 0);
        }

        // 去最后一个 . 后缀（examples/hello.myp → examples/hello）。
        string stripExt(string path) {
            int dot = -1;
            for (int i = Str.len(path) - 1; i >= 0; i = i - 1) {
                if (__myp_charcode(path, i) == 46) { dot = i; break; }
            }
            if (dot >= 0) return Str.substring(path, 0, dot);
            return path;
        }

        void printHelp() {
            Console.writeLine("Usage: myp_self <file.myp> [options]");
            Console.writeLine("       myp_self --frontend-dump <tokens|ast|sema> <file.myp>");
            Console.writeLine("       myp_self run <file.myp> [args...]");
            Console.writeLine("       myp_self fmt [--check] <file.myp> ...");
            Console.writeLine("Options:");
            Console.writeLine("  -o <out>        Output executable path (default <file>.out)");
            Console.writeLine("  --emit-llvm     Save LLVM IR to <out>.ll and skip linking");
            Console.writeLine("  --stdlib <path> Stdlib directory");
            Console.writeLine("  --version       Show version");
            Console.writeLine("  --help, -h      Show this help");
        }
}

// CLI 分发（main() 只允许实例创建 + 顶层函数调用）
int selfMain() {
    return Cli.run();
}

int main() {
    int code = selfMain();
    return code;
}

