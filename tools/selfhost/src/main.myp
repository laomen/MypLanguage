// main.myp — myp_self CLI 驱动。入口 int selfMain()。
//
// myp_self 是全自举编译器（tools/selfhost，非 GPU）的命令行驱动。
// 各 mode 随里程碑推进：
//   F1 tokens ✅（本文件 + token/lexer/diag）
//   F2-F3 ast / F4 sema / G1+ compile / G4 run/fmt。
//
// 关联: tools/selfhost/design.md §3 D1、roadmap.md F1；
// 对拍: src/main.cpp（C++ mypc --frontend-dump），契约 format.md。

import env;
import args;
import io;
import fs;
import text;
import process;
import pool;
import "./diag.myp";
import "./token.myp";
import "./lexer.myp";
import "./ast.myp";
import "./parser.myp";
import "./sema.myp";
import "./codegen.myp";
import "./link.myp";

// 去重集合：参数 ArrayList 方法调用会崩溃 → 用内部用 ArrayList 的辅助类
// （其方法在类内调用 list，正常）。
class LoadedSet {
    action:
        @constructor LoadedSet() { set_ = new ArrayList<string>(); }
        void add(string s) { set_.add(s); }
        int has(string s) {
            for (int i = 0; i < set_.size(); i = i + 1) {
                if (set_.get(i) == s) return 1;
            }
            return 0;
        }
        ArrayList<string> set() { return set_; }
    property:
        ArrayList<string> set_;
}

// dump 输出辅助 + 前端模式实现。
@static class Frontend {
    static:
        // 读文件为字符串（字节级；调用前须用 Fs.exists 判存在）。
        string readFile(string path) {
            File f = new File();
            f.open(path, "r");
            string s = f.readAll();
            f.close();
            return s;
        }

        // 确定性转义（format.md §2）：\n \t \r \" \\ \0。
        // 注：MYP 串无法承载 NUL 字节，lexer 用 0x01 哨兵表示 \0，此处映射回 \0。
        string escape(string s) {
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < Str.len(s); i = i + 1) {
                int c = __myp_charcode(s, i);
                if (c == 10) sb.append("\\n");
                else if (c == 9) sb.append("\\t");
                else if (c == 13) sb.append("\\r");
                else if (c == 34) sb.append("\\\"");
                else if (c == 92) sb.append("\\\\");
                else if (c == 1) sb.append("\\0");  // 0x01 哨兵 → \0
                // 非转义字节原样透传（同 ast.myp Dump.esc）：MYP string 是字节串，
                // __myp_charcode 返回字节（如 0xE5），__myp_chr(0xE5) 会再 UTF-8
                // 编码成 2 字节 → 多字节中文双重编码（与 C++ escapeDumpString 不一致）。
                else sb.append(Str.substring(s, i, i + 1));
            }
            return sb.toString();
        }

        // 诊断排序比较（line, col, msg 升序，与 C++ 一致）。
        int diagLess(Diag a, Diag b) {
            if (a.line() != b.line()) { if (a.line() < b.line()) return 1; return 0; }
            if (a.col() != b.col()) { if (a.col() < b.col()) return 1; return 0; }
            int cm = Str.cmp(a.msg(), b.msg());
            if (cm != 0) { if (cm < 0) return 1; return 0; }
            return 0;
        }

        void printDiagnostics(DiagEngine diag) {
            Console.writeLine("(Diagnostics)");
            ArrayList<Diag> list = diag.get();
            int n = list.size();
            // 插入排序（稳定升序）。
            for (int i = 1; i < n; i = i + 1) {
                Diag key = list.get(i);
                int j = i - 1;
                while (j >= 0 && Frontend.diagLess(key, list.get(j)) == 1) {
                    list.set(j + 1, list.get(j));
                    j = j - 1;
                }
                list.set(j + 1, key);
            }
            for (int i = 0; i < n; i = i + 1) {
                Diag d = list.get(i);
                Console.writeLine("  (Diag line=" + d.line() + " col=" + d.col()
                    + " sev=" + d.sev() + " msg=\"" + Frontend.escape(d.msg()) + "\")");
            }
        }

        // F1：tokens 模式（对拍 mypc --frontend-dump tokens）。
        int tokens(string file) {
            if (Fs.exists(file) == 0) {
                Console.writeLine("Error: cannot open file '" + file + "'");
                return 1;
            }
            string src = Frontend.readFile(file);
            Lexer lx = new Lexer(src);
            ArrayList<Tok> toks = lx.tokenize();
            DiagEngine diag = lx.diags();

            Console.writeLine("MYP_FRONTEND_DUMP v1");
            Console.writeLine("(Mode tokens)");
            for (int i = 0; i < toks.size(); i = i + 1) {
                Tok t = toks.get(i);
                Console.writeLine("token " + t.begin() + ":" + t.end() + " " + t.kind()
                    + " \"" + Frontend.escape(t.value()) + "\"");
            }
            Frontend.printDiagnostics(diag);
            int ok2 = 1;
            if (diag.errorCount() != 0) ok2 = 0;
            Console.writeLine("(Result ok=" + ok2 + " errors=" + diag.errorCount() + ")");
            if (diag.errorCount() != 0) return 1;
            return 0;
        }

        // 诊断段追加到 StringBuilder（排序后）。
        void appendDiagnostics(StringBuilder sb, DiagEngine diag) {
            sb.append("(Diagnostics)\n");
            ArrayList<Diag> list = diag.get();
            int n = list.size();
            for (int i = 1; i < n; i = i + 1) {
                Diag key = list.get(i);
                int j = i - 1;
                while (j >= 0 && Frontend.diagLess(key, list.get(j)) == 1) {
                    list.set(j + 1, list.get(j));
                    j = j - 1;
                }
                list.set(j + 1, key);
            }
            for (int i = 0; i < n; i = i + 1) {
                Diag d = list.get(i);
                sb.append("  (Diag line=" + d.line() + " col=" + d.col()
                    + " sev=" + d.sev() + " msg=\"" + Frontend.escape(d.msg()) + "\")\n");
            }
        }

        // 点分模块名 → 目录层级：gpu.backend → gpu/backend。
        string dotToSlash(string name) {
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < Str.len(name); i = i + 1) {
                int c = __myp_charcode(name, i);
                if (c == 46) sb.append("/");
                else sb.append(Str.substring(name, i, i + 1));  // 字节透传
            }
            return sb.toString();
        }

        // stdlib 路径探测：MYP_STDLIB env → ./stdlib → ../stdlib →
        // 相对 myp_self 二进制位置（pm 工具从包目录调用 myp_self 时 cwd 不在地根）。
        string stdlibResolve() {
            string env = Console.getEnv("MYP_STDLIB");
            if (Str.len(env) != 0 && Fs.isDir(env) != 0) return env;
            if (Fs.exists("./stdlib/env.myp") != 0) return "./stdlib";
            if (Fs.exists("../stdlib/env.myp") != 0) return "../stdlib";
            return Cli.selfStdlib();
        }

        // 路径规范化：去掉 "./" 片段与空段，并折叠 ".."（对齐 C++ normalizePath，
        // BUG-024）。dedup key 用——否则同一文件经不同相对路径（直导 ./helper.myp +
        // 子模块内 ../helper.myp）会重复载入报 duplicate class name。
        // 注意：必须保留前导 '/'（绝对路径）——否则 /home/x 会退化成 home/x，
        // Fs.exists 找不到文件、loadModule 中断整个 import 链（绝对路径根文件必挂）。
        string normalizePath(string p) {
            int hasRoot = 0;
            if (Str.len(p) != 0 && __myp_charcode(p, 0) == 47) hasRoot = 1;
            ArrayList<string> parts = new ArrayList<string>();
            int start = 0;
            for (int i = 0; i <= Str.len(p); i = i + 1) {
                if (i == Str.len(p) || __myp_charcode(p, i) == 47) {
                    string seg = Str.substring(p, start, i);
                    if (Str.len(seg) != 0 && seg != ".") {
                        if (seg == "..") {
                            // .. 弹栈折叠：栈非空且末段非 .. → 弹；绝对根处 .. 丢弃；
                            // 相对路径前导 ..（栈空）保留。
                            if (parts.size() > 0 && parts.get(parts.size() - 1) != "..") {
                                parts.remove(parts.size() - 1);
                            } else if (hasRoot == 0) {
                                parts.add(seg);
                            }
                        } else {
                            parts.add(seg);
                        }
                    }
                    start = i + 1;
                }
            }
            StringBuilder sb = new StringBuilder();
            if (hasRoot != 0) sb.append("/");
            for (int i = 0; i < parts.size(); i = i + 1) {
                if (i != 0) sb.append("/");
                sb.append(parts.get(i));
            }
            return sb.toString();
        }

        // 递归加载 import 并合并（对齐 C++ loadModule：合并 7 类声明；imports/macros/typeAliases 不合并）。
        // packagePath：--package-path 冒号分隔的包搜索路径（myp_packages）。
        int loadModule(AstTU tu, AstImport imp, string sourceDir, string packagePath, LoadedSet loaded, DiagEngine diag) {
            string path = "";
            if (imp.isPath() != 0) {
                if (Str.len(imp.path()) != 0 && __myp_charcode(imp.path(), 0) == 47) {
                    path = imp.path();
                } else {
                    path = sourceDir + "/" + imp.path();
                }
            } else {
                string slash = Frontend.dotToSlash(imp.name());
                string stdlib = Frontend.stdlibResolve();
                string p1 = stdlib + "/" + slash + ".myp";
                string p2 = sourceDir + "/../stdlib/" + slash + ".myp";
                string p3 = sourceDir + "/stdlib/" + slash + ".myp";
                if (Fs.exists(p1) != 0) path = p1;
                else if (Fs.exists(p2) != 0) path = p2;
                else if (Fs.exists(p3) != 0) path = p3;
                else {
                    // 包搜索路径：<pkg>/<module>/src/<module>.myp 或
                    // <pkg>/<module>/<module>.myp（冒号分隔多路径）
                    int np = Str.splitCount(packagePath, ":");
                    for (int pi = 0; pi < np && Str.len(path) == 0; pi = pi + 1) {
                        string pp = Str.trim(Str.splitGet(packagePath, ":", pi));
                        if (Str.len(pp) == 0) continue;
                        string pkgSrc = pp + "/" + slash + "/src/" + imp.name() + ".myp";
                        string pkgRoot = pp + "/" + slash + "/" + imp.name() + ".myp";
                        if (Fs.exists(pkgSrc) != 0) path = pkgSrc;
                        else if (Fs.exists(pkgRoot) != 0) path = pkgRoot;
                        // 点分模块名（a.b.c）追加「首段=包名」解析：a.b.c →
                        // <pp>/a/src/b/c.myp 或 <pp>/a/b/c.myp（对齐 C++ loadModule
                        // 2026-08-20，支持 mypview.controls.app_icon 等）。向后兼容。
                        if (Str.len(path) == 0 && Str.len(imp.name()) > 0) {
                            int hasDot = 0;
                            int dot = 0;
                            for (int di = 0; di < Str.len(imp.name()); di = di + 1) {
                                if (__myp_charcode(imp.name(), di) == 46) {
                                    if (hasDot == 0) dot = di;
                                    hasDot = 1;
                                }
                            }
                            if (hasDot != 0) {
                                string pkgName = Str.substring(imp.name(), 0, dot);
                                string subSlash = Frontend.dotToSlash(Str.substring(imp.name(), dot + 1, Str.len(imp.name())));
                                string pkgSrc2 = pp + "/" + pkgName + "/src/" + subSlash + ".myp";
                                string pkgRoot2 = pp + "/" + pkgName + "/" + subSlash + ".myp";
                                if (Fs.exists(pkgSrc2) != 0) path = pkgSrc2;
                                else if (Fs.exists(pkgRoot2) != 0) path = pkgRoot2;
                            }
                        }
                    }
                    if (Str.len(path) == 0) path = p1;
                }
            }
            path = Frontend.normalizePath(path);
            string key = path;
            if (imp.isPath() == 0) key = imp.name();
            if (loaded.has(key) != 0) return 1;
            loaded.add(key);
            if (Fs.exists(path) == 0) {
                // 镜像 C++：路径 import 失败只打 stderr（stdout 不输出，也不加诊断）；
                // 名字 import 失败才加诊断。
                if (imp.isPath() == 0) {
                    diag.error(0, 0, "cannot find import '" + imp.name() + "'");
                }
                return 0;
            }
            string src = Frontend.readFile(path);
            // 模块 .myp.libs 侧车：纯 ffi 外部库链接标志（Go #cgo LDFLAGS 风格）。
            if (Fs.exists(path + ".libs") != 0) {
                Link.addLibsSidecar(Str.trim(Frontend.readFile(path + ".libs")));
            }
            Lexer lx = new Lexer(src);
            ArrayList<Tok> toks = lx.tokenize();
            DiagEngine subDiag = lx.diags();
            Parser pr = new Parser(toks, subDiag);
            AstTU sub = pr.parse();
            // 合并 7 类声明
            for (int i = 0; i < sub.classes().size(); i = i + 1) tu.classes().add(sub.classes().get(i));
            for (int i = 0; i < sub.interfaces().size(); i = i + 1) tu.interfaces().add(sub.interfaces().get(i));
            for (int i = 0; i < sub.mappings().size(); i = i + 1) tu.mappings().add(sub.mappings().get(i));
            for (int i = 0; i < sub.functions().size(); i = i + 1) tu.functions().add(sub.functions().get(i));
            for (int i = 0; i < sub.ffis().size(); i = i + 1) tu.ffis().add(sub.ffis().get(i));
            for (int i = 0; i < sub.enums().size(); i = i + 1) tu.enums().add(sub.enums().get(i));
            for (int i = 0; i < sub.structs().size(); i = i + 1) tu.structs().add(sub.structs().get(i));
            string subDir = Fs.dirname(path);
            for (int i = 0; i < sub.imports().size(); i = i + 1) {
                AstImport si = sub.imports().get(i);
                if (Frontend.loadModule(tu, si, subDir, packagePath, loaded, diag) == 0) return 0;
            }
            return 1;
        }

        // F2：ast 模式（对拍 mypc --frontend-dump ast，含 import 合并）。
        int ast(string file) {
            if (Fs.exists(file) == 0) {
                Console.writeLine("Error: cannot open file '" + file + "'");
                return 1;
            }
            string src = Frontend.readFile(file);
            Lexer lx = new Lexer(src);
            ArrayList<Tok> toks = lx.tokenize();
            DiagEngine diag = lx.diags();
            Parser pr = new Parser(toks, diag);
            AstTU tu = pr.parse();
            if (diag.errorCount() == 0) {
                LoadedSet loaded = new LoadedSet();
                string sourceDir = Fs.dirname(file);
                for (int i = 0; i < tu.imports().size(); i = i + 1) {
                    AstImport imp = tu.imports().get(i);
                    if (Frontend.loadModule(tu, imp, sourceDir, "", loaded, diag) == 0) break;
                }
            }
            StringBuilder sb = new StringBuilder();
            sb.append("MYP_FRONTEND_DUMP v1\n");
            sb.append("(Mode ast)\n");
            tu.dump(sb);
            Frontend.appendDiagnostics(sb, diag);
            int ok2 = 1;
            if (diag.errorCount() != 0) ok2 = 0;
            sb.append("(Result ok=" + ok2 + " errors=" + diag.errorCount() + ")\n");
            Console.writeString(sb.toString());
            if (diag.errorCount() != 0) return 1;
            return 0;
        }

        // F4：sema 模式（对拍 mypc --frontend-dump sema，含 import 合并 + 类型推断）。
        int sema(string file) {
            if (Fs.exists(file) == 0) {
                Console.writeLine("Error: cannot open file '" + file + "'");
                return 1;
            }
            string src = Frontend.readFile(file);
            Lexer lx = new Lexer(src);
            ArrayList<Tok> toks = lx.tokenize();
            DiagEngine diag = lx.diags();
            Parser pr = new Parser(toks, diag);
            AstTU tu = pr.parse();
            if (diag.errorCount() == 0) {
                LoadedSet loaded = new LoadedSet();
                string sourceDir = Fs.dirname(file);
                for (int i = 0; i < tu.imports().size(); i = i + 1) {
                    AstImport imp = tu.imports().get(i);
                    if (Frontend.loadModule(tu, imp, sourceDir, "", loaded, diag) == 0) break;
                }
            }
            // C++ Sema 构造 diag_.reset() 清除 parser/loadModule 的 diag
            diag.reset();
            Sema se = new Sema(diag);
            se.analyze(tu);
            StringBuilder sb = new StringBuilder();
            sb.append("MYP_FRONTEND_DUMP v1\n");
            sb.append("(Mode sema)\n");
            tu.dump(sb);
            Frontend.appendDiagnostics(sb, diag);
            int ok2 = 1;
            if (diag.errorCount() != 0) ok2 = 0;
            sb.append("(Result ok=" + ok2 + " errors=" + diag.errorCount() + ")\n");
            Console.writeString(sb.toString());
            if (diag.errorCount() != 0) return 1;
            return 0;
        }

        // @derive(X) 类级派生（v1：@derive(Json) → 注入 toJson/fromJson）。
        // 镜像 C++ expandDerives：构造合成源码 → 复用本编译器 lexer+parser →
        // 抽出生成的两个方法注入目标类。须在 sema 前调用。
        void deriveAll(AstTU tu, DiagEngine diag) {
            int n = tu.classes().size();
            for (int ci = 0; ci < n; ci = ci + 1) {
                AstClass cls = tu.classes().get(ci);
                if (Str.len(cls.derive()) == 0) continue;
                if (cls.derive() != "Json") {
                    diag.error(cls.line(), cls.col(), "unsupported derive macro '@derive(" + cls.derive() + ")' (supported: Json)");
                    cls.setDerive("");
                    continue;
                }
                if (cls.typeParams().size() > 0) {
                    diag.error(cls.line(), cls.col(), "@derive(Json) on generic classes is not yet supported (v1 supports non-generic classes)");
                    cls.setDerive("");
                    continue;
                }
                // 构造合成源码（与 C++ expandDerives 逐字节一致）。
                StringBuilder sb = new StringBuilder();
                sb.append("class __MYP_DERIVE_" + cls.name() + " {\n");
                sb.append("    action:\n");
                sb.append("        string toJson() {\n");
                sb.append("            string s = \"{\";\n");
                StringBuilder fromSb = new StringBuilder();
                int np = cls.props().size();
                int bad = 0;
                for (int pi = 0; pi < np; pi = pi + 1) {
                    AstProp p = cls.props().get(pi);
                    AstType pt = p.type();
                    string te = "";
                    string fs = "";
                    if (pt.element() != null || Str.len(pt.className()) != 0
                        || pt.isTuple() != 0 || pt.funcReturn() != null) {
                        diag.error(p.line(), p.col(), "property '" + p.name() + "' of class '" + cls.name() + "' has a type not supported by @derive(Json) (v1: int/long/double/float/bool/string)");
                        bad = 1;
                        break;
                    }
                    string bn = pt.basicName();
                    if (bn == "int" || bn == "long" || bn == "short" || bn == "byte"
                        || bn == "uint" || bn == "ulong" || bn == "ushort" || bn == "ubyte") {
                        te = "\"\\\"" + p.name() + "\\\":\" + " + p.name();
                        fs = p.name() + " = p.getInt(\"" + p.name() + "\");";
                    } else if (bn == "double" || bn == "float") {
                        te = "\"\\\"" + p.name() + "\\\":\" + " + p.name();
                        fs = p.name() + " = p.getDouble(\"" + p.name() + "\");";
                    } else if (bn == "bool") {
                        te = "\"\\\"" + p.name() + "\\\":\" + (" + p.name() + " ? \"true\" : \"false\")";
                        fs = p.name() + " = p.getBool(\"" + p.name() + "\") != 0;";
                    } else if (bn == "string") {
                        te = "\"\\\"" + p.name() + "\\\":\\\"\" + Json.escape(" + p.name() + ") + \"\\\"\"";
                        fs = p.name() + " = p.getString(\"" + p.name() + "\");";
                    } else {
                        diag.error(p.line(), p.col(), "property '" + p.name() + "' of class '" + cls.name() + "' has a type not supported by @derive(Json) (v1: int/long/double/float/bool/string)");
                        bad = 1;
                        break;
                    }
                    sb.append("            s = s + " + te);
                    if (pi + 1 < np) sb.append(" + \",\"");
                    sb.append(";\n");
                    fromSb.append("            " + fs + "\n");
                }
                if (bad != 0) { cls.setDerive(""); continue; }
                sb.append("            s = s + \"}\";\n");
                sb.append("            return s;\n");
                sb.append("        }\n");
                sb.append("        void fromJson(string j) {\n");
                sb.append("            Json p = new Json(j);\n");
                sb.append(fromSb.toString());
                sb.append("            p.free();\n");
                sb.append("        }\n");
                sb.append("}\n");
                // 重新 lex + parse 合成源码，抽出两个方法注入目标类。
                Lexer dlx = new Lexer(sb.toString());
                ArrayList<Tok> dtoks = dlx.tokenize();
                DiagEngine ddiag = dlx.diags();
                Parser dpr = new Parser(dtoks, ddiag);
                AstTU dtu = dpr.parse();
                if (ddiag.errorCount() != 0 || dtu.classes().size() == 0) {
                    diag.error(cls.line(), cls.col(), "@derive(Json) failed to generate methods for class '" + cls.name() + "' (internal error)");
                    cls.setDerive("");
                    continue;
                }
                AstClass dcls = dtu.classes().get(0);
                for (int di = 0; di < dcls.actions().size(); di = di + 1)
                    cls.actions().add(dcls.actions().get(di));
                cls.setDerive(""); // 已展开
            }
        }

        // G1：compile 模式——lexer→parser→import 合并→sema→codegen(.ll)→link。
        // 多文件（B5）：files[0] 为主文件，其余解析后全量合并进 TU（镜像 C++
        // multi-file：imports/structs/bitfields/classes/interfaces/mappings/
        // functions/enums/ffis/macros/typeAliases），再统一加载所有 imports。
        // emitLlvmOnly != 0 时只发射 .ll（跳过 link）。optLevel：默认 2=-O2（CLI
        // 未显式给 -O 时；opt 跨 setjmp/longjmp 的 finally 语义破坏根因已修——
        // codegen try 入口 myp_try_escape 逃逸，v3.12.44）；-O0/-O1/-O3 显式覆盖，
        // MYP_SELF_OPT=0 强制关闭（调试/对比）。
        int compile(ArrayList<string> files, string outPath, string stdlib, string packagePath, int emitLlvmOnly, int testMode, int autoMain, int optLevel, int libraryMode, int freestanding) {
            // MYP_COMPILE_TIMING=1：compile 阶段计时（P0 增量编译诊断；默认关闭不影响对拍）。
            int timing = 0;
            string tvs = Console.getEnv("MYP_COMPILE_TIMING");
            if (Str.len(tvs) != 0 && tvs == "1") timing = 1;
            long tc0 = 0, tcFront = 0, tcDerive = 0, tcSema = 0, tcCg = 0;
            if (timing != 0) tc0 = __myp_now_ms();
            string file = files.get(0);
            if (Fs.exists(file) == 0) {
                Console.writeLine("Error: cannot open file '" + file + "'");
                return 1;
            }
            string src = Frontend.readFile(file);
            // 主文件 .myp.libs 侧车：纯 ffi 外部库链接标志（Go #cgo LDFLAGS 风格）。
            // 编译任意调外部库（SDL/GL 等）的纯 ffi 程序时，模块旁放 foo.myp.libs 即可。
            if (Fs.exists(file + ".libs") != 0) {
                Link.addLibsSidecar(Str.trim(Frontend.readFile(file + ".libs")));
            }
            Lexer lx = new Lexer(src);
            ArrayList<Tok> toks = lx.tokenize();
            DiagEngine diag = lx.diags();
            Parser pr = new Parser(toks, diag);
            AstTU tu = pr.parse();
            if (diag.errorCount() == 0) {
                LoadedSet loaded = new LoadedSet();
                string sourceDir = Fs.dirname(file);
                // 命令行输入文件预置进 loaded（import 跳过，防重复加载/重复类名）。
                for (int fi = 0; fi < files.size(); fi = fi + 1) {
                    string fx = files.get(fi);
                    loaded.add(Frontend.normalizePath(fx));
                    loaded.add(fx);
                }
                // 附加输入文件：并行前端（lexer+parser 每文件独立）+ 顺序合并。
                // @parallel for 是 CPU 线程池 body（v3.13.2 起支持字符串/new/
                // 方法调用），可安全并行化前端；每线程写各自下标无竞争。
                AstTU[] subUnits = new AstTU[files.size()];
                int[] subOK = new int[files.size()];
                string[] subMsgs = new string[files.size()];
                int fileCount = files.size();
                @parallel for (int fi = 1; fi < fileCount; fi = fi + 1) {
                    string extra = files.get(fi);
                    if (Fs.exists(extra) == 0) {
                        subMsgs[fi] = "cannot open file '" + extra + "'";
                        continue;
                    }
                    string esrc = Frontend.readFile(extra);
                    Lexer elx = new Lexer(esrc);
                    ArrayList<Tok> etoks = elx.tokenize();
                    DiagEngine ediag = elx.diags();
                    Parser epr = new Parser(etoks, ediag);
                    AstTU esub = epr.parse();
                    if (ediag.errorCount() != 0) {
                        subMsgs[fi] = "errors in input file '" + extra + "'";
                        continue;
                    }
                    subUnits[fi] = esub;
                    subOK[fi] = 1;
                }
                // 顺序合并（保持输入顺序；跨文件引用需完整 TU）。
                for (int fi = 1; fi < files.size(); fi = fi + 1) {
                    if (subOK[fi] == 0) {
                        diag.error(0, 0, subMsgs[fi]);
                        break;
                    }
                    AstTU esub = subUnits[fi];
                    for (int i = 0; i < esub.imports().size(); i = i + 1) tu.imports().add(esub.imports().get(i));
                    for (int i = 0; i < esub.structs().size(); i = i + 1) tu.structs().add(esub.structs().get(i));
                    for (int i = 0; i < esub.bitfields().size(); i = i + 1) tu.bitfields().add(esub.bitfields().get(i));
                    for (int i = 0; i < esub.classes().size(); i = i + 1) tu.classes().add(esub.classes().get(i));
                    for (int i = 0; i < esub.interfaces().size(); i = i + 1) tu.interfaces().add(esub.interfaces().get(i));
                    for (int i = 0; i < esub.mappings().size(); i = i + 1) tu.mappings().add(esub.mappings().get(i));
                    for (int i = 0; i < esub.functions().size(); i = i + 1) tu.functions().add(esub.functions().get(i));
                    for (int i = 0; i < esub.enums().size(); i = i + 1) tu.enums().add(esub.enums().get(i));
                    for (int i = 0; i < esub.ffis().size(); i = i + 1) tu.ffis().add(esub.ffis().get(i));
                    for (int i = 0; i < esub.macros().size(); i = i + 1) tu.macros().add(esub.macros().get(i));
                    for (int i = 0; i < esub.typeAliases().size(); i = i + 1) tu.typeAliases().add(esub.typeAliases().get(i));
                }
                // 合并后统一加载所有 imports（主文件 + 附加文件，loaded 去重）。
                // 相对路径 import 以主文件目录解析（stdlib 名 import 与目录无关）。
                for (int i = 0; i < tu.imports().size(); i = i + 1) {
                    AstImport imp = tu.imports().get(i);
                    if (Frontend.loadModule(tu, imp, sourceDir, packagePath, loaded, diag) == 0) break;
                }
            }
            // 语法/import 错误必须短路——之前 diag.reset() 把 parser 诊断清掉，
            // missing_semicolon 等负例被静默放行。
            if (timing != 0) tcFront = __myp_now_ms();
            if (diag.errorCount() != 0) {
                Frontend.printDiagnostics(diag);
                return 1;
            }
            // @derive(X) 类级派生（@derive(Json) → 注入 toJson/fromJson；须在 sema 前）。
            Frontend.deriveAll(tu, diag);
            if (diag.errorCount() != 0) {
                Frontend.printDiagnostics(diag);
                return 1;
            }
            Sema se = new Sema(diag);
            se.setAutoMain(autoMain);
            if (timing != 0) tcDerive = __myp_now_ms();
            se.expandMacros(tu);
            se.analyze(tu);
            if (diag.errorCount() != 0) {
                Frontend.printDiagnostics(diag);
                return 1;
            }
            if (timing != 0) tcSema = __myp_now_ms();
            CodeGen cg = new CodeGen();
            cg.setTestMode(testMode);
            cg.setLibraryMode(libraryMode);
            cg.setFreestanding(freestanding);
            string ir = cg.generate(tu);
            if (timing != 0) tcCg = __myp_now_ms();
            // A4：打印编译期警告（C++ 镜像：@coro 过小栈等）
            ArrayList<string> warns = cg.warnings();
            for (int wi = 0; wi < warns.size(); wi = wi + 1) {
                Console.writeLine("warning: " + warns.get(wi));
            }
            string llPath = outPath + ".ll";
            File of = new File();
            of.open(llPath, "w");
            of.write(ir);
            of.close();
            if (emitLlvmOnly != 0) {
                Console.writeLine("LLVM IR saved: " + llPath);
                if (timing != 0) {
                    long tcEnd = __myp_now_ms();
                    Console.writeLine("COMPILE timing: frontend=" + (tcFront - tc0)
                        + "ms  derive=" + (tcDerive - tcFront)
                        + "ms  macro+sema=" + (tcSema - tcDerive)
                        + "ms  codegen=" + (tcCg - tcSema)
                        + "ms  write+link=" + (tcEnd - tcCg)
                        + "ms  total=" + (tcEnd - tc0) + "ms");
                }
                return 0;
            }
            int lrc = Link.link(llPath, outPath, stdlib, optLevel, libraryMode, freestanding);
            if (timing != 0) {
                long tcEnd = __myp_now_ms();
                Console.writeLine("COMPILE timing: frontend=" + (tcFront - tc0)
                    + "ms  derive=" + (tcDerive - tcFront)
                    + "ms  macro+sema=" + (tcSema - tcDerive)
                    + "ms  codegen=" + (tcCg - tcSema)
                    + "ms  write+link=" + (tcEnd - tcCg)
                    + "ms  total=" + (tcEnd - tc0) + "ms");
            }
            return lrc;
        }
}

@static class Cli {
    static:
        string selfStdlib() {
            string s = Console.getEnv("MYP_STDLIB");
            if (Str.len(s) > 0 && Fs.isDir(s) != 0) return s;
            // 相对 myp_self 二进制位置推断仓库 stdlib（Args.get(0) = 程序路径）
            if (Args.count() > 0) {
                string self = Args.get(0);
                string root = Fs.dirname(Fs.dirname(self));
                string cand = Fs.join(root, "stdlib");
                if (Fs.exists(Fs.join(cand, "env.myp")) != 0) return cand;
            }
            // 相对当前工作目录向上搜索（tools/codegen 等子目录里跑 run 子命令
            // 时二进制在 /tmp、仓库 stdlib 在 cwd 上方数层）。
            if (Fs.exists("../../stdlib/env.myp") != 0) return "../../stdlib";
            if (Fs.exists("../../../stdlib/env.myp") != 0) return "../../../stdlib";
            if (Fs.exists("../../../../stdlib/env.myp") != 0) return "../../../../stdlib";
            if (Fs.exists("./stdlib/env.myp") != 0) return "./stdlib";
            if (Fs.exists("../stdlib/env.myp") != 0) return "../stdlib";
            return "";
        }

        string quoteShell(string s) {
            StringBuilder sb = new StringBuilder();
            sb.append("\"");
            for (int i = 0; i < Str.len(s); i = i + 1) {
                string ch = Str.substring(s, i, i + 1);
                if (ch == "\"") sb.append("\\\"");
                else if (ch == "\\") sb.append("\\\\");
                else sb.append(ch);
            }
            sb.append("\"");
            return sb.toString();
        }

        // myp_self run <file.myp> [args...] —— 仿 go run：编译(autoMain) + 运行 + 清理（原生实现，不再委托 mypc）。
        int runFile() {
            string file = Args.get(2);
            string stdlib = Cli.selfStdlib();
            string base = "/tmp/myp_self_run_" + Process.getPid();
            ArrayList<string> files0 = new ArrayList<string>();
            files0.add(file);
            int rc = Frontend.compile(files0, base, stdlib, "", 0, 0, 1, 2, 0, 0);
            if (rc != 0) return rc;
            StringBuilder cmd = new StringBuilder();
            cmd.append(Cli.quoteShell(base));
            int i = 3;
            while (i < Args.count()) {
                cmd.append(" " + Cli.quoteShell(Args.get(i)));
                i = i + 1;
            }
            int erc = Process.run(cmd.toString());
            Fs.removeRecursive(base);
            Fs.removeRecursive(base + ".o");
            Fs.removeRecursive(base + ".ll");
            Fs.removeRecursive(base + ".opt.ll");
            return erc;
        }

        // myp_self fmt [--check] <file.myp> ... —— 调自举格式化器 myp_fmt2（tools/fmt/main.myp），不再委托 mypc。
        int fmt() {
            string fmtBin = Console.getEnv("MYP_FMT");
            if (Str.len(fmtBin) == 0) fmtBin = "./build/myp_fmt2";
            if (Fs.isFile(fmtBin) == 0) {
                fmtBin = "/tmp/myp_fmt2_self";
                if (Fs.isFile(fmtBin) == 0) {
                    string stdlib = Cli.selfStdlib();
                    ArrayList<string> files0b = new ArrayList<string>();
                    files0b.add("tools/fmt/main.myp");
                    int rc = Frontend.compile(files0b, fmtBin, stdlib, "", 0, 0, 0, 2, 0, 0);
                    if (rc != 0) {
                        Console.writeLine("myp_self fmt: 无法定位/编译自举格式化器（设 MYP_FMT 或提供 tools/fmt/main.myp）");
                        return rc;
                    }
                }
            }
            StringBuilder cmd = new StringBuilder();
            cmd.append(Cli.quoteShell(fmtBin));
            int i = 2;
            while (i < Args.count()) {
                cmd.append(" " + Cli.quoteShell(Args.get(i)));
                i = i + 1;
            }
            return Process.run(cmd.toString());
        }

        // myp_self --bootstrap —— 自举 2 级校验（类 gcc 自举命令）：
        // 当前编译器编译 tools/selfhost 源码 → stage1；stage1 再编译 → stage2；
        // 两者 MD5 一致（自举成立）→ 返回 0；不一致 → 返回 1（编译失败）。
        // ⚠️ stage 输出放 <repo>/build/（非 /tmp）：mypRtLib 首个候选是
        // <exe_dir>/libmyp_rt_myp.a——/tmp 下若有陈旧归档会先被拾取（缺符号，
        // 曾致 process 未定义）。
        int bootstrap() {
            string stdlib = Cli.selfStdlib();
            string src = "tools/selfhost/src/main.myp";
            if (Fs.exists(src) == 0) {
                Console.writeLine("myp_self --bootstrap: 找不到自举源码 '" + src + "'（须在仓库根运行）");
                return 1;
            }
            string s1 = "build/bootstrap_s1";
            string s2 = "build/bootstrap_s2";
            ArrayList<string> f1 = new ArrayList<string>();
            f1.add(src);
            int rc1 = Frontend.compile(f1, s1, stdlib, "", 0, 0, 0, 2, 0, 0);
            if (rc1 != 0) {
                Console.writeLine("myp_self --bootstrap: stage1 编译失败（rc=" + rc1 + "）");
                return rc1;
            }
            StringBuilder c2 = new StringBuilder();
            c2.append(Cli.quoteShell(s1));
            c2.append(" " + Cli.quoteShell(src));
            c2.append(" -o " + Cli.quoteShell(s2));
            c2.append(" --stdlib " + Cli.quoteShell(stdlib));
            int rc2 = Process.run(c2.toString());
            if (rc2 != 0) {
                Console.writeLine("myp_self --bootstrap: stage2 编译失败（rc=" + rc2 + "）");
                return rc2;
            }
            // 清理源码旁产物（Frontend.compile 会在源码旁生成 main.myp.o）
            Fs.removeRecursive("tools/selfhost/src/main.myp.o");
            // 注：MYP 字符串里 $1 会被当宏引用 → 用 cut（无 $）取 md5sum 首列。
            string h1 = Process.output("md5sum " + Cli.quoteShell(s1) + " | cut -d' ' -f1");
            string h2 = Process.output("md5sum " + Cli.quoteShell(s2) + " | cut -d' ' -f1");
            Console.writeLine("bootstrap stage1 md5=" + h1);
            Console.writeLine("bootstrap stage2 md5=" + h2);
            if (h1 != h2) {
                Console.writeLine("ERROR: 自举不动点 MD5 不一致——编译失败（stage1 != stage2）");
                return 1;
            }
            Console.writeLine("OK: 自举成立（2 级 MD5 一致）");
            Fs.removeRecursive(s1);
            Fs.removeRecursive(s2);
            Fs.removeRecursive(s1 + ".o");
            Fs.removeRecursive(s1 + ".ll");
            Fs.removeRecursive(s1 + ".opt.ll");
            Fs.removeRecursive(s2 + ".o");
            Fs.removeRecursive(s2 + ".ll");
            Fs.removeRecursive(s2 + ".opt.ll");
            return 0;
        }

        int run() {
            int argc = Args.count();
            if (argc < 2) {
                Cli.printHelp();
                return 1;
            }
            string arg = Args.get(1);
            if (arg == "--version") {
                Console.writeLine("MYP Self-Hosted Compiler v3.15.216");
                return 0;
            }
            if (arg == "--help" || arg == "-h") {
                Cli.printHelp();
                return 0;
            }
            if (arg == "run") {
                if (argc < 3) {
                    Console.writeLine("Usage: myp_self run <file.myp> [args...]");
                    return 1;
                }
                return Cli.runFile();
            }
            if (arg == "fmt") {
                return Cli.fmt();
            }
            if (arg == "--bootstrap") {
                return Cli.bootstrap();
            }
            if (arg == "--frontend-dump") {
                if (argc < 4) {
                    Console.writeLine("myp_self: --frontend-dump requires <mode> <file.myp>");
                    return 1;
                }
                string mode = Args.get(2);
                string file = Args.get(3);
                if (mode == "tokens") return Frontend.tokens(file);
                if (mode == "ast") return Frontend.ast(file);
                if (mode == "sema") return Frontend.sema(file);
                Console.writeLine("myp_self: unknown mode '" + mode + "'");
                return 1;
            }
            // 默认：compile 模式（G1）——myp_self [--test] <file1.myp> [file2.myp ...]
            // [-o out] [--emit-llvm] [--stdlib path] [--package-path path]
            ArrayList<string> files = new ArrayList<string>();
            string outPath = "";
            string stdlib = "";
            string packagePath = "";
            int emitLlvm = 0;
            int testMode = 0;
            int libMode = 0;
            int freestanding = 0;
            // 默认 -O2（v3.12.44 修复 setjmp/longjmp 根因后 -O2 安全；opt 步骤编译
            // 开销 +24%，换取生成程序 3-23x 运行提升）。-O0/-O1/-O3 显式覆盖；
            // MYP_SELF_OPT=0 强制关闭（调试/对比）。
            int optLevel = 2;
            int i = 1;
            if (arg == "--test") {
                testMode = 1;
                i = 2;
            }
            while (i < argc) {
                string a = Args.get(i);
                if (a == "-o") {
                    i = i + 1;
                    if (i < argc) outPath = Args.get(i);
                } else if (a == "--emit-llvm") {
                    emitLlvm = 1;
                } else if (a == "--shared") {
                    libMode = 1;
                } else if (a == "--freestanding") {
                    freestanding = 1;
                } else if (a == "--test") {
                    testMode = 1;
                } else if (a == "--stdlib") {
                    i = i + 1;
                    if (i < argc) stdlib = Args.get(i);
                } else if (a == "--package-path") {
                    i = i + 1;
                    if (i < argc) packagePath = Args.get(i);
                } else if (a == "-O0") {
                    optLevel = 0;
                } else if (a == "-O1") {
                    optLevel = 1;
                } else if (a == "-O2") {
                    optLevel = 2;
                } else if (a == "-O3") {
                    optLevel = 3;
                } else {
                    // 位置参数 → 输入文件（B5：多文件合并，镜像 C++ multi-file）
                    files.add(a);
                }
                i = i + 1;
            }
            if (files.size() == 0) { Cli.printHelp(); return 1; }
            if (Str.len(outPath) == 0) {
                if (files.size() == 1) outPath = Cli.stripExt(files.get(0)) + ".out";
                else outPath = "a.out";
            }
            // stdlib 未显式给 --stdlib 时回退 Cli.selfStdlib()（run 子命令同款），
            // 使 compile 从任意子目录（如 bench/）也能定位 stdlib/runtime。
            if (Str.len(stdlib) == 0) stdlib = Cli.selfStdlib();
            return Frontend.compile(files, outPath, stdlib, packagePath, emitLlvm, testMode, 0, optLevel, libMode, freestanding);
        }

        // 去最后一个 . 后缀（examples/hello.myp → examples/hello）。
        string stripExt(string path) {
            int dot = -1;
            for (int i = Str.len(path) - 1; i >= 0; i = i - 1) {
                if (__myp_charcode(path, i) == 46) { dot = i; break; }
            }
            if (dot >= 0) return Str.substring(path, 0, dot);
            return path;
        }

        void printHelp() {
            Console.writeLine("Usage: myp_self <file.myp> [options]");
            Console.writeLine("       myp_self --frontend-dump <tokens|ast|sema> <file.myp>");
            Console.writeLine("       myp_self run <file.myp> [args...]");
            Console.writeLine("       myp_self fmt [--check] <file.myp> ...");
            Console.writeLine("       myp_self --bootstrap    Self-host 2-level bootstrap check (MD5 gate)");
            Console.writeLine("Options:");
            Console.writeLine("  -o <out>        Output executable path (default <file>.out)");
            Console.writeLine("  --emit-llvm     Save LLVM IR to <out>.ll and skip linking");
            Console.writeLine("  --freestanding  Static no-libc ELF (no CRT/runtime/gcc)");
            Console.writeLine("  --stdlib <path> Stdlib directory");
            Console.writeLine("  --version       Show version");
            Console.writeLine("  --help, -h      Show this help");
        }
}

// CLI 分发（main() 只允许实例创建 + 顶层函数调用）
int selfMain() {
    long mt0 = __myp_now_ms();
    int code = Cli.run();
    long mt1 = __myp_now_ms();
    // MYP_COMPILE_TIMING 同门控：打印 selfMain 内部耗时（此后为进程退出清理）。
    string mtv = Console.getEnv("MYP_COMPILE_TIMING");
    if (Str.len(mtv) != 0 && mtv == "1") {
        Console.writeLine("MAIN: selfMain=" + (mt1 - mt0) + "ms (exit cleanup after)");
    }
    return code;
}

int main() {
    int code = selfMain();
    return code;
}

