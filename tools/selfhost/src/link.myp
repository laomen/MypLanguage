// link.myp — llc + gcc 链接 C runtime（G1 雏形；run/fmt 子命令留 G4）。
// 对拍基准: src/main.cpp linkObjects（design.md §3 D4/D5）。

import fs;
import process;
import env;
import io;          // File（读侧车文件）
import collections; // ArrayList

// .myp.libs 侧车累积器：MYP 模块声明额外链接库（纯 ffi 访问外部系统库，Go
// #cgo LDFLAGS 风格）。Frontend 加载 import 时读 <module>.myp.libs 累积，
// link() 追加到链接命令。
@static class LinkSidecar {
    property:
        string flags = "";
}

@static class Link {
    static:
        // 累积 .myp.libs 侧车标志（main.myp loadModule/compile 调用）
        void addLibsSidecar(string f) {
            string t = Str.trim(f);
            if (Str.len(t) == 0) return;
            if (Str.len(LinkSidecar.flags) > 0) LinkSidecar.flags = LinkSidecar.flags + " " + t;
            else LinkSidecar.flags = t;
        }
        // 通用工具探测（P0 去硬编码）：<envKey> 环境变量 → `command -v`（PATH 优
        // 先，含 <name>-<ver> 版本化命令）→ 版本绝对路径候选表 → 回退裸命令名。
        // versions 为按新到旧排列的 LLVM 主版本候选（数据驱动，跨机可扩展）。
        string probeTool(string name, string envKey, ArrayList<string> versions) {
            string e = Console.getEnv(envKey);
            if (Str.len(e) != 0) return e;
            string p0 = Str.trim(Process.output("command -v " + name + " 2>/dev/null"));
            if (Str.len(p0) != 0) return p0;
            for (int i = 0; i < versions.size(); i = i + 1) {
                string p = Str.trim(Process.output("command -v " + name + "-" + versions.get(i) + " 2>/dev/null"));
                if (Str.len(p) != 0) return p;
            }
            for (int i = 0; i < versions.size(); i = i + 1) {
                if (Fs.isFile("/usr/bin/" + name + "-" + versions.get(i)) != 0) return "/usr/bin/" + name + "-" + versions.get(i);
                if (Fs.isFile("/usr/lib/llvm-" + versions.get(i) + "/bin/" + name) != 0) return "/usr/lib/llvm-" + versions.get(i) + "/bin/" + name;
            }
            return name;
        }

        // 探测 llc / opt：版本候选表（新→旧；数据驱动，新增版本只改这里）。
        string findLlc() {
            ArrayList<string> v = new ArrayList<string>();
            v.add("21"); v.add("20"); v.add("19"); v.add("18");
            return Link.probeTool("llc", "MYP_LLC", v);
        }

        // 探测 opt（LLVM 中端优化器）：路径规则同 llc。MYP_OPT 环境变量优先。
        string findOpt() {
            ArrayList<string> v = new ArrayList<string>();
            v.add("21"); v.add("20"); v.add("19"); v.add("18");
            return Link.probeTool("opt", "MYP_OPT", v);
        }

        // 探测 host triple：opt 需要 `-mtriple` 才创建 TargetMachine 并注册
        // TargetIRAnalysis(TTI)——没有它 LoopVectorizer 无 cost model，所有循环
        // 保持标量（如 matmul ~2.5x 差距）。mypc 进程内管线正是给 PassBuilder
        // 传 TargetMachine 才向量化。优先 llvm-config --host-target（command -v
        // + 版本候选），回退 uname。MYP_LLVM_CONFIG 环境变量可显式指定。
        string findHostTriple() {
            ArrayList<string> v = new ArrayList<string>();
            v.add("21"); v.add("20"); v.add("19"); v.add("18");
            string cfg = Link.probeTool("llvm-config", "MYP_LLVM_CONFIG", v);
            string t0 = Str.trim(Process.output(cfg + " --host-target"));
            if (Str.len(t0) != 0) return t0;
            string m = Str.trim(Process.output("uname -m"));
            if (m == "x86_64") return "x86_64-pc-linux-gnu";
            if (m == "aarch64" || m == "arm64") return "aarch64-unknown-linux-gnu";
            return "";
        }

        // 定位 runtime.c：优先 cwd 的 src/runtime/runtime.c，否则 stdlib 父目录。
        string findRuntimeC(string stdlib) {
            if (Fs.isFile("src/runtime/runtime.c") != 0) return "src/runtime/runtime.c";
            string rtDir = Fs.dirname(stdlib);
            string cand = rtDir + "/src/runtime/runtime.c";
            if (Fs.isFile(cand) != 0) return cand;
            return "src/runtime/runtime.c";
        }

        // 定位 coro_ctx.S（x86-64 协程上下文切换汇编；平台相关，Win64 用
        // coro_ctx_win.S）。优先 cwd，其次 stdlib 父目录。
        string findCoroCtx(string stdlib) {
            string asmName = Link.ctxAsmName();
            if (Fs.isFile("src/runtime/" + asmName) != 0) return "src/runtime/" + asmName;
            string rtDir = Fs.dirname(stdlib);
            string cand = rtDir + "/src/runtime/" + asmName;
            if (Fs.isFile(cand) != 0) return cand;
            // 回退非平台名（老布局 / 单平台镜像）
            if (Fs.isFile("src/runtime/coro_ctx.S") != 0) return "src/runtime/coro_ctx.S";
            string cand2 = rtDir + "/src/runtime/coro_ctx.S";
            if (Fs.isFile(cand2) != 0) return cand2;
            return "";
        }

        // 定位 runtime_gpu.c（GPU/CUDA dlopen 胶水；任何 Linux 可编译，同 mypc
        // 始终链接以提供设备信息符号）。
        string findRuntimeGpu(string stdlib) {
            if (Fs.isFile("src/runtime/runtime_gpu.c") != 0) return "src/runtime/runtime_gpu.c";
            string rtDir = Fs.dirname(stdlib);
            string cand = rtDir + "/src/runtime/runtime_gpu.c";
            if (Fs.isFile(cand) != 0) return cand;
            return "";
        }

        // 定位 runtime_lib.c（cuBLAS 等厂商库 dlopen 钩子；任何 Linux 可编译）。
        string findRuntimeLib(string stdlib) {
            if (Fs.isFile("src/runtime/runtime_lib.c") != 0) return "src/runtime/runtime_lib.c";
            string rtDir = Fs.dirname(stdlib);
            string cand = rtDir + "/src/runtime/runtime_lib.c";
            if (Fs.isFile(cand) != 0) return cand;
            return "";
        }

        // 定位 include 目录（runtime.h）。
        string findIncDir(string stdlib) {
            if (Fs.isFile("include/mylang/runtime.h") != 0) return "include";
            string rtDir = Fs.dirname(stdlib);
            if (Fs.isFile(rtDir + "/include/mylang/runtime.h") != 0) return rtDir + "/include";
            return "include";
        }

        // ---- P2 集中 Toolchain 配置：单点维护 CC / 编译标志 / 链接库 ----
        // 消灭 5 处重复 gcc flags；$CC 环境变量优先（跨机交叉编译）。
        string findCc() {
            string e = Console.getEnv("CC");
            if (Str.len(e) != 0) return e;
            string c0 = Str.trim(Process.output("command -v cc 2>/dev/null"));
            if (Str.len(c0) != 0) return c0;
            string g0 = Str.trim(Process.output("command -v gcc 2>/dev/null"));
            if (Str.len(g0) != 0) return g0;
            return "gcc";
        }

        // 平台判定（P3 基础）：OS 环境变量（Windows → MinGW）或 uname -s。
        int isWindows() {
            string os = Console.getEnv("OS");
            if (Str.toUpper(os) == "WINDOWS_NT") return 1;
            string s = Str.trim(Process.output("uname -s 2>/dev/null"));
            if (Str.startsWith(s, "MINGW") != 0 || Str.startsWith(s, "MSYS") != 0) return 1;
            return 0;
        }

        // 基础编译标志（所有 runtime C 对象共用；-O 级别由调用点决定）。
        string baseCflags(string inc) {
            return " -I" + inc + " -fPIC -ffunction-sections -fdata-sections ";
        }

        // 平台链接库：Linux -lpthread -lm -ldl；Windows/MinGW ws2_32 + winmm。
        string ldLibs() {
            if (Link.isWindows() != 0) return " -lpthread -lws2_32 -lwinmm";
            return " -lpthread -lm -ldl";
        }

        // 协程上下文汇编：平台相关（SysV coro_ctx.S / Win64 coro_ctx_win.S）。
        string ctxAsmName() {
            if (Link.isWindows() != 0) return "coro_ctx_win.S";
            return "coro_ctx.S";
        }

        // ---- P1 缓存路径去硬编码：内容哈希（FNV-1a 64）+ 共享缓存目录 ----
        // 对齐 C++ cacheObj：runtime/ctx/gpu/lib/bridge 源码 + 标志 → 缓存对象，
        // 跨进程复用且无并发覆盖（同名 .o 只写一次，内容确定）。旧代码固定
        // /tmp/myp_self_*.o：并发 myp_self（make -j / xargs -P）互相覆盖。
        string fileContent(string path) {
            File f = new File();
            f.open(path, "r");
            string s = f.readAll();
            f.close();
            return s;
        }

        // 64 位无符号整数 → 16 位小写十六进制。
        string hexLong(long v) {
            StringBuilder sb = new StringBuilder();
            string ch = "0123456789abcdef";
            for (int i = 15; i >= 0; i = i - 1) {
                int digit = int((v >> (i * 4)) & 0xF);
                sb.append(Str.substring(ch, digit, digit + 1));
            }
            return sb.toString();
        }

        // FNV-1a 64 内容哈希 → 共享缓存对象路径（源码/标志任一变化即新对象）。
        string cacheObjPath(string srcPath, string extraFlags) {
            if (Fs.isFile(srcPath) == 0) return "";
            string content = Link.fileContent(srcPath);
            long h = 1469598103934665603;
            for (int i = 0; i < Str.len(content); i = i + 1) {
                h = (h ^ __myp_charcode(content, i)) * 1099511628211;
            }
            for (int i = 0; i < Str.len(extraFlags); i = i + 1) {
                h = (h ^ __myp_charcode(extraFlags, i)) * 1099511628211;
            }
            if (Fs.isDir("/tmp/myp_rt_cache") == 0) {
                Process.run("mkdir -p /tmp/myp_rt_cache");
            }
            return "/tmp/myp_rt_cache/myp_rt_" + Link.hexLong(h) + ".o";
        }

        // ---- 通用桥接发现（对拍 src/main.cpp linkObjects；新增桥无需改编译器）----
        // bridges 目录（MYP_BRIDGES 冒号分隔追加；默认 <stdlib>/bridges）下 *.c 即
        // 候选桥接。程序 obj 的 nm -u 未定义符号 × 桥 nm --defined-only 取交集命中
        // 即自动编译（mtime 缓存）+ 链接；固定点迭代处理依赖链（sdl_ttf → sdl）。
        // 侧车文件（可选）：<名>.c.cflags 编译标志、<名>.c.libs 链接库。
        ArrayList<string> bridgeDirs(string stdlib) {
            ArrayList<string> out = new ArrayList<string>();
            string e = Console.getEnv("MYP_BRIDGES");
            if (Str.len(e) > 0) {
                int c = Str.splitCount(e, ":");
                for (int i = 0; i < c; i = i + 1) {
                    string d = Str.trim(Str.splitGet(e, ":", i));
                    if (Str.len(d) > 0) out.add(d);
                }
            }
            out.add(stdlib + "/bridges");
            return out;
        }

        // 目录下所有 *.c 桥接文件（完整路径）
        ArrayList<string> listBridges(string dir) {
            ArrayList<string> out = new ArrayList<string>();
            if (Fs.isDir(dir) == 0) return out;
            int n = Fs.listCount(dir);
            string[] files = Fs.listDir(dir);
            for (int i = 0; i < n; i = i + 1) {
                string f = files[i];
                int fl = Str.len(f);
                if (fl > 2 && Str.substring(f, fl - 2, fl) == ".c")
                    out.add(Fs.join(dir, f));
            }
            return out;
        }

        // 目录下所有预编译库（.so / .a）——闭源分发：分发目录只有 <secret.so +
        // 封装 .myp>（无 .c 源码），用户 MYP_BRIDGES 指向库目录，按符号匹配直接
        // 链接（对齐 C++ listLibFiles）。
        ArrayList<string> listLibFiles(string dir) {
            ArrayList<string> out = new ArrayList<string>();
            if (Fs.isDir(dir) == 0) return out;
            int n = Fs.listCount(dir);
            string[] files = Fs.listDir(dir);
            for (int i = 0; i < n; i = i + 1) {
                string f = files[i];
                int fl = Str.len(f);
                if ((fl > 3 && Str.substring(f, fl - 3, fl) == ".so")
                    || (fl > 2 && Str.substring(f, fl - 2, fl) == ".a"))
                    out.add(Fs.join(dir, f));
            }
            return out;
        }

        // 单遍行切分：一次扫描 s 按 '\n' 分段，只留非空段。
        // 不用 splitGet 逐行 —— splitGet 每次从串头 strstr 数到 index（O(len)），
        // 循环 N 行 = O(N²)（同 codegen 的 preamble 修复）。
        ArrayList<string> splitLines(string s) {
            ArrayList<string> out = new ArrayList<string>();
            int n = Str.len(s);
            int start = 0;
            int i = 0;
            while (i <= n) {
                if (i == n || __myp_charcode(s, i) == 10) {  // '\n'
                    if (i > start) out.add(Str.substring(s, start, i));
                    start = i + 1;
                }
                i = i + 1;
            }
            return out;
        }

        // nm 输出 → 符号集合（defined=1 → --defined-only；0 → -u 未定义）。
        // 每行末列 = 符号名（地址/类型列用空白分隔）。
        ArrayList<string> nmSymbols(string files, int defined) {
            ArrayList<string> out = new ArrayList<string>();
            string cmd = "nm " + ((defined != 0) ? "--defined-only " : "-u ") + files + " 2>/dev/null";
            string outp = Process.output(cmd);
            ArrayList<string> lines = Link.splitLines(outp);
            int c = lines.size();
            for (int i = 0; i < c; i = i + 1) {
                string line = Str.trim(lines.get(i));
                if (Str.len(line) == 0) continue;
                int nw = Str.splitCount(line, " ");
                string name = Str.trim(Str.splitGet(line, " ", nw - 1));
                if (Str.len(name) == 0 || name == "C") continue;
                if (Str.substring(name, 0, 1) == "*") continue;
                out.add(name);
            }
            return out;
        }

        // 动态符号表（.so 用）：导出的全局符号可能只在 .dynsym，普通 nm 读不到
        // （尤其 strip 过的共享库）。.a 无动态表，仍用 nmSymbols（对齐 C++
        // nmDynSymbols）。
        ArrayList<string> nmDynSymbols(string files, int defined) {
            ArrayList<string> out = new ArrayList<string>();
            string cmd = "nm -D " + ((defined != 0) ? "--defined-only " : "-u ") + files + " 2>/dev/null";
            string outp = Process.output(cmd);
            ArrayList<string> lines = Link.splitLines(outp);
            int c = lines.size();
            for (int i = 0; i < c; i = i + 1) {
                string line = Str.trim(lines.get(i));
                if (Str.len(line) == 0) continue;
                int nw = Str.splitCount(line, " ");
                string name = Str.trim(Str.splitGet(line, " ", nw - 1));
                if (Str.len(name) == 0 || name == "C") continue;
                if (Str.substring(name, 0, 1) == "*") continue;
                out.add(name);
            }
            return out;
        }

        // 读取侧车文件（去尾部空白）；不存在返回空串
        string readSidecar(string path) {
            if (Fs.isFile(path) == 0) return "";
            File f = new File();
            f.open(path, "r");
            string s = f.readAll();
            f.close();
            return Str.trim(s);
        }

        // 桥接缓存对象路径（内容哈希缓存，对齐 C++ cacheObj）。
        string bridgeObjPath(string c, string bflags) {
            return Link.cacheObjPath(c, "b" + bflags);
        }

        // 编译桥接（内容哈希缓存：源码/标志未变则复用，跨进程共享安全）；
        // 失败返回空串。
        string compileBridge(string c, string inc, string bflags) {
            string bObj = Link.bridgeObjPath(c, bflags);
            if (Str.len(bObj) == 0) return "";
            int need = 1;
            if (Fs.isFile(bObj) != 0 && Fs.isFile(c) != 0) {
                if (Fs.modifiedTime(bObj) >= Fs.modifiedTime(c)) need = 0;
            }
            if (need != 0) {
                string cmd = Link.findCc() + Link.baseCflags(inc) + " -O2 " + bflags + " -c " + c + " -o " + bObj + " 2>&1";
                if (Process.run(cmd) != 0) return "";
            }
            return bObj;
        }

        // b 是否有任一符号在 a 中
        int symContains(ArrayList<string> a, string s) {
            for (int i = 0; i < a.size(); i = i + 1)
                if (a.get(i) == s) return 1;
            return 0;
        }
        int symIntersect(ArrayList<string> a, ArrayList<string> b) {
            for (int i = 0; i < b.size(); i = i + 1)
                if (Link.symContains(a, b.get(i)) != 0) return 1;
            return 0;
        }

        // 探测链接器（--freestanding）：MYP_LD 环境变量优先，其次 ld.lld → ld。
        string findLd() {
            string e = Console.getEnv("MYP_LD");
            if (Str.len(e) != 0) return e;
            string l0 = Str.trim(Process.output("command -v ld.lld 2>/dev/null"));
            if (Str.len(l0) != 0) return l0;
            return "ld";
        }

        // ---- 档A：ld.lld 链接（去 gcc 的链接职责，保留 libc）----
        // 定位链接器：MYP_LD → ld.lld-21/20/19/ld.lld/lld → ld → ""（未找到）。
        string findLld() {
            string e = Console.getEnv("MYP_LD");
            if (Str.len(e) != 0) return e;
            ArrayList<string> v = new ArrayList<string>();
            v.add("ld.lld-21"); v.add("ld.lld-20"); v.add("ld.lld-19");
            v.add("ld.lld"); v.add("lld"); v.add("ld");
            for (int i = 0; i < v.size(); i = i + 1) {
                string p = Str.trim(Process.output("command -v " + v.get(i) + " 2>/dev/null"));
                if (Str.len(p) != 0) return p;
                if (Fs.isFile("/usr/bin/" + v.get(i)) != 0) return "/usr/bin/" + v.get(i);
            }
            return "";
        }

        // CRT 启动文件目录（含 crt1.o）。
        string crtDir() {
            ArrayList<string> v = new ArrayList<string>();
            v.add("/usr/lib/x86_64-linux-gnu"); v.add("/usr/lib64");
            v.add("/usr/lib/aarch64-linux-gnu"); v.add("/usr/lib/arm-linux-gnueabihf");
            v.add("/lib/x86_64-linux-gnu"); v.add("/lib64"); v.add("/usr/lib");
            for (int i = 0; i < v.size(); i = i + 1)
                if (Fs.isFile(v.get(i) + "/crt1.o") != 0) return v.get(i);
            return "";
        }

        // 动态加载器路径（x86-64 / aarch64 常见布局）。
        string dynLinker() {
            ArrayList<string> v = new ArrayList<string>();
            v.add("/lib64/ld-linux-x86-64.so.2"); v.add("/lib/ld-linux-aarch64.so.1");
            v.add("/lib/ld-linux-x86-64.so.2"); v.add("/lib64/ld-linux-x86-64.so.1");
            for (int i = 0; i < v.size(); i = i + 1)
                if (Fs.isFile(v.get(i)) != 0) return v.get(i);
            return "/lib64/ld-linux-x86-64.so.2";
        }

        // 档A 收尾：定位预编译核心 runtime 归档（libmyp_rt.a，随编译器分发）。
        // MYP_RT_LIB 显式覆盖；默认取编译器二进制旁（Args.get(0) 目录 → build/）。
        // 找不到返回 ""（回退 gcc 编译缓存）。
        string prebuiltRt() {
            string e = Console.getEnv("MYP_RT_LIB");
            if (Str.len(e) > 0 && Fs.isFile(e) != 0) return e;
            ArrayList<string> cands = new ArrayList<string>();
            if (Args.count() > 0) {
                cands.add(Fs.join(Fs.dirname(Args.get(0)), "libmyp_rt.a"));
            }
            cands.add("build/libmyp_rt.a");
            cands.add("./build/libmyp_rt.a");
            cands.add("libmyp_rt.a");
            for (int i = 0; i < cands.size(); i = i + 1) {
                if (Fs.isFile(cands.get(i)) != 0) return cands.get(i);
            }
            return "";
        }

        // 预编译 MYP 运行时归档（libmyp_rt_myp.a，随编译器分发，de-gcc 关键）。
        // 含 runtime_myp/*.myp 的 --shared 对象（base64/date/hash/json/regex 等
        // bridge 的 MYP 版 + 全部 runtime 层）。MYP_RT_MYP 显式覆盖；默认取编译
        // 器二进制旁。找到时：① 跳过对应 C bridge 编译（gcc 职责减），② 链接时
        // 置于 libmyp_rt.a 之前 + --allow-multiple-definition → MYP 定义优先。
        // 找不到返回 ""（回退 C bridge 编译，行为不变）。
        string mypRtLib() {
            string e = Console.getEnv("MYP_RT_MYP");
            if (Str.len(e) > 0 && Fs.isFile(e) != 0) return e;
            ArrayList<string> cands = new ArrayList<string>();
            if (Args.count() > 0) {
                cands.add(Fs.join(Fs.dirname(Args.get(0)), "libmyp_rt_myp.a"));
            }
            cands.add("build/libmyp_rt_myp.a");
            cands.add("./build/libmyp_rt_myp.a");
            cands.add("libmyp_rt_myp.a");
            for (int i = 0; i < cands.size(); i = i + 1) {
                if (Fs.isFile(cands.get(i)) != 0) return cands.get(i);
            }
            return "";
        }

        // bridge .c 是否已被 runtime_myp MYP 化（编译器可跳过其 C 编译）。
        // 与 runtime_myp/*.myp 同步维护：base64/date/hash/json/regex/process/uds。
        int mypifiedBridge(string c) {
            int sl = Str.len(c);
            string b = c;
            for (int i = sl - 1; i >= 0; i = i - 1) {
                if (__myp_charcode(c, i) == 47) { b = Str.substring(c, i + 1, sl); break; }   // '/'
            }
            if (b == "base64_bridge.c") return 1;
            if (b == "date_bridge.c") return 1;
            if (b == "hash_bridge.c") return 1;
            if (b == "json_bridge.c") return 1;
            if (b == "regex_bridge.c") return 1;
            if (b == "process_bridge.c") return 1;
            if (b == "uds_bridge.c") return 1;
            return 0;
        }

        // llPath(.ll) → [opt -O<level>] → llc → obj → gcc 链接 runtime → outPath 可执行。
        // 默认 **-O2**（CLI 默认 optLevel=2；v3.12.44 修复 opt -O2 跨 setjmp/longjmp
        // 的 finally 语义破坏根因——codegen 在 try 入口把全部在作用域局部 + finally
        // flag 的地址传给 myp_try_escape 无操作，使其成为逃逸内存，mem2reg/SROA 不
        // 提升、DSE 不删 store，-O2 下 arc_throw 15/15、全量 310/0）。optLevel>0 时
        // 跑 opt -O<level>；MYP_SELF_OPT=1 强制开启、=0 强制关闭（调试/对比）。
        int link(string llPath, string outPath, string stdlib, int optLevel, int shared, int freestanding) {
            string srcLl = llPath;
            string optEnv = Console.getEnv("MYP_SELF_OPT");
            int doOpt = (optLevel > 0) ? 1 : 0;
            if (optEnv == "1") doOpt = 1;
            else if (optEnv == "0") doOpt = 0;
            if (doOpt != 0) {
                string opt = Link.findOpt();
                string optPath = outPath + ".opt.ll";
                string mt = Link.findHostTriple();
                string optCmd = opt + " " + llPath + " -O" + optLevel;
                if (Str.len(mt) > 0) optCmd = optCmd + " -mtriple=" + mt;
                optCmd = optCmd + " -o " + optPath + " 2>&1";
                if (Process.run(optCmd) != 0) {
                    Console.writeLine("opt failed");
                    return 1;
                }
                srcLl = optPath;
            }
            string llc = Link.findLlc();
            string objPath = outPath + ".o";
            // --freestanding：静态重定位模型（匹配无 PIE 的裸静态链接）；常规 PIC。
            string reloc = (freestanding != 0) ? "-relocation-model=static" : "-relocation-model=pic";
            string cmd = llc + " " + srcLl + " -filetype=obj " + reloc + " -o " + objPath + " 2>&1";
            if (Process.run(cmd) != 0) {
                Console.writeLine("llc failed");
                return 1;
            }
            // --freestanding（档B）：无 CRT / runtime.c / libc / gcc —— codegen 已
            // 发射 _start（call main → exit syscall），这里直接静态链接。
            if (freestanding != 0) {
                string ld = Link.findLd();
                string lcmd = ld + " -nostdlib -static -e _start -o " + outPath + " " + objPath + " 2>&1";
                if (Process.run(lcmd) != 0) {
                    Console.writeLine("freestanding link failed");
                    return 1;
                }
                Console.writeLine("Link OK: " + outPath);
                return 0;
            }
            // 档A 收尾：预编译核心 runtime 归档（libmyp_rt.a，随编译器分发）。
            // 找到时直接链接（免 C 编译器——gcc 只剩 bridge 的 C 编译职责）。
            string prebuiltRt = Link.prebuiltRt();
            // 预编译 MYP 运行时归档（可选）：找到时跳过 MYP 化 bridge 的 C 编译。
            string mypRt = Link.mypRtLib();
            string inc = Link.findIncDir(stdlib);
            string runtimeC = Link.findRuntimeC(stdlib);
            // runtime.c 约 6000 行，gcc -O2 每次编译 ~0.9s，占单文件编译总耗时
            // 90%+。内容哈希缓存（FNV-1a 源码+标志）：未变则复用，跨进程共享安全。
            string rtObj = "";
            if (Str.len(prebuiltRt) == 0) {
                rtObj = Link.cacheObjPath(runtimeC, "-O2");
                int needRt = 1;
                if (Str.len(rtObj) != 0 && Fs.isFile(rtObj) != 0 && Fs.isFile(runtimeC) != 0) {
                    if (Fs.modifiedTime(rtObj) >= Fs.modifiedTime(runtimeC)) needRt = 0;
                }
                if (needRt != 0) {
                    cmd = Link.findCc() + Link.baseCflags(inc) + " -O2 -c " + runtimeC + " -o " + rtObj + " 2>&1";
                    if (Process.run(cmd) != 0) {
                        Console.writeLine("runtime compile failed");
                        return 1;
                    }
                }
            }
            string ctxAsm = Link.findCoroCtx(stdlib);
            string ctxObj = "";
            if (Str.len(ctxAsm) != 0 && Str.len(prebuiltRt) == 0) {
                // coro_ctx.S 小文件，同样内容哈希缓存复用。
                ctxObj = Link.cacheObjPath(ctxAsm, "-O2");
                int needCtx = 1;
                if (Str.len(ctxObj) != 0 && Fs.isFile(ctxObj) != 0 && Fs.isFile(ctxAsm) != 0) {
                    if (Fs.modifiedTime(ctxObj) >= Fs.modifiedTime(ctxAsm)) needCtx = 0;
                }
                if (needCtx != 0) {
                    cmd = Link.findCc() + " -c " + ctxAsm + " -o " + ctxObj + " 2>&1";
                    if (Process.run(cmd) != 0) {
                        Console.writeLine("coro_ctx compile failed");
                        return 1;
                    }
                }
            }
            // runtime_gpu.c（dlopen 胶水）：始终链接（同 mypc），否则 gpu/cuda
            // 内建（myp_gpu_init/myp_cuda_*）链接时报 undefined reference。
            string gpuC = Link.findRuntimeGpu(stdlib);
            string gpuObj = "";
            string gpuLinkObj = "";
            if (Str.len(gpuC) != 0 && Str.len(prebuiltRt) == 0) {
                gpuObj = Link.cacheObjPath(gpuC, "-O2");
                int needGpu = 1;
                if (Str.len(gpuObj) != 0 && Fs.isFile(gpuObj) != 0 && Fs.isFile(gpuC) != 0) {
                    if (Fs.modifiedTime(gpuObj) >= Fs.modifiedTime(gpuC)) needGpu = 0;
                }
                if (needGpu != 0) {
                    cmd = Link.findCc() + Link.baseCflags(inc) + " -O2 -c " + gpuC + " -o " + gpuObj + " 2>&1";
                    if (Process.run(cmd) != 0) {
                        Console.writeLine("gpu runtime compile failed");
                        return 1;
                    }
                }
                gpuLinkObj = " " + gpuObj;
            }
            // runtime_lib.c（cuBLAS 等厂商库钩子）：始终链接（同 mypc）。
            string libC = Link.findRuntimeLib(stdlib);
            string libObj = "";
            string libLinkObj = "";
            if (Str.len(libC) != 0 && Str.len(prebuiltRt) == 0) {
                libObj = Link.cacheObjPath(libC, "-O2");
                int needLib = 1;
                if (Str.len(libObj) != 0 && Fs.isFile(libObj) != 0 && Fs.isFile(libC) != 0) {
                    if (Fs.modifiedTime(libObj) >= Fs.modifiedTime(libC)) needLib = 0;
                }
                if (needLib != 0) {
                    cmd = Link.findCc() + Link.baseCflags(inc) + " -O2 -c " + libC + " -o " + libObj + " 2>&1";
                    if (Process.run(cmd) != 0) {
                        Console.writeLine("vendor-lib runtime compile failed");
                        return 1;
                    }
                }
                libLinkObj = " " + libObj;
            }
            // ---- 通用桥接发现（对拍 mypc；新增桥无需改自举编译器）----
            ArrayList<string> bdirs = Link.bridgeDirs(stdlib);
            ArrayList<string> allB = new ArrayList<string>();
            for (int bi = 0; bi < bdirs.size(); bi = bi + 1) {
                ArrayList<string> cs = Link.listBridges(bdirs.get(bi));
                for (int ci = 0; ci < cs.size(); ci = ci + 1) allB.add(cs.get(ci));
            }
            // 预编译库（.so/.a，闭源分发）候选
            ArrayList<string> allLibs = new ArrayList<string>();
            for (int bi = 0; bi < bdirs.size(); bi = bi + 1) {
                ArrayList<string> ls = Link.listLibFiles(bdirs.get(bi));
                for (int li = 0; li < ls.size(); li = li + 1) allLibs.add(ls.get(li));
            }
            string bridgeObjList = "";
            string bridgeLibs = "";
            ArrayList<string> undef = Link.nmSymbols(objPath, 0);
            ArrayList<string> sel = new ArrayList<string>();
            int changed = 1;
            int guard = 0;
            while (changed != 0 && guard < 128) {
                changed = 0;
                guard = guard + 1;
                for (int i = 0; i < allB.size(); i = i + 1) {
                    string c = allB.get(i);
                    if (Link.symContains(sel, c) != 0) continue;
                    // MYP 运行时归档提供该 bridge 的全部符号 → 跳过 C 编译
                    // （de-gcc：这些 bridge 不再用 gcc 现编译）。
                    if (Str.len(mypRt) != 0 && Link.mypifiedBridge(c) != 0) continue;
                    string bflags = Link.readSidecar(c + ".cflags");
                    string blibs = Link.readSidecar(c + ".libs");
                    string bObj = Link.compileBridge(c, inc, bflags);
                    if (Str.len(bObj) == 0) continue;
                    if (Link.symIntersect(undef, Link.nmSymbols(bObj, 1)) != 0) {
                        sel.add(c);
                        bridgeObjList = bridgeObjList + " " + bObj;
                        if (Str.len(blibs) > 0) bridgeLibs = bridgeLibs + " " + blibs;
                        ArrayList<string> u = Link.nmSymbols(bObj, 0);
                        for (int ui = 0; ui < u.size(); ui = ui + 1) undef.add(u.get(ui));
                        changed = 1;
                    }
                }
            }
            // 预编译库（.so/.a）同款固定点：按符号匹配直接链接，无需 .c 源码——
            // 闭源分发路径（分发 <secret.so + 封装 .myp>，用户 MYP_BRIDGES 指向
            // 库目录）。.so 用动态符号表（nm -D），.a 用普通 nm（对齐 C++）。
            ArrayList<string> selLibs = new ArrayList<string>();
            changed = 1;
            guard = 0;
            while (changed != 0 && guard < 128) {
                changed = 0;
                guard = guard + 1;
                for (int i = 0; i < allLibs.size(); i = i + 1) {
                    string l = allLibs.get(i);
                    if (Link.symContains(selLibs, l) != 0) continue;
                    int isSo = 0;
                    int ll = Str.len(l);
                    if (ll > 3 && Str.substring(l, ll - 3, ll) == ".so") isSo = 1;
                    ArrayList<string> defSyms = (isSo != 0) ? Link.nmDynSymbols(l, 1) : Link.nmSymbols(l, 1);
                    if (Link.symIntersect(undef, defSyms) == 0) continue;
                    selLibs.add(l);
                    bridgeObjList = bridgeObjList + " " + l;
                    string blibs = Link.readSidecar(l + ".libs");
                    if (Str.len(blibs) > 0) bridgeLibs = bridgeLibs + " " + blibs;
                    ArrayList<string> uu = (isSo != 0) ? Link.nmDynSymbols(l, 0) : Link.nmSymbols(l, 0);
                    for (int ui = 0; ui < uu.size(); ui = ui + 1) undef.add(uu.get(ui));
                    changed = 1;
                }
            }
            // .myp.libs 侧车（纯 ffi 外部库，Go #cgo LDFLAGS 风格）：追加 -l 标志。
            if (Str.len(LinkSidecar.flags) > 0) bridgeLibs = bridgeLibs + " " + LinkSidecar.flags;
            string cc = Link.findCc();
            string libs = Link.ldLibs();
            // runtime 对象列表：预编译归档优先（免 C 编译），否则单个对象。
            string runtimeObjs = (Str.len(prebuiltRt) > 0)
                ? " " + prebuiltRt
                : " " + rtObj + " " + ctxObj + gpuLinkObj + libLinkObj;
            // 档A：非 shared 默认 ld.lld 链接（去 gcc 的链接职责，保留 libc）；
            // MYP_LINKER=gcc 或未找到 lld 时回退 gcc。
            int useLld = 0;
            if (shared == 0 && Console.getEnv("MYP_LINKER") != "gcc") {
                if (Str.len(Link.findLld()) != 0) useLld = 1;
            }
            if (useLld != 0) {
                string ld = Link.findLld();
                string crt = Link.crtDir();
                string dynl = Link.dynLinker();
                // PIE 动态可执行（对齐 gcc Ubuntu 默认）：Scrt1.o + -pie；否则
                // crt1.o 无 -pie。libgcc 已去除（MYP 生成代码无 libgcc 符号依赖），
                // 仅保留 glibc（-lc -lm -lpthread -ldl）。crtn.o 收尾。
                int pie = (Fs.isFile(crt + "/Scrt1.o") != 0) ? 1 : 0;
                string start = (pie != 0) ? crt + "/Scrt1.o" : crt + "/crt1.o";
                string pieFlag = (pie != 0) ? "-pie " : "";
                // MYP 运行时归档：置于 libmyp_rt.a 之前 + --allow-multiple-definition
                // → MYP 定义优先（shadow 机制），提供被跳过的 MYP 化 bridge 符号。
                string mypRtObj = (Str.len(mypRt) > 0) ? " " + mypRt : "";
                string amd = (Str.len(mypRt) > 0) ? " --allow-multiple-definition" : "";
                cmd = ld + " " + pieFlag + "--dynamic-linker " + dynl + " -o " + outPath
                    + " " + start + " " + crt + "/crti.o"
                    + " " + objPath + mypRtObj + runtimeObjs
                    + bridgeObjList
                    + " -L" + crt
                    + " -lc -lm -lpthread -ldl"
                    + " " + bridgeLibs + " " + crt + "/crtn.o"
                    + " --gc-sections" + amd + " 2>&1";
            } else if (shared != 0) {
                cmd = cc + " -shared -fPIC " + objPath + " " + rtObj + " " + ctxObj + gpuLinkObj + libLinkObj
                    + bridgeObjList + " -o " + outPath + libs + bridgeLibs
                    + " -Wl,--gc-sections 2>&1";
            } else {
                cmd = cc + " " + objPath + " " + rtObj + " " + ctxObj + gpuLinkObj + libLinkObj
                    + bridgeObjList + " -o " + outPath + libs + bridgeLibs
                    + " -Wl,--gc-sections 2>&1";
            }
            if (Process.run(cmd) != 0) {
                Console.writeLine("link failed");
                return 1;
            }
            Console.writeLine("Link OK: " + outPath);
            return 0;
        }
}
