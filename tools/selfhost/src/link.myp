// link.myp — llc + gcc 链接 C runtime（G1 雏形；run/fmt 子命令留 G4）。
// 对拍基准: src/main.cpp linkObjects（design.md §3 D4/D5）。

import fs;
import process;
import env;
import io;          // File（读侧车文件）
import collections; // ArrayList

@static class Link {
    static:
        // 探测 llc：本机 llc 不在 PATH（llc-21 / /usr/lib/llvm-21/bin/llc）。
        // MYP_LLC 环境变量显式指定路径/命令 → 优先（跨机器 / 任意 LLVM 版本）。
        string findLlc() {
            string e = Console.getEnv("MYP_LLC");
            if (Str.len(e) != 0) return e;
            if (Fs.isFile("/usr/bin/llc-21") != 0) return "/usr/bin/llc-21";
            if (Fs.isFile("/usr/lib/llvm-21/bin/llc") != 0) return "/usr/lib/llvm-21/bin/llc";
            if (Fs.isFile("/usr/bin/llc-20") != 0) return "/usr/bin/llc-20";
            if (Fs.isFile("/usr/lib/llvm-20/bin/llc") != 0) return "/usr/lib/llvm-20/bin/llc";
            return "llc";
        }

        // 探测 opt（LLVM 中端优化器）：路径规则同 llc。MYP_OPT 环境变量优先。
        string findOpt() {
            string e = Console.getEnv("MYP_OPT");
            if (Str.len(e) != 0) return e;
            if (Fs.isFile("/usr/bin/opt-21") != 0) return "/usr/bin/opt-21";
            if (Fs.isFile("/usr/lib/llvm-21/bin/opt") != 0) return "/usr/lib/llvm-21/bin/opt";
            if (Fs.isFile("/usr/bin/opt-20") != 0) return "/usr/bin/opt-20";
            if (Fs.isFile("/usr/lib/llvm-20/bin/opt") != 0) return "/usr/lib/llvm-20/bin/opt";
            return "opt";
        }

        // 探测 host triple：opt 需要 `-mtriple` 才创建 TargetMachine 并注册
        // TargetIRAnalysis(TTI)——没有它 LoopVectorizer 无 cost model，所有循环
        // 保持标量（如 matmul ~2.5x 差距）。mypc 进程内管线正是给 PassBuilder
        // 传 TargetMachine 才向量化。优先 llvm-config --host-target，回退 uname。
        // MYP_LLVM_CONFIG 环境变量可显式指定 llvm-config。
        string findHostTriple() {
            string cfg = Console.getEnv("MYP_LLVM_CONFIG");
            if (Str.len(cfg) != 0) {
                string t0 = Str.trim(Process.output(cfg + " --host-target"));
                if (Str.len(t0) != 0) return t0;
            }
            string t21 = Str.trim(Process.output("llvm-config-21 --host-target"));
            if (Str.len(t21) != 0) return t21;
            string t20 = Str.trim(Process.output("llvm-config-20 --host-target"));
            if (Str.len(t20) != 0) return t20;
            string tg = Str.trim(Process.output("llvm-config --host-target"));
            if (Str.len(tg) != 0) return tg;
            string m = Str.trim(Process.output("uname -m"));
            if (m == "x86_64") return "x86_64-pc-linux-gnu";
            if (m == "aarch64" || m == "arm64") return "aarch64-unknown-linux-gnu";
            return "";
        }

        // 定位 runtime.c：优先 cwd 的 src/runtime/runtime.c，否则 stdlib 父目录。
        string findRuntimeC(string stdlib) {
            if (Fs.isFile("src/runtime/runtime.c") != 0) return "src/runtime/runtime.c";
            string rtDir = Fs.dirname(stdlib);
            string cand = rtDir + "/src/runtime/runtime.c";
            if (Fs.isFile(cand) != 0) return cand;
            return "src/runtime/runtime.c";
        }

        // 定位 coro_ctx.S（x86-64 协程上下文切换汇编）。
        string findCoroCtx(string stdlib) {
            if (Fs.isFile("src/runtime/coro_ctx.S") != 0) return "src/runtime/coro_ctx.S";
            string rtDir = Fs.dirname(stdlib);
            string cand = rtDir + "/src/runtime/coro_ctx.S";
            if (Fs.isFile(cand) != 0) return cand;
            return "";
        }

        // 定位 runtime_gpu.c（GPU/CUDA dlopen 胶水；任何 Linux 可编译，同 mypc
        // 始终链接以提供设备信息符号）。
        string findRuntimeGpu(string stdlib) {
            if (Fs.isFile("src/runtime/runtime_gpu.c") != 0) return "src/runtime/runtime_gpu.c";
            string rtDir = Fs.dirname(stdlib);
            string cand = rtDir + "/src/runtime/runtime_gpu.c";
            if (Fs.isFile(cand) != 0) return cand;
            return "";
        }

        // 定位 runtime_lib.c（cuBLAS 等厂商库 dlopen 钩子；任何 Linux 可编译）。
        string findRuntimeLib(string stdlib) {
            if (Fs.isFile("src/runtime/runtime_lib.c") != 0) return "src/runtime/runtime_lib.c";
            string rtDir = Fs.dirname(stdlib);
            string cand = rtDir + "/src/runtime/runtime_lib.c";
            if (Fs.isFile(cand) != 0) return cand;
            return "";
        }

        // 定位 include 目录（runtime.h）。
        string findIncDir(string stdlib) {
            if (Fs.isFile("include/mylang/runtime.h") != 0) return "include";
            string rtDir = Fs.dirname(stdlib);
            if (Fs.isFile(rtDir + "/include/mylang/runtime.h") != 0) return rtDir + "/include";
            return "include";
        }

        // ---- 通用桥接发现（对拍 src/main.cpp linkObjects；新增桥无需改编译器）----
        // bridges 目录（MYP_BRIDGES 冒号分隔追加；默认 <stdlib>/bridges）下 *.c 即
        // 候选桥接。程序 obj 的 nm -u 未定义符号 × 桥 nm --defined-only 取交集命中
        // 即自动编译（mtime 缓存）+ 链接；固定点迭代处理依赖链（sdl_ttf → sdl）。
        // 侧车文件（可选）：<名>.c.cflags 编译标志、<名>.c.libs 链接库。
        ArrayList<string> bridgeDirs(string stdlib) {
            ArrayList<string> out = new ArrayList<string>();
            string e = Console.getEnv("MYP_BRIDGES");
            if (Str.len(e) > 0) {
                int c = Str.splitCount(e, ":");
                for (int i = 0; i < c; i = i + 1) {
                    string d = Str.trim(Str.splitGet(e, ":", i));
                    if (Str.len(d) > 0) out.add(d);
                }
            }
            out.add(stdlib + "/bridges");
            return out;
        }

        // 目录下所有 *.c 桥接文件（完整路径）
        ArrayList<string> listBridges(string dir) {
            ArrayList<string> out = new ArrayList<string>();
            if (Fs.isDir(dir) == 0) return out;
            int n = Fs.listCount(dir);
            string[] files = Fs.listDir(dir);
            for (int i = 0; i < n; i = i + 1) {
                string f = files[i];
                int fl = Str.len(f);
                if (fl > 2 && Str.substring(f, fl - 2, fl) == ".c")
                    out.add(Fs.join(dir, f));
            }
            return out;
        }

        // nm 输出 → 符号集合（defined=1 → --defined-only；0 → -u 未定义）。
        // 每行末列 = 符号名（地址/类型列用空白分隔）。
        ArrayList<string> nmSymbols(string files, int defined) {
            ArrayList<string> out = new ArrayList<string>();
            string cmd = "nm " + ((defined != 0) ? "--defined-only " : "-u ") + files + " 2>/dev/null";
            string outp = Process.output(cmd);
            int c = Str.splitCount(outp, "\n");
            for (int i = 0; i < c; i = i + 1) {
                string line = Str.trim(Str.splitGet(outp, "\n", i));
                if (Str.len(line) == 0) continue;
                int nw = Str.splitCount(line, " ");
                string name = Str.trim(Str.splitGet(line, " ", nw - 1));
                if (Str.len(name) == 0 || name == "C") continue;
                if (Str.substring(name, 0, 1) == "*") continue;
                out.add(name);
            }
            return out;
        }

        // 读取侧车文件（去尾部空白）；不存在返回空串
        string readSidecar(string path) {
            if (Fs.isFile(path) == 0) return "";
            File f = new File();
            f.open(path, "r");
            string s = f.readAll();
            f.close();
            return Str.trim(s);
        }

        // 桥接缓存对象路径（按 basename，mtime 缓存复用）
        string bridgeObjPath(string c) {
            string base = Fs.basename(c);
            int bl = Str.len(base);
            if (bl > 2 && Str.substring(base, bl - 2, bl) == ".c")
                base = Str.substring(base, 0, bl - 2);
            return "/tmp/myp_self_bridge_" + base + ".o";
        }

        // 编译桥接（mtime 缓存：源码未变则复用）；失败返回空串
        string compileBridge(string c, string inc, string bflags) {
            string bObj = Link.bridgeObjPath(c);
            int need = 1;
            if (Fs.isFile(bObj) != 0 && Fs.isFile(c) != 0) {
                if (Fs.modifiedTime(bObj) >= Fs.modifiedTime(c)) need = 0;
            }
            if (need != 0) {
                string cmd = "gcc -I " + inc + " -fPIC -O2 -ffunction-sections -fdata-sections " + bflags + " -c " + c + " -o " + bObj + " 2>&1";
                if (Process.run(cmd) != 0) return "";
            }
            return bObj;
        }

        // b 是否有任一符号在 a 中
        int symContains(ArrayList<string> a, string s) {
            for (int i = 0; i < a.size(); i = i + 1)
                if (a.get(i) == s) return 1;
            return 0;
        }
        int symIntersect(ArrayList<string> a, ArrayList<string> b) {
            for (int i = 0; i < b.size(); i = i + 1)
                if (Link.symContains(a, b.get(i)) != 0) return 1;
            return 0;
        }

        // llPath(.ll) → [opt -O<level>] → llc → obj → gcc 链接 runtime → outPath 可执行。
        // 默认 **-O2**（CLI 默认 optLevel=2；v3.12.44 修复 opt -O2 跨 setjmp/longjmp
        // 的 finally 语义破坏根因——codegen 在 try 入口把全部在作用域局部 + finally
        // flag 的地址传给 myp_try_escape 无操作，使其成为逃逸内存，mem2reg/SROA 不
        // 提升、DSE 不删 store，-O2 下 arc_throw 15/15、全量 310/0）。optLevel>0 时
        // 跑 opt -O<level>；MYP_SELF_OPT=1 强制开启、=0 强制关闭（调试/对比）。
        int link(string llPath, string outPath, string stdlib, int optLevel) {
            string srcLl = llPath;
            string optEnv = Console.getEnv("MYP_SELF_OPT");
            int doOpt = (optLevel > 0) ? 1 : 0;
            if (optEnv == "1") doOpt = 1;
            else if (optEnv == "0") doOpt = 0;
            if (doOpt != 0) {
                string opt = Link.findOpt();
                string optPath = outPath + ".opt.ll";
                string mt = Link.findHostTriple();
                string optCmd = opt + " " + llPath + " -O" + optLevel;
                if (Str.len(mt) > 0) optCmd = optCmd + " -mtriple=" + mt;
                optCmd = optCmd + " -o " + optPath + " 2>&1";
                if (Process.run(optCmd) != 0) {
                    Console.writeLine("opt failed");
                    return 1;
                }
                srcLl = optPath;
            }
            string llc = Link.findLlc();
            string objPath = outPath + ".o";
            string cmd = llc + " " + srcLl + " -filetype=obj -relocation-model=pic -o " + objPath + " 2>&1";
            if (Process.run(cmd) != 0) {
                Console.writeLine("llc failed");
                return 1;
            }
            string inc = Link.findIncDir(stdlib);
            string rtObj = "/tmp/myp_self_rt.o";
            string runtimeC = Link.findRuntimeC(stdlib);
            // runtime.c 约 6000 行，gcc -O2 每次编译 ~0.9s，占单文件编译总耗时
            // 90%+。按 mtime 缓存：runtime.c 未变则复用 rtObj，跳过重编译。
            int needRt = 1;
            if (Fs.isFile(rtObj) != 0 && Fs.isFile(runtimeC) != 0) {
                if (Fs.modifiedTime(rtObj) >= Fs.modifiedTime(runtimeC)) needRt = 0;
            }
            if (needRt != 0) {
                cmd = "gcc -I " + inc + " -fPIC -O2 -ffunction-sections -fdata-sections -c " + runtimeC + " -o " + rtObj + " 2>&1";
                if (Process.run(cmd) != 0) {
                    Console.writeLine("runtime compile failed");
                    return 1;
                }
            }
            string ctxObj = "/tmp/myp_self_ctx.o";
            string ctxAsm = Link.findCoroCtx(stdlib);
            if (Str.len(ctxAsm) != 0) {
                // coro_ctx.S 小文件，同样按 mtime 缓存复用。
                int needCtx = 1;
                if (Fs.isFile(ctxObj) != 0 && Fs.isFile(ctxAsm) != 0) {
                    if (Fs.modifiedTime(ctxObj) >= Fs.modifiedTime(ctxAsm)) needCtx = 0;
                }
                if (needCtx != 0) {
                    cmd = "gcc -c " + ctxAsm + " -o " + ctxObj + " 2>&1";
                    if (Process.run(cmd) != 0) {
                        Console.writeLine("coro_ctx compile failed");
                        return 1;
                    }
                }
            }
            // runtime_gpu.c（dlopen 胶水）：始终链接（同 mypc），否则 gpu/cuda
            // 内建（myp_gpu_init/myp_cuda_*）链接时报 undefined reference。
            string gpuObj = "/tmp/myp_self_gpu.o";
            string gpuC = Link.findRuntimeGpu(stdlib);
            string gpuLinkObj = "";
            if (Str.len(gpuC) != 0) {
                int needGpu = 1;
                if (Fs.isFile(gpuObj) != 0 && Fs.isFile(gpuC) != 0) {
                    if (Fs.modifiedTime(gpuObj) >= Fs.modifiedTime(gpuC)) needGpu = 0;
                }
                if (needGpu != 0) {
                    cmd = "gcc -I " + inc + " -fPIC -O2 -ffunction-sections -fdata-sections -c " + gpuC + " -o " + gpuObj + " 2>&1";
                    if (Process.run(cmd) != 0) {
                        Console.writeLine("gpu runtime compile failed");
                        return 1;
                    }
                }
                gpuLinkObj = " " + gpuObj;
            }
            // runtime_lib.c（cuBLAS 等厂商库钩子）：始终链接（同 mypc）。
            string libObj = "/tmp/myp_self_lib.o";
            string libC = Link.findRuntimeLib(stdlib);
            string libLinkObj = "";
            if (Str.len(libC) != 0) {
                int needLib = 1;
                if (Fs.isFile(libObj) != 0 && Fs.isFile(libC) != 0) {
                    if (Fs.modifiedTime(libObj) >= Fs.modifiedTime(libC)) needLib = 0;
                }
                if (needLib != 0) {
                    cmd = "gcc -I " + inc + " -fPIC -O2 -ffunction-sections -fdata-sections -c " + libC + " -o " + libObj + " 2>&1";
                    if (Process.run(cmd) != 0) {
                        Console.writeLine("vendor-lib runtime compile failed");
                        return 1;
                    }
                }
                libLinkObj = " " + libObj;
            }
            // ---- 通用桥接发现（对拍 mypc；新增桥无需改自举编译器）----
            ArrayList<string> bdirs = Link.bridgeDirs(stdlib);
            ArrayList<string> allB = new ArrayList<string>();
            for (int bi = 0; bi < bdirs.size(); bi = bi + 1) {
                ArrayList<string> cs = Link.listBridges(bdirs.get(bi));
                for (int ci = 0; ci < cs.size(); ci = ci + 1) allB.add(cs.get(ci));
            }
            string bridgeObjList = "";
            string bridgeLibs = "";
            ArrayList<string> undef = Link.nmSymbols(objPath, 0);
            ArrayList<string> sel = new ArrayList<string>();
            int changed = 1;
            int guard = 0;
            while (changed != 0 && guard < 128) {
                changed = 0;
                guard = guard + 1;
                for (int i = 0; i < allB.size(); i = i + 1) {
                    string c = allB.get(i);
                    if (Link.symContains(sel, c) != 0) continue;
                    string bflags = Link.readSidecar(c + ".cflags");
                    string blibs = Link.readSidecar(c + ".libs");
                    string bObj = Link.compileBridge(c, inc, bflags);
                    if (Str.len(bObj) == 0) continue;
                    if (Link.symIntersect(undef, Link.nmSymbols(bObj, 1)) != 0) {
                        sel.add(c);
                        bridgeObjList = bridgeObjList + " " + bObj;
                        if (Str.len(blibs) > 0) bridgeLibs = bridgeLibs + " " + blibs;
                        ArrayList<string> u = Link.nmSymbols(bObj, 0);
                        for (int ui = 0; ui < u.size(); ui = ui + 1) undef.add(u.get(ui));
                        changed = 1;
                    }
                }
            }
            cmd = "gcc " + objPath + " " + rtObj + " " + ctxObj + gpuLinkObj + libLinkObj
                + bridgeObjList + " -o " + outPath + " -lpthread -lm -ldl " + bridgeLibs
                + " -Wl,--gc-sections 2>&1";
            if (Process.run(cmd) != 0) {
                Console.writeLine("link failed");
                return 1;
            }
            return 0;
        }
}
