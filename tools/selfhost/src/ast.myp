// ---- 通用 ----
class AstPair {
    action:
        @constructor AstPair() { k_ = ""; v_ = ""; typeStr_ = ""; }
        void setK(string v) { k_ = v; }
        void setV(string val) { v_ = val; }
        void setTypeStr(string v) { typeStr_ = v; }
        string k() { return k_; }
        string v() { return v_; }
        string typeStr() { return typeStr_; }
    property:
        string k_;
        string v_;
        string typeStr_;
}

class AstNonlocalSlot {
    action:
        @constructor AstNonlocalSlot() { slot_ = ""; varName_ = ""; cell_ = ""; }
        void setSlot(string v) { slot_ = v; }
        void setVarName(string v) { varName_ = v; }
        void setCell(string v) { cell_ = v; }
        string varName() { return varName_; }
        string slot() { return slot_; }
        string cell() { return cell_; }
    property:
        string slot_;
        string varName_;
        string cell_;
}

// 平移单元。
class AstTU {
    action:
        @constructor AstTU() {
            imports_ = new ArrayList<AstImport>();
            structs_ = new ArrayList<AstStruct>();
            bitfields_ = new ArrayList<AstBitfield>();
            classes_ = new ArrayList<AstClass>();
            interfaces_ = new ArrayList<AstInterface>();
            mappings_ = new ArrayList<AstMapping>();
            functions_ = new ArrayList<AstFunction>();
            enums_ = new ArrayList<AstEnum>();
            ffis_ = new ArrayList<AstFFI>();
            macros_ = new ArrayList<AstMacro>();
            typeAliases_ = new ArrayList<AstTypeAlias>();
        }
        ArrayList<AstImport> imports() { return imports_; }
        ArrayList<AstStruct> structs() { return structs_; }
        ArrayList<AstBitfield> bitfields() { return bitfields_; }
        ArrayList<AstClass> classes() { return classes_; }
        ArrayList<AstInterface> interfaces() { return interfaces_; }
        ArrayList<AstMapping> mappings() { return mappings_; }
        ArrayList<AstFunction> functions() { return functions_; }
        ArrayList<AstEnum> enums() { return enums_; }
        ArrayList<AstFFI> ffis() { return ffis_; }
        ArrayList<AstMacro> macros() { return macros_; }
        ArrayList<AstTypeAlias> typeAliases() { return typeAliases_; }
        void dump(StringBuilder sb) {
            sb.append("(TranslationUnit)\n");
            for (int i = 0; i < imports_.size(); i = i + 1) imports_.get(i).dump(sb, 2);
            for (int i = 0; i < structs_.size(); i = i + 1) structs_.get(i).dump(sb, 2);
            for (int i = 0; i < bitfields_.size(); i = i + 1) bitfields_.get(i).dump(sb, 2);
            for (int i = 0; i < classes_.size(); i = i + 1) classes_.get(i).dump(sb, 2);
            for (int i = 0; i < interfaces_.size(); i = i + 1) interfaces_.get(i).dump(sb, 2);
            for (int i = 0; i < mappings_.size(); i = i + 1) mappings_.get(i).dump(sb, 2);
            for (int i = 0; i < functions_.size(); i = i + 1) functions_.get(i).dump(sb, 2);
            for (int i = 0; i < enums_.size(); i = i + 1) enums_.get(i).dump(sb, 2);
            for (int i = 0; i < ffis_.size(); i = i + 1) ffis_.get(i).dump(sb, 2);
            for (int i = 0; i < macros_.size(); i = i + 1) macros_.get(i).dump(sb, 2);
            for (int i = 0; i < typeAliases_.size(); i = i + 1) typeAliases_.get(i).dump(sb, 2);
        }
    property:
        ArrayList<AstImport> imports_;
        ArrayList<AstStruct> structs_;
        ArrayList<AstBitfield> bitfields_;
        ArrayList<AstClass> classes_;
        ArrayList<AstInterface> interfaces_;
        ArrayList<AstMapping> mappings_;
        ArrayList<AstFunction> functions_;
        ArrayList<AstEnum> enums_;
        ArrayList<AstFFI> ffis_;
        ArrayList<AstMacro> macros_;
        ArrayList<AstTypeAlias> typeAliases_;
}

// ---- 公共工具 ----
@static class AstNode {
    static:
        void dumpTypeParams(StringBuilder sb, int ind, ArrayList<string> tps) {
            ArrayList<string> w = tps;
            for (int i = 0; i < w.size(); i = i + 1)
                Dump.line(sb, ind, "(TypeParam name=\"" + Dump.esc(w.get(i)) + "\")");
        }
        void dumpConstraints(StringBuilder sb, int ind, ArrayList<AstPair> cs) {
            ArrayList<AstPair> sorted = AstNode.sortedPairs(cs);
            for (int i = 0; i < sorted.size(); i = i + 1) {
                AstPair p = sorted.get(i);
                Dump.line(sb, ind, "(Constraint name=\"" + Dump.esc(p.k()) + "\" iface=\"" + Dump.esc(p.v()) + "\")");
            }
        }
        string joinTypes(ArrayList<AstType> ts) {
            ArrayList<AstType> w = ts;
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < w.size(); i = i + 1) {
                if (i != 0) sb.append(",");
                sb.append(w.get(i).str());
            }
            return sb.toString();
        }
        ArrayList<AstPair> sortedPairs(ArrayList<AstPair> list) {
            ArrayList<AstPair> w = list;
            int n = w.size();
            for (int i = 1; i < n; i = i + 1) {
                AstPair key = w.get(i);
                int j = i - 1;
                while (j >= 0 && Str.cmp(w.get(j).k(), key.k()) > 0) {
                    w.set(j + 1, w.get(j));
                    j = j - 1;
                }
                w.set(j + 1, key);
            }
            return w;
        }
}

