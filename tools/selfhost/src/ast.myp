class AstMappingNode {
    action:
        @constructor AstMappingNode() {
            src_ = "";
            member_ = "";
            isFunction_ = 0;
            isLambda_ = 0;
            isTransformer_ = 0;
            trKind_ = 0;
            trParam_ = 0;
            lambda_ = null;
        }
        void setSrc(string v) { src_ = v; }
        void setMember(string v) { member_ = v; }
        void setIsFunction(int v) { isFunction_ = v; }
        void setIsLambda(int v) { isLambda_ = v; }
        void setIsTransformer(int v) { isTransformer_ = v; }
        void setTrKind(int v) { trKind_ = v; }
        void setTrParam(int v) { trParam_ = v; }
        void setLambda(AstExpr v) { lambda_ = v; }
        string src() { return src_; }
        string member() { return member_; }
        int isFunction() { return isFunction_; }
        int isLambda() { return isLambda_; }
        int isTransformer() { return isTransformer_; }
        int trKind() { return trKind_; }
        int trParam() { return trParam_; }
        AstExpr lambda() { return lambda_; }
    property:
        string src_;
        string member_;
        int isFunction_;
        int isLambda_;
        int isTransformer_;
        int trKind_;
        int trParam_;
        AstExpr lambda_;
}

class AstMappingChain {
    action:
        @constructor AstMappingChain() {
            nodes_ = new ArrayList<AstMappingNode>();
            where_ = null;
        }
        ArrayList<AstMappingNode> nodes() { return nodes_; }
        void setWhere(AstExpr v) { where_ = v; }
        AstExpr whereClause() { return where_; }
    property:
        ArrayList<AstMappingNode> nodes_;
        AstExpr where_;
}

class AstMapping {
    action:
        @constructor AstMapping() {
            scope_ = 0;
            chains_ = new ArrayList<AstMappingChain>();
        }
        ArrayList<AstMappingChain> chains() { return chains_; }
        void setScope(int v) { scope_ = v; }
        void dump(StringBuilder sb, int ind) {
            Dump.line(sb, ind, "(Mapping scope=" + scope_ + ")");
            for (int i = 0; i < chains_.size(); i = i + 1) {
                AstMappingChain ch = chains_.get(i);
                Dump.line(sb, ind + 2, "(Chain)");
                for (int j = 0; j < ch.nodes().size(); j = j + 1) {
                    AstMappingNode n = ch.nodes().get(j);
                    Dump.line(sb, ind + 4, "(Node src=\"" + Dump.esc(n.src()) + "\" member=\"" + Dump.esc(n.member()) + "\" isFunction=" + n.isFunction() + " isLambda=" + n.isLambda() + " isTransformer=" + n.isTransformer() + " trKind=" + n.trKind() + " trParam=" + n.trParam() + ")");
                    if (n.lambda() != null) n.lambda().dump(sb, ind + 4);
                }
                if (ch.whereClause() != null) {
                    Dump.line(sb, ind + 4, "(Where)");
                    ch.whereClause().dump(sb, ind + 6);
                }
            }
        }
        int scope() { return scope_; }
    property:
        int scope_;
        ArrayList<AstMappingChain> chains_;
}

class AstMacro {
    action:
        @constructor AstMacro() {
            name_ = "";
            params_ = new ArrayList<string>();
            body_ = null;
        }
        ArrayList<string> params() { return params_; }
        void setName(string v) { name_ = v; }
        void setBody(AstStmt v) { body_ = v; }
        void dump(StringBuilder sb, int ind) {
            Dump.line(sb, ind, "(Macro name=\"" + Dump.esc(name_) + "\")");
            for (int i = 0; i < params_.size(); i = i + 1)
                Dump.line(sb, ind + 2, "(Param name=\"" + Dump.esc(params_.get(i)) + "\")");
            if (body_ != null) body_.dump(sb, ind + 2);
        }
        string name() { return name_; }
        AstStmt body() { return body_; }
    property:
        string name_;
        ArrayList<string> params_;
        AstStmt body_;
}

class AstImport {
    action:
