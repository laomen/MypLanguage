// ast.myp — AST 节点类 + 无损 dump（F2）
//
// 对拍基准: src/frontend_dump.cpp dumpAST（tools/selfhost/format.md §4）。
// 节点用扁平 class + kind 字符串（MYP 无继承），dump 按 kind 分派复刻 C++ 输出。
// 缩进 2 空格/层；字符串经 Dump.esc 转义；哈希容器字段（constraints/assoc）排序。
// float 值用 Fmt.g(v,17)（≡ C %.17g）。

import collections;
import text;
import fmt;

// 转义 + 缩进工具（与 format.md §2 一致）。
@static class Dump {
    static:
        string esc(string s) {
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < Str.len(s); i = i + 1) {
                int c = __myp_charcode(s, i);
                if (c == 10) sb.append("\\n");
                else if (c == 9) sb.append("\\t");
                else if (c == 13) sb.append("\\r");
                else if (c == 34) sb.append("\\\"");
                else if (c == 92) sb.append("\\\\");
                else if (c == 1) sb.append("\\0");
                // 非转义字符原样字节透传（不用 __myp_chr 重新编码）——MYP string 是
                // 字节串，__myp_charcode 返回字节（如 0xE5），__myp_chr(0xE5) 会再
                // UTF-8 编码成 2 字节（"å"）→ 多字节中文双重编码（与 C++
                // escapeDumpString 逐字节原样一致）。
                else sb.append(Str.substring(s, i, i + 1));
            }
            return sb.toString();
        }
        string pad(int n) {
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < n; i = i + 1) sb.append(" ");
            return sb.toString();
        }
        string joinList(ArrayList<string> v) {
            ArrayList<string> w = v;
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < w.size(); i = i + 1) {
                if (i != 0) sb.append(",");
                sb.append(Dump.esc(w.get(i)));
            }
            return sb.toString();
        }
        void line(StringBuilder sb, int ind, string s) {
            sb.append(Dump.pad(ind));
            sb.append(s);
            sb.append("\n");
        }
}

// ---- 类型 ----
class AstType {
    action:
        @constructor AstType() {
            basicName_ = "";
            className_ = "";
            typeArgs_ = new ArrayList<AstType>();
            element_ = null;
            arraySize_ = 0;
            genericParam_ = 0;
            funcParamTypes_ = new ArrayList<AstType>();
            funcReturn_ = null;
            isTuple_ = 0;
            bitvectorWidth_ = 0;
        }
        ArrayList<AstType> typeArgs() { return typeArgs_; }
        ArrayList<AstType> funcParamTypes() { return funcParamTypes_; }
        int line() { return line_; }
        int col() { return col_; }
        void setPos(int l, int c) { line_ = l; col_ = c; }
        void setBasicName(string v) { basicName_ = v; }
        void setClassName(string v) { className_ = v; }
        void setElement(AstType v) { element_ = v; }
        void setArraySize(int v) { arraySize_ = v; }
        void setGenericParam(int v) { genericParam_ = v; }
        void setFuncReturn(AstType v) { funcReturn_ = v; }
        void setIsTuple(int v) { isTuple_ = v; }
        void setBitvectorWidth(int v) { bitvectorWidth_ = v; }
        string str() {
            if (element_ != null) {
                StringBuilder s = new StringBuilder();
                s.append(element_.str());
                s.append("[");
                if (arraySize_ > 0) s.append("" + arraySize_);
                s.append("]");
                return s.toString();
            }
            if (Str.len(className_) != 0) {
                StringBuilder s = new StringBuilder();
                s.append(className_);
                if (typeArgs_.size() != 0) {
                    s.append("<");
                    for (int i = 0; i < typeArgs_.size(); i = i + 1) {
                        if (i != 0) s.append(",");
                        s.append(typeArgs_.get(i).str());
                    }
                    s.append(">");
                }
                return s.toString();
            }
            // 注：MYP 字符串插值会把 "$T" 当 $T 宏引用 → 用 __myp_chr(36) 拼出 "$T"。
            if (genericParam_ != 0) return __myp_chr(36) + "T";
            if (funcReturn_ != null) {
                StringBuilder s = new StringBuilder();
                s.append("(");
                for (int i = 0; i < funcParamTypes_.size(); i = i + 1) {
                    if (i != 0) s.append(",");
                    s.append(funcParamTypes_.get(i).str());
                }
                s.append(")->");
                s.append(funcReturn_.str());
                return s.toString();
            }
            if (isTuple_ != 0) {
                StringBuilder s = new StringBuilder();
                s.append("(");
                for (int i = 0; i < funcParamTypes_.size(); i = i + 1) {
                    if (i != 0) s.append(",");
                    s.append(funcParamTypes_.get(i).str());
                }
                s.append(")");
                return s.toString();
            }
            // bitvector<N> → "bitvector8"（C++ typeNodeToString: "bitvector"+width）
            if (basicName_ == "bitvector" && bitvectorWidth_ != 0) {
                return basicName_ + "" + bitvectorWidth_;
            }
            return basicName_;
        }
        string basicName() { return basicName_; }
        string className() { return className_; }
        AstType element() { return element_; }
        int arraySize() { return arraySize_; }
        int genericParam() { return genericParam_; }
        AstType funcReturn() { return funcReturn_; }
        int isTuple() { return isTuple_; }
        int bitvectorWidth() { return bitvectorWidth_; }
    property:
        string basicName_;
        string className_;
        ArrayList<AstType> typeArgs_;
        AstType element_;
        int arraySize_;
        int genericParam_;
        ArrayList<AstType> funcParamTypes_;
        AstType funcReturn_;
        int isTuple_;
        int bitvectorWidth_;
        int line_;
        int col_;
}

// ---- 声明 ----
class AstParam {
    action:
        @constructor AstParam() {
            name_ = "";
            type_ = null;
            ref_ = 0;
            hasDefault_ = 0;
            defaultExpr_ = null;
        }
        void setName(string v) { name_ = v; }
        void setType(AstType v) { type_ = v; }
        void setRef(int v) { ref_ = v; }
        void setHasDefault(int v) { hasDefault_ = v; }
        void setDefaultExpr(AstExpr v) { defaultExpr_ = v; }
        AstExpr defaultExpression() { return defaultExpr_; }
        void dump(StringBuilder sb, int ind) {
            StringBuilder s = new StringBuilder();
            s.append(Dump.pad(ind));
            s.append("(Param name=\"");
            s.append(Dump.esc(name_));
            s.append("\" type=");
            if (type_ != null) s.append(type_.str()); else s.append("?");
            s.append(" ref=");
            s.append("" + ref_);
            if (hasDefault_ != 0) s.append(" hasDefault=1");
            s.append(")\n");
            sb.append(s.toString());
            if (defaultExpr_ != null) defaultExpr_.dump(sb, ind);
        }
        string name() { return name_; }
        AstType type() { return type_; }
        int isRef() { return ref_; }
        int hasDefault() { return hasDefault_; }
        AstExpr defaultExpr() { return defaultExpr_; }
    property:
        string name_;
        AstType type_;
        int ref_;
        int hasDefault_;
        AstExpr defaultExpr_;
}

class AstVar {
    action:
        @constructor AstVar() {
            name_ = "";
            type_ = null;
            const_ = 0;
            thread_ = 0;
            threadpool_ = 0;
            isInferred_ = 0;
            init_ = null;
        }
        void setName(string v) { name_ = v; }
        void setNamePos(int l, int c) { nameLine_ = l; nameCol_ = c; }
        void setType(AstType v) { type_ = v; }
        void setInferred(int v) { isInferred_ = v; }
        void setConst(int v) { const_ = v; }
        void setThread(int v) { thread_ = v; }
        void setThreadpool(int v) { threadpool_ = v; }
        void setInit(AstExpr v) { init_ = v; }
        void dump(StringBuilder sb, int ind) {
            StringBuilder s = new StringBuilder();
            s.append(Dump.pad(ind));
            s.append("(Var name=\"");
            s.append(Dump.esc(name_));
            s.append("\" type=");
            if (type_ != null) s.append(type_.str()); else s.append("?");
            s.append(" const=");
            s.append("" + const_);
            s.append(" thread=");
            s.append("" + thread_);
            s.append(" threadpool=");
            s.append("" + threadpool_);
            s.append(")\n");
            sb.append(s.toString());
            if (init_ != null) init_.dump(sb, ind);
        }
        string name() { return name_; }
        int nameLine() { return nameLine_; }
        int nameCol() { return nameCol_; }
        AstType type() { return type_; }
        int isConst() { return const_; }
        int thread() { return thread_; }
        int threadpool() { return threadpool_; }
        int isInferred() { return isInferred_; }
        AstExpr init() { return init_; }
    property:
        string name_;
        int nameLine_;
        int nameCol_;
        AstType type_;
        int const_;
        int thread_;
        int threadpool_;
        int isInferred_;
        AstExpr init_;
}

class AstProp {
    action:
        @constructor AstProp() {
            name_ = "";
            type_ = null;
            const_ = 0;
            weak_ = 0;
            init_ = null;
            get_ = 0;   // 自动属性：外部可读（{ get; }）
            set_ = 0;   // 自动属性：外部可写（{ set; }）
        }
        void setName(string v) { name_ = v; }
        void setPos(int l, int c) { line_ = l; col_ = c; }
        void setType(AstType v) { type_ = v; }
        void setConst(int v) { const_ = v; }
        void setWeak(int v) { weak_ = v; }
        void setInit(AstExpr v) { init_ = v; }
        void setGet(int v) { get_ = v; }
        void setSet(int v) { set_ = v; }
        void dump(StringBuilder sb, int ind) {
            StringBuilder s = new StringBuilder();
            s.append(Dump.pad(ind));
            s.append("(Property name=\"");
            s.append(Dump.esc(name_));
            s.append("\" type=");
            if (type_ != null) s.append(type_.str()); else s.append("?");
            s.append(" const=");
            s.append("" + const_);
            s.append(" weak=");
            s.append("" + weak_);
            // 自动属性（{ get; set; }）：dump 仅在有访问器时输出，保持既有 dump 稳定。
            if (get_ != 0 || set_ != 0) {
                s.append(" accessor(get=");
                s.append("" + get_);
                s.append(" set=");
                s.append("" + set_);
                s.append(")");
            }
            s.append(")\n");
            sb.append(s.toString());
            if (init_ != null) init_.dump(sb, ind);
        }
        string name() { return name_; }
        int line() { return line_; }
        int col() { return col_; }
        AstType type() { return type_; }
        int isConst() { return const_; }
        int weak() { return weak_; }
        AstExpr init() { return init_; }
        int accessorGet() { return get_; }
        int accessorSet() { return set_; }
    property:
        string name_;
        int line_;
        int col_;
        AstType type_;
        int const_;
        int weak_;
        AstExpr init_;
        int get_;
        int set_;
}

class AstAction {
    action:
        @constructor AstAction() {
            name_ = "";
            line_ = 0;
            col_ = 0;
            ret_ = null;
            startup_ = 0;
            ctor_ = 0;
            test_ = 0;
            coro_ = 0;
            async_ = 0;
            region_ = 0;
            stack_ = 0;
            typeParams_ = new ArrayList<string>();
            constraints_ = new ArrayList<AstPair>();
            params_ = new ArrayList<AstParam>();
            instTypeArgs_ = new ArrayList<AstType>();
            body_ = null;
        }
        ArrayList<string> typeParams() { return typeParams_; }
        ArrayList<AstPair> constraints() { return constraints_; }
        ArrayList<AstParam> params() { return params_; }
        ArrayList<AstType> instTypeArgs() { return instTypeArgs_; }
        void setName(string v) { name_ = v; }
        void setPos(int l, int c) { line_ = l; col_ = c; }
        void setRet(AstType v) { ret_ = v; }
        void setStartup(int v) { startup_ = v; }
        void setCtor(int v) { ctor_ = v; }
        void setTest(int v) { test_ = v; }
        void setCoro(int v) { coro_ = v; }
        void setAsync(int v) { async_ = v; }
        void setRegion(int v) { region_ = v; }
        void setStack(int v) { stack_ = v; }
        void setBody(AstStmt v) { body_ = v; }
        void dump(StringBuilder sb, int ind) {
            StringBuilder s = new StringBuilder();
            s.append(Dump.pad(ind));
            s.append("(Action name=\"");
            s.append(Dump.esc(name_));
            s.append("\" ret=");
            if (ret_ != null) s.append(ret_.str()); else s.append("?");
            s.append(" startup=");
            s.append("" + startup_);
            s.append(" ctor=");
            s.append("" + ctor_);
            s.append(" test=");
            s.append("" + test_);
            s.append(" coro=");
            s.append("" + coro_);
            s.append(" async=");
            s.append("" + async_);
            s.append(" region=");
            s.append("" + region_);
            s.append(" stack=");
            s.append("" + stack_);
            s.append(")\n");
            sb.append(s.toString());
            AstNode.dumpTypeParams(sb, ind + 2, typeParams_);
            AstNode.dumpConstraints(sb, ind + 2, constraints_);
            for (int i = 0; i < params_.size(); i = i + 1) params_.get(i).dump(sb, ind + 2);
            if (body_ != null) body_.dump(sb, ind + 2);
        }
        string name() { return name_; }
        int line() { return line_; }
        int col() { return col_; }
        AstType ret() { return ret_; }
        int startup() { return startup_; }
        int ctor() { return ctor_; }
        int test() { return test_; }
        int coro() { return coro_; }
        int async() { return async_; }
        int region() { return region_; }
        int stack() { return stack_; }
        AstStmt body() { return body_; }
    property:
        string name_;
        int line_;
        int col_;
        AstType ret_;
        int startup_;
        int ctor_;
        int test_;
        int coro_;
        int async_;
        int region_;
        int stack_;
        ArrayList<string> typeParams_;
        ArrayList<AstPair> constraints_;
        ArrayList<AstParam> params_;
        ArrayList<AstType> instTypeArgs_;
        AstStmt body_;
}

class AstEvent {
    action:
        @constructor AstEvent() {
            name_ = "";
            params_ = new ArrayList<AstParam>();
        }
        ArrayList<AstParam> params() { return params_; }
        void setName(string v) { name_ = v; }
        void dump(StringBuilder sb, int ind) {
            Dump.line(sb, ind, "(Event name=\"" + Dump.esc(name_) + "\")");
            for (int i = 0; i < params_.size(); i = i + 1) params_.get(i).dump(sb, ind + 2);
        }
        string name() { return name_; }
    property:
        string name_;
        ArrayList<AstParam> params_;
}

class AstStruct {
    action:
        @constructor AstStruct() {
            name_ = "";
            parent_ = "";
            props_ = new ArrayList<AstProp>();
            funcs_ = new ArrayList<AstFunction>();
        }
        ArrayList<AstProp> props() { return props_; }
        ArrayList<AstFunction> funcs() { return funcs_; }
        void setName(string v) { name_ = v; }
        void setPos(int l, int c) { line_ = l; col_ = c; }
        void setParent(string v) { parent_ = v; }
        void dump(StringBuilder sb, int ind) {
            Dump.line(sb, ind, "(Struct name=\"" + Dump.esc(name_) + "\" parent=\"" + Dump.esc(parent_) + "\")");
            for (int i = 0; i < props_.size(); i = i + 1) props_.get(i).dump(sb, ind + 2);
            for (int i = 0; i < funcs_.size(); i = i + 1) funcs_.get(i).dump(sb, ind + 2);
        }
        string name() { return name_; }
        int line() { return line_; }
        int col() { return col_; }
        string parent() { return parent_; }
    property:
        string name_;
        int line_;
        int col_;
        string parent_;
        ArrayList<AstProp> props_;
        ArrayList<AstFunction> funcs_;
}

class AstBitfieldField {
    action:
        @constructor AstBitfieldField() { name_ = ""; width_ = 0; offset_ = 0; }
        void setName(string v) { name_ = v; }
        void setWidth(int v) { width_ = v; }
        void setOffset(int v) { offset_ = v; }
        string name() { return name_; }
        int width() { return width_; }
        int offset() { return offset_; }
    property:
        string name_;
        int width_;
        int offset_;
}

class AstBitfield {
    action:
        @constructor AstBitfield() {
            name_ = "";
            totalBits_ = 0;
            fields_ = new ArrayList<AstBitfieldField>();
        }
        ArrayList<AstBitfieldField> fields() { return fields_; }
        void setName(string v) { name_ = v; }
        void setTotalBits(int v) { totalBits_ = v; }
        void dump(StringBuilder sb, int ind) {
            Dump.line(sb, ind, "(Bitfield name=\"" + Dump.esc(name_) + "\" totalBits=" + totalBits_ + ")");
            for (int i = 0; i < fields_.size(); i = i + 1) {
                AstBitfieldField f = fields_.get(i);
                Dump.line(sb, ind + 2, "(Field name=\"" + Dump.esc(f.name()) + "\" width=" + f.width() + " offset=" + f.offset() + ")");
            }
        }
        string name() { return name_; }
        int totalBits() { return totalBits_; }
    property:
        string name_;
        int totalBits_;
        ArrayList<AstBitfieldField> fields_;
}

class AstClass {
    action:
        @constructor AstClass() {
            name_ = "";
            derive_ = "";
            isStatic_ = 0;
            isThread_ = 0;
            isGenericInst_ = 0;
            lambda_ = "";
            iface_ = "";
            typeParams_ = new ArrayList<string>();
            constraints_ = new ArrayList<AstPair>();
            instTypeArgs_ = new ArrayList<AstType>();
            assocTypes_ = new ArrayList<AstPair>();
            nonlocalSlots_ = new ArrayList<AstNonlocalSlot>();
            actions_ = new ArrayList<AstAction>();
            staticActions_ = new ArrayList<AstAction>();
            events_ = new ArrayList<AstEvent>();
            props_ = new ArrayList<AstProp>();
            funcs_ = new ArrayList<AstFunction>();
            structs_ = new ArrayList<AstStruct>();
        }
        ArrayList<string> typeParams() { return typeParams_; }
        ArrayList<AstPair> constraints() { return constraints_; }
        ArrayList<AstType> instTypeArgs() { return instTypeArgs_; }
        ArrayList<AstPair> assocTypes() { return assocTypes_; }
        ArrayList<AstNonlocalSlot> nonlocalSlots() { return nonlocalSlots_; }
        ArrayList<AstAction> actions() { return actions_; }
        ArrayList<AstAction> staticActions() { return staticActions_; }
        ArrayList<AstEvent> events() { return events_; }
        ArrayList<AstProp> props() { return props_; }
        ArrayList<AstFunction> funcs() { return funcs_; }
        ArrayList<AstStruct> structs() { return structs_; }
        void setName(string v) { name_ = v; }
        void setPos(int l, int c) { line_ = l; col_ = c; }
        void setIsStatic(int v) { isStatic_ = v; }
        void setIsThread(int v) { isThread_ = v; }
        void setDerive(string v) { derive_ = v; }
        int isStatic() { return isStatic_; }
        int isThread() { return isThread_; }
        void setIsGenericInst(int v) { isGenericInst_ = v; }
        void setLambda(string v) { lambda_ = v; }
        void setIface(string v) { iface_ = v; }
        void dump(StringBuilder sb, int ind) {
            Dump.line(sb, ind, "(Class name=\"" + Dump.esc(name_) + "\" isStatic=" + isStatic_ + " isGenericInst=" + isGenericInst_ + " lambda=" + lambda_ + " iface=\"" + Dump.esc(iface_) + "\")");
            AstNode.dumpTypeParams(sb, ind + 2, typeParams_);
            AstNode.dumpConstraints(sb, ind + 2, constraints_);
            for (int i = 0; i < instTypeArgs_.size(); i = i + 1)
                Dump.line(sb, ind + 2, "(InstTypeArg type=" + instTypeArgs_.get(i).str() + ")");
            ArrayList<AstPair> assoc = AstNode.sortedPairs(assocTypes_);
            for (int i = 0; i < assoc.size(); i = i + 1) {
                AstPair p = assoc.get(i);
                Dump.line(sb, ind + 2, "(AssocType name=\"" + Dump.esc(p.k()) + "\" type=" + p.typeStr() + ")");
            }
            for (int i = 0; i < nonlocalSlots_.size(); i = i + 1) {
                AstNonlocalSlot ns = nonlocalSlots_.get(i);
                Dump.line(sb, ind + 2, "(NonlocalSlot slot=\"" + Dump.esc(ns.slot()) + "\" var=\"" + Dump.esc(ns.varName()) + "\" cell=\"" + Dump.esc(ns.cell()) + "\")");
            }
            for (int i = 0; i < actions_.size(); i = i + 1) actions_.get(i).dump(sb, ind + 2);
            for (int i = 0; i < staticActions_.size(); i = i + 1) {
                Dump.line(sb, ind + 2, "(Static)");
                staticActions_.get(i).dump(sb, ind + 4);
            }
            for (int i = 0; i < events_.size(); i = i + 1) events_.get(i).dump(sb, ind + 2);
            for (int i = 0; i < props_.size(); i = i + 1) props_.get(i).dump(sb, ind + 2);
            for (int i = 0; i < funcs_.size(); i = i + 1) funcs_.get(i).dump(sb, ind + 2);
            for (int i = 0; i < structs_.size(); i = i + 1) structs_.get(i).dump(sb, ind + 2);
        }
        string name() { return name_; }
        int line() { return line_; }
        int col() { return col_; }
        int isGenericInst() { return isGenericInst_; }
        string lambda() { return lambda_; }
        string iface() { return iface_; }
        string derive() { return derive_; }
    property:
        string name_;
        int line_;
        int col_;
        int isStatic_;
        int isThread_;    // @static @thread class：属性发射为 thread_local 全局（per-thread）
        string derive_;   // @derive(X)：类级派生宏名（@derive(Json) → toJson/fromJson）
        int isGenericInst_;
        string lambda_;
        string iface_;
        ArrayList<string> typeParams_;
        ArrayList<AstPair> constraints_;
        ArrayList<AstType> instTypeArgs_;
        ArrayList<AstPair> assocTypes_;
        ArrayList<AstNonlocalSlot> nonlocalSlots_;
        ArrayList<AstAction> actions_;
        ArrayList<AstAction> staticActions_;
        ArrayList<AstEvent> events_;
        ArrayList<AstProp> props_;
        ArrayList<AstFunction> funcs_;
        ArrayList<AstStruct> structs_;
}

class AstInterface {
    action:
        @constructor AstInterface() {
            name_ = "";
            assocTypeDecls_ = new ArrayList<string>();
            actions_ = new ArrayList<AstAction>();
            events_ = new ArrayList<AstEvent>();
        }
        ArrayList<string> assocTypeDecls() { return assocTypeDecls_; }
        ArrayList<AstAction> actions() { return actions_; }
        ArrayList<AstEvent> events() { return events_; }
        void setName(string v) { name_ = v; }
        void dump(StringBuilder sb, int ind) {
            Dump.line(sb, ind, "(Interface name=\"" + Dump.esc(name_) + "\")");
            for (int i = 0; i < assocTypeDecls_.size(); i = i + 1)
                Dump.line(sb, ind + 2, "(AssocTypeDecl name=\"" + Dump.esc(assocTypeDecls_.get(i)) + "\")");
            for (int i = 0; i < actions_.size(); i = i + 1) actions_.get(i).dump(sb, ind + 2);
            for (int i = 0; i < events_.size(); i = i + 1) events_.get(i).dump(sb, ind + 2);
        }
        string name() { return name_; }
    property:
        string name_;
        ArrayList<string> assocTypeDecls_;
        ArrayList<AstAction> actions_;
        ArrayList<AstEvent> events_;
}

class AstFunction {
    action:
        @constructor AstFunction() {
            name_ = "";
            ret_ = null;
            genericInst_ = 0;
            test_ = 0;
            autoMain_ = 0;
            region_ = 0;
            coro_ = 0;
            async_ = 0;
            stack_ = 0;
            op_ = "";
            eval_ = 0;
            macro_ = 0;
            ctor_ = 0;
            constDecl_ = 0;
            typeParams_ = new ArrayList<string>();
            constraints_ = new ArrayList<AstPair>();
            instTypeArgs_ = new ArrayList<AstType>();
            params_ = new ArrayList<AstParam>();
            body_ = null;
        }
        ArrayList<string> typeParams() { return typeParams_; }
        ArrayList<AstPair> constraints() { return constraints_; }
        ArrayList<AstType> instTypeArgs() { return instTypeArgs_; }
        ArrayList<AstParam> params() { return params_; }
        void setName(string v) { name_ = v; }
        void setPos(int l, int c) { line_ = l; col_ = c; }
        void setRet(AstType v) { ret_ = v; }
        void setGenericInst(int v) { genericInst_ = v; }
        void setTest(int v) { test_ = v; }
        void setAutoMain(int v) { autoMain_ = v; }
        void setRegion(int v) { region_ = v; }
        void setCoro(int v) { coro_ = v; }
        void setAsync(int v) { async_ = v; }
        void setStack(int v) { stack_ = v; }
        void setOp(string v) { op_ = v; }
        void setEval(int v) { eval_ = v; }
        void setMacro(int v) { macro_ = v; }
        void setCtor(int v) { ctor_ = v; }
        void setConstDecl(int v) { constDecl_ = v; }
        void setBody(AstStmt v) { body_ = v; }
        void dump(StringBuilder sb, int ind) {
            Dump.line(sb, ind, "(Function name=\"" + Dump.esc(name_) + "\" ret=" + (ret_ != null ? ret_.str() : "?") + " genericInst=" + genericInst_ + " test=" + test_ + " autoMain=" + autoMain_ + " region=" + region_ + " coro=" + coro_ + " async=" + async_ + " stack=" + stack_ + " op=\"" + Dump.esc(op_) + "\" eval=" + eval_ + " macro=" + macro_ + " ctor=" + ctor_ + " constDecl=" + constDecl_ + ")");
            AstNode.dumpTypeParams(sb, ind + 2, typeParams_);
            AstNode.dumpConstraints(sb, ind + 2, constraints_);
            for (int i = 0; i < instTypeArgs_.size(); i = i + 1)
                Dump.line(sb, ind + 2, "(InstTypeArg type=" + instTypeArgs_.get(i).str() + ")");
            for (int i = 0; i < params_.size(); i = i + 1) params_.get(i).dump(sb, ind + 2);
            if (body_ != null) body_.dump(sb, ind + 2);
        }
        string name() { return name_; }
        int line() { return line_; }
        int col() { return col_; }
        AstType ret() { return ret_; }
        int genericInst() { return genericInst_; }
        int test() { return test_; }
        int autoMain() { return autoMain_; }
        int region() { return region_; }
        int coro() { return coro_; }
        int async() { return async_; }
        int stack() { return stack_; }
        string op() { return op_; }
        int eval() { return eval_; }
        int isMacro() { return macro_; }
        int ctor() { return ctor_; }
        int constDecl() { return constDecl_; }
        AstStmt body() { return body_; }
    property:
        string name_;
        int line_;
        int col_;
        AstType ret_;
        int genericInst_;
        int test_;
        int autoMain_;
        int region_;
        int coro_;
        int async_;
        int stack_;
        string op_;
        int eval_;
        int macro_;
        int ctor_;
        int constDecl_;
        ArrayList<string> typeParams_;
        ArrayList<AstPair> constraints_;
        ArrayList<AstType> instTypeArgs_;
        ArrayList<AstParam> params_;
        AstStmt body_;
}

class AstEnum {
    action:
        @constructor AstEnum() {
            name_ = "";
            variants_ = new ArrayList<AstEnumVariant>();
        }
        ArrayList<AstEnumVariant> variants() { return variants_; }
        void setName(string v) { name_ = v; }
        void setPos(int l, int c) { line_ = l; col_ = c; }
        void dump(StringBuilder sb, int ind) {
            Dump.line(sb, ind, "(Enum name=\"" + Dump.esc(name_) + "\")");
            for (int i = 0; i < variants_.size(); i = i + 1) variants_.get(i).dump(sb, ind + 2);
        }
        string name() { return name_; }
        int line() { return line_; }
        int col() { return col_; }
    property:
        string name_;
        int line_;
        int col_;
        ArrayList<AstEnumVariant> variants_;
}

