        }
        string name() { return name_; }
        string path() { return path_; }
        int isPath() { return isPath_; }
    property:
        string name_;
        string path_;
        int isPath_;
}

class AstTypeAlias {
    action:
        @constructor AstTypeAlias() { name_ = ""; type_ = null; }
        void setName(string v) { name_ = v; }
        void setType(AstType v) { type_ = v; }
        void dump(StringBuilder sb, int ind) {
            Dump.line(sb, ind, "(TypeAlias name=\"" + Dump.esc(name_) + "\" type=" + (type_ != null ? type_.str() : "?") + ")");
        }
        string name() { return name_; }
        AstType type() { return type_; }
    property:
        string name_;
        AstType type_;
}

// ---- 语句（扁平：kind 字符串 + 字段）----
class AstStmt {
    action:
        @constructor AstStmt() {
            kind_ = "";
            line_ = 0;
            col_ = 0;
            bodyStmts_ = new ArrayList<AstStmt>();
            condition_ = null;
            then_ = null;
            else_ = null;
            body_ = null;
            init_ = null;
            step_ = null;
            value_ = null;
            expr_ = null;
            decls_ = new ArrayList<AstVar>();
            target_ = null;
            isDecl_ = 0;
            varName_ = "";
            varType_ = null;
            hasType_ = 0;
            iterKind_ = 0;
            className_ = "";
            sizeFn_ = "";
            getFn_ = "";
            arrSize_ = -1;
            parallel_ = 0;
            gpu_ = 0;
            stride_ = 0;
            block_ = 0;
            resident_ = new ArrayList<AstPair>();
            stream_ = null;
            subject_ = null;
            arms_ = new ArrayList<AstMatchArm>();
            tryBlock_ = null;
            catches_ = new ArrayList<AstCatch>();
            finallyBlock_ = null;
            mapping_ = null;
            names_ = new ArrayList<string>();
            acc_ = "";
            x_ = "";
            arr_ = "";
            out_ = "";
            exclusive_ = 0;
            inName_ = "";
            idxName_ = "";
            mode_ = 0;
            aBegin_ = null;
            aEnd_ = null;
            idxBegin_ = null;
            idxEnd_ = null;
            sharedType_ = null;
            name_ = "";
            hasGrid_ = 0;
            gridVal_ = 1;
            gridExpr_ = null;
            opBody_ = null;
            opExpr_ = null;
            initExpr_ = null;
            beginExpr_ = null;
            endExpr_ = null;
            timeout_ = null;
            iterable_ = null;
            throwType_ = "";
        }
        ArrayList<AstStmt> bodyStmts() { return bodyStmts_; }
        void setBodyStmts(ArrayList<AstStmt> v) { bodyStmts_ = v; }
        ArrayList<AstVar> decls() { return decls_; }
        ArrayList<AstPair> resident() { return resident_; }
        ArrayList<AstMatchArm> arms() { return arms_; }
        ArrayList<AstCatch> catches() { return catches_; }
        ArrayList<string> names() { return names_; }
        void setKind(string v) { kind_ = v; }
        void setPos(int l, int c) { line_ = l; col_ = c; }
        void setEndPos(int l, int c) { endLine_ = l; endCol_ = c; }
        void setCondition(AstExpr v) { condition_ = v; }
        void setThen(AstStmt v) { then_ = v; }
        void setElse(AstStmt v) { else_ = v; }
        void setBody(AstStmt v) { body_ = v; }
        void setInit(AstStmt v) { init_ = v; }
        void setStep(AstExpr v) { step_ = v; }
        void setValue(AstExpr v) { value_ = v; }
        void setExpr(AstExpr v) { expr_ = v; }
        void setTarget(AstDestructureTarget v) { target_ = v; }
        void setIsDecl(int v) { isDecl_ = v; }
        void setVarName(string v) { varName_ = v; }
        void setVarType(AstType v) { varType_ = v; }
        void setHasType(int v) { hasType_ = v; }
        void setIterKind(int v) { iterKind_ = v; }
        void setClassName(string v) { className_ = v; }
        void setSizeFn(string v) { sizeFn_ = v; }
        void setGetFn(string v) { getFn_ = v; }
        void setArrSize(int v) { arrSize_ = v; }
        void setParallel(int v) { parallel_ = v; }
        void setGpu(int v) { gpu_ = v; }
        void setStride(int v) { stride_ = v; }
        void setBlock(int v) { block_ = v; }
        void setStream(AstExpr v) { stream_ = v; }
        void setSubject(AstExpr v) { subject_ = v; }
        void setTryBlock(AstStmt v) { tryBlock_ = v; }
        void setFinallyBlock(AstStmt v) { finallyBlock_ = v; }
        void setMapping(AstMapping v) { mapping_ = v; }
        void setAcc(string v) { acc_ = v; }
        void setX(string v) { x_ = v; }
        void setArr(string v) { arr_ = v; }
        void setOut(string v) { out_ = v; }
        void setExclusive(int v) { exclusive_ = v; }
        void setInName(string v) { inName_ = v; }
        void setIdxName(string v) { idxName_ = v; }
        void setMode(int v) { mode_ = v; }
        void setABegin(AstExpr v) { aBegin_ = v; }
        void setAEnd(AstExpr v) { aEnd_ = v; }
        void setIdxBegin(AstExpr v) { idxBegin_ = v; }
        void setIdxEnd(AstExpr v) { idxEnd_ = v; }
        void setSharedType(AstType v) { sharedType_ = v; }
        void setName(string v) { name_ = v; }
        void setHasGrid(int v) { hasGrid_ = v; }
        void setGridVal(int v) { gridVal_ = v; }
        void setGridExpr(AstExpr v) { gridExpr_ = v; }
        void setOpBody(AstStmt v) { opBody_ = v; }
        void setOpExpr(AstExpr v) { opExpr_ = v; }
        void setInitExpr(AstExpr v) { initExpr_ = v; }
        void setBeginExpr(AstExpr v) { beginExpr_ = v; }
        void setEndExpr(AstExpr v) { endExpr_ = v; }
        void setTimeout(AstExpr v) { timeout_ = v; }
        void setIterable(AstExpr v) { iterable_ = v; }
        void setThrowType(string v) { throwType_ = v; }
        AstExpr iterable() { return iterable_; }
        string loopVarName() { return varName_; }
        int loopHasType() { return hasType_; }
        AstType loopVarType() { return varType_; }
        void dump(StringBuilder sb, int ind) {
            if (kind_ == "Block") {
                Dump.line(sb, ind, "(Block)");
                for (int i = 0; i < bodyStmts_.size(); i = i + 1) bodyStmts_.get(i).dump(sb, ind + 2);
            } else if (kind_ == "VarDecl") {
                Dump.line(sb, ind, "(VarDecl)");
                for (int i = 0; i < decls_.size(); i = i + 1) decls_.get(i).dump(sb, ind + 2);
            } else if (kind_ == "Destructure") {
                Dump.line(sb, ind, "(Destructure isDecl=" + isDecl_ + ")");
                if (target_ != null) target_.dump(sb, ind + 2);
                if (value_ != null) value_.dump(sb, ind + 2);
            } else if (kind_ == "ExprStmt") {
                Dump.line(sb, ind, "(ExprStmt)");
                if (expr_ != null) expr_.dump(sb, ind + 2);
            } else if (kind_ == "If") {
                Dump.line(sb, ind, "(If)");
                if (condition_ != null) condition_.dump(sb, ind + 2);
                if (then_ != null) then_.dump(sb, ind + 2);
                if (else_ != null) else_.dump(sb, ind + 2);
            } else if (kind_ == "While") {
                Dump.line(sb, ind, "(While)");
                if (condition_ != null) condition_.dump(sb, ind + 2);
                if (body_ != null) body_.dump(sb, ind + 2);
            } else if (kind_ == "For") {
                Dump.line(sb, ind, "(For parallel=" + parallel_ + " gpu=" + gpu_ + " stride=" + stride_ + " block=" + block_ + ")");
                for (int i = 0; i < resident_.size(); i = i + 1) {
                    AstPair p = resident_.get(i);
                    Dump.line(sb, ind + 2, "(Resident arr=\"" + Dump.esc(p.k()) + "\" dev=\"" + Dump.esc(p.v()) + "\")");
                }
                if (init_ != null) init_.dump(sb, ind + 2);
                if (condition_ != null) condition_.dump(sb, ind + 2);
                if (step_ != null) step_.dump(sb, ind + 2);
                if (stream_ != null) stream_.dump(sb, ind + 2);
                if (body_ != null) body_.dump(sb, ind + 2);
            } else if (kind_ == "ForIn") {
                // C++ TypeNode 默认 basic_type=Int：未显式类型时 dump 出 "int"
                Dump.line(sb, ind, "(ForIn name=\"" + Dump.esc(varName_) + "\" type=" + (varType_ != null ? varType_.str() : "int") + " hasType=" + hasType_ + " iterKind=" + iterKind_ + " class=\"" + Dump.esc(className_) + "\" sizeFn=\"" + Dump.esc(sizeFn_) + "\" getFn=\"" + Dump.esc(getFn_) + "\" arrSize=" + arrSize_ + ")");
                if (iterable_ != null) iterable_.dump(sb, ind + 2);
                if (body_ != null) body_.dump(sb, ind + 2);
            } else if (kind_ == "Return") {
                Dump.line(sb, ind, "(Return)");
                if (value_ != null) value_.dump(sb, ind + 2);
            } else if (kind_ == "Break") {
                Dump.line(sb, ind, "(Break)");
            } else if (kind_ == "Continue") {
                Dump.line(sb, ind, "(Continue)");
            } else if (kind_ == "Await") {
                Dump.line(sb, ind, "(Await)");
                if (expr_ != null) expr_.dump(sb, ind + 2);
                if (timeout_ != null) timeout_.dump(sb, ind + 2);
            } else if (kind_ == "MappingStmt") {
                Dump.line(sb, ind, "(MappingStmt)");
                if (mapping_ != null) mapping_.dump(sb, ind + 2);
            } else if (kind_ == "Match") {
                Dump.line(sb, ind, "(Match)");
                if (subject_ != null) subject_.dump(sb, ind + 2);
                for (int i = 0; i < arms_.size(); i = i + 1) {
                    AstMatchArm a = arms_.get(i);
                    if (a.patKind() == "enum") {
                        Dump.line(sb, ind + 2, "(Arm enum=\"" + Dump.esc(a.enumName()) + "\" variant=\"" + Dump.esc(a.variant()) + "\" index=" + a.index() + " bindings=[" + Dump.joinList(a.bindings()) + "])");
                    } else {
                        Dump.line(sb, ind + 2, "(Arm pat=" + a.patKind() + " litInt=" + a.litInt() + " litStr=\"" + Dump.esc(a.litStr()) + "\" bindings=[" + Dump.joinList(a.bindings()) + "])");
                    }
                    if (a.body() != null) a.body().dump(sb, ind + 4);
                }
            } else if (kind_ == "Try") {
                Dump.line(sb, ind, "(Try)");
                if (tryBlock_ != null) tryBlock_.dump(sb, ind + 2);
                for (int i = 0; i < catches_.size(); i = i + 1) {
                    AstCatch c = catches_.get(i);
                    Dump.line(sb, ind + 2, "(Catch var=\"" + Dump.esc(c.varName()) + "\" type=\"" + Dump.esc(c.type()) + "\")");
                    if (c.block() != null) c.block().dump(sb, ind + 4);
                }
                if (finallyBlock_ != null) finallyBlock_.dump(sb, ind + 2);
            } else if (kind_ == "Throw") {
                Dump.line(sb, ind, "(Throw)");
                if (expr_ != null) expr_.dump(sb, ind + 2);
            } else if (kind_ == "Nonlocal") {
                Dump.line(sb, ind, "(Nonlocal names=[" + Dump.joinList(names_) + "])");
            } else if (kind_ == "GpuTile") {
                Dump.line(sb, ind, "(GpuTile name=\"" + Dump.esc(name_) + "\" hasGrid=" + hasGrid_ + " grid=" + gridVal_ + " block=" + block_ + ")");
                if (sharedType_ != null) Dump.line(sb, ind + 2, "(SharedType type=" + sharedType_.str() + ")");
                if (gridExpr_ != null) gridExpr_.dump(sb, ind + 2);
                for (int i = 0; i < resident_.size(); i = i + 1) {
                    AstPair p = resident_.get(i);
                    Dump.line(sb, ind + 2, "(Resident arr=\"" + Dump.esc(p.k()) + "\" dev=\"" + Dump.esc(p.v()) + "\")");
                }
                if (stream_ != null) stream_.dump(sb, ind + 2);
                if (body_ != null) body_.dump(sb, ind + 2);
            } else if (kind_ == "GpuReduce") {
                Dump.line(sb, ind, "(GpuReduce acc=\"" + Dump.esc(acc_) + "\" x=\"" + Dump.esc(x_) + "\" arr=\"" + Dump.esc(arr_) + "\" out=\"" + Dump.esc(out_) + "\" block=" + block_ + ")");
                if (opBody_ != null) opBody_.dump(sb, ind + 2);
                if (opExpr_ != null) opExpr_.dump(sb, ind + 2);
                if (initExpr_ != null) initExpr_.dump(sb, ind + 2);
                if (beginExpr_ != null) beginExpr_.dump(sb, ind + 2);
                if (endExpr_ != null) endExpr_.dump(sb, ind + 2);
            } else if (kind_ == "GpuScan") {
                Dump.line(sb, ind, "(GpuScan acc=\"" + Dump.esc(acc_) + "\" x=\"" + Dump.esc(x_) + "\" in=\"" + Dump.esc(inName_) + "\" out=\"" + Dump.esc(out_) + "\" exclusive=" + exclusive_ + " block=" + block_ + ")");
                if (opBody_ != null) opBody_.dump(sb, ind + 2);
                if (opExpr_ != null) opExpr_.dump(sb, ind + 2);
                if (initExpr_ != null) initExpr_.dump(sb, ind + 2);
                if (beginExpr_ != null) beginExpr_.dump(sb, ind + 2);
                if (endExpr_ != null) endExpr_.dump(sb, ind + 2);
            } else if (kind_ == "GpuScatter") {
                Dump.line(sb, ind, "(GpuScatter a=\"" + Dump.esc(arr_) + "\" b=\"" + Dump.esc(out_) + "\" idx=\"" + Dump.esc(idxName_) + "\" mode=" + mode_ + " block=" + block_ + ")");
                if (aBegin_ != null) aBegin_.dump(sb, ind + 2);
                if (aEnd_ != null) aEnd_.dump(sb, ind + 2);
                if (idxBegin_ != null) idxBegin_.dump(sb, ind + 2);
                if (idxEnd_ != null) idxEnd_.dump(sb, ind + 2);
            } else {
                Dump.line(sb, ind, "(Stmt)");
            }
        }
        string kind() { return kind_; }
        int line() { return line_; }
        int col() { return col_; }
        int endLine() { return endLine_; }
        int endCol() { return endCol_; }
        AstExpr condition() { return condition_; }
        AstStmt then() { return then_; }
        AstStmt elseBranch() { return else_; }
        AstStmt body() { return body_; }
        AstStmt init() { return init_; }
        AstExpr step() { return step_; }
        AstExpr value() { return value_; }
        AstExpr expr() { return expr_; }
        AstDestructureTarget target() { return target_; }
        int isDecl() { return isDecl_; }
        string varName() { return varName_; }
        AstType varType() { return varType_; }
        int hasType() { return hasType_; }
        int iterKind() { return iterKind_; }
        string className() { return className_; }
        string sizeFn() { return sizeFn_; }
        string getFn() { return getFn_; }
        int arrSize() { return arrSize_; }
        int parallel() { return parallel_; }
        int gpu() { return gpu_; }
        int stride() { return stride_; }
        int block() { return block_; }
        AstExpr stream() { return stream_; }
        AstExpr subject() { return subject_; }
        AstStmt tryBlock() { return tryBlock_; }
        AstStmt finallyBlock() { return finallyBlock_; }
        AstMapping mappingDecl() { return mapping_; }
        string acc() { return acc_; }
        string x() { return x_; }
        string arr() { return arr_; }
        string out() { return out_; }
        int exclusive() { return exclusive_; }
        string inName() { return inName_; }
        string idxName() { return idxName_; }
        int mode() { return mode_; }
        AstExpr aBegin() { return aBegin_; }
        AstExpr aEnd() { return aEnd_; }
        AstExpr idxBegin() { return idxBegin_; }
        AstExpr idxEnd() { return idxEnd_; }
        AstType sharedType() { return sharedType_; }
        string name() { return name_; }
        int hasGrid() { return hasGrid_; }
        int gridVal() { return gridVal_; }
        AstExpr gridExpr() { return gridExpr_; }
        AstStmt opBody() { return opBody_; }
        AstExpr opExpr() { return opExpr_; }
        AstExpr initExpr() { return initExpr_; }
        AstExpr beginExpr() { return beginExpr_; }
        AstExpr endExpr() { return endExpr_; }
        AstExpr timeout() { return timeout_; }
        string throwType() { return throwType_; }
    property:
        string kind_;
        int line_;
        int col_;
        int endLine_;
        int endCol_;
        ArrayList<AstStmt> bodyStmts_;
        AstExpr condition_;
        AstStmt then_;
        AstStmt else_;
        AstStmt body_;
        AstStmt init_;
        AstExpr step_;
        AstExpr value_;
        AstExpr expr_;
        ArrayList<AstVar> decls_;
        AstDestructureTarget target_;
        int isDecl_;
        string varName_;
        AstType varType_;
        int hasType_;
        int iterKind_;
        string className_;
        string sizeFn_;
        string getFn_;
        int arrSize_;
        int parallel_;
        int gpu_;
        int stride_;
        int block_;
        ArrayList<AstPair> resident_;
        AstExpr stream_;
        AstExpr subject_;
        ArrayList<AstMatchArm> arms_;
        AstStmt tryBlock_;
        ArrayList<AstCatch> catches_;
        AstStmt finallyBlock_;
        AstMapping mapping_;
        ArrayList<string> names_;
        string acc_;
        string x_;
        string arr_;
        string out_;
        int exclusive_;
        string inName_;
        string idxName_;
        int mode_;
        AstExpr aBegin_;
        AstExpr aEnd_;
        AstExpr idxBegin_;
        AstExpr idxEnd_;
        AstType sharedType_;
        string name_;
        int hasGrid_;
        int gridVal_;
        AstExpr gridExpr_;
        AstStmt opBody_;
        AstExpr opExpr_;
        AstExpr initExpr_;
        AstExpr beginExpr_;
        AstExpr endExpr_;
        AstExpr timeout_;
        AstExpr iterable_;
        string throwType_;
}

class AstMatchArm {
    action:
        @constructor AstMatchArm() {
            // patKind：enum（变体）/ int / long / uint / char / string / float /
            // float32（字面量模式）/ wildcard（_ 通配默认臂）。
            patKind_ = "enum";
            enum_ = "";
            variant_ = "";
            index_ = 0;
            bindings_ = new ArrayList<string>();
            body_ = null;
            litInt_ = 0L;
            litStr_ = "";
            litDbl_ = 0.0;
        }
        ArrayList<string> bindings() { return bindings_; }
        void setEnum(string v) { enum_ = v; }
        void setVariant(string v) { variant_ = v; }
        void setIndex(int v) { index_ = v; }
        void setBody(AstStmt v) { body_ = v; }
        string enumName() { return enum_; }
        string variant() { return variant_; }
        int index() { return index_; }
        AstStmt body() { return body_; }
        string patKind() { return patKind_; }
        void setPatKind(string v) { patKind_ = v; }
        long litInt() { return litInt_; }
        void setLitInt(long v) { litInt_ = v; }
        string litStr() { return litStr_; }
        void setLitStr(string v) { litStr_ = v; }
        double litDbl() { return litDbl_; }
        void setLitDbl(double v) { litDbl_ = v; }
    property:
        string patKind_;
        string enum_;
        string variant_;
        int index_;
        ArrayList<string> bindings_;
        AstStmt body_;
        long litInt_;
        string litStr_;
        double litDbl_;
}

class AstCatch {
    action:
        @constructor AstCatch() { var_ = ""; type_ = ""; block_ = null; }
        void setVar(string v) { var_ = v; }
        void setType(string v) { type_ = v; }
        void setBlock(AstStmt v) { block_ = v; }
        string varName() { return var_; }
        string type() { return type_; }
        AstStmt block() { return block_; }
    property:
        string var_;
        string type_;
        AstStmt block_;
}

class AstDestructureTarget {
    action:
        @constructor AstDestructureTarget() {
            name_ = "";
            type_ = null;
            hasType_ = 0;
            elements_ = new ArrayList<AstDestructureTarget>();
        }
        ArrayList<AstDestructureTarget> elements() { return elements_; }
        void setName(string v) { name_ = v; }
        void setPos(int l, int c) { line_ = l; col_ = c; }
        void setType(AstType v) { type_ = v; }
        void setHasType(int v) { hasType_ = v; }
        void dump(StringBuilder sb, int ind) {
            if (elements_.size() != 0) {
                Dump.line(sb, ind, "(DestructureTarget)");
                for (int i = 0; i < elements_.size(); i = i + 1) elements_.get(i).dump(sb, ind + 2);
            } else {
                // C++ TypeNode 默认 Int：未显式类型时 dump "int"
                Dump.line(sb, ind, "(DestructureLeaf name=\"" + Dump.esc(name_) + "\" type=" + (type_ != null ? type_.str() : "int") + " hasType=" + hasType_ + ")");
            }
        }
        string name() { return name_; }
        int line() { return line_; }
        int col() { return col_; }
        AstType type() { return type_; }
        int hasType() { return hasType_; }
    property:
        string name_;
        int line_;
        int col_;
        AstType type_;
        int hasType_;
        ArrayList<AstDestructureTarget> elements_;
}

// ---- 表达式（扁平）----
class AstExpr {
    action:
        @constructor AstExpr() {
            kind_ = "";
            line_ = 0;
            col_ = 0;
            endLine_ = 0;
            endCol_ = 0;
            value_ = 0L;
            isLong_ = 0;
            isUnsigned_ = 0;
            isChar_ = 0;
            f32_ = 0;
            fval_ = 0.0;
            name_ = "";
            op_ = "";
            lhs_ = null;
            rhs_ = null;
            operand_ = null;
            toKind_ = "";
            bw_ = 0;
            callee_ = null;
            args_ = new ArrayList<AstExpr>();
            callTypeArgs_ = new ArrayList<AstType>();
            resolved_ = "";
            structType_ = "";
            structCtor_ = "";
            memberName_ = "";
            resolvedClass_ = "";
            valueClass_ = "";
            sliceElem_ = "";
            array_ = null;
            index_ = null;
            className_ = "";
            typeArgs_ = new ArrayList<AstType>();
            ctor_ = "";
            elemType_ = null;
            dimensions_ = new ArrayList<AstExpr>();
            condition_ = null;
            trueExpr_ = null;
            falseExpr_ = null;
            start_ = null;
            end_ = null;
            enumName_ = "";
            variantIndex_ = 0;
            params_ = new ArrayList<AstParam>();
            hiddenClass_ = "";
            captureNames_ = new ArrayList<string>();
            captureSlots_ = new ArrayList<string>();
            nonlocalCells_ = new ArrayList<string>();
            targetKind_ = "";
            classType_ = "";
            method_ = "transform";
            catchVarName_ = "";
            tryExpr_ = null;
            catchExpr_ = null;
            timeout_ = null;
            elements_ = new ArrayList<AstExpr>();
            initFields_ = new ArrayList<string>();
            namedName_ = "";
            namedValue_ = null;
            stmt_ = null;
            resultKind_ = "int";
            stringValue_ = "";
            bodyStmt_ = null;
            lhsUnsigned_ = 0;
            rhsUnsigned_ = 0;
            resultUnsigned_ = 0;
            opCall_ = 0;
            type_ = null;
            resolvedKind_ = "";
            argsVisited_ = 0;
            callParamTypes_ = null;
            callParamFuncSig_ = null;
        }
        void setType(AstType v) { type_ = v; }
        void setResolvedKind(string v) { resolvedKind_ = v; }
        void setArgsVisited(int v) { argsVisited_ = v; }
        ArrayList<AstExpr> args() { return args_; }
        ArrayList<AstType> callTypeArgs() { return callTypeArgs_; }
        ArrayList<AstType> typeArgs() { return typeArgs_; }
        ArrayList<AstExpr> dimensions() { return dimensions_; }
        ArrayList<AstParam> params() { return params_; }
        ArrayList<string> captureNames() { return captureNames_; }
        ArrayList<string> captureSlots() { return captureSlots_; }
        ArrayList<string> nonlocalCells() { return nonlocalCells_; }
        ArrayList<AstExpr> elements() { return elements_; }
        ArrayList<string> initFields() { return initFields_; }
        void setInitFields(ArrayList<string> v) { initFields_ = v; }
        void setArgs(ArrayList<AstExpr> v) { args_ = v; }
        void setCallTypeArgs(ArrayList<AstType> v) { callTypeArgs_ = v; }
        void setTypeArgs(ArrayList<AstType> v) { typeArgs_ = v; }
        void setDimensions(ArrayList<AstExpr> v) { dimensions_ = v; }
        void setParams(ArrayList<AstParam> v) { params_ = v; }
        void setCaptureNames(ArrayList<string> v) { captureNames_ = v; }
        void setCaptureSlots(ArrayList<string> v) { captureSlots_ = v; }
        void setNonlocalCells(ArrayList<string> v) { nonlocalCells_ = v; }
        void setElements(ArrayList<AstExpr> v) { elements_ = v; }
        void setKind(string v) { kind_ = v; }
        void setPos(int l, int c) { line_ = l; col_ = c; }
        string kindName() { return kind_; }
        string identifierName() { return name_; }
        string resolvedClassName() { return resolvedClass_; }
        string valueClassName() { return valueClass_; }
        void setEndPos(int l, int c) { endLine_ = l; endCol_ = c; }
        void setValue(long v) { value_ = v; }
        long integerValue() { return value_; }
        void setIsLong(int v) { isLong_ = v; }
        void setIsUnsigned(int v) { isUnsigned_ = v; }
        void setIsChar(int v) { isChar_ = v; }
        void setF32(int v) { f32_ = v; }
        void setFval(double v) { fval_ = v; }
        void setName(string v) { name_ = v; }
        void setOp(string v) { op_ = v; }
        void setLhs(AstExpr v) { lhs_ = v; }
        void setRhs(AstExpr v) { rhs_ = v; }
        void setOperand(AstExpr v) { operand_ = v; }
        void setToKind(string v) { toKind_ = v; }
        void setBw(int v) { bw_ = v; }
        void setCallee(AstExpr v) { callee_ = v; }
        void setResolved(string v) { resolved_ = v; }
        void setStructType(string v) { structType_ = v; }
        void setStructCtor(string v) { structCtor_ = v; }
        void setMemberName(string v) { memberName_ = v; }
        void setResolvedClass(string v) { resolvedClass_ = v; }
        void setValueClass(string v) { valueClass_ = v; }
        void setSliceElem(string v) { sliceElem_ = v; }
        void setArray(AstExpr v) { array_ = v; }
        void setIndex(AstExpr v) { index_ = v; }
        void setClassName(string v) { className_ = v; }
        void setCtor(string v) { ctor_ = v; }
        void setElemType(AstType v) { elemType_ = v; }
        void setCondition(AstExpr v) { condition_ = v; }
        void setTrueExpr(AstExpr v) { trueExpr_ = v; }
        void setFalseExpr(AstExpr v) { falseExpr_ = v; }
        void setStart(AstExpr v) { start_ = v; }
        void setEnd(AstExpr v) { end_ = v; }
        void setEnumName(string v) { enumName_ = v; }
        void setVariantIndex(int v) { variantIndex_ = v; }
        void setHiddenClass(string v) { hiddenClass_ = v; }
        void setTargetKind(string v) { targetKind_ = v; }
        void setClassType(string v) { classType_ = v; }
        void setMethod(string v) { method_ = v; }
        void setCatchVarName(string v) { catchVarName_ = v; }
        void setTryExpr(AstExpr v) { tryExpr_ = v; }
        void setCatchExpr(AstExpr v) { catchExpr_ = v; }
        void setTimeout(AstExpr v) { timeout_ = v; }
        void setNamedName(string v) { namedName_ = v; }
        void setNamedValue(AstExpr v) { namedValue_ = v; }
        void setStmt(AstStmt v) { stmt_ = v; }
        void setResultKind(string v) { resultKind_ = v; }
        void setStringValue(string v) { stringValue_ = v; }
        ArrayList<string> callParamTypes() { return callParamTypes_; }
        void setCallParamTypes(ArrayList<string> v) { callParamTypes_ = v; }
        // BUG-100：函数类型形参签名（每个元素为 [ret, param1, param2...]；非函数形参为 null）
        ArrayList<ArrayList<string>> callParamFuncSig() { return callParamFuncSig_; }
        void setCallParamFuncSig(ArrayList<ArrayList<string>> v) { callParamFuncSig_ = v; }
        void setBodyStmt(AstStmt v) { bodyStmt_ = v; }
        void setLhsUnsigned(int v) { lhsUnsigned_ = v; }
        void setRhsUnsigned(int v) { rhsUnsigned_ = v; }
        void setResultUnsigned(int v) { resultUnsigned_ = v; }
        void setOpCall(int v) { opCall_ = v; }
        // 浅克隆（复合赋值 desugar：lhs 在 Assign.lhs 与 Binary.lhs 出现两次，共享子节点）。
        AstExpr cloneExpr() {
            AstExpr c = new AstExpr();
            c.setKind(kind_);
            c.setPos(line_, col_);
            c.setEndPos(endLine_, endCol_);
            c.setValue(value_);
            c.setIsLong(isLong_);
            c.setIsUnsigned(isUnsigned_);
            c.setIsChar(isChar_);
            c.setF32(f32_);
            c.setFval(fval_);
            c.setName(name_);
            c.setOp(op_);
            c.setLhs(lhs_);
            c.setRhs(rhs_);
            c.setOperand(operand_);
            c.setToKind(toKind_);
            c.setBw(bw_);
            c.setCallee(callee_);
            c.setArgs(args_);
            c.setCallTypeArgs(callTypeArgs_);
            c.setResolved(resolved_);
            c.setStructType(structType_);
            c.setStructCtor(structCtor_);
            c.setMemberName(memberName_);
            c.setResolvedClass(resolvedClass_);
            c.setArray(array_);
            c.setIndex(index_);
            c.setClassName(className_);
            c.setTypeArgs(typeArgs_);
            c.setCtor(ctor_);
            c.setElemType(elemType_);
            c.setDimensions(dimensions_);
            c.setCondition(condition_);
            c.setTrueExpr(trueExpr_);
            c.setFalseExpr(falseExpr_);
            c.setStart(start_);
            c.setEnd(end_);
            c.setEnumName(enumName_);
            c.setVariantIndex(variantIndex_);
            c.setParams(params_);
            c.setHiddenClass(hiddenClass_);
            c.setCaptureNames(captureNames_);
            c.setCaptureSlots(captureSlots_);
            c.setNonlocalCells(nonlocalCells_);
            c.setTargetKind(targetKind_);
            c.setClassType(classType_);
            c.setMethod(method_);
            c.setCatchVarName(catchVarName_);
            c.setTryExpr(tryExpr_);
            c.setCatchExpr(catchExpr_);
            c.setTimeout(timeout_);
            c.setElements(elements_);
            c.setInitFields(initFields_);
            c.setNamedName(namedName_);
            c.setNamedValue(namedValue_);
            c.setStmt(stmt_);
            c.setResultKind(resultKind_);
            c.setStringValue(stringValue_);
            c.setBodyStmt(bodyStmt_);
            c.setLhsUnsigned(lhsUnsigned_);
            c.setRhsUnsigned(rhsUnsigned_);
            c.setResultUnsigned(resultUnsigned_);
            c.setOpCall(opCall_);
            return c;
        }
        // sema 模式：表达式行尾追加 " : <type>"。
        // 依赖 Sema 已设置 type_/resolvedKind_（AST 模式二者为空 → 无后缀）。
        string tsfx() {
            if (type_ != null) return " : " + type_.str();
            if (Str.len(resolvedKind_) != 0) return " : " + resolvedKind_;
            return "";
        }
        void dump(StringBuilder sb, int ind) {
            if (kind_ == "Integer") {
                Dump.line(sb, ind, "(Integer value=" + value_ + " long=" + isLong_ + " unsigned=" + isUnsigned_ + " char=" + isChar_ + ")" + tsfx());
            } else if (kind_ == "Float") {
                Dump.line(sb, ind, "(Float value=" + Fmt.g(fval_, 17) + " f32=" + f32_ + ")" + tsfx());
            } else if (kind_ == "Bool") {
                Dump.line(sb, ind, "(Bool value=" + (value_ != 0L ? 1 : 0) + ")" + tsfx());
            } else if (kind_ == "String") {
                Dump.line(sb, ind, "(String value=\"" + Dump.esc(stringValue_) + "\")" + tsfx());
            } else if (kind_ == "Null") {
                Dump.line(sb, ind, "(Null)" + tsfx());
            } else if (kind_ == "Identifier") {
                Dump.line(sb, ind, "(Identifier name=\"" + Dump.esc(name_) + "\")" + tsfx());
            } else if (kind_ == "This") {
                Dump.line(sb, ind, "(This)" + tsfx());
            } else if (kind_ == "Binary") {
                Dump.line(sb, ind, "(Binary op=" + op_ + " lhsUnsigned=" + lhsUnsigned_ + " rhsUnsigned=" + rhsUnsigned_ + " resultUnsigned=" + resultUnsigned_ + " opCall=" + opCall_ + ")" + tsfx());
                if (lhs_ != null) lhs_.dump(sb, ind + 2);
                if (rhs_ != null) rhs_.dump(sb, ind + 2);
            } else if (kind_ == "Unary") {
                Dump.line(sb, ind, "(Unary op=" + op_ + ")" + tsfx());
                if (operand_ != null) operand_.dump(sb, ind + 2);
            } else if (kind_ == "Convert") {
                Dump.line(sb, ind, "(Convert to=" + toKind_ + " bw=" + bw_ + ")" + tsfx());
                if (operand_ != null) operand_.dump(sb, ind + 2);
            } else if (kind_ == "Call") {
                Dump.line(sb, ind, "(Call typeArgs=[" + AstNode.joinTypes(callTypeArgs_) + "] resolved=\"" + Dump.esc(resolved_) + "\" structType=\"" + Dump.esc(structType_) + "\" structCtor=\"" + Dump.esc(structCtor_) + "\")" + tsfx());
                if (callee_ != null) callee_.dump(sb, ind + 2);
                for (int i = 0; i < args_.size(); i = i + 1) args_.get(i).dump(sb, ind + 2);
            } else if (kind_ == "Member") {
                Dump.line(sb, ind, "(Member name=\"" + Dump.esc(memberName_) + "\" resolvedClass=\"" + Dump.esc(resolvedClass_) + "\")" + tsfx());
                if (array_ != null) array_.dump(sb, ind + 2);
            } else if (kind_ == "Subscript") {
                Dump.line(sb, ind, "(Subscript)" + tsfx());
                if (array_ != null) array_.dump(sb, ind + 2);
                if (index_ != null) index_.dump(sb, ind + 2);
            } else if (kind_ == "New") {
                Dump.line(sb, ind, "(New class=\"" + Dump.esc(className_) + "\" typeArgs=[" + AstNode.joinTypes(typeArgs_) + "] ctor=\"" + Dump.esc(ctor_) + "\")" + tsfx());
                for (int i = 0; i < args_.size(); i = i + 1) args_.get(i).dump(sb, ind + 2);
            } else if (kind_ == "NewArray") {
                Dump.line(sb, ind, "(NewArray elem=" + (elemType_ != null ? elemType_.str() : "?") + ")" + tsfx());
                for (int i = 0; i < dimensions_.size(); i = i + 1) dimensions_.get(i).dump(sb, ind + 2);
            } else if (kind_ == "Assign") {
                Dump.line(sb, ind, "(Assign)" + tsfx());
                if (lhs_ != null) lhs_.dump(sb, ind + 2);
                if (rhs_ != null) rhs_.dump(sb, ind + 2);
            } else if (kind_ == "Ternary") {
                Dump.line(sb, ind, "(Ternary)" + tsfx());
                if (condition_ != null) condition_.dump(sb, ind + 2);
                if (trueExpr_ != null) trueExpr_.dump(sb, ind + 2);
                if (falseExpr_ != null) falseExpr_.dump(sb, ind + 2);
            } else if (kind_ == "Range") {
                Dump.line(sb, ind, "(Range)" + tsfx());
                if (start_ != null) start_.dump(sb, ind + 2);
                if (end_ != null) end_.dump(sb, ind + 2);
            } else if (kind_ == "EnumVariant") {
                Dump.line(sb, ind, "(EnumVariant enum=\"" + Dump.esc(enumName_) + "\" index=" + variantIndex_ + ")" + tsfx());
                for (int i = 0; i < args_.size(); i = i + 1) args_.get(i).dump(sb, ind + 2);
            } else if (kind_ == "Lambda") {
                Dump.line(sb, ind, "(Lambda name=\"" + Dump.esc(name_) + "\" hiddenClass=\"" + Dump.esc(hiddenClass_) + "\" captures=[" + Dump.joinList(captureNames_) + "] slots=[" + Dump.joinList(captureSlots_) + "] nonlocal=[" + Dump.joinList(nonlocalCells_) + "])" + tsfx());
                for (int i = 0; i < params_.size(); i = i + 1) params_.get(i).dump(sb, ind + 2);
                if (bodyStmt_ != null) bodyStmt_.dump(sb, ind + 2);
            } else if (kind_ == "Pipe") {
                Dump.line(sb, ind, "(Pipe target=\"" + Dump.esc(targetKind_) + "\" class=\"" + Dump.esc(classType_) + "\" method=\"" + Dump.esc(method_) + "\")" + tsfx());
                if (lhs_ != null) lhs_.dump(sb, ind + 2);
                if (rhs_ != null) rhs_.dump(sb, ind + 2);
            } else if (kind_ == "TryExpr") {
                Dump.line(sb, ind, "(TryExpr catchVar=\"" + Dump.esc(catchVarName_) + "\")" + tsfx());
                if (tryExpr_ != null) tryExpr_.dump(sb, ind + 2);
                if (catchExpr_ != null) catchExpr_.dump(sb, ind + 2);
            } else if (kind_ == "Await") {
                Dump.line(sb, ind, "(Await)" + tsfx());
                if (operand_ != null) operand_.dump(sb, ind + 2);
                if (timeout_ != null) timeout_.dump(sb, ind + 2);
            } else if (kind_ == "Tuple") {
                Dump.line(sb, ind, "(Tuple)" + tsfx());
                for (int i = 0; i < elements_.size(); i = i + 1) elements_.get(i).dump(sb, ind + 2);
            } else if (kind_ == "NamedArg") {
                Dump.line(sb, ind, "(NamedArg name=\"" + Dump.esc(namedName_) + "\")" + tsfx());
                if (namedValue_ != null) namedValue_.dump(sb, ind + 2);
            } else if (kind_ == "MacroParam") {
                Dump.line(sb, ind, "(MacroParam name=\"" + Dump.esc(name_) + "\")" + tsfx());
            } else if (kind_ == "Quote") {
                Dump.line(sb, ind, "(Quote)" + tsfx());
                if (bodyStmt_ != null) bodyStmt_.dump(sb, ind + 2);
            } else if (kind_ == "GpuReduceExpr") {
                Dump.line(sb, ind, "(GpuReduceExpr result=" + resultKind_ + ")" + tsfx());
                if (stmt_ != null) stmt_.dump(sb, ind + 2);
            } else if (kind_ == "StructLit") {
                // 结构体初始化器 Point{x:1, y:2}：className_=struct 名，initFields_/
                // elements_ 平行存字段名/初值表达式。
                Dump.line(sb, ind, "(StructLit type=\"" + Dump.esc(className_) + "\")" + tsfx());
                for (int si = 0; si < initFields_.size(); si = si + 1) {
                    Dump.line(sb, ind + 2, "(Field name=\"" + Dump.esc(initFields_.get(si)) + "\")");
                    if (si < elements_.size() && elements_.get(si) != null) elements_.get(si).dump(sb, ind + 4);
                }
            } else {
                Dump.line(sb, ind, "(Expr)" + tsfx());
            }
        }
        string kind() { return kind_; }
        int line() { return line_; }
        int col() { return col_; }
        int endLine() { return endLine_; }
        int endCol() { return endCol_; }
        long value() { return value_; }
        int isLong() { return isLong_; }
        int isUnsigned() { return isUnsigned_; }
        int isChar() { return isChar_; }
        int f32() { return f32_; }
        double fval() { return fval_; }
        string name() { return name_; }
        string op() { return op_; }
        AstExpr lhs() { return lhs_; }
        AstExpr rhs() { return rhs_; }
        AstExpr operand() { return operand_; }
        string toKind() { return toKind_; }
        int bw() { return bw_; }
        AstExpr callee() { return callee_; }
        string resolved() { return resolved_; }
        string structType() { return structType_; }
        string structCtor() { return structCtor_; }
        string memberName() { return memberName_; }
        string resolvedClass() { return resolvedClass_; }
        string valueClass() { return valueClass_; }
        string sliceElem() { return sliceElem_; }
        AstExpr array() { return array_; }
