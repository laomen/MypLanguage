// sema.myp — 语义分析（F4）：类型推断 + 符号表。
//
// 对拍基准: src/sema/sema.cpp + sema_expr.cpp（tools/selfhost/format.md §5）。
// sema 模式 = AST dump + 每个表达式行尾追加 " : <type>"。
// <type> 优先 expr.type（TypeNode → typeNodeToString），否则 resolved_kind
// （TypeKind → typeKindToString）。本实现用字符串 kind 名填充 resolvedKind_。

import collections;
import text;
import fmt;
import "./diag.myp";
import "./ast.myp";

ffi long myp_str_to_long(string s);

// ---- 作用域符号表 ----
class SymbolEntry {
    action:
        @constructor SymbolEntry(string n, string t) {
            name_ = n; type_ = t;
            elementType_ = "";
            elementClass_ = "";
            elementElem_ = "";
            className_ = "";
            concreteClass_ = "";
            funcRet_ = "";
                arraySize_ = -1;
            reassigned_ = 0;
            tupleTypes_ = new ArrayList<string>();
            funcParamTypes_ = new ArrayList<string>();
            instArgs_ = new ArrayList<string>();
        }
        void addTupleType(string t) { tupleTypes_.add(t); }
        void setElementType(string v) { elementType_ = v; }
        void setElementClass(string v) { elementClass_ = v; }
        void setElementElem(string v) { elementElem_ = v; }
        void setClassName(string v) { className_ = v; }
        void setConcreteClass(string v) { concreteClass_ = v; }
        void setReassigned(int v) { reassigned_ = v; }
        void setFuncRet(string v) { funcRet_ = v; }
        void addFuncParamType(string v) { funcParamTypes_.add(v); }
        ArrayList<string> functionParamTypes() { return funcParamTypes_; }
            void setArraySize(int v) { arraySize_ = v; }
        string kind() { return type_; }
        string elementKind() { return elementType_; }
        string elementClass() { return elementClass_; }
        string className() { return className_; }
        string concreteClass() { return concreteClass_; }
        int reassigned() { return reassigned_; }
        int arraySize() { return arraySize_; }
        void addInstArg(string v) { instArgs_.add(v); }
        string name() { return name_; }
        string type() { return type_; }
        string elementType() { return elementType_; }
        string elementElem() { return elementElem_; }
        string funcRet() { return funcRet_; }
        ArrayList<string> tupleTypes() { return tupleTypes_; }
        ArrayList<string> funcParamTypes() { return funcParamTypes_; }
        ArrayList<string> instArgs() { return instArgs_; }
    property:
        string name_;
        string type_;
        string elementType_;
        string elementClass_;
        string elementElem_;
        string className_;
        string concreteClass_;
        string funcRet_;
            int arraySize_;
            int reassigned_;
        ArrayList<string> tupleTypes_;
        ArrayList<string> funcParamTypes_;
        ArrayList<string> instArgs_;
}

// 类方法签名（静态查找用）。
class MethodSig {
    action:
        @constructor MethodSig(string c, string m, string r, int np, ArrayList<AstParam> ps, int cor, AstType rt) {
            cls_ = c; meth_ = m; ret_ = r; nparams_ = np; params_ = ps; coro_ = cor; retType_ = rt;
        }
        string cls() { return cls_; }
        string meth() { return meth_; }
        string ret() { return ret_; }
        void setRet(string r) { ret_ = r; }
        int nparams() { return nparams_; }
        ArrayList<AstParam> params() { return params_; }
        int coro() { return coro_; }
        AstType retType() { return retType_; }
    property:
        string cls_;
        string meth_;
        string ret_;
        int nparams_;
        ArrayList<AstParam> params_;
        int coro_;
        AstType retType_;
}

// 扁平符号表：enterScope 压入哨兵，leaveScope 用 remove 弹出本作用域声明与哨兵。
class SymbolTable {
    action:
        @constructor SymbolTable() {
            entries_ = new ArrayList<SymbolEntry>();
        }
        void enterScope() { entries_.add(new SymbolEntry("__scope__", "")); }
        void leaveScope() {
            while (entries_.size() > 0 && entries_.get(entries_.size() - 1).name() != "__scope__") {
                entries_.remove(entries_.size() - 1);
            }
            if (entries_.size() > 0) entries_.remove(entries_.size() - 1);
        }
        void declare(string name, string type) {
            entries_.add(new SymbolEntry(name, type));
        }
        // 函数类型变量：(int)->int f → type="function" + funcRet 记录返回类型
        void declareFunc(string name, string retKind, ArrayList<AstType> params) {
            SymbolEntry e = new SymbolEntry(name, "function");
            e.setFuncRet(retKind);
            for (int i = 0; i < params.size(); i = i + 1) e.addFuncParamType(TKind.typeKindOf(params.get(i)));
            entries_.add(e);
        }
        // 数组/切片变量：记录元素类型（供 Subscript 返回元素类型）。
        void declareElem(string name, string type, string elem) {
            SymbolEntry e = new SymbolEntry(name, type);
            e.setElementType(elem);
            entries_.add(e);
        }
            void declareFixedElem(string name, string elem, int size) {
                SymbolEntry e = new SymbolEntry(name, "array");
                e.setElementType(elem);
                e.setArraySize(size);
                entries_.add(e);
            }
        void declareFixedElemClass(string name, string elem, string elemCls, int size) {
            SymbolEntry e = new SymbolEntry(name, "array");
            e.setElementType(elem);
            e.setElementClass(elemCls);
            e.setArraySize(size);
            entries_.add(e);
        }
        void declareElemClass(string name, string type, string elem, string elemCls) {
            SymbolEntry e = new SymbolEntry(name, type);
            e.setElementType(elem);
            e.setElementClass(elemCls);
            entries_.add(e);
        }
        // 类实例变量：记录具体类名（供 Member 方法/属性解析）。
        void declareClass(string name, string type, string cls) {
            SymbolEntry e = new SymbolEntry(name, type);
            e.setClassName(cls);
            entries_.add(e);
        }
        // 接口变量：声明类型为接口，另记录具体实现类（B3，C++ var_class_map_ 镜像，
        // 作用域感知——符号表随 enterScope/leaveScope 弹出）。
        void declareClassConcrete(string name, string type, string cls, string concrete) {
            SymbolEntry e = new SymbolEntry(name, type);
            e.setClassName(cls);
            e.setConcreteClass(concrete);
            entries_.add(e);
        }
        void declareElemClass2(string name, string type, string elem, string elemCls, string elemElem) {
            SymbolEntry e = new SymbolEntry(name, type);
            e.setElementType(elem);
            e.setElementClass(elemCls);
            e.setElementElem(elemElem);
            entries_.add(e);
        }
        // 泛型类实例：记录实例类型参数（供泛型方法返回类型替换）
        void declareClassInst(string name, string type, string cls, ArrayList<AstType> targs) {
            SymbolEntry e = new SymbolEntry(name, type);
            e.setClassName(cls);
            for (int i = 0; i < targs.size(); i = i + 1) {
                AstType ta = targs.get(i);
                if (ta != null) {
                    string tn = ta.className();
                    if (Str.len(tn) == 0) tn = ta.basicName();
                    if (Str.len(tn) != 0) e.addInstArg(tn);
                    else e.addInstArg("int");
                } else {
                    e.addInstArg("int");
                }
            }
            entries_.add(e);
        }
        string lookupClass(string name) {
            for (int i = entries_.size() - 1; i >= 0; i = i - 1) {
                SymbolEntry en = entries_.get(i);
                if (en.name() == name) return en.className();
            }
            return "";
        }
        void declareTuple(string name, string type, ArrayList<AstType> tt) {
            SymbolEntry e = new SymbolEntry(name, type);
            for (int i = 0; i < tt.size(); i = i + 1) e.addTupleType(tt.get(i) != null ? TKind.typeKindOf(tt.get(i)) : "int");
            entries_.add(e);
        }
        string lookup(string name) {
            for (int i = entries_.size() - 1; i >= 0; i = i - 1) {
                if (entries_.get(i).name() == name) return entries_.get(i).type();
            }
            return "";
        }
        SymbolEntry lookupEntry(string name) {
            for (int i = entries_.size() - 1; i >= 0; i = i - 1) {
                if (entries_.get(i).name() == name) return entries_.get(i);
            }
            return null;
        }
        ArrayList<SymbolEntry> entries() { return entries_; }
    property:
        ArrayList<SymbolEntry> entries_;
}

// ---- 类型 kind 名（typeKindToString）----
@static class TKind {
    static:
        int isNumeric(string k) {
            if (k == "byte" || k == "short" || k == "int" || k == "long"
                || k == "ubyte" || k == "ushort" || k == "uint" || k == "ulong"
                || k == "char" || k == "float" || k == "double" || k == "float4"
                || k == "double2" || k == "int4") return 1;
            return 0;
        }
        // 数字提升（算术 numeric_common，对齐 C++ sema_expr.cpp）：
        // double>float>ulong>long>uint>int>ubyte/ushort→uint；byte/short 也 → int。
        // 注意：无 `l==r` 短路——byte+byte 提升为 int。三元用 ternaryCommon（见下）。
        string numericCommon(string l, string r) {
            if (l == "double" || r == "double") return "double";
            if (l == "float" || r == "float") return "float";
            if (l == "ulong" || r == "ulong") return "ulong";
            if (l == "long" || r == "long") return "long";
            if (l == "uint" || r == "uint") return "uint";
            if (l == "int" || r == "int") return "int";
            if (l == "ubyte" || r == "ubyte" || l == "ushort" || r == "ushort") return "uint";
            return "int";
        }
        // 三元提升（对齐 C++ commonNumericKind）：a==b → a；否则 b 可提升到 a → a，
        // a 可提升到 b → b（C++ promotes 关系，见下）。
        int promotesTo(string from, string to) {
            if (from == to) return 1;
            if (from == "byte")   return (to == "short" || to == "int" || to == "long" || to == "double") ? 1 : 0;
            if (from == "char")   return (to == "ubyte" || to == "ushort" || to == "uint" || to == "ulong" || to == "int" || to == "long" || to == "double") ? 1 : 0;
            if (from == "short")  return (to == "int" || to == "long" || to == "double") ? 1 : 0;
            if (from == "int")    return (to == "long" || to == "double") ? 1 : 0;
            if (from == "long")   return 0;
            if (from == "float")  return (to == "double") ? 1 : 0;
            if (from == "ubyte")  return (to == "ushort" || to == "uint" || to == "ulong" || to == "int" || to == "long" || to == "double") ? 1 : 0;
            if (from == "ushort") return (to == "uint" || to == "ulong" || to == "int" || to == "long" || to == "double") ? 1 : 0;
            if (from == "uint")   return (to == "ulong" || to == "long" || to == "double") ? 1 : 0;
            if (from == "ulong")  return 0;
            return 0;
        }
        string ternaryCommon(string a, string b) {
            if (a == b) return a;
            if (TKind.promotesTo(b, a) != 0) return a;
            if (TKind.promotesTo(a, b) != 0) return b;
            return "void";
        }
        // AstType → TypeKind 字符串（typeKindToString），供符号表/返回类型用。
        string typeKindOf(AstType t) {
            if (t == null) return "int";
            if (t.element() != null) return "array";
            if (t.className() == "slice") return "slice";
            if (Str.len(t.className()) != 0) return "class";
            if (t.funcReturn() != null) return "function";
            if (t.isTuple() != 0) return "tuple";
            if (t.genericParam() != 0) return "int";
            return t.basicName();
        }
        // 位运算/移位提升（与 numericCommon 相似但无 float/double）
        string numericBitCommon(string l, string r) {
            if (l == "ulong" || r == "ulong") return "ulong";
            if (l == "long" || r == "long") return "long";
            if (l == "uint" || r == "uint") return "uint";
            if (l == "ubyte" || r == "ubyte" || l == "ushort" || r == "ushort") return "uint";
            return "int";
        }
}

// ---- 语义分析 ----
class EvalVal {
    action:
        @constructor EvalVal() {
            kind_ = "int";
            ival_ = 0L;
            sval_ = "";
            stmts_ = new ArrayList<AstStmt>();
        }
        void setKind(string v) { kind_ = v; }
        void setIval(long v) { ival_ = v; }
        void setSval(string v) { sval_ = v; }
        string kind() { return kind_; }
        long ival() { return ival_; }
        string sval() { return sval_; }
        ArrayList<AstStmt> stmts() { return stmts_; }
    property:
        string kind_;            // "int" | "str" | "ast"
        long ival_;
        string sval_;
        ArrayList<AstStmt> stmts_;
}

class Sema {
    action:
        @constructor Sema(DiagEngine diag) {
            diag_ = diag;
            sym_ = new SymbolTable();
            classNames_ = new ArrayList<string>();
            classProps_ = new ArrayList<ArrayList<AstProp>>();
            classActions_ = new ArrayList<ArrayList<AstAction>>();
            classFuncs_ = new ArrayList<ArrayList<AstFunction>>();
            funcNames_ = new ArrayList<string>();
            funcRet_ = new ArrayList<AstType>();
            funcParams_ = new ArrayList<ArrayList<AstParam>>();
            intrNames_ = new ArrayList<string>();
            intrRets_ = new ArrayList<string>();
            methods_ = new ArrayList<MethodSig>();
            coroNames_ = new ArrayList<string>();
            curGeneric_ = new ArrayList<string>();
            interfaceNames_ = new ArrayList<string>();
            interfaceMethods_ = new ArrayList<MethodSig>();
            structNames_ = new ArrayList<string>();
            structProps_ = new ArrayList<ArrayList<AstProp>>();
            classIdx_ = new StrHashMap<int>();
            structIdx_ = new StrHashMap<int>();
            enumIdx_ = new StrHashMap<int>();
            ifaceIdx_ = new StrHashMap<int>();
            funcIdx_ = new StrHashMap<int>();
            methodSigIdx_ = new StrHashMap<int>();
            classTypeParams_ = new ArrayList<ArrayList<string>>();
            opSyms_ = new ArrayList<string>();
            opParams_ = new ArrayList<ArrayList<AstParam>>();
            opRets_ = new ArrayList<AstType>();
            opFuncNames_ = new ArrayList<string>();
            eventPairs_ = new ArrayList<string>();
            instDone_ = new ArrayList<string>();
            instNames_ = new ArrayList<string>();
            instTAs_ = new ArrayList<ArrayList<AstType>>();
            gsKeys_ = new ArrayList<string>();
            gsClasses_ = new ArrayList<string>();
            gsActions_ = new ArrayList<AstAction>();
            enumNames_ = new ArrayList<string>();
            enumVariants_ = new ArrayList<ArrayList<string>>();
            bitfieldNames_ = new ArrayList<string>();
            bitfieldFieldNames_ = new ArrayList<ArrayList<string>>();
            bitfieldFieldWidths_ = new ArrayList<ArrayList<int>>();
            threadVars_ = new ArrayList<string>();
            macroNames_ = new ArrayList<string>();
            macroParams_ = new ArrayList<ArrayList<string>>();
            macroBodies_ = new ArrayList<AstStmt>();
            pmFuncNames_ = new ArrayList<string>();
            pmFuncs_ = new ArrayList<AstFunction>();
            pmLocalNames_ = new ArrayList<string>();
            pmLocalVals_ = new ArrayList<EvalVal>();
            pmBreak_ = 0;
            pmContinue_ = 0;
            pmDepth_ = 0;
            evalDepth_ = 0;
            constValNames_ = new ArrayList<string>();
            constValVals_ = new ArrayList<EvalVal>();
            startupMethods_ = new ArrayList<string>();
            lambdaCounter_ = 0;
            cellCounter_ = 0;
            cellClassByTypeKey_ = new ArrayList<string>();
            cellClassByTypeVal_ = new ArrayList<string>();
            lambdaSelfName_ = "";
            lambdaSelfClass_ = "";
            currentClass_ = "";
            inClass_ = 0;
            inStruct_ = 0;
            inGpuFor_ = 0;
            inGpuKernel_ = 0;
            inMain_ = 0;
            currentRet_ = "";
            loopDepth_ = 0;
            inCoro_ = 0;
            currentMethodName_ = "";
            inDiscardStmt_ = 0;
            tu_ = null;
        }
        void addMethod(string c, string m, AstType r, int np, ArrayList<AstParam> ps, int cor) {
            methods_.add(new MethodSig(c, m, r != null ? typeToKind(r) : "void", np, ps, cor, r));
            string key = c + "." + m;
            if (methodSigIdx_.contains(key) == 0) methodSigIdx_.put(key, methods_.size() - 1);
        }
        // BUG-046 镜像：static 方法签名串（返回类型 + 参数类型 kind，数组含元素 kind）。
        // 同名 static 方法：签名相同保持历史静默合并；签名不同报错（C++ 用 TypeInfo
        // 相等性判定，这里用 kind 串等价）。
        string staticActionSig(AstAction a) {
            StringBuilder sb = new StringBuilder();
            sb.append(typeToKind(a.ret()));
            ArrayList<AstParam> ps = a.params();
            for (int pi = 0; pi < ps.size(); pi = pi + 1) {
                AstType pt = ps.get(pi).type();
                sb.append("|");
                sb.append(typeToKind(pt));
                if (pt != null && pt.element() != null) {
                    sb.append("[");
                    sb.append(typeToKind(pt.element()));
                    sb.append("]");
                }
            }
            return sb.toString();
        }
        // cls 的 function: 段是否含方法 meth（A2：外部 obj.f() 访问 function: 段
        // 方法应拒绝——function: 仅类内 this.f() 可调，镜像 C++ BUG-001 规则）。
        int isFuncSectionMethod(string cls, string meth) {
            if (tu_ == null || Str.len(cls) == 0) return 0;
            int ci = classIdx_.get(cls, -1);   // O(1)（P6 规模修复：cls 为 base 名，类索引=tu.classes 索引）
            if (ci < 0 || ci >= tu_.classes().size()) return 0;
            AstClass c = tu_.classes().get(ci);
            for (int j = 0; j < c.funcs().size(); j = j + 1) {
                if (c.funcs().get(j).name() == meth) return 1;
            }
            return 0;
        }
        // 方法返回类型的具体类名（非类返回空）
        string findMethodRetClass(string cls, string meth) {
            int mi = methodSigIdx_.get(cls + "." + meth, -1);   // O(1)（P6 规模修复）
            if (mi < 0) return "";
            MethodSig s = methods_.get(mi);
            AstType rt = s.retType();
            if (rt != null && Str.len(rt.className()) != 0) {
                if (rt.typeArgs().size() > 0) return instClassName(rt);
                return rt.className();
            }
            return "";
        }
        // 泛型类参数列表
        ArrayList<string> findClassTypeParams(string cls) {
            int ci = classIdx_.get(cls, -1);   // O(1)（P6 规模修复）
            if (ci < 0) return new ArrayList<string>();
            return classTypeParams_.get(ci);
        }
        // 方法返回 AstType
        AstType findMethodRetAst(string cls, string meth) {
            int mi = methodSigIdx_.get(cls + "." + meth, -1);   // O(1)
            if (mi < 0) return null;
            return methods_.get(mi).retType();
        }
        // 泛型方法返回类型替换：T → 实例类型参数（instArgs_）
        string substRet(string base, AstType rt, SymbolEntry en) {
            if (rt == null) return "int";
            string rn = rt.className();
            if (Str.len(rn) == 0) rn = rt.basicName();
            int idx = -1;
            ArrayList<string> tp = findClassTypeParams(base);
            for (int i = 0; i < tp.size(); i = i + 1) {
                string assocPrefix = tp.get(i) + "::";
                if (Str.len(rn) > Str.len(assocPrefix)
                    && Str.substring(rn, 0, Str.len(assocPrefix)) == assocPrefix
                    && en != null && i < en.instArgs().size()) {
                    return associatedTypeKind(en.instArgs().get(i) + "::" + Str.substring(rn, Str.len(assocPrefix), Str.len(rn)));
                }
                if (tp.get(i) == rn) { idx = i; break; }
            }
            if (idx >= 0 && en != null && idx < en.instArgs().size()) {
                return en.instArgs().get(idx);
            }
            return typeToKind(rt);
        }
        // 实例类名 → typeArgs（AstType 列表），供方法调用链的泛型返回替换
        ArrayList<AstType> findInstTypeArgs(string instName) {
            for (int i = 0; i < instNames_.size(); i = i + 1) {
                if (instNames_.get(i) == instName) return instTAs_.get(i);
            }
            return null;
        }
        // 泛型方法返回替换（用 AstType 列表，链式方法调用 t.m().get() 场景）
        string substRetAst(string base, AstType rt, ArrayList<AstType> targs) {
            if (rt == null) return "int";
            string rn = rt.className();
            if (Str.len(rn) == 0) rn = rt.basicName();
            ArrayList<string> tp = findClassTypeParams(base);
            for (int i = 0; i < tp.size(); i = i + 1) {
                string assocPrefix = tp.get(i) + "::";
                if (Str.len(rn) > Str.len(assocPrefix)
                    && Str.substring(rn, 0, Str.len(assocPrefix)) == assocPrefix
                    && i < targs.size()) {
                    AstType owner = targs.get(i);
                    string ownerName = Str.len(owner.className()) != 0 ? owner.className() : owner.basicName();
                    return associatedTypeKind(ownerName + "::" + Str.substring(rn, Str.len(assocPrefix), Str.len(rn)));
                }
                if (tp.get(i) == rn && i < targs.size()) {
                    AstType ta = targs.get(i);
                    if (Str.len(ta.className()) != 0) {
                        if (ta.typeArgs().size() > 0) return instClassName(ta);
                        return ta.className();
                    }
                    return ta.basicName();
                }
            }
            return typeToKind(rt);
        }
        // 类方法是否 @coro（调用返回协程句柄 long）
        int isMethodCoro(string cls, string meth) {
            int mi = methodSigIdx_.get(cls + "." + meth, -1);   // O(1)
            if (mi < 0) return 0;
            return methods_.get(mi).coro();
        }
        // 类方法形参列表（默认参数补全用）
        ArrayList<AstParam> findMethodParams(string cls, string meth) {
            int mi = methodSigIdx_.get(cls + "." + meth, -1);   // O(1)
            if (mi < 0) return null;
            return methods_.get(mi).params();
        }
        // 查找类方法返回类型（类名 + 方法名 + 参数个数）；未找到返回空。
        string findMethodRet(string cls, string meth, int np) {
            int mi = methodSigIdx_.get(cls + "." + meth, -1);   // O(1)
            if (mi < 0) return "";
            return methods_.get(mi).ret();
        }
        // 类中是否存在方法（区分方法 vs 属性）
        int hasMethod(string cls, string meth) {
            string key = cls + "." + meth;
            return methodSigIdx_.contains(key) != 0 ? 1 : 0;   // O(1)（P6 规模修复）
        }

        void addIntr(string name, string ret) {
            intrNames_.add(name);
            intrRets_.add(ret);
        }
        string intrRet(string name) {
            for (int i = 0; i < intrNames_.size(); i = i + 1) {
                if (intrNames_.get(i) == name) return intrRets_.get(i);
            }
            return "";
        }

        void registerIntrinsics() {
            addIntr("__myp_print_int", "void");
            addIntr("__myp_print_long", "void");
            addIntr("__myp_print", "void");
            addIntr("__myp_println", "void");
            addIntr("__myp_print_float", "void");
            addIntr("__myp_print_bool", "void");
            addIntr("__myp_now_ms", "long");
            addIntr("__myp_sleep_ms", "void");
            addIntr("__myp_term_width", "int");
            addIntr("__myp_term_height", "int");
            addIntr("__myp_strlen", "int");
            addIntr("__myp_chr", "string");
            addIntr("__myp_ord", "int");
            addIntr("__myp_charcode", "int");
            addIntr("__myp_type_id", "int");
            addIntr("__myp_type_name", "string");
            addIntr("__myp_timer_create", "int");
            addIntr("__myp_math_sqrt", "double");
            addIntr("__myp_math_abs", "double");
            addIntr("__myp_math_floor", "double");
            addIntr("__myp_math_ceil", "double");
