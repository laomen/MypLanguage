        // ---- M3 声明式宏展开（在符号收集之前运行）----
        int macroIndex(string name) {
            for (int i = 0; i < macroNames_.size(); i = i + 1) {
                if (macroNames_.get(i) == name) return i;
            }
            return -1;
        }

        void expandMacros(AstTU tu) {
            if (tu == null) return;
            for (int i = 0; i < tu.macros().size(); i = i + 1) {
                AstMacro m = tu.macros().get(i);
                macroNames_.add(m.name());
                macroParams_.add(m.params());
                macroBodies_.add(m.body());
            }
            // 收集 @macro 过程宏函数（M4）
            for (int i = 0; i < tu.functions().size(); i = i + 1) {
                AstFunction f = tu.functions().get(i);
                if (f.isMacro() != 0) {
                    pmFuncNames_.add(f.name());
                    pmFuncs_.add(f);
                }
            }
            // 展开顶层函数体（@macro 过程宏体不在此展开——其体内语句由编译期
            // 解释器求值，且深克隆会破坏共享子指针；生成代码的嵌套 M3 宏在
            // expandBlockStmts 内另行展开）
            for (int i = 0; i < tu.functions().size(); i = i + 1) {
                AstFunction f = tu.functions().get(i);
                if (f.isMacro() != 0) continue;
                if (f.body() != null) expandBlockStmts(f.body(), 0);
            }
            // 展开类方法/构造器体
            for (int ci = 0; ci < tu.classes().size(); ci = ci + 1) {
                AstClass c = tu.classes().get(ci);
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    AstAction a = c.actions().get(ai);
                    if (a.body() != null) expandBlockStmts(a.body(), 0);
                }
                for (int ai = 0; ai < c.staticActions().size(); ai = ai + 1) {
                    AstAction a = c.staticActions().get(ai);
                    if (a.body() != null) expandBlockStmts(a.body(), 0);
                }
                for (int fi = 0; fi < c.funcs().size(); fi = fi + 1) {
                    AstFunction f = c.funcs().get(fi);
                    if (f.body() != null) expandBlockStmts(f.body(), 0);
                }
            }
            // 展开 struct 方法体
            for (int si = 0; si < tu.structs().size(); si = si + 1) {
                AstStruct st = tu.structs().get(si);
                for (int fi = 0; fi < st.funcs().size(); fi = fi + 1) {
                    AstFunction f = st.funcs().get(fi);
                    if (f.body() != null) expandBlockStmts(f.body(), 0);
                }
            }
        }

        // 深克隆表达式并替换 $param（params/args 平行）。
        AstExpr deepCloneExpr(AstExpr e, ArrayList<string> params, ArrayList<AstExpr> args) {
            if (e == null) return null;
            if (e.kind() == "MacroParam") {
                for (int i = 0; i < params.size(); i = i + 1) {
                    if (i >= args.size()) break;
                    if (params.get(i) == e.name()) return deepCloneExpr(args.get(i), params, args);
                }
            }
            AstExpr c = e.cloneExpr();
            c.setLhs(deepCloneExpr(e.lhs(), params, args));
            c.setRhs(deepCloneExpr(e.rhs(), params, args));
            c.setOperand(deepCloneExpr(e.operand(), params, args));
            c.setCallee(deepCloneExpr(e.callee(), params, args));
            c.setArray(deepCloneExpr(e.array(), params, args));
            c.setIndex(deepCloneExpr(e.index(), params, args));
            c.setCondition(deepCloneExpr(e.condition(), params, args));
            c.setTrueExpr(deepCloneExpr(e.trueExpr(), params, args));
            c.setFalseExpr(deepCloneExpr(e.falseExpr(), params, args));
            c.setStart(deepCloneExpr(e.start(), params, args));
            c.setEnd(deepCloneExpr(e.end(), params, args));
            c.setTryExpr(deepCloneExpr(e.tryExpr(), params, args));
            c.setCatchExpr(deepCloneExpr(e.catchExpr(), params, args));
            c.setTimeout(deepCloneExpr(e.timeout(), params, args));
            c.setNamedValue(deepCloneExpr(e.namedValue(), params, args));
            ArrayList<AstExpr> na = new ArrayList<AstExpr>();
            for (int i = 0; i < e.args().size(); i = i + 1) na.add(deepCloneExpr(e.args().get(i), params, args));
            c.setArgs(na);
            ArrayList<AstExpr> nd = new ArrayList<AstExpr>();
            for (int i = 0; i < e.dimensions().size(); i = i + 1) nd.add(deepCloneExpr(e.dimensions().get(i), params, args));
            c.setDimensions(nd);
            ArrayList<AstExpr> nel = new ArrayList<AstExpr>();
            for (int i = 0; i < e.elements().size(); i = i + 1) nel.add(deepCloneExpr(e.elements().get(i), params, args));
            c.setElements(nel);
            return c;
        }

        // 深克隆语句并替换 $param。
        AstStmt deepCloneStmt(AstStmt s, ArrayList<string> params, ArrayList<AstExpr> args) {
            if (s == null) return null;
            AstStmt c = new AstStmt();
            c.setKind(s.kind());
            c.setPos(s.line(), s.col());
            c.setEndPos(s.endLine(), s.endCol());
            if (s.kind() == "Block") {
                for (int i = 0; i < s.bodyStmts().size(); i = i + 1) c.bodyStmts().add(deepCloneStmt(s.bodyStmts().get(i), params, args));
            } else if (s.kind() == "ExprStmt") {
                c.setExpr(deepCloneExpr(s.expr(), params, args));
            } else if (s.kind() == "If") {
                c.setCondition(deepCloneExpr(s.condition(), params, args));
                c.setThen(deepCloneStmt(s.then(), params, args));
                c.setElse(deepCloneStmt(s.elseBranch(), params, args));
            } else if (s.kind() == "While") {
                c.setCondition(deepCloneExpr(s.condition(), params, args));
                c.setBody(deepCloneStmt(s.body(), params, args));
            } else if (s.kind() == "For") {
                c.setInit(deepCloneStmt(s.init(), params, args));
                c.setCondition(deepCloneExpr(s.condition(), params, args));
                c.setStep(deepCloneExpr(s.step(), params, args));
                c.setBody(deepCloneStmt(s.body(), params, args));
                c.setParallel(s.parallel());
                c.setGpu(s.gpu());
                c.setStride(s.stride());
                c.setBlock(s.block());
                c.setStream(deepCloneExpr(s.stream(), params, args));
            } else if (s.kind() == "VarDecl") {
                for (int i = 0; i < s.decls().size(); i = i + 1) {
                    AstVar v = s.decls().get(i);
                    AstVar nv = new AstVar();
                    nv.setName(v.name());
                    nv.setType(v.type());
                    nv.setConst(v.isConst());
                    nv.setThread(v.thread());
                    nv.setThreadpool(v.threadpool());
                    nv.setInferred(v.isInferred());
                    nv.setInit(deepCloneExpr(v.init(), params, args));
                    c.decls().add(nv);
                }
            } else if (s.kind() == "Return") {
                c.setValue(deepCloneExpr(s.value(), params, args));
            } else if (s.kind() == "Await") {
                c.setExpr(deepCloneExpr(s.expr(), params, args));
                c.setTimeout(deepCloneExpr(s.timeout(), params, args));
            } else if (s.kind() == "Throw") {
                c.setExpr(deepCloneExpr(s.expr(), params, args));
            } else if (s.kind() == "Break" || s.kind() == "Continue") {
                // 无字段
            } else {
                // 其他语句：浅拷贝关键字段（宏体不常用）
                c.setExpr(deepCloneExpr(s.expr(), params, args));
                c.setCondition(deepCloneExpr(s.condition(), params, args));
                c.setBody(deepCloneStmt(s.body(), params, args));
            }
            return c;
        }

        // 递归展开块内宏调用（语句位置）。depth 限深。
        void expandBlockStmts(AstStmt block, int depth) {
            if (block == null || block.kind() != "Block") return;
            if (depth > 100) return;
            ArrayList<AstStmt> out = new ArrayList<AstStmt>();
            int changed = 0;
            for (int i = 0; i < block.bodyStmts().size(); i = i + 1) {
                AstStmt st = block.bodyStmts().get(i);
                // 递归展开嵌套块
                if (st != null) {
                    AstStmt b = st.body();
                    if (b != null) expandBlockStmts(b, depth + 1);
                    AstStmt t = st.then();
                    if (t != null) expandBlockStmts(t, depth + 1);
                    AstStmt el = st.elseBranch();
                    if (el != null) expandBlockStmts(el, depth + 1);
                }
                // 宏调用（语句位置）：name(args) → 展开
                int expanded = 0;
                if (st != null && st.kind() == "ExprStmt") {
                    AstExpr ex = st.expr();
                    if (ex != null && ex.kind() == "Call") {
                        AstExpr ca = ex.callee();
                        if (ca != null && ca.kind() == "Identifier") {
                            int mi = macroIndex(ca.name());
                            if (mi >= 0) {
                                AstStmt body = deepCloneStmt(macroBodies_.get(mi), macroParams_.get(mi), ex.args());
                                if (body != null && body.kind() == "Block") {
                                    for (int j = 0; j < body.bodyStmts().size(); j = j + 1) {
                                        out.add(body.bodyStmts().get(j));
                                    }
                                    expanded = 1;
                                }
                            } else {
                                // M4：过程宏调用 → 编译期求值生成语句
                                int pi = procMacroIndex(ca.name());
                                if (pi >= 0) {
                                    ArrayList<AstStmt> gen = evalProcMacro(pmFuncs_.get(pi), ex.args());
                                    if (gen != null) {
                                        // 生成代码中嵌套 M3 宏再展开
                                        AstStmt tmp = new AstStmt();
                                        tmp.setKind("Block");
                                        for (int j = 0; j < gen.size(); j = j + 1) tmp.bodyStmts().add(gen.get(j));
                                        expandBlockStmts(tmp, depth + 1);
                                        for (int j = 0; j < tmp.bodyStmts().size(); j = j + 1) {
                                            out.add(tmp.bodyStmts().get(j));
                                        }
                                        expanded = 1;
                                    }
                                }
                            }
                        }
                    }
                }
                if (expanded == 0) out.add(st);
                else changed = 1;
            }
            // 仅在确有展开时重建块；且用整体替换列表（setBodyStmts），绝不在
            // clear 后向同一槽位重放原指针 —— 那会触发 storeRef 的 release 旧
            // 值（恰为同一对象）→ 双重释放 → 内存损坏/崩溃。
            if (changed != 0) {
                block.setBodyStmts(out);
            }
        }

        // ---- M4 过程宏（@macro StmtList + quote{}）编译期求值 ----
        int procMacroIndex(string name) {
            for (int i = 0; i < pmFuncNames_.size(); i = i + 1) {
                if (pmFuncNames_.get(i) == name) return i;
            }
            return -1;
        }

        EvalVal pmFindLocal(string name) {
            for (int i = 0; i < pmLocalNames_.size(); i = i + 1) {
                if (pmLocalNames_.get(i) == name) return pmLocalVals_.get(i);
            }
            return null;
        }

        void pmSetLocal(string name, EvalVal v) {
            for (int i = 0; i < pmLocalNames_.size(); i = i + 1) {
                if (pmLocalNames_.get(i) == name) {
                    pmLocalVals_.set(i, v);
                    return;
                }
            }
            pmLocalNames_.add(name);
            pmLocalVals_.add(v);
        }

        // 深拷贝 ast 值（语句列表）——保证每个局部变量独占其列表，原地拼接
        // 不会污染别名（alias = out 语义）。
        EvalVal pmCloneAst(EvalVal v) {
            EvalVal nv = new EvalVal();
            nv.setKind("ast");
            for (int j = 0; j < v.stmts().size(); j = j + 1) nv.stmts().add(cloneStmtI(v.stmts().get(j)));
            return nv;
        }

        int pmToBool(EvalVal v) {
            if (v == null) return 0;
            if (v.kind() == "str") return 0;
            return v.ival() != 0 ? 1 : 0;
        }

        long pmEq(EvalVal a, EvalVal b) {
            if (a.kind() == "str" || b.kind() == "str") return (a.sval() == b.sval()) ? 1L : 0L;
            return (a.ival() == b.ival()) ? 1L : 0L;
        }

        // @eval 函数调用求值（编译期解释器）：查函数 → 限深 → 求实参 → 绑定
        // 形参 → 执行函数体 → 恢复调用者局部。与 C++ EvalInterpreter::evalCall
        // 对齐；深度超限报 "recursion depth exceeded"（eval_recursion 负例）。
        EvalVal evalCallI(AstExpr e) {
            AstExpr callee = e.callee();
            if (callee == null || callee.kind() != "Identifier") {
                diag_.error(e.line(), e.col(), "compile-time evaluation: can only call @eval functions");
                return null;
            }
            string fnName = callee.name();
            // 零参 const 调用：const K() → 返回已折叠的常量值（C++ const_values_）
            for (int ci = 0; ci < constValNames_.size(); ci = ci + 1) {
                if (constValNames_.get(ci) == fnName && e.args().size() == 0) {
                    return constValVals_.get(ci);
                }
            }
            AstFunction fn = null;
            if (tu_ != null) {
                for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                    AstFunction f = tu_.functions().get(i);
                    if (f.eval() != 0 && f.name() == fnName) { fn = f; break; }
                }
            }
            if (fn == null) {
                diag_.error(e.line(), e.col(), "compile-time evaluation: '" + fnName + "' is not an @eval function");
                return null;
            }
            if (e.args().size() != fn.params().size()) {
                diag_.error(e.line(), e.col(), "compile-time evaluation: wrong argument count for '" + fnName + "'");
                return null;
            }
            evalDepth_ = evalDepth_ + 1;
            if (evalDepth_ > 500) {
                evalDepth_ = evalDepth_ - 1;
                diag_.error(e.line(), e.col(), "compile-time evaluation: recursion depth exceeded in '" + fnName + "'");
                return null;
            }
            // 在调用者环境求实参（递归调用时调用者的局部仍可见）
            ArrayList<EvalVal> argVals = new ArrayList<EvalVal>();
            for (int i = 0; i < e.args().size(); i = i + 1) {
                EvalVal av = evalExprI(e.args().get(i));
                if (av == null) { evalDepth_ = evalDepth_ - 1; return null; }
                argVals.add(av);
            }
            // 保存调用者局部，绑定形参
            ArrayList<string> savedNames = pmLocalNames_;
            ArrayList<EvalVal> savedVals = pmLocalVals_;
            pmLocalNames_ = new ArrayList<string>();
            pmLocalVals_ = new ArrayList<EvalVal>();
            for (int i = 0; i < fn.params().size(); i = i + 1) {
                pmSetLocal(fn.params().get(i).name(), argVals.get(i));
            }
            int savedBreak = pmBreak_;
            int savedContinue = pmContinue_;
            pmBreak_ = 0;
            pmContinue_ = 0;
            EvalVal result = evalStmtI(fn.body());
            pmLocalNames_ = savedNames;
            pmLocalVals_ = savedVals;
            pmBreak_ = savedBreak;
            pmContinue_ = savedContinue;
            evalDepth_ = evalDepth_ - 1;
            return result;
        }

        // 编译期常量求值（C++ evaluateCompileTimeConstants 的 run()）：
        // 遍历 const 声明，求值初始表达式；成功则记录（供后续 @eval/const 用），
        // 失败（如 @eval 深度超限）已由 evalCallI 写入诊断。
        void runConstEval(AstTU tu) {
            if (tu == null) return;
            for (int i = 0; i < tu.functions().size(); i = i + 1) {
                AstFunction fn = tu.functions().get(i);
                if (fn.constDecl() == 0) continue;
                if (fn.body() == null || fn.body().bodyStmts().size() == 0) continue;
                AstStmt first = fn.body().bodyStmts().get(0);
                if (first == null || first.kind() != "Return") continue;
                if (first.value() == null) continue;
                pmLocalNames_ = new ArrayList<string>();
                pmLocalVals_ = new ArrayList<EvalVal>();
                EvalVal v = evalExprI(first.value());
                // 记录常量值（零参 const 调用 FIB10() 会命中；不可折叠的
                // 初始器保持运行时行为，跳过记录但保留已报诊断）。
                if (v != null) {
                    constValNames_.add(fn.name());
                    constValVals_.add(v);
                }
                if (diag_.errorCount() != 0) return;
            }
        }

        // 过程宏入口：编译期求值 @macro 函数体，返回生成的语句列表。
        ArrayList<AstStmt> evalProcMacro(AstFunction fn, ArrayList<AstExpr> args) {
            if (fn == null || fn.body() == null) return null;
            if (args.size() != fn.params().size()) return null;
            // 用全新列表替代 clear()：ArrayList.clear() 只把 cnt 置 0、不释放
            // 元素，后续 append 会向同一槽位重新 store 相同指针 → release 旧值
            // （恰是同一对象）→ 双重释放/悬垂指针。直接换新列表彻底避免。
            pmLocalNames_ = new ArrayList<string>();
            pmLocalVals_ = new ArrayList<EvalVal>();
            ArrayList<EvalVal> argVals = new ArrayList<EvalVal>();
            for (int i = 0; i < args.size(); i = i + 1) {
                EvalVal v = evalExprI(args.get(i));
                if (v == null) return null;
                argVals.add(v);
            }
            pmLocalNames_ = new ArrayList<string>();
            pmLocalVals_ = new ArrayList<EvalVal>();
            for (int i = 0; i < fn.params().size(); i = i + 1) {
                pmSetLocal(fn.params().get(i).name(), argVals.get(i));
            }
            int sb = pmBreak_;
            int sc = pmContinue_;
            pmBreak_ = 0;
            pmContinue_ = 0;
            EvalVal r = evalStmtI(fn.body());
            pmBreak_ = sb;
            pmContinue_ = sc;
            if (r == null || r.kind() != "ast") return null;
            return r.stmts();
        }

        // 表达式求值（编译期解释器子集）。
        EvalVal evalExprI(AstExpr e) {
            if (e == null) return null;
            string k = e.kind();
            if (k == "Integer") {
                EvalVal v = new EvalVal();
                v.setKind("int");
                v.setIval(e.value());
                return v;
            }
            if (k == "String") {
                EvalVal v = new EvalVal();
                v.setKind("str");
                v.setSval(e.stringValue());
                return v;
            }
            if (k == "Identifier") {
                EvalVal lv = pmFindLocal(e.name());
                if (lv != null) return lv;
                EvalVal v = new EvalVal();
                return v;
            }
            if (k == "Call") return evalCallI(e);
            if (k == "Quote") return evalQuoteI(e);
            if (k == "Binary") return evalBinaryI(e);
            if (k == "Assign") {
                // 注意：链式字段访问（e.lhs_.name_ / e.rhs_.lhs_.kind_）在 MYP
                // 会产生垃圾值 → 必须先拆成局部变量（自举编译器已知坑）。
                AstExpr lhsE = e.lhs();
                string tname = lhsE != null ? lhsE.name() : "";
                AstExpr rhsE = e.rhs();
                // 快路径：out = out + quote{...} —— 原地追加（避免 O(n²)）
                if (rhsE != null && rhsE.kind() == "Binary" && rhsE.op() == "+") {
                    AstExpr rhsL = rhsE.lhs();
                    if (rhsL != null && rhsL.kind() == "Identifier" && rhsL.name() == tname) {
                        EvalVal cur = pmFindLocal(tname);
                        if (cur != null && cur.kind() == "ast") {
                            EvalVal rhs = evalExprI(rhsE.rhs());
                            if (rhs != null && rhs.kind() == "ast") {
                                for (int j = 0; j < rhs.stmts().size(); j = j + 1) cur.stmts().add(rhs.stmts().get(j));
                                return cur;
                            }
                        }
                    }
                }
                EvalVal v = evalExprI(rhsE);
                if (v == null) return null;
                EvalVal stored = v;
                if (v.kind() == "ast") {
                    // 深拷贝，避免别名共享（alias = out 语义）
                    stored = pmCloneAst(v);
                }
                pmSetLocal(tname, stored);
                return stored;
            }
            if (k == "Unary") {
                EvalVal v = evalExprI(e.operand());
                if (v == null) return null;
                EvalVal r = new EvalVal();
                r.setKind("int");
                if (e.op() == "!") r.setIval((pmToBool(v) == 0) ? 1L : 0L);
                else r.setIval(-v.ival());
                return r;
            }
            EvalVal v = new EvalVal();
            return v;
        }

        EvalVal evalBinaryI(AstExpr b) {
            EvalVal l = evalExprI(b.lhs());
            EvalVal r = evalExprI(b.rhs());
            if (l == null || r == null) return null;
            if (b.op() == "+" && l.kind() == "ast" && r.kind() == "ast") {
                EvalVal out = new EvalVal();
                out.setKind("ast");
                for (int i = 0; i < l.stmts().size(); i = i + 1) out.stmts().add(cloneStmtI(l.stmts().get(i)));
                for (int i = 0; i < r.stmts().size(); i = i + 1) out.stmts().add(cloneStmtI(r.stmts().get(i)));
                return out;
            }
            if (b.op() == "+" && l.kind() == "str" && r.kind() == "str") {
                EvalVal out = new EvalVal();
                out.setKind("str");
                out.setSval(l.sval() + r.sval());
                return out;
            }
            EvalVal o = new EvalVal();
            o.setKind("int");
            if (b.op() == "==") o.setIval(pmEq(l, r));
            else if (b.op() == "!=") o.setIval((pmEq(l, r) == 0) ? 1L : 0L);
            else if (b.op() == "<") o.setIval((l.ival() < r.ival()) ? 1L : 0L);
            else if (b.op() == ">") o.setIval((l.ival() > r.ival()) ? 1L : 0L);
            else if (b.op() == "<=") o.setIval((l.ival() <= r.ival()) ? 1L : 0L);
            else if (b.op() == ">=") o.setIval((l.ival() >= r.ival()) ? 1L : 0L);
            else if (b.op() == "&&") o.setIval((pmToBool(l) != 0 && pmToBool(r) != 0) ? 1L : 0L);
            else if (b.op() == "||") o.setIval((pmToBool(l) != 0 || pmToBool(r) != 0) ? 1L : 0L);
            else if (b.op() == "+") o.setIval(l.ival() + r.ival());
            else if (b.op() == "-") o.setIval(l.ival() - r.ival());
            else if (b.op() == "*") o.setIval(l.ival() * r.ival());
            else if (b.op() == "/") o.setIval(l.ival() / r.ival());
            else if (b.op() == "%") o.setIval(l.ival() % r.ival());
            else if (b.op() == "&") o.setIval(l.ival() & r.ival());
            else if (b.op() == "|") o.setIval(l.ival() | r.ival());
            else if (b.op() == "^") o.setIval(l.ival() ^ r.ival());
            else if (b.op() == "<<") o.setIval(l.ival() << (r.ival() & 63));
            else if (b.op() == ">>") o.setIval(l.ival() >> (r.ival() & 63));
            else o.setIval(0L);
            return o;
        }

        // quote{...} → Ast 值（语句列表）。
        EvalVal evalQuoteI(AstExpr q) {
            EvalVal v = new EvalVal();
            v.setKind("ast");
            AstStmt body = q.bodyStmt();
            if (body != null && body.kind() == "Block") {
                for (int i = 0; i < body.bodyStmts().size(); i = i + 1) {
                    AstStmt st = body.bodyStmts().get(i);
                    // 语句位置 $x：Ast 值内联（链式字段访问需拆局部变量）
                    if (st != null && st.kind() == "ExprStmt") {
                        AstExpr stE = st.expr();
                        if (stE != null && stE.kind() == "MacroParam") {
                            EvalVal lv = pmFindLocal(stE.name());
                            if (lv != null && lv.kind() == "ast") {
                                for (int j = 0; j < lv.stmts().size(); j = j + 1) v.stmts().add(cloneStmtI(lv.stmts().get(j)));
                                continue;
                            }
                        }
                    }
                    v.stmts().add(cloneStmtI(st));
                }
            }
            return v;
        }

        // 语句深克隆 + $param 插值（M4 quote）。
        AstStmt cloneStmtI(AstStmt s) {
            if (s == null) return null;
            AstStmt c = new AstStmt();
            c.setKind(s.kind());
            c.setPos(s.line(), s.col());
            c.setEndPos(s.endLine(), s.endCol());
            if (s.kind() == "Block") {
                for (int i = 0; i < s.bodyStmts().size(); i = i + 1) c.bodyStmts().add(cloneStmtI(s.bodyStmts().get(i)));
            } else if (s.kind() == "ExprStmt") {
                c.setExpr(cloneExprI(s.expr()));
            } else if (s.kind() == "VarDecl") {
                for (int i = 0; i < s.decls().size(); i = i + 1) {
                    AstVar v = s.decls().get(i);
                    AstVar nv = new AstVar();
                    string nm = v.name();
                    // $name 变量名插值
                    if (Str.len(nm) > 0 && Str.startsWith(nm, "$") != 0) {
                        string key = Str.substring(nm, 1, Str.len(nm));
                        EvalVal lv = pmFindLocal(key);
                        if (lv != null && lv.kind() == "str") nm = lv.sval();
                        else nm = "__error__";
                    }
                    nv.setName(nm);
                    nv.setType(v.type());
                    nv.setConst(v.isConst());
                    nv.setThread(v.thread());
                    nv.setThreadpool(v.threadpool());
                    nv.setInferred(v.isInferred());
                    nv.setInit(cloneExprI(v.init()));
                    c.decls().add(nv);
                }
            } else if (s.kind() == "Return") {
                c.setValue(cloneExprI(s.value()));
            } else if (s.kind() == "If") {
                c.setCondition(cloneExprI(s.condition()));
                c.setThen(cloneStmtI(s.then()));
                c.setElse(cloneStmtI(s.elseBranch()));
            } else if (s.kind() == "While") {
                c.setCondition(cloneExprI(s.condition()));
                c.setBody(cloneStmtI(s.body()));
            } else if (s.kind() == "For") {
                c.setInit(cloneStmtI(s.init()));
                c.setCondition(cloneExprI(s.condition()));
                c.setStep(cloneExprI(s.step()));
                c.setBody(cloneStmtI(s.body()));
                c.setParallel(s.parallel());
                c.setGpu(s.gpu());
                c.setStride(s.stride());
                c.setBlock(s.block());
                c.setStream(cloneExprI(s.stream()));
            } else if (s.kind() == "Break" || s.kind() == "Continue") {
                // 无字段
            } else {
                c.setExpr(cloneExprI(s.expr()));
                c.setCondition(cloneExprI(s.condition()));
                c.setBody(cloneStmtI(s.body()));
            }
            return c;
        }

        // 表达式深克隆 + $param 插值（M4 quote）。
        AstExpr cloneExprI(AstExpr e) {
            if (e == null) return null;
            if (e.kind() == "MacroParam") {
                EvalVal lv = pmFindLocal(e.name());
                if (lv != null) {
                    if (lv.kind() == "int") {
                        AstExpr lit = new AstExpr();
                        lit.setKind("Integer");
                        lit.setValue(lv.ival());
                        lit.setPos(e.line(), e.col());
                        return lit;
                    }
                    if (lv.kind() == "str") {
                        AstExpr lit = new AstExpr();
                        lit.setKind("String");
                        lit.setStringValue(lv.sval());
                        lit.setPos(e.line(), e.col());
                        return lit;
                    }
                    if (lv.kind() == "ast") {
                        if (lv.stmts().size() == 1) {
                            AstStmt s0 = lv.stmts().get(0);
                            if (s0.kind() == "ExprStmt" && s0.expr() != null) return cloneExprI(s0.expr());
                        }
                    }
                }
                return e.cloneExpr();
            }
            AstExpr c = e.cloneExpr();
            c.setLhs(cloneExprI(e.lhs()));
            c.setRhs(cloneExprI(e.rhs()));
            c.setOperand(cloneExprI(e.operand()));
            c.setCallee(cloneExprI(e.callee()));
            c.setArray(cloneExprI(e.array()));
            c.setIndex(cloneExprI(e.index()));
            c.setCondition(cloneExprI(e.condition()));
            c.setTrueExpr(cloneExprI(e.trueExpr()));
            c.setFalseExpr(cloneExprI(e.falseExpr()));
            c.setStart(cloneExprI(e.start()));
            c.setEnd(cloneExprI(e.end()));
            c.setTryExpr(cloneExprI(e.tryExpr()));
            c.setCatchExpr(cloneExprI(e.catchExpr()));
            c.setTimeout(cloneExprI(e.timeout()));
            c.setNamedValue(cloneExprI(e.namedValue()));
            ArrayList<AstExpr> na = new ArrayList<AstExpr>();
            for (int i = 0; i < e.args().size(); i = i + 1) na.add(cloneExprI(e.args().get(i)));
            c.setArgs(na);
            ArrayList<AstExpr> nd = new ArrayList<AstExpr>();
            for (int i = 0; i < e.dimensions().size(); i = i + 1) nd.add(cloneExprI(e.dimensions().get(i)));
            c.setDimensions(nd);
            ArrayList<AstExpr> nel = new ArrayList<AstExpr>();
            for (int i = 0; i < e.elements().size(); i = i + 1) nel.add(cloneExprI(e.elements().get(i)));
            c.setElements(nel);
            return c;
        }

        // 语句解释器（返回 return/break/continue 信号）。
        EvalVal evalStmtI(AstStmt s) {
            if (s == null) return null;
            string k = s.kind();
            if (k == "Block") {
                for (int i = 0; i < s.bodyStmts().size(); i = i + 1) {
                    EvalVal r = evalStmtI(s.bodyStmts().get(i));
                    if (r != null) return r;
                }
                return null;
            }
            if (k == "VarDecl") {
                for (int i = 0; i < s.decls().size(); i = i + 1) {
                    AstVar d = s.decls().get(i);
                    if (d.init() != null) {
                        EvalVal v = evalExprI(d.init());
                        if (v == null) return null;
                        // ast 值声明时深拷贝：alias = out 各自独占列表
                        if (v.kind() == "ast") v = pmCloneAst(v);
                        pmSetLocal(d.name(), v);
                    } else {
                        pmSetLocal(d.name(), new EvalVal());
                    }
                }
                return null;
            }
            if (k == "ExprStmt") {
                if (s.expr() != null) {
                    if (evalExprI(s.expr()) == null) return null;
                }
                return null;
            }
            if (k == "Return") {
                if (s.value() == null) return new EvalVal();
                return evalExprI(s.value());
            }
            if (k == "If") {
                EvalVal c = evalExprI(s.condition());
                if (c == null) return null;
                if (pmToBool(c) != 0) {
                    if (s.then() != null) return evalStmtI(s.then());
                } else {
                    if (s.elseBranch() != null) return evalStmtI(s.elseBranch());
                }
                return null;
            }
            if (k == "While") {
                while (true) {
                    EvalVal c = evalExprI(s.condition());
                    if (c == null) return null;
                    if (pmToBool(c) == 0) break;
                    EvalVal r = evalStmtI(s.body());
                    if (r != null) {
                        if (pmBreak_ != 0) { pmBreak_ = 0; return null; }
                        if (pmContinue_ != 0) { pmContinue_ = 0; continue; }
                        return r;
                    }
                }
                return null;
            }
            if (k == "For") {
                if (s.init() != null) {
                    EvalVal r = evalStmtI(s.init());
                    if (r != null) return r;
                }
                while (true) {
                    if (s.condition() != null) {
                        EvalVal c = evalExprI(s.condition());
                        if (c == null) return null;
                        if (pmToBool(c) == 0) break;
                    }
                    EvalVal r = evalStmtI(s.body());
                    if (r != null) {
                        if (pmBreak_ != 0) { pmBreak_ = 0; break; }
                        if (pmContinue_ != 0) { pmContinue_ = 0; }
                        else return r;
                    }
                    if (s.step() != null) {
                        if (evalExprI(s.step()) == null) return null;
                    }
                }
                return null;
            }
            if (k == "Break") {
                pmBreak_ = 1;
                return new EvalVal();
            }
            if (k == "Continue") {
                pmContinue_ = 1;
                return new EvalVal();
            }
            return null;
        }

        void setAutoMain(int v) { autoMain_ = v; }

        // `myp_self run`：无 main 时注入合成 main（ClassName c = new ClassName(); c.startup(); return 0;）。
        // 移植自 C++ Sema::injectAutoMainIfNeeded。合成 main 带 autoMain 标志（豁免 main() 直接调用限制）。
        void injectAutoMainIfNeeded(AstTU tu) {
            // 用户已定义 main → 直接用，不注入
            for (int i = 0; i < tu.functions().size(); i = i + 1) {
                if (tu.functions().get(i).name() == "main") return;
            }
            // 收集带 @startup 的类（跳过泛型实例类）
            string clsName = "";
            string startupName = "";
            int count = 0;
            for (int ci = 0; ci < tu.classes().size(); ci = ci + 1) {
                AstClass cls = tu.classes().get(ci);
                if (cls.isGenericInst() != 0) continue;
                for (int ai = 0; ai < cls.actions().size(); ai = ai + 1) {
                    AstAction a = cls.actions().get(ai);
                    if (a.startup() != 0) {
                        clsName = cls.name();
                        startupName = a.name();
                        count = count + 1;
                        break;
                    }
                }
            }
            if (count == 0) {
                diag_.error(0, 0, "run: 无 'main' 函数且无带 '@startup' 注解的类——请定义 main() 或给类 action 加 '@startup' 注解");
                return;
            }
            if (count > 1) {
                diag_.error(0, 0, "run: 无 'main' 函数但有多个类带 '@startup'——请显式定义 main()");
                return;
            }

            // ClassName c = new ClassName();
            AstType clsType = new AstType();
            clsType.setClassName(clsName);
            AstExpr newExpr = new AstExpr();
            newExpr.setKind("New");
            newExpr.setClassName(clsName);
            AstVar vd = new AstVar();
            vd.setName("c");
            vd.setType(clsType);
            vd.setInit(newExpr);
            AstStmt vds = new AstStmt();
            vds.setKind("VarDecl");
            vds.decls().add(vd);

            // c.startupAction();
            AstExpr id = new AstExpr();
            id.setKind("Identifier");
            id.setName("c");
            AstExpr ma = new AstExpr();
            ma.setKind("Member");
            ma.setArray(id);
            ma.setMemberName(startupName);
            AstExpr call = new AstExpr();
            call.setKind("Call");
            call.setCallee(ma);
            AstStmt es = new AstStmt();
            es.setKind("ExprStmt");
            es.setExpr(call);

            // return 0;
            AstExpr zero = new AstExpr();
            zero.setKind("Integer");
            zero.setValue(0L);
            AstStmt ret = new AstStmt();
            ret.setKind("Return");
            ret.setValue(zero);

            AstStmt blk = new AstStmt();
            blk.setKind("Block");
            blk.bodyStmts().add(vds);
            blk.bodyStmts().add(es);
            blk.bodyStmts().add(ret);

            AstFunction mainDecl = new AstFunction();
            mainDecl.setName("main");
            AstType retT = new AstType();
            retT.setBasicName("int");
            mainDecl.setRet(retT);
            mainDecl.setAutoMain(1);
            mainDecl.setBody(blk);
            tu.functions().add(mainDecl);
        }

        void analyze(AstTU tu) {
            tu_ = tu;
            registerIntrinsics();
            if (autoMain_ != 0) injectAutoMainIfNeeded(tu);
            // Pass 0：递归 type alias 检测（type A = A / type A = B, B = A）。
            // 沿别名链走，重复命中即递归（内建/类名/数组元素/类型参数终止）。
            for (int ti = 0; ti < tu.typeAliases().size(); ti = ti + 1) {
                AstTypeAlias ta = tu.typeAliases().get(ti);
                string nm = ta.name();
                ArrayList<string> seen = new ArrayList<string>();
                seen.add(nm);
                AstType cur = ta.type();
                int guard = 0;
                while (cur != null && guard < 128) {
                    guard = guard + 1;
                    string cn = "";
                    if (cur.element() != null) {
                        cur = cur.element();
                        continue;
                    }
                    cn = cur.className();
                    if (Str.len(cn) == 0) break;
                    int isAlias = 0;
                    for (int aj = 0; aj < tu.typeAliases().size(); aj = aj + 1) {
                        if (tu.typeAliases().get(aj).name() == cn) { isAlias = 1; break; }
                    }
                    if (isAlias == 0) break;
                    int hit = 0;
                    for (int sj = 0; sj < seen.size(); sj = sj + 1) {
                        if (seen.get(sj) == cn) { hit = 1; break; }
                    }
                    if (hit != 0) {
                        diag_.error(0, 0, "recursive type alias '" + nm + "'");
                        break;
                    }
                    seen.add(cn);
                    AstType next = null;
                    for (int aj = 0; aj < tu.typeAliases().size(); aj = aj + 1) {
                        if (tu.typeAliases().get(aj).name() == cn) { next = tu.typeAliases().get(aj).type(); break; }
                    }
                    cur = next;
                }
            }
            // Pass 0.5：编译期常量求值（@eval / const folding）。深度超限等错误
            // 由 evalCallI 写入诊断（eval_recursion 负例）。
            runConstEval(tu);
            for (int bi = 0; bi < tu.bitfields().size(); bi = bi + 1) {
                AstBitfield bf = tu.bitfields().get(bi);
                bitfieldNames_.add(bf.name());
                ArrayList<string> names = new ArrayList<string>();
                ArrayList<int> widths = new ArrayList<int>();
                for (int fi = 0; fi < bf.fields().size(); fi = fi + 1) {
                    AstBitfieldField field = bf.fields().get(fi);
                    names.add(field.name());
                    widths.add(field.width());
                }
                bitfieldFieldNames_.add(names);
                bitfieldFieldWidths_.add(widths);
            }
            // 收集 struct（须在类/方法收集前，使 typeToKind 能识别 struct 返回类型）
            for (int si = 0; si < tu.structs().size(); si = si + 1) {
                AstStruct st = tu.structs().get(si);
                structNames_.add(st.name());
                structProps_.add(st.props());
                if (structIdx_.contains(st.name()) == 0) structIdx_.put(st.name(), structNames_.size() - 1);
                for (int pi = 0; pi < st.props().size(); pi = pi + 1) {
                    AstProp prop = st.props().get(pi);
                    AstType embedded = prop.type();
                    while (embedded != null && embedded.element() != null) embedded = embedded.element();
                    if (embedded != null && embedded.className() == st.name()) {
                        diag_.error(st.line(), st.col(), "recursive struct definition (infinite size): '"
                            + st.name() + "' is embedded by value in a cycle");
                    }
                    for (int pj = 0; pj < pi; pj = pj + 1) {
                        if (st.props().get(pj).name() == prop.name()) {
                            diag_.error(prop.line(), prop.col(), "duplicate field '" + prop.name()
                                + "' in struct '" + st.name() + "'");
                            break;
                        }
                    }
                    if (prop.init() != null) markAllExpr(prop.init());
                }
                // 收集 struct 方法（findMethodRet 需要）
                ArrayList<AstFunction> sfuncs = st.funcs();
                for (int sfj = 0; sfj < sfuncs.size(); sfj = sfj + 1) {
                    AstFunction f = sfuncs.get(sfj);
                    funcNames_.add(f.name());
                    funcRet_.add(f.ret());
                    funcParams_.add(f.params());
                    if (funcIdx_.contains(f.name()) == 0) funcIdx_.put(f.name(), funcNames_.size() - 1);
                    if (f.coro() != 0) coroNames_.add(f.name());
                    methods_.add(new MethodSig(st.name(), f.name(), f.ret() != null ? typeToKind(f.ret()) : "void", f.params().size(), f.params(), f.coro() != 0 ? 1 : 0, f.ret()));
                    string mkey = st.name() + "." + f.name();
                    if (methodSigIdx_.contains(mkey) == 0) methodSigIdx_.put(mkey, methods_.size() - 1);
                }
            }
            // 收集类内嵌套 struct（B4：Sensor::Config 以裸名 Config 注册）。须在
            // 顶层函数/测试体访问前完成——否则测试里 Sensor::Config c; 解析为 void。
            for (int nci = 0; nci < tu.classes().size(); nci = nci + 1) {
                AstClass ncl = tu.classes().get(nci);
                if (ncl.isGenericInst() != 0) continue;
                for (int nsi = 0; nsi < ncl.structs().size(); nsi = nsi + 1) {
                    AstStruct nst = ncl.structs().get(nsi);
                    int known2 = 0;
                    for (int k = 0; k < structNames_.size(); k = k + 1) {
                        if (structNames_.get(k) == nst.name()) { known2 = 1; break; }
                    }
                    if (known2 == 0) {
                        structNames_.add(nst.name());
                        structProps_.add(nst.props());
                        if (structIdx_.contains(nst.name()) == 0) structIdx_.put(nst.name(), structNames_.size() - 1);
                    }
                }
            }
            // 收集接口（方法签名）
            for (int ii = 0; ii < tu.interfaces().size(); ii = ii + 1) {
                AstInterface ifc = tu.interfaces().get(ii);
                interfaceNames_.add(ifc.name());
                if (ifaceIdx_.contains(ifc.name()) == 0) ifaceIdx_.put(ifc.name(), interfaceNames_.size() - 1);
                ArrayList<AstAction> iacts = ifc.actions();
                for (int j2 = 0; j2 < iacts.size(); j2 = j2 + 1) {
                    AstAction a2 = iacts.get(j2);
                    interfaceMethods_.add(new MethodSig(ifc.name(), a2.name(), a2.ret() != null ? typeToKind(a2.ret()) : "void", a2.params().size(), a2.params(), 0, a2.ret()));
                    // C++ 不类型检查接口默认体（保持默认 Int）→ 整树标 int
                    if (a2.body() != null) markAllStmt(a2.body());
                }
            }
            // C++ checkInterfaceImpl：实现 interface class 的类须实现接口无默认体 action。
            for (int ci = 0; ci < tu.classes().size(); ci = ci + 1) {
                AstClass cl = tu.classes().get(ci);
                if (Str.len(cl.iface()) == 0) continue;
                AstInterface implIface = null;
                for (int ii2 = 0; ii2 < tu.interfaces().size(); ii2 = ii2 + 1) {
                    if (tu.interfaces().get(ii2).name() == cl.iface()) { implIface = tu.interfaces().get(ii2); break; }
                }
                if (implIface == null) {
                    diag_.error(cl.line(), cl.col(), "interface '" + cl.iface() + "' not found");
                    continue;
                }
                ArrayList<AstAction> iacts2 = implIface.actions();
                for (int ji = 0; ji < iacts2.size(); ji = ji + 1) {
                    AstAction ia2 = iacts2.get(ji);
                    if (ia2.body() != null) continue;  // 默认实现 → 可省略
                    // BUG-008 镜像 C++：接口签名含关联类型 → 只按名称匹配；
                    // 否则按名称 + 返回类型 + 参数列表精确匹配。
                    int usesAssoc = 0;
                    AstType iaRet2 = ia2.ret();
                    if (iaRet2 != null && typeToKind(iaRet2) == "assoc") usesAssoc = 1;
                    if (usesAssoc == 0) {
                        ArrayList<AstParam> iap2 = ia2.params();
                        for (int q = 0; q < iap2.size(); q = q + 1) {
                            AstType qp = iap2.get(q).type();
                            if (qp != null && typeToKind(qp) == "assoc") { usesAssoc = 1; break; }
                        }
                    }
                    int foundImpl = 0;
                    // 类 action 匹配
                    ArrayList<AstAction> clActs = cl.actions();
                    for (int ka = 0; ka < clActs.size(); ka = ka + 1) {
                        AstAction ca2 = clActs.get(ka);
                        if (ca2.name() != ia2.name()) continue;
                        if (usesAssoc == 0) {
                            string cr2 = ca2.ret() != null ? typeToKind(ca2.ret()) : "";
                            string ir2 = iaRet2 != null ? typeToKind(iaRet2) : "";
                            if (cr2 != ir2) continue;
                            ArrayList<AstParam> cp2 = ca2.params();
                            if (cp2.size() != ia2.params().size()) continue;
                            int pm = 1;
                            for (int q = 0; q < cp2.size(); q = q + 1) {
                                AstType cqt = cp2.get(q).type();
                                AstType iqt = ia2.params().get(q).type();
                                string cqk = cqt != null ? typeToKind(cqt) : "";
                                string iqk = iqt != null ? typeToKind(iqt) : "";
                                if (cqk != iqk) { pm = 0; break; }
                            }
                            if (pm == 0) continue;
                        }
                        foundImpl = 1;
                        break;
                    }
                    if (foundImpl == 0) {
                        ArrayList<AstAction> clStatics = cl.staticActions();
                        for (int kb = 0; kb < clStatics.size(); kb = kb + 1) {
                            AstAction cs2 = clStatics.get(kb);
                            if (cs2.name() != ia2.name()) continue;
                            if (usesAssoc == 0) {
                                string csr2 = cs2.ret() != null ? typeToKind(cs2.ret()) : "";
                                string ir2b = iaRet2 != null ? typeToKind(iaRet2) : "";
                                if (csr2 != ir2b) continue;
                                ArrayList<AstParam> csp2 = cs2.params();
                                if (csp2.size() != ia2.params().size()) continue;
                                int pm2 = 1;
                                for (int q = 0; q < csp2.size(); q = q + 1) {
                                    AstType cqt = csp2.get(q).type();
                                    AstType iqt = ia2.params().get(q).type();
                                    string cqk = cqt != null ? typeToKind(cqt) : "";
                                    string iqk = iqt != null ? typeToKind(iqt) : "";
                                    if (cqk != iqk) { pm2 = 0; break; }
                                }
                                if (pm2 == 0) continue;
                            }
                            foundImpl = 1;
                            break;
                        }
                    }
                    if (foundImpl == 0) {
                        diag_.error(cl.line(), cl.col(), "class '" + cl.name() + "' does not implement action '"
                            + ia2.name() + "' from interface '" + implIface.name() + "'");
                    }
                }
                // 关联类型绑定校验（C++ checkInterfaceImpl）：接口声明 type Item → 类必须绑定。
                ArrayList<string> ifaceAssocs = implIface.assocTypeDecls();
                for (int ja = 0; ja < ifaceAssocs.size(); ja = ja + 1) {
                    string atName = ifaceAssocs.get(ja);
                    int bound = 0;
                    ArrayList<AstPair> clAssocs = cl.assocTypes();
                    for (int kb = 0; kb < clAssocs.size(); kb = kb + 1) {
                        if (clAssocs.get(kb).k() == atName) { bound = 1; break; }
                    }
                    if (bound == 0) {
                        diag_.error(cl.line(), cl.col(), "class '" + cl.name() + "' does not bind associated type '"
                            + atName + "' from interface '" + implIface.name() + "' (add `type " + atName + " = ...;`)");
                    }
                }
            }
            // 收集 enum（变体访问解析）
            for (int ei = 0; ei < tu.enums().size(); ei = ei + 1) {
                AstEnum en = tu.enums().get(ei);
                for (int ej = 0; ej < enumNames_.size(); ej = ej + 1) {
                    if (enumNames_.get(ej) == en.name()) {
                        diag_.error(en.line(), en.col(), "duplicate enum name '" + en.name() + "'");
                        break;
                    }
                }
                enumNames_.add(en.name());
                if (enumIdx_.contains(en.name()) == 0) enumIdx_.put(en.name(), enumNames_.size() - 1);
                ArrayList<string> vs = new ArrayList<string>();
                ArrayList<AstEnumVariant> vv = en.variants();
                for (int vi = 0; vi < vv.size(); vi = vi + 1) vs.add(vv.get(vi).name());
                enumVariants_.add(vs);
            }
            // 收集类：第一遍只收类名/属性（使 addMethod 的 typeToKind 能看到全部类）
            for (int i = 0; i < tu.classes().size(); i = i + 1) {
                AstClass c = tu.classes().get(i);
                for (int cj = 0; cj < classNames_.size(); cj = cj + 1) {
                    if (classNames_.get(cj) == c.name()) {
                        diag_.error(c.line(), c.col(), "duplicate class name '" + c.name() + "'");
                        break;
                    }
                }
                classTypeParams_.add(c.typeParams());
                classNames_.add(c.name());
                if (classIdx_.contains(c.name()) == 0) classIdx_.put(c.name(), classNames_.size() - 1);
                classProps_.add(c.props());
                classActions_.add(c.actions());
                classFuncs_.add(c.funcs());
            }
            // struct 方法收集在类收集之前（typeToKind 识别 struct 返回需要），
            // 但此时 classNames_ 为空 → ArrayList<int> 等泛型类返回类型被误判
            // void。类名收集完后重刷 struct 方法签名（仅覆盖 ret kind，形参不变）。
            for (int si = 0; si < tu.structs().size(); si = si + 1) {
                AstStruct st = tu.structs().get(si);
                for (int sfj = 0; sfj < st.funcs().size(); sfj = sfj + 1) {
                    AstFunction f = st.funcs().get(sfj);
                    for (int mi = 0; mi < methods_.size(); mi = mi + 1) {
                        MethodSig ms = methods_.get(mi);
                        if (ms.cls() == st.name() && ms.meth() == f.name()) {
                            ms.setRet(f.ret() != null ? typeToKind(f.ret()) : "void");
                            break;
                        }
                    }
                }
            }
            for (int i = 0; i < tu.classes().size(); i = i + 1) {
                AstClass c = tu.classes().get(i);
                for (int pi = 0; pi < c.props().size(); pi = pi + 1) {
                    AstProp prop = c.props().get(pi);
                    if (prop.weak() != 0) {
                        string weakKind = typeToKind(prop.type());
                        if (weakKind != "class" && weakKind != "interface") {
                            diag_.error(prop.line(), prop.col(), "@weak property '" + prop.name()
                                + "' must be a class or interface reference type");
                        }
                        if (prop.isConst() != 0) {
                            diag_.error(prop.line(), prop.col(), "@weak property '" + prop.name()
                                + "' cannot also be const");
                        }
                    }
                }
            }
            for (int i = 0; i < tu.classes().size(); i = i + 1) {
                AstClass c = tu.classes().get(i);
                curGeneric_.clear();
                ArrayList<string> ctp = c.typeParams();
                for (int gi = 0; gi < ctp.size(); gi = gi + 1) curGeneric_.add(ctp.get(gi));
                // 收集方法签名（静态方法优先，含泛型）
                // BUG-009 镜像 C++：一个类最多一个 @startup（@thread 取最后一个、
                // myp_self run 取第一个，多个行为不一致 → 诊断）。
                string firstStartup = "";
                for (int j = 0; j < c.actions().size(); j = j + 1) {
                    AstAction a = c.actions().get(j);
                    if (a.ctor() != 0) {
                        if (a.startup() != 0)
                            diag_.error(a.line(), a.col(), "cannot be both @constructor and @startup");
                        if (a.name() != c.name())
                            diag_.error(a.line(), a.col(), "constructor name '" + a.name() + "' must match class name '" + c.name() + "'");
                        if (typeToKind(a.ret()) != "void")
                            diag_.error(a.line(), a.col(), "constructor '" + a.name() + "' must have void return type");
                    }
                    addMethod(c.name(), a.name(), a.ret(), a.params().size(), a.params(), a.coro());
                    for (int pi = 0; pi < a.params().size(); pi = pi + 1) {
                        AstExpr defaultExpr = a.params().get(pi).defaultExpression();
                        if (defaultExpr != null) markAllExpr(defaultExpr);
                    }
                    if (a.startup() != 0) {
                        if (Str.len(firstStartup) == 0) firstStartup = a.name();
                        else {
                            diag_.error(a.line(), a.col(), "class '" + c.name() + "' declares multiple '@startup' actions ('" + firstStartup + "' and '" + a.name() + "') — at most one @startup per class");
                        }
                        startupMethods_.add(c.name() + "." + a.name());
                    }
                }
                for (int j = 0; j < c.staticActions().size(); j = j + 1) {
                    AstAction a = c.staticActions().get(j);
                    // BUG-046 镜像：同名 static 方法——签名不同才报错（签名相同
                    // 保持历史静默合并，如 cuda.myp Vectors 的 CPU/GPU 版 max/min）。
                    if (a.typeParams().size() == 0) {
                        string sigA = staticActionSig(a);
                        for (int pj = 0; pj < j; pj = pj + 1) {
                            AstAction prev = c.staticActions().get(pj);
                            if (prev.typeParams().size() != 0 || prev.name() != a.name()) continue;
                            if (staticActionSig(prev) != sigA) {
                                diag_.error(a.line(), a.col(), "duplicate static action '" + a.name()
                                    + "' in class '" + c.name() + "' (different signature)");
                                break;
                            }
                        }
                    }
                    addMethod(c.name(), a.name(), a.ret(), a.params().size(), a.params(), a.coro());
                    // F4-G1：登记泛型静态方法模板（Class.method → 模板 AstAction）
                    if (a.typeParams().size() > 0) {
                        gsKeys_.add(c.name() + "." + a.name());
                        gsClasses_.add(c.name());
                        gsActions_.add(a);
                    }
                }
                for (int j = 0; j < c.funcs().size(); j = j + 1) {
                    AstFunction f = c.funcs().get(j);
                    addMethod(c.name(), f.name(), f.ret(), f.params().size(), f.params(), f.coro());
                    if (f.ctor() != 0 && f.name() == "") {
                        // @startup function
                    }
                }
                // 事件也作为可调用方法（void 返回）
                for (int j = 0; j < c.events().size(); j = j + 1) {
                    AstEvent ev = c.events().get(j);
                    methods_.add(new MethodSig(c.name(), ev.name(), "void", 0, new ArrayList<AstParam>(), 0, null));
                    eventPairs_.add(c.name() + "." + ev.name());
                    string ekey = c.name() + "." + ev.name();
                    if (methodSigIdx_.contains(ekey) == 0) methodSigIdx_.put(ekey, methods_.size() - 1);
                }
            }
            // 收集顶层函数
            for (int i = 0; i < tu.functions().size(); i = i + 1) {
                AstFunction f = tu.functions().get(i);
                for (int fj = 0; fj < i; fj = fj + 1) {
                    if (tu.functions().get(fj).name() == f.name()) {
                        diag_.error(f.line(), f.col(), "duplicate function name '" + f.name() + "'");
                        break;
                    }
                }
                funcNames_.add(f.name());
                funcRet_.add(f.ret());
                funcParams_.add(f.params());
                if (funcIdx_.contains(f.name()) == 0) funcIdx_.put(f.name(), funcNames_.size() - 1);
                if (f.coro() != 0) coroNames_.add(f.name());
                // 收集 @op 运算符重载函数
                if (Str.len(f.op()) != 0) {
                    opSyms_.add(f.op());
                    opParams_.add(f.params());
                    opRets_.add(f.ret());
                    opFuncNames_.add(f.name());
                }
            }
            // 收集 ffi 声明（也是可调用函数，返回类型来自声明）
            for (int i = 0; i < tu.ffis().size(); i = i + 1) {
                AstFFI f = tu.ffis().get(i);
                funcNames_.add(f.name());
                funcRet_.add(f.ret());
                funcParams_.add(f.params());
                if (funcIdx_.contains(f.name()) == 0) funcIdx_.put(f.name(), funcNames_.size() - 1);
            }
            for (int i = 0; i < tu.macros().size(); i = i + 1) {
                AstMacro m = tu.macros().get(i);
                if (m.body() != null) markAllStmt(m.body());
            }
            // C++ 在 Pass1 声明诊断后不进入任何 body 分析；未访问 Expr 的
            // resolved_kind 默认仍为 Int。自托管 AST 初值为空，故只补默认注解。
            if (diag_.errorCount() != 0) {
                for (int i = 0; i < tu.functions().size(); i = i + 1)
                    if (tu.functions().get(i).body() != null) markAllStmt(tu.functions().get(i).body());
                for (int i = 0; i < tu.structs().size(); i = i + 1) {
                    AstStruct st = tu.structs().get(i);
                    for (int j = 0; j < st.funcs().size(); j = j + 1)
                        if (st.funcs().get(j).body() != null) markAllStmt(st.funcs().get(j).body());
                }
                for (int i = 0; i < tu.classes().size(); i = i + 1) {
                    AstClass c = tu.classes().get(i);
                    for (int j = 0; j < c.props().size(); j = j + 1)
                        if (c.props().get(j).init() != null) markAllExpr(c.props().get(j).init());
                    for (int j = 0; j < c.actions().size(); j = j + 1)
                        if (c.actions().get(j).body() != null) markAllStmt(c.actions().get(j).body());
                    for (int j = 0; j < c.staticActions().size(); j = j + 1)
                        if (c.staticActions().get(j).body() != null) markAllStmt(c.staticActions().get(j).body());
                    for (int j = 0; j < c.funcs().size(); j = j + 1)
                        if (c.funcs().get(j).body() != null) markAllStmt(c.funcs().get(j).body());
                }
                return;
            }
            // 顶层 mapping：处理 where 子句与 lambda 节点
            for (int mi = 0; mi < tu.mappings().size(); mi = mi + 1) {
                analyzeMapping(tu.mappings().get(mi));
            }
            // 顶层函数体
            for (int i = 0; i < tu.functions().size(); i = i + 1) {
                AstFunction f = tu.functions().get(i);
                if (f.genericInst() != 0) continue;  // F4-G1：泛型实例函数不重新分析（C++ 同）
                if (f.body() == null) continue;
                if (Str.len(f.name()) == 0) continue;
                currentClass_ = "";
                inClass_ = 0;
                inMain_ = (f.name() == "main" && f.autoMain() == 0) ? 1 : 0;
                // F4-G2：泛型函数的类型参数占位符（T/R/E）也进 curGeneric_，
                // 使 declareParam 的 tryInstantiate 能识别占位符并延迟实例化
                // （否则 resultMap<T,R,E> 的 Result<T,E> 参数会生成 Result_T_E_inst）。
                curGeneric_.clear();
                for (int gi = 0; gi < f.typeParams().size(); gi = gi + 1) curGeneric_.add(f.typeParams().get(gi));
                currentRet_ = typeToKind(f.ret());
                inCoro_ = f.coro() != 0 ? 1 : 0;
                loopDepth_ = 0;
                sym_.enterScope();
                int topFCheck = f.typeParams().size() == 0 ? 1 : 0;
                for (int j = 0; j < f.params().size(); j = j + 1) {
                    declareParam(f.params().get(j), topFCheck);
                }
                if (f.typeParams().size() != 0 || f.isMacro() != 0) markAllStmt(f.body());
                else visitStmt(f.body());
                sym_.leaveScope();
                curGeneric_.clear();
            }
            int ncls = tu.classes().size();
            // === F4-G2b：全局双 pass 类访问（复现 C++ Pass1/Pass2 作用域弹出）===
            // C++ visitClassDecl(Pass1) 解析属性类型 → 触发泛型实例化#1（实例名声明在
            // 类作用域，结束时弹出）；随后 Pass2 以新作用域访问 action body，此时
            // `new ArrayList<Diag>()` 的去重缓存失效 → 实例化#2 → dump 出现重复 _inst
            // 类。MYP 必须同样：Pass A 处理全部类属性后弹作用域，Pass B 再以新作用域
            // 访问 body，否则只出一份实例，与参考端不一致（如 diag.myp / codegen 工具）。
            // ---- Pass A：全部类的属性声明（弹作用域）----
            for (int ci = 0; ci < ncls; ci = ci + 1) {
                AstClass c = tu.classes().get(ci);
                if (c.isGenericInst() != 0) continue;  // 泛型实例类不重新分析（body 保持 int）
                curGeneric_.clear();
                ArrayList<string> ctpA = c.typeParams();
                for (int gi = 0; gi < ctpA.size(); gi = gi + 1) curGeneric_.add(ctpA.get(gi));
                // 收集类内嵌套 struct（struct 成员访问需要）
                for (int ns = 0; ns < c.structs().size(); ns = ns + 1) {
                    AstStruct st = c.structs().get(ns);
                    int known = 0;
                    for (int k = 0; k < structNames_.size(); k = k + 1) {
                        if (structNames_.get(k) == st.name()) { known = 1; break; }
                    }
                    if (known == 0) {
                        structNames_.add(st.name());
                        structProps_.add(st.props());
                        if (structIdx_.contains(st.name()) == 0) structIdx_.put(st.name(), structNames_.size() - 1);
                    }
                }
                currentClass_ = c.name();
                inClass_ = 1;
                inMain_ = 0;
                sym_.enterScope();
                sym_.declare("this", "class");
                for (int j = 0; j < c.props().size(); j = j + 1) {
                    AstProp p = c.props().get(j);
                    AstType pt = p.type();
                    if (pt != null && pt.element() != null) {
                        AstType el3 = pt.element();
                        if (Str.len(el3.className()) != 0) sym_.declareElemClass(p.name(), "array", typeToKind(el3), el3.className());
                        else sym_.declareElem(p.name(), "array", typeToKind(el3));
                    }
                    else if (pt != null && Str.len(pt.className()) != 0) {
                        if (inGeneric(pt.className()) != 0) sym_.declare(p.name(), "int");
                        else {
                            if (pt.typeArgs().size() > 0) tryInstantiate(pt.className(), pt.typeArgs());
                            if (pt.typeArgs().size() > 0) sym_.declareClassInst(p.name(), typeToKind(pt), instClassName(pt), pt.typeArgs());
                            else sym_.declareClass(p.name(), typeToKind(pt), instClassName(pt));
                        }
                    }
                    else sym_.declare(p.name(), typeToKind(pt));
                    // C++ 不 visit 属性默认值（resolved_kind 保持默认 Int）→ markAllExpr 置 int
                    if (p.init() != null) markAllExpr(p.init());
                }
                // Pass A 补充：C++ visitClassDecl 在类作用域内按 props → actions →
                // functions → static_actions → events 顺序解析成员类型（返回类型+
                // 形参），每类都会触发泛型实例化。MYP 必须同序处理，否则尾部 _inst
                // 顺序与参考端不一致（如 ast.myp：Dump.joinList 的 ArrayList<string>
                // 形参应先于 AstType 的 ArrayList<AstType> 属性被实例化）。
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    AstAction a = c.actions().get(ai);
                    if (a.ret() != null && a.ret().typeArgs().size() > 0) tryInstantiate(a.ret().className(), a.ret().typeArgs());
                    ArrayList<AstParam> ap = a.params();
                    for (int j = 0; j < ap.size(); j = j + 1) {
                        AstType pt2 = ap.get(j).type();
                        if (pt2 != null && pt2.typeArgs().size() > 0) tryInstantiate(pt2.className(), pt2.typeArgs());
                    }
                }
                for (int fi = 0; fi < c.funcs().size(); fi = fi + 1) {
                    AstFunction f = c.funcs().get(fi);
                    if (f.ret() != null && f.ret().typeArgs().size() > 0) tryInstantiate(f.ret().className(), f.ret().typeArgs());
                    ArrayList<AstParam> fp = f.params();
                    for (int j = 0; j < fp.size(); j = j + 1) {
                        AstType pt2 = fp.get(j).type();
                        if (pt2 != null && pt2.typeArgs().size() > 0) tryInstantiate(pt2.className(), pt2.typeArgs());
                    }
                }
                for (int sai = 0; sai < c.staticActions().size(); sai = sai + 1) {
                    AstAction a = c.staticActions().get(sai);
                    // C++ visitClassDecl 对泛型静态方法只注册模板、不解析成员类型
                    // （continue，模板不可直接调用）→ 模板形参里的 ArrayList<T> 不会
                    // 在类分析期触发实例化；MYP 若不跳过会生成 ArrayList_T_inst 幽灵。
                    if (a.typeParams().size() > 0) continue;
                    if (a.ret() != null && a.ret().typeArgs().size() > 0) tryInstantiate(a.ret().className(), a.ret().typeArgs());
                    ArrayList<AstParam> sp = a.params();
                    for (int j = 0; j < sp.size(); j = j + 1) {
                        AstType pt2 = sp.get(j).type();
                        if (pt2 != null && pt2.typeArgs().size() > 0) tryInstantiate(pt2.className(), pt2.typeArgs());
                    }
                }
                for (int evi = 0; evi < c.events().size(); evi = evi + 1) {
                    ArrayList<AstParam> ep = c.events().get(evi).params();
                    for (int j = 0; j < ep.size(); j = j + 1) {
                        AstType pt2 = ep.get(j).type();
                        if (pt2 != null && pt2.typeArgs().size() > 0) tryInstantiate(pt2.className(), pt2.typeArgs());
                    }
                }
                sym_.leaveScope();  // ← 弹出属性作用域：prop 触发的泛型实例从符号表移除
            }
            // ---- Pass B：全部类的 action/function body（新作用域，复现 C++ Pass2）----
            // C++ 主循环用 tu.classes.size() 动态上界：body 分析期间新创建的类
            // （嵌套 lambda / 泛型实例）也会被后续迭代访问。固定 ncls 会漏掉
            // Pass B 内生成的嵌套 lambda（其 __call body 从未类型检查）。
            for (int ci = 0; ci < tu.classes().size(); ci = ci + 1) {
                AstClass c = tu.classes().get(ci);
                if (c.isGenericInst() != 0) continue;  // 泛型实例类不重新分析（body 保持 int）
                curGeneric_.clear();
                ArrayList<string> ctp2 = c.typeParams();
                for (int gi = 0; gi < ctp2.size(); gi = gi + 1) curGeneric_.add(ctp2.get(gi));
                currentClass_ = c.name();
                inClass_ = 1;
                inMain_ = 0;
                // C++ buildCurrentClassMemberTypes 在进入方法作用域前解析当前类的
                // props/actions/functions/events 类型。由此产生的泛型实例声明在全局
                // 符号层，后续类可以复用；若省略此步，实例只会在方法体的临时作用域
                // 创建并被弹出，造成后续类重复生成 _inst。
                for (int pi = 0; pi < c.props().size(); pi = pi + 1) {
                    AstType ptb = c.props().get(pi).type();
                    if (ptb != null && ptb.typeArgs().size() > 0) tryInstantiate(ptb.className(), ptb.typeArgs());
                }
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    AstAction ab = c.actions().get(ai);
                    if (ab.ret() != null && ab.ret().typeArgs().size() > 0) tryInstantiate(ab.ret().className(), ab.ret().typeArgs());
                    for (int pi = 0; pi < ab.params().size(); pi = pi + 1) {
                        AstType ptb = ab.params().get(pi).type();
                        if (ptb != null && ptb.typeArgs().size() > 0) tryInstantiate(ptb.className(), ptb.typeArgs());
                    }
                }
                for (int fi = 0; fi < c.funcs().size(); fi = fi + 1) {
                    AstFunction fb = c.funcs().get(fi);
                    if (fb.ret() != null && fb.ret().typeArgs().size() > 0) tryInstantiate(fb.ret().className(), fb.ret().typeArgs());
                    for (int pi = 0; pi < fb.params().size(); pi = pi + 1) {
                        AstType ptb = fb.params().get(pi).type();
                        if (ptb != null && ptb.typeArgs().size() > 0) tryInstantiate(ptb.className(), ptb.typeArgs());
                    }
                }
                for (int ei = 0; ei < c.events().size(); ei = ei + 1) {
                    ArrayList<AstParam> ebp = c.events().get(ei).params();
                    for (int pi = 0; pi < ebp.size(); pi = pi + 1) {
                        AstType ptb = ebp.get(pi).type();
                        if (ptb != null && ptb.typeArgs().size() > 0) tryInstantiate(ptb.className(), ptb.typeArgs());
                    }
                }
                sym_.enterScope();
                sym_.declare("this", "class");
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    AstAction a = c.actions().get(ai);
                    if (a.body() == null) continue;
                    currentRet_ = typeToKind(a.ret());
                    inCoro_ = a.coro() != 0 ? 1 : 0;
                    currentMethodName_ = a.name();
                    loopDepth_ = 0;
                    // F4-G2：叠加方法自身类型参数（map<T,R> 的 T/R）→ 占位符延迟实例化
                    int gbase = curGeneric_.size();
                    for (int gi = 0; gi < a.typeParams().size(); gi = gi + 1) curGeneric_.add(a.typeParams().get(gi));
                    sym_.enterScope();
                    // M-FN-2 nonlocal：named lambda 的 __call 内把 nonlocal 变量
                    // 按其 cell 属性类型声明进作用域（body 引用解析；实际存储由
                    // codegen 注入别名）。对齐 C++ visitClassDecl action 循环。
                    if (Str.startsWith(c.name(), "__lambda_") != 0 && Str.len(c.lambda()) != 0 && a.name() == "__call") {
                        // M-FN-2 named lambda 自引用：把自名声明为自身函数类型
                        // （body 里 `B(0)` 解析；实际递归走自身 trampoline）。
                        string selfRet = a.ret() != null ? typeToKind(a.ret()) : "int";
                        ArrayList<AstType> selfParams = new ArrayList<AstType>();
                        for (int spi = 0; spi < a.params().size(); spi = spi + 1) {
                            AstType spp = a.params().get(spi).type();
                            selfParams.add(spp != null ? spp : new AstType());
                        }
                        sym_.declareFunc(c.lambda(), selfRet, selfParams);
                        lambdaSelfName_ = c.lambda();
                        lambdaSelfClass_ = c.name();
                        for (int nsi = 0; nsi < c.nonlocalSlots().size(); nsi = nsi + 1) {
                            AstNonlocalSlot ns = c.nonlocalSlots().get(nsi);
                            for (int cj = 0; cj < tu.classes().size(); cj = cj + 1) {
                                AstClass cc = tu.classes().get(cj);
                                if (cc.name() != ns.cell()) continue;
                                if (cc.props().size() != 0) sym_.declare(ns.varName(), typeToKind(cc.props().get(0).type()));
                                break;
                            }
                        }
                    }
                    for (int j = 0; j < a.params().size(); j = j + 1) {
                        declareParam(a.params().get(j), 1);
                    }
                    if (a.typeParams().size() != 0) markAllStmt(a.body());
                    else visitStmt(a.body());
                    lambdaSelfName_ = "";
                    lambdaSelfClass_ = "";
                    sym_.leaveScope();
                    while (curGeneric_.size() > gbase) curGeneric_.remove(curGeneric_.size() - 1);
                    currentMethodName_ = "";
                }
                for (int fi = 0; fi < c.funcs().size(); fi = fi + 1) {
                    AstFunction f = c.funcs().get(fi);
                    if (f.body() == null) continue;
                    currentRet_ = typeToKind(f.ret());
                    inCoro_ = f.coro() != 0 ? 1 : 0;
                    loopDepth_ = 0;
                    // F4-G2：叠加函数自身类型参数
                    int gbase3 = curGeneric_.size();
                    for (int gi = 0; gi < f.typeParams().size(); gi = gi + 1) curGeneric_.add(f.typeParams().get(gi));
                    sym_.enterScope();
                    for (int j = 0; j < f.params().size(); j = j + 1) {
                        declareParam(f.params().get(j), 1);
                    }
                    if (f.typeParams().size() != 0) markAllStmt(f.body());
                    else visitStmt(f.body());
                    sym_.leaveScope();
                    while (curGeneric_.size() > gbase3) curGeneric_.remove(curGeneric_.size() - 1);
                }
                // 静态 action（@static class 的方法）
                for (int sai = 0; sai < c.staticActions().size(); sai = sai + 1) {
                    AstAction a = c.staticActions().get(sai);
                    if (a.body() == null) continue;
                    currentRet_ = typeToKind(a.ret());
                    inCoro_ = a.coro() != 0 ? 1 : 0;
                    loopDepth_ = 0;
                    // F4-G2：叠加方法自身类型参数
                    int gbase2 = curGeneric_.size();
                    for (int gi = 0; gi < a.typeParams().size(); gi = gi + 1) curGeneric_.add(a.typeParams().get(gi));
                    sym_.enterScope();
                    for (int j = 0; j < a.params().size(); j = j + 1) {
                        declareParam(a.params().get(j), 1);
                    }
                    if (a.typeParams().size() != 0) markAllStmt(a.body());
                    else visitStmt(a.body());
                    sym_.leaveScope();
                    while (curGeneric_.size() > gbase2) curGeneric_.remove(curGeneric_.size() - 1);
                }
                sym_.leaveScope();
            }
            // C++ checks top-level struct methods after all class bodies.
            for (int si2 = 0; si2 < tu.structs().size(); si2 = si2 + 1) {
                AstStruct st2 = tu.structs().get(si2);
                ArrayList<AstFunction> sfuncs2 = st2.funcs();
                for (int sfj2 = 0; sfj2 < sfuncs2.size(); sfj2 = sfj2 + 1) {
                    AstFunction f = sfuncs2.get(sfj2);
                    if (f.body() == null) continue;
                    currentClass_ = st2.name();
                    inStruct_ = 1;
                    inClass_ = 1;
                    inMain_ = 0;
                    currentRet_ = typeToKind(f.ret());
                    inCoro_ = f.coro() != 0 ? 1 : 0;
                    loopDepth_ = 0;
                    sym_.enterScope();
                    for (int j = 0; j < f.params().size(); j = j + 1) {
                        declareParam(f.params().get(j), 0);
                    }
                    if (f.typeParams().size() != 0) markAllStmt(f.body());
                    else visitStmt(f.body());
                    sym_.leaveScope();
                }
                inStruct_ = 0;
            }
        }

        // 查找函数返回类型（名 + 参数个数匹配）→ TypeKind 字符串
        string findFuncRet(string name, int nparams) {
            for (int i = 0; i < funcNames_.size(); i = i + 1) {
                if (funcNames_.get(i) == name && funcParams_.get(i).size() == nparams) {
                    AstType r = funcRet_.get(i);
                    return r != null ? typeToKind(r) : "void";
                }
            }
            return "";
        }
        AstType findFuncRetType(string name, int nparams) {
            for (int i = 0; i < funcNames_.size(); i = i + 1) {
                if (funcNames_.get(i) == name && funcParams_.get(i).size() == nparams) {
                    return funcRet_.get(i);
                }
            }
            return null;
        }
        // destructure target 叶子（绑定）数
        int countDestructureTargets(AstDestructureTarget t) {
            if (t.elements().size() == 0) return 1;
            int n = 0;
            for (int i = 0; i < t.elements().size(); i = i + 1) n = n + countDestructureTargets(t.elements().get(i));
            return n;
        }
        int findClass(string name) {
            int ci = classIdx_.get(name, -1);   // O(1)（P6 规模修复）
            return ci;
        }
        // @static class 判定（对拍 C++ sema：外部属性访问仅允许 this.prop / StaticClass.prop）。
        // 链式访问拆局部变量（自举 codegen 对 getter().method() 链有限制）。
        // 注：保留线性扫描——classIdx_ 映射 classNames_（不含 _inst 克隆），而
        // @static 判定需查 tu().classes()（含 _inst）；此路径仅属性访问时触发，非热路径。
        int isStaticClass(string name) {
            AstTU t = tu();
            if (t == null) return 0;
            ArrayList<AstClass> cls = t.classes();
            for (int i = 0; i < cls.size(); i = i + 1) {
                AstClass c = cls.get(i);
                if (c.isStatic() != 0 && c.name() == name) return 1;
            }
            return 0;
        }
        int isFuncName(string name) {
            return funcIdx_.contains(name) != 0 ? 1 : 0;   // O(1)
        }
        // ★ BUG-050：查找零参 const-decl 函数（`const int X = N;` 解析成 constDecl
        // 函数，body=return N）。裸标识符引用应折叠为常量（等价零参调用 X()）。
        AstFunction findConstDeclFunc(string name) {
            if (tu_ == null) return null;
            for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                AstFunction f = tu_.functions().get(i);
                if (f.constDecl() != 0 && f.name() == name && f.params().size() == 0) {
                    return f;
                }
            }
            return null;
        }
        // const-decl 函数返回类型的 valueClass（class/interface 返回时）
        string constRetValueClass(AstFunction f) {
            if (f == null || f.ret() == null) return "";
            AstType t = f.ret();
            if (Str.len(t.className()) != 0 && t.className() != "slice") {
                if (t.typeArgs().size() > 0) return instClassName(t);
                return t.className();
            }
            return "";
        }
        // AstType → TypeKind 字符串（typeKindToString），供符号表/返回类型用。
        int isNumKind(string k) {
            if (k == "byte" || k == "short" || k == "int" || k == "long"
                || k == "ubyte" || k == "ushort" || k == "uint" || k == "ulong"
                || k == "char" || k == "float" || k == "double") return 1;
            return 0;
        }
        int isUnsignedKind(string k) {
            if (k == "ubyte" || k == "ushort" || k == "uint" || k == "ulong") return 1;
            return 0;
        }
        // 类型兼容：同类型、无损数字拓宽、null→class。
        int typesCompat(string a, string b) {
            if (a == b) return 1;
            if (a == "bool" && b == "bit") return 1;
            if (a == "bit" && b == "bool") return 1;
            if (isNumKind(a) != 0 && isNumKind(b) != 0) {
                if ((a == "int" && b == "long") || (a == "long" && b == "int")) return 1;
                return TKind.promotesTo(b, a);
            }
            if (a == "null" && b == "class") return 1;
            if (a == "class" && b == "null") return 1;
            // 接口变量可赋实现类实例
            if (a == "interface" && b == "class") return 1;
            return 0;
        }
        // C++ Sema::isNarrowing 等价（kind 字符串版）：实参 from → 形参 to 有损窄化。
        // typesCompat 已放行 Int↔Long 双向 / int→double 提升；此处捕获位宽收窄
        // （Long→Int/Double→Float）或浮点→整型，供参数传递处发「narrowing」warning。
        int isNarrowingKind(string from, string to) {
            int fb = numericBitsOf(from);
            int tb = numericBitsOf(to);
            if (fb == 0 || tb == 0) return 0;
            if (from == to) return 0;
            if (fb > tb) return 1;
            if (isFloatKindOf(from) != 0 && isFloatKindOf(to) == 0) return 1;
            return 0;
        }
        int numericBitsOf(string k) {
            if (k == "byte" || k == "char" || k == "ubyte") return 8;
            if (k == "short" || k == "ushort") return 16;
            if (k == "int" || k == "uint" || k == "float") return 32;
            if (k == "long" || k == "ulong" || k == "double") return 64;
            return 0;
        }
        int isFloatKindOf(string k) {
            if (k == "float" || k == "double") return 1;
            return 0;
        }
        // 构造器实参兼容：actual 只能提升到 parameter，禁止 double→int 等收窄。
        int ctorArgCompat(string parameter, string actual) {
            if (parameter == actual) return 1;
            if (isNumKind(parameter) != 0 && isNumKind(actual) != 0)
                return TKind.promotesTo(actual, parameter);
            return typesCompat(parameter, actual);
        }
        // typeName（C++ typeName）：有 AstType 用 str()（tuple/array/class 精确），否则 kind 名
        string typeNameOf(string kind, AstType t) {
            if (t != null) {
                string s = t.str();
                if (Str.len(s) != 0) return s;
            }
            return kind;
        }
        // tuple 声明类型名（C++ 格式 "(int, int)"）
        string tupleDeclName(ArrayList<AstType> tys) {
            StringBuilder sb = new StringBuilder();
            sb.append("(");
            for (int i = 0; i < tys.size(); i = i + 1) {
                if (i != 0) sb.append(", ");
                sb.append(typeNameOf(typeToKind(tys.get(i)), tys.get(i)));
            }
            sb.append(")");
            return sb.toString();
        }
        // tuple 值类型名（C++ 格式 "(byte, byte, byte)"）
        string tupleValName(ArrayList<AstExpr> els) {
            StringBuilder sb = new StringBuilder();
            sb.append("(");
            for (int i = 0; i < els.size(); i = i + 1) {
                if (i != 0) sb.append(", ");
                string k = els.get(i) != null ? els.get(i).resolvedKind() : "void";
                sb.append(k);
            }
            sb.append(")");
            return sb.toString();
        }
        // match 字面量臂 subject 判定：整型族（int/long/uint/ulong/byte/short/ubyte/ushort/char）。
        int isIntKindMatch(string k) {
            if (k == "int" || k == "long" || k == "uint" || k == "ulong"
                || k == "byte" || k == "short" || k == "ubyte" || k == "ushort"
                || k == "char") return 1;
            return 0;
        }
        // 表达式对应的具体 struct/class 名（BUG-054：typesCompat 只比 kind "struct"，
        // 不同 struct 类型赋值需比较具体名）。
        // ⚠️ Member 访问（obj.field）的 resolvedClass 是**容器**类型名（如
        // root.inner 的 resolvedClass=L0 而非字段类型 L1）——必须查 struct 定义
        // 解析字段声明类型，否则同名 struct 比较误判（误拒合法 `L2 y = a.b.c;`）。
        string exprStructName(AstExpr e) {
            if (e == null) return "";
            if (e.kind() == "Member") {
                AstExpr mobj = e.array();
                string on = exprStructName(mobj);
                if (Str.len(on) != 0) {
                    string ft = structFieldTypeName(on, e.memberName());
                    if (Str.len(ft) != 0) return ft;
                }
                return "";
            }
            if (Str.len(e.resolvedClass()) != 0) return e.resolvedClass();
            if (Str.len(e.valueClass()) != 0) return e.valueClass();
            if (e.kind() == "Identifier") {
                SymbolEntry en = sym_.lookupEntry(e.name());
                if (en != null && Str.len(en.className()) != 0) return en.className();
            }
            return "";
        }
        // struct 的字段声明类型名（struct 名 + 字段名 → 字段类型 className/basicName）。
        string structFieldTypeName(string structName, string fieldName) {
            if (tu_ == null) return "";
            for (int i = 0; i < tu_.structs().size(); i = i + 1) {
                AstStruct st = tu_.structs().get(i);
                if (st.name() != structName) continue;
                for (int j = 0; j < st.props().size(); j = j + 1) {
                    AstProp p = st.props().get(j);
                    if (p.name() != fieldName) continue;
                    AstType pt = p.type();
                    if (pt == null) return "";
                    if (Str.len(pt.className()) != 0) return pt.className();
                    return pt.basicName();
                }
            }
            return "";
        }
        // 操作数类型名（struct/class 用类名，C++ typeName）
        string exprTypeName(AstExpr e, string kind) {
            if (kind == "struct" || kind == "class") {
                if (e != null && e.kind() == "Identifier") {
                    string cn = sym_.lookupClass(e.name());
                    if (Str.len(cn) != 0) return cn;
                }
                if (e != null && Str.len(e.resolvedClass()) != 0) return e.resolvedClass();
                if (e != null && Str.len(e.valueClass()) != 0) return e.valueClass();
            } else if (kind == "array" && e != null && e.kind() == "Identifier") {
                SymbolEntry en = sym_.lookupEntry(e.name());
                if (en != null) {
                    string et2 = en.elementType();
                    if (Str.len(en.elementClass()) != 0) et2 = en.elementClass();
                    if (Str.len(et2) != 0) return et2 + "[]";
                }
            }
            return kind;
        }
        // 当前类/方法泛型参数名是否命中（泛型占位 → int）
        int inGeneric(string n) {
            for (int i = 0; i < curGeneric_.size(); i = i + 1) {
                if (curGeneric_.get(i) == n) return 1;
            }
            return 0;
        }
        string associatedTypeKind(string name) {
            if (tu_ == null) return "";
            for (int i = 1; i + 1 < Str.len(name); i = i + 1) {
                if (Str.substring(name, i, i + 2) == "::") {
                    string owner = Str.substring(name, 0, i);
                    string item = Str.substring(name, i + 2, Str.len(name));
                    for (int j = 0; j < tu_.classes().size(); j = j + 1) {
                        AstClass cls = tu_.classes().get(j);
                        if (cls.name() != owner) continue;
                        for (int k = 0; k < cls.assocTypes().size(); k = k + 1) {
                            AstPair binding = cls.assocTypes().get(k);
                            if (binding.k() == item) return binding.typeStr();
                        }
                    }
                    return "assoc";
                }
            }
            for (int i = 0; i < tu_.interfaces().size(); i = i + 1) {
                AstInterface iface = tu_.interfaces().get(i);
                for (int j = 0; j < iface.assocTypeDecls().size(); j = j + 1) {
                    if (iface.assocTypeDecls().get(j) == name) return "assoc";
                }
            }
            return "";
        }
        string typeToKind(AstType t) {
            if (t != null && (inGeneric(t.basicName()) != 0 || inGeneric(t.className()) != 0)) return "int";
            // 限定 struct 名（Sensor::Config）优先于关联类型判定：owner 是类但
            // 无 assoc 绑定（Config 是嵌套 struct 非 type Item=...）时
            // associatedTypeKind 会误返 "assoc"，导致嵌套 struct 变量类型错。
            if (t != null && Str.len(t.className()) != 0 && inStructName(t.className()) != 0) return "struct";
            if (t != null) {
                string assocKind = associatedTypeKind(Str.len(t.className()) != 0 ? t.className() : t.basicName());
                if (Str.len(assocKind) != 0) return assocKind;
            }
            if (t != null && Str.len(t.className()) != 0 && inInterface(t.className()) != 0) return "interface";
            if (t != null && Str.len(t.className()) != 0 && findBitfield(t.className()) >= 0) return "bitfield";
            if (t != null && Str.len(t.className()) != 0 && t.className() != "slice") {
                // 已知类 → class；enum → enum；未知类型 → void（C++ unknown type 诊断）
                if (findClass(t.className()) >= 0) return "class";
                if (findEnum(t.className()) >= 0) return "enum";
                return "void";
            }
            return TKind.typeKindOf(t);
        }
        int findBitfield(string name) {
            for (int i = 0; i < bitfieldNames_.size(); i = i + 1) {
                if (bitfieldNames_.get(i) == name) return i;
            }
            return -1;
        }
        string bitfieldMemberType(string name, string member) {
            int index = findBitfield(name);
            if (index < 0) return "";
            ArrayList<string> names = bitfieldFieldNames_.get(index);
            ArrayList<int> widths = bitfieldFieldWidths_.get(index);
            for (int i = 0; i < names.size(); i = i + 1) {
                if (names.get(i) == member) return widths.get(i) == 1 ? "bit" : "uint";
            }
            return "";
        }
        int inInterface(string n) {
            return ifaceIdx_.contains(n) != 0 ? 1 : 0;   // O(1)
        }
        int inStructName(string n) {
            return findStruct(n) >= 0 ? 1 : 0;
        }
        // 限定 struct 名 → 裸名（Sensor::Config → Config；Device::Mode → Mode）。
        // 空 = 无 "::"。
        string structBareName(string n) {
            int idx = -1;
            for (int i = 0; i + 1 < Str.len(n); i = i + 1) {
                if (Str.substring(n, i, i + 2) == "::") idx = i;
            }
            if (idx < 0) return "";
            return Str.substring(n, idx + 2, Str.len(n));
        }
        // 泛型类实例名：ArrayList<string> → ArrayList_string_inst（C++ 递归实例名）
        string instClassName(AstType t) {
            if (t == null) return "";
            string cn = t.className();
            if (Str.len(cn) == 0) return mangleType(t);
            ArrayList<AstType> tas = t.typeArgs();
            if (tas.size() > 0) {
                string inst = cn;
                for (int i = 0; i < tas.size(); i = i + 1) inst = inst + "_" + instClassName(tas.get(i));
                return inst + "_inst";
            }
            return cn;
        }
        // 实例名 → 原始类名（ArrayList_string_inst → ArrayList）
        string resolveBase(string cn) {
            if (classIdx_.contains(cn) != 0) return cn;   // O(1) 精确命中
            for (int i = 0; i < classNames_.size(); i = i + 1) {
                string base = classNames_.get(i);
                if (Str.startsWith(cn, base + "_") != 0) return base;
            }
            return cn;
        }
        string currentClassMemberType(string name) {
            if (Str.len(currentClass_) == 0) return "";
            int ci = findClass(currentClass_);
            if (ci < 0) return "";
            string pt = findPropType(ci, name);
            if (Str.len(pt) != 0) return pt;
            if (hasMethod(currentClass_, name) != 0) return "function";
            return "";
        }
        AstType currentClassMemberAstType(string name) {
            if (Str.len(currentClass_) == 0) return null;
            int ci = findClass(currentClass_);
            if (ci < 0) return null;
            return findPropTypeAst(ci, name);
        }
        string currentClassMemberClassName(string name) {
            if (Str.len(currentClass_) == 0) return "";
            int ci = findClass(currentClass_);
            if (ci < 0) return "";
            return findPropTypeClass(ci, name);
        }
        string currentStructMemberClassName(string name) {
            if (Str.len(currentClass_) == 0) return "";
            int si = findStruct(currentClass_);
            if (si < 0) return "";
            AstType pt = findStructPropAst(si, name);
            if (pt == null) return "";
            if (pt.typeArgs().size() > 0) return instClassName(pt);
            if (Str.len(pt.className()) != 0) return pt.className();
            return "";
        }
        // struct 字段类型
        string findStructProp(int si, string name) {
            ArrayList<AstProp> ps = structProps_.get(si);
            for (int i = 0; i < ps.size(); i = i + 1) {
                if (ps.get(i).name() == name) return ps.get(i).type() != null ? typeToKind(ps.get(i).type()) : "int";
            }
            return "";
        }
        AstType findStructPropAst(int si, string name) {
            ArrayList<AstProp> ps = structProps_.get(si);
            for (int i = 0; i < ps.size(); i = i + 1) {
                if (ps.get(i).name() == name) return ps.get(i).type();
            }
            return null;
        }
        int findStruct(string name) {
            int si = structIdx_.get(name, -1);   // O(1)（P6 规模修复）
            if (si >= 0) return si;
            // 限定名 Sensor::Config / Device::Mode → 裸名回退（嵌套/文件级限定
            // struct 以裸名注册，引用用限定名）。
            string bare = structBareName(name);
            if (Str.len(bare) != 0) return structIdx_.get(bare, -1);
            return -1;
        }
        // 当前 struct 内隐式 this 字段访问类型
        string structPropType(string sn, string name) {
            int si = findStruct(sn);
            if (si < 0) return "";
            return findStructProp(si, name);
        }
        // @op 运算符重载匹配：返回返回类型 kind（空 = 未命中）
        string resolveOp(AstExpr e, string sym, AstExpr lhs, string lt, string rt) {
            string structName = "";
            if (lt == "struct" && lhs != null && lhs.kind() == "Identifier") structName = sym_.lookupClass(lhs.name());
            else if (lt == "struct" && lhs != null) {
                structName = lhs.valueClass();
                if (Str.len(structName) == 0) structName = lhs.resolvedClass();
            }
            int si = findStruct(structName);
            if (si >= 0) {
                ArrayList<AstFunction> funcs = tu_.structs().get(si).funcs();
                for (int i = 0; i < funcs.size(); i = i + 1) {
                    AstFunction f = funcs.get(i);
                    if (f.op() != sym || f.params().size() != 1) continue;
                    AstType pt = f.params().get(0).type();
                    string pk = pt != null ? typeToKind(pt) : "void";
                    if (typesCompatKind(pk, rt) != 0) {
                        // struct @op 方法：记录 mangled 方法名，codegen 按
                        // struct_<key>_<method>(ptr this, rhs) 发射（同 C++
                        // op_call->struct_method）。
                        e.setResolved("struct_" + structName + "_" + f.name());
                        return f.ret() != null ? typeToKind(f.ret()) : "void";
                    }
                }
            }
            for (int i = 0; i < opSyms_.size(); i = i + 1) {
                if (opSyms_.get(i) != sym) continue;
                ArrayList<AstParam> ps = opParams_.get(i);
                if (ps.size() != 2) continue;
                string p0 = ps.get(0).type() != null ? typeToKind(ps.get(0).type()) : "void";
                string p1 = ps.get(1).type() != null ? typeToKind(ps.get(1).type()) : "void";
                if (typesCompatKind(p0, lt) != 0 && typesCompatKind(p1, rt) != 0) {
                    AstType rt2 = opRets_.get(i);
                    return rt2 != null ? typeToKind(rt2) : "void";
                }
            }
            return "";
        }
        // 简化的类型兼容（用于 @op 参数匹配）
        int typesCompatKind(string a, string b) {
            if (a == b) return 1;
            if (isNumKind(a) != 0 && isNumKind(b) != 0) return 1;
            return 0;
        }
        // 类的事件？
        int isEvent(string cls, string name) {
            string key = cls + "." + name;
            for (int i = 0; i < eventPairs_.size(); i = i + 1) {
                if (eventPairs_.get(i) == key) return 1;
            }
            return 0;
        }
        // enum 查找
        int findEnum(string name) {
            return enumIdx_.get(name, -1);   // O(1)（P6 规模修复）
        }
        int enumHasVariant(int ei, string name) {
            ArrayList<string> vs = enumVariants_.get(ei);
            for (int i = 0; i < vs.size(); i = i + 1) {
                if (vs.get(i) == name) return 1;
            }
            return 0;
        }
        int isThreadVar(string name) {
            for (int i = 0; i < threadVars_.size(); i = i + 1) {
                if (threadVars_.get(i) == name) return 1;
            }
            return 0;
        }
        int isStartupMethod(string cls, string name) {
            string key = cls + "." + name;
            for (int i = 0; i < startupMethods_.size(); i = i + 1) {
                if (startupMethods_.get(i) == key) return 1;
            }
            return 0;
        }
        // 泛型类模板？
        int isGenericClass(string name) {
            int ci = classIdx_.get(name, -1);   // O(1)
            if (ci < 0) return 0;
            return classTypeParams_.get(ci).size() > 0 ? 1 : 0;
        }
        // 类型替换：类型参数 T → 具体类型（C++ substituteTypeNode）
        AstType substituteType(AstType t, ArrayList<string> tps, ArrayList<AstType> concrete) {
            if (t == null) return null;
            // 直接命中类型参数：T、U、E 等，且数组元素/泛型实参中的占位符也要替换。
            for (int i = 0; i < tps.size(); i = i + 1) {
                if (i >= concrete.size()) break;
                string tp = tps.get(i);
                string assocPrefix = tp + "::";
                string typeName = Str.len(t.className()) != 0 ? t.className() : t.basicName();
                if (Str.len(typeName) > Str.len(assocPrefix)
                    && Str.substring(typeName, 0, Str.len(assocPrefix)) == assocPrefix) {
                    AstType owner = concrete.get(i);
                    string ownerName = Str.len(owner.className()) != 0 ? owner.className() : owner.basicName();
                    AstType assoc = new AstType();
                    assoc.setClassName(ownerName + "::" + Str.substring(typeName, Str.len(assocPrefix), Str.len(typeName)));
                    return assoc;
                }
                if (t.genericParam() != 0) return concrete.get(i);
                if ((t.className() == tp || t.basicName() == tp) && Str.len(tp) != 0) return concrete.get(i);
            }
            if (t.element() != null) {
                AstType sub = substituteType(t.element(), tps, concrete);
                if (sub != t.element()) {
                    AstType r = new AstType();
                    r.setClassName(t.className());
                    r.setBasicName(t.basicName());
                    r.setElement(sub);
                    r.setArraySize(t.arraySize());
                    for (int i = 0; i < t.typeArgs().size(); i = i + 1) r.typeArgs().add(t.typeArgs().get(i));
                    return r;
                }
            }
            if (t.typeArgs().size() > 0) {
                int changed = 0;
                ArrayList<AstType> nta = new ArrayList<AstType>();
                for (int i = 0; i < t.typeArgs().size(); i = i + 1) {
                    AstType sub = substituteType(t.typeArgs().get(i), tps, concrete);
                    nta.add(sub);
                    if (sub != t.typeArgs().get(i)) changed = 1;
                }
                if (changed != 0) {
                    AstType r = new AstType();
                    r.setClassName(t.className());
                    r.setBasicName(t.basicName());
                    for (int i = 0; i < nta.size(); i = i + 1) r.typeArgs().add(nta.get(i));
                    return r;
                }
            }
            // 函数类型 (T)->R 与元组 (T, R)：递归替换参数/返回（C++ substituteTypeNode）
            if (t.funcReturn() != null || t.isTuple() != 0) {
                AstType r = new AstType();
                r.setIsTuple(t.isTuple());
                if (t.funcReturn() != null) r.setFuncReturn(substituteType(t.funcReturn(), tps, concrete));
                for (int i = 0; i < t.funcParamTypes().size(); i = i + 1) {
                    r.funcParamTypes().add(substituteType(t.funcParamTypes().get(i), tps, concrete));
                }
                return r;
            }
            return t;
        }
        AstParam cloneParam(AstParam p, ArrayList<string> tps, ArrayList<AstType> concrete) {
            AstParam np = new AstParam();
            np.setName(p.name());
            np.setType(substituteType(p.type(), tps, concrete));
            np.setRef(p.isRef());
            np.setHasDefault(p.hasDefault());
            np.setDefaultExpr(p.defaultExpr());
            return np;
        }
        // 克隆 Action 并替换类型参数
        AstAction cloneAction(AstAction a, ArrayList<string> tps, ArrayList<AstType> concrete) {
            AstAction na = new AstAction();
            na.setName(a.name());
            na.setPos(a.line(), a.col());
            na.setRet(substituteType(a.ret(), tps, concrete));
            na.setStartup(a.startup());
            na.setCtor(a.ctor());
            na.setTest(a.test());
            na.setCoro(a.coro());
            na.setAsync(a.async());
            na.setRegion(a.region());
            na.setStack(a.stack());
            for (int j = 0; j < a.typeParams().size(); j = j + 1) na.typeParams().add(a.typeParams().get(j));
            ArrayList<AstPair> ac = a.constraints();
            for (int j = 0; j < ac.size(); j = j + 1) na.constraints().add(ac.get(j));
            for (int j = 0; j < a.params().size(); j = j + 1) na.params().add(cloneParam(a.params().get(j), tps, concrete));
            na.setBody(a.body());
            return na;
        }
        // 克隆 Function 并替换类型参数
        AstFunction cloneFunction(AstFunction f, ArrayList<string> tps, ArrayList<AstType> concrete) {
            AstFunction nf = new AstFunction();
            nf.setName(f.name());
            nf.setRet(substituteType(f.ret(), tps, concrete));
            nf.setGenericInst(f.genericInst());
            nf.setTest(f.test());
            nf.setAutoMain(f.autoMain());
            nf.setRegion(f.region());
            nf.setCoro(f.coro());
            nf.setAsync(f.async());
            nf.setStack(f.stack());
            nf.setOp(f.op());
            nf.setEval(f.eval());
            nf.setMacro(f.isMacro());
            nf.setCtor(f.ctor());
            nf.setConstDecl(f.constDecl());
            for (int j = 0; j < f.typeParams().size(); j = j + 1) nf.typeParams().add(f.typeParams().get(j));
            for (int j = 0; j < f.instTypeArgs().size(); j = j + 1) nf.instTypeArgs().add(substituteType(f.instTypeArgs().get(j), tps, concrete));
            for (int j = 0; j < f.params().size(); j = j + 1) nf.params().add(cloneParam(f.params().get(j), tps, concrete));
            nf.setBody(f.body());
            return nf;
        }
        int typeMatchesGenericParam(AstType t, string tpName) {
            if (t == null) return 0;
            if (t.genericParam() != 0) return 1;
            if (Str.len(t.className()) != 0 && t.className() == tpName) return 1;
            if (Str.len(t.basicName()) != 0 && t.basicName() == tpName) return 1;
            if (t.element() != null && typeMatchesGenericParam(t.element(), tpName) != 0) return 1;
            for (int i = 0; i < t.typeArgs().size(); i = i + 1) {
                if (typeMatchesGenericParam(t.typeArgs().get(i), tpName) != 0) return 1;
            }
            for (int i = 0; i < t.funcParamTypes().size(); i = i + 1) {
                if (typeMatchesGenericParam(t.funcParamTypes().get(i), tpName) != 0) return 1;
            }
            if (t.funcReturn() != null && typeMatchesGenericParam(t.funcReturn(), tpName) != 0) return 1;
            return 0;
        }
        AstType inferConcreteTypeForGenericParam(AstType paramType, AstExpr arg, string tpName) {
            if (arg == null) return null;
            if (paramType != null && paramType.element() != null && typeMatchesGenericParam(paramType.element(), tpName) != 0) {
                AstType at = argElemToAstType(arg);
                if (at != null) return at;
            }
            if (typeMatchesGenericParam(paramType, tpName) != 0) {
                AstType at = argToAstType(arg);
                if (at != null) return at;
            }
            return null;
        }
        // 生成泛型函数实例（C++ resolveGenericCall：id<int>(x) -> id_int_inst）
        string instantiateGenericFunction(string baseName, ArrayList<AstType> typeArgs) {
            if (tu_ == null) return "";
            AstFunction templ = null;
            for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                AstFunction f = tu_.functions().get(i);
                if (f.name() == baseName && f.typeParams().size() > 0 && f.genericInst() == 0) { templ = f; break; }
            }
            if (templ == null) return "";
            if (typeArgs.size() != templ.typeParams().size()) return "";
            string instName = baseName;
            for (int i = 0; i < typeArgs.size(); i = i + 1) instName = instName + "_" + instClassName(typeArgs.get(i));
            instName = instName + "_inst";
            for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                if (tu_.functions().get(i).name() == instName) return instName;
            }
            AstFunction nf = cloneFunction(templ, templ.typeParams(), typeArgs);
            nf.setName(instName);
            nf.setGenericInst(1);
            for (int i = 0; i < typeArgs.size(); i = i + 1) nf.instTypeArgs().add(typeArgs.get(i));
            tu_.functions().add(nf);
            return instName;
        }
        // 生成泛型类实例（C++ typeNodeToTypeInfo 单态化：克隆模板 + 替换类型参数）
        void instantiateClass(string baseName, ArrayList<AstType> typeArgs) {
            string inst = baseName;
            for (int i = 0; i < typeArgs.size(); i = i + 1) inst = inst + "_" + instClassName(typeArgs.get(i));
            inst = inst + "_inst";
            // F4-G2：作用域感知去重（C++ symbol_table_.lookup 沿作用域链搜索）。
            // 同一作用域链内已声明 → 去重；作用域弹出后再触发 → 追加字节相同的克隆，
            // 复现参考端 dump 的重复 _inst 类声明（规范实例仍唯一，克隆共享 typeArgs）。
            if (sym_.lookup(inst) == "class") return;
            if (tu_ == null) return;
            AstClass tmpl = null;
            for (int i = 0; i < tu_.classes().size(); i = i + 1) {
                if (tu_.classes().get(i).name() == baseName) { tmpl = tu_.classes().get(i); break; }
            }
            if (tmpl == null) return;
            ArrayList<string> tps = tmpl.typeParams();
            if (tps.size() == 0) return;
            // 规范实例登记（首次创建才记录；克隆共享 typeArgs）
            int canonical = 0;
            for (int i = 0; i < instDone_.size(); i = i + 1) {
                if (instDone_.get(i) == inst) { canonical = 1; break; }
            }
            if (canonical == 0) {
                instDone_.add(inst);
                instNames_.add(inst);
                instTAs_.add(typeArgs);
            }
            AstClass nc = new AstClass();
            nc.setName(inst);
            nc.setIsStatic(tmpl.isStatic());
            nc.setIsGenericInst(1);
            nc.setLambda(tmpl.lambda());
            nc.setIface(tmpl.iface());
            for (int i = 0; i < tps.size(); i = i + 1) nc.typeParams().add(tps.get(i));
            for (int i = 0; i < typeArgs.size(); i = i + 1) nc.instTypeArgs().add(typeArgs.get(i));
            for (int i = 0; i < tmpl.actions().size(); i = i + 1) nc.actions().add(cloneAction(tmpl.actions().get(i), tps, typeArgs));
            for (int i = 0; i < tmpl.staticActions().size(); i = i + 1) nc.staticActions().add(cloneAction(tmpl.staticActions().get(i), tps, typeArgs));
            for (int i = 0; i < tmpl.events().size(); i = i + 1) nc.events().add(tmpl.events().get(i));
            for (int i = 0; i < tmpl.props().size(); i = i + 1) {
                AstProp p = tmpl.props().get(i);
                AstProp np = new AstProp();
                np.setName(p.name());
                np.setType(substituteType(p.type(), tps, typeArgs));
                np.setConst(p.isConst());
                np.setWeak(p.weak());
                // C++ 泛型实例属性不拷贝 init_expr（sema_expr.cpp 单态化只拷
                // name/type/range）→ dump 不出 (Integer) 初始化节点。
                np.setInit(null);
                nc.props().add(np);
            }
            for (int i = 0; i < tmpl.funcs().size(); i = i + 1) nc.funcs().add(cloneFunction(tmpl.funcs().get(i), tps, typeArgs));
            tu_.classes().add(nc);
            // F4-G2：声明实例到当前作用域（C++ visitClassDecl 注册类）
            sym_.declare(inst, "class");
            // F4-G2：级联——实例属性类型可能引用其他泛型类（如 FfiParam 有
            // ArrayList<string> 成员）→ 触发嵌套实例化，复现参考端的重复克隆。
            for (int i = 0; i < nc.props().size(); i = i + 1) {
                AstType ppt = nc.props().get(i).type();
                if (ppt != null && ppt.typeArgs().size() > 0) tryInstantiate(ppt.className(), ppt.typeArgs());
            }
        }
        // 触发泛型类实例化（类型引用带 typeArgs，递归内层）
        // BUG-056：泛型类型实参最大嵌套深度（O(N) 单遍，不递归拼名）。
        int typeArgDepth(AstType t) {
            if (t == null) return 0;
            int m = 0;
            for (int i = 0; i < t.typeArgs().size(); i = i + 1) {
                int d = typeArgDepth(t.typeArgs().get(i));
                if (d > m) m = d;
            }
            return m + 1;
        }
        void tryInstantiate(string cn, ArrayList<AstType> tas) {
            if (Str.len(cn) == 0) return;
            if (tas.size() == 0) return;
            // BUG-056：嵌套泛型实例化深度守卫。Box<Box<...<int>...>> 深度 N 时，
            // SymbolTable.lookup 线性扫描（entries_ 已 N 项 × 长名比较）+ instClassName
            // 递归拼名（每层 O(k²)）→ 实例化总 O(N³)：实测 depth 800 >25s（DoS）。
            // 顶层一次性测深：超限整体拒绝（1 条错误），避免对深层类型做任何实例化/
            // 名构建。合法泛型嵌套 ≤4 层（如 Map<string, ArrayList<Option<byte>>>），
            // 64 极其宽松。
            int td = typeArgDepth(tas.get(0));
            if (td > 64) {
                diag_.error(0, 0, "generic type nested too deeply (" + td + " > 64) while instantiating '" + cn + "' — limit nested generic instantiation depth");
                return;
            }
            // 纵深防御：递归计数器（typeArgDepth 未覆盖的路径也不得超 64）。
            if (instDepth_ >= 64) {
                diag_.error(0, 0, "generic type nested too deeply (>64) while instantiating '" + cn + "'");
                return;
            }
            instDepth_ = instDepth_ + 1;
            // C++ has_placeholder：类型实参是当前泛型参数占位符（T/E）→ 延迟实例化，
            // 否则模板体内 `new Option<T>()` 会生成 Option_T_inst 幽灵实例。
            int proceed = 1;
            for (int i = 0; i < tas.size() && proceed != 0; i = i + 1) {
                AstType ta = tas.get(i);
                if (ta != null && (inGeneric(ta.className()) != 0 || inGeneric(ta.basicName()) != 0)) proceed = 0;
            }
            if (proceed != 0) {
                for (int i = 0; i < tas.size(); i = i + 1) {
                    AstType ta = tas.get(i);
                    if (ta != null && ta.typeArgs().size() > 0) tryInstantiate(ta.className(), ta.typeArgs());
                }
                if (isGenericClass(cn) != 0) instantiateClass(cn, tas);
            }
            instDepth_ = instDepth_ - 1;
        }
        // F4-G1：泛型静态方法调用是否命中注册模板（返回索引，-1 = 否）
        int findGenericStatic(AstExpr callee) {
            if (callee == null || callee.kind() != "Member") return -1;
            AstExpr obj = callee.array();
            if (obj == null || obj.kind() != "Identifier") return -1;
            string key = obj.name() + "." + callee.memberName();
            for (int i = 0; i < gsKeys_.size(); i = i + 1) {
                if (gsKeys_.get(i) == key) return i;
            }
            return -1;
        }
        // 泛型静态方法：实例化 __gs_Class_method_<types>_inst 并设置调用 resolved。
        // 参考：C++ resolveGenericStaticCall（src/sema/sema_expr.cpp）。
        string resolveGenericStaticCall(AstExpr e, AstExpr callee, int gsi) {
            string clsName = gsClasses_.get(gsi);
            AstAction templ = gsActions_.get(gsi);
            ArrayList<string> tps = templ.typeParams();
            int ntp = tps.size();
            // 1) 访问实参（置 argsVisited_ 防止共享 Call 尾部二次访问）
            for (int i = 0; i < e.args().size(); i = i + 1) visitExpr(e.args().get(i));
            e.setArgsVisited(1);
            // 2) 解析具体类型实参（显式 <T1,...> 或从实参推导）
            ArrayList<AstType> concrete = new ArrayList<AstType>();
            ArrayList<AstType> cta = e.callTypeArgs();
            if (cta.size() > 0) {
                if (cta.size() != ntp) {
                    diag_.error(e.line(), e.col(), "generic static method '" + clsName + "." + templ.name() + "' expects " + ntp + " type argument(s), got " + cta.size());
                    return "void";
                }
                for (int i = 0; i < ntp; i = i + 1) concrete.add(cta.get(i));
            } else {
                ArrayList<AstParam> tps2 = templ.params();
                for (int ti = 0; ti < ntp; ti = ti + 1) {
                    int found = 0;
                    for (int pi = 0; pi < tps2.size() && pi < e.args().size(); pi = pi + 1) {
                        AstType pt = tps2.get(pi).type();
                        if (pt == null) continue;
                        if (Str.len(pt.className()) != 0 && pt.className() == tps.get(ti)
                            && pt.typeArgs().size() == 0 && pt.element() == null) {
                            concrete.add(argToAstType(e.args().get(pi)));
                            found = 1;
                            break;
                        }
                        if (pt.element() != null && Str.len(pt.element().className()) != 0
                            && pt.element().className() == tps.get(ti)
                            && pt.element().typeArgs().size() == 0) {
                            AstType at = argElemToAstType(e.args().get(pi));
                            if (at != null) { concrete.add(at); found = 1; break; }
                        }
                    }
                    if (found == 0) {
                        diag_.error(e.line(), e.col(), "cannot infer type parameter '" + tps.get(ti) + "' for generic static method '" + clsName + "." + templ.name() + "' (pass explicit args: " + clsName + "." + templ.name() + "<...>(...))");
                        return "void";
                    }
                }
            }
            // 3) mangling（C++ 全局去重）
            string mangled = "__gs_" + clsName + "_" + templ.name();
            for (int i = 0; i < concrete.size(); i = i + 1) mangled = mangled + "_" + gsTypeArgName(concrete.get(i));
            mangled = mangled + "_inst";
            // 4) 查找或创建实例函数（顶层 Function，去重）
            AstFunction inst = null;
            for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                if (tu_.functions().get(i).name() == mangled) { inst = tu_.functions().get(i); break; }
            }
            if (inst == null) {
                inst = cloneStaticToFunction(templ, mangled, tps, concrete);
                tu_.functions().add(inst);
            }
            // 5) 设置调用节点：resolved + 返回类型（T → 具体类型）
            e.setResolved(mangled);
            AstType sret = substituteType(templ.ret(), tps, concrete);
            // C++ typeNodeToTypeInfo 会触发返回类型的泛型类实例化（如 Option<int>）
            if (sret != null && sret.typeArgs().size() > 0) {
                tryInstantiate(sret.className(), sret.typeArgs());
            }
            string rk = sret != null ? typeToKind(sret) : "void";
            if (rk == "class" || rk == "struct" || rk == "interface") {
                string vc = gsRetValueClass(sret);
                if (Str.len(vc) != 0) e.setValueClass(vc);
            }
            e.setResolvedKind(rk);
            // C++ 不解析 callee（Member 保持 resolvedClass="" : int）
            callee.setResolvedKind("int");
            AstExpr mobj = callee.array();
            if (mobj != null) mobj.setResolvedKind("int");
            return rk;
        }
        // AstAction 泛型模板 → AstFunction 实例（C++ FuncDecl inst 形态）
        AstFunction cloneStaticToFunction(AstAction a, string name, ArrayList<string> tps, ArrayList<AstType> concrete) {
            AstFunction nf = new AstFunction();
            nf.setName(name);
            nf.setRet(substituteType(a.ret(), tps, concrete));
            nf.setGenericInst(1);
            nf.setRegion(a.region());
            nf.setCoro(a.coro());
            nf.setAsync(a.async());
            nf.setStack(a.stack());
            for (int j = 0; j < a.typeParams().size(); j = j + 1) nf.typeParams().add(a.typeParams().get(j));
            for (int j = 0; j < concrete.size(); j = j + 1) nf.instTypeArgs().add(concrete.get(j));
            for (int j = 0; j < a.params().size(); j = j + 1) nf.params().add(cloneParam(a.params().get(j), tps, concrete));
            nf.setBody(a.body());
            return nf;
        }
        // __gs_ 后缀：C++ typeName（原始→名、类→名/实例名、数组→elem[]）
        string gsTypeArgName(AstType t) {
            if (t == null) return "int";
            if (t.element() != null) return gsTypeArgName(t.element()) + "[]";
            if (Str.len(t.className()) != 0) {
                if (t.typeArgs().size() > 0) return instClassName(t);
                return t.className();
            }
            return t.basicName();
        }
        // 实参表达式 → 类型节点（C++ TypeNodeFromTypeInfo），供泛型推导
        AstType argToAstType(AstExpr a) {
            AstType t = new AstType();
            if (a == null) { t.setBasicName("int"); return t; }
            if (a.kind() == "Tuple") {
                t.setIsTuple(1);
                for (int i = 0; i < a.elements().size(); i = i + 1) {
                    t.funcParamTypes().add(argToAstType(a.elements().get(i)));
                }
                return t;
            }
            if (a.kind() == "Identifier") {
                SymbolEntry en = sym_.lookupEntry(a.name());
                if (en != null) {
                    if (Str.len(en.elementType()) != 0 || Str.len(en.elementClass()) != 0) {
                        AstType el = new AstType();
                        if (Str.len(en.elementClass()) != 0) el.setClassName(en.elementClass());
                        else el.setBasicName(en.elementType());
                        t.setElement(el);
                        return t;
                    }
                    if (Str.len(en.className()) != 0) { t.setClassName(en.className()); return t; }
                }
            }
            string rk = a.resolvedKind();
            if (rk == "class") {
                string cn = a.valueClass();
                if (Str.len(cn) == 0) cn = a.resolvedClass();
                if (Str.len(cn) != 0) t.setClassName(cn);
                else t.setBasicName(rk);
                return t;
            }
            t.setBasicName(rk);
            return t;
        }
        // T[] 形参：实参数组的元素类型
        AstType argElemToAstType(AstExpr a) {
            if (a == null) return null;
            if (a.kind() == "Identifier") {
                SymbolEntry en = sym_.lookupEntry(a.name());
                if (en != null) {
                    AstType el = new AstType();
                    if (Str.len(en.elementClass()) != 0) el.setClassName(en.elementClass());
                    else if (Str.len(en.elementType()) != 0) el.setBasicName(en.elementType());
                    else el.setBasicName("int");
                    return el;
                }
            }
            return null;
        }
        // 返回类型类名（供链式调用 valueClass）
        string gsRetValueClass(AstType t) {
            if (t == null) return "";
            if (Str.len(t.className()) != 0 && t.className() != "slice") {
                if (t.typeArgs().size() > 0) return instClassName(t);
                return t.className();
            }
            return "";
        }
        // 接口方法返回类型
        string findIfaceMethodRet(string ifc, string meth) {
            for (int i = 0; i < interfaceMethods_.size(); i = i + 1) {
                MethodSig s = interfaceMethods_.get(i);
                if (s.cls() == ifc && s.meth() == meth) return s.ret();
            }
            return "";
        }
        // 类方法（含接口）是否存在
        int hasMethodAny(string cls, string meth) {
            if (hasMethod(cls, meth) != 0) return 1;
            if (Str.len(findIfaceMethodRet(cls, meth)) != 0) return 1;
            return 0;
        }
        string genericConstraintInterface(string name) {
            if (tu_ == null) return "";
            for (int i = 0; i < tu_.classes().size(); i = i + 1) {
                AstClass cls = tu_.classes().get(i);
                if (cls.name() != currentClass_) continue;
                for (int j = 0; j < cls.constraints().size(); j = j + 1) {
                    AstPair constraint = cls.constraints().get(j);
                    if (constraint.k() == name && inInterface(constraint.v()) != 0) return constraint.v();
                }
                break;
            }
            return "";
        }
        int isGenericAssocType(string name) {
            for (int i = 1; i + 1 < Str.len(name); i = i + 1) {
                if (Str.substring(name, i, i + 2) == "::") {
                    return inGeneric(Str.substring(name, 0, i));
                }
            }
            return 0;
        }
        // 声明参数并访问其默认值表达式（类型推断）。checkDefault=1 时按 C++
        // checkParamDefaults 校验默认值类型（struct 方法不校验）。
        void declareParam(AstParam p, int checkDefault) {
            AstExpr defaultExpr = p.defaultExpression();
            if (checkDefault != 0 && defaultExpr != null) {
                string defaultKind = visitExpr(defaultExpr);
                string paramKind = p.type() != null ? typeToKind(p.type()) : "void";
                if (Str.len(paramKind) != 0 && paramKind != "void" && typesCompat(paramKind, defaultKind) == 0) {
                    AstExpr de = defaultExpr;
                    int dline = de.line();
                    int dcol = de.col();
                    diag_.error(dline, dcol, "default value for parameter '" + p.name()
                        + "' has type '" + defaultKind + "', expected '" + paramKind + "'");
                }
            } else if (checkDefault == 0 && defaultExpr != null) {
                // C++ 不访问 struct 方法默认值（保持默认 Int）→ 整树标 int
                markAllExpr(defaultExpr);
            }
            AstType pt = p.type();
            if (pt != null && pt.typeArgs().size() > 0) tryInstantiate(pt.className(), pt.typeArgs());
            if (pt != null && pt.isTuple() != 0 && pt.funcParamTypes().size() != 0) {
                sym_.declareTuple(p.name(), "tuple", pt.funcParamTypes());
            } else if (pt != null && pt.element() != null) {
                AstType el = pt.element();
                if (Str.len(el.className()) != 0) sym_.declareElemClass(p.name(), "array", typeToKind(el), el.className());
                else sym_.declareElem(p.name(), "array", typeToKind(el));
            } else if (pt != null && pt.className() == "slice") {
                AstType sl = pt.typeArgs().size() > 0 ? pt.typeArgs().get(0) : null;
                if (sl != null && Str.len(sl.className()) != 0) {
                    AstType sl2b = sl.typeArgs().size() > 0 ? sl.typeArgs().get(0) : null;
                    sym_.declareElemClass2(p.name(), "slice", typeToKind(sl), sl.className(), sl2b != null ? typeToKind(sl2b) : "");
                }
                else sym_.declareElem(p.name(), "slice", sl != null ? typeToKind(sl) : "int");
            } else if (pt != null && pt.funcReturn() != null) {
                // F4-L：函数类型形参 (int)->int f → 记录返回类型，供 f(v) 调用解析
                // （此前缺此分支，函数形参调用被解析成 void）。
                string fret = typeToKind(pt.funcReturn());
                sym_.declareFunc(p.name(), fret, pt.funcParamTypes());
            } else if (pt != null && Str.len(pt.className()) != 0) {
                string constrainedIface = genericConstraintInterface(pt.className());
                if (Str.len(constrainedIface) != 0) sym_.declareClass(p.name(), "interface", constrainedIface);
                else if (inGeneric(pt.className()) != 0) sym_.declare(p.name(), "int");
                else if (isGenericAssocType(pt.className()) != 0) sym_.declare(p.name(), "assoc");
                else if (pt.typeArgs().size() > 0) sym_.declareClassInst(p.name(), typeToKind(pt), instClassName(pt), pt.typeArgs());
                else sym_.declareClass(p.name(), typeToKind(pt), instClassName(pt));
            } else {
                sym_.declare(p.name(), typeToKind(pt));
            }
        }
        string findPropType(int ci, string name) {
            ArrayList<AstProp> ps = classProps_.get(ci);
            for (int i = 0; i < ps.size(); i = i + 1) {
                if (ps.get(i).name() == name) return ps.get(i).type() != null ? typeToKind(ps.get(i).type()) : "int";
            }
            return "";
        }
        AstType findPropTypeAst(int ci, string name) {
            ArrayList<AstProp> ps = classProps_.get(ci);
            for (int i = 0; i < ps.size(); i = i + 1) {
                if (ps.get(i).name() == name) return ps.get(i).type();
            }
            return null;
        }
        // 属性类型的具体类名（供 obj.prop.method() 链式解析）
        string findPropTypeClass(int ci, string name) {
            AstType pt = findPropTypeAst(ci, name);
            if (pt != null && Str.len(pt.className()) != 0) {
                if (pt.typeArgs().size() > 0) return instClassName(pt);
                return pt.className();
            }
            return "";
        }

        // ---- 泛型方法：C++ 跳过其 body（resolved_kind 保持默认 Int）→ 全部标 int ----
        void markAllStmt(AstStmt s) {
            if (s == null) return;
            string k = s.kind();
            if (k == "Block") {
                for (int i = 0; i < s.bodyStmts().size(); i = i + 1) markAllStmt(s.bodyStmts().get(i));
            } else if (k == "ExprStmt") {
                if (s.expr() != null) markAllExpr(s.expr());
            } else if (k == "VarDecl") {
                for (int i = 0; i < s.decls().size(); i = i + 1) {
                    if (s.decls().get(i).init() != null) markAllExpr(s.decls().get(i).init());
                }
            } else if (k == "If") {
                if (s.condition() != null) markAllExpr(s.condition());
                if (s.then() != null) markAllStmt(s.then());
                if (s.elseBranch() != null) markAllStmt(s.elseBranch());
            } else if (k == "While") {
                if (s.condition() != null) markAllExpr(s.condition());
                if (s.body() != null) markAllStmt(s.body());
            } else if (k == "For") {
                if (s.init() != null) markAllStmt(s.init());
                if (s.condition() != null) markAllExpr(s.condition());
                if (s.step() != null) markAllExpr(s.step());
                if (s.body() != null) markAllStmt(s.body());
            } else if (k == "Return") {
                if (s.value() != null) markAllExpr(s.value());
            } else if (k == "ForIn") {
                if (s.iterable() != null) markAllExpr(s.iterable());
                if (s.body() != null) markAllStmt(s.body());
            } else if (k == "Throw") {
                if (s.expr() != null) markAllExpr(s.expr());
            } else if (k == "Match") {
                if (s.subject() != null) markAllExpr(s.subject());
                for (int i = 0; i < s.arms().size(); i = i + 1) {
                    if (s.arms().get(i).body() != null) markAllStmt(s.arms().get(i).body());
                }
            } else if (k == "Try") {
                if (s.tryBlock() != null) markAllStmt(s.tryBlock());
                for (int i = 0; i < s.catches().size(); i = i + 1) {
                    if (s.catches().get(i).block() != null) markAllStmt(s.catches().get(i).block());
                }
                if (s.finallyBlock() != null) markAllStmt(s.finallyBlock());
            } else if (k == "GpuTile") {
                if (s.gridExpr() != null) markAllExpr(s.gridExpr());
                if (s.stream() != null) markAllExpr(s.stream());
                if (s.body() != null) markAllStmt(s.body());
            } else if (k == "GpuReduce" || k == "GpuScan") {
                if (s.opBody() != null) markAllStmt(s.opBody());
                if (s.opExpr() != null) markAllExpr(s.opExpr());
                if (s.initExpr() != null) markAllExpr(s.initExpr());
                if (s.beginExpr() != null) markAllExpr(s.beginExpr());
                if (s.endExpr() != null) markAllExpr(s.endExpr());
                if (s.body() != null) markAllStmt(s.body());
            } else if (k == "GpuScatter") {
                if (s.aBegin() != null) markAllExpr(s.aBegin());
                if (s.aEnd() != null) markAllExpr(s.aEnd());
                if (s.idxBegin() != null) markAllExpr(s.idxBegin());
                if (s.idxEnd() != null) markAllExpr(s.idxEnd());
                if (s.body() != null) markAllStmt(s.body());
            } else if (k == "GpuFor") {
                if (s.body() != null) markAllStmt(s.body());
            } else {
                if (s.expr() != null) markAllExpr(s.expr());
            }
        }
        void markAllExpr(AstExpr e) {
            if (e == null) return;
            e.setResolvedKind("int");
            if (e.kind() == "Binary" || e.kind() == "Assign" || e.kind() == "Pipe") {
                if (e.lhs() != null) markAllExpr(e.lhs());
                if (e.rhs() != null) markAllExpr(e.rhs());
            } else if (e.kind() == "Unary" || e.kind() == "Convert" || e.kind() == "Await") {
                if (e.operand() != null) markAllExpr(e.operand());
                if (e.timeout() != null) markAllExpr(e.timeout());
            } else if (e.kind() == "Call") {
                if (e.callee() != null) markAllExpr(e.callee());
                for (int i = 0; i < e.args().size(); i = i + 1) markAllExpr(e.args().get(i));
            } else if (e.kind() == "Member" || e.kind() == "Subscript") {
                if (e.array() != null) markAllExpr(e.array());
                if (e.index() != null) markAllExpr(e.index());
            } else if (e.kind() == "New") {
                for (int i = 0; i < e.args().size(); i = i + 1) markAllExpr(e.args().get(i));
            } else if (e.kind() == "NewArray") {
                for (int i = 0; i < e.dimensions().size(); i = i + 1) markAllExpr(e.dimensions().get(i));
            } else if (e.kind() == "Ternary") {
                if (e.condition() != null) markAllExpr(e.condition());
                if (e.trueExpr() != null) markAllExpr(e.trueExpr());
                if (e.falseExpr() != null) markAllExpr(e.falseExpr());
            } else if (e.kind() == "Range") {
                if (e.start() != null) markAllExpr(e.start());
                if (e.end() != null) markAllExpr(e.end());
            } else if (e.kind() == "Tuple") {
                for (int i = 0; i < e.elements().size(); i = i + 1) markAllExpr(e.elements().get(i));
            } else if (e.kind() == "NamedArg") {
                if (e.namedValue() != null) markAllExpr(e.namedValue());
            } else if (e.kind() == "TryExpr") {
                if (e.tryExpr() != null) markAllExpr(e.tryExpr());
                if (e.catchExpr() != null) markAllExpr(e.catchExpr());
            } else if (e.kind() == "Lambda") {
                if (e.bodyStmt() != null) markAllStmt(e.bodyStmt());
            } else if (e.kind() == "Quote") {
                if (e.bodyStmt() != null) markAllStmt(e.bodyStmt());
            } else if (e.kind() == "EnumVariant") {
                for (int i = 0; i < e.args().size(); i = i + 1) markAllExpr(e.args().get(i));
            }
        }

        // ---- 语句 ----
        void visitStmt(AstStmt s) {
            string k = s.kind();
            if (k == "Block") {
                sym_.enterScope();
                for (int i = 0; i < s.bodyStmts().size(); i = i + 1) visitStmt(s.bodyStmts().get(i));
                sym_.leaveScope();
            } else if (k == "ExprStmt") {
                AstExpr xe = s.expr();
                if (xe != null) {
                    if (inMain_ != 0 && xe.kind() == "Call") {
                        AstExpr clx = xe.callee();
                        if (clx != null && (clx.kind() == "Identifier" || clx.kind() == "Member")) {
                            // __myp_* 编译器内建（内联汇编/直发 LLVM，不经 runtime 与
                            // mapping）：允许 main() 内直调——freestanding/libmyp 探针
                            //（档B；镜像 C++ sema 豁免）。
                            if (clx.kind() == "Identifier" && Str.startsWith(clx.name(), "__myp_") != 0) {
                                int savedDiscard = inDiscardStmt_;
                                if (xe.kind() == "Call") inDiscardStmt_ = 1;
                                visitExpr(xe);
                                inDiscardStmt_ = savedDiscard;
                            } else {
                                if (clx.kind() == "Member" && clx.array() != null) visitExpr(clx.array());
                                int ml = xe.line();
                                int mc = xe.col();
                                diag_.error(ml, mc, "direct function call not allowed in main() — use mapping() instead");
                                xe.setResolvedKind("int");
                                clx.setResolvedKind("int");
                                // args 不 visit，标记 int（C++ 默认 Int）
                                ArrayList<AstExpr> xa = xe.args();
                                for (int xi = 0; xi < xa.size(); xi = xi + 1) {
                                    markAllExpr(xa.get(xi));
                                }
                            }
                        } else {
                            visitExpr(xe);
                        }
                    } else {
                        int savedDiscard = inDiscardStmt_;
                        if (xe.kind() == "Call") inDiscardStmt_ = 1;
                        visitExpr(xe);
                        inDiscardStmt_ = savedDiscard;
                    }
                }
            } else if (k == "VarDecl") {
                for (int i = 0; i < s.decls().size(); i = i + 1) {
                    AstVar v = s.decls().get(i);
                    AstType vt3 = v.type();
                    if (v.thread() != 0) threadVars_.add(v.name());
                    if (vt3 != null && vt3.typeArgs().size() > 0) {
                        if (checkGenericClassConstraint(vt3.className(), vt3.typeArgs(), s.line(), s.col()) == 0) {
                            tryInstantiate(vt3.className(), vt3.typeArgs());
                        }
                    }
                    string vt = typeToKind(vt3);
                    // BUG-007 镜像 C++：bitvector<N> 宽度必须 ∈ {8,16,32,64}——
                    // 此前不校验，bitvector<3> 静默映射为 i32。宽度 0 为合成默认跳过。
                    if (vt3 != null && vt3.basicName() == "bitvector" && vt3.bitvectorWidth() != 0) {
                        int bw = vt3.bitvectorWidth();
                        if (bw != 8 && bw != 16 && bw != 32 && bw != 64) {
                            int dl = vt3.line();
                            int dc = vt3.col();
                            if (dl == 0) { dl = v.nameLine(); dc = v.nameCol(); }
                            if (dl == 0) { dl = s.line(); dc = s.col(); }
                            diag_.error(dl, dc, "bitvector<N> width must be one of 8, 16, 32, 64 (got " + bw + ")");
                            continue;
                        }
                    }
                    // void 变量检查（C++：cannot declare variable of type 'void' / unknown type）
                    if (vt3 != null && vt == "void") {
                        // 位置 = 类型 token（C++ decl.range 指向类型，非变量名）
                        int dl = 0;
                        int dc = 0;
                        if (vt3.line() != 0 && vt3.col() != 0) { dl = vt3.line(); dc = vt3.col(); }
                        else { dl = v.nameLine(); dc = v.nameCol(); }
                        if (dl == 0) { dl = s.line(); dc = s.col(); }
                        string cn2 = vt3.className();
                        if (Str.len(cn2) != 0) {
                            diag_.error(dl, dc, "unknown type '" + cn2 + "'");
                        } else {
                            diag_.error(dl, dc, "cannot declare variable of type 'void'");
                        }
                        // C++ visitVarDecl 对 void/unknown 类型提前 return：不访问 init
                        //（保持默认 Int）、不声明变量 → 后续引用报 undefined symbol。
                        if (v.init() != null) markAllExpr(v.init());
                        continue;
                    }
                    string it = "void";
                    int errBefore = diag_.errorCount();
                    if (v.init() != null) {
                        // MYP 注意：链式字段访问（v.init_.kind_）产生垃圾 → 先用局部变量。
                        AstExpr initLocal = v.init();
                        // F4-L：lambda 赋给函数类型变量 → 设名字（命名 lambda 自引用），
                        // visitLambda 据此合成 __lambda_N 类。上下文返回类型 = 声明返回类型
                        //（C++ visitVarDecl 传 expected_fn 给 visitLambda）。
                        // MYP 注意：链式字段访问（v.type_.funcReturn_）产生垃圾 → 先取局部。
                        AstType vtLambda = v.type();
                        if (initLocal.kind() == "Lambda" && vt == "function") {
                            initLocal.setName(v.name());
                            if (vtLambda != null) {
                                AstType frLambda = vtLambda.funcReturn();
                                if (frLambda != null) lambdaExpectedRet_ = frLambda;
                            }
                        }
                        it = visitExpr(initLocal);
                        lambdaExpectedRet_ = null;
                        if (initLocal.kind() == "Lambda") initLocal.setResolvedKind("int");
                    }
                    // BUG-016：`var r = voidCall();` 推断为 void 此前放行 → codegen 用
                    // Int(i32) alloca 存 void 值 → LLVM getPrefTypeAlign(void) 无限递归段错误。
                    // void 值不能赋给变量，应报错（仅当有初始化器、且 visitExpr 未级联报错时补报；
                    // `var x;` 无 init 由 C++ "'var' declaration requires an initializer' 拒绝）。
                    if (v.init() != null && v.isInferred() != 0
                        && diag_.errorCount() == errBefore && it == "void") {
                        int dl = v.nameLine();
                        int dc = v.nameCol();
                        if (dl == 0) { dl = s.line(); dc = s.col(); }
                        diag_.error(dl, dc, "cannot infer type of 'var' from a void expression");
                        continue;
                    }
                    // BUG-022 镜像 C++：`@thread` 只能用于 class 实例变量——struct 是
                    // 值类型，@thread 启动工作线程托管实例对 struct 静默无效果（此前
                    // 接受）。var 推断用 it（init 解析类型），显式类型用 vt。
                    if (v.thread() != 0) {
                        string eff = v.isInferred() != 0 ? it : vt;
                        if (eff != "class") {
                            int dl = v.nameLine();
                            int dc = v.nameCol();
                            if (dl == 0) { dl = s.line(); dc = s.col(); }
                            diag_.error(dl, dc, "'@thread' can only be applied to a class instance variable");
                            continue;
                        }
                    }
                    // 类型检查（C++：cannot initialize variable ...）
                    // BUG-016：已知 void 值赋给非 void 变量（int x = voidCall();）——C++ 同补报；
                    // 仅当有初始化器、且 visitExpr 未级联报错（it=="void" 确为 void 调用，
                    // 非无 init 声明 / 未解析表达式）时。
                    if (v.init() != null && v.type() != null && Str.len(it) != 0 && v.isInferred() == 0) {
                        int reported = diag_.errorCount() > errBefore ? 1 : 0;
                        int bad = 0;
                        if (reported == 0 && it == "void") bad = 1;
                        else if (it != "void" && typesCompat(vt, it) == 0) bad = 1;
                        // BUG-054：struct 初始化须比较具体 struct 名（typesCompat 只比
                        // kind "struct"；`A a = b;`（b 为 B）静默过 sema → LLVM opt 报错）。
                        else if (it == "struct" && vt == "struct") {
                            string dt = Str.len(v.type().className()) != 0 ? v.type().className() : v.type().basicName();
                            string di = exprStructName(v.init());
                            if (Str.len(dt) != 0 && Str.len(di) != 0 && dt != di) bad = 1;
                        }
                        if (bad != 0) {
                            int dl = v.nameLine();
                            int dc = v.nameCol();
                            if (dl == 0) { dl = s.line(); dc = s.col(); }
                            string itn = it;
                            string vtn = vt;
                            if (it == "struct" && vt == "struct") {
                                itn = exprStructName(v.init());
                                vtn = Str.len(v.type().className()) != 0 ? v.type().className() : v.type().basicName();
                                if (Str.len(itn) == 0) itn = "struct";
                            }
                            diag_.error(dl, dc, "cannot initialize variable '" + v.name()
                                + "' of type '" + typeNameOf(vtn, v.type()) + "' with value of type '" + typeNameOf(itn, null) + "'");
                        }
                    }
                    // tuple arity/元素检查（C++ typesCompatible 对 tuple 比较）
                    if (v.type() != null && v.type().isTuple() != 0 && v.init() != null && v.isInferred() == 0) {
                        AstExpr tie = v.init();
                        if (tie != null && tie.kind() == "Tuple") {
                            ArrayList<AstExpr> tels = tie.elements();
                            ArrayList<AstType> wtys = v.type().funcParamTypes();
                            int bad = 0;
                            if (wtys.size() != tels.size()) bad = 1;
                            else {
                                for (int ei = 0; ei < tels.size(); ei = ei + 1) {
                                    string et2 = tels.get(ei) != null ? tels.get(ei).resolvedKind() : "void";
                                    string wt2 = typeToKind(wtys.get(ei));
                                    if (typesCompat(wt2, et2) == 0) { bad = 1; break; }
                                }
                            }
                            if (bad != 0) {
                                int dl = v.nameLine();
                                int dc = v.nameCol();
                                if (dl == 0) { dl = s.line(); dc = s.col(); }
                                string declName = tupleDeclName(wtys);
                                string valName = tupleValName(tels);
                                diag_.error(dl, dc, "cannot initialize variable '" + v.name()
                                    + "' of type '" + declName + "' with value of type '" + valName + "'");
                            }
                        }
                    }
                    AstType vt2 = v.type();
                    if (v.isInferred() != 0) {
                        // F4：var 推断——用初始值类型声明（C++ infer from init）
                        if (it == "class") {
                            AstExpr iev2 = v.init();
                            string icn = "";
                            if (iev2 != null && Str.len(iev2.resolvedClass()) != 0) icn = iev2.resolvedClass();
                            if (Str.len(icn) != 0) sym_.declareClass(v.name(), "class", icn);
                            else sym_.declare(v.name(), it);
                        } else if (it == "array") {
                            AstExpr iev3 = v.init();
                            string elemK = "int";
                            if (iev3 != null && iev3.kind() == "NewArray" && iev3.elemType() != null) elemK = typeToKind(iev3.elemType());
                            sym_.declareElem(v.name(), "array", elemK);
                        } else if (it == "function") {
                            sym_.declare(v.name(), "function");
                        } else {
                            sym_.declare(v.name(), it);
                        }
                    } else if (vt2 != null && vt2.isTuple() != 0 && vt2.funcParamTypes().size() != 0) {
                        sym_.declareTuple(v.name(), "tuple", vt2.funcParamTypes());
                    } else if (vt2 != null && vt2.element() != null) {
                        AstType el2 = vt2.element();
                        if (Str.len(el2.className()) != 0 && vt2.arraySize() > 0) sym_.declareFixedElemClass(v.name(), typeToKind(el2), el2.className(), vt2.arraySize());
                        else if (Str.len(el2.className()) != 0) sym_.declareElemClass(v.name(), "array", typeToKind(el2), el2.className());
                        else if (vt2.arraySize() > 0) sym_.declareFixedElem(v.name(), typeToKind(el2), vt2.arraySize());
                        else sym_.declareElem(v.name(), "array", typeToKind(el2));
                    } else if (vt2 != null && vt2.className() == "slice") {
                        AstType sl2 = vt2.typeArgs().size() > 0 ? vt2.typeArgs().get(0) : null;
                        if (sl2 != null && Str.len(sl2.className()) != 0) {
                            AstType sl2b = sl2.typeArgs().size() > 0 ? sl2.typeArgs().get(0) : null;
                            sym_.declareElemClass2(v.name(), "slice", typeToKind(sl2), sl2.className(), sl2b != null ? typeToKind(sl2b) : "");
                        }
                        else sym_.declareElem(v.name(), "slice", sl2 != null ? typeToKind(sl2) : "int");
                    } else if (vt2 != null && Str.len(vt2.className()) != 0) {
                        if (inGeneric(vt2.className()) != 0) sym_.declare(v.name(), "int");
                        else if (vt2.typeArgs().size() > 0) sym_.declareClassInst(v.name(), typeToKind(vt2), instClassName(vt2), vt2.typeArgs());
                        else {
                            // B3：接口变量 + new 具体类初始化 → 把具体实现类记到
                            // 符号条目（作用域感知，C++ var_class_map_ 镜像），供
                            // 关联类型方法调用解析返回类型。
                            string vconc = "";
                            if (inInterface(vt2.className()) != 0 && v.init() != null && v.init().kind() == "New") {
                                AstExpr nic = v.init();
                                string icls = nic.resolvedClass();
                                if (Str.len(icls) == 0) icls = nic.className();
                                if (Str.len(icls) != 0) vconc = icls;
                            }
                            if (Str.len(vconc) != 0) sym_.declareClassConcrete(v.name(), typeToKind(vt2), instClassName(vt2), vconc);
                            else sym_.declareClass(v.name(), typeToKind(vt2), instClassName(vt2));
                        }
                    } else if (vt2 != null && vt2.funcReturn() != null) {
                        // F4-L：函数类型变量 (A)->R f → 记录返回类型供调用 f(...) 解析
                        string fret = typeToKind(vt2.funcReturn());
                        sym_.declareFunc(v.name(), fret, vt2.funcParamTypes());
                    } else {
                        sym_.declare(v.name(), vt);
                    }
                }
            } else if (k == "If") {
                if (s.condition() != null) visitExpr(s.condition());
                // §3.3 kernel 上下文内 if 分支 = 发散控制流（aligned barrier 需 uniform）
                int savedDiv = inGpuDivergent_;
                if (inGpuFor_ != 0) inGpuDivergent_ = inGpuDivergent_ + 1;
                if (s.then() != null) visitStmt(s.then());
                if (s.elseBranch() != null) visitStmt(s.elseBranch());
                inGpuDivergent_ = savedDiv;
            } else if (k == "While") {
                if (s.condition() != null) visitExpr(s.condition());
                loopDepth_ = loopDepth_ + 1;
                int savedDiv2 = inGpuDivergent_;
                if (inGpuFor_ != 0) inGpuDivergent_ = inGpuDivergent_ + 1;
                if (s.body() != null) visitStmt(s.body());
                inGpuDivergent_ = savedDiv2;
                loopDepth_ = loopDepth_ - 1;
            } else if (k == "For") {
                // block(...) 仅限 @gpu for；@gpu for 的 block 大小校验（C++）
                if (s.block() != 0 && s.gpu() == 0) {
                    diag_.error(s.line(), s.col(), "'block(...)' is only valid on '@gpu for'");
                } else if (s.gpu() != 0 && s.block() != 0) {
                    if (s.block() % 32 != 0) {
                        diag_.error(s.line(), s.col() + 5, "'block(...)' size must be a multiple of 32 (warp size)");
                    } else if (s.block() > 1024) {
                        diag_.error(s.line(), s.col() + 5, "'block(...)' size exceeds maxThreadsPerBlock (1024)");
                    }
                }
                int savedForGpu = inGpuFor_;
                int savedForKernel = inGpuKernel_;
                if (s.gpu() != 0 || s.parallel() != 0) {
                    if (s.stream() != null) visitExpr(s.stream());
                    inGpuFor_ = 1;
                }
                // 字符串仅 GPU 内核禁用（NVPTX 无 string runtime）；@parallel for
                // 是 CPU 线程池 body（普通 CPU 函数，可安全用字符串/字面量）。
                if (s.gpu() != 0) inGpuKernel_ = 1;
                if (s.init() != null) visitStmt(s.init());                if (s.condition() != null) visitExpr(s.condition());
                if (s.step() != null) visitExpr(s.step());
                loopDepth_ = loopDepth_ + 1;
                if (s.body() != null) visitStmt(s.body());
                loopDepth_ = loopDepth_ - 1;
                inGpuFor_ = savedForGpu;
                inGpuKernel_ = savedForKernel;
            } else if (k == "Break" || k == "Continue") {
                if (loopDepth_ == 0) {
                    diag_.error(s.line(), s.col(), "break/continue outside loop");
                }
            } else if (k == "Return") {
                if (s.value() != null) {
                    string rt = visitExpr(s.value());
                    // 返回类型检查（C++：cannot return value ...，位置 = return 语句）
                    if (Str.len(currentRet_) != 0 && currentRet_ != "void"
                        && Str.len(rt) != 0 && rt != "void" && typesCompat(currentRet_, rt) == 0) {
                        diag_.error(s.line(), s.col(), "cannot return value of type '" + rt
                            + "' from function returning '" + currentRet_ + "'");
                    }
                }
            } else if (k == "ForIn") {
                AstExpr iterable = s.iterable();
                if (iterable != null) visitExpr(iterable);
                string elemType = "void";
                if (iterable != null && iterable.kindName() == "Range") {
                    elemType = "int";
                    s.setIterKind(3);
                } else if (iterable != null && iterable.kindName() == "Identifier") {
                    SymbolEntry iterableSym = sym_.lookupEntry(iterable.identifierName());
                    if (iterableSym != null && iterableSym.kind() == "array" && iterableSym.arraySize() > 0) {
                        elemType = iterableSym.elementKind();
                        s.setIterKind(1);
                        s.setArrSize(iterableSym.arraySize());
                        if (Str.len(iterableSym.elementClass()) != 0) elemType = "class:" + iterableSym.elementClass();
                    } else if (iterableSym != null && iterableSym.kind() == "slice") {
                        elemType = iterableSym.elementKind();
                        s.setIterKind(2);
                        if (Str.len(iterableSym.elementClass()) != 0) elemType = "class:" + iterableSym.elementClass();
                    } else if (iterableSym != null && iterableSym.kind() == "class" && Str.len(iterableSym.className()) != 0) {
                        string className = iterableSym.className();
                        string baseName = resolveBase(className);
                        AstType getAst = findMethodRetAst(baseName, "get");
                        string getType = substRet(baseName, getAst, iterableSym);
                        if (Str.len(getType) != 0) {
                            elemType = getType;
                            if (findClass(getType) >= 0) elemType = "class:" + getType;
                            s.setClassName(className);
                            s.setSizeFn(className + "_size");
                            s.setGetFn(className + "_get");
                        }
                    }
                }
                if (elemType != "void") {
                    sym_.enterScope();
                    AstType loopType = s.loopVarType();
                    if (Str.startsWith(elemType, "class:") != 0) {
                        sym_.declareClass(s.loopVarName(), "class", Str.substring(elemType, 6, Str.len(elemType)));
                    } else sym_.declare(s.loopVarName(), s.loopHasType() != 0 && loopType != null ? typeToKind(loopType) : elemType);
                    loopDepth_ = loopDepth_ + 1;
                    if (s.body() != null) visitStmt(s.body());
                    loopDepth_ = loopDepth_ - 1;
                    sym_.leaveScope();
                } else if (s.body() != null) visitStmt(s.body());
            } else if (k == "Throw") {
                // C++ visitThrowStmt：确定 throw_type（rethrow/string/类名）。
                if (s.expr() == null) {
                    s.setThrowType("rethrow");
                } else {
                    string t = visitExpr(s.expr());
                    if (t == "string") s.setThrowType("string");
                    else if (t == "class" || t == "interface") {
                        AstExpr xe = s.expr();
                        string cn = "";
                        if (xe.kind() == "New") {
                            cn = xe.resolvedClass();
                            if (Str.len(cn) == 0) cn = xe.className();
                        } else if (xe.kind() == "Identifier") {
                            cn = sym_.lookupClass(xe.name());
                        } else if (xe.kind() == "Member") {
                            cn = xe.resolvedClass();
                        }
                        if (Str.len(cn) != 0) s.setThrowType(cn);
                        else s.setThrowType("class");
                    } else s.setThrowType("");
                }
            } else if (k == "Match") {
                if (s.subject() != null) visitExpr(s.subject());
                string subjKind = s.subject() != null ? s.subject().resolvedKind() : "void";
                // subject 类别（match 扩展：字面量臂 int/long/uint/char/string/float）
                int subjInt = isIntKindMatch(subjKind);
                int subjFloat = (subjKind == "double" || subjKind == "float") ? 1 : 0;
                int subjString = (subjKind == "string") ? 1 : 0;
                int sawEnum = 0;
                int sawLiteral = 0;
                for (int i = 0; i < s.arms().size(); i = i + 1) {
                    AstMatchArm arm = s.arms().get(i);
                    string pk = arm.patKind();
                    if (pk == "wildcard") {
                        // 通配默认臂：无 subject 类型约束；无绑定。
                        sym_.enterScope();
                        if (arm.body() != null) visitStmt(arm.body());
                        sym_.leaveScope();
                        continue;
                    }
                    if (pk == "enum") {
                        if (sawLiteral != 0) {
                            diag_.error(s.line(), s.col(), "cannot mix enum variant and literal match arms");
                        }
                        sawEnum = 1;
                        int enumIndex = findEnum(arm.enumName());
                        if (enumIndex < 0) {
                            diag_.error(s.line(), s.col(), "unknown enum type '" + arm.enumName() + "'");
                            continue;
                        }
                        ArrayList<AstEnumVariant> variants = tu_.enums().get(enumIndex).variants();
                        int variantIndex = -1;
                        for (int vi = 0; vi < variants.size(); vi = vi + 1) {
                            if (variants.get(vi).name() == arm.variant()) { variantIndex = vi; break; }
                        }
                        if (variantIndex < 0) {
                            diag_.error(s.line(), s.col(), "unknown variant '" + arm.variant() + "' in enum '" + arm.enumName() + "'");
                            continue;
                        }
                        arm.setIndex(variantIndex);
                        AstEnumVariant variant = variants.get(variantIndex);
                        sym_.enterScope();
                        for (int bi = 0; bi < arm.bindings().size() && bi < variant.params().size(); bi = bi + 1) {
                            AstType bt = variant.params().get(bi).type();
                            sym_.declare(arm.bindings().get(bi), bt != null ? typeToKind(bt) : "void");
                        }
                        if (arm.body() != null) visitStmt(arm.body());
                        sym_.leaveScope();
                    } else {
                        // 字面量臂（int/long/uint/char/string/float/float32）
                        if (sawEnum != 0) {
                            diag_.error(s.line(), s.col(), "cannot mix enum variant and literal match arms");
                        }
                        sawLiteral = 1;
                        if (pk == "string") {
                            if (subjString == 0) {
                                diag_.error(s.line(), s.col(), "cannot match string literal against subject of type '" + subjKind + "'");
                            }
                        } else if (pk == "float" || pk == "float32") {
                            if (subjFloat == 0) {
                                diag_.error(s.line(), s.col(), "cannot match float literal against subject of type '" + subjKind + "'");
                            }
                        } else {
                            if (subjInt == 0) {
                                diag_.error(s.line(), s.col(), "cannot match numeric literal against subject of type '" + subjKind + "'");
                            }
                        }
                        sym_.enterScope();
                        if (arm.body() != null) visitStmt(arm.body());
                        sym_.leaveScope();
                    }
                }
            } else if (k == "Try") {
                // C++ visitTryStmt：try/catch/finally 体内允许函数调用
                //（临时清 inMain_，与 C++ in_main_function_ 一致）。
                int savedMain = inMain_;
                inMain_ = 0;
                if (s.tryBlock() != null) visitStmt(s.tryBlock());
                for (int i = 0; i < s.catches().size(); i = i + 1) {
                    AstCatch ct = s.catches().get(i);
                    sym_.enterScope();
                    if (Str.len(ct.varName()) != 0) {
                        string cty = ct.type();
                        if (Str.len(cty) == 0) cty = "string";
                        // F4：catch 绑定若是类/接口/struct 名 → declareClass（kind +
                        // 类名），否则 Identifier 会 dump 成类名、Member 无法解析。
                        if (findClass(cty) >= 0) sym_.declareClass(ct.varName(), "class", cty);
                        else if (inInterface(cty) != 0) sym_.declareClass(ct.varName(), "interface", cty);
                        else if (inStructName(cty) != 0) sym_.declareClass(ct.varName(), "struct", cty);
                        else sym_.declare(ct.varName(), cty);
                    }
                    if (ct.block() != null) visitStmt(ct.block());
                    sym_.leaveScope();
                }
                if (s.finallyBlock() != null) visitStmt(s.finallyBlock());
                inMain_ = savedMain;
            } else if (k == "Destructure") {
                AstExpr dv = s.value();
                if (dv != null) visitExpr(dv);
                if (dv != null && dv.kind() == "Tuple" && s.isDecl() == 0) {
                    int tupleN = dv.elements().size();
                    int targetN = s.target().elements().size();
                    int checkN = tupleN < targetN ? tupleN : targetN;
                    for (int di = 0; di < checkN; di = di + 1) {
                        AstDestructureTarget dt = s.target().elements().get(di);
                        AstExpr de = dv.elements().get(di);
                        SymbolEntry existing = sym_.lookupEntry(dt.name());
                        if (dt.name() != "_" && existing != null
                            && typesCompat(existing.type(), de.resolvedKind()) == 0) {
                            diag_.error(dt.line(), dt.col(), "destructure: cannot assign '"
                                + de.resolvedKind() + "' to '" + dt.name() + "' of type '"
                                + existing.type() + "'");
                        }
                    }
                }
                // arity 检查（C++ destructure：tuple 元素数 vs 顶层绑定数）
                if (dv != null && dv.kind() == "Call") {
                    AstExpr cl = dv.callee();
                    if (cl != null && cl.kind() == "Identifier") {
                        AstType frt = findFuncRetType(cl.name(), dv.args().size());
                        if (frt != null && frt.isTuple() != 0) {
                            int valN = frt.funcParamTypes().size();
                            int tgtN = s.target().elements().size();
                            if (tgtN != valN) {
                                int dstLine = s.endLine() != 0 ? s.endLine() : s.line();
                                int dstCol = s.endCol() != 0 ? s.endCol() : s.col();
                                diag_.error(dstLine, dstCol, "destructure: tuple has " + valN + " elements but target binds " + tgtN);
                            }
                        }
                    }
                }
                if (s.isDecl() != 0) declareDestructureTarget(s.target());
            } else if (k == "Await") {
                if (inCoro_ == 0) {
                    diag_.error(s.line(), s.col(), "'await' is only allowed inside an '@coro' method");
                }
                if (s.expr() != null) {
                    AstExpr ae = s.expr();
                    if (ae.kind() == "Member") {
                        AstExpr ao = ae.array();
                        if (s.timeout() != null && ao != null && ao.kind() == "Identifier") {
                            // 事件引用 Class.event（带 timeout）→ int（C++ 对 await 事件标 int）
                            if (isEvent(ao.name(), ae.memberName()) != 0) {
                                ao.setResolvedKind("int");
                                ae.setResolvedKind("int");
                            } else {
                                visitExpr(ae);
                            }
                        } else {
                            visitExpr(ae);
                        }
                    } else {
                        visitExpr(ae);
                    }
                }
                if (s.timeout() != null) visitExpr(s.timeout());
            } else if (k == "Nonlocal") {
                // 无表达式
            } else if (k == "MappingStmt") {
                // 处理 mapping 链的 where 子句（声明源事件参数后 visit）与 lambda 节点
                AstMapping mp2 = s.mappingDecl();
                if (mp2 != null) analyzeMapping(mp2);
            } else if (k == "GpuTile") {
                long sharedCount = 1L;
                AstType sharedDim = s.sharedType();
                while (sharedDim != null && sharedDim.element() != null) {
                    if (sharedDim.arraySize() > 0) sharedCount = sharedCount * sharedDim.arraySize();
                    sharedDim = sharedDim.element();
                }
                string sharedKind = sharedDim != null ? typeToKind(sharedDim) : "int";
                long sharedBytes = 1L;
                if (sharedKind == "double" || sharedKind == "long" || sharedKind == "ulong") sharedBytes = 8L;
                else if (sharedKind == "float" || sharedKind == "int" || sharedKind == "uint") sharedBytes = 4L;
                else if (sharedKind == "short" || sharedKind == "ushort" || sharedKind == "char") sharedBytes = 2L;
                long sharedTotal = sharedCount * sharedBytes;
                if (sharedTotal > 49152L) {
                    diag_.error(0, 0, "@gpu tile shared array size (" + sharedTotal
                        + " bytes) exceeds the 48KB limit (NV sm_75)");
                }
                if (s.gridExpr() != null) {
                    visitExpr(s.gridExpr());
                    long gridLiteral = s.gridExpr().integerValue();
                    if (s.gridExpr().kind() == "Integer" || gridLiteral > 0) {
                        s.setGridVal(int(gridLiteral));
                    } else s.setGridVal(-1);
                }
                if (s.stream() != null) visitExpr(s.stream());
                int savedTileGpu = inGpuFor_;
                int savedTileKernel = inGpuKernel_;
                inGpuFor_ = 1;
                inGpuKernel_ = 1;
                sym_.enterScope();
                AstType sharedElem = s.sharedType();
                while (sharedElem != null && sharedElem.element() != null) sharedElem = sharedElem.element();
                sym_.declareElem(s.name(), "array", sharedElem != null ? typeToKind(sharedElem) : "int");
                if (s.body() != null) visitStmt(s.body());
                sym_.leaveScope();
                inGpuFor_ = savedTileGpu;
                inGpuKernel_ = savedTileKernel;
            } else if (k == "GpuReduce" || k == "GpuScan") {
                sym_.enterScope();
                string opKind = s.initExpr() != null ? visitExpr(s.initExpr()) : "int";
                sym_.declare(s.acc(), opKind);
                sym_.declare(s.x(), opKind);
                if (s.opBody() != null) visitStmt(s.opBody());
                // C++：把 op 体的单 Return 表达式提取到 op_expr（Return 置空）
                AstStmt ob = s.opBody();
                if (ob != null && ob.kind() == "Block") {
                    for (int bi = 0; bi < ob.bodyStmts().size(); bi = bi + 1) {
                        AstStmt bs = ob.bodyStmts().get(bi);
                        if (bs.kind() == "Return" && bs.value() != null) {
                            s.setOpExpr(bs.value());
                            bs.setValue(null);
                            break;
                        }
                    }
                }
                if (s.opExpr() != null) visitExpr(s.opExpr());
                if (s.initExpr() != null) visitExpr(s.initExpr());
                if (s.beginExpr() != null) visitExpr(s.beginExpr());
                if (s.endExpr() != null) visitExpr(s.endExpr());
                if (s.body() != null) visitStmt(s.body());
                sym_.leaveScope();
            } else if (k == "GpuScatter") {
                int scatterOK = 1;
                SymbolEntry scatterIn = sym_.lookupEntry(s.arr());
                if (scatterIn == null || scatterIn.type() != "array" || Str.len(scatterIn.elementType()) == 0) {
                    diag_.error(0, 0, "'@gpu scatter' input '" + s.arr() + "' must be a 'T[]' dynamic array");
                    scatterOK = 0;
                } else if (scatterIn.elementType() != "float" && scatterIn.elementType() != "double"
                    && scatterIn.elementType() != "int") {
                    diag_.error(0, 0, "'@gpu scatter' element type must be float/double/int (got '"
                        + scatterIn.elementType() + "')");
                    scatterOK = 0;
                }
                if (scatterOK != 0) {
                    SymbolEntry scatterOut = sym_.lookupEntry(s.out());
                    if (scatterOut == null || scatterOut.type() != "array"
                        || scatterOut.elementType() != scatterIn.elementType()) {
                        diag_.error(0, 0, "'@gpu scatter' output '" + s.out()
                            + "' must be a '" + scatterIn.elementType() + "[]' array");
                        scatterOK = 0;
                    }
                }
                if (scatterOK != 0) {
                    SymbolEntry scatterIdx = sym_.lookupEntry(s.idxName());
                    if (scatterIdx == null || scatterIdx.type() != "array" || scatterIdx.elementType() != "int") {
                        diag_.error(0, 0, "'@gpu scatter' index '" + s.idxName()
                            + "' must be an 'int[]' array");
                        scatterOK = 0;
                    }
                }
                if (scatterOK == 0) {
                    if (s.aBegin() != null) markAllExpr(s.aBegin());
                    if (s.aEnd() != null) markAllExpr(s.aEnd());
                    if (s.idxBegin() != null) markAllExpr(s.idxBegin());
                    if (s.idxEnd() != null) markAllExpr(s.idxEnd());
                    return;
                }
                if (s.aBegin() != null) visitExpr(s.aBegin());
                if (s.aEnd() != null) visitExpr(s.aEnd());
                if (s.idxBegin() != null) visitExpr(s.idxBegin());
                if (s.idxEnd() != null) visitExpr(s.idxEnd());
                if (s.body() != null) visitStmt(s.body());
            } else if (k == "GpuFor") {
                int savedGpu = inGpuFor_;
                int savedKernel = inGpuKernel_;
                inGpuFor_ = 1;
                inGpuKernel_ = 1;
                if (s.body() != null) visitStmt(s.body());
                inGpuFor_ = savedGpu;
                inGpuKernel_ = savedKernel;
            } else {
                if (s.expr() != null) visitExpr(s.expr());
            }
        }

        // ---- 表达式 ----
        string visitExpr(AstExpr e) {
            string k = e.kind();
            if (k == "Integer") {
                string t = "int";
                if (e.isChar() != 0) t = "char";
                else if (e.isLong() != 0) t = "long";
                else if (e.isUnsigned() != 0) {
                    long v = e.value();
                    if (v >= 0 && v <= 255) t = "ubyte";
                    else if (v <= 65535) t = "ushort";
                    else if (v <= 4294967295L) t = "uint";
                    else t = "ulong";
                } else {
                    long v = e.value();
                    if (v >= -128 && v <= 127) t = "byte";
                    else if (v >= -32768 && v <= 32767) t = "short";
                    else if (v >= -2147483648L && v <= 2147483647L) t = "int";
                    else t = "long";
                }
                e.setResolvedKind(t);
                return t;
            }
            if (k == "Float") {
                string t = e.f32() != 0 ? "float" : "double";
                e.setResolvedKind(t);
                return t;
            }
            if (k == "Bool") { e.setResolvedKind("bool"); return "bool"; }
            if (k == "String") {
                if (inGpuKernel_ != 0) {
                    diag_.error(e.line(), e.col(), "string literals are not supported inside '@gpu for' bodies");
                }
                e.setResolvedKind("string"); return "string";
            }
            if (k == "Null") { e.setResolvedKind("null"); return "null"; }
            if (k == "This") { e.setResolvedKind("class"); return "class"; }
            if (k == "Identifier") {
                if (inGpuFor_ != 0 && e.name() == "kernel") {
                    e.setResolvedKind("int");
                    return "int";
                }
                string t = sym_.lookup(e.name());
                if (Str.len(t) == 0 && inStruct_ != 0) {
                    // struct 方法内隐式 this 字段访问
                    t = structPropType(currentClass_, e.name());
                }
                if (Str.len(t) == 0 && inClass_ != 0) {
                    // F4-G2: 类作用域已弹出，但裸属性/方法仍可从当前类成员表回退解析。
                    string mt = currentClassMemberType(e.name());
                    if (Str.len(mt) != 0) t = mt;
                }
                if (Str.len(t) == 0) {
                    // 内置函数 / 普通函数名 → function
                    string ir = intrRet(e.name());
                    if (Str.len(ir) != 0) t = "function";
                    else if (isFuncName(e.name()) != 0) t = "function";
                    else if (inClass_ != 0 && hasMethod(currentClass_, e.name()) != 0) t = "function";
                    else {
                        int ci = findClass(e.name());
                        if (ci >= 0) t = "class";
                        else {
                            int eei = findEnum(e.name());
                            if (eei >= 0) {
                                t = "enum";
                                e.setResolvedClass(e.name());
                            } else {
                                t = "void";
                                // C++：undefined symbol（位置 = 标识符）
                                if (Str.startsWith(e.name(), "__myp_") == 0) {
                                    diag_.error(e.line(), e.col(), "undefined symbol '" + e.name() + "'");
                                }
                            }
                        }
                    }
                }
                // ★ BUG-050 修复（裸 const 标识符）：`const int CAP = 1024;`
                // 是零参 const-decl 函数；裸引用 `CAP` 应折叠为常量（等价 `CAP()`），
                // 而非解析成 'function' 类型。top-level 裸 const 标识符在此改判为
                // 其返回类型（codegen 对 const-decl 标识符发射隐式零参调用）。
                if (t == "function") {
                    AstFunction cf = findConstDeclFunc(e.name());
                    if (cf != null) {
                        AstType sret2 = cf.ret();
                        string crk = sret2 != null ? typeToKind(sret2) : "void";
                        if (crk == "class" || crk == "struct" || crk == "interface") {
                            string vc2 = constRetValueClass(cf);
                            if (Str.len(vc2) != 0) e.setValueClass(vc2);
                        }
                        e.setResolvedKind(crk);
                        return crk;
                    }
                }
                e.setResolvedKind(t);
                return t;
            }
            if (k == "Binary") {
                string l = visitExpr(e.lhs());
                string r = visitExpr(e.rhs());
                if (inGpuKernel_ != 0 && (l == "string" || r == "string")) {
                    diag_.error(e.line(), e.col(), "string operations are not supported inside '@gpu for' bodies");
                }
                string op = e.op();
                if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">="
                    || op == "&&" || op == "||") {
                    string opr = resolveOp(e, op, e.lhs(), l, r);
                    if (Str.len(opr) != 0) {
                        // BUG-006 镜像 C++：main 内解析到外部 @op 函数的比较运算符拒绝
                        //（struct 算子 setResolved("struct_...") 放行）。
                        if (inMain_ != 0 && inStruct_ == 0 && Str.startsWith(e.resolved(), "struct_") == 0) {
                            diag_.error(e.line(), e.col(), "direct function call not allowed in main() — use mapping() instead (operator '@op(" + op + ")')");
                        }
                        e.setOpCall(1);
                        e.setResolvedKind(opr);
                        return opr;
                    }
                    if (op == "<" || op == ">" || op == "<=" || op == ">=") {
                        // C++：只有关系比较 < > <= >= 设置 unsigned 标志（== != 不设置）
                        int lu = isUnsignedKind(l) != 0 ? 1 : 0;
                        int ru = isUnsignedKind(r) != 0 ? 1 : 0;
                        e.setLhsUnsigned(lu);
                        e.setRhsUnsigned(ru);
                        int uc2 = lu + ru > 0 ? 1 : 0;
                        if (l == "long" || r == "long" || l == "double" || r == "double" || l == "float" || r == "float") uc2 = 0;
                        if (l == "ulong" || r == "ulong") uc2 = 1;
                        e.setResultUnsigned(uc2);
                    }
                    // 字符串比较（==/!= 与 </>/<=/>= 一致）：两边都须为字符串（或一方 null）。
                    // 修复：bool==string / int==string 类型混合此前被放行，落到 codegen 的
                    // inttoptr 兜底产出"恒 false"的非法 IR → 应为类型错误。
                    if ((op == "==" || op == "!=") && (l == "string" || r == "string")) {
                        if ((l != "string" || r != "string") && l != "null" && r != "null") {
                            diag_.error(e.line(), e.col(), "string comparison requires both operands to be strings");
                        }
                        e.setResolvedKind("bool");
                        return "bool";
                    }
                    e.setResolvedKind("bool");
                    return "bool";
                }
                if (op == "+" && (l == "string" || r == "string")) {
                    e.setResolvedKind("string");
                    return "string";
                }
                // @op 运算符重载（slice+slice 等），C++ resolveOperator 先于数字检查
                string opr = resolveOp(e, op, e.lhs(), l, r);
                if (Str.len(opr) != 0) {
                    // BUG-006 镜像 C++：main 内解析到外部 @op 函数的运算符拒绝
                    //（struct 算子 setResolved("struct_...") 放行）。
                    if (inMain_ != 0 && inStruct_ == 0 && Str.startsWith(e.resolved(), "struct_") == 0) {
                        diag_.error(e.line(), e.col(), "direct function call not allowed in main() — use mapping() instead (operator '@op(" + op + ")')");
                    }
                    e.setOpCall(1);
                    e.setResolvedKind(opr);
                    return opr;
                }
                // C++ 级联错误恢复：操作数为 void → 直接返回 int（不报 numeric 错）
                if (l == "void" || r == "void") {
                    e.setResolvedKind("int");
                    return "int";
                }
                if ((op == "&" || op == "|" || op == "^") && l == "bitvector" && r == "bitvector") {
                    e.setLhsUnsigned(1);
                    e.setRhsUnsigned(1);
                    e.setResultUnsigned(1);
                    e.setResolvedKind("bitvector");
                    return "bitvector";
                }
                if ((op == "<<" || op == ">>") && l == "bitvector") {
                    e.setLhsUnsigned(1);
                    e.setRhsUnsigned(1);
                    e.setResultUnsigned(1);
                    e.setResolvedKind("bitvector");
                    return "bitvector";
                }
                // 算术/位运算：操作数须为数字（C++ expectNumeric）
                if (isNumKind(l) == 0) {
                    int ll = 0;
                    int lc = 0;
                    AstExpr lp = e.lhs();
                    if (lp != null) { ll = lp.line(); lc = lp.col(); }
                    if (lp != null && lp.kind() == "Identifier" && lc >= 2) lc = lc - 2;
                    diag_.error(ll, lc, "expected numeric type, got '" + exprTypeName(lp, l) + "'");
                } else if (isNumKind(r) == 0) {
                    int rl = 0;
                    int rc = 0;
                    AstExpr rp = e.rhs();
                    if (rp != null) { rl = rp.line(); rc = rp.col(); }
                    diag_.error(rl, rc, "expected numeric type, got '" + exprTypeName(rp, r) + "'");
                }
                // C++：算术/位运算设置 unsigned 标志
                e.setLhsUnsigned(isUnsignedKind(l) != 0 ? 1 : 0);
                e.setRhsUnsigned(isUnsignedKind(r) != 0 ? 1 : 0);
                if (op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>") {
                    string t = TKind.numericBitCommon(l, r);
                    if (t == "ulong" || t == "uint" || t == "ubyte" || t == "ushort") e.setResultUnsigned(1);
                    else e.setResultUnsigned(0);
                    e.setResolvedKind(t);
                    return t;
                }
                string t2 = TKind.numericCommon(l, r);
                if (t2 == "ulong" || t2 == "uint" || t2 == "ubyte" || t2 == "ushort") e.setResultUnsigned(1);
                else e.setResultUnsigned(0);
                e.setResolvedKind(t2);
                return t2;
            }
            if (k == "Unary") {
                string o = visitExpr(e.operand());
                string op = e.op();
                if (op == "!") {
                    string t = o == "bit" ? "bit" : "bool";
                    e.setResolvedKind(t);
                    return t;
                }
                e.setResolvedKind(o);
                return o;
            }
            if (k == "Convert") {
                // C++ 总是先 visit operand（设置其类型），再返回目标类型。
                string o = visitExpr(e.operand());
                string to = e.toKind();
                if (Str.len(to) != 0) { e.setResolvedKind(to); return to; }
                e.setResolvedKind(o);
                return o;
            }
            if (k == "Assign") {
                // devirt 安全：接口变量被重赋值 → concreteClass 快照失效，标记
                // reassigned，后续方法调用回退 vtable 分派（不 devirt）。
                if (e.lhs() != null && e.lhs().kind() == "Identifier") {
                    SymbolEntry bent = sym_.lookupEntry(e.lhs().name());
                    if (bent != null && Str.len(bent.concreteClass()) != 0) bent.setReassigned(1);
                }
                // 左值检查（C++：target must be variable/field/array element，
                // 位置 = Assign 节点 range = RHS 末 token）
                AstExpr lt = e.lhs();
                if (lt != null) {
                    string lk = lt.kind();
                    if (lk != "Identifier" && lk != "Member" && lk != "Subscript" && lk != "Tuple") {
                        int ll2 = e.line();
                        int lc2 = e.col();
                        diag_.error(ll2, lc2, "cannot assign to this expression (target must be a variable, field, or array element)");
                        // C++ 不 visit 子表达式（resolved_kind 默认 Int）
                        lt.setResolvedKind("int");
                        AstExpr lr = e.rhs();
                        if (lr != null) lr.setResolvedKind("int");
                        e.setResolvedKind("void");
                        return "void";
                    }
                }
                string l = visitExpr(e.lhs());
                string r = e.rhs() != null ? visitExpr(e.rhs()) : "void";
                int badAssign = (l != "void" && r != "void" && typesCompat(l, r) == 0) ? 1 : 0;
                // BUG-054：struct 赋值须比较具体 struct 名（typesCompat 只比
                // kind "struct"，不同 struct 互赋静默过 sema → LLVM opt 报错）。
                if (badAssign == 0 && l == "struct" && r == "struct"
                    && e.lhs() != null && e.rhs() != null) {
                    string ln = exprStructName(e.lhs());
                    string rn = exprStructName(e.rhs());
                    if (Str.len(ln) != 0 && Str.len(rn) != 0 && ln != rn) badAssign = 1;
                }
                if (badAssign != 0) {
                    string lm = l;
                    string rm = r;
                    if (l == "struct" && r == "struct") {
                        lm = exprStructName(e.lhs());
                        rm = exprStructName(e.rhs());
                        if (Str.len(lm) == 0) lm = "struct";
                        if (Str.len(rm) == 0) rm = "struct";
                    }
                    diag_.error(e.line(), e.col(), "cannot assign value of type '" + rm
                        + "' to variable of type '" + lm + "'");
                }
                e.setResolvedKind(l);
                return l;
            }
            if (k == "Ternary") {
                if (e.condition() != null) visitExpr(e.condition());
                string t = e.trueExpr() != null ? visitExpr(e.trueExpr()) : "void";
                string f = e.falseExpr() != null ? visitExpr(e.falseExpr()) : "void";
                if (TKind.isNumeric(t) != 0 && TKind.isNumeric(f) != 0) {
                    // C++ visitTernary 用 commonNumericKind（a==b→a），非 numeric_common
                    string common = TKind.ternaryCommon(t, f);
                    if (common != "void") {
                        e.setResolvedKind(common);
                        return common;
                    }
                }
                e.setResolvedKind(t);
                return t;
            }
            if (k == "Range") {
                if (e.start() != null) visitExpr(e.start());
                if (e.end() != null) visitExpr(e.end());
                e.setResolvedKind("int");
                return "int";
            }
            if (k == "Call") {
                string ret = "void";
                AstExpr callee = e.callee();
                int callFailed = 0;  // callee 不可调用 → 实参不 visit，标 int（C++ 提前返回）
                // C++ visitCall：@coro 方法自递归（值使用）拒绝——@coro 调用生成句柄。
                if (inCoro_ != 0 && Str.len(currentMethodName_) != 0 && inDiscardStmt_ == 0 && callee != null) {
                    int selfCall = 0;
                    if (callee.kind() == "Identifier" && callee.name() == currentMethodName_) selfCall = 1;
                    else if (callee.kind() == "Member" && callee.array() != null && callee.array().kind() == "This"
                        && callee.memberName() == currentMethodName_) selfCall = 1;
                    if (selfCall != 0) {
                        int curIsCoro = 0;
                        for (int ci2 = 0; ci2 < tu_.classes().size(); ci2 = ci2 + 1) {
                            AstClass cl2 = tu_.classes().get(ci2);
                            if (cl2.name() != currentClass_) continue;
                            ArrayList<AstAction> acts2 = cl2.actions();
                            for (int ai2 = 0; ai2 < acts2.size(); ai2 = ai2 + 1) {
                                if (acts2.get(ai2).name() == currentMethodName_ && acts2.get(ai2).coro() != 0) { curIsCoro = 1; break; }
                            }
                            if (curIsCoro != 0) break;
                        }
                        if (curIsCoro != 0) {
                            diag_.error(e.line(), e.col(), "recursive call to '@coro' method '" + currentMethodName_
                                + "' is not supported: an '@coro' call spawns a new coroutine and returns a handle, not the method's return value. Move the recursion into a plain function and call it from the '@coro' body");
                            if (callee != null) markAllExpr(callee);
                            for (int ci3 = 0; ci3 < e.args().size(); ci3 = ci3 + 1) markAllExpr(e.args().get(ci3));
                            e.setResolvedKind("void");
                            return "void";
                        }
                    }
                }
                // GPU kernel 上下文方法由 C++ visitCall 提前拦截；callee/object
                // 不走常规 Member 解析，保持默认 Int。
                if (inGpuFor_ != 0 && callee != null && callee.kind() == "Member") {
                    AstExpr ko = callee.array();
                    if (ko != null && ko.kind() == "Identifier" && ko.name() == "kernel") {
                        string km = callee.memberName();
                        ko.setResolvedKind("int");
                        callee.setResolvedKind("int");
                        if (km == "sync") {
                            if (e.args().size() != 0) diag_.error(e.line(), e.col(), "kernel.sync() takes no arguments");
                            // §3.3：aligned barrier（bar.sync 0）要求 uniform 控制流，发散分支内
                            // 的 sync 会死锁——警告（保守：if/while body 一律视为发散）。
                            if (inGpuDivergent_ > 0) {
                                diag_.warn(e.line(), e.col(), "kernel.sync() inside divergent (thread-dependent) control flow may deadlock; place it at a uniform point");
                            }
                            e.setResolvedKind("void");
                            return "void";
                        }
                        if (km == "shfl_down") {
                            if (e.args().size() != 2) {
                                diag_.error(e.line(), e.col(), "kernel.shfl_down(v, delta) takes 2 arguments");
                                e.setResolvedKind("double");
                                return "double";
                            }
                            string kr = visitExpr(e.args().get(0));
                            visitExpr(e.args().get(1));
                            if (kr != "double" && kr != "float" && kr != "int") {
                                diag_.error(e.line(), e.col(), "kernel.shfl_down supports double/float/int");
                            }
                            e.setResolvedKind(kr);
                            return kr;
                        }
                        if (km == "block_reduce_sum" || km == "block_reduce_max") {
                            if (e.args().size() != 1) {
                                diag_.error(e.line(), e.col(), "kernel." + km + "(v) takes 1 argument");
                                e.setResolvedKind("double");
                                return "double";
                            }
                            string kr2 = visitExpr(e.args().get(0));
                            if (kr2 != "double" && kr2 != "float" && kr2 != "int") {
                                diag_.error(e.line(), e.col(), "kernel." + km + " supports double/float/int");
                            }
                            e.setResolvedKind(kr2);
                            return kr2;
                        }
                        if (km == "printk" || km == "assert") {
                            int isAssert = km == "assert" ? 1 : 0;
                            int need = isAssert != 0 ? 2 : 1;
                            if (e.args().size() < need) {
                                diag_.error(e.line(), e.col(), "kernel." + km + " needs a format string");
                                e.setResolvedKind("void");
                                return "void";
                            }
                            if (isAssert != 0) {
                                string condKind = visitExpr(e.args().get(0));
                                if (condKind != "bool" && condKind != "int" && condKind != "long") {
                                    AstExpr condArg = e.args().get(0);
                                    diag_.error(condArg.line(), condArg.col(), "kernel.assert cond must be bool/int");
                                }
                            }
                            AstExpr fmtArg = e.args().get(need - 1);
                            fmtArg.setResolvedKind("int");
                            if (fmtArg.kind() != "String") {
                                diag_.error(e.line(), e.col(), "kernel." + km + " format must be a string literal");
                            }
                            int nval = e.args().size() - need;
                            if (nval > 3) {
                                diag_.error(e.line(), e.col(), "kernel." + km + " takes at most 3 value arguments");
                            }
                            for (int i = need; i < e.args().size(); i = i + 1) {
                                AstExpr valueArg = e.args().get(i);
                                string valueKind = visitExpr(valueArg);
                                if (valueKind != "int" && valueKind != "long" && valueKind != "double"
                                    && valueKind != "float" && valueKind != "bool") {
                                    diag_.error(valueArg.line(), valueArg.col(), "kernel." + km
                                        + " value arg must be int/long/double/float");
                                }
                            }
                            e.setResolvedKind("void");
                            return "void";
                        }
                    }
                }
                if (callee != null) {
                    if (callee.array() != null) {
                        AstExpr enumObject = callee.array();
                        int enumIndex = findEnum(enumObject.name());
                        int isVariant = 0;
                        if (enumIndex >= 0) {
                            ArrayList<AstEnumVariant> variants = tu_.enums().get(enumIndex).variants();
                            for (int vi = 0; vi < variants.size(); vi = vi + 1)
                                if (variants.get(vi).name() == callee.memberName()) { isVariant = 1; break; }
                        }
                        if (isVariant != 0) {
                            for (int i = 0; i < e.args().size(); i = i + 1) visitExpr(e.args().get(i));
                            e.setArgsVisited(1);
                            enumObject.setResolvedKind("enum");
                            callee.setResolvedKind("function");
                            callee.setResolvedClass(enumObject.name());
                            e.setResolvedKind("enum");
                            return "enum";
                        }
                    }
                    int gsi = -1;
                    if (callee.kind() == "Member") gsi = findGenericStatic(callee);
                    if (gsi >= 0) {
                        // F4-G1：泛型静态方法 Class.method<T>(...) / 推导
                        ret = resolveGenericStaticCall(e, callee, gsi);
                    } else if (callee.kind() == "Identifier") {
                        string fn = callee.name();
                        // F4-G1：泛型函数调用 id<int>(x) / max2(a, b) 解析为具体 _inst 函数。
                        int hasGenericFn = 0;
                        AstFunction genericFn = null;
                                    for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                            AstFunction f = tu_.functions().get(i);
                            if (f.name() == fn && f.typeParams().size() > 0 && f.genericInst() == 0) { genericFn = f; hasGenericFn = 1; break; }
                        }
                        if (hasGenericFn != 0) {
                            for (int i = 0; i < e.args().size(); i = i + 1) visitExpr(e.args().get(i));
                            e.setArgsVisited(1);
                            ArrayList<AstType> concrete = new ArrayList<AstType>();
                            if (e.callTypeArgs().size() > 0) {
                                for (int i = 0; i < e.callTypeArgs().size(); i = i + 1) concrete.add(e.callTypeArgs().get(i));
                            } else {
                                for (int ti = 0; ti < genericFn.typeParams().size(); ti = ti + 1) {
                                    int found = 0;
                                    string tpName = genericFn.typeParams().get(ti);
                                    for (int pi = 0; pi < genericFn.params().size() && pi < e.args().size(); pi = pi + 1) {
                                        AstType pt = genericFn.params().get(pi).type();
                                        if (pt == null) continue;
                                        AstType at = inferConcreteTypeForGenericParam(pt, e.args().get(pi), tpName);
                                        if (at != null) {
                                            concrete.add(at);
                                            found = 1;
                                            break;
                                        }
                                    }
                                    if (found == 0) { break; }
                                }
                            }
                            // C++ resolveGenericCall：无法推断 → 报错并返回 Void。
                            if (concrete.size() < genericFn.typeParams().size() && e.callTypeArgs().size() == 0) {
                                string missTp = genericFn.typeParams().get(concrete.size());
                                diag_.error(e.line(), e.col(), "cannot infer type parameter '" + missTp
                                    + "' for generic function '" + fn + "' (pass explicit args: " + fn + "<...>(...))");
                                e.setResolvedKind("void");
                                callee.setResolvedKind("int");
                                return "void";
                            }
                            // §9 泛型函数 where 约束校验（C++ satisfiesTraitConstraint）。
                            ArrayList<AstPair> gcons = genericFn.constraints();
                            for (int ci2 = 0; ci2 < gcons.size(); ci2 = ci2 + 1) {
                                string gtp = gcons.get(ci2).k();
                                string gtrait = gcons.get(ci2).v();
                                int gi2 = -1;
                                for (int k3 = 0; k3 < genericFn.typeParams().size(); k3 = k3 + 1) {
                                    if (genericFn.typeParams().get(k3) == gtp) { gi2 = k3; break; }
                                }
                                if (gi2 >= 0 && gi2 < concrete.size()) {
                                    string ckind = typeToKind(concrete.get(gi2));
                                    if (satisfiesTraitAst(concrete.get(gi2), gtrait) == 0) {
                                        diag_.error(e.line(), e.col(), "type argument '" + ckind
                                            + "' does not satisfy constraint '" + gtp + " : " + gtrait
                                            + "' for generic function '" + fn + "'");
                                        e.setResolvedKind("void");
                                        callee.setResolvedKind("int");
                                        return "void";
                                    }
                                }
                            }
                            if (concrete.size() == genericFn.typeParams().size()) {
                                string instName = instantiateGenericFunction(fn, concrete);
                                if (Str.len(instName) != 0) {
                                    e.setResolved(instName);
                                    AstFunction inst = null;
                                    for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                                        if (tu_.functions().get(i).name() == instName) { inst = tu_.functions().get(i); break; }
                                    }
                                    if (inst != null) {
                                        // §四-1：泛型实例函数同样做默认/命名实参归一化，
                                        // 缺省 clone 需访问（C++ 在实参循环中访问）。
                                        if (normalizeCallArgs(e, inst.params()) != 0) {
                                            for (int gi = 0; gi < e.args().size(); gi = gi + 1) {
                                                if (Str.len(e.args().get(gi).resolvedKind()) == 0) visitExpr(e.args().get(gi));
                                            }
                                        }
                                        AstType sret = substituteType(inst.ret(), genericFn.typeParams(), concrete);
                                        string rk = sret != null ? typeToKind(sret) : "void";
                                        if (sret != null && sret.typeArgs().size() > 0) {
                                            tryInstantiate(sret.className(), sret.typeArgs());
                                        }
                                        if (rk == "class" || rk == "struct" || rk == "interface") {
                                            string vc = gsRetValueClass(sret);
                                            if (Str.len(vc) != 0) e.setValueClass(vc);
                                        }
                                        e.setResolvedKind(rk);
                                        callee.setResolvedKind("int");
                                        return rk;
                                    }
                                }
                            }
                        }
                        if (fn == "bitcast") {
                            // P0 bitcast<T,U>(x)：位保持重解释，源/目标同宽
                            callee.setResolvedKind("int");
                            if (e.args().size() > 0) visitExpr(e.args().get(0));
                            ArrayList<AstType> cta = e.callTypeArgs();
                            if (cta.size() >= 1) {
                                AstType bt = cta.get(cta.size() - 1);
                                string bk = typeToKind(bt);
                                e.setResolvedKind(bk);
                                // 宽度检查（C++ visitBitcast）
                                string sk = "";
                                if (cta.size() == 2) sk = typeToKind(cta.get(0));
                                else sk = e.args().size() > 0 ? e.args().get(0).resolvedKind() : "void";
                                int sw = bitcastWidth(sk);
                                int tw = bitcastWidth(bk);
                                if (sw != 0 && tw != 0 && sw != tw) {
                                    diag_.error(e.line(), e.col(), "bitcast requires source and target of the same width (" + sw + " vs " + tw + " bits)");
                                    e.setResolvedKind("void");
                                    return "void";
                                }
                                return bk;
                            }
                            ret = "void";
                        } else if (isNoVisitIntr(fn) != 0) {
                            // C++ 对拦截名单内建调用不 visit callee（保持默认 Int）。
                            // 返回类型：内建优先，用户自定义同名函数时用用户函数（C++ 行为）。
                            callee.setResolvedKind("int");
                            string ir = intrRet(fn);
                            if (Str.len(ir) != 0) ret = ir;
                            else if (fn == "checkedAdd" || fn == "checkedMul" || fn == "parseIntOpt") ret = "tuple";
                            else if (fn == "parseInt") ret = "int";
                            else if (fn == "parseLong") ret = "long";
                            else if (fn == "parseUint") ret = "uint";
                            else if (fn == "parseUlong") ret = "ulong";
                            else if (fn == "parseFloat") ret = "float";
                            else if (fn == "parseDouble") ret = "double";
                            else if (fn == "bytes" || fn == "bytesOf") ret = "array";
                            else if (fn == "str") ret = "string";
                            else if (fn == "load4") ret = "float4";
                            else if (fn == "store4") ret = "void";
                            else if (fn == "bytesOf") ret = "array";
                            else if ((fn == "popcount" || fn == "clz" || fn == "ctz" || fn == "bitreverse"
                                || fn == "rotl" || fn == "rotr") && e.args().size() > 0) {
                                ret = visitExpr(e.args().get(0));
                                for (int ai = 1; ai < e.args().size(); ai = ai + 1) visitExpr(e.args().get(ai));
                                e.setArgsVisited(1);
                            }
                            else {
                                string fr2 = findFuncRet(fn, e.args().size());
                                if (Str.len(fr2) != 0) ret = fr2;
                            }
                        } else {
                            // F4：struct 函数式构造 Buffer(args)（对齐 C++
                            // resolveStructConstruction——在 visit callee 前拦截）。
                            int isStructCtor = 0;
                            int sci = findStruct(fn);
                            if (sci >= 0 && tu_ != null) {
                                AstStruct st = null;
                                for (int si3 = 0; si3 < tu_.structs().size(); si3 = si3 + 1) {
                                    if (tu_.structs().get(si3).name() == fn) { st = tu_.structs().get(si3); break; }
                                }
                                if (st != null) {
                                    ArrayList<string> scnames = new ArrayList<string>();
                                    ArrayList<ArrayList<AstParam>> scparams = new ArrayList<ArrayList<AstParam>>();
                                    ArrayList<AstFunction> sfs = st.funcs();
                                    for (int j = 0; j < sfs.size(); j = j + 1) {
                                        AstFunction f = sfs.get(j);
                                        if (f.ctor() != 0) { scnames.add(f.name()); scparams.add(f.params()); }
                                    }
                                    if (scnames.size() != 0) {
                                        // 实参类型：命名赋值实参只访问其值（C++ resolveStructConstruction），
                                        // 否则访问整个实参。匹配成功后归一化（命名→NamedArg、重排、缺省补全）。
                                        ArrayList<string> argKinds = new ArrayList<string>();
                                        for (int j = 0; j < e.args().size(); j = j + 1) {
                                            AstExpr ar = e.args().get(j);
                                            if (ar != null && ar.kind() == "Assign" && ar.rhs() != null) argKinds.add(visitExpr(ar.rhs()));
                                            else if (ar != null) argKinds.add(visitExpr(ar));
                                            else argKinds.add("void");
                                        }
                                        e.setArgsVisited(1);
                                        int best = -1;
                                        int bestScore = 1 << 30;
                                        int ambiguous = 0;
                                        for (int j = 0; j < scnames.size(); j = j + 1) {
                                            ArrayList<AstParam> ps = scparams.get(j);
                                            ArrayList<int> plan = planCallArgs(e, ps);
                                            if (plan == null) continue;
                                            int argsOK = 1;
                                            int promos = 0;
                                            for (int k2 = 0; k2 < ps.size(); k2 = k2 + 1) {
                                                if (plan.get(k2) < 0) continue;  // 缺省
                                                AstParam p = ps.get(k2);
                                                string pk = p.type() != null ? typeToKind(p.type()) : "void";
                                                string at = argKinds.get(plan.get(k2));
                                                if (ctorArgCompat(pk, at) == 0) { argsOK = 0; break; }
                                                if (pk != at) promos = promos + 1;
                                            }
                                            if (argsOK == 0) continue;
                                            if (best < 0 || promos < bestScore) { best = j; bestScore = promos; ambiguous = 0; }
                                            else if (promos == bestScore) ambiguous = 1;
                                        }
                                        if (best >= 0 && ambiguous == 0) {
                                            isStructCtor = 1;
                                            callee.setResolvedKind("int");
                                            normalizeCallArgs(e, scparams.get(best));
                                            e.setArgsVisited(1);
                                            // C++ struct 构造缺省补全的默认值不被访问（保持默认 Int）
                                            for (int dj = 0; dj < e.args().size(); dj = dj + 1) {
                                                if (Str.len(e.args().get(dj).resolvedKind()) == 0) markAllExpr(e.args().get(dj));
                                            }
                                            e.setStructType(fn);
                                            e.setStructCtor("struct_" + fn + "_" + scnames.get(best) + mangleParams(scparams.get(best)));
                                            ret = "struct";
                                        } else if (best < 0) {
                                            StringBuilder asb = new StringBuilder();
                                            for (int j = 0; j < argKinds.size(); j = j + 1) {
                                                if (j != 0) asb.append(", ");
                                                asb.append(argKinds.get(j));
                                            }
                                            diag_.error(e.line(), e.col(), "no matching constructor for '" + fn + "(" + asb.toString() + ")'");
                                            isStructCtor = 1;
                                            callee.setResolvedKind("int");
                                            ret = "struct";
                                        }
                                    }
                                }
                            }
                            if (isStructCtor == 0) {
                            visitExpr(callee);
                            // M-FN-2 named lambda 自递归：lambda body 内 `name(args)`
                            // 路由到自身 trampoline（codegen 识别 __self 标记）。
                            if (Str.len(lambdaSelfName_) != 0 && callee.kind() == "Identifier" && callee.name() == lambdaSelfName_) {
                                e.setResolved(lambdaSelfClass_ + "__self");
                            }
                            string ir = intrRet(fn);
                            if (Str.len(ir) != 0) ret = ir;
                            else {
                                // §四-1：默认/命名实参归一化（顶层函数，非内建）
                                int topNormFailed = 0;
                                ArrayList<AstParam> topParams = findFuncParams(fn);
                                if (topParams != null) {
                                    if (normalizeCallArgs(e, topParams) == 0) { topNormFailed = 1; ret = "void"; }
                                    else e.setCallParamTypes(paramKinds(topParams));
                                }
                                // @coro 顶层函数调用返回协程句柄（long）
                                int isCor = 0;
                                for (int ci2 = 0; ci2 < coroNames_.size(); ci2 = ci2 + 1) {
                                    if (coroNames_.get(ci2) == fn) { isCor = 1; break; }
                                }
                                if (topNormFailed == 0 && isCor != 0) {
                                    ret = "long";
                                } else if (topNormFailed == 0) {
                                    string fr = findFuncRet(fn, e.args().size());
                                    if (Str.len(fr) != 0) {
                                        ret = fr;
                                        // 链式调用 f().member()：记录返回类名（自举缺口——普通
                                        // 顶层函数调用只设 kind 不设 valueClass，导致成员访问回落到
                                        // 当前类 "class 'X' has no member"。对齐泛型显式实参/
                                        // 类 action/new 路径，用 gsRetValueClass 取类名）。
                                        if (fr == "class" || fr == "struct" || fr == "interface") {
                                            AstType fret = findFuncRetType(fn, e.args().size());
                                            string fvc = gsRetValueClass(fret);
                                            if (Str.len(fvc) != 0) e.setValueClass(fvc);
                                        }
                                    } else {
                                        // F4-L：函数类型变量调用 f(21) → 用声明的返回类型
                                        SymbolEntry fve = sym_.lookupEntry(fn);
                                        if (fve != null && Str.len(fve.funcRet()) != 0) {
                                            ret = fve.funcRet();
                                            e.setCallParamTypes(fve.functionParamTypes());
                                        } else if (inClass_ != 0) {
                                        string mr = findMethodRet(currentClass_, fn, e.args().size());
                                        if (Str.len(mr) != 0) {
                                            ret = mr;
                                            // 链式调用 (m()).member：记录返回类名
                                            string rcl2 = findMethodRetClass(currentClass_, fn);
                                            if (Str.len(rcl2) != 0) e.setResolvedClass(rcl2);
                                        } else {
                                            // C++：'X' is not callable（位置 = Call range = ')'）
                                            string cr = callee.resolvedKind();
                                            if (cr != "function") {
                                                diag_.error(e.line(), e.col(), "'" + fn + "' is not callable");
                                                callFailed = 1;
                                            }
                                        }
                                    } else {
                                        // C++：'X' is not callable
                                        string cr = callee.resolvedKind();
                                        if (cr != "function") {
                                            diag_.error(e.line(), e.col(), "'" + fn + "' is not callable");
                                            callFailed = 1;
                                        }
                                    }
                                }
                            }
                            }
                            }
                        }
                    } else if (callee.kind() == "Member") {
                        visitExpr(callee);
                        // 类.方法(…) / 实例.方法(…) / obj.m().m() / arr[i].m() → 查类方法返回类型
                        AstExpr mo = callee.array();
                        // slice.size()/.length()/.data() 内建
                        if (mo != null && mo.kind() == "Identifier") {
                            string mot2 = sym_.lookup(mo.name());
                            if (mot2 == "slice") {
                                if (callee.memberName() == "size" || callee.memberName() == "length") ret = "int";
                                else if (callee.memberName() == "data") ret = "array";
                            }
                        } else if (mo != null && mo.kind() == "Call" && mo.resolvedKind() == "slice") {
                            // makeSlice().size()：slice 返回调用结果的内建成员（BUG-059）
                            if (callee.memberName() == "size" || callee.memberName() == "length") ret = "int";
                            else if (callee.memberName() == "data") ret = "array";
                        }
                        string cn = "";
                        if (mo != null && mo.kind() == "Identifier") {
                            cn = sym_.lookupClass(mo.name());
                            if (Str.len(cn) == 0 && mo.name() == "this" && inClass_ != 0) cn = currentClass_;
                            if (Str.len(cn) == 0 && inClass_ != 0) {
                                // F4-G2b：类作用域已弹出（双 pass），裸属性实例
                                // 从当前类成员表回退解析（同 Member-visit 路径）。
                                cn = currentClassMemberClassName(mo.name());
                                if (Str.len(cn) == 0 && inStruct_ != 0) cn = currentStructMemberClassName(mo.name());
                            }
                            if (Str.len(cn) == 0) cn = mo.name();
                        } else if (mo != null && (mo.kind() == "Call" || mo.kind() == "Subscript" || mo.kind() == "Member" || mo.kind() == "New")) {
                            // B1：new Foo().method() 链——New 的 resolvedClass 即类名
                            cn = mo.valueClass();
                            if (Str.len(cn) == 0) cn = mo.resolvedClass();
                        }
                        if (Str.len(cn) != 0) {
                            string base3 = resolveBase(cn);
                            // A2（BUG-001 镜像）：function: 段方法仅类内 this.f()
                            // 可调用；外部 obj.f() 拒绝（含同类另一实例/链式对象）。
                            if (isFuncSectionMethod(base3, callee.memberName()) != 0) {
                                int isThis = 0;
                                if (mo != null && mo.kind() == "Identifier" && mo.name() == "this") isThis = 1;
                                if (isThis == 0) {
                                    diag_.error(callee.line(), callee.col(), "cannot access function '" + callee.memberName() + "' from outside class '" + base3 + "'");
                                    ret = "void";
                                }
                            }
                            ArrayList<AstParam> anyMps = findMethodParams(base3, callee.memberName());
                            int normFailed = 0;
                            if (anyMps != null) {
                                if (normalizeCallArgs(e, anyMps) == 0) { normFailed = 1; ret = "void"; }
                                else e.setCallParamTypes(paramKinds(anyMps));
                            }
                            string fr = findMethodRet(base3, callee.memberName(), e.args().size());
                            if (Str.len(fr) == 0) fr = findIfaceMethodRet(base3, callee.memberName());
                            // B3（C++ BUG-017 镜像）：接口变量关联类型方法——sb.getVal()
                            // 返回接口占位 assoc，但 sb 的具体类已知（sb = new StrBox()）
                            // → 从具体类同名方法解析真实返回类型（string/int），并把
                            // 具体类记到 CallExpr.resolvedClass 供 codegen 分派用。
                            // 具体类从作用域感知的符号条目取（泛型实例化方法参数不受
                            // 测试级同名变量污染）。
                            // B3 扩展（devirt）：接口方法调用（对象是接口变量）且具体类
                            // 已知（声明时 concreteClass 快照）且从未被重赋值 →
                            // resolvedClass 记具体类，codegen 据此发直接调用（devirt，
                            // 让 LLVM 内联）。assoc 关联类型方法另用具体类返回类型
                            // 覆盖（原 BUG-017）。
                            if (mo != null && mo.kind() == "Identifier") {
                                SymbolEntry bent = sym_.lookupEntry(mo.name());
                                string ccls = "";
                                int reassigned = 1;
                                if (bent != null) {
                                    ccls = bent.concreteClass();
                                    reassigned = bent.reassigned();
                                }
                                if (Str.len(ccls) != 0 && reassigned == 0
                                    && inInterface(resolveBase(cn)) != 0) {
                                    string cret = findMethodRet(resolveBase(ccls), callee.memberName(), e.args().size());
                                    if (Str.len(cret) != 0) {
                                        e.setResolvedClass(ccls);
                                        if (fr == "assoc") fr = cret;
                                    }
                                }
                            }
                            if (normFailed == 0 && Str.len(fr) != 0) {
                                // BUG-012/现有规则镜像 C++：@thread 实例的 action 禁止
                                // 跨线程直接调用（须经 mapping() 投递到其工作线程）；
                                // @startup 由工作线程自动调用，手动调用双执行。
                                if (mo != null && mo.kind() == "Identifier" && isThreadVar(mo.name()) != 0) {
                                    if (isStartupMethod(base3, callee.memberName()) != 0) {
                                        diag_.error(callee.line(), callee.col(), "cannot manually call '@startup' method '" + callee.memberName() + "' on a @thread instance (auto-invoked in the worker thread)");
                                    } else {
                                        diag_.error(callee.line(), callee.col(), "cannot directly call action '" + callee.memberName() + "' on a @thread instance — cross-thread calls must go through mapping()");
                                        ret = "void";
                                    }
                                }
                                // @coro 方法调用返回协程句柄（long）
                                if (isMethodCoro(base3, callee.memberName()) != 0) ret = "long";
                                else {
                                    ret = fr;
                                    // 泛型方法返回类型替换：T → 实例类型参数
                                    SymbolEntry men = null;
                                    if (mo != null && mo.kind() == "Identifier") men = sym_.lookupEntry(mo.name());
                                    AstType mrt = findMethodRetAst(base3, callee.memberName());
                                    if (mrt != null) {
                                        string sub = "";
                                        if (men != null && men.instArgs().size() > 0) {
                                            sub = substRet(base3, mrt, men);
                                        } else if (mo != null && mo.kind() == "Identifier") {
                                            // F4-G2b：类作用域已弹出（双 pass），裸属性
                                            // 实例的 typeArgs 从当前类成员表回退解析。
                                            AstType pta = currentClassMemberAstType(mo.name());
                                            if (pta != null && pta.typeArgs().size() > 0) {
                                                sub = substRetAst(base3, mrt, pta.typeArgs());
                                            }
                                        } else if (mo != null) {
                                            // 链式调用：t.m().get() —— mo 是 Call，用其返回实例的 typeArgs
                                            string vcn = mo.valueClass();
                                            if (Str.len(vcn) == 0) vcn = mo.resolvedClass();
                                            if (Str.len(vcn) != 0) {
                                                ArrayList<AstType> targs = findInstTypeArgs(vcn);
                                                if (targs != null) sub = substRetAst(base3, mrt, targs);
                                            }
                                        }
                                        if (Str.len(sub) != 0 && sub != fr) {
                                            ret = sub;
                                            // 替换结果是类名 → resolvedKind "class" + valueClass_
                                            if (findClass(resolveBase(sub)) >= 0) {
                                                ret = "class";
                                                e.setValueClass(sub);
                                            } else if (inStructName(sub) != 0 || inInterface(sub) != 0) {
                                                ret = inStructName(sub) != 0 ? "struct" : "interface";
                                                e.setValueClass(sub);
                                            }
                                        }
                                    }
                                    // 记录返回类名（供 obj.method().field 链式解析）
                                    if (Str.len(e.valueClass()) == 0) {
                                        string rcl = findMethodRetClass(base3, callee.memberName());
                                        if (Str.len(rcl) != 0) e.setResolvedClass(rcl);
                                    }
                                }
                                // 默认参数补全（C++ normalizeArgsToParamDecls）
                                ArrayList<AstParam> mps = findMethodParams(base3, callee.memberName());
                                if (normFailed == 0 && mps != null) fillDefaultArgs(e, mps);
                            }
                        } else if (inClass_ != 0) {
                            string fr = findMethodRet(currentClass_, callee.memberName(), e.args().size());
                            if (Str.len(fr) != 0) {
                                if (isMethodCoro(currentClass_, callee.memberName()) != 0) ret = "long";
                                else {
                                    ret = fr;
                                    string rcl = findMethodRetClass(currentClass_, callee.memberName());
                                    if (Str.len(rcl) != 0) e.setResolvedClass(rcl);
                                }
                                ArrayList<AstParam> mps = findMethodParams(currentClass_, callee.memberName());
                                if (mps != null) fillDefaultArgs(e, mps);
                            }
                        }
                    } else {
                        visitExpr(callee);
                    }
                }
                if (e.argsVisited() == 0 && callFailed == 0) {
                    for (int i = 0; i < e.args().size(); i = i + 1) visitExpr(e.args().get(i));
                } else if (callFailed != 0) {
                    // C++ visitCall 对不可调用 callee 提前返回、不访问实参（默认 Int）
                    for (int i = 0; i < e.args().size(); i = i + 1) markAllExpr(e.args().get(i));
                    e.setArgsVisited(1);
                }
                // C++ visitCall：lambda 实参匹配具体函数类型形参时，visitLambda 被直接
                // 调用（不经 visitExpr 调度器），resolved_kind 保持默认 Int；其余路径
                // 为 Function。MYP visitLambda 一律置 function → 此处回退 int 对齐。
                ArrayList<string> cptLambda = e.callParamTypes();
                if (cptLambda != null) {
                    for (int i = 0; i < e.args().size() && i < cptLambda.size(); i = i + 1) {
                        AstExpr argL = e.args().get(i);
                        if (argL != null && argL.kind() == "Lambda" && cptLambda.get(i) == "function") {
                            argL.setResolvedKind("int");
                        }
                    }
                }
                if (e.callParamTypes() != null) {
                    ArrayList<string> cpts = e.callParamTypes();
                    // 任一形参 kind 未解析（void，如泛型占位符未替换）→ 跳过检查，
                    // 避免对合法泛型方法调用误报。
                    int anyVoidParam = 0;
                    for (int i = 0; i < cpts.size(); i = i + 1) {
                        if (cpts.get(i) == "void") { anyVoidParam = 1; break; }
                    }
                    if (anyVoidParam == 0) {
                        for (int i = 0; i < e.args().size() && i < cpts.size(); i = i + 1) {
                            AstExpr argi = e.args().get(i);
                            string at = argi != null ? argi.resolvedKind() : "void";
                            // C++ 用 visitLambda 返回的 Function 类型做实参检查（而非
                            // resolved_kind 注解），lambda 实参匹配函数形参时按 function 检查。
                            if (argi != null && argi.kind() == "Lambda" && cpts.get(i) == "function") {
                                at = "function";
                            }
                            string pt = cpts.get(i);
                            if (Str.len(at) != 0 && Str.len(pt) != 0 && typesCompat(pt, at) == 0) {
                                int al = argi != null ? argi.line() : 0;
                                int ac = argi != null ? argi.col() : 0;
                                diag_.error(al, ac, "argument " + (i + 1) + ": expected '" + pt + "', got '" + at + "'");
                            } else if (Str.len(at) != 0 && Str.len(pt) != 0 && isNarrowingKind(at, pt) != 0) {
                                // C++ visitCall 的 narrowing warning 等价（selfhost 无参名
                                // 元数据 → 不带形参名；仅比 dump 不比 stderr，不影响对拍）。
                                int al = argi != null ? argi.line() : 0;
                                int ac = argi != null ? argi.col() : 0;
                                diag_.warn(al, ac, "argument " + (i + 1) + ": passing '" + at + "' to parameter of type '" + pt + "' is a narrowing conversion; if this is a misplaced/missed argument, fix the call, otherwise use convert<" + pt + ">(...) to make it explicit");
                            }
                        }
                    }
                }
                e.setResolvedKind(ret);
                return ret;
            }
            if (k == "Member") {
                AstExpr kernelObj = e.array();
                if (inGpuFor_ != 0 && kernelObj != null && kernelObj.kind() == "Identifier" && kernelObj.name() == "kernel") {
                    kernelObj.setResolvedKind("int");
                    if (e.memberName() == "gid" || e.memberName() == "bx" || e.memberName() == "tx"
                        || e.memberName() == "bd" || e.memberName() == "gx") {
                        e.setResolvedKind("long");
                        return "long";
                    }
                    diag_.error(e.line(), e.col(), "unknown kernel context member '" + e.memberName() + "'");
                    e.setResolvedKind("long");
                    return "long";
                }
                string o = e.array() != null ? visitExpr(e.array()) : "void";
                string t = "void";
                // C++ visitMemberAccess：void/非类对象访问成员 → 报错并返回 void，
                // 不设 resolvedClass（否则会错误回退到当前类"has no member"）。
                if (o == "void") {
                    diag_.error(e.line(), e.col(), "cannot access member of non-class type 'void'");
                    e.setResolvedKind("void");
                    return "void";
                }
                if (o == "bitfield") {
                    AstExpr bitObject = e.array();
                    string bitfieldName = "";
                    if (bitObject != null && bitObject.kind() == "Identifier") bitfieldName = sym_.lookupClass(bitObject.name());
                    else if (bitObject != null) {
                        bitfieldName = bitObject.valueClassName();
                        if (Str.len(bitfieldName) == 0) bitfieldName = bitObject.resolvedClassName();
                    }
                    string bitType = bitfieldMemberType(bitfieldName, e.memberName());
                    if (Str.len(bitType) != 0) {
                        e.setResolvedClass(bitfieldName);
                        e.setResolvedKind(bitType);
                        return bitType;
                    }
                }
                if (o == "float4" && (e.memberName() == "x" || e.memberName() == "y"
                    || e.memberName() == "z" || e.memberName() == "w")) {
                    e.setResolvedKind("float");
                    return "float";
                }
                // slice.size()/.length() → int，slice.data() → array（C++ slice 内建）
                if (o == "slice") {
                    if (e.memberName() == "size" || e.memberName() == "length") {
                        e.setResolvedKind("int");
                        return "int";
                    }
                    if (e.memberName() == "data") {
                        e.setResolvedKind("array");
                        return "array";
                    }
                }
                // 静态类名.成员 → 解析为方法（function）或属性
                // 元组字段访问：t.0 / t.1 → 元组第 N 元素类型
                if (isIntegerStr(e.memberName()) != 0) {
                    AstExpr arr = e.array();
                    if (arr != null && arr.kind() == "Identifier") {
                        SymbolEntry en = sym_.lookupEntry(arr.name());
                        if (en != null && en.tupleTypes().size() != 0) {
                            int idx = myp_str_to_long(e.memberName());
                            if (idx >= 0 && idx < en.tupleTypes().size()) t = en.tupleTypes().get(idx);
                            else {
                                diag_.error(e.line(), e.col(), "tuple index " + e.memberName() + " out of range (" + en.tupleTypes().size() + " elements)");
                            }
                        }
                    }
                } else {
                    // MYP 注意：跨实例属性链访问（e.array_.kind_）产生垃圾 → 先用局部变量。
                    AstExpr arr = e.array();
                    string cn = "";
                    if (arr != null && arr.kind() == "Identifier") {
                        // 实例变量优先（符号表类名）；若是当前 struct 的字段，再回退到 struct 成员类型。
                        cn = sym_.lookupClass(arr.name());
                        if (Str.len(cn) == 0 && arr.name() == "this" && inClass_ != 0) cn = currentClass_;
                        if (Str.len(cn) == 0 && inClass_ != 0) {
                            cn = currentClassMemberClassName(arr.name());
                            if (Str.len(cn) == 0 && inStruct_ != 0) cn = currentStructMemberClassName(arr.name());
                            if (Str.len(cn) == 0) cn = arr.name();
                        }
                        if (Str.len(cn) == 0) cn = arr.name();
                    } else if (arr != null && (arr.kind() == "Call" || arr.kind() == "Subscript" || arr.kind() == "Member" || arr.kind() == "New")) {
                        // 方法调用结果 / 数组元素 / 属性 / new → 用其值类名
                        cn = arr.valueClass();
                        if (Str.len(cn) == 0) cn = arr.resolvedClass();
                    } else if (arr != null && arr.kind() == "New") {
                        cn = arr.valueClass();
                        if (Str.len(cn) == 0) cn = arr.resolvedClass();
                    }
                    if (Str.len(cn) != 0) {
                        string base2 = resolveBase(cn);
                        int ci = findClass(base2);
                        if (ci >= 0) {
                            e.setResolvedClass(cn);
                            if (hasMethod(base2, e.memberName()) != 0) {
                                t = "function";
                            } else {
                                string pt = findPropType(ci, e.memberName());
                                if (Str.len(pt) != 0) {
                                    // C++：properties 私有——外部实例访问拒绝（this.prop / 同类另一实例 / 静态类.prop）。
                                    int allowProp = 0;
                                    if (arr != null && arr.kind() == "Identifier" && arr.name() == "this") allowProp = 1;
                                    else if (base2 == currentClass_) allowProp = 1;
                                    else if (arr != null && arr.kind() == "Identifier" && isStaticClass(arr.name()) != 0) allowProp = 1;
                                    if (allowProp == 0) {
                                        diag_.error(e.line(), e.col(), "cannot access property '" + e.memberName() + "' of '" + base2 + "' from outside the class (properties are private; use a getter action or a struct)");
                                    } else {
                                        t = pt;
                                        string pcl = findPropTypeClass(ci, e.memberName());
                                        if (Str.len(pcl) != 0) e.setValueClass(pcl);
                                    }
                                } else {
                                    // C++：class 'M' has no member 'x'
                                    diag_.error(e.line(), e.col(), "class '" + base2 + "' has no member '" + e.memberName() + "'");
                                }
                            }
                        } else {
                            // 接口方法 / struct 字段 / enum 变体
                            if (Str.len(findIfaceMethodRet(cn, e.memberName())) != 0) {
                                e.setResolvedClass(cn);
                                t = "function";
                            } else {
                                int eei = findEnum(cn);
                                if (eei >= 0) {
                                    e.setResolvedClass(cn);
                                    if (enumHasVariant(eei, e.memberName()) != 0) {
                                        t = "enum";
                                    } else {
                                        // C++：enum 'Color' has no variant 'Xyz'
                                        diag_.error(e.line(), e.col(), "enum '" + cn + "' has no variant '" + e.memberName() + "'");
                                    }
                                } else {
                                    int si = findStruct(cn);
                                    if (si >= 0) {
                                        e.setResolvedClass(cn);
                                        // struct 方法
                                        if (hasMethod(cn, e.memberName()) != 0) {
                                            t = "function";
                                        } else {
                                            string spt = findStructProp(si, e.memberName());
                                            if (Str.len(spt) != 0) {
                                                t = spt;
                                                AstType spta = findStructPropAst(si, e.memberName());
                                                if (spta != null && Str.len(spta.className()) != 0) {
                                                    // 泛型类字段 ArrayList<int> → 记录实例类名
                                                    //（否则成员方法解析到模板名 ArrayList，形参 T 无法替换）
                                                    if (spta.typeArgs().size() > 0) e.setValueClass(instClassName(spta));
                                                    else e.setValueClass(spta.className());
                                                }
                                            } else {
                                                // C++：struct 'S' has no member 'y'
                                                diag_.error(e.line(), e.col(), "struct '" + cn + "' has no member '" + e.memberName() + "'");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else if (inClass_ != 0) {
                        int ci = findClass(currentClass_);
                        if (ci >= 0) {
                            e.setResolvedClass(currentClass_);
                            if (hasMethod(currentClass_, e.memberName()) != 0) t = "function";
                            else {
                                string pt = findPropType(ci, e.memberName());
                                if (Str.len(pt) != 0) {
                                    t = pt;
                                    string pcl = findPropTypeClass(ci, e.memberName());
                                    if (Str.len(pcl) != 0) e.setValueClass(pcl);
                                } else {
                                    // C++：class 'M' has no member 'x'（this 访问）
                                    diag_.error(e.line(), e.col(), "class '" + currentClass_ + "' has no member '" + e.memberName() + "'");
                                }
                            }
                        }
                    }
                }
                e.setResolvedKind(t);
                return t;
            }
            if (k == "Subscript") {
                string o = e.array() != null ? visitExpr(e.array()) : "void";
                if (e.index() != null) visitExpr(e.index());
                string et = "array";
                if (o == "bitvector") et = "bit";
                // 数组/切片变量 → 元素类型；string 下标 → char
                AstExpr sa = e.array();
                if (sa != null && sa.kind() == "Identifier") {
                    SymbolEntry en = sym_.lookupEntry(sa.name());
                    if (en != null && Str.len(en.elementType()) != 0) {
                        et = en.elementType();
                        if (Str.len(en.elementClass()) != 0) e.setResolvedClass(en.elementClass());
                        // 嵌套 slice：rows[i] 元素是 slice → 记录深层元素
                        if (et == "slice" && Str.len(en.elementElem()) != 0) e.setSliceElem(en.elementElem());
                    } else if (inStruct_ != 0) {
                        // F4：struct 方法内裸字段下标 energies[0] → 元素类型。
                        // 注意：struct 方法分析时 inClass_ 也=1，故 inStruct_ 必须
                        // 排在 inClass_ 之前，否则被 else-if 链跳过。
                        int ssi = findStruct(currentClass_);
                        if (ssi >= 0) {
                            AstType pt = findStructPropAst(ssi, sa.name());
                            if (pt != null && pt.element() != null) {
                                AstType el = pt.element();
                                et = typeToKind(el);
                                if (Str.len(el.className()) != 0) e.setResolvedClass(el.className());
                            }
                        }
                    } else if (inClass_ != 0) {
                        AstType pt = currentClassMemberAstType(sa.name());
                        if (pt != null && pt.element() != null) {
                            AstType el = pt.element();
                            et = typeToKind(el);
                            if (Str.len(el.className()) != 0) e.setResolvedClass(el.className());
                        }
                    }
                } else if (sa != null && sa.kind() == "Subscript") {
                    // 嵌套 slice 双下标：rows[i][j] → 内层返回 slice，取深层元素
                    string inner = sa.resolvedKind();
                    if (inner == "slice") {
                        string se = sa.sliceElem();
                        if (Str.len(se) != 0) et = se;
                    }
                } else if (sa != null && sa.kind() == "Call") {
                    AstExpr bytesCallee = sa.callee();
                    if (bytesCallee != null && bytesCallee.kind() == "Identifier" && bytesCallee.name() == "bytesOf") et = "ubyte";
                    else {
                        // f()[i]：顶层函数返回 T[] → 元素类型（BUG-058，自举缺口——
                        // 返回数组的元素类型没传到 Subscript，实测报 expected numeric
                        // type, got 'array'。对齐 BUG-057 思路，从返回 AstType 取 element）。
                        AstExpr cal = sa.callee();
                        if (cal != null && cal.kind() == "Identifier") {
                            AstType fret = findFuncRetType(cal.name(), sa.args().size());
                            if (fret != null && fret.element() != null) {
                                AstType el = fret.element();
                                et = typeToKind(el);
                                if (Str.len(el.className()) != 0) e.setResolvedClass(el.className());
                            } else if (fret != null && fret.className() == "slice" && fret.typeArgs().size() > 0) {
                                // slice<T> 返回：元素在 typeArgs（非 element）
                                AstType el = fret.typeArgs().get(0);
                                et = typeToKind(el);
                                if (Str.len(el.className()) != 0) e.setResolvedClass(el.className());
                            }
                        } else if (cal != null && cal.kind() == "Member") {
                            // b.get()[i]：方法返回 T[] → 元素类型（用 Member 自身
                            // resolvedClass，sema 解析成员时已设具体类名）。
                            string mcls = cal.resolvedClass();
                            if (Str.len(mcls) == 0) {
                                AstExpr mobj = cal.array();
                                if (mobj != null && mobj.kind() == "Identifier") mcls = sym_.lookupClass(mobj.name());
                                if (Str.len(mcls) == 0 && mobj != null) { mcls = mobj.valueClass(); if (Str.len(mcls) == 0) mcls = mobj.resolvedClass(); }
                            }
                            if (Str.len(mcls) != 0) {
                                AstType mret = findMethodRetAst(resolveBase(mcls), cal.memberName());
                                if (mret != null && mret.element() != null) {
                                    AstType el = mret.element();
                                    et = typeToKind(el);
                                    if (Str.len(el.className()) != 0) e.setResolvedClass(el.className());
                                } else if (mret != null && mret.className() == "slice" && mret.typeArgs().size() > 0) {
                                    // b.get()[i]：方法返回 slice<T> → 元素在 typeArgs
                                    AstType el = mret.typeArgs().get(0);
                                    et = typeToKind(el);
                                    if (Str.len(el.className()) != 0) e.setResolvedClass(el.className());
                                }
                            }
                        }
                    }
                } else if (sa != null && sa.kind() == "Member") {
                    // obj.prop 数组属性 → 元素类型
                    AstExpr mo2 = sa.array();
                    if (mo2 != null && mo2.kind() == "Identifier") {
                        string cn2 = sym_.lookupClass(mo2.name());
                        if (Str.len(cn2) == 0 && mo2.name() == "this" && inClass_ != 0) cn2 = currentClass_;
                        if (Str.len(cn2) == 0 && inClass_ != 0) {
                            AstType pt = currentClassMemberAstType(mo2.name());
                            if (pt != null && Str.len(pt.className()) != 0) cn2 = pt.className();
                        }
                        if (Str.len(cn2) == 0) cn2 = mo2.name();
                        int ci2 = findClass(cn2);
                        if (ci2 >= 0) {
                            AstType pt2 = findPropTypeAst(ci2, sa.memberName());
                            if (pt2 != null && pt2.element() != null) {
                                // MYP 注意：链式字段访问（pt2.element_.xxx）产生垃圾
                                // → 先取局部变量再读字段（同本文件既有规避模式）。
                                AstType elt = pt2.element();
                                et = typeToKind(elt);
                                // F4：数组元素是类/struct → 记 resolvedClass，供链式 .name 解析
                                if (Str.len(elt.className()) != 0) e.setResolvedClass(elt.className());
                            }
                        } else {
                            // F4：struct 变量 .数组字段 下标（ba.data[0]）→ 元素类型
                            int ssi2 = findStruct(cn2);
                            if (ssi2 >= 0) {
                                AstType sp2 = findStructPropAst(ssi2, sa.memberName());
                                if (sp2 != null && sp2.element() != null) {
                                    AstType elt2 = sp2.element();
                                    et = typeToKind(elt2);
                                    if (Str.len(elt2.className()) != 0) e.setResolvedClass(elt2.className());
                                }
                            }
                        }
                    }
                }
                if (et == "array" && o == "string") et = "char";
                e.setResolvedKind(et);
                return et;
            }
            if (k == "New") {
                // slice<T>(n) → slice 类型
                if (e.className() == "slice") {
                    for (int i = 0; i < e.args().size(); i = i + 1) visitExpr(e.args().get(i));
                    e.setResolvedKind("slice");
                    return "slice";
                }
                // 泛型类实例化（C++ typeNodeToTypeInfo 单态化 → 生成 _inst 类）
                if (e.typeArgs().size() > 0) tryInstantiate(e.className(), e.typeArgs());
                // 解析构造器名（类中 ctor 标记的 action/function）
                string cn = e.className();
                string resolvedClass = cn;
                if (Str.len(e.className()) != 0) {
                    if (e.typeArgs().size() > 0 && isGenericClass(e.className()) != 0) {
                        int hasPh = 0;
                        for (int i = 0; i < e.typeArgs().size(); i = i + 1) {
                            AstType taa = e.typeArgs().get(i);
                            if (taa != null && (inGeneric(taa.className()) != 0 || inGeneric(taa.basicName()) != 0)) { hasPh = 1; break; }
                        }
                        if (hasPh == 0) {
                            string iname = e.className();
                            for (int i = 0; i < e.typeArgs().size(); i = i + 1) iname = iname + "_" + instClassName(e.typeArgs().get(i));
                            resolvedClass = iname + "_inst";
                        }
                    }
                }
                string ctor = "";
                int sawCtor = 0;
                ArrayList<string> ctorArgKinds = new ArrayList<string>();
                if (tu_ != null) {
                    ArrayList<string> classNames = new ArrayList<string>();
                    if (resolvedClass != cn) classNames.add(resolvedClass);
                    classNames.add(cn);
                    for (int ci = 0; ci < classNames.size(); ci = ci + 1) {
                        string candidate = classNames.get(ci);
                        for (int i = 0; i < tu_.classes().size(); i = i + 1) {
                            AstClass cl = tu_.classes().get(i);
                            if (cl.name() != candidate) continue;
                            // F4：构造器重载解析（对齐 C++ resolveNewConstructor）。
                            // 收集 action:/function: 段构造器候选，按实参个数+类型
                            // 兼容打分选最优（默认参数允许缺省）；无候选 → legacy 默认。
                            ArrayList<string> candNames = new ArrayList<string>();
                            ArrayList<ArrayList<AstParam>> candParams = new ArrayList<ArrayList<AstParam>>();
                            ArrayList<AstAction> acts = cl.actions();
                            for (int j = 0; j < acts.size(); j = j + 1) {
                                AstAction a = acts.get(j);
                                if (a.ctor() != 0) { candNames.add(a.name()); candParams.add(a.params()); }
                            }
                            ArrayList<AstFunction> fs = cl.funcs();
                            for (int j = 0; j < fs.size(); j = j + 1) {
                                AstFunction f = fs.get(j);
                                if (f.ctor() != 0) { candNames.add(f.name()); candParams.add(f.params()); }
                            }
                            if (candNames.size() == 0) break;  // 无构造器 → legacy
                            sawCtor = 1;
                            // 实参类型：命名赋值实参只访问其值（C++ resolveNewConstructor），
                            // 否则访问整个实参。
                            ArrayList<string> argKinds = new ArrayList<string>();
                            for (int j = 0; j < e.args().size(); j = j + 1) {
                                AstExpr ar = e.args().get(j);
                                if (ar != null && ar.kind() == "Assign" && ar.rhs() != null) argKinds.add(visitExpr(ar.rhs()));
                                else if (ar != null) argKinds.add(visitExpr(ar));
                                else argKinds.add("void");
                            }
                            ctorArgKinds = argKinds;
                            int best = -1;
                            int bestScore = 1 << 30;
                            int ambiguous = 0;
                            for (int j = 0; j < candNames.size(); j = j + 1) {
                                ArrayList<AstParam> ps = candParams.get(j);
                                ArrayList<int> plan = planCallArgs(e, ps);
                                if (plan == null) continue;
                                int argsOK = 1;
                                int promos = 0;
                                for (int k2 = 0; k2 < ps.size(); k2 = k2 + 1) {
                                    if (plan.get(k2) < 0) continue;  // 缺省
                                    AstParam p = ps.get(k2);
                                    string pk = p.type() != null ? typeToKind(p.type()) : "void";
                                    string at = argKinds.get(plan.get(k2));
                                    if (ctorArgCompat(pk, at) == 0) { argsOK = 0; break; }
                                    if (pk != at) promos = promos + 1;
                                }
                                if (argsOK == 0) continue;
                                if (best < 0 || promos < bestScore) { best = j; bestScore = promos; ambiguous = 0; }
                                else if (promos == bestScore) ambiguous = 1;
                            }
                            if (best >= 0 && ambiguous == 0) {
                                ctor = candidate + "_" + candNames.get(best) + mangleParams(candParams.get(best));
                                // 规范化实参：命名→NamedArg、重排到形参序、缺省补全。
                                normalizeCallArgs(e, candParams.get(best));
                                // C++ 构造器缺省补全的默认值不被访问（保持默认 Int）
                                for (int dj = 0; dj < e.args().size(); dj = dj + 1) {
                                    if (Str.len(e.args().get(dj).resolvedKind()) == 0) markAllExpr(e.args().get(dj));
                                }
                            }
                            if (Str.len(ctor) != 0) break;
                        }
                        if (Str.len(ctor) != 0) break;
                    }
                }
                if (sawCtor != 0 && Str.len(ctor) == 0) {
                    StringBuilder asb = new StringBuilder();
                    for (int i = 0; i < ctorArgKinds.size(); i = i + 1) {
                        if (i != 0) asb.append(", ");
                        asb.append(ctorArgKinds.get(i));
                    }
                    int dl = e.endLine() != 0 ? e.endLine() : e.line();
                    int dc = e.endCol() != 0 ? e.endCol() : e.col();
                    diag_.error(dl, dc, "no matching constructor for '" + resolvedClass + "(" + asb.toString() + ")'");
                }
                e.setCtor(ctor);
                e.setResolvedKind("class");
                if (Str.len(e.className()) != 0) {
                    if (e.typeArgs().size() > 0 && isGenericClass(e.className()) != 0) {
                        // C++ has_placeholder：实参含泛型占位符 → resolvedClass 用模板名
                        int hasPh = 0;
                        for (int i = 0; i < e.typeArgs().size(); i = i + 1) {
                            AstType taa = e.typeArgs().get(i);
                            if (taa != null && (inGeneric(taa.className()) != 0 || inGeneric(taa.basicName()) != 0)) { hasPh = 1; break; }
                        }
                        if (hasPh != 0) {
                            e.setResolvedClass(e.className());
                        } else {
                            string iname = e.className();
                            for (int i = 0; i < e.typeArgs().size(); i = i + 1) iname = iname + "_" + instClassName(e.typeArgs().get(i));
                            e.setResolvedClass(iname + "_inst");
                        }
                    } else {
                        e.setResolvedClass(e.className());
                    }
                }
                if (sawCtor == 0) {
                    // legacy（无构造器）：访问全部实参（有构造器时匹配阶段已访问其值）
                    for (int i = 0; i < e.args().size(); i = i + 1) visitExpr(e.args().get(i));
                }
                return "class";
            }
            if (k == "NewArray") {
                for (int i = 0; i < e.dimensions().size(); i = i + 1) visitExpr(e.dimensions().get(i));
                e.setResolvedKind("array");
                return "array";
            }
            if (k == "Tuple") {
                for (int i = 0; i < e.elements().size(); i = i + 1) visitExpr(e.elements().get(i));
                e.setResolvedKind("tuple");
                return "tuple";
            }
            if (k == "MacroParam") { e.setResolvedKind("int"); return "int"; }
            if (k == "Quote") {
                if (e.bodyStmt() != null) markAllStmt(e.bodyStmt());
                e.setResolvedKind("int");
                return "void";
            }
            if (k == "Await") {
                if (inCoro_ == 0) {
                    diag_.error(e.line(), e.col(), "'await' is only allowed inside an '@coro' method");
                }
                string t = "long";
                AstExpr op = e.operand();
                if (op != null) {
                    // 事件引用 Class.event + timeout → int（C++ 对 await 事件标 int）
                    if (op.kind() == "Member") {
                        AstExpr ao2 = op.array();
                        if (e.timeout() != null && ao2 != null && ao2.kind() == "Identifier" && isEvent(ao2.name(), op.memberName()) != 0) {
                            ao2.setResolvedKind("int");
                            op.setResolvedKind("int");
                        } else {
                            // @async 调用形态 → 返回调用返回类型
                            if (op.kind() == "Call") t = visitExpr(op);
                            else visitExpr(op);
                        }
                    } else {
                        if (op.kind() == "Call") t = visitExpr(op);
                        else visitExpr(op);
                    }
                }
                if (e.timeout() != null) visitExpr(e.timeout());
                e.setResolvedKind(t);
                return t;
            }
            if (k == "NamedArg") {
                string t = e.namedValue() != null ? visitExpr(e.namedValue()) : "void";
                e.setResolvedKind(t);
                return t;
            }
            if (k == "Pipe") {
                string leftKind = e.lhs() != null ? visitExpr(e.lhs()) : "void";
                AstExpr target = e.rhs();
                string cls = "";
                if (target != null && target.kind() == "Identifier") {
                    cls = sym_.lookupClass(target.name());
                    if (Str.len(cls) != 0) e.setTargetKind("instance");
                    else if (findClass(target.name()) >= 0) {
                        cls = target.name();
                        e.setTargetKind("class");
                    }
                    target.setResolvedKind("int");
                } else if (target != null) {
                    visitExpr(target);
                }
                if (Str.len(cls) != 0) {
                    e.setClassType(cls);
                    string ret = findMethodRet(resolveBase(cls), e.method(), 1);
                    if (Str.len(ret) != 0) {
                        // BUG-006 镜像 C++：main 内管道解析到 class transform → 拒绝。
                        if (inMain_ != 0 && inStruct_ == 0) {
                            diag_.error(e.line(), e.col(), "direct function call not allowed in main() — use mapping() instead (pipe to '" + target.name() + ".transform')");
                        }
                        leftKind = ret;
                    }
                }
                e.setResolvedKind(leftKind);
                return leftKind;
            }
            if (k == "Lambda") {
                // F4-L：合成 __lambda_N 类（C++ visitLambda）——__call action +
                // 捕获槽 cap_i 属性 + body 前置捕获拷贝。
                string cls = "__lambda_" + lambdaCounter_;
                lambdaCounter_ = lambdaCounter_ + 1;
                e.setHiddenClass(cls);
                ArrayList<string> params = new ArrayList<string>();
                for (int i = 0; i < e.params().size(); i = i + 1) {
                    string pn = e.params().get(i).name();
                    if (Str.len(pn) != 0 && listHas(params, pn) == 0) params.add(pn);
                }
                ArrayList<string> locals = new ArrayList<string>();
                for (int i = 0; i < params.size(); i = i + 1) locals.add(params.get(i));
                if (Str.len(e.name()) != 0) locals.add(e.name());
                if (e.bodyStmt() != null) collectStmtLocals(e.bodyStmt(), locals);
                ArrayList<string> captures = new ArrayList<string>();
                if (e.bodyStmt() != null) collectStmtCaptures(e.bodyStmt(), params, locals, captures);
                // M-FN-2 nonlocal：收集 `nonlocal name;` 声明并加入捕获集（只写不读也
                // 共享 cell）。非嵌套、非 struct 方法校验略（正语料不触发）。
                ArrayList<string> nonlocalNames = new ArrayList<string>();
                if (e.bodyStmt() != null) collectStmtNonlocal(e.bodyStmt(), nonlocalNames);
                for (int i = 0; i < nonlocalNames.size(); i = i + 1) {
                    if (listHas(captures, nonlocalNames.get(i)) == 0) captures.add(nonlocalNames.get(i));
                }
                AstClass lc = new AstClass();
                lc.setName(cls);
                lc.setLambda(e.name());
                AstStmt body = e.bodyStmt();
                if (captures.size() != 0) {
                    // 捕获拷贝语句：T cap = this.cap_i; ——插入原 Block 开头
                    // （body 是 Block 时直接 prepend，否则包一层）。
                    ArrayList<AstStmt> preStmts = new ArrayList<AstStmt>();
                    for (int i = 0; i < captures.size(); i = i + 1) {
                        string cap = captures.get(i);
                        int isNl = listHas(nonlocalNames, cap);
                        SymbolEntry ce = sym_.lookupEntry(cap);
                        AstType cty = ce != null ? entryToAstType(ce) : new AstType();
                        AstProp cp = new AstProp();
                        cp.setName("cap_" + i);
                        if (isNl != 0) {
                            // nonlocal：槽类型 = cell 类引用（__cell_N），共享可变 cell；
                            // 跳过捕获拷贝（codegen 注入 cell 属性别名）。
                            string ccell = nonlocalCellClass(cty);
                            AstType cellType = new AstType();
                            cellType.setClassName(ccell);
                            cp.setType(cellType);
                            lc.props().add(cp);
                            e.captureNames().add(cap);
                            e.captureSlots().add("cap_" + i);
                            e.nonlocalCells().add(ccell);
                            AstNonlocalSlot ns = new AstNonlocalSlot();
                            ns.setSlot("cap_" + i);
                            ns.setVarName(cap);
                            ns.setCell(ccell);
                            lc.nonlocalSlots().add(ns);
                        } else {
                            cp.setType(cty);
                            lc.props().add(cp);
                            e.captureNames().add(cap);
                            e.captureSlots().add("cap_" + i);
                            e.nonlocalCells().add("");
                            AstExpr th = new AstExpr();
                            th.setKind("This");
                            AstExpr ma = new AstExpr();
                            ma.setKind("Member");
                            ma.setMemberName("cap_" + i);
                            ma.setArray(th);
                            AstVar vd = new AstVar();
                            vd.setName(cap);
                            vd.setType(cty);
                            vd.setInit(ma);
                            AstStmt vs = new AstStmt();
                            vs.setKind("VarDecl");
                            vs.decls().add(vd);
                            preStmts.add(vs);
                        }
                    }
                    if (preStmts.size() != 0) {
                        if (body != null && body.kind() == "Block") {
                            // 重建 Block：前置捕获拷贝 + 原块语句（ArrayList 无 insert）。
                            AstStmt nb = new AstStmt();
                            nb.setKind("Block");
                            for (int i = 0; i < preStmts.size(); i = i + 1) nb.bodyStmts().add(preStmts.get(i));
                            for (int i = 0; i < body.bodyStmts().size(); i = i + 1) nb.bodyStmts().add(body.bodyStmts().get(i));
                            body = nb;
                        } else {
                            AstStmt nb = new AstStmt();
                            nb.setKind("Block");
                            for (int i = 0; i < preStmts.size(); i = i + 1) nb.bodyStmts().add(preStmts.get(i));
                            if (body != null) nb.bodyStmts().add(body);
                            body = nb;
                        }
                        // C++ 共享 body：Lambda 表达式节点 dump 也带捕获拷贝
                        e.setBodyStmt(body);
                    }
                }
                AstAction call = new AstAction();
                call.setName("__call");
                AstType rty = new AstType();
                rty.setBasicName("int");
                call.setRet(rty);
                for (int i = 0; i < e.params().size(); i = i + 1) call.params().add(e.params().get(i));
                call.setBody(body);
                lc.actions().add(call);
                if (tu_ != null) {
                    tu_.classes().add(lc);
                    // 登记类成员表（供 body 里 this.cap_i / 成员解析）
                    classNames_.add(cls);
                    classProps_.add(lc.props());
                    if (classIdx_.contains(cls) == 0) classIdx_.put(cls, classNames_.size() - 1);
                }
                // 在 lambda 类上下文类型检查 __call body（对齐 C++ visitClassDecl）
                string saveCls = currentClass_;
                int saveInCls = inClass_;
                int saveInSt = inStruct_;
                currentClass_ = cls;
                inClass_ = 1;
                inStruct_ = 0;
                sym_.enterScope();
                sym_.declare("this", "class");
                for (int i = 0; i < call.params().size(); i = i + 1) {
                    AstParam p = call.params().get(i);
                    sym_.declare(p.name(), typeToKind(p.type()));
                }
                for (int i = 0; i < captures.size(); i = i + 1) {
                    SymbolEntry ce = sym_.lookupEntry(captures.get(i));
                    if (ce != null) {
                        if (Str.len(ce.className()) != 0) sym_.declareClass(captures.get(i), "class", ce.className());
                        else if (Str.len(ce.elementType()) != 0 || Str.len(ce.elementClass()) != 0) {
                            AstType elt2 = new AstType();
                            if (Str.len(ce.elementClass()) != 0) elt2.setClassName(ce.elementClass());
                            else elt2.setBasicName(ce.elementType());
                            if (Str.len(ce.elementClass()) != 0) sym_.declareElemClass(captures.get(i), "array", typeToKind(elt2), ce.elementClass());
                               else if (ce.arraySize() > 0) sym_.declareFixedElem(captures.get(i), typeToKind(elt2), ce.arraySize());
                               else sym_.declareElem(captures.get(i), "array", typeToKind(elt2));
                        } else sym_.declare(captures.get(i), ce.type());
                    }
                }
                // C++ visitLambda 不内联访问完整 __call body（body 只在主 class-body
                // pass 分析一次）；否则嵌套 lambda 在首次访问就生成 __lambda_N，主 pass
                // 再生成一次 → 重复/编号漂移。返回类型：上下文类型（lambdaExpectedRet_）
                // 优先；否则只 visit 第一个 return 的值推断（等价 C++ inferLambdaReturn）。
                if (lambdaExpectedRet_ != null) {
                    call.setRet(lambdaExpectedRet_);
                    lambdaExpectedRet_ = null;
                } else {
                    AstExpr returnValue = null;
                    if (body != null && body.kind() == "Return") returnValue = body.value();
                    else if (body != null && body.kind() == "Block") {
                        for (int i = 0; i < body.bodyStmts().size(); i = i + 1) {
                            AstStmt stmt = body.bodyStmts().get(i);
                            if (stmt.kind() == "Return" && stmt.value() != null) {
                                returnValue = stmt.value();
                                break;
                            }
                        }
                    }
                    if (returnValue != null) {
                        visitExpr(returnValue);
                        call.setRet(argToAstType(returnValue));
                    }
                }
                sym_.leaveScope();
                currentClass_ = saveCls;
                inClass_ = saveInCls;
                inStruct_ = saveInSt;
                e.setResolvedKind("function");
                return "function";
            }
            if (k == "TryExpr") {
                string t = e.tryExpr() != null ? visitExpr(e.tryExpr()) : "void";
                string f = e.catchExpr() != null ? visitExpr(e.catchExpr()) : "void";
                // BUG-060：表达式 try 类型兼容检查（对齐 C++ visitTryExpr）——否则
                // try 给 int、catch 给 string 静默过 sema → codegen PHI i32/ptr 类型
                // 不匹配 → opt 崩（非干净诊断）。
                if (typesCompat(t, f) == 0) {
                    diag_.error(e.line(), e.col(), "try/catch expressions have incompatible types: '" + t + "' and '" + f + "'");
                    e.setResolvedKind(t);
                    return t;
                }
                e.setResolvedKind(t);
                return t;
            }
            if (k == "EnumVariant") {
                for (int i = 0; i < e.args().size(); i = i + 1) visitExpr(e.args().get(i));
                e.setResolvedKind("enum");
                return "enum";
            }
            if (k == "GpuReduceExpr") { e.setResolvedKind("void"); return "void"; }
            e.setResolvedKind("void");
            return "void";
        }
        // 位宽（bitcast 检查）
        int bitcastWidth(string k) {
            if (k == "byte" || k == "ubyte" || k == "char") return 8;
            if (k == "short" || k == "ushort") return 16;
            if (k == "int" || k == "uint" || k == "float") return 32;
            if (k == "long" || k == "ulong" || k == "double") return 64;
            return 0;
        }
        int isIntegerStr(string s) {
            if (Str.len(s) == 0) return 0;
            for (int i = 0; i < Str.len(s); i = i + 1) {
                int c = __myp_charcode(s, i);
                if (c < 48 || c > 57) return 0;
            }
            return 1;
        }
        // C++ visitCall 提前拦截名单：这些内建调用的 callee 不被 visit（保持默认 Int）。
        int isNoVisitIntr(string n) {
            if (n == "bytes" || n == "str" || n == "bytesOf") return 1;
            if (n == "parseInt" || n == "parseLong" || n == "parseUint" || n == "parseUlong"
                || n == "parseFloat" || n == "parseDouble" || n == "parseIntOpt") return 1;
            if (n == "popcount" || n == "clz" || n == "ctz" || n == "bitreverse"
                || n == "rotl" || n == "rotr") return 1;
            if (n == "load4" || n == "store4" || n == "checkedAdd" || n == "checkedMul") return 1;
            if (Str.startsWith(n, "__myp_math_") != 0) return 1;
            return 0;
        }
        // 顶层 mapping 与语句内 mapping：处理 where 子句（声明源事件参数）与 lambda 节点。
        void analyzeMapping(AstMapping mp) {
            ArrayList<AstMappingChain> mcs = mp.chains();
            // BUG-011 镜像 C++：mapping 节点用函数内局部实例变量名（`s.e -> t.a`）
            // → C++ handler 函数跨函数引用 LLVM verify 失败；自举侧虽以 %inst 兜
            // 底但不产生跨函数引用（语义仍错：注册全局，无法捕获函数局部实例）。
            // 统一编译期诊断：mapping 节点须用类名（实例级映射暂不支持）。
            for (int ni = 0; ni < mcs.size(); ni = ni + 1) {
                ArrayList<AstMappingNode> ndn = mcs.get(ni).nodes();
                for (int nj = 0; nj < ndn.size(); nj = nj + 1) {
                    AstMappingNode nn2 = ndn.get(nj);
                    if (nn2.isFunction() != 0 || nn2.isLambda() != 0 || nn2.isTransformer() != 0) continue;
                    string s2 = nn2.src();
                    int isCls2 = 0;
                    if (tu_ != null) {
                        for (int x2 = 0; x2 < tu_.classes().size(); x2 = x2 + 1) {
                            if (tu_.classes().get(x2).name() == s2) { isCls2 = 1; break; }
                        }
                    }
                    SymbolEntry se2 = sym_.lookupEntry(s2);
                    if (isCls2 == 0 && se2 != null) {
                        string cn2 = sym_.lookupClass(s2);
                        if (Str.len(cn2) == 0) cn2 = s2;
                        diag_.error(0, 0, "mapping 节点 '" + s2 + "' 是函数内局部变量名；"
                            + "实例级映射暂不支持，请改用类名节点（如 '" + cn2 + "." + nn2.member() + "'）");
                    }
                }
            }
            for (int cix = 0; cix < mcs.size(); cix = cix + 1) {
                AstMappingChain ch = mcs.get(cix);
                AstExpr wh = ch.whereClause();
                if (wh != null) {
                    ArrayList<AstMappingNode> nds = ch.nodes();
                    string evName = nds.size() > 0 ? nds.get(0).member() : "";
                    sym_.enterScope();
                    if (tu_ != null && Str.len(evName) != 0) {
                        for (int x = 0; x < tu_.classes().size(); x = x + 1) {
                            AstClass cl = tu_.classes().get(x);
                            ArrayList<AstEvent> evs = cl.events();
                            int foundEv = 0;
                            for (int y = 0; y < evs.size(); y = y + 1) {
                                AstEvent ev = evs.get(y);
                                if (ev.name() == evName) {
                                    ArrayList<AstParam> evp = ev.params();
                                    for (int p = 0; p < evp.size(); p = p + 1) declareParam(evp.get(p), 0);
                                    foundEv = 1;
                                    break;
                                }
                            }
                            if (foundEv != 0) break;
                        }
                    }
                    visitExpr(wh);
                    sym_.leaveScope();
                }
                ArrayList<AstMappingNode> nds2 = ch.nodes();
                for (int j = 0; j < nds2.size(); j = j + 1) {
                    AstMappingNode nn = nds2.get(j);
                    if (nn.lambda() != null) {
                        visitExpr(nn.lambda());
                        nn.lambda().setResolvedKind("int");
                    }
                }
            }
        }

        // 构造器 mangling（对应 C++ constructorMangledName / mangleTypeNode）
        string mangleType(AstType t) {
            if (t == null) return "unknown";
            if (t.element() != null) return mangleType(t.element()) + "_arr";
            if (Str.len(t.className()) != 0) {
                string s = t.className();
                ArrayList<AstType> tas = t.typeArgs();
                for (int i = 0; i < tas.size(); i = i + 1) s = s + "_" + mangleType(tas.get(i));
                return s;
            }
            return t.basicName();
        }
        string mangleParams(ArrayList<AstParam> ps) {
            string s = "";
            for (int i = 0; i < ps.size(); i = i + 1) {
                s = s + "_" + mangleType(ps.get(i).type());
            }
            return s;
        }
        // 默认参数补全：实参少于形参时，把缺省形参的默认值克隆进 args。
        void fillDefaultArgs(AstExpr e, ArrayList<AstParam> params) {
            ArrayList<AstExpr> as = e.args();
            int have = as.size();
            int need = params.size();
            if (have >= need) return;
            for (int i = have; i < need; i = i + 1) {
                AstParam p = params.get(i);
                if (p.defaultExpr() == null) break;
                AstExpr de = p.defaultExpr();
                as.add(de.cloneExpr());
            }
        }
        // 顶层函数形参列表（默认/命名实参归一化用；仅顶层函数，排除泛型实例）
        ArrayList<AstParam> findFuncParams(string name) {
            for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                AstFunction f = tu_.functions().get(i);
                if (f.name() == name && f.typeParams().size() == 0) return f.params();
            }
            return null;
        }
        // 形参类型 kind 列表（per-arg 类型检查用）
        ArrayList<string> paramKinds(ArrayList<AstParam> ps) {
            ArrayList<string> out = new ArrayList<string>();
            for (int i = 0; i < ps.size(); i = i + 1) {
                out.add(ps.get(i).type() != null ? typeToKind(ps.get(i).type()) : "void");
            }
            return out;
        }
        // C++ namedArgName：赋值实参 LHS 为形参名 → 返回形参名（否则空）
        string namedArgNameOf(AstExpr a, ArrayList<AstParam> params) {
            if (a == null || a.kind() != "Assign") return "";
            AstExpr tgt = a.lhs();
            if (tgt == null || tgt.kind() != "Identifier") return "";
            for (int i = 0; i < params.size(); i = i + 1) {
                if (params.get(i).name() == tgt.name()) return tgt.name();
            }
            return "";
        }
        // C++ satisfiesTraitConstraint：具体类型 AstType 是否满足约束 trait。
        int satisfiesTraitAst(AstType ct, string trait) {
            string k = ct != null ? typeToKind(ct) : "void";
            if (trait == "Numeric") return TKind.isNumeric(k) != 0 ? 1 : 0;
            if (trait == "Integer") {
                if (k == "byte" || k == "short" || k == "int" || k == "long"
                    || k == "ubyte" || k == "ushort" || k == "uint" || k == "ulong" || k == "char") return 1;
                return 0;
            }
            if (trait == "Float") return (k == "float" || k == "double") ? 1 : 0;
            if (trait == "Ordered") {
                if (k == "byte" || k == "short" || k == "int" || k == "long"
                    || k == "ubyte" || k == "ushort" || k == "uint" || k == "ulong"
                    || k == "char" || k == "float" || k == "double" || k == "string") return 1;
                return 0;
            }
            // 接口约束：类实现检查 / 接口类型本身
            if (k == "class" && ct != null && Str.len(ct.className()) != 0) {
                string cls = ct.className();
                for (int i = 0; i < tu_.classes().size(); i = i + 1) {
                    AstClass c = tu_.classes().get(i);
                    if (c.name() == cls && c.iface() == trait) return 1;
                }
                return 0;
            }
            if (k == "interface" && ct != null && ct.className() == trait) return 1;
            return 0;
        }
        // 泛型类 where 约束校验（C++ typeNodeToTypeInfo M2）。任一约束失败返回 1。
        int checkGenericClassConstraint(string cn, ArrayList<AstType> tas, int line, int col) {
            int ti2 = -1;
            for (int i = 0; i < tu_.classes().size(); i = i + 1) {
                AstClass c = tu_.classes().get(i);
                if (c.name() == cn) { ti2 = i; break; }
            }
            if (ti2 < 0) return 0;
            AstClass tpl = tu_.classes().get(ti2);
            ArrayList<AstPair> cons = tpl.constraints();
            for (int ci3 = 0; ci3 < cons.size(); ci3 = ci3 + 1) {
                string tp = cons.get(ci3).k();
                string trait = cons.get(ci3).v();
                int idx = -1;
                for (int k3 = 0; k3 < tpl.typeParams().size(); k3 = k3 + 1) {
                    if (tpl.typeParams().get(k3) == tp) { idx = k3; break; }
                }
                if (idx < 0 || idx >= tas.size()) continue;
                AstType arg = tas.get(idx);
                if (satisfiesTraitAst(arg, trait) == 0) {
                    diag_.error(line, col, "type argument '" + typeToKind(arg)
                        + "' does not satisfy constraint '" + tp + " : " + trait
                        + "' for generic class '" + cn + "'");
                    return 1;
                }
            }
            return 0;
        }
        // C++ planArgMapping：返回每个形参对应的实参索引（-1=缺省），失败返回 null。
        ArrayList<int> planCallArgs(AstExpr e, ArrayList<AstParam> params) {
            ArrayList<AstExpr> args = e.args();
            int nparam = params.size();
            ArrayList<int> plan = new ArrayList<int>();
            for (int i = 0; i < nparam; i = i + 1) plan.add(-1);
            int positional = 0;
            ArrayList<string> namedNames = new ArrayList<string>();
            ArrayList<int> namedIdx = new ArrayList<int>();
            for (int ai = 0; ai < args.size(); ai = ai + 1) {
                AstExpr a = args.get(ai);
                string nn = namedArgNameOf(a, params);
                if (a.kind() == "NamedArg") { namedNames.add(a.namedName()); namedIdx.add(ai); }
                else if (Str.len(nn) != 0) { namedNames.add(nn); namedIdx.add(ai); }
                else positional = positional + 1;
            }
            if (positional > nparam) return null;
            int pi = 0;
            for (int ai = 0; ai < args.size(); ai = ai + 1) {
                AstExpr a = args.get(ai);
                if (a.kind() == "NamedArg") continue;
                if (Str.len(namedArgNameOf(a, params)) != 0) continue;
                plan.set(pi, ai);
                pi = pi + 1;
            }
            for (int ni = 0; ni < namedNames.size(); ni = ni + 1) {
                int found = 0;
                for (int i = 0; i < nparam; i = i + 1) {
                    if (params.get(i).name() == namedNames.get(ni)) {
                        if (plan.get(i) >= 0) return null;  // 位置+命名重叠
                        plan.set(i, namedIdx.get(ni));
                        found = 1;
                        break;
                    }
                }
                if (found == 0) return null;
            }
            for (int i = 0; i < namedNames.size(); i = i + 1)
                for (int j = i + 1; j < namedNames.size(); j = j + 1)
                    if (namedNames.get(i) == namedNames.get(j)) return null;
            for (int i = 0; i < nparam; i = i + 1)
                if (plan.get(i) < 0 && params.get(i).defaultExpr() == null) return null;  // 必填缺失
            return plan;
        }
        // 规范化调用实参（镜像 C++ normalizeArgsToParamDecls）：命名赋值实参 →
        // NamedArg、重排到形参序、缺省默认补全。成功改写 e.args() 返回 1；
        // 失败按 C++ 发诊断并置 argsVisited（实参不再访问），返回 0。
        int normalizeCallArgs(AstExpr e, ArrayList<AstParam> params) {
            ArrayList<AstExpr> args = e.args();
            int nparam = params.size();
            if (nparam == 0) {
                if (args.size() != 0) {
                    diag_.error(e.line(), e.col(), "call takes no arguments, but " + args.size() + " given");
                    for (int ai = 0; ai < args.size(); ai = ai + 1) markAllExpr(args.get(ai));
                    e.setArgsVisited(1);
                    return 0;
                }
                return 1;
            }
            // 命名赋值实参 → NamedArg
            for (int ai = 0; ai < args.size(); ai = ai + 1) {
                AstExpr a = args.get(ai);
                string nn = namedArgNameOf(a, params);
                if (Str.len(nn) != 0 && a.kind() == "Assign") {
                    AstExpr na = new AstExpr();
                    na.setKind("NamedArg");
                    na.setPos(a.line(), a.col());
                    na.setNamedName(nn);
                    na.setNamedValue(a.rhs());
                    args.set(ai, na);
                }
            }
            int positional = 0;
            ArrayList<string> namedNames = new ArrayList<string>();
            for (int ai = 0; ai < args.size(); ai = ai + 1) {
                AstExpr a = args.get(ai);
                if (a.kind() == "NamedArg") namedNames.add(a.namedName());
                else positional = positional + 1;
            }
            // 重复命名实参（C++ fits 拒绝，无额外诊断）
            for (int i = 0; i < namedNames.size(); i = i + 1)
                for (int j = i + 1; j < namedNames.size(); j = j + 1)
                    if (namedNames.get(i) == namedNames.get(j)) {
                        for (int ai = 0; ai < args.size(); ai = ai + 1) markAllExpr(args.get(ai));
                        e.setArgsVisited(1);
                        return 0;
                    }
            if (positional > nparam) {
                diag_.error(e.line(), e.col(), "too many arguments: expected at most " + nparam + ", got " + args.size());
                for (int ai = 0; ai < args.size(); ai = ai + 1) markAllExpr(args.get(ai));
                e.setArgsVisited(1);
                return 0;
            }
            int anyNamed = namedNames.size() != 0 ? 1 : 0;
            if (anyNamed != 0) {
                for (int ni = 0; ni < namedNames.size(); ni = ni + 1) {
                    int found = 0;
                    for (int pi = 0; pi < nparam; pi = pi + 1)
                        if (params.get(pi).name() == namedNames.get(ni)) { found = 1; break; }
                    if (found == 0) {
                        diag_.error(e.line(), e.col(), "unknown named argument '" + namedNames.get(ni) + "'");
                        for (int ai = 0; ai < args.size(); ai = ai + 1) markAllExpr(args.get(ai));
                        e.setArgsVisited(1);
                        return 0;
                    }
                }
                for (int pi = 0; pi < positional && pi < nparam; pi = pi + 1) {
                    for (int ni = 0; ni < namedNames.size(); ni = ni + 1) {
                        if (namedNames.get(ni) == params.get(pi).name()) {
                            diag_.error(e.line(), e.col(), "parameter '" + params.get(pi).name() + "' given both by position and by name");
                            for (int ai = 0; ai < args.size(); ai = ai + 1) markAllExpr(args.get(ai));
                            e.setArgsVisited(1);
                            return 0;
                        }
                    }
                }
            }
            ArrayList<int> provided = new ArrayList<int>();
            for (int pi = 0; pi < nparam; pi = pi + 1) provided.add(0);
            for (int pi = 0; pi < positional && pi < nparam; pi = pi + 1) provided.set(pi, 1);
            for (int ni = 0; ni < namedNames.size(); ni = ni + 1)
                for (int pi = 0; pi < nparam; pi = pi + 1)
                    if (params.get(pi).name() == namedNames.get(ni)) provided.set(pi, 1);
            ArrayList<string> missing = new ArrayList<string>();
            for (int pi = 0; pi < nparam; pi = pi + 1)
                if (provided.get(pi) == 0 && params.get(pi).defaultExpr() == null) missing.add(params.get(pi).name());
            if (missing.size() != 0) {
                string msg = "missing required argument(s)";
                for (int mi = 0; mi < missing.size(); mi = mi + 1) msg = msg + " '" + missing.get(mi) + "'";
                msg = msg + " — expected " + nparam + " arguments, got " + positional;
                if (anyNamed != 0) msg = msg + " + " + namedNames.size() + " named";
                diag_.error(e.line(), e.col(), msg);
                for (int ai = 0; ai < args.size(); ai = ai + 1) markAllExpr(args.get(ai));
                e.setArgsVisited(1);
                return 0;
            }
            // 成功：位置实参 + 命名实参按形参序重排 + 缺省补全
            ArrayList<AstExpr> posArgs = new ArrayList<AstExpr>();
            ArrayList<string> namedN = new ArrayList<string>();
            ArrayList<AstExpr> namedV = new ArrayList<AstExpr>();
            for (int ai = 0; ai < args.size(); ai = ai + 1) {
                AstExpr a = args.get(ai);
                if (a.kind() == "NamedArg") { namedN.add(a.namedName()); namedV.add(a.namedValue()); }
                else posArgs.add(a);
            }
            ArrayList<int> nameToIdx = new ArrayList<int>();
            for (int pi = 0; pi < nparam; pi = pi + 1) {
                int idx = -1;
                for (int nj = 0; nj < namedN.size(); nj = nj + 1)
                    if (namedN.get(nj) == params.get(pi).name()) { idx = nj; break; }
                nameToIdx.add(idx);
            }
            ArrayList<int> provided2 = new ArrayList<int>();
            ArrayList<int> argOfParam = new ArrayList<int>();
            for (int pi = 0; pi < nparam; pi = pi + 1) { provided2.add(0); argOfParam.add(-1); }
            for (int i = 0; i < posArgs.size(); i = i + 1) { provided2.set(i, 1); argOfParam.set(i, i); }
            for (int pi = 0; pi < nparam; pi = pi + 1) {
                if (nameToIdx.get(pi) >= 0) { provided2.set(pi, 1); argOfParam.set(pi, posArgs.size() + nameToIdx.get(pi)); }
            }
            ArrayList<AstExpr> out = new ArrayList<AstExpr>();
            for (int pi = 0; pi < nparam; pi = pi + 1) {
                if (provided2.get(pi) != 0) {
                    int src = argOfParam.get(pi);
                    if (src < posArgs.size()) out.add(posArgs.get(src));
                    else out.add(namedV.get(src - posArgs.size()));
                } else {
                    AstParam p = params.get(pi);
                    if (p.defaultExpr() == null) {
                        diag_.error(e.line(), e.col(), "cannot use default value for parameter '" + p.name() + "' (non-constant expression)");
                        for (int ai = 0; ai < args.size(); ai = ai + 1) markAllExpr(args.get(ai));
                        e.setArgsVisited(1);
                        return 0;
                    }
                    out.add(p.defaultExpr().cloneExpr());
                }
            }
            e.setArgs(out);
            return 1;
        }
        // 递归声明解构目标叶子变量。
        void declareDestructureTarget(AstDestructureTarget t) {
            if (t == null) return;
            if (t.elements().size() != 0) {
                for (int i = 0; i < t.elements().size(); i = i + 1) declareDestructureTarget(t.elements().get(i));
            } else {
                if (Str.len(t.name()) != 0) sym_.declare(t.name(), typeToKind(t.type()));
            }
        }
        // ---- F4-L lambda 捕获分析（对齐 C++ collectLambdaLocals/Captures）----
        int listHas(ArrayList<string> ls, string s) {
            for (int i = 0; i < ls.size(); i = i + 1) {
                if (ls.get(i) == s) return 1;
            }
            return 0;
        }
        // 符号条目 → AstType（cap 属性 / 捕获拷贝局部变量的类型）
        AstType entryToAstType(SymbolEntry en) {
            AstType t = new AstType();
            if (en == null) { t.setBasicName("int"); return t; }
            if (Str.len(en.elementType()) != 0 || Str.len(en.elementClass()) != 0) {
                AstType el = new AstType();
                if (Str.len(en.elementClass()) != 0) el.setClassName(en.elementClass());
                else el.setBasicName(en.elementType());
                t.setElement(el);
                    if (en.arraySize() > 0) t.setArraySize(en.arraySize());
                return t;
            }
            if (Str.len(en.className()) != 0) { t.setClassName(en.className()); return t; }
            // F4-L：函数类型符号（(int)->int）——funcRet_ 有值则重建完整函数类型
            // （捕获槽 / 捕获拷贝 Var 需 dump 出完整类型，而不是裸 "function"）。
            if (en.type() == "function" && Str.len(en.funcRet()) != 0) {
                AstType ret = new AstType();
                ret.setBasicName(en.funcRet());
                t.setFuncReturn(ret);
                for (int i = 0; i < en.funcParamTypes().size(); i = i + 1) {
                    AstType pt = new AstType();
                    pt.setBasicName(en.funcParamTypes().get(i));
                    t.funcParamTypes().add(pt);
                }
                return t;
            }
            t.setBasicName(en.type());
            return t;
        }
        // 语句局部变量名（VarDecl 的变量名；不进入嵌套 lambda）
        void collectStmtLocals(AstStmt st, ArrayList<string> locals) {
            if (st == null) return;
            string k = st.kind();
            if (k == "Block") {
                for (int i = 0; i < st.bodyStmts().size(); i = i + 1) collectStmtLocals(st.bodyStmts().get(i), locals);
            } else if (k == "VarDecl") {
                for (int i = 0; i < st.decls().size(); i = i + 1) {
                    string nm = st.decls().get(i).name();
                    if (Str.len(nm) != 0 && listHas(locals, nm) == 0) locals.add(nm);
                }
            } else if (k == "If") {
                collectStmtLocals(st.then(), locals);
                collectStmtLocals(st.elseBranch(), locals);
            } else if (k == "While") {
                collectStmtLocals(st.body(), locals);
            } else if (k == "For") {
                collectStmtLocals(st.init(), locals);
                collectStmtLocals(st.body(), locals);
            } else if (k == "ForIn") {
                collectStmtLocals(st.body(), locals);
            }
        }
        // 表达式遍历：收集 Identifier（用于捕获）
        void collectExprCaptures(AstExpr e, ArrayList<string> params, ArrayList<string> locals, ArrayList<string> out) {
            if (e == null) return;
            string k = e.kind();
            if (k == "Identifier") {
                string nm = e.name();
                if (listHas(params, nm) != 0) return;
                if (listHas(locals, nm) != 0) return;
                // 引用外层符号（符号表里有）→ 捕获（去重，按首次出现顺序）
                if (Str.len(sym_.lookup(nm)) != 0 && listHas(out, nm) == 0) out.add(nm);
                return;
            }
            // C++ collectExprCaptures 对嵌套 Lambda 递归：用外层 locals/params
            // 扫描内层 body，把内层引用的外层符号也捕获到外层（base 这类）。
            // 内层参数（如 y）此时未进符号表 → sym_.lookup 为空，不会被误捕获。
            if (k == "Lambda") {
                if (e.bodyStmt() != null) collectStmtCaptures(e.bodyStmt(), params, locals, out);
                return;
            }
            if (k == "Binary") { collectExprCaptures(e.lhs(), params, locals, out); collectExprCaptures(e.rhs(), params, locals, out); }
            else if (k == "Unary") { collectExprCaptures(e.operand(), params, locals, out); }
            else if (k == "Convert") { collectExprCaptures(e.operand(), params, locals, out); }
            else if (k == "Assign") { collectExprCaptures(e.lhs(), params, locals, out); collectExprCaptures(e.rhs(), params, locals, out); }
            else if (k == "Ternary") { collectExprCaptures(e.condition(), params, locals, out); collectExprCaptures(e.trueExpr(), params, locals, out); collectExprCaptures(e.falseExpr(), params, locals, out); }
            else if (k == "Member") { collectExprCaptures(e.array(), params, locals, out); }
            else if (k == "Subscript") { collectExprCaptures(e.array(), params, locals, out); collectExprCaptures(e.index(), params, locals, out); }
            else if (k == "Call") {
                collectExprCaptures(e.callee(), params, locals, out);
                for (int i = 0; i < e.args().size(); i = i + 1) collectExprCaptures(e.args().get(i), params, locals, out);
            } else if (k == "New") {
                for (int i = 0; i < e.args().size(); i = i + 1) collectExprCaptures(e.args().get(i), params, locals, out);
            } else if (k == "NewArray") {
                for (int i = 0; i < e.dimensions().size(); i = i + 1) collectExprCaptures(e.dimensions().get(i), params, locals, out);
            } else if (k == "Tuple") {
                for (int i = 0; i < e.elements().size(); i = i + 1) collectExprCaptures(e.elements().get(i), params, locals, out);
            } else if (k == "Await") { collectExprCaptures(e.operand(), params, locals, out); }
            else if (k == "NamedArg") { collectExprCaptures(e.namedValue(), params, locals, out); }
        }
        // 语句遍历：收集捕获（Return/ExprStmt/VarDecl init/If/While/For/ForIn/Match）
        void collectStmtCaptures(AstStmt st, ArrayList<string> params, ArrayList<string> locals, ArrayList<string> out) {
            if (st == null) return;
            string k = st.kind();
            if (k == "Block") {
                for (int i = 0; i < st.bodyStmts().size(); i = i + 1) collectStmtCaptures(st.bodyStmts().get(i), params, locals, out);
            } else if (k == "VarDecl") {
                for (int i = 0; i < st.decls().size(); i = i + 1) collectExprCaptures(st.decls().get(i).init(), params, locals, out);
            } else if (k == "ExprStmt") {
                collectExprCaptures(st.expr(), params, locals, out);
            } else if (k == "Return") {
                collectExprCaptures(st.value(), params, locals, out);
            } else if (k == "If") {
                collectExprCaptures(st.condition(), params, locals, out);
                collectStmtCaptures(st.then(), params, locals, out);
                collectStmtCaptures(st.elseBranch(), params, locals, out);
            } else if (k == "While") {
                collectExprCaptures(st.condition(), params, locals, out);
                collectStmtCaptures(st.body(), params, locals, out);
            } else if (k == "For") {
                collectStmtCaptures(st.init(), params, locals, out);
                collectExprCaptures(st.condition(), params, locals, out);
                collectExprCaptures(st.step(), params, locals, out);
                collectStmtCaptures(st.body(), params, locals, out);
            } else if (k == "ForIn") {
                collectExprCaptures(st.iterable(), params, locals, out);
                collectStmtCaptures(st.body(), params, locals, out);
            } else if (k == "Match") {
                collectExprCaptures(st.subject(), params, locals, out);
                for (int i = 0; i < st.arms().size(); i = i + 1) {
                    if (st.arms().get(i).body() != null) collectStmtCaptures(st.arms().get(i).body(), params, locals, out);
                }
            }
        }
        // ---- M-FN-2 nonlocal：收集当前 lambda body 内的 `nonlocal name;`（不进入
        // 嵌套 lambda —— 嵌套 lambda 的 nonlocal 属于它自己）。----
        void collectExprNonlocal(AstExpr e, ArrayList<string> out) {
            if (e == null) return;
            if (e.kind() == "Lambda") return;
            string k = e.kind();
            if (k == "Binary") { collectExprNonlocal(e.lhs(), out); collectExprNonlocal(e.rhs(), out); }
            else if (k == "Unary") { collectExprNonlocal(e.operand(), out); }
            else if (k == "Assign") { collectExprNonlocal(e.lhs(), out); collectExprNonlocal(e.rhs(), out); }
            else if (k == "Member") { collectExprNonlocal(e.array(), out); }
            else if (k == "Subscript") { collectExprNonlocal(e.array(), out); collectExprNonlocal(e.index(), out); }
            else if (k == "Call") {
                collectExprNonlocal(e.callee(), out);
                for (int i = 0; i < e.args().size(); i = i + 1) collectExprNonlocal(e.args().get(i), out);
            } else if (k == "New") {
                for (int i = 0; i < e.args().size(); i = i + 1) collectExprNonlocal(e.args().get(i), out);
            } else if (k == "NewArray") {
                for (int i = 0; i < e.dimensions().size(); i = i + 1) collectExprNonlocal(e.dimensions().get(i), out);
            } else if (k == "Ternary") {
                collectExprNonlocal(e.condition(), out);
                collectExprNonlocal(e.trueExpr(), out);
                collectExprNonlocal(e.falseExpr(), out);
            } else if (k == "Tuple") {
                for (int i = 0; i < e.elements().size(); i = i + 1) collectExprNonlocal(e.elements().get(i), out);
            }
        }
        void collectStmtNonlocal(AstStmt st, ArrayList<string> out) {
            if (st == null) return;
            string k = st.kind();
            if (k == "Block") {
                for (int i = 0; i < st.bodyStmts().size(); i = i + 1) collectStmtNonlocal(st.bodyStmts().get(i), out);
            } else if (k == "Nonlocal") {
                for (int i = 0; i < st.names().size(); i = i + 1) {
                    string n = st.names().get(i);
                    if (listHas(out, n) == 0) out.add(n);
                }
            } else if (k == "VarDecl") {
                for (int i = 0; i < st.decls().size(); i = i + 1) collectExprNonlocal(st.decls().get(i).init(), out);
            } else if (k == "ExprStmt") {
                collectExprNonlocal(st.expr(), out);
            } else if (k == "Return") {
                collectExprNonlocal(st.value(), out);
            } else if (k == "If") {
                collectExprNonlocal(st.condition(), out);
                collectStmtNonlocal(st.then(), out);
                collectStmtNonlocal(st.elseBranch(), out);
            } else if (k == "While") {
                collectExprNonlocal(st.condition(), out);
                collectStmtNonlocal(st.body(), out);
            } else if (k == "For") {
                collectStmtNonlocal(st.init(), out);
                collectExprNonlocal(st.condition(), out);
                collectExprNonlocal(st.step(), out);
                collectStmtNonlocal(st.body(), out);
            } else if (k == "ForIn") {
                collectExprNonlocal(st.iterable(), out);
                collectStmtNonlocal(st.body(), out);
            } else if (k == "Match") {
                collectExprNonlocal(st.subject(), out);
                for (int i = 0; i < st.arms().size(); i = i + 1) {
                    if (st.arms().get(i).body() != null) collectStmtNonlocal(st.arms().get(i).body(), out);
                }
            }
        }
        // 查找/复用 nonlocal cell 类（按类型复用，C++ cell_class_by_type_）
        string nonlocalCellClass(AstType t) {
            string key = t != null ? t.str() : "int";
            for (int i = 0; i < cellClassByTypeKey_.size(); i = i + 1) {
                if (cellClassByTypeKey_.get(i) == key) return cellClassByTypeVal_.get(i);
            }
            string ccell = "__cell_" + cellCounter_;
            cellCounter_ = cellCounter_ + 1;
            AstClass cell = new AstClass();
            cell.setName(ccell);
            AstProp cv = new AstProp();
            cv.setName("v");
            cv.setType(t != null ? t : new AstType());
            cell.props().add(cv);
            if (tu_ != null) tu_.classes().add(cell);
            cellClassByTypeKey_.add(key);
            cellClassByTypeVal_.add(ccell);
            return ccell;
        }

