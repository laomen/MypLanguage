            addIntr("__myp_io_fclose", "void");
            addIntr("__myp_io_current_handle", "int");
            addIntr("__myp_io_select", "void");
            addIntr("__myp_io_read_line", "string");
            addIntr("__myp_io_write", "void");
            addIntr("__myp_io_write_line", "void");
            addIntr("__myp_io_has_next", "int");
            addIntr("__myp_io_read_byte", "int");
            addIntr("__myp_io_read_i32be", "int");
            addIntr("__myp_io_seek", "int");
            addIntr("__myp_io_write_byte", "int");
            addIntr("__myp_io_write_i32be", "int");
            addIntr("__myp_io_write_double", "int");
            addIntr("__myp_io_read_double", "double");
            addIntr("__myp_read_line", "string");
            addIntr("__myp_flush", "void");
            addIntr("__myp_atof", "double");
            // libmyp/freestanding 探针（档B，镜像 C++）：原始 syscall + 字符串数据指针。
            addIntr("__myp_syscall", "long");
            addIntr("__myp_str_ptr", "long");
            // raw memory 内建（自举编译器新增；runtime myp化 使能层——地址以 long
            // 传，经 inttoptr 访问。自举独有，mypc 无：MYP 运行时模块用它实现
            // 分配器/字节操作，避免改 mypc）。
            addIntr("__myp_mem_load_i32", "int");
            addIntr("__myp_mem_load_i8", "int");
            addIntr("__myp_mem_load_i64", "long");
            addIntr("__myp_mem_load_double", "double");
            addIntr("__myp_mem_load_ptr", "long");
            addIntr("__myp_mem_store_i32", "void");
            addIntr("__myp_mem_store_i8", "void");
            addIntr("__myp_mem_store_i64", "void");
            addIntr("__myp_mem_store_double", "void");
            addIntr("__myp_memcpy", "void");
            addIntr("__myp_memset", "void");
            addIntr("__myp_addr_to_str", "string");
            // 运行时↔程序生成代码边界内建（2026-08-25，release_table 全 MYP 化）：
            // __myp_rtable_addr() → 程序生成的 @__myp_release_table 基址（外部引用，
            // 链接时程序 .o 在前 → 程序表胜出）；__myp_call_ptr(addr,obj) → 间接调用
            // 该表里的 destroy stub（call void %fn(ptr %obj)）。自举独有，mypc 无
            //（runtime_myp 模块由自举编译；mypc 已用 ExternalLinkage 发射同名表）。
            addIntr("__myp_rtable_addr", "long");
            addIntr("__myp_call_ptr", "void");
            // 通用内联汇编内建（2026-08-25）：__myp_asm(asmStr, consStr, ...args)
            // → void / __myp_asm_r(asmStr, consStr, ...args) → long。asm/constraints
            // 是字符串字面量，后续实参按各自 LLVM 类型作 asm 操作数。具体汇编用途
            //（如协程 myp_ctx_switch）封装成标准库函数，不再在 codegen 写死。
            // __myp_fn_addr("name") 取函数地址（ptrtoint ptr @name to i64，协程入口帧用）。
            addIntr("__myp_asm", "void");
            addIntr("__myp_asm_r", "long");
            addIntr("__myp_fn_addr", "long");
            // 通用间接调用内建（2026-08-25，#30）：__myp_indirect_<RET>(addr, ...args)
            // → 发射 inttoptr i64 addr to ptr + `call RET %fn(<实参 LLVM 类型>)`。返回
            // 类型按后缀定（i32→int / i64→long / double→double / void），实参类型由
            // 调用点 MYP 实参推断（long 承载指针）。供运行时 dlopen+dlsym 后调用
            // CUDA/LLVM C API 等任意签名函数（GPU 迁移地基）。自举独有（同 __myp_asm）。
            addIntr("__myp_indirect_i32", "int");
            addIntr("__myp_indirect_i64", "long");
            addIntr("__myp_indirect_double", "double");
            addIntr("__myp_indirect_void", "void");
            addIntr("__myp_kbhit", "int");
            addIntr("__myp_getch", "int");
            addIntr("__myp_throw", "void");
            addIntr("__myp_assert", "void");
            addIntr("__myp_assert_msg", "void");
            addIntr("__myp_test_set_msg", "void");
            addIntr("__myp_assert_eq", "void");
            addIntr("__myp_assert_neq", "void");
            addIntr("__myp_assert_long_eq", "void");
            addIntr("__myp_assert_str_eq", "void");
            addIntr("__myp_assert_str_neq", "void");
            addIntr("__myp_test_report", "void");
            addIntr("__myp_test_fail_msg", "void");
            addIntr("__myp_test_summary", "int");
            addIntr("__myp_assert_long_neq", "void");
            addIntr("__myp_assert_float_neq", "void");
            addIntr("__myp_assert_null", "void");
            addIntr("__myp_assert_not_null", "void");
            addIntr("__myp_test_capture_start", "void");
            addIntr("__myp_test_capture_stop", "void");
            addIntr("__myp_test_capture_get", "string");
            addIntr("__myp_test_capture_contains", "int");
            addIntr("__myp_test_capture_eq", "int");
            addIntr("__myp_atomic_add_i32", "int");
            addIntr("__myp_atomic_sub_i32", "int");
            addIntr("__myp_atomic_xchg_i32", "int");
            addIntr("__myp_atomic_add_f64", "double");
            addIntr("__myp_atomic_load_i32", "int");
            addIntr("__myp_atomic_store_i32", "void");
            // raw-address 原子变体（long 地址）：分配器/ARC 的 rc 字段（obj-8）用——
            // 数组下标寻址不适用任意地址。
            addIntr("__myp_atomic_add_i32_addr", "int");
            addIntr("__myp_atomic_sub_i32_addr", "int");
            addIntr("__myp_atomic_load_i32_addr", "int");
            addIntr("__myp_atomic_store_i32_addr", "void");
            addIntr("__myp_gpu_alloc", "long");
            addIntr("__myp_gpu_free", "int");
            addIntr("__myp_gpu_copy_d2d", "int");
            addIntr("__myp_gpu_sync", "int");
            addIntr("__myp_gpu_stream_create", "long");
            addIntr("__myp_gpu_stream_sync", "int");
            addIntr("__myp_gpu_stream_destroy", "int");
            addIntr("__myp_gpu_copy_d2d_async", "int");
            addIntr("__myp_gpu_event_create", "long");
            addIntr("__myp_gpu_event_record", "int");
            addIntr("__myp_gpu_event_wait", "int");
            addIntr("__myp_gpu_event_sync", "int");
            addIntr("__myp_gpu_event_elapsed", "double");
            addIntr("__myp_gpu_event_destroy", "int");
            addIntr("__myp_gpu_copy_h2d", "int");
