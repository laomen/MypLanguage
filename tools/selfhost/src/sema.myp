// sema.myp — 语义分析（F4）：类型推断 + 符号表。
//
// 对拍基准: src/sema/sema.cpp + sema_expr.cpp（tools/selfhost/format.md §5）。
// sema 模式 = AST dump + 每个表达式行尾追加 " : <type>"。
// <type> 优先 expr.type（TypeNode → typeNodeToString），否则 resolved_kind
// （TypeKind → typeKindToString）。本实现用字符串 kind 名填充 resolvedKind_。

import collections;
import text;
import fmt;
import "./diag.myp";
import "./ast.myp";

ffi long myp_str_to_long(string s);

// ---- 作用域符号表 ----
class SymbolEntry {
    action:
        @constructor SymbolEntry(string n, string t) {
            name_ = n; type_ = t;
            elementType_ = "";
            elementClass_ = "";
            elementElem_ = "";
            className_ = "";
            tupleTypes_ = new ArrayList<string>();
            instArgs_ = new ArrayList<string>();
        }
        void addTupleType(string t) { tupleTypes_.add(t); }
        void setElementType(string v) { elementType_ = v; }
        void setElementClass(string v) { elementClass_ = v; }
        void setElementElem(string v) { elementElem_ = v; }
        void setClassName(string v) { className_ = v; }
        void addInstArg(string v) { instArgs_.add(v); }
    property:
        string name_;
        string type_;
        string elementType_;
        string elementClass_;
        string elementElem_;
        string className_;
        ArrayList<string> tupleTypes_;
        ArrayList<string> instArgs_;
}

// 类方法签名（静态查找用）。
class MethodSig {
    action:
        @constructor MethodSig(string c, string m, string r, int np, ArrayList<AstParam> ps, int cor, AstType rt) {
            cls_ = c; meth_ = m; ret_ = r; nparams_ = np; params_ = ps; coro_ = cor; retType_ = rt;
        }
    property:
        string cls_;
        string meth_;
        string ret_;
        int nparams_;
        ArrayList<AstParam> params_;
        int coro_;
        AstType retType_;
}

// 扁平符号表：enterScope 压入哨兵，leaveScope 用 remove 弹出本作用域声明与哨兵。
class SymbolTable {
    action:
        @constructor SymbolTable() {
            entries_ = new ArrayList<SymbolEntry>();
        }
        void enterScope() { entries_.add(new SymbolEntry("__scope__", "")); }
        void leaveScope() {
            while (entries_.size() > 0 && entries_.get(entries_.size() - 1).name_ != "__scope__") {
                entries_.remove(entries_.size() - 1);
            }
            if (entries_.size() > 0) entries_.remove(entries_.size() - 1);
        }
        void declare(string name, string type) {
            entries_.add(new SymbolEntry(name, type));
        }
        // 数组/切片变量：记录元素类型（供 Subscript 返回元素类型）。
        void declareElem(string name, string type, string elem) {
            SymbolEntry e = new SymbolEntry(name, type);
            e.setElementType(elem);
            entries_.add(e);
        }
        void declareElemClass(string name, string type, string elem, string elemCls) {
            SymbolEntry e = new SymbolEntry(name, type);
            e.setElementType(elem);
            e.setElementClass(elemCls);
            entries_.add(e);
        }
        // 类实例变量：记录具体类名（供 Member 方法/属性解析）。
        void declareClass(string name, string type, string cls) {
            SymbolEntry e = new SymbolEntry(name, type);
            e.setClassName(cls);
            entries_.add(e);
        }
        void declareElemClass2(string name, string type, string elem, string elemCls, string elemElem) {
            SymbolEntry e = new SymbolEntry(name, type);
            e.setElementType(elem);
            e.setElementClass(elemCls);
            e.setElementElem(elemElem);
            entries_.add(e);
        }
        // 泛型类实例：记录实例类型参数（供泛型方法返回类型替换）
        void declareClassInst(string name, string type, string cls, ArrayList<AstType> targs) {
            SymbolEntry e = new SymbolEntry(name, type);
            e.setClassName(cls);
            for (int i = 0; i < targs.size(); i = i + 1) {
                AstType ta = targs.get(i);
                if (ta != null) {
                    string tn = ta.className_;
                    if (Str.len(tn) == 0) tn = ta.basicName_;
                    if (Str.len(tn) != 0) e.addInstArg(tn);
                    else e.addInstArg("int");
                } else {
                    e.addInstArg("int");
                }
            }
            entries_.add(e);
        }
        string lookupClass(string name) {
            for (int i = entries_.size() - 1; i >= 0; i = i - 1) {
                SymbolEntry en = entries_.get(i);
                if (en.name_ == name) return en.className_;
            }
            return "";
        }
        void declareTuple(string name, string type, ArrayList<AstType> tt) {
            SymbolEntry e = new SymbolEntry(name, type);
            for (int i = 0; i < tt.size(); i = i + 1) e.addTupleType(tt.get(i) != null ? TKind.typeKindOf(tt.get(i)) : "int");
            entries_.add(e);
        }
        string lookup(string name) {
            for (int i = entries_.size() - 1; i >= 0; i = i - 1) {
                if (entries_.get(i).name_ == name) return entries_.get(i).type_;
            }
            return "";
        }
        SymbolEntry lookupEntry(string name) {
            for (int i = entries_.size() - 1; i >= 0; i = i - 1) {
                if (entries_.get(i).name_ == name) return entries_.get(i);
            }
            return null;
        }
    property:
        ArrayList<SymbolEntry> entries_;
}

// ---- 类型 kind 名（typeKindToString）----
@static class TKind {
    static:
        int isNumeric(string k) {
            if (k == "byte" || k == "short" || k == "int" || k == "long"
                || k == "ubyte" || k == "ushort" || k == "uint" || k == "ulong"
                || k == "char" || k == "float" || k == "double" || k == "float4"
                || k == "double2" || k == "int4") return 1;
            return 0;
        }
        // 数字提升（numeric_common）：double>float>ulong>long>uint>int>(u)byte/short→uint
        string numericCommon(string l, string r) {
            if (l == "double" || r == "double") return "double";
            if (l == "float" || r == "float") return "float";
            if (l == "ulong" || r == "ulong") return "ulong";
            if (l == "long" || r == "long") return "long";
            if (l == "uint" || r == "uint") return "uint";
            if (l == "int" || r == "int") return "int";
            if (l == "ubyte" || r == "ubyte" || l == "ushort" || r == "ushort") return "uint";
            return "int";
        }
        // AstType → TypeKind 字符串（typeKindToString），供符号表/返回类型用。
        string typeKindOf(AstType t) {
            if (t == null) return "int";
            if (t.element_ != null) return "array";
            if (t.className_ == "slice") return "slice";
            if (Str.len(t.className_) != 0) return "class";
            if (t.funcReturn_ != null) return "function";
            if (t.isTuple_ != 0) return "tuple";
            if (t.genericParam_ != 0) return "int";
            return t.basicName_;
        }
        // 位运算/移位提升（与 numericCommon 相似但无 float/double）
        string numericBitCommon(string l, string r) {
            if (l == "ulong" || r == "ulong") return "ulong";
            if (l == "long" || r == "long") return "long";
            if (l == "uint" || r == "uint") return "uint";
            if (l == "ubyte" || r == "ubyte" || l == "ushort" || r == "ushort") return "uint";
            return "int";
        }
}

// ---- 语义分析 ----
class Sema {
    action:
        @constructor Sema(DiagEngine diag) {
            diag_ = diag;
            sym_ = new SymbolTable();
            classNames_ = new ArrayList<string>();
            classProps_ = new ArrayList<ArrayList<AstProp>>();
            classActions_ = new ArrayList<ArrayList<AstAction>>();
            classFuncs_ = new ArrayList<ArrayList<AstFunction>>();
            funcNames_ = new ArrayList<string>();
            funcRet_ = new ArrayList<AstType>();
            funcParams_ = new ArrayList<ArrayList<AstParam>>();
            intrNames_ = new ArrayList<string>();
            intrRets_ = new ArrayList<string>();
            methods_ = new ArrayList<MethodSig>();
            coroNames_ = new ArrayList<string>();
            curGeneric_ = new ArrayList<string>();
            interfaceNames_ = new ArrayList<string>();
            interfaceMethods_ = new ArrayList<MethodSig>();
            structNames_ = new ArrayList<string>();
            structProps_ = new ArrayList<ArrayList<AstProp>>();
            classTypeParams_ = new ArrayList<ArrayList<string>>();
            opSyms_ = new ArrayList<string>();
            opParams_ = new ArrayList<ArrayList<AstParam>>();
            opRets_ = new ArrayList<AstType>();
            opFuncNames_ = new ArrayList<string>();
            eventPairs_ = new ArrayList<string>();
            instDone_ = new ArrayList<string>();
            instNames_ = new ArrayList<string>();
            instTAs_ = new ArrayList<ArrayList<AstType>>();
            gsKeys_ = new ArrayList<string>();
            gsClasses_ = new ArrayList<string>();
            gsActions_ = new ArrayList<AstAction>();
            enumNames_ = new ArrayList<string>();
            enumVariants_ = new ArrayList<ArrayList<string>>();
            threadVars_ = new ArrayList<string>();
            startupMethods_ = new ArrayList<string>();
            currentClass_ = "";
            inClass_ = 0;
            inStruct_ = 0;
            inGpuFor_ = 0;
            inMain_ = 0;
            currentRet_ = "";
            loopDepth_ = 0;
            inCoro_ = 0;
            tu_ = null;
        }
        void addMethod(string c, string m, AstType r, int np, ArrayList<AstParam> ps, int cor) {
            methods_.add(new MethodSig(c, m, r != null ? typeToKind(r) : "void", np, ps, cor, r));
        }
        // 方法返回类型的具体类名（非类返回空）
        string findMethodRetClass(string cls, string meth) {
            for (int i = 0; i < methods_.size(); i = i + 1) {
                MethodSig s = methods_.get(i);
                if (s.cls_ == cls && s.meth_ == meth) {
                    AstType rt = s.retType_;
                    if (rt != null && Str.len(rt.className_) != 0) {
                        if (rt.typeArgs().size() > 0) return instClassName(rt);
                        return rt.className_;
                    }
                    return "";
                }
            }
            return "";
        }
        // 泛型类参数列表
        ArrayList<string> findClassTypeParams(string cls) {
            for (int i = 0; i < classNames_.size(); i = i + 1) {
                if (classNames_.get(i) == cls) return classTypeParams_.get(i);
            }
            return new ArrayList<string>();
        }
        // 方法返回 AstType
        AstType findMethodRetAst(string cls, string meth) {
            for (int i = 0; i < methods_.size(); i = i + 1) {
                MethodSig s = methods_.get(i);
                if (s.cls_ == cls && s.meth_ == meth) return s.retType_;
            }
            return null;
        }
        // 泛型方法返回类型替换：T → 实例类型参数（instArgs_）
        string substRet(string base, AstType rt, SymbolEntry en) {
            if (rt == null) return "int";
            string rn = rt.className_;
            if (Str.len(rn) == 0) rn = rt.basicName_;
            int idx = -1;
            ArrayList<string> tp = findClassTypeParams(base);
            for (int i = 0; i < tp.size(); i = i + 1) {
                if (tp.get(i) == rn) { idx = i; break; }
            }
            if (idx >= 0 && en != null && idx < en.instArgs_.size()) {
                return en.instArgs_.get(idx);
            }
            return typeToKind(rt);
        }
        // 实例类名 → typeArgs（AstType 列表），供方法调用链的泛型返回替换
        ArrayList<AstType> findInstTypeArgs(string instName) {
            for (int i = 0; i < instNames_.size(); i = i + 1) {
                if (instNames_.get(i) == instName) return instTAs_.get(i);
            }
            return null;
        }
        // 泛型方法返回替换（用 AstType 列表，链式方法调用 t.m().get() 场景）
        string substRetAst(string base, AstType rt, ArrayList<AstType> targs) {
            if (rt == null) return "int";
            string rn = rt.className_;
            if (Str.len(rn) == 0) rn = rt.basicName_;
            ArrayList<string> tp = findClassTypeParams(base);
            for (int i = 0; i < tp.size(); i = i + 1) {
                if (tp.get(i) == rn && i < targs.size()) {
                    AstType ta = targs.get(i);
                    if (Str.len(ta.className_) != 0) return ta.className_;
                    return ta.basicName_;
                }
            }
            return typeToKind(rt);
        }
        // 类方法是否 @coro（调用返回协程句柄 long）
        int isMethodCoro(string cls, string meth) {
            for (int i = 0; i < methods_.size(); i = i + 1) {
                MethodSig s = methods_.get(i);
                if (s.cls_ == cls && s.meth_ == meth) return s.coro_;
            }
            return 0;
        }
        // 类方法形参列表（默认参数补全用）
        ArrayList<AstParam> findMethodParams(string cls, string meth) {
            for (int i = 0; i < methods_.size(); i = i + 1) {
                MethodSig s = methods_.get(i);
                if (s.cls_ == cls && s.meth_ == meth) return s.params_;
            }
            return null;
        }
        // 查找类方法返回类型（类名 + 方法名 + 参数个数）；未找到返回空。
        string findMethodRet(string cls, string meth, int np) {
            for (int i = 0; i < methods_.size(); i = i + 1) {
                MethodSig s = methods_.get(i);
                if (s.cls_ == cls && s.meth_ == meth && s.nparams_ == np) return s.ret_;
            }
            // 参数个数不匹配时退化为名字匹配
            for (int i = 0; i < methods_.size(); i = i + 1) {
                MethodSig s = methods_.get(i);
                if (s.cls_ == cls && s.meth_ == meth) return s.ret_;
            }
            return "";
        }
        // 类中是否存在方法（区分方法 vs 属性）
        int hasMethod(string cls, string meth) {
            for (int i = 0; i < methods_.size(); i = i + 1) {
                MethodSig s = methods_.get(i);
                if (s.cls_ == cls && s.meth_ == meth) return 1;
            }
            return 0;
        }

        void addIntr(string name, string ret) {
            intrNames_.add(name);
            intrRets_.add(ret);
        }
        string intrRet(string name) {
            for (int i = 0; i < intrNames_.size(); i = i + 1) {
                if (intrNames_.get(i) == name) return intrRets_.get(i);
            }
            return "";
        }

        void registerIntrinsics() {
            addIntr("__myp_print_int", "void");
            addIntr("__myp_print_long", "void");
            addIntr("__myp_print", "void");
            addIntr("__myp_println", "void");
            addIntr("__myp_print_float", "void");
