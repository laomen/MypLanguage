        // interfaceNames_/funcNames_ 并行维护；首次出现优先，与线性扫描一致）。
        StrHashMap<int> classIdx_;
        StrHashMap<int> structIdx_;
        StrHashMap<int> enumIdx_;
        StrHashMap<int> ifaceIdx_;
        StrHashMap<int> funcIdx_;
        StrHashMap<int> methodSigIdx_;   // "cls.meth" → 1（hasMethod O(1)）
