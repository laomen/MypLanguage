// ir_emit.myp — LLVM IR 文本发射器（G1）：类型映射 + 固定 preamble。
// 对拍基准: mypc --emit-llvm（design.md §3 D4）。G1 只做最小闭环（hello 级）。

import "./ast.myp";

@static class IrEmit {
    static:
        // AstType → LLVM IR 类型字符串。
        // 类/接口/数组/函数/元组一律 ptr；slice<T> = {ptr, i64} fat pointer。
        string llvmType(AstType t) {
            if (t == null) return "i32";
            string s = t.str();
            if (s == "int" || s == "uint") return "i32";
            if (s == "long" || s == "ulong") return "i64";
            if (s == "short" || s == "ushort") return "i16";
            if (s == "byte" || s == "ubyte" || s == "char") return "i8";
            if (s == "bool" || s == "bit") return "i1";
            if (s == "float") return "float";
            if (s == "double") return "double";
            if (s == "void") return "void";
            // §3.6 向量类型：float4 → <4 x float>、double2 → <2 x double>、int4 → <4 x i32>
            if (s == "float4") return "<4 x float>";
            if (s == "double2") return "<2 x double>";
            if (s == "int4") return "<4 x i32>";
            // bitvector<N> → iN（底层 LLVM 整数）
            if (Str.startsWith(s, "bitvector") != 0 && t.bitvectorWidth() != 0) {
                return "i" + t.bitvectorWidth();
            }
            if (t.className() == "slice") return "{ ptr, i64 }";
            if (t.funcReturn() != null) return "{ ptr, ptr }";
            if (t.isTuple() != 0) {
                // 元组 (A, B) → 匿名结构体 { A, B }
                StringBuilder sb = new StringBuilder();
                sb.append("{ ");
                for (int i = 0; i < t.funcParamTypes().size(); i = i + 1) {
                    if (i != 0) sb.append(", ");
                    sb.append(IrEmit.llvmType(t.funcParamTypes().get(i)));
                }
                sb.append(" }");
                return sb.toString();
            }
            if (t.element() != null) {
                // 定长数组 T[N] → [N x T]（结构体字段/栈变量）；不定长 T[] → ptr
                if (t.arraySize() > 0) {
                    return "[" + t.arraySize() + " x " + IrEmit.llvmType(t.element()) + "]";
                }
                return "ptr";
            }
            return "ptr";
        }

        // t 是否为函数类型 (A,B)->R（fat pointer {closure, call_fn}）。
        int isFunction(AstType t) {
            if (t == null) return 0;
            if (t.funcReturn() != null) return 1;
            return 0;
        }

        // slice<T> 的元素 LLVM 类型（t 为 slice 类型时）。
        string sliceElemType(AstType t) {
            if (t == null) return "i32";
            ArrayList<AstType> tas = t.typeArgs();
            if (tas.size() > 0) return IrEmit.llvmType(tas.get(0));
            return "i32";
        }

        // t 是否为 slice 类型。
        int isSlice(AstType t) {
            if (t == null) return 0;
            if (t.className() == "slice") return 1;
            return 0;
        }

        // sema resolvedKind → LLVM 类型（表达式 resultKind 用）。
        string kindType(string kind) {
            if (kind == "int" || kind == "uint") return "i32";
            if (kind == "long" || kind == "ulong") return "i64";
            if (kind == "short" || kind == "ushort") return "i16";
            if (kind == "byte" || kind == "ubyte" || kind == "char") return "i8";
            if (kind == "bool" || kind == "bit") return "i1";
            if (kind == "float") return "float";
            if (kind == "double") return "double";
            if (kind == "void") return "void";
            if (kind == "float4") return "<4 x float>";
            if (kind == "double2") return "<2 x double>";
            if (kind == "int4") return "<4 x i32>";
            if (kind == "string" || kind == "class" || kind == "interface"
                || kind == "array" || kind == "struct"
                || kind == "enum" || kind == "tuple") return "ptr";
            if (kind == "slice") return "{ ptr, i64 }";
            if (kind == "function") return "{ ptr, ptr }";
            return "i32";
        }

        // LLVM 类型 → 零值常量（局部变量默认初始化）。
        string zeroValue(string lt) {
            if (lt == "i1") return "false";
            if (lt == "double" || lt == "float") return "0.000000e+00";
            if (lt == "ptr") return "null";
            if (Str.startsWith(lt, "{") != 0) return "zeroinitializer";
            if (Str.startsWith(lt, "[") != 0) return "zeroinitializer";
            if (Str.startsWith(lt, "%") != 0) return "zeroinitializer";   // 命名 struct
            if (Str.startsWith(lt, "<") != 0) return "zeroinitializer";   // §3.6 向量
            return "0";
        }

        // LLVM 类型 → 对齐字节数。
        int alignOf(string lt) {
            if (Str.startsWith(lt, "[") != 0) {
                int sp = Str.indexOf(lt, " x ");
                // 去掉尾部 ']'（"[262144 x i32]" → "i32"；否则 "i32]" 不匹配
                // → 落默认 8，把 1MB i32 栈数组 alloca 成 align 8，llc 在
                // SelectionDAG Combine 段错误）。
                if (sp > 0) return IrEmit.alignOf(Str.substring(lt, sp + 3, Str.len(lt) - 1));
            }
            if (Str.startsWith(lt, "<") != 0) {
                // §3.6 向量：<4 x float> → 4、<2 x double> → 8、<4 x i32> → 4
                int sp = Str.indexOf(lt, " x ");
                if (sp > 0) return IrEmit.alignOf(Str.substring(lt, sp + 3, Str.len(lt) - 1));
            }
            if (lt == "i8" || lt == "i1") return 1;
            if (lt == "i16") return 2;
            if (lt == "i32" || lt == "float") return 4;
            return 8;
        }

        // 是否整数类型（含 i1）。
        int isIntType(string lt) {
            if (lt == "i1" || lt == "i8" || lt == "i16" || lt == "i32" || lt == "i64") return 1;
            return 0;
        }

        // 整数类型位宽。
        int intWidth(string lt) {
            if (lt == "i1") return 1;
            if (lt == "i8") return 8;
            if (lt == "i16") return 16;
            if (lt == "i32") return 32;
            if (lt == "i64") return 64;
            return 32;
        }

        // "123" → int（无 FFI 依赖的十进制解析）。
        int parseNum(string s) {
            int v = 0;
            for (int i = 0; i < Str.len(s); i = i + 1) {
                int c = __myp_ord(Str.substring(s, i, i + 1));
                if (c >= 48 && c <= 57) v = v * 10 + (c - 48);
            }
            return v;
        }

        // LLVM 类型 → 字节大小（数组元素大小用；[N x T] 递归）。
        int typeSize(string lt) {
            if (Str.startsWith(lt, "[") != 0) {
                int sp = Str.indexOf(lt, " x ");
                if (sp > 0) {
                    int n = IrEmit.parseNum(Str.substring(lt, 1, sp));
                    return n * IrEmit.typeSize(Str.substring(lt, sp + 3, Str.len(lt)));
                }
            }
            if (Str.startsWith(lt, "<") != 0) {
                // §3.6 向量：<4 x float> → 4 * sizeof(float)
                int sp = Str.indexOf(lt, " x ");
                if (sp > 0) {
                    int n = IrEmit.parseNum(Str.substring(lt, 1, sp));
                    return n * IrEmit.typeSize(Str.substring(lt, sp + 3, Str.len(lt) - 1));
                }
            }
            if (lt == "{ ptr, i64 }") return 16;
            if (lt == "{ ptr, ptr }") return 16;
            if (lt == "i1" || lt == "i8") return 1;
            if (lt == "i16") return 2;
            if (lt == "i32" || lt == "float") return 4;
            return 8;
        }

        // 固定 preamble：module 头 + 全局 + 全部 runtime/内建 declare。
        // 无类程序（G1）时 __myp_release_table / type_name_table 均为 [1 x ptr]，
        // max_type_id = 0；G3 引入类后改为动态发射。
        string preamble() {
            StringBuilder sb = new StringBuilder();
            sb.append("; ModuleID = 'myp_module'\n");
            sb.append("source_filename = \"myp_module\"\n");
            sb.append("\n");
            sb.append("%myp_jmp_buf = type { [25 x i64] }\n");
            sb.append("\n");
            sb.append("@__myp_jmpbuf = internal global %myp_jmp_buf zeroinitializer\n");
            sb.append("\n");
            sb.append("declare void @myp_print(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_println(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_print_int(i32)\n");
            sb.append("\n");
            sb.append("declare void @myp_print_long(i64)\n");
            sb.append("\n");
            sb.append("declare void @myp_print_float(double)\n");
            sb.append("\n");
            sb.append("declare void @myp_print_bool(i32)\n");
            sb.append("\n");
            sb.append("declare i64 @myp_now_ms()\n");
            sb.append("\n");
            sb.append("declare void @myp_sleep_ms(i64)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_sqrt(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_abs(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_floor(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_ceil(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_sin(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_cos(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_tan(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_asin(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_acos(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_atan(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_atan2(double, double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_sinh(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_cosh(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_tanh(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_exp(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_log(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_pow(double, double)\n");
            sb.append("\n");
            sb.append("declare double @myp_math_trunc(double)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_math_abs_int(i32)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_str_to_bytes(ptr)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_uint_to_bytes(i64, i32)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_bytes_to_str(ptr)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_str_parse_int(ptr)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_str_parse_int_opt(ptr, ptr)\n");
            sb.append("\n");
            sb.append("declare i64 @myp_str_to_long(ptr)\n");
            sb.append("\n");
            sb.append("declare i64 @myp_str_to_ulong(ptr)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_str_to_uint(ptr)\n");
            sb.append("\n");
            sb.append("declare float @myp_str_to_float(ptr)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_io_fopen(ptr, ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_io_fclose()\n");
            sb.append("\n");
            sb.append("declare ptr @myp_io_read_line()\n");
            sb.append("\n");
            sb.append("declare void @myp_io_write(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_io_write_line(ptr)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_io_has_next()\n");
            sb.append("\n");
            sb.append("declare i32 @myp_io_read_byte()\n");
            sb.append("\n");
            sb.append("declare i32 @myp_io_read_i32be()\n");
            sb.append("\n");
            sb.append("declare i32 @myp_io_seek(i32, i32)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_io_write_byte(i32)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_io_write_i32be(i32)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_io_write_double(double)\n");
            sb.append("\n");
            sb.append("declare double @myp_io_read_double()\n");
            sb.append("\n");
            sb.append("declare i32 @myp_io_current_handle()\n");
            sb.append("\n");
            sb.append("declare void @myp_io_select(i32)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_read_line()\n");
            sb.append("\n");
            sb.append("declare i32 @myp_str_eq(ptr, ptr)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_str_cmp(ptr, ptr)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_kbhit()\n");
            sb.append("\n");
            sb.append("declare i32 @myp_getch()\n");
            sb.append("\n");
            sb.append("declare void @myp_flush()\n");
            sb.append("\n");
            sb.append("declare i32 @myp_term_width()\n");
            sb.append("\n");
            sb.append("declare i32 @myp_term_height()\n");
            sb.append("\n");
            sb.append("declare i32 @myp_strlen(ptr)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_strcat(ptr, ptr)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_alloc_slice_backing(i64, i32, i32)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_chr(i32)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_to_string_i32(i32)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_to_string_i64(i64)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_to_string_u32(i32)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_to_string_u64(i64)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_to_string_double(double)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_to_string_float(float)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_to_string_bool(i32)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_ord(ptr)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_str_substring(ptr, i32, i32)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_obj_type_id(ptr)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_obj_type_name(ptr)\n");
            sb.append("\n");
            sb.append("declare double @myp_atof(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_event_register(i32, ptr, ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_event_fire(i32, ptr, ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_event_process_all()\n");
            sb.append("\n");
            sb.append("declare void @myp_event_push_scope()\n");
            sb.append("\n");
            sb.append("declare void @myp_event_pop_scope()\n");
            sb.append("\n");
            sb.append("declare ptr @myp_thread_create(ptr, ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_thread_run_loop(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_thread_stop(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_thread_destroy(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_thread_associate_instance(ptr, ptr)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_timer_create(i32, ptr, i64, i64, i64)\n");
            sb.append("\n");
            sb.append("; Function Attrs: returns_twice\n");
            sb.append("declare i32 @setjmp(ptr) #0\n");
            sb.append("\n");
            sb.append("; Function Attrs: noreturn\n");
            sb.append("declare void @__myp_longjmp(ptr, i32) #1\n");
            sb.append("\n");
            sb.append("declare void @myp_throw(ptr)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_get_error()\n");
            sb.append("\n");
            sb.append("declare ptr @myp_strdup(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_exception_push(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_exception_pop()\n");
            sb.append("\n");
            sb.append("declare ptr @myp_exception_get_jmpbuf()\n");
            sb.append("\n");
            sb.append("declare void @myp_throw_object(ptr, i32)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_exception_get_type()\n");
            sb.append("\n");
            sb.append("declare ptr @myp_exception_get_object()\n");
            sb.append("\n");
            sb.append("declare void @myp_assert(i32)\n");
            sb.append("\n");
            sb.append("declare void @myp_assert_msg(i32, ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_test_set_msg(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_assert_eq(i32, i32)\n");
            sb.append("\n");
            sb.append("declare void @myp_assert_str_eq(ptr, ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_assert_neq(i32, i32)\n");
            sb.append("\n");
            sb.append("declare void @myp_assert_long_eq(i64, i64)\n");
            sb.append("\n");
            sb.append("declare void @myp_assert_str_neq(ptr, ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_test_report(ptr, i32)\n");
            sb.append("\n");
            sb.append("declare void @myp_test_fail_msg(ptr)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_test_summary(i32)\n");
            sb.append("\n");
            sb.append("declare void @myp_assert_long_neq(i64, i64)\n");
            sb.append("\n");
            sb.append("declare void @myp_assert_float_neq(double, double, double)\n");
            sb.append("\n");
            sb.append("declare void @myp_assert_null(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_assert_not_null(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_test_capture_start()\n");
            sb.append("\n");
            sb.append("declare void @myp_test_capture_stop()\n");
            sb.append("\n");
            sb.append("declare ptr @myp_test_capture_get()\n");
            sb.append("\n");
            sb.append("declare i32 @myp_test_capture_contains(ptr)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_test_capture_eq(ptr)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_alloc(i64)\n");
            sb.append("\n");
            sb.append("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n");
            sb.append("\n");
            sb.append("declare void @myp_free(ptr)\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_create(i64)\n");
            sb.append("\n");
            sb.append("declare void @__myp_coro_set_entry(i64, i64)\n");
            sb.append("\n");
            sb.append("declare void @__myp_coro_set_entry_arg(i64, i64)\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_get_entry_arg(i64)\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_resume(i64, i64)\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_yield(i64)\n");
            sb.append("\n");
            sb.append("declare void @__myp_coro_set_result(i64)\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_result(i64)\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_is_active(i64)\n");
            sb.append("\n");
            sb.append("declare void @__myp_coro_request_cancel(i64)\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_cancel_requested()\n");
            sb.append("\n");
            sb.append("declare void @__myp_coro_cancel_clear()\n");
            sb.append("\n");
            sb.append("declare void @__myp_coro_destroy(i64)\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_current_handle()\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_count()\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_status(i64)\n");
            sb.append("\n");
            sb.append("declare void @__myp_coro_scheduler()\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_wait_event(i64, i64)\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_wait_event_timeout(i64, i64, i64)\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_wait_any(ptr, i64, i64, i64)\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_wait_any_of(ptr, i64, i64, i64)\n");
            sb.append("\n");
            sb.append("declare i64 @__myp_coro_sleep(i64)\n");
            sb.append("\n");
