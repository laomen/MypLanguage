            sb.append("\n");
            sb.append("declare void @__myp_coro_frame_set(i64, i64)\n");
            sb.append("\n");
            sb.append("declare void @__myp_coro_frame_clear(i64)\n");
            sb.append("\n");
            sb.append("declare void @myp_free_all()\n");
            sb.append("\n");
            sb.append("declare ptr @myp_alloc_object(i64, i32)\n");
            sb.append("\n");
            sb.append("declare void @myp_retain(ptr)\n");
            sb.append("\n");
            sb.append("declare i32 @myp_release(ptr)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_arena_mark()\n");
            sb.append("\n");
            sb.append("declare void @myp_arena_release(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_free_object(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_weak_clear(ptr)\n");
            sb.append("\n");
            sb.append("declare void @myp_weak_store(ptr, ptr)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_weak_load(ptr)\n");
            sb.append("\n");
            sb.append("declare ptr @myp_pool_ensure_global()\n");
            sb.append("\n");
            sb.append("declare void @myp_pool_parallel_for(ptr, i32, i32, i32, ptr, ptr)\n");
