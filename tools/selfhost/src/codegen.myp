// codegen.myp — 顶层/全局/函数 codegen（G1 最小闭环：hello 级）。
// 对拍基准: src/codegen/codegen.cpp（design.md §3 D4）。G1 只覆盖基本类型、
// 函数定义/调用、return；类/ARC/异常/协程/泛型/mapping 留 G2/G3。

import "./ast.myp";
import "./ir_emit.myp";

// double → LLVM %e 文本（与 mypc --emit-llvm 的 double 常量格式一致）。
ffi string myp_fmt_double_e(double v, int precision);

// try-with-finally 的控制流上下文（C++ FinallyCtx）。
class FinallyCtx {
    action:
        @constructor FinallyCtx() {
            flagSlot_ = "";
            finallyB_ = "";
            mergeB_ = "";
            outerFinallyB_ = "";
            outerFlagSlot_ = "";
            breakB_ = "";
            continueB_ = "";
            inFinally_ = 0;
        }
        void setFlagSlot(string v) { flagSlot_ = v; }
        void setFinallyB(string v) { finallyB_ = v; }
        void setMergeB(string v) { mergeB_ = v; }
        void setOuterFinallyB(string v) { outerFinallyB_ = v; }
        void setOuterFlagSlot(string v) { outerFlagSlot_ = v; }
        void setBreakB(string v) { breakB_ = v; }
        void setContinueB(string v) { continueB_ = v; }
        void setInFinally(int v) { inFinally_ = v; }
        string flagSlot() { return flagSlot_; }
        string finallyB() { return finallyB_; }
        string mergeB() { return mergeB_; }
        string outerFinallyB() { return outerFinallyB_; }
        string outerFlagSlot() { return outerFlagSlot_; }
        string breakB() { return breakB_; }
        string continueB() { return continueB_; }
        int inFinally() { return inFinally_; }
    property:
        string flagSlot_;
        string finallyB_;
        string mergeB_;
        string outerFinallyB_;
        string outerFlagSlot_;
        string breakB_;
        string continueB_;
        int inFinally_;
}

class CodeGen {
    action:
        @constructor CodeGen() {
            sb_ = new StringBuilder();
            tmp_ = 0;
            paramNames_ = new ArrayList<string>();
            paramTypes_ = new ArrayList<string>();
            paramAstTypes_ = new ArrayList<AstType>();
            localNames_ = new ArrayList<string>();
            localTypes_ = new ArrayList<string>();
            localAstTypes_ = new ArrayList<AstType>();
            localAllocas_ = new ArrayList<string>();
            localElemTypes_ = new ArrayList<string>();
            localIsSlice_ = new ArrayList<int>();
            isMainFunc_ = 0;
            curBlock_ = "entry";
            blockCounter_ = 0;
            terminated_ = 0;
            loopBreak_ = new ArrayList<string>();
            loopContinue_ = new ArrayList<string>();
            stringGlobals_ = new StringBuilder();
            strCounter_ = 0;
            cellOwnerNames_ = new ArrayList<string>();
            cellOwnerVals_ = new ArrayList<string>();
            curTypeParams_ = new ArrayList<string>();
            curTypeArgs_ = new ArrayList<AstType>();
            pendingTemps_ = new ArrayList<string>();
            arcSlotNames_ = new ArrayList<string>();
            sliceSlotNames_ = new ArrayList<string>();
            localIsArc_ = new ArrayList<int>();
            finallyStack_ = new ArrayList<FinallyCtx>();
            finallyRetSlot_ = "";
            tryArcBases_ = new ArrayList<int>();
            threadHandles_ = new ArrayList<string>();
            testMode_ = 0;
            curFnCoro_ = 0;
        }

        void setTestMode(int v) { testMode_ = v; }

        string newTmp() {
            string t = "%t" + tmp_;
            tmp_ = tmp_ + 1;
            return t;
        }

        // 新基本块名（hint.0 / hint.1 ...）。
        string newBlock(string hint) {
            string b = hint + "." + blockCounter_;
            blockCounter_ = blockCounter_ + 1;
            return b;
        }

        // 开始新基本块。
        void openBlock(string b) {
            sb_.append(b + ":\n");
            curBlock_ = b;
            terminated_ = 0;
        }

        // 无条件跳转（结束当前 block）。
        void emitBr(string target) {
            sb_.append("  br label %" + target + "\n");
            terminated_ = 1;
        }

        // 条件值转 i1（非 i1 用 icmp ne 0 转换，同 C++）。
        string toI1(string v, string vt) {
            if (vt == "i1") return v;
            string t = newTmp();
            if (vt == "double" || vt == "float") {
                sb_.append("  " + t + " = fcmp une " + vt + " " + v + ", 0.000000e+00\n");
            } else {
                sb_.append("  " + t + " = icmp ne " + vt + " " + v + ", 0\n");
            }
            return t;
        }

        // ---- 泛型实例体内的类型参数替换（C++ current_type_params_）----
        // 泛型类模板的 body 由所有实例共享，其局部变量类型仍是 T 占位 →
        // 发射前把 T 解析为具体类型（typeParams/instTypeArgs 平行）。
        AstType resolveType(AstType t) {
            if (t == null) return null;
            for (int i = 0; i < curTypeParams_.size(); i = i + 1) {
                if (i >= curTypeArgs_.size()) break;
                string tp = curTypeParams_.get(i);
                if (t.genericParam() != 0) return curTypeArgs_.get(i);
                if (Str.len(tp) != 0 && (t.className() == tp || t.basicName() == tp)) {
                    return curTypeArgs_.get(i);
                }
            }
            if (t.element() != null) {
                AstType sub = resolveType(t.element());
                if (sub != t.element()) {
                    AstType r = new AstType();
                    r.setClassName(t.className());
                    r.setBasicName(t.basicName());
                    r.setElement(sub);
                    r.setArraySize(t.arraySize());
                    for (int i = 0; i < t.typeArgs().size(); i = i + 1) r.typeArgs().add(t.typeArgs().get(i));
                    return r;
                }
            }
            if (t.typeArgs().size() > 0) {
                int changed = 0;
                AstType r = new AstType();
                r.setClassName(t.className());
                r.setBasicName(t.basicName());
                for (int i = 0; i < t.typeArgs().size(); i = i + 1) {
                    AstType sub = resolveType(t.typeArgs().get(i));
                    r.typeArgs().add(sub);
                    if (sub != t.typeArgs().get(i)) changed = 1;
                }
                if (changed != 0) return r;
            }
            // 函数类型 (T)->R / 元组：递归替换参数/返回（同 sema substituteType）
            if (t.funcReturn() != null || t.isTuple() != 0) {
                int changed = 0;
                AstType r = new AstType();
                r.setIsTuple(t.isTuple());
                if (t.funcReturn() != null) {
                    AstType fr = resolveType(t.funcReturn());
                    r.setFuncReturn(fr);
                    if (fr != t.funcReturn()) changed = 1;
                }
                for (int i = 0; i < t.funcParamTypes().size(); i = i + 1) {
                    AstType sub = resolveType(t.funcParamTypes().get(i));
                    r.funcParamTypes().add(sub);
                    if (sub != t.funcParamTypes().get(i)) changed = 1;
                }
                if (changed != 0) return r;
                return t;
            }
            return t;
        }

        // AstType → LLVM 类型（先替换泛型类型参数）。
        string llvmType(AstType t) {
            AstType rt = resolveType(t);
            string tn = typeName(rt);
            // 接口类型 → fat pointer { data, vtable }
            if (rt != null && Str.len(tn) != 0 && isInterfaceName(tn) != 0) {
                return "{ ptr, ptr }";
            }
            // 枚举类型 → 结构体值 { i32, [N x i8] }
            if (rt != null && Str.len(tn) != 0 && isEnumName(tn) != 0) {
                return enumLlvmType(tn);
            }
            // struct 类型 → 命名结构体 %Point
            if (rt != null && Str.len(tn) != 0 && isStructName(tn) != 0) {
                return "%" + tn;
            }
            // bitfield 类型 → 打包背衬整数（i8/i16/i32/i64）
            if (rt != null && Str.len(tn) != 0 && isBitfieldName(tn) != 0) {
                return bitfieldLlvmType(tn);
            }
            return IrEmit.llvmType(rt);
        }

        // 类型名（className 优先，否则 basicName；new Flags[3] 的 elemType 只有 basicName）。
        string typeName(AstType t) {
            if (t == null) return "";
            if (Str.len(t.className()) != 0) return t.className();
            return t.basicName();
        }

        // slice<T> 元素 LLVM 类型（先替换泛型类型参数）。
        // 用 codegen 的 llvmType（struct→%Name、接口→{ptr,ptr}、枚举→{i32,[N x i8]}），
        // 而非 IrEmit.llvmType（其对 struct/接口一律 ptr，slice<Vec> 会错）。
        string sliceElemType(AstType t) {
            AstType rt = resolveType(t);
            if (rt == null) return "i32";
            ArrayList<AstType> tas = rt.typeArgs();
            if (tas.size() > 0) return llvmType(tas.get(0));
            return "i32";
        }

        // t 是否为 slice（先替换泛型类型参数）。
        int isSliceType(AstType t) {
            return IrEmit.isSlice(resolveType(t));
        }

        // LLVM 类型是否为定长数组 "[N x T]"。
        int isFixedArrayLt(string lt) {
            if (Str.startsWith(lt, "[") != 0) return 1;
            return 0;
        }

        // ---- 元组辅助 ----
        // 全数字字符串（元组字段名 "0"/"1"/...）。
        int isDigits(string s) {
            if (Str.len(s) == 0) return 0;
            for (int i = 0; i < Str.len(s); i = i + 1) {
                int c = __myp_ord(Str.substring(s, i, i + 1));
                if (c < 48 || c > 57) return 0;
            }
            return 1;
        }

        // 去掉首尾空格。
        string trimSpaces(string s) {
            int a = 0;
            int b = Str.len(s);
            while (a < b && Str.substring(s, a, a + 1) == " ") a = a + 1;
            while (b > a && Str.substring(s, b - 1, b) == " ") b = b - 1;
            return Str.substring(s, a, b);
        }

        // "{T0, T1, ...}" → 第 idx 个顶层元素类型字符串（支持嵌套 {} 与 [N x T]）。
        string structElemType(string lt, int idx) {
            string inner = Str.substring(lt, 2, Str.len(lt) - 2);
            int start = 0;
            int depth = 0;
            int cur = 0;
            for (int i = 0; i < Str.len(inner); i = i + 1) {
                string ch = Str.substring(inner, i, i + 1);
                if (ch == "{") depth = depth + 1;
                else if (ch == "}") depth = depth - 1;
                else if (ch == "," && depth == 0) {
                    if (cur == idx) return trimSpaces(Str.substring(inner, start, i));
                    start = i + 1;
                    cur = cur + 1;
                }
            }
            if (cur == idx) return trimSpaces(Str.substring(inner, start, Str.len(inner)));
            return "i32";
        }

        // 顶层函数返回 AstType（元组返回类型用）。
        AstType findFuncRetAstType(string name, int nparams) {
            if (tu_ == null) return null;
            for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                AstFunction f = tu_.functions().get(i);
                if (f.name() == name && f.params().size() == nparams) return f.ret();
            }
            return null;
        }

        // ---- ARC（计数引用）----
        // string/类实例/接口/动态数组 → LLVM ptr，均走 myp_retain/myp_release。
        // 定长数组是栈数组（非计数）；struct/slice/函数值/enum 是结构体值类型。
        int isArcType(AstType t) {
            AstType rt = resolveType(t);
            if (rt == null) return 0;
            if (rt.str() == "string") return 1;
            if (rt.element() != null) {
                if (rt.arraySize() == 0) return 1;   // T[] 动态数组（计数 backing）
                return 0;                           // T[N] 定长数组（栈）
            }
            if (rt.className() == "slice") return 0;
            // 仅类实例/接口/字符串是引用；内建标量（bool/bit/int...）className 为空 → 0。
            if (Str.len(rt.className()) != 0) {
                if (isEnumName(rt.className()) != 0) return 0;     // 枚举是值类型
                if (isStructName(rt.className()) != 0) return 0;   // struct 是值类型
                if (isBitfieldName(rt.className()) != 0) return 0; // bitfield 是值类型（整数背衬）
                return 1;   // 类实例/接口引用
            }
            return 0;
        }

        // slice 初始化是否 fresh（new slice / 返回 slice 的调用 → rc=1 转移）；
        // 否则为别名拷贝，须 retain backing（同 C++ isFreshArcExpr 的 slice 部分）。
        int isFreshSliceExpr(AstExpr e) {
            if (e == null) return 0;
            string k = e.kind();
            if (k == "New" || k == "Call" || k == "Lambda") return 1;
            if (k == "Binary" && e.opCall() != 0) return 1;   // @op 重载结果 = fresh slice
            return 0;
        }

        void addFreshTemp(string v) {
            pendingTemps_.add(v);
        }

        // v 是刚产生的 fresh 值（pending 末尾）→ 弹出（所有权转移，语句末不释放）。
        void consumeTemp(string v) {
            if (pendingTemps_.size() > 0 && pendingTemps_.get(pendingTemps_.size() - 1) == v) {
                pendingTemps_.remove(pendingTemps_.size() - 1);
            }
        }

        // v 是否为 fresh（pending 末尾匹配）。
        int isFreshTemp(string v) {
            if (pendingTemps_.size() > 0 && pendingTemps_.get(pendingTemps_.size() - 1) == v) return 1;
            return 0;
        }

        // 语句末释放所有未消费的 fresh temp。
        void flushTemps() {
            flushTempsFrom(0);
        }

        // 释放 index ≥ before 的 fresh temp（条件/分支内产生的临时值；外层
        // 表达式的 pending temp（如 new 对象）不在其列，避免误释放）。
        void flushTempsFrom(int before) {
            if (pendingTemps_.size() <= before) return;
            if (terminated_ != 0) {
                while (pendingTemps_.size() > before) pendingTemps_.remove(pendingTemps_.size() - 1);
                return;
            }
            for (int i = before; i < pendingTemps_.size(); i = i + 1) {
                sb_.append("  call i32 @myp_release(ptr " + pendingTemps_.get(i) + ")\n");
            }
            while (pendingTemps_.size() > before) pendingTemps_.remove(pendingTemps_.size() - 1);
        }

        // 向引用槽 store：释放旧值（myp_release(null) 安全）；fresh 转移 +1，
        // 否则 myp_retain。
        void storeRef(string dst, string value, int fresh) {
            string old = newTmp();
            sb_.append("  " + old + " = load ptr, ptr " + dst + "\n");
            sb_.append("  call i32 @myp_release(ptr " + old + ")\n");
            if (fresh != 0) {
                sb_.append("  store ptr " + value + ", ptr " + dst + "\n");
                consumeTemp(value);
            } else {
                sb_.append("  call void @myp_retain(ptr " + value + ")\n");
                sb_.append("  store ptr " + value + ", ptr " + dst + "\n");
            }
        }

        // 声明式 store（VarDecl 初始化）：不释放旧值——旧值要么是 entry 零初始化
        // 的 null，要么已在上一轮循环块出口释放（循环内重复声明）。若释放会
        // 双重释放（C++ 对声明用 plain store + retain 别名，释放统一由 popScope）。
        void storeNew(string dst, string value, int fresh) {
            if (fresh != 0) {
                sb_.append("  store ptr " + value + ", ptr " + dst + "\n");
                consumeTemp(value);
            } else {
                sb_.append("  call void @myp_retain(ptr " + value + ")\n");
                sb_.append("  store ptr " + value + ", ptr " + dst + "\n");
            }
        }

        // 向 slice 槽（alloca 或元素 GEP）store {ptr,i64}：fresh 转移 rc=1，
        // 否则 retain 新 backing；释放旧 backing（同 C++ arcStoreSlice）。
        void storeSliceSlot(string dst, string value, int fresh) {
            string old = newTmp();
            sb_.append("  " + old + " = load { ptr, i64 }, ptr " + dst + "\n");
            string oldData = newTmp();
            sb_.append("  " + oldData + " = extractvalue { ptr, i64 } " + old + ", 0\n");
            if (fresh == 0) {
                string newData = newTmp();
                sb_.append("  " + newData + " = extractvalue { ptr, i64 } " + value + ", 0\n");
                sb_.append("  call void @myp_retain(ptr " + newData + ")\n");
            }
            sb_.append("  call i32 @myp_release(ptr " + oldData + ")\n");
            sb_.append("  store { ptr, i64 } " + value + ", ptr " + dst + "\n");
        }

        // 具体类实例 ptr → 接口 fat pointer { data, vtable }（C++ buildInterfaceFat）。
        string buildIfaceFat(string instV, string ifaceName, string clsName) {
            string fat = newTmp() + ".fat";
            sb_.append("  " + fat + " = alloca { ptr, ptr }, align 8\n");
            string d0 = newTmp();
            sb_.append("  " + d0 + " = getelementptr { ptr, ptr }, ptr " + fat + ", i32 0, i32 0\n");
            sb_.append("  store ptr " + instV + ", ptr " + d0 + "\n");
            string d1 = newTmp();
            sb_.append("  " + d1 + " = getelementptr { ptr, ptr }, ptr " + fat + ", i32 0, i32 1\n");
            sb_.append("  store ptr @__myp_vtable_" + ifaceName + "_" + clsName + ", ptr " + d1 + "\n");
            string fv = newTmp();
            sb_.append("  " + fv + " = load { ptr, ptr }, ptr " + fat + "\n");
            return fv;
        }

        // 具体类实例 ptr → 接口 fat pointer（无法识别具体类则直通原值）。
        string upcastIface(AstExpr argE, string ifaceName, string argV) {
            string clsName = "";
            if (argE != null && argE.kind() == "New") {
                clsName = argE.className();
                if (Str.len(argE.resolvedClass()) != 0) clsName = argE.resolvedClass();
            } else if (argE != null && argE.kind() == "Identifier") {
                AstType ivt = varAstType(argE.name());
                if (ivt != null) {
                    AstType irt = resolveType(ivt);
                    if (irt != null && Str.len(irt.className()) != 0
                        && isInterfaceName(irt.className()) == 0
                        && isStructName(irt.className()) == 0
                        && isEnumName(irt.className()) == 0) {
                        clsName = classInstName(irt);
                    }
                }
            }
            if (Str.len(clsName) != 0) return buildIfaceFat(argV, ifaceName, clsName);
            return argV;
        }

        // 释放当前函数全部 ARC 局部槽（返回前/函数末尾）。
        void releaseArcSlots() {
            for (int i = 0; i < arcSlotNames_.size(); i = i + 1) {
                string old = newTmp();
                emitCoroFrameClear(arcSlotNames_.get(i));
                sb_.append("  " + old + " = load ptr, ptr " + arcSlotNames_.get(i) + "\n");
                sb_.append("  call i32 @myp_release(ptr " + old + ")\n");
            }
            releaseSliceSlots();
        }

        // 释放 [base, end) 的 ARC 槽（块作用域退出，C++ popScope）。
        void releaseArcSlotsFrom(int base) {
            for (int i = arcSlotNames_.size() - 1; i >= base; i = i - 1) {
                string old = newTmp();
                emitCoroFrameClear(arcSlotNames_.get(i));
                sb_.append("  " + old + " = load ptr, ptr " + arcSlotNames_.get(i) + "\n");
                sb_.append("  call i32 @myp_release(ptr " + old + ")\n");
            }
            while (arcSlotNames_.size() > base) arcSlotNames_.remove(arcSlotNames_.size() - 1);
        }

        // 释放单个 slice 槽（load {ptr,i64} → extract 0 → myp_release backing）。
        void releaseSliceSlot(string va) {
            emitCoroFrameClear(va);
            string fat = newTmp();
            sb_.append("  " + fat + " = load { ptr, i64 }, ptr " + va + "\n");
            string data = newTmp();
            sb_.append("  " + data + " = extractvalue { ptr, i64 } " + fat + ", 0\n");
            sb_.append("  call i32 @myp_release(ptr " + data + ")\n");
        }

        // 释放全部 slice 槽（函数末）。
        void releaseSliceSlots() {
            for (int i = 0; i < sliceSlotNames_.size(); i = i + 1) {
                releaseSliceSlot(sliceSlotNames_.get(i));
            }
        }

        // 释放 [base, end) 的 slice 槽（块作用域退出，C++ popScope）。
        void releaseSliceSlotsFrom(int base) {
            for (int i = sliceSlotNames_.size() - 1; i >= base; i = i - 1) {
                releaseSliceSlot(sliceSlotNames_.get(i));
            }
            while (sliceSlotNames_.size() > base) sliceSlotNames_.remove(sliceSlotNames_.size() - 1);
        }

        // @region 出口：myp_arena_release(mark)（释放函数内 region 临时分配）。
        void emitRegionExit() {
            if (Str.len(curRegionMark_) == 0) return;
            string m = newTmp();
            sb_.append("  " + m + " = load ptr, ptr %" + curRegionMark_ + "\n");
            sb_.append("  call void @myp_arena_release(ptr " + m + ")\n");
        }

        // 入口块 alloca（ARC 槽：跨块释放需 alloca 在 entry 块支配所有块，
        // 同 C++ createEntryBlockAlloca）。指令写进 entryAllocas_，函数体生成完
        // 后插到 entry 块参数 store 之后。零初始化：if 分支内声明的槽在未执行
        // 该分支的路径上仍会被作用域释放读取 → 必须为 null 使 myp_release 安全。
        string entryAlloca(string lt) {
            string va = newTmp();
            int al = IrEmit.alignOf(lt);
            entryAllocas_.append("  " + va + " = alloca " + lt + ", align " + al + "\n");
            if (lt == "ptr") {
                entryAllocas_.append("  store ptr null, ptr " + va + "\n");
            } else {
                entryAllocas_.append("  store " + lt + " zeroinitializer, ptr " + va + "\n");
            }
            return va;
        }

        // §五-1 收尾: 协程帧 ARC 镜像。@coro 函数体里 class/string 局部槽的
        // 存活对象镜像进运行时帧表（__myp_coro_frame_set/clear），
        // Coro.destroy / 未捕获异常时由 trampoline 统一释放（无泄漏、无
        // double-free）。同 C++ emitCoroFrameSet/emitCoroFrameClear。
        int isCoroClassLocal(AstType t) {
            AstType rt = resolveType(t);
            if (rt == null) return 0;
            if (rt.element() != null) return 0;          // 数组（动态/定长）
            if (rt.className() == "slice") return 0;
            if (Str.len(rt.className()) == 0) return 0;
            if (isEnumName(rt.className()) != 0) return 0;
            if (isStructName(rt.className()) != 0) return 0;
            if (isInterfaceName(rt.className()) != 0) return 0;
            return 1;                                    // 类实例
        }
        // 声明处镜像：class / string（同 C++ arc_decl_class || arc_decl_string）。
        int isCoroFrameTrackedDecl(AstType t) {
            AstType rt = resolveType(t);
            if (rt == null) return 0;
            if (rt.str() == "string") return 1;
            return isCoroClassLocal(rt);
        }
        void emitCoroFrameSet(string va, string objV) {
            if (curFnCoro_ == 0) return;
            string slot = newTmp();
            sb_.append("  " + slot + " = ptrtoint ptr " + va + " to i64\n");
            string oi = newTmp();
            sb_.append("  " + oi + " = ptrtoint ptr " + objV + " to i64\n");
            sb_.append("  call void @__myp_coro_frame_set(i64 " + slot + ", i64 " + oi + ")\n");
        }
        void emitCoroFrameClear(string va) {
            if (curFnCoro_ == 0) return;
            string slot = newTmp();
            sb_.append("  " + slot + " = ptrtoint ptr " + va + " to i64\n");
            sb_.append("  call void @__myp_coro_frame_clear(i64 " + slot + ")\n");
        }

        // 类型转换（整数扩展/截断 + int↔fp）。返回转换后的值名。
        string convertValue(string v, string from, string to) {
            if (from == to) return v;
            int fromInt = IrEmit.isIntType(from);
            int toInt = IrEmit.isIntType(to);
            string t = newTmp();
            if (fromInt != 0 && toInt != 0) {
                int fw = IrEmit.intWidth(from);
                int tw = IrEmit.intWidth(to);
                if (tw < fw) {
                    sb_.append("  " + t + " = trunc " + from + " " + v + " to " + to + "\n");
                } else if (from == "i1") {
                    // bool/bit → 整数：零扩展（0/1）
                    sb_.append("  " + t + " = zext " + from + " " + v + " to " + to + "\n");
                } else {
                    // 有符号扩展（MYP 整数默认有符号）
                    sb_.append("  " + t + " = sext " + from + " " + v + " to " + to + "\n");
                }
                return t;
            }
            if (fromInt != 0 && (to == "double" || to == "float")) {
                if (from == "i1") {
                    // bool→fp：先零扩展到 i32（true=1），再转 fp；
                    // sitofp i1 → -1.0 是错的。
                    string e = newTmp();
                    sb_.append("  " + e + " = zext i1 " + v + " to i32\n");
                    sb_.append("  " + t + " = sitofp i32 " + e + " to " + to + "\n");
                } else {
                    sb_.append("  " + t + " = sitofp " + from + " " + v + " to " + to + "\n");
                }
                return t;
            }
            if ((from == "double" || from == "float") && toInt != 0) {
                sb_.append("  " + t + " = fptosi " + from + " " + v + " to " + to + "\n");
                return t;
            }
            if (from == "double" && to == "float") {
                sb_.append("  " + t + " = fptrunc double " + v + " to float\n");
                return t;
            }
            if (from == "float" && to == "double") {
                sb_.append("  " + t + " = fpext float " + v + " to double\n");
                return t;
            }
            return v;
        }

        // kind 是否为无符号整型（uint/ulong/ubyte/ushort/char）。
        int isUnsignedKind(string kind) {
            return (kind == "uint" || kind == "ulong" || kind == "ubyte" || kind == "ushort" || kind == "char") ? 1 : 0;
        }

        // 类型转换（带无符号源）：un != 0 时整数扩宽用 zext，否则 sext。
        string convertValueU(string v, string from, string to, int un) {
            if (from == to) return v;
            int fromInt = IrEmit.isIntType(from);
            int toInt = IrEmit.isIntType(to);
            string t = newTmp();
            if (fromInt != 0 && toInt != 0) {
                int fw = IrEmit.intWidth(from);
                int tw = IrEmit.intWidth(to);
                if (tw < fw) {
                    sb_.append("  " + t + " = trunc " + from + " " + v + " to " + to + "\n");
                } else if (un != 0 || from == "i1") {
                    sb_.append("  " + t + " = zext " + from + " " + v + " to " + to + "\n");
                } else {
                    sb_.append("  " + t + " = sext " + from + " " + v + " to " + to + "\n");
                }
                return t;
            }
            return convertValue(v, from, to);
        }

        // 按源表达式 kind 的有符号性做整数转换（uint/ulong/ubyte/ushort/char
        // → zext；其余有符号 sext）。用于赋值/声明/返回/数组元素等存储路径。
        string convertExpr(string v, string from, string to, AstExpr src) {
            if (src != null && Str.len(src.resolvedKind()) != 0) {
                return convertValueU(v, from, to, isUnsignedKind(src.resolvedKind()));
            }
            return convertValue(v, from, to);
        }

        // @op 运算符重载函数查找：按符号 + 两实参 LLVM 类型匹配（返回函数名）。
        string findOpFuncName(string sym, string lt, string rt) {
            if (tu_ == null) return "";
            for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                AstFunction f = tu_.functions().get(i);
                if (f.op() != sym) continue;
                if (f.params().size() != 2) continue;
                string p0 = llvmType(f.params().get(0).type());
                string p1 = llvmType(f.params().get(1).type());
                if (p0 == lt && p1 == rt) return f.name();
            }
            return "";
        }

        // 标量/指针 → i64（协程入口槽/返回值/事件参数打包；同 C++ castToI64）。
        string castToI64(string v, string vt) {
            if (vt == "i64") return v;
            string t = newTmp();
            if (IrEmit.isIntType(vt) != 0) {
                sb_.append("  " + t + " = sext " + vt + " " + v + " to i64\n");
                return t;
            }
            if (vt == "double") {
                sb_.append("  " + t + " = bitcast double " + v + " to i64\n");
                return t;
            }
            if (vt == "float") {
                string e = newTmp();
                sb_.append("  " + e + " = fpext float " + v + " to double\n");
                sb_.append("  " + t + " = bitcast double " + e + " to i64\n");
                return t;
            }
            if (vt == "ptr") {
                sb_.append("  " + t + " = ptrtoint ptr " + v + " to i64\n");
                return t;
            }
            return v;
        }

        // i64 → 标量/指针（协程入口槽解包）。
        string i64ToType(string v, string to) {
            if (to == "i64") return v;
            string t = newTmp();
            if (IrEmit.isIntType(to) != 0) {
                sb_.append("  " + t + " = trunc i64 " + v + " to " + to + "\n");
                return t;
            }
            if (to == "double") {
                sb_.append("  " + t + " = bitcast i64 " + v + " to double\n");
                return t;
            }
            if (to == "float") {
                string d = newTmp();
                sb_.append("  " + d + " = bitcast i64 " + v + " to double\n");
                sb_.append("  " + t + " = fptrunc double " + d + " to float\n");
                return t;
            }
            if (to == "ptr") {
                sb_.append("  " + t + " = inttoptr i64 " + v + " to " + to + "\n");
                return t;
            }
            return v;
        }

        // 字符串拼接的标量 → 字符串转换（对齐 C++ stringifyForConcat）：
        // ptr 直通；bool→myp_to_string_bool；char→myp_chr；整数按有符号/无符号
        // 选择 i32/i64/u32/u64；float/double 各自转换。
        string stringifyConcat(string v, string vt, AstExpr src) {
            if (vt == "ptr") return v;
            if (vt == "i1") {
                string e1 = newTmp();
                sb_.append("  " + e1 + " = zext i1 " + v + " to i32\n");
                string r = newTmp();
                sb_.append("  " + r + " = call ptr @myp_to_string_bool(i32 " + e1 + ")\n");
                addFreshTemp(r);
                return r;
            }
            int isUnsigned = 0;
            int isChar = 0;
            if (src != null) {
                string rk = src.resolvedKind();
                if (rk == "ubyte" || rk == "ushort" || rk == "uint" || rk == "ulong") isUnsigned = 1;
                if (rk == "char") isChar = 1;
            }
            if (isChar != 0 && vt == "i8") {
                string e2 = newTmp();
                sb_.append("  " + e2 + " = zext i8 " + v + " to i32\n");
                string r = newTmp();
                sb_.append("  " + r + " = call ptr @myp_chr(i32 " + e2 + ")\n");
                addFreshTemp(r);
                return r;
            }
            if (IrEmit.isIntType(vt) != 0) {
                string cvt = vt;
                string cv2 = v;
                if (isUnsigned != 0) {
                    if (vt == "i8" || vt == "i16") {
                        string e3 = newTmp();
                        sb_.append("  " + e3 + " = zext " + vt + " " + v + " to i32\n");
                        cv2 = e3;
                        cvt = "i32";
                    }
                    string fn = (cvt == "i32") ? "myp_to_string_u32" : "myp_to_string_u64";
                    string r = newTmp();
                    sb_.append("  " + r + " = call ptr @" + fn + "(" + cvt + " " + cv2 + ")\n");
                    addFreshTemp(r);
                    return r;
                }
                if (vt == "i8" || vt == "i16") {
                    string e4 = newTmp();
                    sb_.append("  " + e4 + " = sext " + vt + " " + v + " to i32\n");
                    cv2 = e4;
                    cvt = "i32";
                }
                string fn2 = (cvt == "i32") ? "myp_to_string_i32" : "myp_to_string_i64";
                string r2 = newTmp();
                sb_.append("  " + r2 + " = call ptr @" + fn2 + "(" + cvt + " " + cv2 + ")\n");
                addFreshTemp(r2);
                return r2;
            }
            string fn3 = "myp_to_string_double";
            if (vt == "float") fn3 = "myp_to_string_float";
            string r3 = newTmp();
            sb_.append("  " + r3 + " = call ptr @" + fn3 + "(" + vt + " " + v + ")\n");
            addFreshTemp(r3);
            return r3;
        }

        // 顶层入口：生成完整 IR 文本。
        string generate(AstTU tu) {
            // 函数体写 sb_；字符串全局写 stringGlobals_（module 级，跨函数共享）。
            tu_ = tu;
            sb_ = new StringBuilder();
            stringGlobals_ = new StringBuilder();
            strCounter_ = 0;
            mappingInitCalls_ = new StringBuilder();
            mappingHandlers_ = new StringBuilder();
            instanceGlobals_ = new ArrayList<string>();
            curFnScope_ = 0;
            // preamble 先构建一次：FFI 声明与之去重（避免 llc "invalid redefinition"，
            // 如 stdlib/text.myp 的 `ffi int myp_strlen` 与 preamble 内建重复）。
            string pre = IrEmit.preamble();
            ArrayList<string> ffiNames = new ArrayList<string>();
            // FFI 声明 → declare <ret> @name(<params>)
            for (int i = 0; i < tu.ffis().size(); i = i + 1) {
                AstFFI ff = tu.ffis().get(i);
                int dup = 0;
                for (int di = 0; di < ffiNames.size(); di = di + 1) {
                    if (ffiNames.get(di) == ff.name()) { dup = 1; break; }
                }
                if (dup != 0) continue;
                if (Str.contains(pre, "@" + ff.name() + "(") != 0) continue;
                ffiNames.add(ff.name());
                string fret = IrEmit.llvmType(ff.ret());
                StringBuilder fps = new StringBuilder();
                for (int pi = 0; pi < ff.params().size(); pi = pi + 1) {
                    AstParam fp = ff.params().get(pi);
                    if (pi != 0) fps.append(", ");
                    fps.append(IrEmit.llvmType(fp.type()));
                }
                stringGlobals_.append("declare " + fret + " @" + ff.name() + "(" + fps.toString() + ")\n");
            }
            // 类结构体类型定义（属性布局）
            emitClassTypes();
            // @static class 全局实例（ClassName.prop 访问）
            emitStaticClassGlobals();
            // struct 类型定义（%Point = type { ... }）
            emitStructTypes();
            // 类 type_id 全局（max/type_name 表）——函数体之前（catch 分发用）
            emitTypeIdGlobals();
            // ARC：每类 destroy stub + __myp_release_table（级联释放引用字段）
            emitArcSupport();
            // 接口 vtable + __myp_error_vtables（函数体之前，catch (Error) 分发用）
            emitInterfaceVTables();
            // mapping 实例全局（__myp_inst_<src>，handler 取目标实例用）
            emitInstanceGlobals();
            // 顶层函数（按名去重：泛型实例函数可能被 sema 重复追加）
            ArrayList<string> doneFns = new ArrayList<string>();
            for (int i = 0; i < tu.functions().size(); i = i + 1) {
                AstFunction f = tu.functions().get(i);
                // 泛型函数模板跳过（只发射单态化实例，同 C++）
                if (f.typeParams().size() != 0 && f.genericInst() == 0) continue;
                // @macro 过程宏：仅编译期求值，不发射运行时函数（同 C++）
                if (f.isMacro() != 0) continue;
                // test 模式：跳过用户 main（测试运行器生成新的 main，同 C++）
                if (testMode_ != 0 && f.name() == "main") continue;
                int dup = 0;
                for (int di = 0; di < doneFns.size(); di = di + 1) {
                    if (doneFns.get(di) == f.name()) { dup = 1; break; }
                }
                if (dup != 0) continue;
                doneFns.add(f.name());
                genFunction(f);
                // @coro 顶层函数入口包装（spawn 时被引用）
                if (f.coro() != 0) genCoroFuncEntry(f);
            }
            // 预发射 lambda tramp：lambda 表达式在函数体内构建 fat pointer 时
            // 引用 @cls_tramp，须在函数体之前定义（同 C++ generateTranslationUnit）。
            ArrayList<string> doneTramp = new ArrayList<string>();
            for (int ci = 0; ci < tu.classes().size(); ci = ci + 1) {
                AstClass c = tu.classes().get(ci);
                if (c.typeParams().size() != 0 && c.isGenericInst() == 0) continue;
                int dup = 0;
                for (int di = 0; di < doneTramp.size(); di = di + 1) {
                    if (doneTramp.get(di) == c.name()) { dup = 1; break; }
                }
                if (dup != 0) continue;
                doneTramp.add(c.name());
                if (Str.startsWith(c.name(), "__lambda_") != 0) genLambdaTramp(c);
            }
            // 类方法（@static 类静态方法 + 实例方法 + function 段；泛型类模板跳过；
            // 按类名去重，避免 sema 重复追加的 _inst 克隆触发 define 重定义）
            ArrayList<string> doneCls = new ArrayList<string>();
            for (int ci = 0; ci < tu.classes().size(); ci = ci + 1) {
                AstClass c = tu.classes().get(ci);
                if (c.typeParams().size() != 0 && c.isGenericInst() == 0) continue;
                int dup = 0;
                for (int di = 0; di < doneCls.size(); di = di + 1) {
                    if (doneCls.get(di) == c.name()) { dup = 1; break; }
                }
                if (dup != 0) continue;
                doneCls.add(c.name());
                // function 段方法（实例方法，this 指针；先于 action 生成，同 C++）
                for (int fi = 0; fi < c.funcs().size(); fi = fi + 1) {
                    genClassFunction(c.name(), c.funcs().get(fi));
                }
                // 静态方法（泛型模板跳过：其实例在 tu.functions 的 __gs_ 中，同 C++）
                for (int ai = 0; ai < c.staticActions().size(); ai = ai + 1) {
                    AstAction a = c.staticActions().get(ai);
                    if (a.typeParams().size() != 0) continue;
                    genStaticAction(c.name(), a);
                }
                // trait 默认实现：类省略了带默认体的接口方法时，生成按类特化的默认函数
                //（__ifdef_<iface>_<method>_<cls>；默认体内 this.method() 解析到 <cls>_<method>）
                if (Str.len(c.iface()) != 0 && c.isGenericInst() == 0) {
                    for (int ii = 0; ii < tu_.interfaces().size(); ii = ii + 1) {
                        AstInterface ifc = tu_.interfaces().get(ii);
                        if (ifc.name() != c.iface()) continue;
                        for (int ai = 0; ai < ifc.actions().size(); ai = ai + 1) {
                            AstAction ia = ifc.actions().get(ai);
                            if (ia.body() == null) continue;
                            int has = 0;
                            for (int ci2 = 0; ci2 < c.actions().size(); ci2 = ci2 + 1) {
                                AstAction ca = c.actions().get(ci2);
                                if (ca.name() == ia.name() && ca.ret() != null && ia.ret() != null
                                    && ca.ret().str() == ia.ret().str()) { has = 1; break; }
                            }
                            if (has == 0) {
                                genInstanceActionNamed("__ifdef_" + ifc.name() + "_" + ia.name() + "_" + c.name(), c.name(), ia);
                            }
                        }
                        break;
                    }
                }
                // 实例方法（this 指针）+ 构造器
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    AstAction a = c.actions().get(ai);
                    if (a.ctor() != 0) genConstructor(c.name(), a);
                    else genInstanceAction(c.name(), a);
                }
                // 事件 fire 函数（fire_<Class>_<Event> → myp_event_fire）
                for (int ei = 0; ei < c.events().size(); ei = ei + 1) {
                    genEventFire(c.name(), c.events().get(ei));
                }
                // @coro 方法入口包装（__myp_coro_entry_Cls_m，spawn 时被引用）
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    AstAction a = c.actions().get(ai);
                    if (a.coro() != 0) genCoroEntry(c.name(), a);
                }
            }
            // struct 方法体（顶层 + 类嵌套；同 C++ generateStructMethods）。
            emitStructMethods();
            // 顶层 mapping：生成 handler 函数 + __myp_init 注册调用。
            genTopMappings();
            if (Str.len(mappingInitCalls_.toString()) != 0) {
                sb_.append("define internal void @__myp_init() {\n");
                sb_.append("body:\n");
                sb_.append(mappingInitCalls_.toString());
                sb_.append("  ret void\n");
                sb_.append("}\n\n");
            }
            // handler 函数（顶层 + 语句内 mapping）
            sb_.append(mappingHandlers_.toString());
            // test 模式：生成测试运行器 main（逐个调用 @test 函数/action，异常隔离）
            if (testMode_ != 0) genTestRunner();
            // 顺序：preamble → 类类型 + FFI + 字符串全局 → 函数 → attributes
            StringBuilder out = new StringBuilder();
            out.append(pre);
            out.append(stringGlobals_.toString());
            out.append(sb_.toString());
            out.append("attributes #0 = { returns_twice }\n");
            out.append("attributes #1 = { noreturn }\n");
            return out.toString();
        }

        // 类结构体类型：%ClassName = type { <prop types> }（空类用 i8 占位）。
        // 按名去重：sema 的泛型实例"dump 事件"会追加字节相同的克隆类（D9），
        // 重复发射 `%X = type` 会触发 llc "redefinition of type"。
        void emitClassTypes() {
            if (tu_ == null) return;
            ArrayList<string> emitted = new ArrayList<string>();
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.typeParams().size() != 0 && c.isGenericInst() == 0) continue;
                int dup = 0;
                for (int di = 0; di < emitted.size(); di = di + 1) {
                    if (emitted.get(di) == c.name()) { dup = 1; break; }
                }
                if (dup != 0) continue;
                emitted.add(c.name());
                StringBuilder ms = new StringBuilder();
                for (int pi = 0; pi < c.props().size(); pi = pi + 1) {
                    if (pi != 0) ms.append(", ");
                    ms.append(llvmType(c.props().get(pi).type()));
                }
                if (c.props().size() == 0) ms.append("i8");
                stringGlobals_.append("%" + c.name() + " = type { " + ms.toString() + " }\n");
            }
        }

        // @static class：为每个带属性的静态类发射全局结构体实例
        // `@__myp_static_<Cls> = global %<Cls> zeroinitializer`，属性访问
        // ClassName.prop → GEP 进该全局（同 C++ static_property_globals_）。
        void emitStaticClassGlobals() {
            if (tu_ == null) return;
            ArrayList<string> emitted = new ArrayList<string>();
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.isStatic() == 0) continue;
                if (c.props().size() == 0) continue;
                int dup = 0;
                for (int di = 0; di < emitted.size(); di = di + 1) {
                    if (emitted.get(di) == c.name()) { dup = 1; break; }
                }
                if (dup != 0) continue;
                emitted.add(c.name());
                stringGlobals_.append("@__myp_static_" + c.name() + " = global %" + c.name() + " zeroinitializer\n");
            }
        }

        // name 是否为 @static class（其属性是全局，ClassName.prop 访问）。
        int isStaticClassName(string name) {
            if (tu_ == null) return 0;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() == name && c.isStatic() != 0) return 1;
            }
            return 0;
        }

        // 类属性 → 索引（成员 GEP 用）。
        int propIndex(string cls, string prop) {
            if (tu_ == null) return 0;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int pi = 0; pi < c.props().size(); pi = pi + 1) {
                    if (c.props().get(pi).name() == prop) return pi;
                }
                return 0;
            }
            return 0;
        }

        // 类属性 → LLVM 类型。
        string propType(string cls, string prop) {
            if (tu_ == null) return "i32";
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int pi = 0; pi < c.props().size(); pi = pi + 1) {
                    if (c.props().get(pi).name() == prop) {
                        return llvmType(c.props().get(pi).type());
                    }
                }
                return "i32";
            }
            return "i32";
        }

        // 类实例大小：按 LLVM 结构体布局（字段对齐 + padding）计算。
        // 与 myp_alloc_object(size) 对齐（C++ getTypeAllocSize）。
        int classSize(string cls) {
            if (tu_ == null) return 1;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                int offset = 0;
                int maxAlign = 1;
                for (int pi = 0; pi < c.props().size(); pi = pi + 1) {
                    string lt = llvmType(c.props().get(pi).type());
                    int al = IrEmit.alignOf(lt);
                    int sz = IrEmit.typeSize(lt);
                    if (al > maxAlign) maxAlign = al;
                    int rem = offset % al;
                    if (rem != 0) offset = offset + (al - rem);
                    offset = offset + sz;
                }
                int rem2 = offset % maxAlign;
                if (rem2 != 0) offset = offset + (maxAlign - rem2);
                if (offset == 0) offset = 1;
                return offset;
            }
            return 1;
        }

        // Member 表达式的字段地址（obj.field / this.field → GEP）。
        string memberAddr(AstExpr m) {
            AstExpr obj = m.array();
            // struct 成员：obj 是 struct 局部（alloca 指针）→ 直接 GEP alloca
            if (obj != null && obj.kind() == "Identifier") {
                AstType oat = varAstType(obj.name());
                if (oat != null && Str.len(oat.className()) != 0 && isStructName(oat.className()) != 0) {
                    string stName = oat.className();
                    string base = varAlloca(obj.name());
                    int idx = structFieldIndex(stName, m.memberName());
                    string gep = newTmp();
                    sb_.append("  " + gep + " = getelementptr %" + stName + ", ptr " + base + ", i32 0, i32 " + idx + "\n");
                    return gep;
                }
            }
            // @static class：ClassName.prop → GEP 进全局实例（@__myp_static_<Cls>）
            if (obj != null && obj.kind() == "Identifier" && isStaticClassName(obj.name()) != 0) {
                string cls = obj.name();
                int idx = propIndex(cls, m.memberName());
                string gep = newTmp();
                sb_.append("  " + gep + " = getelementptr %" + cls + ", ptr @__myp_static_" + cls + ", i32 0, i32 " + idx + "\n");
                return gep;
            }
            // struct 元素成员：v[i].field（v 是 slice/数组，元素是 struct 值）
            if (obj != null && obj.kind() == "Subscript") {
                AstExpr sarr = obj.array();
                string elemT = subscriptElemLt(sarr);
                if (Str.startsWith(elemT, "%") != 0) {
                    string stName = Str.substring(elemT, 1, Str.len(elemT));
                    string elemAddr = subscriptElemAddr(sarr, obj.index());
                    int idx = structFieldIndex(stName, m.memberName());
                    string gep = newTmp();
                    sb_.append("  " + gep + " = getelementptr " + elemT + ", ptr " + elemAddr + ", i32 0, i32 " + idx + "\n");
                    return gep;
                }
            }
            // 链式 struct 字段：a.b.c / o.inner.x —— 内层 Member 是 struct 字段
            if (obj != null && obj.kind() == "Member") {
                string innerT = memberFieldType(obj);
                if (Str.startsWith(innerT, "%") != 0) {
                    string stName = Str.substring(innerT, 1, Str.len(innerT));
                    string innerAddr = memberAddr(obj);
                    int idx = structFieldIndex(stName, m.memberName());
                    string gep = newTmp();
                    sb_.append("  " + gep + " = getelementptr " + innerT + ", ptr " + innerAddr + ", i32 0, i32 " + idx + "\n");
                    return gep;
                }
            }
            // struct 返回调用结果的字段访问：cfg.getPoint().name —— 存临时 alloca 再 GEP
            if (obj != null && obj.kind() == "Call") {
                string sname2 = callRetStructName(obj);
                if (Str.len(sname2) != 0) {
                    string callV = genExpr(obj);
                    string tmp = newTmp();
                    sb_.append("  " + tmp + " = alloca %" + sname2 + ", align 8\n");
                    sb_.append("  store %" + sname2 + " " + callV + ", ptr " + tmp + "\n");
                    int idx = structFieldIndex(sname2, m.memberName());
                    string gep = newTmp();
                    sb_.append("  " + gep + " = getelementptr %" + sname2 + ", ptr " + tmp + ", i32 0, i32 " + idx + "\n");
                    return gep;
                }
            }
            string objV = genExpr(obj);
            string cls = m.resolvedClass();
            if (Str.len(cls) == 0) cls = "Object";
            string field = m.memberName();
            int idx = propIndex(cls, field);
            string gep = newTmp();
            sb_.append("  " + gep + " = getelementptr %" + cls + ", ptr " + objV + ", i32 0, i32 " + idx + "\n");
            return gep;
        }

        // Member 表达式的字段 LLVM 类型。
        string memberFieldType(AstExpr m) {
            AstExpr obj = m.array();
            if (obj != null && obj.kind() == "Identifier") {
                AstType oat = varAstType(obj.name());
                if (oat != null && Str.len(oat.className()) != 0 && isStructName(oat.className()) != 0) {
                    return structFieldType(oat.className(), m.memberName());
                }
            }
            // @static class：ClassName.prop → 类属性类型
            if (obj != null && obj.kind() == "Identifier" && isStaticClassName(obj.name()) != 0) {
                return propType(obj.name(), m.memberName());
            }
            // struct 元素成员：v[i].field → struct 字段类型
            if (obj != null && obj.kind() == "Subscript") {
                AstExpr sarr = obj.array();
                string elemT = subscriptElemLt(sarr);
                if (Str.startsWith(elemT, "%") != 0) {
                    string stName = Str.substring(elemT, 1, Str.len(elemT));
                    return structFieldType(stName, m.memberName());
                }
            }
            // 链式 struct 字段：a.b.c → 内层字段类型
            if (obj != null && obj.kind() == "Member") {
                string innerT = memberFieldType(obj);
                if (Str.startsWith(innerT, "%") != 0) {
                    string stName = Str.substring(innerT, 1, Str.len(innerT));
                    return structFieldType(stName, m.memberName());
                }
            }
            // struct 返回调用结果字段：cfg.getPoint().name
            if (obj != null && obj.kind() == "Call") {
                string sname2 = callRetStructName(obj);
                if (Str.len(sname2) != 0) {
                    return structFieldType(sname2, m.memberName());
                }
            }
            string cls = m.resolvedClass();
            if (Str.len(cls) == 0) cls = "Object";
            return propType(cls, m.memberName());
        }

        // Member 表达式的字段 AstType（struct 字段 / 链式 / 元素 / 调用结果；null=无）。
        AstType memberFieldAstType(AstExpr m) {
            AstExpr obj = m.array();
            if (obj == null) return null;
            string mname = m.memberName();
            if (obj.kind() == "Identifier") {
                AstType oat = varAstType(obj.name());
                if (oat != null) {
                    AstType rt = resolveType(oat);
                    if (rt != null && Str.len(rt.className()) != 0 && isStructName(rt.className()) != 0) {
                        return structFieldAstType(rt.className(), mname);
                    }
                }
            } else if (obj.kind() == "Member") {
                AstType inner = memberFieldAstType(obj);
                if (inner != null) {
                    AstType rt = resolveType(inner);
                    if (rt != null && Str.len(rt.className()) != 0 && isStructName(rt.className()) != 0) {
                        return structFieldAstType(rt.className(), mname);
                    }
                }
            } else if (obj.kind() == "Subscript") {
                AstExpr sarr = obj.array();
                string elemT = subscriptElemLt(sarr);
                if (Str.startsWith(elemT, "%") != 0) {
                    string stName = Str.substring(elemT, 1, Str.len(elemT));
                    return structFieldAstType(stName, mname);
                }
            } else if (obj.kind() == "Call") {
                string sname2 = callRetStructName(obj);
                if (Str.len(sname2) != 0) return structFieldAstType(sname2, mname);
            }
            return null;
        }

        // 类 cls 属性 name 的数组/slice 元素 LLVM 类型（非数组返回 ""）。
        string propElemLt(string cls, string name) {
            if (tu_ == null) return "";
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int pi = 0; pi < c.props().size(); pi = pi + 1) {
                    AstProp p = c.props().get(pi);
                    if (p.name() != name) continue;
                    AstType pt = p.type();
                    if (pt == null) return "";
                    if (pt.element() != null) return llvmType(pt.element());
                    if (pt.className() == "slice") return sliceElemType(pt);
                    return "";
                }
                return "";
            }
            return "";
        }

        // 类 cls 属性 name 是否为 slice 类型。
        int propIsSlice(string cls, string name) {
            if (tu_ == null) return 0;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int pi = 0; pi < c.props().size(); pi = pi + 1) {
                    AstProp p = c.props().get(pi);
                    if (p.name() != name) continue;
                    AstType pt = p.type();
                    if (pt != null && pt.className() == "slice") return 1;
                    return 0;
                }
                return 0;
            }
            return 0;
        }

        // Subscript 数组表达式 → 元素 LLVM 类型（Identifier 局部/属性；默认 i32）。
        string subscriptElemLt(AstExpr arr) {
            if (arr == null) return "i32";
            if (arr.kind() == "Identifier") {
                if (hasVar(arr.name()) != 0) return varElemType(arr.name());
                if (hasMember(arr.name()) != 0) {
                    string et = propElemLt(curClass_, arr.name());
                    if (Str.len(et) != 0) return et;
                }
            } else if (arr.kind() == "Member") {
                string cls = arr.resolvedClass();
                // @static class 属性下标：Shared.counter[0] → 类名从对象标识符取
                AstExpr sobj = arr.array();
                if (sobj != null && sobj.kind() == "Identifier" && isStaticClassName(sobj.name()) != 0) {
                    cls = sobj.name();
                }
                if (Str.len(cls) == 0) cls = "Object";
                string et = propElemLt(cls, arr.memberName());
                if (Str.len(et) != 0) return et;
            }
            return "i32";
        }

        // Subscript 数组表达式 → 是否为 slice。
        int subscriptIsSlice(AstExpr arr) {
            if (arr == null) return 0;
            if (arr.kind() == "Identifier") {
                if (hasVar(arr.name()) != 0) return isSliceVar(arr.name());
                if (hasMember(arr.name()) != 0) return propIsSlice(curClass_, arr.name());
            } else if (arr.kind() == "Member") {
                string cls = arr.resolvedClass();
                // @static class 属性下标
                AstExpr sobj = arr.array();
                if (sobj != null && sobj.kind() == "Identifier" && isStaticClassName(sobj.name()) != 0) {
                    cls = sobj.name();
                }
                if (Str.len(cls) == 0) cls = "Object";
                return propIsSlice(cls, arr.memberName());
            }
            return 0;
        }

        // Subscript 元素地址（不 load）：arr[i] → GEP 指针（slice 先 extract data）。
        // 用于 v[i].field 成员访问（元素是 struct 值时须取地址再 GEP 字段）。
        string subscriptElemAddr(AstExpr arr, AstExpr idx) {
            string arrV = genExpr(arr);
            string idxV = genExpr(idx);
            string idxT = exprLlvmType(idx);
            string elemLt = subscriptElemLt(arr);
            int isSl = subscriptIsSlice(arr);
            if (isSl == 0 && exprLlvmType(arr) == "{ ptr, i64 }") isSl = 1;
            string gep;
            if (isSl != 0) {
                string data = newTmp();
                sb_.append("  " + data + " = extractvalue { ptr, i64 } " + arrV + ", 0\n");
                gep = newTmp();
                sb_.append("  " + gep + " = getelementptr " + elemLt + ", ptr " + data + ", " + idxT + " " + idxV + "\n");
            } else {
                gep = newTmp();
                sb_.append("  " + gep + " = getelementptr " + elemLt + ", ptr " + arrV + ", " + idxT + " " + idxV + "\n");
            }
            return gep;
        }

        void genFunction(AstFunction f) {
            curTypeParams_ = f.typeParams();
            curTypeArgs_ = f.instTypeArgs();
            curFnCoro_ = f.coro();
            curFnRegion_ = f.region();
            genFuncBody(f.name(), f.params(), f.ret(), f.body());
        }

        // @static 类方法：Class_method(params)，无 this。
        void genStaticAction(string cls, AstAction a) {
            // Coro 静态内建：方法体空 → 直接发运行时调用（__myp_coro_* 隐藏）
            if (cls == "Coro") { genCoroBuiltin(cls, a); return; }
            setupTypeParams(cls);
            curFnCoro_ = a.coro();
            curFnRegion_ = a.region();
            genFuncBody(cls + "_" + a.name(), a.params(), a.ret(), a.body());
        }

        // 泛型实例体内类型参数映射（typeParams → instTypeArgs）。
        void setupTypeParams(string cls) {
            curTypeParams_ = new ArrayList<string>();
            curTypeArgs_ = new ArrayList<AstType>();
            if (tu_ == null) return;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int i = 0; i < c.typeParams().size() && i < c.instTypeArgs().size(); i = i + 1) {
                    curTypeParams_.add(c.typeParams().get(i));
                    curTypeArgs_.add(c.instTypeArgs().get(i));
                }
                return;
            }
        }

        // 实例方法：Class_method(ptr this, params...)。
        void genInstanceAction(string cls, AstAction a) {
            genInstanceActionNamed(cls + "_" + a.name(), cls, a);
        }

        // 构造器：Class_Class_<paramTypes>(ptr this, params...)。
        void genConstructor(string cls, AstAction a) {
            genInstanceActionNamed(cls + "_" + a.name() + mangleParams(a.params()), cls, a);
        }

        // function 段方法：Class_name(ptr this, params...)（实例方法，同 C++）。
        void genClassFunction(string cls, AstFunction f) {
            setupTypeParams(cls);
            ArrayList<AstParam> ps = new ArrayList<AstParam>();
            AstParam tp = new AstParam();
            tp.setName("this");
            AstType ptrT = new AstType();
            ptrT.setClassName(cls);
            tp.setType(ptrT);
            ps.add(tp);
            for (int i = 0; i < f.params().size(); i = i + 1) ps.add(f.params().get(i));
            string saveCls = curClass_;
            curClass_ = cls;
            curFnCoro_ = f.coro();
            curFnRegion_ = f.region();
            genFuncBody(cls + "_" + f.name(), ps, f.ret(), f.body());
            curClass_ = saveCls;
        }

        void genInstanceActionNamed(string fn, string cls, AstAction a) {
            setupTypeParams(cls);
            ArrayList<AstParam> ps = new ArrayList<AstParam>();
            AstParam tp = new AstParam();
            tp.setName("this");
            AstType ptrT = new AstType();
            ptrT.setClassName(cls);
            tp.setType(ptrT);
            ps.add(tp);
            for (int i = 0; i < a.params().size(); i = i + 1) ps.add(a.params().get(i));
            string saveCls = curClass_;
            curClass_ = cls;
            curFnCoro_ = a.coro();
            curFnRegion_ = a.region();
            genFuncBody(fn, ps, a.ret(), a.body());
            curClass_ = saveCls;
        }

        // struct 方法：struct_<key>_<method>(ptr this, params...)（this 为结构体指针）。
        void genStructMethod(string key, AstFunction f) {
            ArrayList<AstParam> ps = new ArrayList<AstParam>();
            AstParam tp = new AstParam();
            tp.setName("this");
            AstType ptrT = new AstType();
            ptrT.setClassName("Object");   // 非 struct → llvmType = ptr
            tp.setType(ptrT);
            ps.add(tp);
            for (int i = 0; i < f.params().size(); i = i + 1) ps.add(f.params().get(i));
            string saveCls = curClass_;
            curClass_ = key;
            curFnCoro_ = f.coro();
            curFnRegion_ = f.region();
            genFuncBody("struct_" + key + "_" + f.name(), ps, f.ret(), f.body());
            curClass_ = saveCls;
        }

        // struct 方法调用：struct_<key>_<method>(ptr this, args...)（this = 结构体指针）。
        string genStructMethodCall(string key, string mname, AstExpr e, string thisV) {
            ArrayList<string> exp = structMethodParamLts(key, mname);
            StringBuilder as = new StringBuilder();
            as.append("ptr " + thisV);
            for (int i = 0; i < e.args().size(); i = i + 1) {
                AstExpr a = e.args().get(i);
                string av = genExpr(a);
                string at = exprLlvmType(a);
                if (i < exp.size()) {
                    av = convertValueU(av, at, exp.get(i), isUnsignedKind(a.resolvedKind()));
                    at = exp.get(i);
                }
                as.append(", " + at + " " + av);
            }
            string retLt = exprLlvmType(e);
            if (retLt == "void") {
                sb_.append("  call void @struct_" + key + "_" + mname + "(" + as.toString() + ")\n");
                return "";
            }
            string t = newTmp();
            sb_.append("  " + t + " = call " + retLt + " @struct_" + key + "_" + mname + "(" + as.toString() + ")\n");
            if (retLt == "ptr") addFreshTemp(t);
            return t;
        }

        // 发射全部 struct 方法（顶层 + 类嵌套；同 C++ generateStructMethods）。
        void emitStructMethods() {
            if (tu_ == null) return;
            for (int si = 0; si < tu_.structs().size(); si = si + 1) {
                AstStruct st = tu_.structs().get(si);
                for (int fi = 0; fi < st.funcs().size(); fi = fi + 1) {
                    genStructMethod(st.name(), st.funcs().get(fi));
                }
            }
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.typeParams().size() != 0 && c.isGenericInst() == 0) continue;
                for (int si = 0; si < c.structs().size(); si = si + 1) {
                    AstStruct st = c.structs().get(si);
                    string key = c.name() + "::" + st.name();
                    for (int fi = 0; fi < st.funcs().size(); fi = fi + 1) {
                        genStructMethod(key, st.funcs().get(fi));
                    }
                }
            }
        }

        // 事件 fire 函数：fire_<Class>_<Event>(ptr self, params...) → 打包参数进
        // 栈上 struct + myp_event_fire(event_id, self, data) + process_all。
        void genEventFire(string cls, AstEvent ev) {
            int eid = eventId(cls, ev.name());
            string fn = "fire_" + cls + "_" + ev.name();
            ArrayList<AstParam> ps = ev.params();
            ArrayList<string> lt = new ArrayList<string>();
            StringBuilder sig = new StringBuilder();
            sig.append("ptr %self");
            for (int i = 0; i < ps.size(); i = i + 1) {
                string t = llvmType(ps.get(i).type());
                lt.add(t);
                sig.append(", " + t + " %evp" + i);
            }
            sb_.append("define internal void @" + fn + "(" + sig.toString() + ") {\n");
            sb_.append("entry:\n");
            if (ps.size() > 0) {
                StringBuilder st = new StringBuilder();
                st.append("{");
                for (int i = 0; i < lt.size(); i = i + 1) {
                    if (i != 0) st.append(", ");
                    st.append(lt.get(i));
                }
                st.append("}");
                string structT = st.toString();
                string data = newTmp();
                sb_.append("  " + data + " = alloca " + structT + ", align 8\n");
                for (int i = 0; i < ps.size(); i = i + 1) {
                    string gep = newTmp();
                    sb_.append("  " + gep + " = getelementptr " + structT + ", ptr " + data + ", i32 0, i32 " + i + "\n");
                    sb_.append("  store " + lt.get(i) + " %evp" + i + ", ptr " + gep + "\n");
                }
                sb_.append("  call void @myp_event_fire(i32 " + eid + ", ptr %self, ptr " + data + ")\n");
            } else {
                sb_.append("  call void @myp_event_fire(i32 " + eid + ", ptr %self, ptr null)\n");
            }
            sb_.append("  call void @myp_event_process_all()\n");
            sb_.append("  ret void\n");
            sb_.append("}\n\n");
        }

        // ---- mapping / event ----

        AstFunction findFunc(string name) {
            if (tu_ == null) return null;
            for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                AstFunction f = tu_.functions().get(i);
                if (f.name() == name && f.typeParams().size() == 0) return f;
            }
            return null;
        }

        AstAction findAction(string cls, string name) {
            if (tu_ == null) return null;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    if (c.actions().get(ai).name() == name) return c.actions().get(ai);
                }
                for (int ai = 0; ai < c.staticActions().size(); ai = ai + 1) {
                    if (c.staticActions().get(ai).name() == name) return c.staticActions().get(ai);
                }
                return null;
            }
            return null;
        }

        // 类方法是否 @coro。
        int isCoroMethod(string cls, string name) {
            if (tu_ == null) return 0;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    if (c.actions().get(ai).name() == name) return c.actions().get(ai).coro();
                }
                for (int ai = 0; ai < c.staticActions().size(); ai = ai + 1) {
                    if (c.staticActions().get(ai).name() == name) return c.staticActions().get(ai).coro();
                }
                return 0;
            }
            return 0;
        }

        // 类方法 @coro(stack=N) 栈大小（KB；0 = 默认 128KB）。
        int coroStackKb(string cls, string name) {
            if (tu_ == null) return 0;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    if (c.actions().get(ai).name() == name) return c.actions().get(ai).stack();
                }
                for (int ai = 0; ai < c.staticActions().size(); ai = ai + 1) {
                    if (c.staticActions().get(ai).name() == name) return c.staticActions().get(ai).stack();
                }
                return 0;
            }
            return 0;
        }

        // 顶层函数是否 @coro（调用 spawn 用；@async 不 spawn，await 直接调用）。
        AstFunction findFuncCoro(string name) {
            if (tu_ == null) return null;
            for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                AstFunction f = tu_.functions().get(i);
                if (f.name() == name && f.coro() != 0) return f;
            }
            return null;
        }

        // 类方法/静态方法/function 段的形参 LLVM 类型列表（不含 this）。
        ArrayList<string> methodParamLts(string cls, string name) {
            ArrayList<string> out = new ArrayList<string>();
            if (tu_ == null) return out;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    AstAction a = c.actions().get(ai);
                    if (a.name() == name) {
                        for (int pi = 0; pi < a.params().size(); pi = pi + 1) out.add(llvmType(a.params().get(pi).type()));
                        return out;
                    }
                }
                for (int ai = 0; ai < c.staticActions().size(); ai = ai + 1) {
                    AstAction a = c.staticActions().get(ai);
                    if (a.name() == name) {
                        for (int pi = 0; pi < a.params().size(); pi = pi + 1) out.add(llvmType(a.params().get(pi).type()));
                        return out;
                    }
                }
                for (int fi = 0; fi < c.funcs().size(); fi = fi + 1) {
                    AstFunction f = c.funcs().get(fi);
                    if (f.name() == name) {
                        for (int pi = 0; pi < f.params().size(); pi = pi + 1) out.add(llvmType(f.params().get(pi).type()));
                        return out;
                    }
                }
                return out;
            }
            return out;
        }

        // 类 cls 方法 name 的返回 AstType（null = 未找到）。
        AstType methodRetAstType(string cls, string name) {
            if (tu_ == null) return null;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    if (c.actions().get(ai).name() == name) return c.actions().get(ai).ret();
                }
                for (int ai = 0; ai < c.staticActions().size(); ai = ai + 1) {
                    if (c.staticActions().get(ai).name() == name) return c.staticActions().get(ai).ret();
                }
                for (int fi = 0; fi < c.funcs().size(); fi = fi + 1) {
                    if (c.funcs().get(fi).name() == name) return c.funcs().get(fi).ret();
                }
                return null;
            }
            return null;
        }

        // 类 cls 方法 name 的第 idx 个形参 AstType（null = 未找到）。
        AstType methodParamAstType(string cls, string name, int idx) {
            if (tu_ == null) return null;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    if (c.actions().get(ai).name() == name && idx < c.actions().get(ai).params().size()) return c.actions().get(ai).params().get(idx).type();
                }
                for (int ai = 0; ai < c.staticActions().size(); ai = ai + 1) {
                    if (c.staticActions().get(ai).name() == name && idx < c.staticActions().get(ai).params().size()) return c.staticActions().get(ai).params().get(idx).type();
                }
                for (int fi = 0; fi < c.funcs().size(); fi = fi + 1) {
                    if (c.funcs().get(fi).name() == name && idx < c.funcs().get(fi).params().size()) return c.funcs().get(fi).params().get(idx).type();
                }
                return null;
            }
            return null;
        }

        // 第 idx 个形参的接口名（"" = 非接口）。用于 concrete→interface 上转。
        string callParamIfaceName(string mCls, string mName, int isEvCall, int idx) {
            if (isEvCall != 0) {
                AstEvent evc = findEvent(mCls, mName);
                if (evc != null && idx < evc.params().size()) {
                    AstType pt = resolveType(evc.params().get(idx).type());
                    if (pt != null && Str.len(pt.className()) != 0 && isInterfaceName(pt.className()) != 0) return pt.className();
                }
                return "";
            }
            if (Str.len(mCls) != 0) {
                AstType pt = methodParamAstType(mCls, mName, idx);
                if (pt != null) {
                    AstType rpt = resolveType(pt);
                    if (rpt != null && Str.len(rpt.className()) != 0 && isInterfaceName(rpt.className()) != 0) return rpt.className();
                }
                return "";
            }
            if (Str.len(mName) != 0) {
                AstFunction f = findFunc(mName);
                if (f != null && idx < f.params().size()) {
                    AstType rpt = resolveType(f.params().get(idx).type());
                    if (rpt != null && Str.len(rpt.className()) != 0 && isInterfaceName(rpt.className()) != 0) return rpt.className();
                }
            }
            return "";
        }

        // struct 返回调用 → struct 名（"" = 非 struct 返回）。
        string callRetStructName(AstExpr e) {
            if (e == null || e.resolvedKind() != "struct") return "";
            AstExpr callee = e.callee();
            if (callee == null) return "";
            AstType rt = null;
            if (callee.kind() == "Identifier") {
                rt = findFuncRetAstType(callee.name(), e.args().size());
                if (rt == null) rt = methodRetAstType(curClass_, callee.name());
            } else if (callee.kind() == "Member") {
                // struct 方法调用：obj 是 struct 变量 → struct.funcs 返回类型
                AstExpr obj = callee.array();
                if (obj != null && obj.kind() == "Identifier") {
                    AstType oat = varAstType(obj.name());
                    if (oat != null) {
                        AstType srt = resolveType(oat);
                        if (srt != null && Str.len(srt.className()) != 0 && isStructName(srt.className()) != 0) {
                            AstStruct st = findStructByName(srt.className());
                            if (st != null) {
                                for (int fi = 0; fi < st.funcs().size(); fi = fi + 1) {
                                    AstFunction mf = st.funcs().get(fi);
                                    if (mf.name() == callee.memberName()) rt = mf.ret();
                                }
                            }
                        }
                    }
                }
                if (rt == null) {
                    string cls = callee.resolvedClass();
                    if (Str.len(cls) == 0) cls = "Object";
                    rt = methodRetAstType(cls, callee.memberName());
                }
            }
            if (rt != null) {
                AstType rrt = resolveType(rt);
                if (rrt != null && Str.len(rrt.className()) != 0 && isStructName(rrt.className()) != 0) {
                    return rrt.className();
                }
            }
            return "";
        }

        // 顶层函数形参 LLVM 类型列表。
        ArrayList<string> funcParamLts(string name) {
            ArrayList<string> out = new ArrayList<string>();
            AstFunction f = findFunc(name);
            if (f == null) return out;
            for (int pi = 0; pi < f.params().size(); pi = pi + 1) out.add(llvmType(f.params().get(pi).type()));
            return out;
        }

        // 按名字找 struct（顶层 + 类嵌套）。
        AstStruct findStructByName(string name) {
            if (tu_ == null) return null;
            for (int i = 0; i < tu_.structs().size(); i = i + 1) {
                if (tu_.structs().get(i).name() == name) return tu_.structs().get(i);
            }
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                for (int si = 0; si < c.structs().size(); si = si + 1) {
                    AstStruct st = c.structs().get(si);
                    if (st.name() == name) return st;
                    if ((c.name() + "::" + st.name()) == name) return st;
                }
            }
            return null;
        }

        // struct 方法形参 LLVM 类型列表（key 为 struct 名/带 parent 前缀）。
        ArrayList<string> structMethodParamLts(string key, string name) {
            ArrayList<string> out = new ArrayList<string>();
            AstStruct st = findStructByName(key);
            if (st == null) return out;
            for (int fi = 0; fi < st.funcs().size(); fi = fi + 1) {
                AstFunction f = st.funcs().get(fi);
                if (f.name() == name) {
                    for (int pi = 0; pi < f.params().size(); pi = pi + 1) out.add(llvmType(f.params().get(pi).type()));
                    return out;
                }
            }
            return out;
        }

        // 内建 runtime 函数形参 LLVM 类型（fn 已去 __ 前缀；供实参提升，
        // 尤其 bool→i32 的断言类内建，同 C++ intrinsic_map_ + 签名）。
        ArrayList<string> intrParamLts(string fn) {
            ArrayList<string> out = new ArrayList<string>();
            if (fn == "myp_assert" || fn == "myp_test_summary") { out.add("i32"); return out; }
            if (fn == "myp_assert_msg") { out.add("i32"); out.add("ptr"); return out; }
            if (fn == "myp_test_set_msg" || fn == "myp_test_fail_msg") { out.add("ptr"); return out; }
            if (fn == "myp_assert_eq" || fn == "myp_assert_neq") { out.add("i32"); out.add("i32"); return out; }
            if (fn == "myp_assert_long_eq" || fn == "myp_assert_long_neq") { out.add("i64"); out.add("i64"); return out; }
            if (fn == "myp_assert_str_eq" || fn == "myp_assert_str_neq") { out.add("ptr"); out.add("ptr"); return out; }
            if (fn == "myp_test_report") { out.add("ptr"); out.add("i32"); return out; }
            if (fn == "myp_assert_float_neq") { out.add("double"); out.add("double"); out.add("double"); return out; }
            if (fn == "myp_assert_null" || fn == "myp_assert_not_null"
                || fn == "myp_test_capture_contains" || fn == "myp_test_capture_eq") { out.add("ptr"); return out; }
            return out;
        }

        int hasInstanceGlobal(string name) {
            for (int i = 0; i < instanceGlobals_.size(); i = i + 1) {
                if (instanceGlobals_.get(i) == name) return 1;
            }
            return 0;
        }

        void addInstanceGlobal(string name) {
            if (Str.len(name) == 0 || hasInstanceGlobal(name) != 0) return;
            instanceGlobals_.add(name);
            stringGlobals_.append("@__myp_inst_" + name + " = internal global ptr null\n");
        }

        // 顶层 mapping 节点的实例全局（C++ generateClassInstanceGlobals）。
        void emitInstanceGlobals() {
            if (tu_ == null) return;
            for (int mi = 0; mi < tu_.mappings().size(); mi = mi + 1) {
                AstMapping m = tu_.mappings().get(mi);
                for (int ci = 0; ci < m.chains().size(); ci = ci + 1) {
                    AstMappingChain ch = m.chains().get(ci);
                    for (int ni = 0; ni < ch.nodes().size(); ni = ni + 1) {
                        addInstanceGlobal(ch.nodes().get(ni).src());
                    }
                }
            }
        }

        // { T0, T1, ... } 匿名结构体文本。
        string structTypeList(ArrayList<string> ts) {
            StringBuilder st = new StringBuilder();
            st.append("{");
            for (int i = 0; i < ts.size(); i = i + 1) {
                if (i != 0) st.append(", ");
                st.append(ts.get(i));
            }
            st.append("}");
            return st.toString();
        }

        // 生成 mapping 链的 handler 函数（写进 mappingHandlers_）+ 注册调用
        // （写进 regCalls：顶层 → __myp_init；语句内 → 当前函数体 sb_）。
        void genMappingChain(AstMappingChain ch, StringBuilder regCalls) {
            ArrayList<AstMappingNode> nds = ch.nodes();
            if (nds.size() < 2) return;
            AstMappingNode src = nds.get(0);
            string srcCls = findEventClass(src.src(), src.member());
            if (Str.len(srcCls) == 0) return;
            AstEvent ev = findEvent(srcCls, src.member());
            int eid = eventId(srcCls, src.member());
            string hname = "handler_" + src.src() + "_" + src.member();

            // handler 是独立函数：保存外部上下文，切到 mappingHandlers_ 缓冲。
            StringBuilder saveSb = sb_;
            string saveCls = curClass_;
            ArrayList<string> sLN = localNames_;
            ArrayList<string> sLT = localTypes_;
            ArrayList<AstType> sLAT = localAstTypes_;
            ArrayList<string> sLA = localAllocas_;
            ArrayList<string> sLE = localElemTypes_;
            ArrayList<int> sLS = localIsSlice_;
            ArrayList<int> sLArc = localIsArc_;
            int sTerm = terminated_;
            string sBlock = curBlock_;

            sb_ = mappingHandlers_;
            curClass_ = "";
            terminated_ = 0;
            curBlock_ = "entry";
            localNames_ = new ArrayList<string>();
            localTypes_ = new ArrayList<string>();
            localAstTypes_ = new ArrayList<AstType>();
            localAllocas_ = new ArrayList<string>();
            localElemTypes_ = new ArrayList<string>();
            localIsSlice_ = new ArrayList<int>();
            localIsArc_ = new ArrayList<int>();

            sb_.append("define internal void @" + hname + "(ptr %inst, ptr %data) {\n");
            sb_.append("entry:\n");

            ArrayList<AstParam> ps = ev != null ? ev.params() : new ArrayList<AstParam>();
            ArrayList<string> evT = new ArrayList<string>();
            for (int pi = 0; pi < ps.size(); pi = pi + 1) evT.add(llvmType(ps.get(pi).type()));

            // where 子句：解包事件参数 → 求值条件 → false 则 return
            if (ch.whereClause() != null && ps.size() > 0) {
                string structT = structTypeList(evT);
                for (int pi = 0; pi < ps.size(); pi = pi + 1) {
                    string gep = newTmp();
                    sb_.append("  " + gep + " = getelementptr " + structT + ", ptr %data, i32 0, i32 " + pi + "\n");
                    string lv = newTmp();
                    sb_.append("  " + lv + " = load " + evT.get(pi) + ", ptr " + gep + "\n");
                    string a = newTmp();
                    sb_.append("  " + a + " = alloca " + evT.get(pi) + ", align 8\n");
                    sb_.append("  store " + evT.get(pi) + " " + lv + ", ptr " + a + "\n");
                    localNames_.add(ps.get(pi).name());
                    localTypes_.add(evT.get(pi));
                    localAstTypes_.add(ps.get(pi).type());
                    localAllocas_.add(a);
                    localElemTypes_.add("");
                    localIsSlice_.add(0);
                    localIsArc_.add(0);
                }
                string condV = genExpr(ch.whereClause());
                string ct = exprLlvmType(ch.whereClause());
                string ci = newTmp();
                sb_.append("  " + ci + " = icmp ne " + ct + " " + condV + ", 0\n");
                string contB = newBlock("wh_cont");
                string skipB = newBlock("wh_skip");
                sb_.append("  br i1 " + ci + ", label %" + contB + ", label %" + skipB + "\n");
                sb_.append(skipB + ":\n");
                sb_.append("  ret void\n");
                sb_.append(contB + ":\n");
                // where 参数出作用域（target 阶段不再可见）
                localNames_ = new ArrayList<string>();
                localTypes_ = new ArrayList<string>();
                localAstTypes_ = new ArrayList<AstType>();
                localAllocas_ = new ArrayList<string>();
                localElemTypes_ = new ArrayList<string>();
                localIsSlice_ = new ArrayList<int>();
                localIsArc_ = new ArrayList<int>();
            }

            // targets
            string prevT = "";
            string prevV = "";
            int havePrev = 0;
            for (int i = 1; i < nds.size(); i++) {
                AstMappingNode tgt = nds.get(i);
                if (tgt.isLambda() != 0 && tgt.lambda() != null) {
                    // lambda 变换节点：调 __lambda_N___call(实例, 入参)，结果成为下一节点的入参
                    AstExpr lex = tgt.lambda();
                    string cls = lex.hiddenClass();
                    string callee = cls + "___call";
                    string inst = newTmp();
                    sb_.append("  " + inst + " = load ptr, ptr @__myp_lambda_" + cls + "\n");
                    StringBuilder as = new StringBuilder();
                    as.append("ptr " + inst);
                    ArrayList<string> lparams = methodParamLts(cls, "__call");
                    if (i == 1 && ps.size() > 0) {
                        string structT = structTypeList(evT);
                        for (int pi = 0; pi < ps.size() && pi < lparams.size(); pi++) {
                            string gep = newTmp();
                            sb_.append("  " + gep + " = getelementptr " + structT + ", ptr %data, i32 0, i32 " + pi + "\n");
                            string lv = newTmp();
                            sb_.append("  " + lv + " = load " + evT.get(pi) + ", ptr " + gep + "\n");
                            lv = convertValue(lv, evT.get(pi), lparams.get(pi));
                            as.append(", " + lparams.get(pi) + " " + lv);
                        }
                    } else if (havePrev != 0) {
                        string pt = lparams.size() > 0 ? lparams.get(0) : prevT;
                        string pv = convertValue(prevV, prevT, pt);
                        as.append(", " + pt + " " + pv);
                    }
                    AstType lret = methodRetAstType(cls, "__call");
                    string retLt = lret != null ? llvmType(lret) : "void";
                    if (retLt == "void") {
                        sb_.append("  call void @" + callee + "(" + as.toString() + ")\n");
                    } else {
                        string r = newTmp();
                        sb_.append("  " + r + " = call " + retLt + " @" + callee + "(" + as.toString() + ")\n");
                        prevT = retLt;
                        prevV = r;
                        havePrev = 1;
                    }
                    continue;
                }
                if (tgt.isTransformer() != 0) continue;
                string callee = "";
                string instV = "";
                ArrayList<AstParam> tparams = null;
                AstType tret = null;
                if (tgt.isFunction() != 0) {
                    callee = tgt.src();
                    AstFunction tf = findFunc(tgt.src());
                    if (tf != null) { tparams = tf.params(); tret = tf.ret(); }
                } else {
                    string tcls = tgt.src();
                    callee = tcls + "_" + tgt.member();
                    AstAction ta = findAction(tcls, tgt.member());
                    if (ta != null) { tparams = ta.params(); tret = ta.ret(); }
                    if (hasInstanceGlobal(tcls) != 0) {
                        instV = newTmp();
                        sb_.append("  " + instV + " = load ptr, ptr @__myp_inst_" + tcls + "\n");
                    } else if (isStaticAction(tcls, tgt.member()) == 0) {
                        instV = "%inst";
                    }
                }
                StringBuilder as = new StringBuilder();
                int hasArg = 0;
                if (Str.len(instV) != 0) {
                    as.append("ptr " + instV);
                    hasArg = 1;
                }
                if (i == 1 && ps.size() > 0) {
                    string structT = structTypeList(evT);
                    for (int pi = 0; pi < ps.size(); pi = pi + 1) {
                        string gep = newTmp();
                        sb_.append("  " + gep + " = getelementptr " + structT + ", ptr %data, i32 0, i32 " + pi + "\n");
                        string lv = newTmp();
                        sb_.append("  " + lv + " = load " + evT.get(pi) + ", ptr " + gep + "\n");
                        if (hasArg != 0) as.append(", ");
                        as.append(evT.get(pi) + " " + lv);
                        hasArg = 1;
                    }
                } else if (havePrev != 0) {
                    if (hasArg != 0) as.append(", ");
                    as.append(prevT + " " + prevV);
                    hasArg = 1;
                }
                string retLt = "void";
                if (tret != null) retLt = llvmType(tret);
                if (retLt == "void") {
                    sb_.append("  call void @" + callee + "(" + as.toString() + ")\n");
                } else {
                    string r = newTmp();
                    sb_.append("  " + r + " = call " + retLt + " @" + callee + "(" + as.toString() + ")\n");
                    prevT = retLt;
                    prevV = r;
                    havePrev = 1;
                }
            }
            sb_.append("  ret void\n");
            sb_.append("}\n\n");

            // 恢复外部上下文
            sb_ = saveSb;
            curClass_ = saveCls;
            localNames_ = sLN;
            localTypes_ = sLT;
            localAstTypes_ = sLAT;
            localAllocas_ = sLA;
            localElemTypes_ = sLE;
            localIsSlice_ = sLS;
            localIsArc_ = sLArc;
            terminated_ = sTerm;
            curBlock_ = sBlock;

            // 实例化 mapping 链中的 lambda 实例（零初始化；入参来自事件数据/上一节点）
            for (int li = 1; li < nds.size(); li++) {
                AstMappingNode lnode = nds.get(li);
                if (lnode.isLambda() == 0 || lnode.lambda() == null) continue;
                AstExpr le = lnode.lambda();
                string lcls = le.hiddenClass();
                if (Str.len(lcls) == 0) continue;
                string gname = "__myp_lambda_" + lcls;
                if (Str.contains(stringGlobals_.toString(), "@" + gname) == 0) {
                    stringGlobals_.append("@" + gname + " = internal global ptr null\n");
                }
                int lsz = classSize(lcls);
                if (lsz < 1) lsz = 1;
                string lin = newTmp();
                regCalls.append("  " + lin + " = call ptr @myp_alloc_object(i64 " + lsz + ", i32 0)\n");
                regCalls.append("  call void @llvm.memset.p0.i64(ptr " + lin + ", i8 0, i64 " + lsz + ", i1 false)\n");
                regCalls.append("  store ptr " + lin + ", ptr @" + gname + "\n");
            }

            regCalls.append("  call void @myp_event_register(i32 " + eid + ", ptr null, ptr @" + hname + ")\n");
        }

        // 顶层 mapping：handler 写 mappingHandlers_，注册写 mappingInitCalls_。
        void genTopMappings() {
            if (tu_ == null) return;
            for (int mi = 0; mi < tu_.mappings().size(); mi = mi + 1) {
                AstMapping m = tu_.mappings().get(mi);
                for (int ci = 0; ci < m.chains().size(); ci = ci + 1) {
                    genMappingChain(m.chains().get(ci), mappingInitCalls_);
                }
            }
        }

        // 语句内 mapping：注册调用进当前函数体 sb_，handler 进 mappingHandlers_。
        void genMappingStmtLocal(AstMapping mp) {
            if (mp.scope() != 0) {
                sb_.append("  call void @myp_event_push_scope()\n");
                curFnScope_ = 1;
            }
            for (int ci = 0; ci < mp.chains().size(); ci = ci + 1) {
                genMappingChain(mp.chains().get(ci), sb_);
            }
        }

        // ---- 协程 ----

        // Coro 静态内建方法：方法体空，codegen 直接发运行时调用
        //（__myp_coro_* 对用户隐藏，同 C++ generateCoroBuiltin）。
        void genCoroBuiltin(string cls, AstAction a) {
            string name = a.name();
            string rt = "";
            string retLt = "void";
            if (name == "scheduler") rt = "__myp_coro_scheduler";
            else if (name == "sleep") { rt = "__myp_coro_sleep"; retLt = "i64"; }
            else if (name == "resume") { rt = "__myp_coro_resume"; retLt = "i64"; }
            else if (name == "yield") { rt = "__myp_coro_yield"; retLt = "i64"; }
            else if (name == "isActive") { rt = "__myp_coro_is_active"; retLt = "i64"; }
            else if (name == "current") { rt = "__myp_coro_current_handle"; retLt = "i64"; }
            else if (name == "count") { rt = "__myp_coro_count"; retLt = "i64"; }
            else if (name == "status") { rt = "__myp_coro_status"; retLt = "i64"; }
            else if (name == "destroy") { rt = "__myp_coro_destroy"; }
            else if (name == "result") { rt = "__myp_coro_result"; retLt = "i64"; }
            else if (name == "waitEvent") { rt = "__myp_coro_wait_event"; retLt = "i64"; }
            else if (name == "waitEventTimeout") { rt = "__myp_coro_wait_event_timeout"; retLt = "i64"; }
            else if (name == "waitFd") { rt = "__myp_coro_wait_fd"; retLt = "i64"; }
            else if (name == "requestCancel") { rt = "__myp_coro_request_cancel"; }
            else if (name == "cancelRequested") { rt = "__myp_coro_cancel_requested"; retLt = "i64"; }
            else if (name == "clearCancel") { rt = "__myp_coro_cancel_clear"; }
            else if (name == "waitAny") { rt = "__myp_coro_wait_any"; retLt = "i64"; }
            else if (name == "waitAnyOf") { rt = "__myp_coro_wait_any_of"; retLt = "i64"; }
            else {
                curFnRegion_ = a.region();
                genFuncBody(cls + "_" + a.name(), a.params(), a.ret(), a.body());
                return;
            }
            ArrayList<AstParam> ps = a.params();
            ArrayList<string> pt = new ArrayList<string>();
            for (int i = 0; i < ps.size(); i = i + 1) pt.add(llvmType(ps.get(i).type()));
            StringBuilder sig = new StringBuilder();
            StringBuilder fwd = new StringBuilder();
            for (int i = 0; i < pt.size(); i = i + 1) {
                if (i != 0) { sig.append(", "); fwd.append(", "); }
                sig.append(pt.get(i) + " %" + i);
                fwd.append(pt.get(i) + " %" + i);
            }
            sb_.append("define internal " + retLt + " @" + cls + "_" + name + "(" + sig.toString() + ") {\n");
            sb_.append("entry:\n");
            if (retLt == "void") {
                sb_.append("  call void @" + rt + "(" + fwd.toString() + ")\n");
                sb_.append("  ret void\n");
            } else {
                string r = newTmp();
                sb_.append("  " + r + " = call i64 @" + rt + "(" + fwd.toString() + ")\n");
                sb_.append("  ret i64 " + r + "\n");
            }
            sb_.append("}\n\n");
        }

        // @coro 方法入口包装：__myp_coro_entry_Cls_m() → 取入口槽 → 调真实方法。
        void genCoroEntry(string cls, AstAction a) {
            string fn = "__myp_coro_entry_" + cls + "_" + a.name();
            sb_.append("define void @" + fn + "() {\n");
            sb_.append("entry:\n");
            string s0 = newTmp();
            sb_.append("  " + s0 + " = call i64 @__myp_coro_get_entry_arg(i64 0)\n");
            string thisPtr = i64ToType(s0, "ptr");
            StringBuilder as = new StringBuilder();
            as.append("ptr " + thisPtr);
            for (int i = 0; i < a.params().size(); i = i + 1) {
                string slot = newTmp();
                sb_.append("  " + slot + " = call i64 @__myp_coro_get_entry_arg(i64 " + (i + 1) + ")\n");
                string lt = llvmType(a.params().get(i).type());
                string v = i64ToType(slot, lt);
                as.append(", " + lt + " " + v);
            }
            string retLt = llvmType(a.ret());
            if (retLt == "void") {
                sb_.append("  call void @" + cls + "_" + a.name() + "(" + as.toString() + ")\n");
            } else {
                string r = newTmp();
                sb_.append("  " + r + " = call " + retLt + " @" + cls + "_" + a.name() + "(" + as.toString() + ")\n");
            }
            sb_.append("  ret void\n");
            sb_.append("}\n\n");
        }

        // @coro 顶层函数入口包装：__myp_coro_entry_f() → 取槽 → 调真实函数。
        void genCoroFuncEntry(AstFunction f) {
            string fn = "__myp_coro_entry_" + f.name();
            sb_.append("define void @" + fn + "() {\n");
            sb_.append("entry:\n");
            StringBuilder as = new StringBuilder();
            for (int i = 0; i < f.params().size(); i = i + 1) {
                string slot = newTmp();
                sb_.append("  " + slot + " = call i64 @__myp_coro_get_entry_arg(i64 " + (i + 1) + ")\n");
                string lt = llvmType(f.params().get(i).type());
                string v = i64ToType(slot, lt);
                if (i != 0) as.append(", ");
                as.append(lt + " " + v);
            }
            string retLt = llvmType(f.ret());
            if (retLt == "void") {
                sb_.append("  call void @" + f.name() + "(" + as.toString() + ")\n");
            } else {
                string r = newTmp();
                sb_.append("  " + r + " = call " + retLt + " @" + f.name() + "(" + as.toString() + ")\n");
            }
            sb_.append("  ret void\n");
            sb_.append("}\n\n");
        }

        // @coro 调用 → 创建协程 + 传参 + 首启，返回 handle（i64）。
        string genCoroSpawn(string target, AstExpr e, string thisV, int isMethod, int stackKb) {
            int stackBytes = 128 * 1024;
            if (stackKb > 0) stackBytes = stackKb * 1024;
            string h = newTmp();
            sb_.append("  " + h + " = call i64 @__myp_coro_create(i64 " + stackBytes + ")\n");
            string slot0 = "0";
            if (isMethod != 0 && Str.len(thisV) != 0) slot0 = castToI64(thisV, "ptr");
            sb_.append("  call void @__myp_coro_set_entry_arg(i64 0, i64 " + slot0 + ")\n");
            for (int i = 0; i < e.args().size(); i = i + 1) {
                string av = genExpr(e.args().get(i));
                string at = exprLlvmType(e.args().get(i));
                string slot = castToI64(av, at);
                sb_.append("  call void @__myp_coro_set_entry_arg(i64 " + (i + 1) + ", i64 " + slot + ")\n");
            }
            string ep = newTmp();
            sb_.append("  " + ep + " = ptrtoint ptr @__myp_coro_entry_" + target + " to i64\n");
            sb_.append("  call void @__myp_coro_set_entry(i64 " + h + ", i64 " + ep + ")\n");
            string rr = newTmp();
            sb_.append("  " + rr + " = call i64 @__myp_coro_resume(i64 " + h + ", i64 0)\n");
            return h;
        }

        // callee 是否为 @async 目标（await 时直接调用，不 spawn）。
        int isAsyncCallTarget(AstExpr callee) {
            if (callee == null || tu_ == null) return 0;
            if (callee.kind() == "Identifier") {
                for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                    AstFunction f = tu_.functions().get(i);
                    if (f.name() == callee.name() && f.async() != 0) return 1;
                }
                if (Str.len(curClass_) != 0) {
                    for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                        AstClass c = tu_.classes().get(ci);
                        if (c.name() != curClass_) continue;
                        for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                            if (c.actions().get(ai).name() == callee.name() && c.actions().get(ai).async() != 0) return 1;
                        }
                        for (int ai = 0; ai < c.staticActions().size(); ai = ai + 1) {
                            if (c.staticActions().get(ai).name() == callee.name() && c.staticActions().get(ai).async() != 0) return 1;
                        }
                        return 0;
                    }
                }
                return 0;
            }
            if (callee.kind() == "Member") {
                AstExpr obj = callee.array();
                string mn = callee.memberName();
                if (obj != null && obj.kind() == "Identifier") {
                    // 类名接收者（静态）：Async.sleep
                    for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                        AstClass c = tu_.classes().get(ci);
                        if (c.name() != obj.name()) continue;
                        for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                            if (c.actions().get(ai).name() == mn && c.actions().get(ai).async() != 0) return 1;
                        }
                        for (int ai = 0; ai < c.staticActions().size(); ai = ai + 1) {
                            if (c.staticActions().get(ai).name() == mn && c.staticActions().get(ai).async() != 0) return 1;
                        }
                        return 0;
                    }
                    // 实例接收者：f.readLineAsync() → 按变量类型解析所属类
                    AstType oat = varAstType(obj.name());
                    if (oat != null) {
                        AstType rt = resolveType(oat);
                        if (rt != null && Str.len(rt.className()) != 0) {
                            string cn = classInstName(rt);
                            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                                AstClass c = tu_.classes().get(ci);
                                if (c.name() != cn) continue;
                                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                                    if (c.actions().get(ai).name() == mn && c.actions().get(ai).async() != 0) return 1;
                                }
                                return 0;
                            }
                        }
                    }
                }
                return 0;
            }
            return 0;
        }

        // __myp_timer_create("eventName", delay_ms[, interval_ms]) →
        // myp_timer_create(event_id, this, delay, delay, interval)（同 C++）。
        string genTimerCreate(AstExpr e) {
            int eid = -1;
            if (e.args().size() > 0 && e.args().get(0).kind() == "String") {
                eid = eventId(curClass_, e.args().get(0).stringValue());
            }
            string delay = "0";
            if (e.args().size() > 1) {
                string dv = genExpr(e.args().get(1));
                delay = castToI64(dv, exprLlvmType(e.args().get(1)));
            }
            string interval = "0";
            if (e.args().size() > 2) {
                string iv = genExpr(e.args().get(2));
                interval = castToI64(iv, exprLlvmType(e.args().get(2)));
            }
            string thisV = loadThis();
            string r = newTmp();
            sb_.append("  " + r + " = call i32 @myp_timer_create(i32 " + eid + ", ptr " + thisV + ", i64 " + delay + ", i64 " + delay + ", i64 " + interval + ")\n");
            return r;
        }

        // P2 §5.3 位操作原语：popcount/clz/ctz/bitreverse/rotl/rotr
        // → LLVM intrinsic（多态：类型 = 实参 LLVM 宽度）。
        string genBitOpBuiltin(AstExpr e, string name) {
            AstExpr arg = e.args().get(0);
            string argV = genExpr(arg);
            string argT = exprLlvmType(arg);
            string intr = "";
            if (name == "popcount") intr = "llvm.ctpop." + argT;
            else if (name == "clz") intr = "llvm.ctlz." + argT;
            else if (name == "ctz") intr = "llvm.cttz." + argT;
            else if (name == "bitreverse") intr = "llvm.bitreverse." + argT;
            else if (name == "rotl") intr = "llvm.fshl." + argT;
            else if (name == "rotr") intr = "llvm.fshr." + argT;
            string t = newTmp();
            if (name == "rotl" || name == "rotr") {
                AstExpr sh = e.args().get(1);
                string shV = genExpr(sh);
                string shT = exprLlvmType(sh);
                shV = convertValue(shV, shT, argT);
                sb_.append("  " + t + " = call " + argT + " @" + intr + "(" + argT + " " + argV + ", " + argT + " " + argV + ", " + argT + " " + shV + ")\n");
            } else if (name == "clz" || name == "ctz") {
                sb_.append("  " + t + " = call " + argT + " @" + intr + "(" + argT + " " + argV + ", i1 false)\n");
            } else {
                sb_.append("  " + t + " = call " + argT + " @" + intr + "(" + argT + " " + argV + ")\n");
            }
            return t;
        }

        // §9.5 多态数学 intrinsic：__myp_math_* 一元（除 pow/atan2/abs_int）
        // → LLVM 标量 intrinsic，按实参 LLVM 类型（同 C++ generatePolyMathIntrinsic）。
        string genPolyMathIntrinsic(AstExpr e, string id) {
            AstExpr arg = e.args().get(0);
            string av = genExpr(arg);
            string at = exprLlvmType(arg);
            string op = "";
            if (id == "__myp_math_sqrt") op = "sqrt";
            else if (id == "__myp_math_floor") op = "floor";
            else if (id == "__myp_math_ceil") op = "ceil";
            else if (id == "__myp_math_trunc") op = "trunc";
            else if (id == "__myp_math_sin") op = "sin";
            else if (id == "__myp_math_cos") op = "cos";
            else if (id == "__myp_math_tan") op = "tan";
            else if (id == "__myp_math_asin") op = "asin";
            else if (id == "__myp_math_acos") op = "acos";
            else if (id == "__myp_math_atan") op = "atan";
            else if (id == "__myp_math_sinh") op = "sinh";
            else if (id == "__myp_math_cosh") op = "cosh";
            else if (id == "__myp_math_tanh") op = "tanh";
            else if (id == "__myp_math_exp") op = "exp";
            else if (id == "__myp_math_log") op = "log";
            else if (id == "__myp_math_abs") op = "abs";
            else return "";
            string t = newTmp();
            if (op == "abs") {
                if (IrEmit.isIntType(at) != 0) {
                    sb_.append("  " + t + " = call " + at + " @llvm.abs." + at + "(" + at + " " + av + ", i1 false)\n");
                } else {
                    string fty = at == "float" ? "f32" : "f64";
                    sb_.append("  " + t + " = call " + at + " @llvm.fabs." + fty + "(" + at + " " + av + ")\n");
                }
                return t;
            }
            // 一元实数：整型实参提为 double（正常泛型路径不会到达）
            if (IrEmit.isIntType(at) != 0) {
                string d = newTmp();
                sb_.append("  " + d + " = sitofp " + at + " " + av + " to double\n");
                av = d;
                at = "double";
            }
            string fty = at == "float" ? "f32" : "f64";
            sb_.append("  " + t + " = call " + at + " @llvm." + op + "." + fty + "(" + at + " " + av + ")\n");
            return t;
        }

        // await 表达式/语句核心：@async 直接调用；事件等待；否则 yield。
        string genAwaitCore(AstExpr op, AstExpr timeout) {            // await <@async 调用> → 直接调用（返回值即 await 值）
            if (op != null && op.kind() == "Call") {
                if (isAsyncCallTarget(op.callee()) != 0) {
                    return genExpr(op);
                }
            }
            // await Class.event（+ timeout）→ 事件等待
            if (op != null && op.kind() == "Member") {
                AstExpr obj = op.array();
                if (obj != null && obj.kind() == "Identifier") {
                    string evCls = obj.name();
                    string evName = op.memberName();
                    if (hasEventInClass(evCls, evName) != 0) {
                        int eid = eventId(evCls, evName);
                        if (timeout != null) {
                            string tv = genExpr(timeout);
                            string t64 = castToI64(tv, exprLlvmType(timeout));
                            string r = newTmp();
                            sb_.append("  " + r + " = call i64 @__myp_coro_wait_event_timeout(i64 " + eid + ", i64 " + t64 + ", i64 0)\n");
                            return r;
                        }
                        string r = newTmp();
                        sb_.append("  " + r + " = call i64 @__myp_coro_wait_event(i64 " + eid + ", i64 0)\n");
                        return r;
                    }
                }
            }
            // await expr / await; → 挂起传出值
            string out = "0";
            if (op != null) {
                string ov = genExpr(op);
                out = castToI64(ov, exprLlvmType(op));
            }
            string r = newTmp();
            sb_.append("  " + r + " = call i64 @__myp_coro_yield(i64 " + out + ")\n");
            return r;
        }

        // @test 单个用例的异常隔离：push handler + setjmp；非零 = 未捕获异常 →
        // 打 FAIL + fail_msg + pop，继续下一用例。
        void emitTestProtectedCall(string label, string callInstr) {
            string jb = newTmp();
            sb_.append("  " + jb + " = alloca %myp_jmp_buf, align 8\n");
            sb_.append("  call void @myp_exception_push(ptr " + jb + ")\n");
            string r = newTmp();
            sb_.append("  " + r + " = call i32 @setjmp(ptr " + jb + ")\n");
            string isErr = newTmp();
            sb_.append("  " + isErr + " = icmp ne i32 " + r + ", 0\n");
            string okB = newBlock("test_call");
            string excB = newBlock("test_exc");
            string nextB = newBlock("test_next");
            sb_.append("  br i1 " + isErr + ", label %" + excB + ", label %" + okB + "\n");
            sb_.append(okB + ":\n");
            sb_.append("  " + callInstr + "\n");
            sb_.append("  call void @myp_exception_pop()\n");
            sb_.append("  br label %" + nextB + "\n");
            sb_.append(excB + ":\n");
            string failLbl = stringLiteral("  FAIL: " + label + " (uncaught exception)\n");
            sb_.append("  call i32 (ptr, ...) @printf(ptr " + failLbl + ")\n");
            string msg = stringLiteral("uncaught exception in " + label);
            sb_.append("  call void @myp_test_fail_msg(ptr " + msg + ")\n");
            sb_.append("  call void @myp_exception_pop()\n");
            sb_.append("  br label %" + nextB + "\n");
            sb_.append(nextB + ":\n");
        }

        // 测试运行器 main（mypc --test 等价）：收集 @test 函数/action，逐个异常
        // 隔离调用，末了 myp_test_summary(n) 作为退出码。
        void genTestRunner() {
            if (tu_ == null) return;
            // 收集 @test 顶层函数（去重，泛型模板跳过）
            ArrayList<string> testFns = new ArrayList<string>();
            ArrayList<string> seenF = new ArrayList<string>();
            for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                AstFunction f = tu_.functions().get(i);
                if (f.test() == 0) continue;
                if (f.typeParams().size() != 0 && f.genericInst() == 0) continue;
                int dup = 0;
                for (int di = 0; di < seenF.size(); di = di + 1) {
                    if (seenF.get(di) == f.name()) { dup = 1; break; }
                }
                if (dup != 0) continue;
                seenF.add(f.name());
                testFns.add(f.name());
            }
            // 收集 @test action（实例 + 静态）
            ArrayList<string> actCls = new ArrayList<string>();
            ArrayList<string> actName = new ArrayList<string>();
            ArrayList<int> actStatic = new ArrayList<int>();
            ArrayList<string> seenC = new ArrayList<string>();
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.typeParams().size() != 0 && c.isGenericInst() == 0) continue;
                int dup = 0;
                for (int di = 0; di < seenC.size(); di = di + 1) {
                    if (seenC.get(di) == c.name()) { dup = 1; break; }
                }
                if (dup != 0) continue;
                seenC.add(c.name());
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    AstAction a = c.actions().get(ai);
                    if (a.test() != 0) { actCls.add(c.name()); actName.add(a.name()); actStatic.add(0); }
                }
                for (int ai = 0; ai < c.staticActions().size(); ai = ai + 1) {
                    AstAction a = c.staticActions().get(ai);
                    if (a.test() != 0) { actCls.add(c.name()); actName.add(a.name()); actStatic.add(1); }
                }
            }

            int nTests = testFns.size() + actCls.size();

            sb_.append("declare i32 @printf(ptr, ...)\n\n");
            sb_.append("define i32 @main() {\n");
            sb_.append("entry:\n");
            if (tu_.mappings().size() > 0) sb_.append("  call void @__myp_init()\n");
            string hdr = stringLiteral("=== MYP Test Runner ===\n");
            sb_.append("  call i32 (ptr, ...) @printf(ptr " + hdr + ")\n");

            for (int fi = 0; fi < testFns.size(); fi = fi + 1) {
                string fname = testFns.get(fi);
                string lbl = stringLiteral("  RUN: " + fname + "\n");
                sb_.append("  call i32 (ptr, ...) @printf(ptr " + lbl + ")\n");
                emitTestProtectedCall(fname, "call void @" + fname + "()");
            }
            for (int ai = 0; ai < actCls.size(); ai = ai + 1) {
                string cls = actCls.get(ai);
                string nm = actName.get(ai);
                int isStatic = actStatic.get(ai);
                string lbl = stringLiteral("  RUN: " + cls + "." + nm + "\n");
                sb_.append("  call i32 (ptr, ...) @printf(ptr " + lbl + ")\n");
                if (isStatic != 0) {
                    emitTestProtectedCall(cls + "." + nm, "call void @" + cls + "_" + nm + "()");
                } else {
                    int sz = classSize(cls);
                    string inst = newTmp();
                    sb_.append("  " + inst + " = call ptr @myp_alloc(i64 " + sz + ")\n");
                    sb_.append("  call void @llvm.memset.p0.i64(ptr " + inst + ", i8 0, i64 " + sz + ", i1 false)\n");
                    emitTestProtectedCall(cls + "." + nm, "call void @" + cls + "_" + nm + "(ptr " + inst + ")");
                }
            }

            string done = stringLiteral("=== MYP Tests Complete ===\n");
            sb_.append("  call i32 (ptr, ...) @printf(ptr " + done + ")\n");
            string sum = newTmp();
            sb_.append("  " + sum + " = call i32 @myp_test_summary(i32 " + nTests + ")\n");
            sb_.append("  ret i32 " + sum + "\n");
            sb_.append("}\n\n");
        }

        // __lambda_N_tramp(ptr self, params...) -> ret：调用 __lambda_N___call(self, params...)。
        // 供 lambda 表达式的 fat pointer {closure, call_fn} 引用（call_fn = tramp）。
        void genLambdaTramp(AstClass c) {
            AstAction call = null;
            for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                AstAction a = c.actions().get(ai);
                if (a.name() == "__call") { call = a; break; }
            }
            if (call == null) return;
            string retLt = llvmType(call.ret());
            string fn = c.name() + "_tramp";
            StringBuilder ps = new StringBuilder();
            ps.append("ptr %self");
            for (int i = 0; i < call.params().size(); i = i + 1) {
                ps.append(", " + llvmType(call.params().get(i).type()) + " %" + call.params().get(i).name());
            }
            sb_.append("define internal " + retLt + " @" + fn + "(" + ps.toString() + ") {\n");
            sb_.append("entry:\n");
            StringBuilder as = new StringBuilder();
            as.append("ptr %self");
            for (int i = 0; i < call.params().size(); i = i + 1) {
                as.append(", " + llvmType(call.params().get(i).type()) + " %" + call.params().get(i).name());
            }
            string callFn = c.name() + "___call";
            if (retLt == "void") {
                sb_.append("  call void @" + callFn + "(" + as.toString() + ")\n");
                sb_.append("  ret void\n");
            } else {
                string t = newTmp();
                sb_.append("  " + t + " = call " + retLt + " @" + callFn + "(" + as.toString() + ")\n");
                sb_.append("  ret " + retLt + " " + t + "\n");
            }
            sb_.append("}\n\n");
        }

        // lambda 表达式：new __lambda_N() + 填充捕获槽 + 构建 fat pointer {closure, tramp}。
        string genLambda(AstExpr e) {
            string cls = e.hiddenClass();
            int sz = classSize(cls);
            string obj = newTmp();
            sb_.append("  " + obj + " = call ptr @myp_alloc_object(i64 " + sz + ", i32 0)\n");
            // 填充捕获槽：cap_i = 外层变量当前值（按值）。nonlocal 槽存 cell 对象引用。
            for (int i = 0; i < e.captureNames().size(); i = i + 1) {
                string capName = e.captureNames().get(i);
                string slot = e.captureSlots().get(i);
                int nl = 0;
                if (i < e.nonlocalCells().size() && Str.len(e.nonlocalCells().get(i)) != 0) nl = 1;
                int pi = propIndex(cls, slot);
                string ft = propType(cls, slot);
                string val = "";
                if (nl != 0) {
                    // nonlocal：槽存共享 cell 对象（promoteNonlocalToCell 建立 cellOwner）
                    val = cellOwner(capName);
                    if (Str.len(val) == 0) val = "null";
                } else if (hasVar(capName) != 0) {
                    string lt = varType(capName);
                    string t = newTmp();
                    sb_.append("  " + t + " = load " + lt + ", ptr " + varAlloca(capName) + "\n");
                    val = t;
                } else if (hasMember(capName) != 0) {
                    string gep2 = thisMemberAddr(capName);
                    string ft2 = propType(curClass_, capName);
                    string t = newTmp();
                    sb_.append("  " + t + " = load " + ft2 + ", ptr " + gep2 + "\n");
                    val = t;
                }
                if (Str.len(val) == 0) val = "null";
                string gep = newTmp();
                sb_.append("  " + gep + " = getelementptr %" + cls + ", ptr " + obj + ", i32 0, i32 " + pi + "\n");
                sb_.append("  store " + ft + " " + val + ", ptr " + gep + "\n");
            }
            // fat pointer {closure, call_fn}
            string p0 = newTmp();
            sb_.append("  " + p0 + " = insertvalue { ptr, ptr } poison, ptr " + obj + ", 0\n");
            string p1 = newTmp();
            sb_.append("  " + p1 + " = insertvalue { ptr, ptr } " + p0 + ", ptr @" + cls + "_tramp, 1\n");
            return p1;
        }

        // 间接调用函数值：fn 为 (A,B)->R 类型变量/参数 → load {closure, call_fn}
        // → call_fn(closure, args...)。
        string genFuncValueCall(AstExpr e, string name, AstType at) {
            string fv = newTmp();
            sb_.append("  " + fv + " = load { ptr, ptr }, ptr " + varAlloca(name) + "\n");
            string cl = newTmp();
            sb_.append("  " + cl + " = extractvalue { ptr, ptr } " + fv + ", 0\n");
            string cf = newTmp();
            sb_.append("  " + cf + " = extractvalue { ptr, ptr } " + fv + ", 1\n");
            StringBuilder as = new StringBuilder();
            as.append("ptr " + cl);
            for (int i = 0; i < e.args().size(); i = i + 1) {
                AstExpr a = e.args().get(i);
                string av = genExpr(a);
                string aT = exprLlvmType(a);
                string pt = "i32";
                if (i < at.funcParamTypes().size()) pt = llvmType(at.funcParamTypes().get(i));
                av = convertValue(av, aT, pt);
                as.append(", " + pt + " " + av);
            }
            string retLt = llvmType(at.funcReturn());
            if (retLt == "void") {
                sb_.append("  call void " + cf + "(" + as.toString() + ")\n");
                return "";
            }
            string t = newTmp();
            sb_.append("  " + t + " = call " + retLt + " " + cf + "(" + as.toString() + ")\n");
            return t;
        }

        // nonlocal 捕获变量 → 其共享 cell 对象 SSA 值（尚未提升则返回空）。
        string cellOwner(string name) {
            for (int i = 0; i < cellOwnerNames_.size(); i = i + 1) {
                if (cellOwnerNames_.get(i) == name) return cellOwnerVals_.get(i);
            }
            return "";
        }

        // 构造器 mangle（与 sema mangleType/mangleParams 一致）。
        string mangleType(AstType t) {
            if (t == null) return "unknown";
            if (t.element() != null) return mangleType(t.element()) + "_arr";
            if (Str.len(t.className()) != 0) {
                string s = t.className();
                ArrayList<AstType> tas = t.typeArgs();
                for (int i = 0; i < tas.size(); i = i + 1) s = s + "_" + mangleType(tas.get(i));
                return s;
            }
            return t.basicName();
        }

        // 类类型 → 实例类名（ArrayList<int> → ArrayList_int_inst；同 sema instClassName）。
        string classInstName(AstType t) {
            if (t == null) return "";
            string cn = t.className();
            if (Str.len(cn) == 0) return mangleType(t);
            if (t.typeArgs().size() > 0) {
                string inst = cn;
                for (int i = 0; i < t.typeArgs().size(); i = i + 1) {
                    inst = inst + "_" + classInstName(t.typeArgs().get(i));
                }
                return inst + "_inst";
            }
            return cn;
        }

        string mangleParams(ArrayList<AstParam> ps) {
            string s = "";
            for (int i = 0; i < ps.size(); i = i + 1) s = s + "_" + mangleType(ps.get(i).type());
            return s;
        }

        // 通用方法体：参数 alloca + store + body + 隐式 return。
        void genFuncBody(string fn, ArrayList<AstParam> params, AstType retT, AstStmt body) {
            int isRegion = curFnRegion_;
            curFnRegion_ = 0;
            curRegionMark_ = "";
            paramNames_ = new ArrayList<string>();
            paramTypes_ = new ArrayList<string>();
            paramAstTypes_ = new ArrayList<AstType>();
            localNames_ = new ArrayList<string>();
            localTypes_ = new ArrayList<string>();
            localAstTypes_ = new ArrayList<AstType>();
            localAllocas_ = new ArrayList<string>();
            localElemTypes_ = new ArrayList<string>();
            localIsSlice_ = new ArrayList<int>();
            localIsArc_ = new ArrayList<int>();
            pendingTemps_ = new ArrayList<string>();
            arcSlotNames_ = new ArrayList<string>();
            sliceSlotNames_ = new ArrayList<string>();
            finallyStack_ = new ArrayList<FinallyCtx>();
            finallyRetSlot_ = "";
            tryArcBases_ = new ArrayList<int>();
            threadHandles_ = new ArrayList<string>();
            curFnScope_ = 0;
            blockCounter_ = 0;
            parallelBodies_ = new StringBuilder();
            curBlock_ = "entry";
            terminated_ = 0;
            loopBreak_ = new ArrayList<string>();
            loopContinue_ = new ArrayList<string>();
            isMainFunc_ = 0;
            if (fn == "main") isMainFunc_ = 1;
            string retLt = llvmType(retT);
            curRetLt_ = retLt;
            string linkage = "define";
            if (isMainFunc_ == 0) linkage = "define internal";
            for (int i = 0; i < params.size(); i = i + 1) {
                AstParam p = params.get(i);
                paramNames_.add(p.name());
                paramTypes_.add(llvmType(p.type()));
                paramAstTypes_.add(resolveType(p.type()));
            }
            StringBuilder ps = new StringBuilder();
            for (int i = 0; i < paramNames_.size(); i = i + 1) {
                if (i != 0) ps.append(", ");
                ps.append(paramTypes_.get(i));
                ps.append(" %");
                ps.append(paramNames_.get(i));
            }
            sb_.append(linkage + " " + retLt + " @" + fn + "(" + ps.toString() + ") {\n");
            sb_.append("entry:\n");
            // finally+return 的返回值槽（entry 块 alloca，支配 finally 分发块；
            // 非 void 函数预分配，C++ finally_ret_slot_）。
            if (retLt != "void") {
                finallyRetSlot_ = newTmp();
                sb_.append("  " + finallyRetSlot_ + " = alloca " + retLt + ", align 8\n");
            }
            // 参数 alloca（倒序，模拟 C++ createEntryBlockAlloca 在 entry 头插入）
            for (int i = paramNames_.size() - 1; i >= 0; i = i - 1) {
                string lt = paramTypes_.get(i);
                int al = IrEmit.alignOf(lt);
                sb_.append("  %" + paramNames_.get(i) + ".addr = alloca " + lt + ", align " + al + "\n");
            }
            for (int i = 0; i < paramNames_.size(); i = i + 1) {
                string lt = paramTypes_.get(i);
                int al = IrEmit.alignOf(lt);
                sb_.append("  store " + lt + " %" + paramNames_.get(i) + ", ptr %" + paramNames_.get(i) + ".addr, align " + al + "\n");
            }
            // @region：入口 materialize 一个 region chunk（myp_arena_mark），
            // 出口 myp_arena_release 释放回基线（同 C++ emitRegionEnter/Exit）。
            if (isRegion != 0) {
                curRegionMark_ = "region_mark";
                sb_.append("  %region_mark = alloca ptr, align 8\n");
                string m = newTmp();
                sb_.append("  " + m + " = call ptr @myp_arena_mark()\n");
                sb_.append("  store ptr " + m + ", ptr %region_mark\n");
            }
            // 函数体生成到独立缓冲：ARC 槽 alloca 进 entryAllocas_，body IR 进 bodyBuf。
            entryAllocas_ = new StringBuilder();
            StringBuilder saveSb = sb_;
            StringBuilder bodyBuf = new StringBuilder();
            sb_ = bodyBuf;
            // main 入口先调用 __myp_init() 注册顶层 mapping handler（同 C++）。
            if (isMainFunc_ != 0 && tu_ != null && tu_.mappings().size() > 0) {
                sb_.append("  call void @__myp_init()\n");
            }
            if (body != null) genStmt(body);
            // 隐式 return（body 未 terminated 时；sema 保证非 void 函数必有 return，
            // 此处兜底避免 llc 报 "missing terminator"）。
            if (terminated_ == 0) {
                // @scope mapping：函数退出前解注册（恢复到 push 时 handler 数）
                if (curFnScope_ != 0) {
                    sb_.append("  call void @myp_event_pop_scope()\n");
                    curFnScope_ = 0;
                }
                // @region：出口释放 region 临时分配（先于 ARC 槽释放，同 C++）
                emitRegionExit();
                // 函数末释放全部仍存活的 ARC 局部（C++ arcReleaseAllScopes）。
                releaseArcSlots();
                if (retLt == "void") {
                    sb_.append("  ret void\n");
                } else {
                    sb_.append("  ret " + retLt + " " + IrEmit.zeroValue(retLt) + "\n");
                }
                terminated_ = 1;
            }
            sb_ = saveSb;
            // 组装：ARC 槽 alloca 插入 entry 块（参数 store 之后、body 之前）。
            sb_.append(entryAllocas_.toString());
            sb_.append(bodyBuf.toString());
            sb_.append("}\n\n");
            // @parallel for 生成的并行 body 函数（须在本函数关闭后输出到模块）。
            sb_.append(parallelBodies_.toString());
        }

        // @parallel for 是否可并行化（init 是带命名变量的 VarDecl）。
        // 注意：不读 st.init_.kind_（自举 codegen 里嵌套语句的 kind_ 字符串
        // 读取有悬挂指针 bug），改用 decls()/name_（VarDecl 独有，稳定可用）。
        int canParallelizeFor(AstStmt st) {
            if (st.init() == null) return 0;
            if (st.init().decls().size() == 0) return 0;
            string n = st.init().decls().get(0).name();
            if (Str.len(n) == 0) return 0;
            return 1;
        }

        // @parallel for 数据并行：提取 start/end/step + 收集外层变量捕获 +
        // 生成 chunk-body 函数 + myp_pool_parallel_for 调用（同 C++ generateParallelFor）。
        void genParallelFor(AstStmt st) {
            AstVar d0 = st.init().decls().get(0);
            string loopVar = d0.name();
            string startV = "0";
            if (d0.init() != null) startV = convertValue(genExpr(d0.init()), exprLlvmType(d0.init()), "i32");
            string endV = "0";
            // 条件 i < N / i <= N：上界取 rhs。逐级局部变量展开（自举 codegen
            // 的嵌套字段链 a.b.c 有偏移 bug，拆开访问才正确）。
            AstExpr cond = st.condition();
            if (cond != null) {
                AstExpr bound = cond.rhs();
                if (bound != null) endV = convertValue(genExpr(bound), exprLlvmType(bound), "i32");
            }
            string stepV = "1";
            // 步进 i = i + K：增量 = Assign.rhs(+).rhs。
            AstExpr stepE = st.step();
            if (stepE != null) {
                AstExpr stepRhs = stepE.rhs();
                if (stepRhs != null) {
                    AstExpr inc = stepRhs.rhs();
                    if (inc != null) stepV = convertValue(genExpr(inc), exprLlvmType(inc), "i32");
                }
            }
            // 收集捕获（参数 + 局部，循环变量除外；同名遮蔽取最后）。
            ArrayList<string> capNames = new ArrayList<string>();
            ArrayList<string> capTypes = new ArrayList<string>();
            ArrayList<string> capAllocas = new ArrayList<string>();
            ArrayList<AstType> capAst = new ArrayList<AstType>();
            ArrayList<string> capElem = new ArrayList<string>();
            ArrayList<int> capSlice = new ArrayList<int>();
            ArrayList<int> capArc = new ArrayList<int>();
            for (int i = 0; i < paramNames_.size(); i = i + 1) {
                addCapture(capNames, capTypes, capAllocas, capAst, capElem, capSlice, capArc,
                    paramNames_.get(i), paramTypes_.get(i), "%" + paramNames_.get(i) + ".addr",
                    paramAstTypes_.get(i), "", 0, 0);
            }
            for (int i = 0; i < localNames_.size(); i = i + 1) {
                if (localNames_.get(i) == loopVar) continue;
                addCapture(capNames, capTypes, capAllocas, capAst, capElem, capSlice, capArc,
                    localNames_.get(i), localTypes_.get(i), localAllocas_.get(i),
                    localAstTypes_.get(i), localElemTypes_.get(i), localIsSlice_.get(i), localIsArc_.get(i));
            }
            string capT = "";
            string capA = "null";
            if (capNames.size() > 0) {
                capT = "%parallel_cap." + parallelCounter_;
                StringBuilder ms = new StringBuilder();
                for (int i = 0; i < capTypes.size(); i = i + 1) {
                    if (i != 0) ms.append(", ");
                    ms.append(capTypes.get(i));
                }
                stringGlobals_.append(capT + " = type { " + ms.toString() + " }\n");
                capA = newTmp() + ".cap";
                sb_.append("  " + capA + " = alloca " + capT + ", align 8\n");
                for (int i = 0; i < capNames.size(); i = i + 1) {
                    string cv = newTmp();
                    sb_.append("  " + cv + " = load " + capTypes.get(i) + ", ptr " + capAllocas.get(i) + "\n");
                    string gep = newTmp();
                    sb_.append("  " + gep + " = getelementptr " + capT + ", ptr " + capA + ", i32 0, i32 " + i + "\n");
                    sb_.append("  store " + capTypes.get(i) + " " + cv + ", ptr " + gep + "\n");
                }
            }
            string bodyFn = "parallel_body_" + loopVar + "." + parallelCounter_;
            parallelCounter_ = parallelCounter_ + 1;
            genParallelBody(bodyFn, loopVar, capNames, capTypes, capAst, capElem, capSlice, capArc, capT, st.body());
            string pool = newTmp();
            sb_.append("  " + pool + " = call ptr @myp_pool_ensure_global()\n");
            sb_.append("  call void @myp_pool_parallel_for(ptr " + pool + ", i32 " + startV + ", i32 " + endV + ", i32 " + stepV + ", ptr @" + bodyFn + ", ptr " + capA + ")\n");
        }

        // 捕获去重：同名取最后（内层遮蔽优先）。
        void addCapture(ArrayList<string> names, ArrayList<string> types, ArrayList<string> allocas,
                        ArrayList<AstType> ast, ArrayList<string> elem, ArrayList<int> slice, ArrayList<int> arc,
                        string name, string t, string a, AstType at, string et, int sl, int ar) {
            for (int i = 0; i < names.size(); i = i + 1) {
                if (names.get(i) == name) {
                    types.set(i, t);
                    allocas.set(i, a);
                    ast.set(i, at);
                    elem.set(i, et);
                    slice.set(i, sl);
                    arc.set(i, ar);
                    return;
                }
            }
            names.add(name);
            types.add(t);
            allocas.add(a);
            ast.add(at);
            elem.add(et);
            slice.add(sl);
            arc.add(ar);
        }

        // 生成并行 body 函数：void fn(i32 start, i32 end, i32 step, ptr arg)
        // —— 解包捕获 → 循环变量 alloca → chunk 循环跑用户 body。
        void genParallelBody(string fn, string loopVar,
                             ArrayList<string> capNames, ArrayList<string> capTypes,
                             ArrayList<AstType> capAst, ArrayList<string> capElem,
                             ArrayList<int> capSlice, ArrayList<int> capArc,
                             string capT, AstStmt body) {
            // 保存外层函数状态
            StringBuilder saveSb = sb_;
            ArrayList<string> spn = paramNames_;
            ArrayList<string> spt = paramTypes_;
            ArrayList<AstType> spa = paramAstTypes_;
            ArrayList<string> sln = localNames_;
            ArrayList<string> slt = localTypes_;
            ArrayList<AstType> sla = localAstTypes_;
            ArrayList<string> sll = localAllocas_;
            ArrayList<string> sle = localElemTypes_;
            ArrayList<int> sls = localIsSlice_;
            ArrayList<int> sli = localIsArc_;
            ArrayList<string> sp = pendingTemps_;
            ArrayList<string> sar = arcSlotNames_;
            ArrayList<string> ssl = sliceSlotNames_;
            ArrayList<string> slb = loopBreak_;
            ArrayList<string> slc = loopContinue_;
            string scb = curBlock_;
            int sbc = blockCounter_;
            int ster = terminated_;
            string sret = curRetLt_;
            int smain = isMainFunc_;
            StringBuilder sea = entryAllocas_;

            // 建立 body 函数作用域
            paramNames_ = new ArrayList<string>();
            paramTypes_ = new ArrayList<string>();
            paramAstTypes_ = new ArrayList<AstType>();
            localNames_ = new ArrayList<string>();
            localTypes_ = new ArrayList<string>();
            localAstTypes_ = new ArrayList<AstType>();
            localAllocas_ = new ArrayList<string>();
            localElemTypes_ = new ArrayList<string>();
            localIsSlice_ = new ArrayList<int>();
            localIsArc_ = new ArrayList<int>();
            pendingTemps_ = new ArrayList<string>();
            arcSlotNames_ = new ArrayList<string>();
            sliceSlotNames_ = new ArrayList<string>();
            loopBreak_ = new ArrayList<string>();
            loopContinue_ = new ArrayList<string>();
            curBlock_ = "entry";
            blockCounter_ = 0;
            terminated_ = 0;
            curRetLt_ = "void";
            isMainFunc_ = 0;
            entryAllocas_ = new StringBuilder();

            StringBuilder headBuf = new StringBuilder();
            sb_ = headBuf;
            headBuf.append("define internal void @" + fn + "(i32 %start, i32 %end, i32 %step, ptr %arg) {\n");
            headBuf.append("entry:\n");
            for (int i = 0; i < capNames.size(); i = i + 1) {
                string gep = newTmp();
                headBuf.append("  " + gep + " = getelementptr " + capT + ", ptr %arg, i32 0, i32 " + i + "\n");
                string cv = newTmp();
                headBuf.append("  " + cv + " = load " + capTypes.get(i) + ", ptr " + gep + "\n");
                string va = newTmp();
                int al = IrEmit.alignOf(capTypes.get(i));
                headBuf.append("  " + va + " = alloca " + capTypes.get(i) + ", align " + al + "\n");
                headBuf.append("  store " + capTypes.get(i) + " " + cv + ", ptr " + va + "\n");
                localNames_.add(capNames.get(i));
                localTypes_.add(capTypes.get(i));
                localAstTypes_.add(capAst.get(i));
                localAllocas_.add(va);
                localElemTypes_.add(capElem.get(i));
                localIsSlice_.add(capSlice.get(i));
                localIsArc_.add(capArc.get(i));
            }
            string ia = newTmp();
            headBuf.append("  " + ia + " = alloca i32, align 4\n");
            headBuf.append("  store i32 %start, ptr " + ia + "\n");
            localNames_.add(loopVar);
            localTypes_.add("i32");
            localAstTypes_.add(null);
            localAllocas_.add(ia);
            localElemTypes_.add("");
            localIsSlice_.add(0);
            localIsArc_.add(0);
            // 循环骨架写进独立缓冲：body 内局部变量的 entry alloca 在 genStmt 时
            // 累积到 entryAllocas_，须插入 entry 块（captures/循环变量之后、
            // br ploop.cond 之前）。
            StringBuilder loopBuf = new StringBuilder();
            sb_ = loopBuf;
            string condB = newBlock("ploop.cond");
            string bodyB = newBlock("ploop.body");
            string stepB = newBlock("ploop.step");
            string endB = newBlock("ploop.end");
            loopBuf.append("  br label %" + condB + "\n");
            openBlock(condB);
            string iCur = newTmp();
            loopBuf.append("  " + iCur + " = load i32, ptr " + ia + "\n");
            string ok = newTmp();
            loopBuf.append("  " + ok + " = icmp slt i32 " + iCur + ", %end\n");
            loopBuf.append("  br i1 " + ok + ", label %" + bodyB + ", label %" + endB + "\n");
            terminated_ = 1;
            openBlock(bodyB);
            loopBreak_.add(endB);
            loopContinue_.add(stepB);
            if (body != null) genStmt(body);
            if (terminated_ == 0) emitBr(stepB);
            loopBreak_.remove(loopBreak_.size() - 1);
            loopContinue_.remove(loopContinue_.size() - 1);
            openBlock(stepB);
            string iNext = newTmp();
            loopBuf.append("  " + iNext + " = add i32 " + iCur + ", %step\n");
            loopBuf.append("  store i32 " + iNext + ", ptr " + ia + "\n");
            loopBuf.append("  br label %" + condB + "\n");
            openBlock(endB);
            loopBuf.append("  ret void\n");
            terminated_ = 1;
            // body 函数内累积的 entry alloca（body 局部变量）
            string bodyEntryAllocas = entryAllocas_.toString();

            // 恢复外层状态
            sb_ = saveSb;
            paramNames_ = spn;
            paramTypes_ = spt;
            paramAstTypes_ = spa;
            localNames_ = sln;
            localTypes_ = slt;
            localAstTypes_ = sla;
            localAllocas_ = sll;
            localElemTypes_ = sle;
            localIsSlice_ = sls;
            localIsArc_ = sli;
            pendingTemps_ = sp;
            arcSlotNames_ = sar;
            sliceSlotNames_ = ssl;
            loopBreak_ = slb;
            loopContinue_ = slc;
            curBlock_ = scb;
            blockCounter_ = sbc;
            terminated_ = ster;
            curRetLt_ = sret;
            isMainFunc_ = smain;
            entryAllocas_ = sea;
            // 输出 body 函数到模块缓冲：head（captures/循环变量）+ entry alloca
            // + 循环骨架（本函数关闭后由 genFuncBody 统一输出）。
            parallelBodies_.append(headBuf.toString());
            parallelBodies_.append(bodyEntryAllocas);
            parallelBodies_.append(loopBuf.toString());
            parallelBodies_.append("}\n\n");
        }

        // 语句 → IR。
        void genStmt(AstStmt st) {
            if (st == null) return;
            string k = st.kind();
            if (k == "Block") {
                int arcBase = arcSlotNames_.size();
                int sliceBase = sliceSlotNames_.size();
                int locBase = localNames_.size();
                for (int i = 0; i < st.bodyStmts().size(); i = i + 1) {
                    // 当前块已被终止（throw/return/break 等）→ 新开 dead 块，
                    // 后续语句是死代码但必须合法（同 C++ generateBlock）。
                    if (terminated_ != 0) openBlock(newBlock("dead"));
                    genStmt(st.bodyStmts().get(i));
                }
                // 块末释放本块新增的 ARC 局部（C++ popScope：作用域局部出作用域即释放）。
                // 被终止（throw/return/break/continue）时：不在此释放——但必须把
                // 这些槽从 arcSlotNames_ 弹出（C++ popScope 总是弹出作用域，dead
                // 路径 releaseArcSlot 跳过实际释放）。否则外层块的 releaseArcSlotsFrom
                // 会再次释放这些槽 → 双重释放（myp_viz scanString 段错误根因）。
                if (terminated_ == 0) {
                    releaseArcSlotsFrom(arcBase);
                    releaseSliceSlotsFrom(sliceBase);
                } else {
                    while (arcSlotNames_.size() > arcBase) arcSlotNames_.remove(arcSlotNames_.size() - 1);
                    while (sliceSlotNames_.size() > sliceBase) sliceSlotNames_.remove(sliceSlotNames_.size() - 1);
                }
                // 弹出本块局部变量表（遮蔽恢复）
                while (localNames_.size() > locBase) localNames_.remove(localNames_.size() - 1);
                while (localTypes_.size() > locBase) localTypes_.remove(localTypes_.size() - 1);
                while (localAstTypes_.size() > locBase) localAstTypes_.remove(localAstTypes_.size() - 1);
                while (localAllocas_.size() > locBase) localAllocas_.remove(localAllocas_.size() - 1);
                while (localElemTypes_.size() > locBase) localElemTypes_.remove(localElemTypes_.size() - 1);
                while (localIsSlice_.size() > locBase) localIsSlice_.remove(localIsSlice_.size() - 1);
                while (localIsArc_.size() > locBase) localIsArc_.remove(localIsArc_.size() - 1);
            } else if (k == "VarDecl") {
                for (int i = 0; i < st.decls().size(); i = i + 1) {
                    AstVar v = st.decls().get(i);
                    AstType rvt = resolveType(v.type());
                    // @thread：new Cls() @thread —— 专用线程启动路径
                    if (v.thread() != 0) {
                        genThreadVar(v, rvt);
                        continue;
                    }
                    // @threadpool：Cls[N] pool @threadpool —— 每元素一个线程
                    if (v.threadpool() != 0) {
                        genThreadPoolVar(v, rvt);
                        continue;
                    }
                    // 定长数组 T[N]：alloca [N x T]，decay 为首元素地址存入 ptr 槽
                    //（下标/传参/返回均按数据指针，同 C++ createEntryBlockAlloca + GEP）。
                    if (rvt != null && rvt.element() != null && rvt.arraySize() > 0) {
                        string eLt = llvmType(rvt.element());
                        string arrLt = "[" + rvt.arraySize() + " x " + eLt + "]";
                        string arrA = newTmp() + ".arr";
                        int aal = IrEmit.alignOf(arrLt);
                        sb_.append("  " + arrA + " = alloca " + arrLt + ", align " + aal + "\n");
                        sb_.append("  store " + arrLt + " zeroinitializer, ptr " + arrA + "\n");
                        string elemPtr = newTmp();
                        sb_.append("  " + elemPtr + " = getelementptr " + arrLt + ", ptr " + arrA + ", i32 0, i32 0\n");
                        string va = newTmp();
                        sb_.append("  " + va + " = alloca ptr, align 8\n");
                        sb_.append("  store ptr " + elemPtr + ", ptr " + va + "\n");
                        localNames_.add(v.name());
                        localTypes_.add("ptr");
                        localAstTypes_.add(rvt);
                        localAllocas_.add(va);
                        localElemTypes_.add(eLt);
                        localIsSlice_.add(0);
                        localIsArc_.add(0);
                        continue;
                    }
                    string lt = llvmType(rvt);
                    int al = IrEmit.alignOf(lt);
                    // 接口变量：fat pointer { data, vtable }。init 为具体类实例时
                    // 构建胖指针（C++ generateVarDecl 接口分支），否则整体拷贝。
                    if (rvt != null && Str.len(rvt.className()) != 0 && isInterfaceName(rvt.className()) != 0) {
                        string ifaceName = rvt.className();
                        string va = entryAlloca("{ ptr, ptr }");
                        sb_.append("  store { ptr, ptr } zeroinitializer, ptr " + va + "\n");
                        localNames_.add(v.name());
                        localTypes_.add("{ ptr, ptr }");
                        localAstTypes_.add(rvt);
                        localAllocas_.add(va);
                        localElemTypes_.add("");
                        localIsSlice_.add(0);
                        localIsArc_.add(1);
                        arcSlotNames_.add(va);
                        if (v.init() != null) {
                            AstExpr initE = v.init();
                            string iv = genExpr(initE);
                            string it = exprLlvmType(initE);
                            string clsName = "";
                            if (initE.kind() == "New") {
                                clsName = initE.className();
                                if (Str.len(initE.resolvedClass()) != 0) clsName = initE.resolvedClass();
                            } else if (initE.kind() == "Identifier") {
                                AstType ivt = varAstType(initE.name());
                                if (ivt != null) {
                                    AstType irt = resolveType(ivt);
                                    if (irt != null && Str.len(irt.className()) != 0
                                        && isInterfaceName(irt.className()) == 0
                                        && isStructName(irt.className()) == 0
                                        && isEnumName(irt.className()) == 0) {
                                        clsName = classInstName(irt);
                                    }
                                }
                            }
                            if (it == "{ ptr, ptr }") {
                                // 已是接口值（函数返回接口/另一接口变量）→ 整体拷贝
                                sb_.append("  store { ptr, ptr } " + iv + ", ptr " + va + "\n");
                            } else if (Str.len(clsName) != 0) {
                                string fat = buildIfaceFat(iv, ifaceName, clsName);
                                sb_.append("  store { ptr, ptr } " + fat + ", ptr " + va + "\n");
                            } else {
                                string d0 = newTmp();
                                sb_.append("  " + d0 + " = getelementptr { ptr, ptr }, ptr " + va + ", i32 0, i32 0\n");
                                sb_.append("  store ptr " + iv + ", ptr " + d0 + "\n");
                            }
                        }
                        continue;
                    }
                    // 局部变量用唯一 SSA 名（同函数内同名变量/循环变量不冲突，
                    // 遮蔽由 varAlloca 的 last-match 解析）
                    int isArc = isArcType(rvt);
                    string va = "";
                    // 所有局部变量（ARC 与非 ARC）的 alloca 都提升到 entry 块：
                    // 循环体内声明局部变量时，inline alloca 是动态 alloca，每次
                    // 迭代都会压低栈指针且永不恢复（-O0），循环次数多时栈无限增长
                    // → 64KB 协程栈溢出（coro_wait_compact N=50000 崩溃）。同
                    // C++ createEntryBlockAlloca。
                    va = entryAlloca(lt);
                    localNames_.add(v.name());
                    localTypes_.add(lt);
                    localAstTypes_.add(rvt);
                    localAllocas_.add(va);
                    localIsArc_.add(isArc);
                    // 记录数组/slice 元素类型（下标 GEP / extractvalue 用）
                    string elemLt = "";
                    int isSlice = 0;
                    if (rvt != null) {
                        AstType elt = rvt.element();
                        if (elt != null) elemLt = llvmType(elt);
                        else if (rvt.className() == "slice") {
                            elemLt = sliceElemType(rvt);
                            isSlice = 1;
                        }
                    }
                    localElemTypes_.add(elemLt);
                    localIsSlice_.add(isSlice);
                    if (isSlice != 0) {
                        // slice<T> 值类型 {ptr,i64}：拥有槽，作用域退出释放 backing。
                        sliceSlotNames_.add(va);
                        sb_.append("  store { ptr, i64 } zeroinitializer, ptr " + va + "\n");
                        if (v.init() != null) {
                            string iv = genExpr(v.init());
                            string it = exprLlvmType(v.init());
                            iv = convertValue(iv, it, "{ ptr, i64 }");
                            // 别名拷贝须 retain backing；fresh（new slice/call）转移 rc=1
                            if (isFreshSliceExpr(v.init()) == 0) {
                                string fd = newTmp();
                                sb_.append("  " + fd + " = extractvalue { ptr, i64 } " + iv + ", 0\n");
                                sb_.append("  call void @myp_retain(ptr " + fd + ")\n");
                            }
                            sb_.append("  store { ptr, i64 } " + iv + ", ptr " + va + ", align " + al + "\n");
                        }
                        continue;
                    }
                    if (isArc != 0) {
                        // 引用局部（string/类/动态数组）：拥有槽，函数末释放
                        arcSlotNames_.add(va);
                        sb_.append("  store ptr null, ptr " + va + "\n");
                        if (v.init() != null) {
                            string iv = genExpr(v.init());
                            string it = exprLlvmType(v.init());
                            iv = convertValue(iv, it, "ptr");
                            storeNew(va, iv, isFreshTemp(iv));
                            // §五-1 收尾: class/string 局部镜像进协程帧（destroy/异常释放）
                            if (isCoroFrameTrackedDecl(rvt) != 0) {
                                string cv = newTmp();
                                sb_.append("  " + cv + " = load ptr, ptr " + va + "\n");
                                emitCoroFrameSet(va, cv);
                            }
                            // mapping 实例全局：new Cls() 存进 __myp_inst_Cls / __myp_inst_<var>
                            if (v.init().kind() == "New") {
                                string cn = v.init().className();
                                if (Str.len(v.init().resolvedClass()) != 0) cn = v.init().resolvedClass();
                                string gname = "";
                                if (hasInstanceGlobal(cn) != 0) gname = cn;
                                else if (hasInstanceGlobal(v.name()) != 0) gname = v.name();
                                if (Str.len(gname) != 0) {
                                    string loaded = newTmp();
                                    sb_.append("  " + loaded + " = load ptr, ptr " + va + "\n");
                                    sb_.append("  store ptr " + loaded + ", ptr @__myp_inst_" + gname + "\n");
                                }
                            }
                        }
                    } else {
                        sb_.append("  store " + lt + " " + IrEmit.zeroValue(lt) + ", ptr " + va + ", align " + al + "\n");
                        if (v.init() != null) {
                            string iv = genExpr(v.init());
                            string it = exprLlvmType(v.init());
                            iv = convertExpr(iv, it, lt, v.init());
                            sb_.append("  store " + lt + " " + iv + ", ptr " + va + ", align " + al + "\n");
                        }
                    }
                }
            } else if (k == "ExprStmt") {
                if (st.expr() != null) genExpr(st.expr());
            } else if (k == "MappingStmt") {
                // 语句内 mapping()（函数体内）：handler 注册在当前函数体，
                // 函数退出 @scope 自动解注册。
                if (st.mappingDecl() != null) genMappingStmtLocal(st.mappingDecl());
            } else if (k == "Await") {
                // await expr;（语句形式，丢弃值）
                genAwaitCore(st.expr(), st.timeout());
            } else if (k == "Return") {
                // try-with-finally 内 return → 存值、flag=2、先跑 finally
                if (finallyStack_.size() > 0 && finallyStack_.get(finallyStack_.size() - 1).inFinally() == 0) {
                    if (st.value() != null) {
                        string v = genExpr(st.value());
                        string vt = exprLlvmType(st.value());
                        v = convertExpr(v, vt, curRetLt_, st.value());
                        if (curRetLt_ == "ptr") {
                            if (isFreshTemp(v) != 0) consumeTemp(v);
                            else sb_.append("  call void @myp_retain(ptr " + v + ")\n");
                        }
                        if (Str.len(finallyRetSlot_) == 0) {
                            finallyRetSlot_ = newTmp();
                            sb_.append("  " + finallyRetSlot_ + " = alloca " + curRetLt_ + ", align 8\n");
                        }
                        sb_.append("  store " + curRetLt_ + " " + v + ", ptr " + finallyRetSlot_ + "\n");
                    }
                    flushTemps();
                    FinallyCtx fcx = finallyStack_.get(finallyStack_.size() - 1);
                    sb_.append("  store i8 2, ptr " + fcx.flagSlot() + "\n");
                    emitBr(fcx.finallyB());
                    return;
                }
                if (isMainFunc_ != 0) {
                    // 停止 + 销毁全部 @thread 句柄（先于 event_process_all/free_all）
                    for (int hi = 0; hi < threadHandles_.size(); hi = hi + 1) {
                        string t = newTmp();
                        sb_.append("  " + t + " = load ptr, ptr " + threadHandles_.get(hi) + "\n");
                        sb_.append("  call void @myp_thread_stop(ptr " + t + ")\n");
                    }
                    for (int hi = 0; hi < threadHandles_.size(); hi = hi + 1) {
                        string t = newTmp();
                        sb_.append("  " + t + " = load ptr, ptr " + threadHandles_.get(hi) + "\n");
                        sb_.append("  call void @myp_thread_destroy(ptr " + t + ")\n");
                    }
                    sb_.append("  call void @myp_event_process_all()\n");
                    sb_.append("  call void @myp_free_all()\n");
                }
                if (st.value() != null) {
                    string v = genExpr(st.value());
                    string vt = exprLlvmType(st.value());
                    v = convertExpr(v, vt, curRetLt_, st.value());
                    // ARC：返回引用值——fresh 转移 +1，否则 retain（调用方取得引用）
                    if (curRetLt_ == "ptr") {
                        if (isFreshTemp(v) != 0) consumeTemp(v);
                        else sb_.append("  call void @myp_retain(ptr " + v + ")\n");
                    } else if (curRetLt_ == "{ ptr, i64 }") {
                        // slice 返回：fresh 转移 rc=1，否则 retain backing（同 C++）
                        if (isFreshSliceExpr(st.value()) == 0) {
                            string sd = newTmp();
                            sb_.append("  " + sd + " = extractvalue { ptr, i64 } " + v + ", 0\n");
                            sb_.append("  call void @myp_retain(ptr " + sd + ")\n");
                        }
                    }
                    // @coro 方法：return 值存入协程结果槽（Coro.result 可取）
                    if (curFnCoro_ != 0 && curRetLt_ != "void") {
                        string sv = castToI64(v, curRetLt_);
                        sb_.append("  call void @__myp_coro_set_result(i64 " + sv + ")\n");
                    }
                    emitRegionExit();
                    flushTemps();
                    sb_.append("  ret " + curRetLt_ + " " + v + "\n");
                } else {
                    emitRegionExit();
                    flushTemps();
                    sb_.append("  ret void\n");
                }
                terminated_ = 1;
            } else if (k == "If") {
                if (st.condition() != null) {
                    int cbefore = pendingTemps_.size();
                    string cond = toI1(genExpr(st.condition()), exprLlvmType(st.condition()));
                    flushTempsFrom(cbefore);
                    string thenB = newBlock("then");
                    string elseB = newBlock("else");
                    string endB = newBlock("ifcont");
                    int hasElse = 0;
                    if (st.elseBranch() != null) hasElse = 1;
                    sb_.append("  br i1 " + cond + ", label %" + thenB + ", label %" + (hasElse != 0 ? elseB : endB) + "\n");
                    terminated_ = 1;
                    openBlock(thenB);
                    genStmt(st.then());
                    if (terminated_ == 0) emitBr(endB);
                    if (hasElse != 0) {
                        openBlock(elseB);
                        genStmt(st.elseBranch());
                        if (terminated_ == 0) emitBr(endB);
                    }
                    openBlock(endB);
                }
            } else if (k == "While") {
                string condB = newBlock("while_cond");
                string bodyB = newBlock("while_body");
                string endB = newBlock("while_end");
                emitBr(condB);
                openBlock(condB);
                loopBreak_.add(endB);
                loopContinue_.add(condB);
                if (st.condition() != null) {
                    int cbefore = pendingTemps_.size();
                    string cond = toI1(genExpr(st.condition()), exprLlvmType(st.condition()));
                    flushTempsFrom(cbefore);
                    sb_.append("  br i1 " + cond + ", label %" + bodyB + ", label %" + endB + "\n");
                    terminated_ = 1;
                } else {
                    emitBr(bodyB);
                }
                openBlock(bodyB);
                genStmt(st.body());
                if (terminated_ == 0) emitBr(condB);
                loopBreak_.remove(loopBreak_.size() - 1);
                loopContinue_.remove(loopContinue_.size() - 1);
                openBlock(endB);
            } else if (k == "For") {
                // @parallel for：数据并行（生成并行 body 函数 + myp_pool_parallel_for）。
                // 无法并行化（非规范 for 形态）时回退串行。
                if (st.parallel() != 0 && canParallelizeFor(st) != 0) {
                    genParallelFor(st);
                    return;
                }
                if (st.init() != null) genStmt(st.init());
                string condB = newBlock("for_cond");
                string bodyB = newBlock("for_body");
                string stepB = newBlock("for_step");
                string endB = newBlock("for_end");
                emitBr(condB);
                openBlock(condB);
                if (st.condition() != null) {
                    int cbefore = pendingTemps_.size();
                    string cond = toI1(genExpr(st.condition()), exprLlvmType(st.condition()));
                    flushTempsFrom(cbefore);
                    sb_.append("  br i1 " + cond + ", label %" + bodyB + ", label %" + endB + "\n");
                    terminated_ = 1;
                } else {
                    emitBr(bodyB);
                }
                openBlock(bodyB);
                loopBreak_.add(endB);
                loopContinue_.add(stepB);
                genStmt(st.body());
                if (terminated_ == 0) emitBr(stepB);
                loopBreak_.remove(loopBreak_.size() - 1);
                loopContinue_.remove(loopContinue_.size() - 1);
                openBlock(stepB);
                if (st.step() != null) genExpr(st.step());
                emitBr(condB);
                openBlock(endB);
            } else if (k == "Break") {
                // try-with-finally 内 break → flag=3、先跑 finally
                if (finallyStack_.size() > 0 && finallyStack_.get(finallyStack_.size() - 1).inFinally() == 0) {
                    FinallyCtx fcx = finallyStack_.get(finallyStack_.size() - 1);
                    sb_.append("  store i8 3, ptr " + fcx.flagSlot() + "\n");
                    emitBr(fcx.finallyB());
                    return;
                }
                if (loopBreak_.size() > 0) emitBr(loopBreak_.get(loopBreak_.size() - 1));
            } else if (k == "Continue") {
                // try-with-finally 内 continue → flag=4、先跑 finally
                if (finallyStack_.size() > 0 && finallyStack_.get(finallyStack_.size() - 1).inFinally() == 0) {
                    FinallyCtx fcx = finallyStack_.get(finallyStack_.size() - 1);
                    sb_.append("  store i8 4, ptr " + fcx.flagSlot() + "\n");
                    emitBr(fcx.finallyB());
                    return;
                }
                if (loopContinue_.size() > 0) emitBr(loopContinue_.get(loopContinue_.size() - 1));
            } else if (k == "ForIn") {
                genForIn(st);
            } else if (k == "Destructure") {
                genDestructure(st);
            } else if (k == "Match") {
                genMatchStmt(st);
            } else if (k == "Try") {
                genTryStmt(st);
            } else if (k == "Throw") {
                genThrowStmt(st);
            }
            // 其余（GpuTile 等）留 G3。
            // ARC：语句末释放未消费的 fresh temp（new/调用/拼接）。
            flushTemps();
        }

        // ForIn：定长数组（iterKind=1）与 range（iterKind=3）；class/slice 留 G3。
        void genForIn(AstStmt st) {
            int ik = st.iterKind();
            string varName = st.varName();
            AstType varT = st.varType();
            string elemLt = llvmType(varT);
            AstExpr coll = st.iterable();
            string collV = genExpr(coll);
            string collT = exprLlvmType(coll);
            string collA = newTmp() + ".coll";
            sb_.append("  " + collA + " = alloca " + collT + "\n");
            sb_.append("  store " + collT + " " + collV + ", ptr " + collA + "\n");
            // 上界
            string sizeV = "0";
            if (ik == 1) {
                sizeV = "" + st.arrSize();
            } else if (ik == 2) {
                // slice：extractvalue len
                string collL = newTmp();
                sb_.append("  " + collL + " = load " + collT + ", ptr " + collA + "\n");
                string len64 = newTmp();
                sb_.append("  " + len64 + " = extractvalue { ptr, i64 } " + collL + ", 1\n");
                string ti = newTmp();
                sb_.append("  " + ti + " = trunc i64 " + len64 + " to i32\n");
                sizeV = ti;
            } else if (ik == 3) {
                AstExpr re = coll;
                AstExpr rEnd = re.end();
                AstExpr rStart = re.start();
                string ev = genExpr(rEnd);
                string et = exprLlvmType(rEnd);
                string sv = genExpr(rStart);
                string stt = exprLlvmType(rStart);
                ev = convertValue(ev, et, "i32");
                sv = convertValue(sv, stt, "i32");
                string ts = newTmp();
                sb_.append("  " + ts + " = sub i32 " + ev + ", " + sv + "\n");
                sizeV = ts;
            }
            string idxA = newTmp() + ".i";
            sb_.append("  " + idxA + " = alloca i32\n");
            sb_.append("  store i32 0, ptr " + idxA + "\n");
            // 循环变量用唯一 SSA 名（同函数内多个 for-in 同名变量不冲突）
            string varA = newTmp();
            int al = IrEmit.alignOf(elemLt);
            sb_.append("  " + varA + " = alloca " + elemLt + ", align " + al + "\n");
            localNames_.add(varName);
            localTypes_.add(elemLt);
            localAstTypes_.add(varT);
            localAllocas_.add(varA);
            localElemTypes_.add("");
            localIsSlice_.add(0);
            localIsArc_.add(0);
            string condB = newBlock("for_cond");
            string bodyB = newBlock("for_body");
            string stepB = newBlock("for_step");
            string endB = newBlock("for_end");
            emitBr(condB);
            openBlock(condB);
            string idx0 = newTmp();
            sb_.append("  " + idx0 + " = load i32, ptr " + idxA + "\n");
            string cmp = newTmp();
            sb_.append("  " + cmp + " = icmp slt i32 " + idx0 + ", " + sizeV + "\n");
            sb_.append("  br i1 " + cmp + ", label %" + bodyB + ", label %" + endB + "\n");
            terminated_ = 1;
            openBlock(bodyB);
            string idx1 = newTmp();
            sb_.append("  " + idx1 + " = load i32, ptr " + idxA + "\n");
            string elem = "";
            if (ik == 1) {
                string collL = newTmp();
                sb_.append("  " + collL + " = load " + collT + ", ptr " + collA + "\n");
                string gep = newTmp();
                sb_.append("  " + gep + " = getelementptr " + elemLt + ", ptr " + collL + ", i32 " + idx1 + "\n");
                string el = newTmp();
                sb_.append("  " + el + " = load " + elemLt + ", ptr " + gep + "\n");
                elem = el;
            } else if (ik == 2) {
                // slice：extractvalue data + GEP
                string collL = newTmp();
                sb_.append("  " + collL + " = load " + collT + ", ptr " + collA + "\n");
                string data = newTmp();
                sb_.append("  " + data + " = extractvalue { ptr, i64 } " + collL + ", 0\n");
                string idx64 = convertValue(idx1, "i32", "i64");
                string gep = newTmp();
                sb_.append("  " + gep + " = getelementptr " + elemLt + ", ptr " + data + ", i64 " + idx64 + "\n");
                string el = newTmp();
                sb_.append("  " + el + " = load " + elemLt + ", ptr " + gep + "\n");
                elem = el;
            } else if (ik == 3) {
                AstExpr re = coll;
                AstExpr rStart = re.start();
                string sv = genExpr(rStart);
                string stt = exprLlvmType(rStart);
                sv = convertValue(sv, stt, "i32");
                string el = newTmp();
                sb_.append("  " + el + " = add i32 " + sv + ", " + idx1 + "\n");
                elem = el;
            }
            if (Str.len(elem) != 0) {
                sb_.append("  store " + elemLt + " " + elem + ", ptr " + varA + "\n");
            }
            loopBreak_.add(endB);
            loopContinue_.add(stepB);
            genStmt(st.body());
            if (terminated_ == 0) emitBr(stepB);
            loopBreak_.remove(loopBreak_.size() - 1);
            loopContinue_.remove(loopContinue_.size() - 1);
            openBlock(stepB);
            string idx2 = newTmp();
            sb_.append("  " + idx2 + " = load i32, ptr " + idxA + "\n");
            string nidx = newTmp();
            sb_.append("  " + nidx + " = add i32 " + idx2 + ", 1\n");
            sb_.append("  store i32 " + nidx + ", ptr " + idxA + "\n");
            emitBr(condB);
            openBlock(endB);
        }

        // Destructure：(A a, B b) = tuple；（a, b) = tuple —— extractvalue 解包。
        void genDestructure(AstStmt st) {
            AstExpr dv = st.value();
            if (dv == null) return;
            string tv = genExpr(dv);
            string tt = exprLlvmType(dv);
            AstDestructureTarget tgt = st.target();
            if (tgt == null) return;
            destructureWalk(tgt, tv, tt, st.isDecl());
        }

        // cls 类的 @startup action 函数名（"@Main_run"；无则 "null"）。
        string findStartupFn(string cls) {
            if (tu_ == null || Str.len(cls) == 0) return "null";
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    AstAction a = c.actions().get(ai);
                    if (a.startup() != 0) return "@" + cls + "_" + a.name();
                }
            }
            return "null";
        }

        // @thread 变量：new Cls() @thread —— 建实例、找 @startup、myp_thread_create
        // + run_loop；实例指针存入变量槽（m 仍指向实例）；线程句柄登记，main 末
        // stop/destroy（同 C++ generateVarDecl @thread 分支）。
        void genThreadVar(AstVar v, AstType rvt) {
            string inst = "null";
            if (v.init() != null) {
                inst = genExpr(v.init());
                if (isFreshTemp(inst) != 0) consumeTemp(inst);   // 线程 startup_arg 持有实例
            }
            // 实例指针存入变量槽（m 可继续用）
            string va = newTmp();
            sb_.append("  " + va + " = alloca ptr, align 8\n");
            sb_.append("  store ptr " + inst + ", ptr " + va + "\n");
            localNames_.add(v.name());
            localTypes_.add("ptr");
            localAstTypes_.add(rvt);
            localAllocas_.add(va);
            localElemTypes_.add("");
            localIsSlice_.add(0);
            localIsArc_.add(0);
            // 启动函数（@startup action）
            string startupFn = findStartupFn(rvt.className());
            // 创建线程 + 运行
            string thr = newTmp();
            sb_.append("  " + thr + " = call ptr @myp_thread_create(ptr " + startupFn + ", ptr " + inst + ")\n");
            string thrA = newTmp();
            sb_.append("  " + thrA + " = alloca ptr, align 8\n");
            sb_.append("  store ptr " + thr + ", ptr " + thrA + "\n");
            threadHandles_.add(thrA);
            sb_.append("  call void @myp_thread_associate_instance(ptr " + inst + ", ptr " + thr + ")\n");
            sb_.append("  call void @myp_thread_run_loop(ptr " + thr + ")\n");
        }

        // @threadpool 变量：Cls[N] pool @threadpool —— 分配 [N x ptr] 实例指针
        // 数组，逐个 myp_alloc_object + @startup 线程（同 C++ generateVarDecl
        // @threadpool 分支）。变量值 = 首元素地址（下标 pool[i] 走 GEP）。
        void genThreadPoolVar(AstVar v, AstType rvt) {
            AstType elem = rvt != null ? rvt.element() : null;
            string elemCls = elem != null ? elem.className() : "";
            int poolSize = rvt != null && rvt.arraySize() > 0 ? rvt.arraySize() : 4;
            if (Str.len(elemCls) == 0) return;
            string arrLt = "[" + poolSize + " x ptr]";
            string arrA = newTmp() + ".arr";
            sb_.append("  " + arrA + " = alloca " + arrLt + ", align 8\n");
            string first = newTmp();
            sb_.append("  " + first + " = getelementptr " + arrLt + ", ptr " + arrA + ", i32 0, i32 0\n");
            string va = newTmp();
            sb_.append("  " + va + " = alloca ptr, align 8\n");
            sb_.append("  store ptr " + first + ", ptr " + va + "\n");
            localNames_.add(v.name());
            localTypes_.add("ptr");
            localAstTypes_.add(rvt);
            localAllocas_.add(va);
            localElemTypes_.add("ptr");
            localIsSlice_.add(0);
            localIsArc_.add(0);
            string startupFn = findStartupFn(elemCls);
            int sz = classSize(elemCls);
            int tid = classTypeId(elemCls);
            for (int i = 0; i < poolSize; i = i + 1) {
                string obj = newTmp();
                sb_.append("  " + obj + " = call ptr @myp_alloc_object(i64 " + sz + ", i32 " + tid + ")\n");
                sb_.append("  call void @llvm.memset.p0.i64(ptr " + obj + ", i8 0, i64 " + sz + ", i1 false)\n");
                string gep = newTmp();
                sb_.append("  " + gep + " = getelementptr " + arrLt + ", ptr " + arrA + ", i32 0, i32 " + i + "\n");
                sb_.append("  store ptr " + obj + ", ptr " + gep + "\n");
                string thr = newTmp();
                sb_.append("  " + thr + " = call ptr @myp_thread_create(ptr " + startupFn + ", ptr " + obj + ")\n");
                string thrA = newTmp();
                sb_.append("  " + thrA + " = alloca ptr, align 8\n");
                sb_.append("  store ptr " + thr + ", ptr " + thrA + "\n");
                threadHandles_.add(thrA);
                sb_.append("  call void @myp_thread_associate_instance(ptr " + obj + ", ptr " + thr + ")\n");
                sb_.append("  call void @myp_thread_run_loop(ptr " + thr + ")\n");
            }
        }

        // 递归解包元组结构体。
        void destructureWalk(AstDestructureTarget tgt, string aggV, string aggT, int isDecl) {
            ArrayList<AstDestructureTarget> els = tgt.elements();
            for (int i = 0; i < els.size(); i = i + 1) {
                AstDestructureTarget c = els.get(i);
                if (c.name() == "_") continue;   // 忽略符
                string ev = newTmp();
                sb_.append("  " + ev + " = extractvalue " + aggT + " " + aggV + ", " + i + "\n");
                string et = structElemType(aggT, i);
                if (c.elements().size() != 0) {
                    // 嵌套元组
                    destructureWalk(c, ev, et, isDecl);
                    continue;
                }
                string lt = et;
                if (c.hasType() != 0 && c.type() != null) lt = llvmType(c.type());
                string conv = convertValue(ev, et, lt);
                if (isDecl != 0) {
                    string va = newTmp();
                    int al = IrEmit.alignOf(lt);
                    sb_.append("  " + va + " = alloca " + lt + ", align " + al + "\n");
                    localNames_.add(c.name());
                    localTypes_.add(lt);
                    localAstTypes_.add(c.type());
                    localAllocas_.add(va);
                    localElemTypes_.add("");
                    localIsSlice_.add(0);
                    localIsArc_.add(isArcType(c.type()));
                    if (lt == "ptr" && isArcType(c.type()) != 0) {
                        sb_.append("  store ptr null, ptr " + va + "\n");
                        storeRef(va, conv, isFreshTemp(conv));
                    } else {
                        sb_.append("  store " + lt + " " + conv + ", ptr " + va + "\n");
                    }
                } else {
                    // 赋值到已有变量
                    string dst = varAlloca(c.name());
                    string oldT = varType(c.name());
                    string conv2 = convertValue(ev, et, oldT);
                    if (varIsArc(c.name()) != 0) storeRef(dst, conv2, isFreshTemp(conv2));
                    else sb_.append("  store " + oldT + " " + conv2 + ", ptr " + dst + "\n");
                }
            }
        }

        // longjmp 到当前最内层 handler（throw 传播出本函数 / rethrow）。
        void emitLongjmpOuter() {
            string jb = newTmp();
            sb_.append("  " + jb + " = call ptr @myp_exception_get_jmpbuf()\n");
            sb_.append("  call void @__myp_longjmp(ptr " + jb + ", i32 1)\n");
            sb_.append("  unreachable\n");
            terminated_ = 1;
        }

        // throw 语句：throw "msg"（string）/ throw;（rethrow）/ throw obj（类）。
        void genThrowStmt(AstStmt st) {
            string tt = st.throwType();
            if (tt == "rethrow") {
                // throw; 在 try-with-finally 内 → flag=1 先跑 finally 再向外重抛
                //（catch 入口对 hasFinally 不 pop，直接 longjmp 会重入本 handler 死循环）
                if (finallyStack_.size() > 0 && finallyStack_.get(finallyStack_.size() - 1).inFinally() == 0) {
                    FinallyCtx fc = finallyStack_.get(finallyStack_.size() - 1);
                    sb_.append("  store i8 1, ptr " + fc.flagSlot() + "\n");
                    emitBr(fc.finallyB());
                    return;
                }
                emitLongjmpOuter();
                return;
            }
            if (tt == "string") {
                string msg = genExpr(st.expr());
                sb_.append("  call void @myp_throw(ptr " + msg + ")\n");
                // myp_throw 已拷贝消息；释放本语句 fresh temp（字符串字面量等）。
                flushTemps();
                // 释放本 try 内已废弃的 ARC 局部（C++ emitUnwindRelease）；
                // 无同函数 try 时释放全部（异常离开函数）。
                if (tryArcBases_.size() > 0) {
                    releaseArcSlotsFrom(tryArcBases_.get(tryArcBases_.size() - 1));
                } else {
                    releaseArcSlots();
                }
                emitLongjmpOuter();
                return;
            }
            // 类异常：myp_throw_object(obj, tid)。异常取得独立引用——
            // fresh 转移 +1，别名 retain（同 C++ generateThrowStmt）。
            int tid = classTypeId(tt);
            string obj = genExpr(st.expr());
            if (isFreshTemp(obj) != 0) {
                consumeTemp(obj);
            } else {
                sb_.append("  call void @myp_retain(ptr " + obj + ")\n");
            }
            sb_.append("  call void @myp_throw_object(ptr " + obj + ", i32 " + tid + ")\n");
            flushTemps();
            // 释放本 try 内已废弃的 ARC 局部（C++ emitUnwindRelease）。
            if (tryArcBases_.size() > 0) {
                releaseArcSlotsFrom(tryArcBases_.get(tryArcBases_.size() - 1));
            } else {
                releaseArcSlots();
            }
            emitLongjmpOuter();
        }

        // try / catch / finally：setjmp + handler 栈 + 类型分发（string 版）。
        // 返回/break/continue 穿越 finally 的转发（C++ finally_ctx 模式）留 G3。
        void genTryStmt(AstStmt st) {
            int hasCatch = st.catches().size() > 0 ? 1 : 0;
            int hasFinally = st.finallyBlock() != null ? 1 : 0;
            // per-try jmp_buf + finally 标志（inline alloca，setjmp 前；SP 在
            // setjmp 点之下，longjmp 恢复后仍有效）。
            string jb = newTmp();
            sb_.append("  " + jb + " = alloca %myp_jmp_buf, align 8\n");
            string flagA = "";
            if (hasFinally != 0) {
                flagA = newTmp();
                sb_.append("  " + flagA + " = alloca i8, align 1\n");
            }
            sb_.append("  call void @myp_exception_push(ptr " + jb + ")\n");
            string r = newTmp();
            sb_.append("  " + r + " = call i32 @setjmp(ptr " + jb + ")\n");
            string isErr = newTmp();
            sb_.append("  " + isErr + " = icmp ne i32 " + r + ", 0\n");

            string tryB = newBlock("try_block");
            string dispatchB = hasCatch != 0 ? newBlock("catch_dispatch") : "";
            string propagateB = "";
            string finallyB = hasFinally != 0 ? newBlock("finally_block") : "";
            string mergeB = newBlock("try_end");
            string rethrowB = "";

            if (hasCatch != 0) {
                sb_.append("  br i1 " + isErr + ", label %" + dispatchB + ", label %" + tryB + "\n");
                terminated_ = 1;
            } else if (hasFinally != 0) {
                propagateB = newBlock("try_propagate");
                sb_.append("  br i1 " + isErr + ", label %" + propagateB + ", label %" + tryB + "\n");
                terminated_ = 1;
            } else {
                sb_.append("  br i1 " + isErr + ", label %" + mergeB + ", label %" + tryB + "\n");
                terminated_ = 1;
            }

            // === 建立 finally 控制流上下文（return/break/continue 转发）===
            if (hasFinally != 0) {
                FinallyCtx fc = new FinallyCtx();
                fc.setFlagSlot(flagA);
                fc.setFinallyB(finallyB);
                fc.setMergeB(mergeB);
                if (finallyStack_.size() > 0) {
                    FinallyCtx outer = finallyStack_.get(finallyStack_.size() - 1);
                    fc.setOuterFinallyB(outer.finallyB());
                    fc.setOuterFlagSlot(outer.flagSlot());
                }
                if (loopBreak_.size() > 0) fc.setBreakB(loopBreak_.get(loopBreak_.size() - 1));
                if (loopContinue_.size() > 0) fc.setContinueB(loopContinue_.get(loopContinue_.size() - 1));
                finallyStack_.add(fc);
            }

            // === try 块 ===
            int tryArcBase = arcSlotNames_.size();
            tryArcBases_.add(tryArcBase);
            openBlock(tryB);
            genStmt(st.tryBlock());
            if (terminated_ == 0) {
                if (hasFinally != 0) {
                    sb_.append("  store i8 0, ptr " + flagA + "\n");
                    emitBr(finallyB);
                } else {
                    sb_.append("  call void @myp_exception_pop()\n");
                    emitBr(mergeB);
                }
            }

            // === catch 类型分发 ===
            if (hasCatch != 0) {
                openBlock(dispatchB);
                string etype = newTmp();
                sb_.append("  " + etype + " = call i32 @myp_exception_get_type()\n");
                string nomatch = "";
                if (hasFinally != 0) {
                    if (Str.len(propagateB) == 0) propagateB = newBlock("try_propagate");
                    nomatch = propagateB;
                } else {
                    rethrowB = newBlock("catch_rethrow");
                    nomatch = rethrowB;
                }
                int n = st.catches().size();
                int ncls = classTypeCount();
                for (int i = 0; i < n; i = i + 1) {
                    AstCatch cc = st.catches().get(i);
                    string catchB = newBlock("catch_" + i);
                    string nxt = "";
                    if (i + 1 < n) nxt = newBlock("catch_chk_" + (i + 1));
                    else nxt = nomatch;
                    // 类型匹配：string → type 0；类 → type_id；接口 → error_vtables[etype]
                    string cty = cc.type();
                    if (Str.len(cty) == 0) cty = "string";
                    if (cty == "string") {
                        string m = newTmp();
                        sb_.append("  " + m + " = icmp eq i32 " + etype + ", 0\n");
                        sb_.append("  br i1 " + m + ", label %" + catchB + ", label %" + nxt + "\n");
                    } else if (classTypeId(cty) > 0) {
                        string m = newTmp();
                        sb_.append("  " + m + " = icmp eq i32 " + etype + ", " + classTypeId(cty) + "\n");
                        sb_.append("  br i1 " + m + ", label %" + catchB + ", label %" + nxt + "\n");
                    } else if (isInterfaceName(cty) != 0) {
                        // 接口 catch：__myp_error_vtables[etype] != null
                        string idx = newTmp();
                        sb_.append("  " + idx + " = sext i32 " + etype + " to i64\n");
                        string gep = newTmp();
                        sb_.append("  " + gep + " = getelementptr [" + (ncls + 1) + " x ptr], ptr @__myp_error_vtables, i64 0, i64 " + idx + "\n");
                        string vt = newTmp();
                        sb_.append("  " + vt + " = load ptr, ptr " + gep + "\n");
                        string m = newTmp();
                        sb_.append("  " + m + " = icmp ne ptr " + vt + ", null\n");
                        sb_.append("  br i1 " + m + ", label %" + catchB + ", label %" + nxt + "\n");
                    } else {
                        sb_.append("  br label %" + nxt + "\n");
                    }
                    terminated_ = 1;
                    // catch 体
                    openBlock(catchB);
                    if (hasFinally == 0) {
                        sb_.append("  call void @myp_exception_pop()\n");
                    }
                    int catchArcBase = arcSlotNames_.size();
                    bindCatchVar(cc);
                    genStmt(cc.block());
                    if (terminated_ == 0) {
                        // 正常 catch 结束：catch 取得异常对象的引用，此处释放
                        //（C++ caught_slot 释放；rethrow/return 死路径跳过）。
                        releaseArcSlotsFrom(catchArcBase);
                        if (hasFinally != 0) {
                            sb_.append("  store i8 0, ptr " + flagA + "\n");
                            emitBr(finallyB);
                        } else {
                            emitBr(mergeB);
                        }
                    }
                    if (i + 1 < n) openBlock(nxt);
                }
            }

            // === 无匹配 catch 的传播（带 finally）===
            if (Str.len(propagateB) != 0) {
                openBlock(propagateB);
                sb_.append("  store i8 1, ptr " + flagA + "\n");
                emitBr(finallyB);
            }

            // === finally 块（5 模式分发：0 merge / 1 rethrow / 2 return / 3 break / 4 continue）===
            if (hasFinally != 0) {
                FinallyCtx fc = finallyStack_.get(finallyStack_.size() - 1);
                fc.setInFinally(1);
                openBlock(finallyB);
                sb_.append("  call void @myp_exception_pop()\n");
                genStmt(st.finallyBlock());
                fc.setInFinally(0);
                if (terminated_ == 0) {
                    string flag = newTmp();
                    sb_.append("  " + flag + " = load i8, ptr " + flagA + "\n");
                    string finMerge = newBlock("fin_merge");
                    string finRet = newBlock("fin_ret");
                    string finBreak = newBlock("fin_break");
                    string finCont = newBlock("fin_cont");
                    if (Str.len(rethrowB) == 0) rethrowB = newBlock("catch_rethrow");
                    string c0 = newTmp();
                    sb_.append("  " + c0 + " = icmp eq i8 " + flag + ", 0\n");
                    string chk1 = newBlock("fin_chk1");
                    sb_.append("  br i1 " + c0 + ", label %" + finMerge + ", label %" + chk1 + "\n");
                    terminated_ = 1;
                    openBlock(chk1);
                    string c1 = newTmp();
                    sb_.append("  " + c1 + " = icmp eq i8 " + flag + ", 1\n");
                    string chk2 = newBlock("fin_chk2");
                    sb_.append("  br i1 " + c1 + ", label %" + rethrowB + ", label %" + chk2 + "\n");
                    terminated_ = 1;
                    openBlock(chk2);
                    string c2 = newTmp();
                    sb_.append("  " + c2 + " = icmp eq i8 " + flag + ", 2\n");
                    string chk3 = newBlock("fin_chk3");
                    sb_.append("  br i1 " + c2 + ", label %" + finRet + ", label %" + chk3 + "\n");
                    terminated_ = 1;
                    openBlock(chk3);
                    string c3 = newTmp();
                    sb_.append("  " + c3 + " = icmp eq i8 " + flag + ", 3\n");
                    sb_.append("  br i1 " + c3 + ", label %" + finBreak + ", label %" + finCont + "\n");
                    terminated_ = 1;
                    // mode 0 → 正常结束
                    openBlock(finMerge);
                    emitBr(mergeB);
                    // mode 2 → return（先转发外层 finally）
                    openBlock(finRet);
                    if (Str.len(fc.outerFinallyB()) != 0) {
                        sb_.append("  store i8 2, ptr " + fc.outerFlagSlot() + "\n");
                        emitBr(fc.outerFinallyB());
                    } else if (Str.len(finallyRetSlot_) != 0) {
                        string rv = newTmp();
                        sb_.append("  " + rv + " = load " + curRetLt_ + ", ptr " + finallyRetSlot_ + "\n");
                        sb_.append("  ret " + curRetLt_ + " " + rv + "\n");
                        terminated_ = 1;
                    } else if (curRetLt_ == "void") {
                        sb_.append("  ret void\n");
                        terminated_ = 1;
                    } else {
                        sb_.append("  unreachable\n");
                        terminated_ = 1;
                    }
                    // mode 3 → break（先转发外层 finally）
                    openBlock(finBreak);
                    if (Str.len(fc.outerFinallyB()) != 0) {
                        sb_.append("  store i8 3, ptr " + fc.outerFlagSlot() + "\n");
                        emitBr(fc.outerFinallyB());
                    } else if (Str.len(fc.breakB()) != 0) {
                        emitBr(fc.breakB());
                    } else {
                        emitBr(mergeB);
                    }
                    // mode 4 → continue（先转发外层 finally）
                    openBlock(finCont);
                    if (Str.len(fc.outerFinallyB()) != 0) {
                        sb_.append("  store i8 4, ptr " + fc.outerFlagSlot() + "\n");
                        emitBr(fc.outerFinallyB());
                    } else if (Str.len(fc.continueB()) != 0) {
                        emitBr(fc.continueB());
                    } else {
                        emitBr(mergeB);
                    }
                }
                finallyStack_.remove(finallyStack_.size() - 1);
            }

            // === rethrow：无 finally 时 pop 本 handler 后 longjmp 外层 ===
            if (Str.len(rethrowB) != 0) {
                openBlock(rethrowB);
                if (hasFinally == 0) {
                    sb_.append("  call void @myp_exception_pop()\n");
                }
                emitLongjmpOuter();
            }

            openBlock(mergeB);
            if (tryArcBases_.size() > 0) tryArcBases_.remove(tryArcBases_.size() - 1);
        }

        // 绑定 catch 变量：string → myp_get_error + strdup；类 → myp_exception_get_object；
        // 接口 → fat pointer { data=object, vtable=error_vtables[type] }。
        void bindCatchVar(AstCatch cc) {
            if (Str.len(cc.varName()) == 0) return;
            string cty = cc.type();
            if (Str.len(cty) == 0) cty = "string";
            if (cty == "string") {
                string err = newTmp();
                sb_.append("  " + err + " = call ptr @myp_get_error()\n");
                string dup = newTmp();
                sb_.append("  " + dup + " = call ptr @myp_strdup(ptr " + err + ")\n");
                string ev = entryAlloca("ptr");
                sb_.append("  store ptr null, ptr " + ev + "\n");
                sb_.append("  store ptr " + dup + ", ptr " + ev + "\n");
                localNames_.add(cc.varName());
                localTypes_.add("ptr");
                localAstTypes_.add(null);
                localAllocas_.add(ev);
                localElemTypes_.add("");
                localIsSlice_.add(0);
                localIsArc_.add(1);
                arcSlotNames_.add(ev);
                return;
            }
            if (isInterfaceName(cty) != 0) {
                // 接口 catch：fat pointer { data, vtable }
                int ncls = classTypeCount();
                string obj = newTmp();
                sb_.append("  " + obj + " = call ptr @myp_exception_get_object()\n");
                string et2 = newTmp();
                sb_.append("  " + et2 + " = call i32 @myp_exception_get_type()\n");
                string idx = newTmp();
                sb_.append("  " + idx + " = sext i32 " + et2 + " to i64\n");
                string gep = newTmp();
                sb_.append("  " + gep + " = getelementptr [" + (ncls + 1) + " x ptr], ptr @__myp_error_vtables, i64 0, i64 " + idx + "\n");
                string vt = newTmp();
                sb_.append("  " + vt + " = load ptr, ptr " + gep + "\n");
                string ev = entryAlloca("{ ptr, ptr }");
                string dp = newTmp();
                sb_.append("  " + dp + " = getelementptr { ptr, ptr }, ptr " + ev + ", i32 0, i32 0\n");
                sb_.append("  store ptr " + obj + ", ptr " + dp + "\n");
                string vp = newTmp();
                sb_.append("  " + vp + " = getelementptr { ptr, ptr }, ptr " + ev + ", i32 0, i32 1\n");
                sb_.append("  store ptr " + vt + ", ptr " + vp + "\n");
                localNames_.add(cc.varName());
                localTypes_.add("{ ptr, ptr }");
                localAstTypes_.add(ifaceAstType(cty));
                localAllocas_.add(ev);
                localElemTypes_.add("");
                localIsSlice_.add(0);
                localIsArc_.add(1);
                arcSlotNames_.add(ev);
                return;
            }
            // 类实例：异常载体持有的引用转移到 catch 槽
            string bound = newTmp();
            sb_.append("  " + bound + " = call ptr @myp_exception_get_object()\n");
            string ev2 = entryAlloca("ptr");
            sb_.append("  store ptr null, ptr " + ev2 + "\n");
            sb_.append("  store ptr " + bound + ", ptr " + ev2 + "\n");
            localNames_.add(cc.varName());
            localTypes_.add("ptr");
            localAstTypes_.add(null);
            localAllocas_.add(ev2);
            localElemTypes_.add("");
            localIsSlice_.add(0);
            localIsArc_.add(1);
            arcSlotNames_.add(ev2);
        }

        // 接口方法调用：obj 是 { data, vtable } 胖指针 → extract data/vtable，
        // GEP vtable[methodIndex] 取函数指针后间接调用（this= data）。
        string genIfaceCall(AstExpr obj, string ifaceName, string mname, AstExpr call) {
            int midx = interfaceMethodIndex(ifaceName, mname);
            string objV = genExpr(obj);
            string data = newTmp();
            sb_.append("  " + data + " = extractvalue { ptr, ptr } " + objV + ", 0\n");
            string vt = newTmp();
            sb_.append("  " + vt + " = extractvalue { ptr, ptr } " + objV + ", 1\n");
            string fp = newTmp();
            sb_.append("  " + fp + " = getelementptr ptr, ptr " + vt + ", i32 " + midx + "\n");
            string fnv = newTmp();
            sb_.append("  " + fnv + " = load ptr, ptr " + fp + "\n");
            string retLt = exprLlvmType(call);
            StringBuilder as = new StringBuilder();
            as.append("ptr " + data);
            for (int i = 0; i < call.args().size(); i = i + 1) {
                AstExpr a = call.args().get(i);
                string av = genExpr(a);
                string at = exprLlvmType(a);
                as.append(", " + at + " " + av);
            }
            if (retLt == "void") {
                sb_.append("  call void " + fnv + "(" + as.toString() + ")\n");
                return "";
            }
            string t = newTmp();
            sb_.append("  " + t + " = call " + retLt + " " + fnv + "(" + as.toString() + ")\n");
            if (retLt == "ptr") addFreshTemp(t);
            return t;
        }

        // 枚举变体构造：Option.Some(42) / Color.Red → { i32 disc, [N x i8] payload }。
        string genEnumVariant(string enumName, string variantName, AstExpr call) {
            int vi = enumVariantIndex(enumName, variantName);
            string st = enumLlvmType(enumName);
            string agg = "poison";
            string d1 = newTmp();
            sb_.append("  " + d1 + " = insertvalue " + st + " " + agg + ", i32 " + vi + ", 0\n");
            agg = d1;
            if (call.args().size() > 0) {
                int maxp = enumMaxPayload(enumName);
                string buf = newTmp();
                sb_.append("  " + buf + " = alloca [" + maxp + " x i8]\n");
                for (int ai = 0; ai < call.args().size(); ai = ai + 1) {
                    AstExpr a = call.args().get(ai);
                    string av = genExpr(a);
                    string at = exprLlvmType(a);
                    int off = enumPayloadOffset(enumName, vi, ai);
                    string gep = newTmp();
                    sb_.append("  " + gep + " = getelementptr i8, ptr " + buf + ", i32 " + off + "\n");
                    sb_.append("  store " + at + " " + av + ", ptr " + gep + "\n");
                }
                string payload = newTmp();
                sb_.append("  " + payload + " = load [" + maxp + " x i8], ptr " + buf + "\n");
                string d2 = newTmp();
                sb_.append("  " + d2 + " = insertvalue " + st + " " + agg + ", [" + maxp + " x i8] " + payload + ", 1\n");
                agg = d2;
            }
            return agg;
        }

        // match (subject) { Enum.Variant(a,b) => {...} ... }：extract disc + 链式
        // icmp 分发 + 载荷字段解包绑定（C++ generateMatchStmt）。
        void genMatchStmt(AstStmt s) {
            if (s.subject() == null) return;
            string subjectV = genExpr(s.subject());
            string subjectT = exprLlvmType(s.subject());
            string enumName = "";
            if (s.arms().size() > 0) enumName = s.arms().get(0).enumName();
            // 判别式（元素 0）
            string disc = newTmp();
            sb_.append("  " + disc + " = extractvalue " + subjectT + " " + subjectV + ", 0\n");
            int n = s.arms().size();
            if (n == 0) return;
            string mergeB = newBlock("match_end");
            string chkB = newBlock("match_check_0");
            emitBr(chkB);
            for (int i = 0; i < n; i = i + 1) {
                AstMatchArm arm = s.arms().get(i);
                openBlock(chkB);
                string cmp = newTmp();
                sb_.append("  " + cmp + " = icmp eq i32 " + disc + ", " + arm.index() + "\n");
                string armB = newBlock("match_arm" + i);
                string nxt = "";
                if (i + 1 < n) nxt = newBlock("match_check" + (i + 1));
                else nxt = mergeB;
                sb_.append("  br i1 " + cmp + ", label %" + armB + ", label %" + nxt + "\n");
                terminated_ = 1;
                openBlock(armB);
                // 载荷解包绑定
                if (arm.bindings().size() > 0) {
                    string subjA = newTmp();
                    sb_.append("  " + subjA + " = alloca " + subjectT + "\n");
                    sb_.append("  store " + subjectT + " " + subjectV + ", ptr " + subjA + "\n");
                    int maxp = enumMaxPayload(enumName);
                    if (maxp > 0) {
                        string payloadPtr = newTmp();
                        sb_.append("  " + payloadPtr + " = getelementptr " + subjectT + ", ptr " + subjA + ", i32 0, i32 1\n");
                        for (int bi = 0; bi < arm.bindings().size(); bi = bi + 1) {
                            // 找到 variant 的参数字段类型
                            AstParam vp = findEnumVariantParam(enumName, arm.index(), bi);
                            string bindT = vp != null ? llvmType(vp.type()) : "i32";
                            int off = enumPayloadOffset(enumName, arm.index(), bi);
                            string fieldPtr = newTmp();
                            sb_.append("  " + fieldPtr + " = getelementptr i8, ptr " + payloadPtr + ", i32 " + off + "\n");
                            string loaded = newTmp();
                            sb_.append("  " + loaded + " = load " + bindT + ", ptr " + fieldPtr + "\n");
                            string bindA = newTmp();
                            sb_.append("  " + bindA + " = alloca " + bindT + "\n");
                            sb_.append("  store " + bindT + " " + loaded + ", ptr " + bindA + "\n");
                            localNames_.add(arm.bindings().get(bi));
                            localTypes_.add(bindT);
                            localAstTypes_.add(vp != null ? vp.type() : null);
                            localAllocas_.add(bindA);
                            localElemTypes_.add("");
                            localIsSlice_.add(0);
                            localIsArc_.add(vp != null ? isArcType(vp.type()) : 0);
                        }
                    } else {
                        for (int bi = 0; bi < arm.bindings().size(); bi = bi + 1) {
                            string bindA = newTmp();
                            sb_.append("  " + bindA + " = alloca i32\n");
                            sb_.append("  store i32 0, ptr " + bindA + "\n");
                            localNames_.add(arm.bindings().get(bi));
                            localTypes_.add("i32");
                            localAstTypes_.add(null);
                            localAllocas_.add(bindA);
                            localElemTypes_.add("");
                            localIsSlice_.add(0);
                            localIsArc_.add(0);
                        }
                    }
                }
                genStmt(arm.body());
                if (terminated_ == 0) emitBr(mergeB);
                chkB = nxt;
            }
            openBlock(mergeB);
        }

        // 枚举 variant 的第 fieldIdx 个参数（null 无）。
        AstParam findEnumVariantParam(string enumName, int variantIndex, int fieldIdx) {
            if (tu_ == null) return null;
            for (int i = 0; i < tu_.enums().size(); i = i + 1) {
                AstEnum en = tu_.enums().get(i);
                if (en.name() != enumName) continue;
                if (variantIndex < 0 || variantIndex >= en.variants().size()) return null;
                AstEnumVariant v = en.variants().get(variantIndex);
                if (fieldIdx < 0 || fieldIdx >= v.params().size()) return null;
                return v.params().get(fieldIdx);
            }
            return null;
        }

        // 表达式 → IR，返回 SSA 值名（常量返回其字面量字符串）。
        string genExpr(AstExpr e) {
            if (e == null) return "0";
            string k = e.kind();
            if (k == "Integer") {
                long v = e.value();
                if (e.isChar() != 0) return "" + v;
                if (e.isUnsigned() != 0) return "" + v;
                return "" + v;
            }
            if (k == "Float") {
                return floatLiteral(e.fval());
            }
            if (k == "Bool") {
                if (e.value() != 0L) return "true";
                return "false";
            }
            if (k == "String") {
                return stringLiteral(e.stringValue());
            }
            if (k == "Null") {
                return "null";
            }
            if (k == "This") {
                return loadThis();
            }
            if (k == "Lambda") {
                return genLambda(e);
            }
            if (k == "NamedArg") {
                if (e.namedValue() != null) return genExpr(e.namedValue());
                return "0";
            }
            if (k == "Tuple") {
                // 元组字面量 (a, b, ...) → 匿名结构体 {T0, T1, ...} insertvalue 构造
                ArrayList<AstExpr> els = e.elements();
                ArrayList<string> vals = new ArrayList<string>();
                ArrayList<string> tys = new ArrayList<string>();
                for (int i = 0; i < els.size(); i = i + 1) {
                    AstExpr el = els.get(i);
                    string v = genExpr(el);
                    string vt = exprLlvmType(el);
                    vals.add(v);
                    tys.add(vt);
                }
                StringBuilder ty = new StringBuilder();
                ty.append("{ ");
                for (int i = 0; i < tys.size(); i = i + 1) {
                    if (i != 0) ty.append(", ");
                    ty.append(tys.get(i));
                }
                ty.append(" }");
                string st = ty.toString();
                string agg = "poison";
                for (int i = 0; i < vals.size(); i = i + 1) {
                    string t = newTmp();
                    sb_.append("  " + t + " = insertvalue " + st + " " + agg + ", " + tys.get(i) + " " + vals.get(i) + ", " + i + "\n");
                    agg = t;
                }
                return agg;
            }
            if (k == "Identifier") {
                string nm = e.name();
                if (hasVar(nm) != 0) {
                    string lt = varType(nm);
                    int al = IrEmit.alignOf(lt);
                    string t = newTmp();
                    sb_.append("  " + t + " = load " + lt + ", ptr " + varAlloca(nm) + ", align " + al + "\n");
                    return t;
                }
                if (hasMember(nm) != 0) {
                    // this.field（实例方法内裸属性名）
                    string gep = thisMemberAddr(nm);
                    string ft = propType(curClass_, nm);
                    if (isFixedArrayLt(ft) != 0) return gep;   // 定长数组 decay 为首元素地址
                    string t = newTmp();
                    sb_.append("  " + t + " = load " + ft + ", ptr " + gep + "\n");
                    return t;
                }
                string lt = varType(nm);
                int al = IrEmit.alignOf(lt);
                string t = newTmp();
                sb_.append("  " + t + " = load " + lt + ", ptr " + varAlloca(nm) + ", align " + al + "\n");
                return t;
            }
            if (k == "Unary") {
                string op = e.op();
                string ov = genExpr(e.operand());
                string ot = exprLlvmType(e.operand());
                if (op == "-") {
                    string t = newTmp();
                    if (ot == "double" || ot == "float") {
                        sb_.append("  " + t + " = fneg " + ot + " " + ov + "\n");
                    } else {
                        sb_.append("  " + t + " = sub " + ot + " 0, " + ov + "\n");
                    }
                    return t;
                }
                if (op == "!") {
                    string t = newTmp();
                    if (ot == "i1") {
                        sb_.append("  " + t + " = xor i1 " + ov + ", true\n");
                    } else {
                        sb_.append("  " + t + " = icmp eq " + ot + " " + ov + ", 0\n");
                    }
                    return t;
                }
                if (op == "~") {
                    string t = newTmp();
                    sb_.append("  " + t + " = xor " + ot + " " + ov + ", -1\n");
                    return t;
                }
                return ov;
            }
            if (k == "Convert") {
                // 显式类型转换 int(x)/long(x)/double(x)/bit(x)/bitvector<N>(x)
                string ov = genExpr(e.operand());
                string ot = exprLlvmType(e.operand());
                string toK = e.toKind();
                if (toK == "bit" || toK == "bool") {
                    // bool(x)/bit(x)：非零判定（fcmp une / icmp ne），
                    // 不能用 fptosi double→i1（截断非零值会误判为 0）
                    return toI1(ov, ot);
                }
                if (Str.startsWith(toK, "bitvector") != 0 || toK == "bitvector") {
                    return convertValue(ov, ot, "i" + e.bw());
                }
                string toLt = IrEmit.kindType(toK);
                if (Str.len(toLt) == 0 || toLt == "i32") {
                    if (Str.len(toK) == 0) toLt = "i32";
                }
                // uint/ulong/ubyte/ushort 目标 → 零扩展（位保持）；int(x) 有符号。
                return convertValueU(ov, ot, toLt, isUnsignedKind(toK));
            }
            if (k == "Binary") {
                string op = e.op();
                if (op == "&&" || op == "||") {
                    int isAnd = 0;
                    if (op == "&&") isAnd = 1;
                    int scbefore = pendingTemps_.size();
                    string c = toI1(genExpr(e.lhs()), exprLlvmType(e.lhs()));
                    flushTempsFrom(scbefore);
                    string resAlloca = newTmp() + ".res";
                    sb_.append("  " + resAlloca + " = alloca i1\n");
                    if (isAnd != 0) sb_.append("  store i1 false, ptr " + resAlloca + "\n");
                    else sb_.append("  store i1 true, ptr " + resAlloca + "\n");
                    string rhsB = newBlock(isAnd != 0 ? "land.rhs" : "lor.rhs");
                    string endB = newBlock(isAnd != 0 ? "land.end" : "lor.end");
                    if (isAnd != 0) {
                        sb_.append("  br i1 " + c + ", label %" + rhsB + ", label %" + endB + "\n");
                    } else {
                        sb_.append("  br i1 " + c + ", label %" + endB + ", label %" + rhsB + "\n");
                    }
                    terminated_ = 1;
                    openBlock(rhsB);
                    int scb2 = pendingTemps_.size();
                    string d = toI1(genExpr(e.rhs()), exprLlvmType(e.rhs()));
                    flushTempsFrom(scb2);
                    sb_.append("  store i1 " + d + ", ptr " + resAlloca + "\n");
                    emitBr(endB);
                    openBlock(endB);
                    string t = newTmp();
                    sb_.append("  " + t + " = load i1, ptr " + resAlloca + "\n");
                    return t;
                }
                string lv = genExpr(e.lhs());
                string rv = genExpr(e.rhs());
                string lt = exprLlvmType(e.lhs());
                string rt = exprLlvmType(e.rhs());
                // 字符串拼接（+ 且操作数为 ptr）：标量操作数 → myp_to_string_*，
                // 指针直通借用；myp_strcat(l, r)（与 C++ stringifyForConcat 一致）。
                if (op == "+" && (lt == "ptr" || rt == "ptr")) {
                    string lv2 = stringifyConcat(lv, lt, e.lhs());
                    string rv2 = stringifyConcat(rv, rt, e.rhs());
                    string t = newTmp();
                    sb_.append("  " + t + " = call ptr @myp_strcat(ptr " + lv2 + ", ptr " + rv2 + ")\n");
                    addFreshTemp(t);
                    return t;
                }
                // 字符串比较（==/!=/</<=/>/>=）：myp_str_eq / myp_str_cmp 内容比较
                AstExpr lhsE = e.lhs();
                AstExpr rhsE = e.rhs();
                int lhsStr = 0;
                int rhsStr = 0;
                if (lhsE != null && lhsE.resolvedKind() == "string") lhsStr = 1;
                if (rhsE != null && rhsE.resolvedKind() == "string") rhsStr = 1;
                if (lt == "ptr" && rt == "ptr" && lhsStr != 0 && rhsStr != 0) {
                    if (op == "==" || op == "!=") {
                        string eq = newTmp();
                        sb_.append("  " + eq + " = call i32 @myp_str_eq(ptr " + lv + ", ptr " + rv + ")\n");
                        string t = newTmp();
                        if (op == "==") sb_.append("  " + t + " = icmp ne i32 " + eq + ", 0\n");
                        else sb_.append("  " + t + " = icmp eq i32 " + eq + ", 0\n");
                        return t;
                    }
                    if (op == "<" || op == "<=" || op == ">" || op == ">=") {
                        string cmp = newTmp();
                        sb_.append("  " + cmp + " = call i32 @myp_str_cmp(ptr " + lv + ", ptr " + rv + ")\n");
                        string t = newTmp();
                        string pred = "slt";
                        if (op == "<=") pred = "sle";
                        else if (op == ">") pred = "sgt";
                        else if (op == ">=") pred = "sge";
                        sb_.append("  " + t + " = icmp " + pred + " i32 " + cmp + ", 0\n");
                        return t;
                    }
                }
                int isCmp = 0;
                if (op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=") isCmp = 1;
                // @op 运算符重载（slice+slice、slice*k 等）→ 调用 @op 函数
                if (e.opCall() != 0) {
                    string ofn = findOpFuncName(op, lt, rt);
                    if (Str.len(ofn) != 0) {
                        string oret = exprLlvmType(e);
                        string t = newTmp();
                        sb_.append("  " + t + " = call " + oret + " @" + ofn + "(" + lt + " " + lv + ", " + rt + " " + rv + ")\n");
                        if (oret == "ptr") addFreshTemp(t);
                        return t;
                    }
                }
                // 枚举结构体比较：比较判别式（元素 0，忽略载荷，同 C++）
                if (isCmp != 0 && Str.startsWith(lt, "{ i32") != 0 && Str.startsWith(rt, "{ i32") != 0) {
                    string ld = newTmp();
                    sb_.append("  " + ld + " = extractvalue " + lt + " " + lv + ", 0\n");
                    string rd = newTmp();
                    sb_.append("  " + rd + " = extractvalue " + rt + " " + rv + ", 0\n");
                    string pred = "eq";
                    if (op == "!=") pred = "ne";
                    else if (op == "<") pred = "slt";
                    else if (op == "<=") pred = "sle";
                    else if (op == ">") pred = "sgt";
                    else if (op == ">=") pred = "sge";
                    string t = newTmp();
                    sb_.append("  " + t + " = icmp " + pred + " i32 " + ld + ", " + rd + "\n");
                    return t;
                }
                // 操作数统一类型（算术 → resolvedKind；比较 → 较宽整数侧）
                string opLt = lt;
                if (isCmp == 0) {
                    if (e.resolvedKind() == "bitvector" && lhsE != null) {
                        // bitvector 位运算：结果宽度 = 左操作数（iN）
                        opLt = exprLlvmType(lhsE);
                    } else {
                        opLt = IrEmit.kindType(e.resolvedKind());
                    }
                } else {
                    if (IrEmit.isIntType(lt) != 0 && IrEmit.isIntType(rt) != 0) {
                        if (IrEmit.intWidth(rt) > IrEmit.intWidth(lt)) opLt = rt;
                    }
                }
                if (lt != opLt) { lv = convertValueU(lv, lt, opLt, lhsE != null ? isUnsignedKind(lhsE.resolvedKind()) : 0); lt = opLt; }
                if (rt != opLt) { rv = convertValueU(rv, rt, opLt, rhsE != null ? isUnsignedKind(rhsE.resolvedKind()) : 0); rt = opLt; }
                int isFp = 0;
                if (opLt == "double" || opLt == "float") isFp = 1;
                // 无符号整数运算：任一操作数为无符号整型 → 用无符号除/取模/比较/逻辑右移
                int un = 0;
                if (isFp == 0 && IrEmit.isIntType(opLt) != 0
                    && (e.resolvedKind() == "bitvector"
                        || isUnsignedKind(e.resolvedKind()) != 0
                        || (lhsE != null && isUnsignedKind(lhsE.resolvedKind()) != 0)
                        || (rhsE != null && isUnsignedKind(rhsE.resolvedKind()) != 0))) {
                    un = 1;
                }
                string insn = "";
                if (op == "+") { if (isFp != 0) insn = "fadd"; else insn = "add"; }
                else if (op == "-") { if (isFp != 0) insn = "fsub"; else insn = "sub"; }
                else if (op == "*") { if (isFp != 0) insn = "fmul"; else insn = "mul"; }
                else if (op == "/") { if (isFp != 0) insn = "fdiv"; else insn = (un != 0 ? "udiv" : "sdiv"); }
                else if (op == "%") { if (isFp != 0) insn = "frem"; else insn = (un != 0 ? "urem" : "srem"); }
                else if (op == "==") { if (isFp != 0) insn = "fcmp oeq"; else insn = "icmp eq"; }
                else if (op == "!=") { if (isFp != 0) insn = "fcmp one"; else insn = "icmp ne"; }
                else if (op == "<") { if (isFp != 0) insn = "fcmp olt"; else insn = (un != 0 ? "icmp ult" : "icmp slt"); }
                else if (op == "<=") { if (isFp != 0) insn = "fcmp ole"; else insn = (un != 0 ? "icmp ule" : "icmp sle"); }
                else if (op == ">") { if (isFp != 0) insn = "fcmp ogt"; else insn = (un != 0 ? "icmp ugt" : "icmp sgt"); }
                else if (op == ">=") { if (isFp != 0) insn = "fcmp oge"; else insn = (un != 0 ? "icmp uge" : "icmp sge"); }
                else if (op == "<<") insn = "shl";
                else if (op == ">>") insn = (un != 0 ? "lshr" : "ashr");
                else if (op == "&") insn = "and";
                else if (op == "|") insn = "or";
                else if (op == "^") insn = "xor";
                else insn = "add";
                string t = newTmp();
                sb_.append("  " + t + " = " + insn + " " + opLt + " " + lv + ", " + rv + "\n");
                return t;
            }
            if (k == "Ternary") {
                // cond ? a : b —— alloca 存结果（避免 phi，同短路 &&/|| 处理）。
                int tbefore = pendingTemps_.size();
                string cond = toI1(genExpr(e.condition()), exprLlvmType(e.condition()));
                flushTempsFrom(tbefore);
                string resLt = IrEmit.kindType(e.resolvedKind());
                if (Str.len(e.resolvedKind()) == 0) resLt = exprLlvmType(e.trueExpr());
                string resA = newTmp() + ".res";
                sb_.append("  " + resA + " = alloca " + resLt + "\n");
                if (resLt == "ptr") sb_.append("  store ptr null, ptr " + resA + "\n");
                else sb_.append("  store " + resLt + " " + IrEmit.zeroValue(resLt) + ", ptr " + resA + "\n");
                string thenB = newBlock("tern.then");
                string elseB = newBlock("tern.else");
                string endB = newBlock("tern.end");
                sb_.append("  br i1 " + cond + ", label %" + thenB + ", label %" + elseB + "\n");
                terminated_ = 1;
                openBlock(thenB);
                int tb2 = pendingTemps_.size();
                string tv = genExpr(e.trueExpr());
                string tt = exprLlvmType(e.trueExpr());
                tv = convertValue(tv, tt, resLt);
                if (resLt == "ptr") storeRef(resA, tv, isFreshTemp(tv));
                else sb_.append("  store " + resLt + " " + tv + ", ptr " + resA + "\n");
                flushTempsFrom(tb2);
                emitBr(endB);
                openBlock(elseB);
                int tb3 = pendingTemps_.size();
                string fv = genExpr(e.falseExpr());
                string ft2 = exprLlvmType(e.falseExpr());
                fv = convertValue(fv, ft2, resLt);
                if (resLt == "ptr") storeRef(resA, fv, isFreshTemp(fv));
                else sb_.append("  store " + resLt + " " + fv + ", ptr " + resA + "\n");
                flushTempsFrom(tb3);
                emitBr(endB);
                openBlock(endB);
                string t = newTmp();
                sb_.append("  " + t + " = load " + resLt + ", ptr " + resA + "\n");
                return t;
            }
            if (k == "Assign") {
                string rv = genExpr(e.rhs());
                string rt = exprLlvmType(e.rhs());
                AstExpr lhs = e.lhs();
                if (lhs != null && lhs.kind() == "Identifier") {
                    string nm = lhs.name();
                    if (hasVar(nm) != 0) {
                        string lt = varType(nm);
                        rv = convertExpr(rv, rt, lt, e.rhs());
                        if (lt == "{ ptr, i64 }") {
                            storeSliceSlot(varAlloca(nm), rv, isFreshSliceExpr(e.rhs()));
                        } else if (varIsArc(nm) != 0) {
                            storeRef(varAlloca(nm), rv, isFreshTemp(rv));
                            // §五-1 收尾: 类局部赋值镜像进协程帧（覆盖旧对象，同 C++）
                            if (isCoroClassLocal(varAstType(nm)) != 0) {
                                string cv = newTmp();
                                sb_.append("  " + cv + " = load ptr, ptr " + varAlloca(nm) + "\n");
                                emitCoroFrameSet(varAlloca(nm), cv);
                            }
                        } else {
                            int al = IrEmit.alignOf(lt);
                            sb_.append("  store " + lt + " " + rv + ", ptr " + varAlloca(nm) + ", align " + al + "\n");
                        }
                    } else if (hasMember(nm) != 0) {
                        string gep = thisMemberAddr(nm);
                        string ft = propType(curClass_, nm);
                        rv = convertExpr(rv, rt, ft, e.rhs());
                        if (ft == "ptr") {
                            storeRef(gep, rv, isFreshTemp(rv));
                        } else {
                            sb_.append("  store " + ft + " " + rv + ", ptr " + gep + "\n");
                        }
                    }
                } else if (lhs != null && lhs.kind() == "Subscript" && lhs.resolvedKind() == "bit") {
                    // bitvector<N>[i] = v → 读-改-写背衬整数
                    AstExpr arr = lhs.array();
                    string arrT = exprLlvmType(arr);
                    string slot = "";
                    if (arr != null && arr.kind() == "Identifier") slot = varAlloca(arr.name());
                    if (Str.len(slot) != 0 && IrEmit.isIntType(arrT) != 0) {
                        string cur = newTmp();
                        sb_.append("  " + cur + " = load " + arrT + ", ptr " + slot + "\n");
                        string iv = genExpr(lhs.index());
                        string it = exprLlvmType(lhs.index());
                        iv = convertValue(iv, it, arrT);
                        string one = newTmp();
                        sb_.append("  " + one + " = shl " + arrT + " 1, " + iv + "\n");
                        string notm = newTmp();
                        sb_.append("  " + notm + " = xor " + arrT + " " + one + ", -1\n");
                        string cleared = newTmp();
                        sb_.append("  " + cleared + " = and " + arrT + " " + cur + ", " + notm + "\n");
                        string val = genExpr(e.rhs());
                        string vt = exprLlvmType(e.rhs());
                        val = convertValue(val, vt, arrT);
                        string b = newTmp();
                        sb_.append("  " + b + " = and " + arrT + " " + val + ", 1\n");
                        string placed = newTmp();
                        sb_.append("  " + placed + " = shl " + arrT + " " + b + ", " + iv + "\n");
                        string nv = newTmp();
                        sb_.append("  " + nv + " = or " + arrT + " " + cleared + ", " + placed + "\n");
                        sb_.append("  store " + arrT + " " + nv + ", ptr " + slot + "\n");
                        return rv;
                    }
                } else if (lhs != null && lhs.kind() == "Subscript") {
                    // arr[i] = v / sl[i] = v
                    AstExpr arr = lhs.array();
                    AstExpr idx = lhs.index();
                    string arrV = genExpr(arr);
                    string idxV = genExpr(idx);
                    string idxT = exprLlvmType(idx);
                    string elemLt = subscriptElemLt(arr);
                    int isSl = subscriptIsSlice(arr);
                    // 嵌套 slice：rows[i]（slice 值）再下标 → 须 extractvalue data
                    if (isSl == 0 && exprLlvmType(arr) == "{ ptr, i64 }") isSl = 1;
                    string gep;
                    if (isSl != 0) {
                        string data = newTmp();
                        sb_.append("  " + data + " = extractvalue { ptr, i64 } " + arrV + ", 0\n");
                        gep = newTmp();
                        sb_.append("  " + gep + " = getelementptr " + elemLt + ", ptr " + data + ", " + idxT + " " + idxV + "\n");
                    } else {
                        gep = newTmp();
                        sb_.append("  " + gep + " = getelementptr " + elemLt + ", ptr " + arrV + ", " + idxT + " " + idxV + "\n");
                    }
                    rv = convertExpr(rv, rt, elemLt, e.rhs());
                    if (elemLt == "{ ptr, i64 }") {
                        // slice 元素（含嵌套 slice<slice<T>>）：retain 新 backing，释放旧。
                        storeSliceSlot(gep, rv, isFreshSliceExpr(e.rhs()));
                    } else if (elemLt == "ptr") {
                        storeRef(gep, rv, isFreshTemp(rv));
                    } else {
                        sb_.append("  store " + elemLt + " " + rv + ", ptr " + gep + "\n");
                    }
                } else if (lhs != null && lhs.kind() == "Member"
                    && Str.len(lhs.resolvedClass()) != 0 && isBitfieldName(lhs.resolvedClass()) != 0) {
                    // bitfield 字段写：f.read = v → 读-改-写背衬整数
                    string bfName = lhs.resolvedClass();
                    string mname = lhs.memberName();
                    AstExpr obj = lhs.array();
                    int off = bitfieldFieldOffset(bfName, mname);
                    int width = bitfieldFieldWidth(bfName, mname);
                    string slot = bitfieldSlotAddr(obj);
                    string bft = bitfieldBackingType(obj);
                    string cur = newTmp();
                    sb_.append("  " + cur + " = load " + bft + ", ptr " + slot + "\n");
                    string val = genExpr(e.rhs());
                    string vt = exprLlvmType(e.rhs());
                    val = convertValue(val, vt, bft);
                    int mask = (1 << width) - 1;
                    if (width >= 30) mask = -1;
                    string fmask = "" + mask;
                    string shifted = newTmp();
                    sb_.append("  " + shifted + " = shl " + bft + " " + fmask + ", " + off + "\n");
                    string notm = newTmp();
                    sb_.append("  " + notm + " = xor " + bft + " " + shifted + ", -1\n");
                    string cleared = newTmp();
                    sb_.append("  " + cleared + " = and " + bft + " " + cur + ", " + notm + "\n");
                    string bits = newTmp();
                    sb_.append("  " + bits + " = and " + bft + " " + val + ", " + fmask + "\n");
                    string placed = newTmp();
                    sb_.append("  " + placed + " = shl " + bft + " " + bits + ", " + off + "\n");
                    string nv = newTmp();
                    sb_.append("  " + nv + " = or " + bft + " " + cleared + ", " + placed + "\n");
                    sb_.append("  store " + bft + " " + nv + ", ptr " + slot + "\n");
                    return rv;
                } else if (lhs != null && lhs.kind() == "Member") {
                    // obj.field = v / this.field = v
                    string gep = memberAddr(lhs);
                    string ft = memberFieldType(lhs);
                    if (ft == "{ ptr, ptr }" && rt == "ptr") {
                        // concrete 类 → interface 上转（struct 字段 / 类属性）
                        AstType fa = memberFieldAstType(lhs);
                        if (fa != null) {
                            AstType frt = resolveType(fa);
                            if (frt != null && Str.len(frt.className()) != 0 && isInterfaceName(frt.className()) != 0) {
                                rv = upcastIface(e.rhs(), frt.className(), rv);
                            }
                        }
                    } else {
                        rv = convertExpr(rv, rt, ft, e.rhs());
                    }
                    if (ft == "ptr") {
                        storeRef(gep, rv, isFreshTemp(rv));
                    } else {
                        sb_.append("  store " + ft + " " + rv + ", ptr " + gep + "\n");
                    }
                }
                return rv;
            }
            if (k == "NewArray") {
                // 标量动态数组：myp_alloc_slice_backing(total, elem_size, elem_kind)
                string elemLt = llvmType(e.elemType());
                int elemSize = IrEmit.typeSize(elemLt);
                int elemKind = arrayElemKind(e.elemType());
                string totalV = "1";
                for (int i = 0; i < e.dimensions().size(); i = i + 1) {
                    AstExpr dim = e.dimensions().get(i);
                    string dv = genExpr(dim);
                    string dt = exprLlvmType(dim);
                    string d64 = convertValue(dv, dt, "i64");
                    if (totalV == "1") {
                        totalV = d64;
                    } else {
                        string tm = newTmp();
                        sb_.append("  " + tm + " = mul i64 " + totalV + ", " + d64 + "\n");
                        totalV = tm;
                    }
                }
                string t = newTmp();
                sb_.append("  " + t + " = call ptr @myp_alloc_slice_backing(i64 " + totalV + ", i32 " + elemSize + ", i32 " + elemKind + ")\n");
                addFreshTemp(t);
                // 零初始化（类元素数组的未填槽须为 null）
                string bs = newTmp();
                sb_.append("  " + bs + " = mul i64 " + totalV + ", " + elemSize + "\n");
                sb_.append("  call void @llvm.memset.p0.i64(ptr " + t + ", i8 0, i64 " + bs + ", i1 false)\n");
                return t;
            }
            if (k == "Subscript") {
                AstExpr arr = e.array();
                AstExpr idx = e.index();
                // string 下标 s[i] : char —— myp_str_substring(s,i,i+1)+myp_ord
                // 安全路径（越界/负数钳制），返回 char（i8）。同 C++ generateSubscript。
                if (arr != null && arr.resolvedKind() == "string") {
                    string sptr = genExpr(arr);
                    string iv = genExpr(idx);
                    string it = exprLlvmType(idx);
                    string start = convertValue(iv, it, "i32");
                    string one = "1";
                    string end = newTmp();
                    sb_.append("  " + end + " = add i32 " + start + ", " + one + "\n");
                    string ch = newTmp();
                    sb_.append("  " + ch + " = call ptr @myp_str_substring(ptr " + sptr + ", i32 " + start + ", i32 " + end + ")\n");
                    string code = newTmp();
                    sb_.append("  " + code + " = call i32 @myp_ord(ptr " + ch + ")\n");
                    sb_.append("  call i32 @myp_release(ptr " + ch + ")\n");
                    string t = newTmp();
                    sb_.append("  " + t + " = trunc i32 " + code + " to i8\n");
                    return t;
                }
                // bitvector<N>[i] → (v >> i) & 1 → i1
                if (e.resolvedKind() == "bit" && arr != null) {
                    string arrT = exprLlvmType(arr);
                    if (IrEmit.isIntType(arrT) != 0 && subscriptIsSlice(arr) == 0) {
                        string av = genExpr(arr);
                        string iv = genExpr(idx);
                        string it = exprLlvmType(idx);
                        iv = convertValue(iv, it, arrT);
                        string sh = newTmp();
                        sb_.append("  " + sh + " = lshr " + arrT + " " + av + ", " + iv + "\n");
                        string m = newTmp();
                        sb_.append("  " + m + " = and " + arrT + " " + sh + ", 1\n");
                        string t = newTmp();
                        sb_.append("  " + t + " = trunc " + arrT + " " + m + " to i1\n");
                        return t;
                    }
                }
                string arrV = genExpr(arr);
                string idxV = genExpr(idx);
                string idxT = exprLlvmType(idx);
                string elemLt = subscriptElemLt(arr);
                int isSl = subscriptIsSlice(arr);
                // 数组表达式本身为 slice 值（slice<slice<T>> 的 rows[i] 再下标）：
                // 其结果 LLVM 类型是 { ptr, i64 } → 须 extractvalue data 再 GEP。
                if (isSl == 0 && exprLlvmType(arr) == "{ ptr, i64 }") isSl = 1;
                if (isSl != 0) {
                    // slice：extractvalue data + GEP
                    string data = newTmp();
                    sb_.append("  " + data + " = extractvalue { ptr, i64 } " + arrV + ", 0\n");
                    string gep = newTmp();
                    sb_.append("  " + gep + " = getelementptr " + elemLt + ", ptr " + data + ", " + idxT + " " + idxV + "\n");
                    string t = newTmp();
                    sb_.append("  " + t + " = load " + elemLt + ", ptr " + gep + "\n");
                    return t;
                }
                string gep = newTmp();
                sb_.append("  " + gep + " = getelementptr " + elemLt + ", ptr " + arrV + ", " + idxT + " " + idxV + "\n");
                string t = newTmp();
                sb_.append("  " + t + " = load " + elemLt + ", ptr " + gep + "\n");
                return t;
            }
            if (k == "New") {
                if (e.className() == "slice") {
                    return genSliceNew(e);
                }
                // 类实例：myp_alloc_object(size, type_id) + 属性默认值 + 构造器调用。
                // 泛型实例用 resolvedClass（Box_int_inst），模板名用 className。
                string cls = e.className();
                string rc = e.resolvedClass();
                if (Str.len(rc) != 0) cls = rc;
                else if (e.typeArgs().size() > 0) {
                    // 共享模板体内的 new Result<T,E>(v)：resolvedClass 未解析 →
                    // 按 className + 解析后的实参重建实例名（C++ generateNewExpr）
                    cls = e.className();
                    for (int ti = 0; ti < e.typeArgs().size(); ti = ti + 1) {
                        cls = cls + "_" + classInstName(resolveType(e.typeArgs().get(ti)));
                    }
                    cls = cls + "_inst";
                }
                int sz = classSize(cls);
                int tid = classTypeId(cls);
                string t = newTmp();
                sb_.append("  " + t + " = call ptr @myp_alloc_object(i64 " + sz + ", i32 " + tid + ")\n");
                addFreshTemp(t);
                // 零初始化对象（同 C++ generateNewExpr 的 CreateMemSet——未显式
                // 初始化的属性必须为 0，否则 malloc 垃圾值）
                sb_.append("  call void @llvm.memset.p0.i64(ptr " + t + ", i8 0, i64 " + sz + ", i1 false)\n");
                // 属性默认值（new 时 store；构造器可覆写）
                if (tu_ != null) {
                    for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                        AstClass cc = tu_.classes().get(ci);
                        if (cc.name() != cls) continue;
                        for (int pi = 0; pi < cc.props().size(); pi = pi + 1) {
                            AstProp prop = cc.props().get(pi);
                            if (prop.init() == null) continue;
                            string pv = genExpr(prop.init());
                            string pt = exprLlvmType(prop.init());
                            string ft = propType(cls, prop.name());
                            string gep = newTmp();
                            sb_.append("  " + gep + " = getelementptr %" + cls + ", ptr " + t + ", i32 0, i32 " + pi + "\n");
                            pv = convertValue(pv, pt, ft);
                            sb_.append("  store " + ft + " " + pv + ", ptr " + gep + "\n");
                        }
                        break;
                    }
                }
                string ctor = e.ctor();
                // 泛型实例（共享模板体）：sema 未解析 ctor → 按具体实例类名 + 实参
                // 个数重建构造器名（C++ generateNewExpr 的泛型回退）。
                if (Str.len(ctor) == 0 && tu_ != null) {
                    for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                        AstClass cc = tu_.classes().get(ci);
                        if (cc.name() != cls) continue;
                        for (int ai = 0; ai < cc.actions().size(); ai = ai + 1) {
                            AstAction a = cc.actions().get(ai);
                            if (a.ctor() == 0) continue;
                            if (a.params().size() != e.args().size()) continue;
                            ctor = cls + "_" + a.name();
                            for (int pi = 0; pi < a.params().size(); pi = pi + 1) {
                                ctor = ctor + "_" + mangleType(resolveType(a.params().get(pi).type()));
                            }
                            break;
                        }
                        break;
                    }
                }
                if (Str.len(ctor) != 0) {
                    StringBuilder as = new StringBuilder();
                    as.append("ptr " + t);
                    for (int i = 0; i < e.args().size(); i = i + 1) {
                        AstExpr a = e.args().get(i);
                        string av = genExpr(a);
                        string at = exprLlvmType(a);
                        as.append(", " + at + " " + av);
                    }
                    sb_.append("  call void @" + ctor + "(" + as.toString() + ")\n");
                }
                return t;
            }
            if (k == "Member") {
                string mname = e.memberName();
                // 枚举变体（无参）：Color.Red / Shape.Point
                AstExpr mObj = e.array();
                if (mObj != null && mObj.kind() == "Identifier" && isEnumName(mObj.name()) != 0) {
                    int vi = enumVariantIndex(mObj.name(), mname);
                    string st = enumLlvmType(mObj.name());
                    string d1 = newTmp();
                    sb_.append("  " + d1 + " = insertvalue " + st + " poison, i32 " + vi + ", 0\n");
                    return d1;
                }
                // 元组字段访问 t.0 / t.1 → extractvalue
                if (isDigits(mname) != 0) {
                    AstExpr obj = e.array();
                    string objV = genExpr(obj);
                    string objT = exprLlvmType(obj);
                    string t = newTmp();
                    sb_.append("  " + t + " = extractvalue " + objT + " " + objV + ", " + mname + "\n");
                    return t;
                }
                // slice.length / slice.size() / slice.data()
                if (mObj != null && mObj.kind() == "Identifier" && isSliceVar(mObj.name()) != 0) {
                    if (mname == "size" || mname == "length") {
                        string sv = genExpr(mObj);
                        string len = newTmp();
                        sb_.append("  " + len + " = extractvalue { ptr, i64 } " + sv + ", 1\n");
                        string t = newTmp();
                        sb_.append("  " + t + " = trunc i64 " + len + " to i32\n");
                        return t;
                    }
                    if (mname == "data") {
                        string sv = genExpr(mObj);
                        string data = newTmp();
                        sb_.append("  " + data + " = extractvalue { ptr, i64 } " + sv + ", 0\n");
                        return data;
                    }
                }
                // bitfield 字段读取：f.read / this.f.read / fa[0].read → 位提取
                if (mObj != null && Str.len(e.resolvedClass()) != 0 && isBitfieldName(e.resolvedClass()) != 0) {
                    string bfName = e.resolvedClass();
                    int off = bitfieldFieldOffset(bfName, mname);
                    int width = bitfieldFieldWidth(bfName, mname);
                    string bv = genExpr(mObj);
                    string bft = exprLlvmType(mObj);
                    string sh = newTmp();
                    sb_.append("  " + sh + " = lshr " + bft + " " + bv + ", " + off + "\n");
                    if (width == 1) {
                        string m = newTmp();
                        sb_.append("  " + m + " = and " + bft + " " + sh + ", 1\n");
                        string t = newTmp();
                        sb_.append("  " + t + " = trunc " + bft + " " + m + " to i1\n");
                        return t;
                    }
                    int mask = (1 << width) - 1;
                    if (width >= 30) mask = -1;
                    string m = newTmp();
                    sb_.append("  " + m + " = and " + bft + " " + sh + ", " + mask + "\n");
                    if (bft == "i32") return m;
                    if (bft == "i64") {
                        string t2 = newTmp();
                        sb_.append("  " + t2 + " = trunc i64 " + m + " to i32\n");
                        return t2;
                    }
                    string t = newTmp();
                    sb_.append("  " + t + " = zext " + bft + " " + m + " to i32\n");
                    return t;
                }
                string gep = memberAddr(e);
                string ft = memberFieldType(e);
                if (isFixedArrayLt(ft) != 0) return gep;   // 定长数组 decay 为首元素地址
                string t = newTmp();
                sb_.append("  " + t + " = load " + ft + ", ptr " + gep + "\n");
                return t;
            }
            if (k == "Call") {
                AstExpr callee = e.callee();
                // __myp_throw(msg)：记录错误 + longjmp 到最内层 handler
                //（C++ generateCall 内联特判，与 throw 语句一致）。
                if (callee != null && callee.kind() == "Identifier" && callee.name() == "__myp_throw") {
                    if (e.args().size() > 0) {
                        string msg = genExpr(e.args().get(0));
                        sb_.append("  call void @myp_throw(ptr " + msg + ")\n");
                    }
                    emitLongjmpOuter();
                    return "0";
                }
                // __myp_timer_create("eventName", delay[, interval]) → 解析事件名
                // 为 event_id + myp_timer_create（同 C++ 内联特判）
                if (callee != null && callee.kind() == "Identifier" && callee.name() == "__myp_timer_create") {
                    return genTimerCreate(e);
                }
                // __myp_atomic_* 内建：直接生成 LLVM atomicrmw / load / store
                //（同 C++ generateCall 内联特判，无运行时调用）。
                if (callee != null && callee.kind() == "Identifier") {
                    string an = callee.name();
                    if (an == "__myp_atomic_add_i32" || an == "__myp_atomic_sub_i32"
                        || an == "__myp_atomic_xchg_i32" || an == "__myp_atomic_add_f64"
                        || an == "__myp_atomic_load_i32" || an == "__myp_atomic_store_i32") {
                        string elemT = "i32";
                        if (an == "__myp_atomic_add_f64") elemT = "double";
                        string arrV = genExpr(e.args().get(0));
                        string idxV = genExpr(e.args().get(1));
                        string idxT = exprLlvmType(e.args().get(1));
                        string ap = newTmp();
                        sb_.append("  " + ap + " = getelementptr " + elemT + ", ptr " + arrV + ", " + idxT + " " + idxV + "\n");
                        if (an == "__myp_atomic_load_i32") {
                            string t = newTmp();
                            sb_.append("  " + t + " = load i32, ptr " + ap + "\n");
                            return t;
                        }
                        string vv = genExpr(e.args().get(2));
                        string vt = exprLlvmType(e.args().get(2));
                        vv = convertValue(vv, vt, elemT);
                        if (an == "__myp_atomic_store_i32") {
                            sb_.append("  store i32 " + vv + ", ptr " + ap + "\n");
                            return "0";
                        }
                        string op = "add";
                        if (an == "__myp_atomic_sub_i32") op = "sub";
                        else if (an == "__myp_atomic_xchg_i32") op = "xchg";
                        else if (an == "__myp_atomic_add_f64") op = "fadd";
                        string t = newTmp();
                        sb_.append("  " + t + " = atomicrmw " + op + " ptr " + ap + ", " + elemT + " " + vv + " seq_cst\n");
                        return t;
                    }
                }
                // P2 §5.3 位操作原语：popcount/clz/ctz/bitreverse/rotl/rotr
                // → LLVM intrinsic（返回类型 = 实参 LLVM 宽度）。
                if (callee != null && callee.kind() == "Identifier") {
                    string bn = callee.name();
                    if (bn == "popcount" || bn == "clz" || bn == "ctz" || bn == "bitreverse"
                        || bn == "rotl" || bn == "rotr") {
                        return genBitOpBuiltin(e, bn);
                    }
                }
                // §9.5 多态数学 intrinsic：__myp_math_* 一元（除 pow/atan2/abs_int）
                // → LLVM 标量 intrinsic（按实参类型，同 C++ generatePolyMathIntrinsic）。
                if (callee != null && callee.kind() == "Identifier") {
                    string mn = callee.name();
                    if (Str.startsWith(mn, "__myp_math_") != 0
                        && mn != "__myp_math_pow" && mn != "__myp_math_atan2"
                        && mn != "__myp_math_abs_int") {
                        string r = genPolyMathIntrinsic(e, mn);
                        if (Str.len(r) != 0) return r;
                    }
                }
                // P3 §4.2 checkedAdd/checkedMul → llvm.sadd/smul.with.overflow.iN
                if (callee != null && callee.kind() == "Identifier"
                    && (callee.name() == "checkedAdd" || callee.name() == "checkedMul")) {
                    string av0 = genExpr(e.args().get(0));
                    string at0 = exprLlvmType(e.args().get(0));
                    string av1 = genExpr(e.args().get(1));
                    string at1 = exprLlvmType(e.args().get(1));
                    string ct = IrEmit.intWidth(at0) >= IrEmit.intWidth(at1) ? at0 : at1;
                    av0 = convertValueU(av0, at0, ct, 0);
                    av1 = convertValueU(av1, at1, ct, 0);
                    string intr = callee.name() == "checkedAdd" ? "llvm.sadd.with.overflow." + ct : "llvm.smul.with.overflow." + ct;
                    string t = newTmp();
                    sb_.append("  " + t + " = call { " + ct + ", i1 } @" + intr + "(" + ct + " " + av0 + ", " + ct + " " + av1 + ")\n");
                    return t;
                }
                // P4 §6.2 parseIntOpt(s) → { i32, i1 } 元组
                if (callee != null && callee.kind() == "Identifier" && callee.name() == "parseIntOpt") {
                    string sp = genExpr(e.args().get(0));
                    string ok = newTmp();
                    sb_.append("  " + ok + " = alloca i1\n");
                    string v = newTmp();
                    sb_.append("  " + v + " = call i32 @myp_str_parse_int_opt(ptr " + sp + ", ptr " + ok + ")\n");
                    string okv = newTmp();
                    sb_.append("  " + okv + " = load i1, ptr " + ok + "\n");
                    string p0 = newTmp();
                    sb_.append("  " + p0 + " = insertvalue { i32, i1 } poison, i32 " + v + ", 0\n");
                    string p1 = newTmp();
                    sb_.append("  " + p1 + " = insertvalue { i32, i1 } " + p0 + ", i1 " + okv + ", 1\n");
                    return p1;
                }
                // P0 bitcast<T,U>(x)：位保持重解释 → LLVM bitcast 指令
                if (callee != null && callee.kind() == "Identifier" && callee.name() == "bitcast") {
                    AstExpr arg = e.args().get(0);
                    string srcV = genExpr(arg);
                    string srcT = exprLlvmType(arg);
                    string dst = exprLlvmType(e);
                    string t = newTmp();
                    sb_.append("  " + t + " = bitcast " + srcT + " " + srcV + " to " + dst + "\n");
                    return t;
                }
                // P1 bytes(s) / str(bytes)：string ↔ ubyte[] 互转
                if (callee != null && callee.kind() == "Identifier"
                    && (callee.name() == "bytes" || callee.name() == "str")) {
                    string argV = genExpr(e.args().get(0));
                    string fn2 = callee.name() == "bytes" ? "myp_str_to_bytes" : "myp_bytes_to_str";
                    string t = newTmp();
                    sb_.append("  " + t + " = call ptr @" + fn2 + "(ptr " + argV + ")\n");
                    addFreshTemp(t);
                    return t;
                }
                // §5.1 bytesOf(bitvector<N>) → myp_uint_to_bytes(zext(v,i64), N/8)
                if (callee != null && callee.kind() == "Identifier" && callee.name() == "bytesOf") {
                    string av = genExpr(e.args().get(0));
                    string at = exprLlvmType(e.args().get(0));
                    int nbytes = 4;
                    if (at == "i1") nbytes = 1;
                    else if (at == "i8") nbytes = 1;
                    else if (at == "i16") nbytes = 2;
                    else if (at == "i32") nbytes = 4;
                    else if (at == "i64") nbytes = 8;
                    string wide = convertValue(av, at, "i64");
                    string t = newTmp();
                    sb_.append("  " + t + " = call ptr @myp_uint_to_bytes(i64 " + wide + ", i32 " + nbytes + ")\n");
                    addFreshTemp(t);
                    return t;
                }
                // P2 parse* 全族 → runtime helper
                if (callee != null && callee.kind() == "Identifier") {
                    string pn = callee.name();
                    string pfn = "";
                    string prt = "";
                    if (pn == "parseLong") { pfn = "myp_str_to_long"; prt = "i64"; }
                    else if (pn == "parseInt") { pfn = "myp_str_parse_int"; prt = "i32"; }
                    else if (pn == "parseUlong") { pfn = "myp_str_to_ulong"; prt = "i64"; }
                    else if (pn == "parseUint") { pfn = "myp_str_to_uint"; prt = "i32"; }
                    else if (pn == "parseFloat") { pfn = "myp_str_to_float"; prt = "float"; }
                    else if (pn == "parseDouble") { pfn = "myp_atof"; prt = "double"; }
                    if (Str.len(pfn) != 0) {
                        string argV = genExpr(e.args().get(0));
                        string t = newTmp();
                        sb_.append("  " + t + " = call " + prt + " @" + pfn + "(ptr " + argV + ")\n");
                        return t;
                    }
                }
                // RTTI：__myp_type_id / __myp_type_name → myp_obj_type_id/name
                if (callee != null && callee.kind() == "Identifier"
                    && (callee.name() == "__myp_type_id" || callee.name() == "__myp_type_name")) {
                    string argV = genExpr(e.args().get(0));
                    if (callee.name() == "__myp_type_id") {
                        string t = newTmp();
                        sb_.append("  " + t + " = call i32 @myp_obj_type_id(ptr " + argV + ")\n");
                        return t;
                    }
                    string t = newTmp();
                    sb_.append("  " + t + " = call ptr @myp_obj_type_name(ptr " + argV + ")\n");
                    addFreshTemp(t);
                    return t;
                }
                string fn = "";
                string thisV = "";
                string mCls = "";      // 方法所属类（形参类型查找用）
                string mName = "";     // 方法/函数/事件名
                int isEvCall = 0;      // 事件 fire 调用
                // 泛型函数/泛型静态方法调用：sema 已单态化到具体实例（e.resolved_），
                // 直接调用实例函数（同 C++ generateCall 的 resolved_call_name 分支）。
                if (Str.len(e.resolved()) != 0) {
                    string rfn = e.resolved();
                    string rret = exprLlvmType(e);
                    StringBuilder ras = new StringBuilder();
                    for (int i = 0; i < e.args().size(); i = i + 1) {
                        AstExpr a = e.args().get(i);
                        string av = genExpr(a);
                        string aT = exprLlvmType(a);
                        if (i != 0) ras.append(", ");
                        ras.append(aT + " " + av);
                    }
                    if (rret == "void") {
                        sb_.append("  call void @" + rfn + "(" + ras.toString() + ")\n");
                        return "";
                    }
                    string rt = newTmp();
                    sb_.append("  " + rt + " = call " + rret + " @" + rfn + "(" + ras.toString() + ")\n");
                    if (rret == "ptr") addFreshTemp(rt);
                    return rt;
                }
                // 函数值间接调用：callee 是函数类型变量/参数 → call_fn(closure, args)
                if (callee != null && callee.kind() == "Identifier") {
                    AstType at = varAstType(callee.name());
                    if (at != null && IrEmit.isFunction(at) != 0) {
                        return genFuncValueCall(e, callee.name(), at);
                    }
                }
                if (callee != null && callee.kind() == "Identifier") {
                    fn = callee.name();
                    // 内建 intrinsic __myp_X → runtime myp_X（去掉两个下划线）
                    if (Str.startsWith(fn, "__myp_") != 0) {
                        fn = Str.substring(fn, 2, Str.len(fn));
                    } else if (isTopLevelFunc(fn) == 0 && hasMethodInClass(curClass_, fn) != 0) {
                        // 类内裸方法调用 → this.method()（Class_method(ptr this, ...)）
                        mCls = curClass_;
                        mName = fn;
                        fn = curClass_ + "_" + fn;
                        thisV = loadThis();
                    } else if (isTopLevelFunc(fn) == 0 && hasEventInClass(curClass_, fn) != 0) {
                        // 类内裸事件 fire → fire_Class_Event(this, ...)
                        mCls = curClass_;
                        mName = fn;
                        isEvCall = 1;
                        fn = "fire_" + curClass_ + "_" + fn;
                        thisV = loadThis();
                    } else if (isTopLevelFunc(fn) != 0) {
                        mName = fn;
                    }
                } else if (callee != null && callee.kind() == "Member") {
                    AstExpr obj = callee.array();
                    string mname = callee.memberName();
                    // slice.size() / length() / data()
                    if (obj != null && obj.kind() == "Identifier" && isSliceVar(obj.name()) != 0) {
                        if (mname == "size" || mname == "length") {
                            string sv = genExpr(obj);
                            string len = newTmp();
                            sb_.append("  " + len + " = extractvalue { ptr, i64 } " + sv + ", 1\n");
                            string t = newTmp();
                            sb_.append("  " + t + " = trunc i64 " + len + " to i32\n");
                            return t;
                        }
                        if (mname == "data") {
                            string sv = genExpr(obj);
                            string data = newTmp();
                            sb_.append("  " + data + " = extractvalue { ptr, i64 } " + sv + ", 0\n");
                            return data;
                        }
                    }
                    // 枚举变体构造：Option.Some(42) / Color.Red（无参）
                    if (obj != null && obj.kind() == "Identifier" && isEnumName(obj.name()) != 0) {
                        return genEnumVariant(obj.name(), mname, e);
                    }
                    // struct 变量方法调用：struct_<Name>_<method>(ptr alloca, ...)
                    if (obj != null && obj.kind() == "Identifier") {
                        AstType sOat = varAstType(obj.name());
                        if (sOat != null) {
                            AstType sRt = resolveType(sOat);
                            if (sRt != null && Str.len(sRt.className()) != 0 && isStructName(sRt.className()) != 0) {
                                return genStructMethodCall(sRt.className(), mname, e, varAlloca(obj.name()));
                            }
                        }
                    }
                    if (obj != null && obj.kind() == "Identifier" && isClassName(obj.name()) != 0) {
                        fn = obj.name() + "_" + mname;
                        mCls = obj.name();
                        mName = mname;
                    } else if (obj != null && obj.kind() == "Identifier") {
                        // 接口变量方法调用 → vtable 间接调用
                        AstType oat = varAstType(obj.name());
                        if (oat != null && isInterfaceName(oat.className()) != 0) {
                            return genIfaceCall(obj, oat.className(), mname, e);
                        }
                        // 实例方法 Class_method(ptr this, args...)
                        string cls2 = callee.resolvedClass();
                        // 泛型实例体内：用实参/局部变量的实例类型解析（C++ var_class_map_），
                        // 优先于 sema 在模板体上解析出的 resolvedClass（可能带 T 占位）。
                        AstType oat2 = varAstType(obj.name());
                        if (oat2 != null) {
                            AstType rt2 = resolveType(oat2);
                            if (rt2 != null && Str.len(rt2.className()) != 0 && rt2.funcReturn() == null
                                && isSliceType(rt2) == 0 && isEnumName(rt2.className()) == 0
                                && isStructName(rt2.className()) == 0 && isInterfaceName(rt2.className()) == 0) {
                                cls2 = classInstName(rt2);
                            }
                        }
                        if (Str.len(cls2) == 0) cls2 = "Object";
                        fn = cls2 + "_" + mname;
                        mCls = cls2;
                        mName = mname;
                        thisV = genExpr(obj);
                    } else {
                        // obj 是 Member/Subscript/Call：接口值（{ptr,ptr}）→ vtable 间接调用
                        if (exprLlvmType(obj) == "{ ptr, ptr }") {
                            string iname = callee.resolvedClass();
                            AstType fa = memberFieldAstType(obj);
                            if (fa != null) {
                                AstType frt = resolveType(fa);
                                if (frt != null && Str.len(frt.className()) != 0 && isInterfaceName(frt.className()) != 0) iname = frt.className();
                            }
                            if (Str.len(iname) == 0) iname = "Object";
                            return genIfaceCall(obj, iname, mname, e);
                        }
                        // 实例方法 Class_method(ptr this, args...)
                        string cls = callee.resolvedClass();
                        if (Str.len(cls) == 0) cls = "Object";
                        fn = cls + "_" + mname;
                        mCls = cls;
                        mName = mname;
                        thisV = genExpr(obj);
                    }
                }
                // 返回类型：用 exprLlvmType（tuple 返回 → {T0,T1,...}；否则 kindType）
                string retLt = exprLlvmType(e);
                // 内建 FFI 的真实返回类型：泛型模板体内 resolvedKind 被标 int，
                // 但 math intrinsic 签名固定为 double(double)（C++ intrinsic_map_）
                if (callee != null && callee.kind() == "Identifier"
                    && Str.startsWith(callee.name(), "__myp_math_") != 0
                    && callee.name() != "__myp_math_abs_int") {
                    retLt = "double";
                } else if (callee != null && callee.kind() == "Identifier"
                    && (callee.name() == "__myp_atof" || callee.name() == "__myp_io_read_double")) {
                    retLt = "double";
                }
                // @coro 方法/函数调用 → 创建协程 + 传参 + 首启，返回 handle（i64）
                if (Str.len(mName) != 0) {
                    if (isTopLevelFunc(mName) != 0 && findFuncCoro(mName) != null) {
                        return genCoroSpawn(mName, e, "", 0, 0);
                    } else if (Str.len(mCls) != 0 && isCoroMethod(mCls, mName) != 0) {
                        return genCoroSpawn(mCls + "_" + mName, e, thisV, 1, coroStackKb(mCls, mName));
                    }
                }
                // 期望的形参 LLVM 类型（实参提升：float→double、int→long 等，
                // 同 C++ generateCall 的 convertIntegerValue）
                ArrayList<string> expParams = null;
                if (isEvCall != 0) {
                    AstEvent evc = findEvent(mCls, mName);
                    if (evc != null) {
                        expParams = new ArrayList<string>();
                        for (int pi = 0; pi < evc.params().size(); pi = pi + 1) expParams.add(llvmType(evc.params().get(pi).type()));
                    }
                } else if (Str.len(mName) != 0) {
                    if (isTopLevelFunc(mName) != 0) expParams = funcParamLts(mName);
                    else if (Str.len(mCls) != 0) expParams = methodParamLts(mCls, mName);
                } else if (callee != null && callee.kind() == "Identifier"
                    && Str.startsWith(callee.name(), "__myp_") != 0) {
                    expParams = intrParamLts(fn);
                }
                StringBuilder as = new StringBuilder();
                if (Str.len(thisV) != 0) {
                    as.append("ptr " + thisV);
                }
                for (int i = 0; i < e.args().size(); i = i + 1) {
                    AstExpr a = e.args().get(i);
                    string av = genExpr(a);
                    string at = exprLlvmType(a);
                    if (expParams != null && i < expParams.size()) {
                        string pt = expParams.get(i);
                        if (at == "ptr" && pt == "{ ptr, ptr }") {
                            // concrete 类 → interface 上转（虚表分派）
                            string iname = callParamIfaceName(mCls, mName, isEvCall, i);
                            if (Str.len(iname) != 0) av = upcastIface(a, iname, av);
                            at = "{ ptr, ptr }";
                        } else {
                            av = convertValueU(av, at, pt, isUnsignedKind(a.resolvedKind()));
                            at = pt;
                        }
                    }
                    if (i != 0 || Str.len(thisV) != 0) as.append(", ");
                    as.append(at + " " + av);
                }
                if (retLt == "void") {
                    sb_.append("  call void @" + fn + "(" + as.toString() + ")\n");
                    return "";
                }
                string t = newTmp();
                sb_.append("  " + t + " = call " + retLt + " @" + fn + "(" + as.toString() + ")\n");
                if (retLt == "ptr") addFreshTemp(t);
                return t;
            }
            if (k == "TryExpr") {
                return genTryExpr(e);
            }
            if (k == "Await") {
                return genAwaitCore(e.operand(), e.timeout());
            }
            // Member/Subscript 等留 G2。
            return "0";
        }

        // 表达式 try：try <expr> catch (e) <expr>（C++ generateTryExpr）。
        // 成功路径求值 tryExpr_，异常路径绑定 catch 变量后求值 catchExpr_，
        // merge 用 phi 汇合两个值。
        string genTryExpr(AstExpr e) {
            string jb = newTmp();
            sb_.append("  " + jb + " = alloca %myp_jmp_buf, align 8\n");
            sb_.append("  call void @myp_exception_push(ptr " + jb + ")\n");
            string r = newTmp();
            sb_.append("  " + r + " = call i32 @setjmp(ptr " + jb + ")\n");
            string isErr = newTmp();
            sb_.append("  " + isErr + " = icmp ne i32 " + r + ", 0\n");
            string tryB = newBlock("try_expr_try");
            string catchB = newBlock("try_expr_catch");
            string mergeB = newBlock("try_expr_merge");
            sb_.append("  br i1 " + isErr + ", label %" + catchB + ", label %" + tryB + "\n");
            terminated_ = 1;
            // 成功路径
            openBlock(tryB);
            string v1 = genExpr(e.tryExpr());
            string t1 = exprLlvmType(e.tryExpr());
            if (terminated_ == 0) emitBr(mergeB);
            // 异常路径：绑定 catch 变量（string 消息拷贝）
            openBlock(catchB);
            if (Str.len(e.catchVarName()) != 0) {
                string err = newTmp();
                sb_.append("  " + err + " = call ptr @myp_get_error()\n");
                string dup = newTmp();
                sb_.append("  " + dup + " = call ptr @myp_strdup(ptr " + err + ")\n");
                string ev = entryAlloca("ptr");
                sb_.append("  store ptr null, ptr " + ev + "\n");
                sb_.append("  store ptr " + dup + ", ptr " + ev + "\n");
                localNames_.add(e.catchVarName());
                localTypes_.add("ptr");
                localAstTypes_.add(null);
                localAllocas_.add(ev);
                localElemTypes_.add("");
                localIsSlice_.add(0);
                localIsArc_.add(1);
                arcSlotNames_.add(ev);
            }
            string v2 = genExpr(e.catchExpr());
            string t2 = exprLlvmType(e.catchExpr());
            if (terminated_ == 0) emitBr(mergeB);
            // merge：phi 汇合
            openBlock(mergeB);
            if (t2 != t1) v2 = convertValue(v2, t2, t1);
            string phi = newTmp();
            sb_.append("  " + phi + " = phi " + t1 + " [ " + v1 + ", %" + tryB + " ], [ " + v2 + ", %" + catchB + " ]\n");
            sb_.append("  call void @myp_exception_pop()\n");
            return phi;
        }

        // 表达式 → LLVM 类型。
        string exprLlvmType(AstExpr e) {
            if (e == null) return "i32";
            string k = e.kind();
            if (k == "Integer") {
                if (e.isChar() != 0) return "i8";
                if (e.isUnsigned() != 0) {
                    long v = e.value();
                    if (v <= 255L) return "i8";
                    if (v <= 65535L) return "i16";
                    if (v <= 4294967295L) return "i32";
                    return "i64";
                }
                if (e.isLong() != 0) return "i64";
                long v = e.value();
                if (v >= -2147483648L && v <= 2147483647L) return "i32";
                return "i64";
            }
            if (k == "Float") {
                if (e.f32() != 0) return "float";
                return "double";
            }
            if (k == "Bool") return "i1";
            if (k == "String") return "ptr";
            if (k == "Null") return "ptr";
            if (k == "This") return "ptr";
            if (k == "Lambda") return "{ ptr, ptr }";
            if (k == "NamedArg") return exprLlvmType(e.namedValue());
            if (k == "Binary") {
                string op = e.op();
                // 比较/逻辑运算产物恒为 i1（泛型函数内 resolvedKind 为 int，
                // 但 codegen 的 genExpr 仍产出 i1 → 不能按 resolvedKind 判）
                if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">="
                    || op == "&&" || op == "||") return "i1";
                // 字符串拼接 → ptr
                AstExpr lhs = e.lhs();
                AstExpr rhs = e.rhs();
                if (op == "+") {
                    int ls = (lhs != null && lhs.resolvedKind() == "string") ? 1 : 0;
                    int rs = (rhs != null && rhs.resolvedKind() == "string") ? 1 : 0;
                    if (ls != 0 || rs != 0) return "ptr";
                }
                // bitvector 位运算/移位 → 与左操作数同宽（iN）
                if (e.resolvedKind() == "bitvector" && lhs != null) {
                    return exprLlvmType(lhs);
                }
                return IrEmit.kindType(e.resolvedKind());
            }
            if (k == "Tuple") {
                StringBuilder ty = new StringBuilder();
                ty.append("{ ");
                for (int i = 0; i < e.elements().size(); i = i + 1) {
                    if (i != 0) ty.append(", ");
                    ty.append(exprLlvmType(e.elements().get(i)));
                }
                ty.append(" }");
                return ty.toString();
            }
            if (k == "Unary") {
                if (e.op() == "!") return "i1";
                return exprLlvmType(e.operand());
            }
            if (k == "Convert") {
                if (e.toKind() == "bit") return "i1";
                if (Str.startsWith(e.toKind(), "bitvector") != 0) return "i" + e.bw();
                return IrEmit.kindType(e.toKind());
            }
            if (k == "Identifier") {
                string nm = e.name();
                if (hasVar(nm) != 0) return varType(nm);
                if (hasMember(nm) != 0) {
                    string ft = propType(curClass_, nm);
                    if (isFixedArrayLt(ft) != 0) return "ptr";
                    return ft;
                }
                return varType(nm);
            }
            if (k == "Member") {
                // bitfield 字段：bit → i1；bit[N] → uint/i32
                if (Str.len(e.resolvedClass()) != 0 && isBitfieldName(e.resolvedClass()) != 0) {
                    if (e.resolvedKind() == "bit") return "i1";
                    return "i32";
                }
                if (isDigits(e.memberName()) != 0) {
                    return IrEmit.kindType(e.resolvedKind());
                }
                string ft = memberFieldType(e);
                if (isFixedArrayLt(ft) != 0) return "ptr";
                return ft;
            }
            if (k == "Call") {
                // 元组返回调用 → 匿名结构体类型（否则 kindType("tuple")=ptr 错）
                if (e.resolvedKind() == "tuple") {
                    AstExpr callee = e.callee();
                    if (callee != null && callee.kind() == "Identifier") {
                        AstType rt = findFuncRetAstType(callee.name(), e.args().size());
                        if (rt != null && rt.isTuple() != 0) {
                            return llvmType(rt);
                        }
                    }
                }
                // 枚举变体构造 → { i32, [N x i8] }（枚举名在 callee.resolvedClass_）
                if (e.resolvedKind() == "enum") {
                    AstExpr callee = e.callee();
                    if (callee != null && callee.kind() == "Member" && Str.len(callee.resolvedClass()) != 0) {
                        return enumLlvmType(callee.resolvedClass());
                    }
                }
                // 内建 FFI 固定签名（泛型模板体内 resolvedKind 被标 int）
                AstExpr callee2 = e.callee();
                if (callee2 != null && callee2.kind() == "Identifier"
                    && Str.startsWith(callee2.name(), "__myp_math_") != 0) {
                    string mn = callee2.name();
                    if (mn == "__myp_math_abs_int") return "i32";
                    if (mn == "__myp_math_pow" || mn == "__myp_math_atan2") return "double";
                    // §9.5 一元多态数学：返回类型 = 实参 LLVM 类型
                    //（abs 整型→整型；其余整型实参提为 double）。
                    if (e.args().size() > 0) {
                        string at = exprLlvmType(e.args().get(0));
                        if (mn == "__myp_math_abs") return at;
                        if (IrEmit.isIntType(at) != 0) return "double";
                        return at;
                    }
                    return "double";
                }
                if (callee2 != null && callee2.kind() == "Identifier"
                    && (callee2.name() == "__myp_atof" || callee2.name() == "__myp_io_read_double")) {
                    return "double";
                }
                // P2 位操作原语：返回类型 = 实参 LLVM 宽度（byte 字面量按 i32 物化）
                if (callee2 != null && callee2.kind() == "Identifier") {
                    string bn = callee2.name();
                    if (bn == "popcount" || bn == "clz" || bn == "ctz" || bn == "bitreverse"
                        || bn == "rotl" || bn == "rotr") {
                        if (e.args().size() > 0) return exprLlvmType(e.args().get(0));
                    }
                }
                // P3 §4.2 checkedAdd/checkedMul → { iN, i1 }（公共位宽）
                if (callee2 != null && callee2.kind() == "Identifier"
                    && (callee2.name() == "checkedAdd" || callee2.name() == "checkedMul")) {
                    string at0 = e.args().size() > 0 ? exprLlvmType(e.args().get(0)) : "i32";
                    string at1 = e.args().size() > 1 ? exprLlvmType(e.args().get(1)) : "i32";
                    string ct = IrEmit.intWidth(at0) >= IrEmit.intWidth(at1) ? at0 : at1;
                    return "{ " + ct + ", i1 }";
                }
                // P4 §6.2 parseIntOpt → { i32, i1 }
                if (callee2 != null && callee2.kind() == "Identifier" && callee2.name() == "parseIntOpt") {
                    return "{ i32, i1 }";
                }
                // struct 返回调用 → %Name（值类型，非 ptr）
                string sname = callRetStructName(e);
                if (Str.len(sname) != 0) return "%" + sname;
                // slice 返回调用 → { ptr, i64 } fat pointer（kindType("slice")=ptr 错）
                if (e.resolvedKind() == "slice") return "{ ptr, i64 }";
                return IrEmit.kindType(e.resolvedKind());
            }
            if (k == "Subscript") {
                if (e.resolvedKind() == "bit") return "i1";   // bitvector<N>[i]
                // string 下标 s[i] : char（i8）
                AstExpr sarr = e.array();
                if (sarr != null && sarr.resolvedKind() == "string") return "i8";
                return subscriptElemLt(sarr);
            }
            if (k == "New") {
                if (e.className() == "slice") return "{ ptr, i64 }";
                return "ptr";
            }
            return IrEmit.kindType(e.resolvedKind());
        }

        // 变量（参数/局部）对应的 alloca 名。局部后声明遮蔽先声明（last match）。
        string varAlloca(string name) {
            for (int i = localNames_.size() - 1; i >= 0; i = i - 1) {
                if (localNames_.get(i) == name) return localAllocas_.get(i);
            }
            for (int i = 0; i < paramNames_.size(); i = i + 1) {
                if (paramNames_.get(i) == name) return "%" + name + ".addr";
            }
            return "%" + name;
        }

        // 变量（参数/局部）的 LLVM 类型。
        string varType(string name) {
            for (int i = localNames_.size() - 1; i >= 0; i = i - 1) {
                if (localNames_.get(i) == name) return localTypes_.get(i);
            }
            for (int i = 0; i < paramNames_.size(); i = i + 1) {
                if (paramNames_.get(i) == name) return paramTypes_.get(i);
            }
            return "i32";
        }

        // 变量（参数/局部）的完整 AstType（函数类型调用/元素类型等）。
        AstType varAstType(string name) {
            for (int i = localNames_.size() - 1; i >= 0; i = i - 1) {
                if (localNames_.get(i) == name) return localAstTypes_.get(i);
            }
            for (int i = 0; i < paramNames_.size(); i = i + 1) {
                if (paramNames_.get(i) == name) return paramAstTypes_.get(i);
            }
            return null;
        }

        // 局部数组变量的元素 LLVM 类型（非数组返回 i32）。
        string varElemType(string name) {
            for (int i = localNames_.size() - 1; i >= 0; i = i - 1) {
                if (localNames_.get(i) == name) {
                    string et = localElemTypes_.get(i);
                    if (Str.len(et) != 0) return et;
                    return "i32";
                }
            }
            // slice 参数：元素类型取自参数 AST 类型
            for (int i = 0; i < paramNames_.size(); i = i + 1) {
                if (paramNames_.get(i) == name) {
                    AstType pt = paramAstTypes_.get(i);
                    if (pt != null && isSliceType(pt) != 0) return sliceElemType(pt);
                    return "i32";
                }
            }
            return "i32";
        }

        // name 是否为 slice 局部变量。
        int isSliceVar(string name) {
            for (int i = localNames_.size() - 1; i >= 0; i = i - 1) {
                if (localNames_.get(i) == name) return localIsSlice_.get(i);
            }
            // slice 参数：按参数 AST 类型识别（参数无 localIsSlice_ 表项）
            for (int i = 0; i < paramNames_.size(); i = i + 1) {
                if (paramNames_.get(i) == name) {
                    AstType pt = paramAstTypes_.get(i);
                    if (pt != null && isSliceType(pt) != 0) return 1;
                    return 0;
                }
            }
            return 0;
        }

        // name 是否为 ARC 计数引用局部（string/类/动态数组）。
        int varIsArc(string name) {
            for (int i = localNames_.size() - 1; i >= 0; i = i - 1) {
                if (localNames_.get(i) == name) return localIsArc_.get(i);
            }
            return 0;
        }

        // new slice<T>(n)：myp_alloc_slice_backing + 构造 {data, len} fat pointer。
        string genSliceNew(AstExpr e) {
            AstType et = e.typeArgs().size() > 0 ? e.typeArgs().get(0) : null;
            string elemLt = llvmType(et);
            int elemSize = IrEmit.typeSize(elemLt);
            string nv = genExpr(e.args().get(0));
            string nt = exprLlvmType(e.args().get(0));
            string n64 = convertValue(nv, nt, "i64");
            int elemKind = arrayElemKind(et);
            string data = newTmp();
            sb_.append("  " + data + " = call ptr @myp_alloc_slice_backing(i64 " + n64 + ", i32 " + elemSize + ", i32 " + elemKind + ")\n");
            // 零初始化（类/字符串元素未填槽须为 null）
            string bs = newTmp();
            sb_.append("  " + bs + " = mul i64 " + n64 + ", " + elemSize + "\n");
            sb_.append("  call void @llvm.memset.p0.i64(ptr " + data + ", i8 0, i64 " + bs + ", i1 false)\n");
            string p0 = newTmp();
            sb_.append("  " + p0 + " = insertvalue { ptr, i64 } poison, ptr " + data + ", 0\n");
            string p1 = newTmp();
            sb_.append("  " + p1 + " = insertvalue { ptr, i64 } " + p0 + ", i64 " + n64 + ", 1\n");
            return p1;
        }

        // 动态数组元素类别（同 C++ generateNewExpr slice 分支）：
        // 0 = 类/字符串引用（销毁时逐元素释放），1 = 标量，2 = 嵌套 slice。
        // 注意：泛型占位 T 不解析为具体类型（同 C++ isArcClassType/isStringType
        // 对占位符返回 false），故 new T[n] 恒为 1——与参考端字节一致。
        int arrayElemKind(AstType et) {
            if (et == null) return 1;
            if (et.str() == "string") return 0;
            if (et.className() == "slice") return 2;
            if (Str.len(et.className()) != 0) {
                if (et.typeArgs().size() > 0) {
                    string inst = classInstName(et);
                    if (isClassName(inst) != 0) return 0;
                    return 1;
                }
                if (isClassName(et.className()) != 0) return 0;
            }
            return 1;
        }

        // name 是否为类名（@static 类方法调用判断）。
        int isClassName(string name) {
            if (tu_ == null) return 0;
            for (int i = 0; i < tu_.classes().size(); i = i + 1) {
                if (tu_.classes().get(i).name() == name) return 1;
            }
            return 0;
        }

        // name 是否为接口名。
        int isInterfaceName(string name) {
            if (tu_ == null || Str.len(name) == 0) return 0;
            for (int i = 0; i < tu_.interfaces().size(); i = i + 1) {
                if (tu_.interfaces().get(i).name() == name) return 1;
            }
            return 0;
        }

        // 接口名 → 方法名 → vtable 索引（-1 未找到）。
        int interfaceMethodIndex(string ifaceName, string methodName) {
            if (tu_ == null) return -1;
            for (int i = 0; i < tu_.interfaces().size(); i = i + 1) {
                AstInterface ifc = tu_.interfaces().get(i);
                if (ifc.name() != ifaceName) continue;
                for (int ai = 0; ai < ifc.actions().size(); ai = ai + 1) {
                    if (ifc.actions().get(ai).name() == methodName) return ai;
                }
            }
            return -1;
        }

        // cls 类是否实现了 iface 接口（AstClass.iface_）。
        int classImplements(string cls, string iface) {
            if (tu_ == null) return 0;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() == cls && c.iface() == iface) return 1;
            }
            return 0;
        }

        // 接口名 → AstType（className 置为接口名，供 varAstType 识别接口局部）。
        AstType ifaceAstType(string name) {
            AstType t = new AstType();
            t.setClassName(name);
            return t;
        }

        // name 是否为枚举名。
        int isEnumName(string name) {
            if (tu_ == null || Str.len(name) == 0) return 0;
            for (int i = 0; i < tu_.enums().size(); i = i + 1) {
                if (tu_.enums().get(i).name() == name) return 1;
            }
            return 0;
        }

        // name 是否为 struct 名（顶层 + 类内嵌套）。
        int isStructName(string name) {
            if (tu_ == null || Str.len(name) == 0) return 0;
            for (int i = 0; i < tu_.structs().size(); i = i + 1) {
                if (tu_.structs().get(i).name() == name) return 1;
            }
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                for (int si = 0; si < tu_.classes().get(ci).structs().size(); si = si + 1) {
                    if (tu_.classes().get(ci).structs().get(si).name() == name) return 1;
                }
            }
            return 0;
        }

        // name 是否为 bitfield 名。
        int isBitfieldName(string name) {
            if (tu_ == null || Str.len(name) == 0) return 0;
            for (int i = 0; i < tu_.bitfields().size(); i = i + 1) {
                if (tu_.bitfields().get(i).name() == name) return 1;
            }
            return 0;
        }

        // bitfield 总位数（0 = 未知）。
        int bitfieldTotalBits(string name) {
            for (int i = 0; i < tu_.bitfields().size(); i = i + 1) {
                if (tu_.bitfields().get(i).name() == name) return tu_.bitfields().get(i).totalBits();
            }
            return 0;
        }

        // bitfield 字段偏移（bit）。
        int bitfieldFieldOffset(string name, string member) {
            for (int i = 0; i < tu_.bitfields().size(); i = i + 1) {
                AstBitfield bf = tu_.bitfields().get(i);
                if (bf.name() != name) continue;
                for (int fi = 0; fi < bf.fields().size(); fi = fi + 1) {
                    if (bf.fields().get(fi).name() == member) return bf.fields().get(fi).offset();
                }
            }
            return 0;
        }

        // bitfield 字段位宽（1 = 单 bit）。
        int bitfieldFieldWidth(string name, string member) {
            for (int i = 0; i < tu_.bitfields().size(); i = i + 1) {
                AstBitfield bf = tu_.bitfields().get(i);
                if (bf.name() != name) continue;
                for (int fi = 0; fi < bf.fields().size(); fi = fi + 1) {
                    if (bf.fields().get(fi).name() == member) return bf.fields().get(fi).width();
                }
            }
            return 1;
        }

        // bitfield 名 → LLVM 背衬整数类型（i8/i16/i32/i64）。
        string bitfieldLlvmType(string name) {
            int bits = bitfieldTotalBits(name);
            if (bits <= 8) return "i8";
            if (bits <= 16) return "i16";
            if (bits <= 32) return "i32";
            return "i64";
        }

        // bitfield 对象的背衬槽地址（局部 alloca / this.f GEP / arr[i] 元素 GEP）。
        string bitfieldSlotAddr(AstExpr obj) {
            if (obj == null) return "";
            if (obj.kind() == "Identifier") return varAlloca(obj.name());
            if (obj.kind() == "Member") return memberAddr(obj);
            if (obj.kind() == "Subscript") return subscriptElemAddr(obj.array(), obj.index());
            return "";
        }

        // bitfield 对象的背衬 LLVM 类型（i8/i16/i32）。
        string bitfieldBackingType(AstExpr obj) {
            if (obj == null) return "i8";
            if (obj.kind() == "Identifier") {
                AstType oat = varAstType(obj.name());
                if (oat != null) {
                    AstType rt = resolveType(oat);
                    if (rt != null && Str.len(rt.className()) != 0 && isBitfieldName(rt.className()) != 0) {
                        return bitfieldLlvmType(rt.className());
                    }
                }
                return varType(obj.name());
            }
            if (obj.kind() == "Member") return memberFieldType(obj);
            if (obj.kind() == "Subscript") return subscriptElemLt(obj.array());
            return "i8";
        }

        // struct 字段索引（按声明顺序）。
        int structFieldIndex(string name, string field) {
            if (tu_ == null) return 0;
            for (int i = 0; i < tu_.structs().size(); i = i + 1) {
                AstStruct st = tu_.structs().get(i);
                if (st.name() != name) continue;
                for (int pi = 0; pi < st.props().size(); pi = pi + 1) {
                    if (st.props().get(pi).name() == field) return pi;
                }
                return 0;
            }
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                for (int si = 0; si < tu_.classes().get(ci).structs().size(); si = si + 1) {
                    AstStruct st = tu_.classes().get(ci).structs().get(si);
                    if (st.name() != name) continue;
                    for (int pi = 0; pi < st.props().size(); pi = pi + 1) {
                        if (st.props().get(pi).name() == field) return pi;
                    }
                }
            }
            return 0;
        }

        // struct 字段 LLVM 类型。
        string structFieldType(string name, string field) {
            if (tu_ == null) return "i32";
            for (int i = 0; i < tu_.structs().size(); i = i + 1) {
                AstStruct st = tu_.structs().get(i);
                if (st.name() != name) continue;
                for (int pi = 0; pi < st.props().size(); pi = pi + 1) {
                    if (st.props().get(pi).name() == field) return llvmType(st.props().get(pi).type());
                }
                return "i32";
            }
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                for (int si = 0; si < tu_.classes().get(ci).structs().size(); si = si + 1) {
                    AstStruct st = tu_.classes().get(ci).structs().get(si);
                    if (st.name() != name) continue;
                    for (int pi = 0; pi < st.props().size(); pi = pi + 1) {
                        if (st.props().get(pi).name() == field) return llvmType(st.props().get(pi).type());
                    }
                }
            }
            return "i32";
        }

        // struct 字段 AstType（ARC 判断用）。
        AstType structFieldAstType(string name, string field) {
            if (tu_ == null) return null;
            for (int i = 0; i < tu_.structs().size(); i = i + 1) {
                AstStruct st = tu_.structs().get(i);
                if (st.name() != name) continue;
                for (int pi = 0; pi < st.props().size(); pi = pi + 1) {
                    if (st.props().get(pi).name() == field) return st.props().get(pi).type();
                }
                return null;
            }
            return null;
        }

        // 发射 struct 类型定义（%Point = type { ... }）。
        void emitStructTypes() {
            if (tu_ == null) return;
            ArrayList<string> done = new ArrayList<string>();
            for (int i = 0; i < tu_.structs().size(); i = i + 1) {
                AstStruct st = tu_.structs().get(i);
                int dup = 0;
                for (int di = 0; di < done.size(); di = di + 1) {
                    if (done.get(di) == st.name()) { dup = 1; break; }
                }
                if (dup != 0) continue;
                done.add(st.name());
                StringBuilder m = new StringBuilder();
                m.append("%" + st.name() + " = type {");
                for (int pi = 0; pi < st.props().size(); pi = pi + 1) {
                    if (pi != 0) m.append(", ");
                    m.append(llvmType(st.props().get(pi).type()));
                }
                if (st.props().size() == 0) m.append(" i8");
                m.append(" }\n");
                sb_.append(m.toString());
            }
        }

        // 枚举结构体 LLVM 类型（匿名字面量，同 C++ getEnumStructType）：
        // { i32 } 或 { i32, [max_payload x i8] }。
        string enumLlvmType(string name) {
            int maxp = enumMaxPayload(name);
            if (maxp > 0) return "{ i32, [" + maxp + " x i8] }";
            return "{ i32 }";
        }

        // 枚举最大载荷字节数（各 variant 参数字节和的最大值）。
        int enumMaxPayload(string name) {
            if (tu_ == null) return 0;
            int maxp = 0;
            for (int i = 0; i < tu_.enums().size(); i = i + 1) {
                AstEnum en = tu_.enums().get(i);
                if (en.name() != name) continue;
                for (int vi = 0; vi < en.variants().size(); vi = vi + 1) {
                    int sz = 0;
                    AstEnumVariant v = en.variants().get(vi);
                    for (int pi = 0; pi < v.params().size(); pi = pi + 1) {
                        sz = sz + IrEmit.typeSize(llvmType(v.params().get(pi).type()));
                    }
                    if (sz > maxp) maxp = sz;
                }
                break;
            }
            return maxp;
        }

        // 枚举 variant 名 → 索引（-1 未找到）。
        int enumVariantIndex(string enumName, string variantName) {
            if (tu_ == null) return -1;
            for (int i = 0; i < tu_.enums().size(); i = i + 1) {
                AstEnum en = tu_.enums().get(i);
                if (en.name() != enumName) continue;
                for (int vi = 0; vi < en.variants().size(); vi = vi + 1) {
                    if (en.variants().get(vi).name() == variantName) return vi;
                }
            }
            return -1;
        }

        // 枚举 variant 的字段偏移（字节，字段 idx 之前所有参数字节和）。
        int enumPayloadOffset(string enumName, int variantIndex, int fieldIdx) {
            if (tu_ == null) return 0;
            for (int i = 0; i < tu_.enums().size(); i = i + 1) {
                AstEnum en = tu_.enums().get(i);
                if (en.name() != enumName) continue;
                if (variantIndex < 0 || variantIndex >= en.variants().size()) return 0;
                AstEnumVariant v = en.variants().get(variantIndex);
                int off = 0;
                for (int pi = 0; pi < fieldIdx && pi < v.params().size(); pi = pi + 1) {
                    off = off + IrEmit.typeSize(llvmType(v.params().get(pi).type()));
                }
                return off;
            }
            return 0;
        }

        // 类 → 编译期异常 type_id（1 起；0 = string）。与 C++ class_type_ids_
        // 一致：按 tu.classes 顺序、泛型模板跳过、按名去重。
        int classTypeId(string name) {
            if (tu_ == null || Str.len(name) == 0) return 0;
            int tid = 0;
            ArrayList<string> seen = new ArrayList<string>();
            for (int i = 0; i < tu_.classes().size(); i = i + 1) {
                AstClass c = tu_.classes().get(i);
                if (c.typeParams().size() != 0 && c.isGenericInst() == 0) continue;
                int dup = 0;
                for (int di = 0; di < seen.size(); di = di + 1) {
                    if (seen.get(di) == c.name()) { dup = 1; break; }
                }
                if (dup != 0) continue;
                seen.add(c.name());
                tid = tid + 1;
                if (c.name() == name) return tid;
            }
            return 0;
        }

        // 类名列表（type id 顺序，供 __myp_type_name_table / max_type_id）。
        ArrayList<string> classTypeNames() {
            ArrayList<string> out = new ArrayList<string>();
            if (tu_ == null) return out;
            ArrayList<string> seen = new ArrayList<string>();
            for (int i = 0; i < tu_.classes().size(); i = i + 1) {
                AstClass c = tu_.classes().get(i);
                if (c.typeParams().size() != 0 && c.isGenericInst() == 0) continue;
                int dup = 0;
                for (int di = 0; di < seen.size(); di = di + 1) {
                    if (seen.get(di) == c.name()) { dup = 1; break; }
                }
                if (dup != 0) continue;
                seen.add(c.name());
                out.add(c.name());
            }
            return out;
        }

        // 类数量（type id 上限）。不经过 classTypeNames().size()（方法返回值
        // 上调用 .size() 会落到裸 ArrayList_size，见 §接口）；本地 seen.size() 正常。
        int classTypeCount() {
            if (tu_ == null) return 0;
            int n = 0;
            ArrayList<string> seen = new ArrayList<string>();
            for (int i = 0; i < tu_.classes().size(); i = i + 1) {
                AstClass c = tu_.classes().get(i);
                if (c.typeParams().size() != 0 && c.isGenericInst() == 0) continue;
                int dup = 0;
                for (int di = 0; di < seen.size(); di = di + 1) {
                    if (seen.get(di) == c.name()) { dup = 1; break; }
                }
                if (dup != 0) continue;
                seen.add(c.name());
                n = n + 1;
            }
            return n;
        }

        // 发射 __myp_release_table / __myp_max_type_id / __myp_type_name_table。
        // 有类时 release_table 须 ≥ max_tid+1（myp_release 按 tid 索引，越界=UB）。
        void emitTypeIdGlobals() {
            ArrayList<string> names = classTypeNames();
            int n = names.size();
            StringBuilder sb = new StringBuilder();
            sb.append("@__myp_max_type_id = constant i32 " + n + "\n");
            // 类名字符串全局（private，无 ARC 头；myp_type_name 用 myp_strdup 拷贝）
            ArrayList<string> gvs = new ArrayList<string>();
            for (int i = 0; i < names.size(); i = i + 1) {
                string nm = names.get(i);
                string gv = "@__myp_tn_" + nm;
                sb.append(gv + " = private constant [" + (Str.len(nm) + 1) + " x i8] c\"" + nm + "\\00\"\n");
                gvs.add(gv);
            }
            StringBuilder tbl = new StringBuilder();
            tbl.append("@__myp_type_name_table = constant [" + (n + 1) + " x ptr] [ptr null");
            for (int i = 0; i < gvs.size(); i = i + 1) {
                string nm = names.get(i);
                tbl.append(", ptr getelementptr inbounds ([" + (Str.len(nm) + 1) + " x i8], ptr " + gvs.get(i) + ", i32 0, i32 0)");
            }
            tbl.append("]\n");
            sb.append(tbl.toString());
            stringGlobals_.append(sb.toString());
        }

        // ARC：每类 destroy stub（级联释放引用字段）+ __myp_release_table
        //（C++ generateArcSupport）。destroy 释放字段后 myp_free_object 释放对象头。
        void emitArcSupport() {
            ArrayList<string> names = classTypeNames();
            int n = names.size();
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < n; i = i + 1) {
                string cls = names.get(i);
                int ci = -1;
                for (int cj = 0; cj < tu_.classes().size(); cj = cj + 1) {
                    if (tu_.classes().get(cj).name() == cls) { ci = cj; break; }
                }
                if (ci < 0) continue;
                AstClass c = tu_.classes().get(ci);
                sb.append("define void @__myp_destroy_" + cls + "(ptr %self) {\nentry:\n");
                for (int pi = 0; pi < c.props().size(); pi = pi + 1) {
                    AstProp prop = c.props().get(pi);
                    AstType pt = prop.type();
                    if (pt == null) continue;
                    AstType rt = resolveType(pt);
                    string gep = newTmp();
                    sb.append("  " + gep + " = getelementptr %" + cls + ", ptr %self, i32 0, i32 " + pi + "\n");
                    if (prop.weak() != 0) {
                        sb.append("  call void @myp_weak_clear(ptr " + gep + ")\n");
                        continue;
                    }
                    if (rt != null && rt.element() != null && rt.arraySize() == 0) {
                        // 动态数组 T[] → 释放计数 backing
                        string v = newTmp();
                        sb.append("  " + v + " = load ptr, ptr " + gep + "\n");
                        sb.append("  call i32 @myp_release(ptr " + v + ")\n");
                    } else if (rt != null && rt.className() == "slice") {
                        string fv = newTmp();
                        sb.append("  " + fv + " = load { ptr, i64 }, ptr " + gep + "\n");
                        string data = newTmp();
                        sb.append("  " + data + " = extractvalue { ptr, i64 } " + fv + ", 0\n");
                        sb.append("  call i32 @myp_release(ptr " + data + ")\n");
                    } else if (rt != null && Str.len(rt.className()) != 0 && isInterfaceName(rt.className()) != 0) {
                        string fv = newTmp();
                        sb.append("  " + fv + " = load { ptr, ptr }, ptr " + gep + "\n");
                        string data = newTmp();
                        sb.append("  " + data + " = extractvalue { ptr, ptr } " + fv + ", 0\n");
                        sb.append("  call i32 @myp_release(ptr " + data + ")\n");
                    } else if (rt != null && (rt.str() == "string"
                        || (Str.len(rt.className()) != 0 && isEnumName(rt.className()) == 0
                            && isStructName(rt.className()) == 0 && isBitfieldName(rt.className()) == 0))) {
                        // string / 类实例引用
                        string v = newTmp();
                        sb.append("  " + v + " = load ptr, ptr " + gep + "\n");
                        sb.append("  call i32 @myp_release(ptr " + v + ")\n");
                    }
                }
                sb.append("  call void @myp_free_object(ptr %self)\n");
                sb.append("  ret void\n}\n");
            }
            StringBuilder rel = new StringBuilder();
            rel.append("@__myp_release_table = global [" + (n + 1) + " x ptr] [ptr null");
            for (int i = 0; i < n; i = i + 1) {
                rel.append(", ptr @__myp_destroy_" + names.get(i));
            }
            rel.append("]\n");
            sb.append(rel.toString());
            sb_.append(sb.toString());
        }

        // 发射接口 vtable（__myp_vtable_<iface>_<cls>）+ Error 接口查找表
        // __myp_error_vtables（type_id → vtable；null = 该类未实现 Error）。
        void emitInterfaceVTables() {
            if (tu_ == null) return;
            StringBuilder sb = new StringBuilder();
            ArrayList<string> doneVt = new ArrayList<string>();
            for (int ii = 0; ii < tu_.interfaces().size(); ii = ii + 1) {
                AstInterface ifc = tu_.interfaces().get(ii);
                for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                    AstClass cls = tu_.classes().get(ci);
                    if (cls.iface() != ifc.name()) continue;
                    if (cls.typeParams().size() != 0 && cls.isGenericInst() == 0) continue;
                    string vkey = ifc.name() + "_" + cls.name();
                    int dup = 0;
                    for (int di = 0; di < doneVt.size(); di = di + 1) {
                        if (doneVt.get(di) == vkey) { dup = 1; break; }
                    }
                    if (dup != 0) continue;
                    doneVt.add(vkey);
                    StringBuilder arr = new StringBuilder();
                    arr.append("@__myp_vtable_" + vkey + " = internal constant [" + ifc.actions().size() + " x ptr] [");
                    for (int ai = 0; ai < ifc.actions().size(); ai = ai + 1) {
                        AstAction ia = ifc.actions().get(ai);
                        if (ai != 0) arr.append(", ");
                        string vfn = cls.name() + "_" + ia.name();
                        // trait 默认实现：类未实现但接口方法带默认体 → 回退默认函数
                        // （__ifdef_<iface>_<method>_<cls>，同 C++ getOrCreateVtable）
                        if (hasMethodInClass(cls.name(), ia.name()) == 0 && ia.body() != null) {
                            vfn = "__ifdef_" + ifc.name() + "_" + ia.name() + "_" + cls.name();
                        }
                        arr.append("ptr @" + vfn);
                    }
                    arr.append("]\n");
                    sb.append(arr.toString());
                }
            }
            // __myp_error_vtables：仅当本 TU 声明了 Error 接口
            if (isInterfaceName("Error") != 0) {
                ArrayList<string> names = classTypeNames();
                int n = names.size();
                StringBuilder ev = new StringBuilder();
                ev.append("@__myp_error_vtables = internal constant [" + (n + 1) + " x ptr] [ptr null");
                for (int i = 0; i < n; i = i + 1) {
                    if (classImplements(names.get(i), "Error") != 0) {
                        ev.append(", ptr @__myp_vtable_Error_" + names.get(i));
                    } else {
                        ev.append(", ptr null");
                    }
                }
                ev.append("]\n");
                sb.append(ev.toString());
            }
            stringGlobals_.append(sb.toString());
        }

        // cls 类是否存在名为 name 的方法（action 或 function 段）。
        int hasMethodInClass(string cls, string name) {
            if (tu_ == null || Str.len(cls) == 0) return 0;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int ai = 0; ai < c.actions().size(); ai = ai + 1) {
                    if (c.actions().get(ai).name() == name) return 1;
                }
                for (int fi = 0; fi < c.funcs().size(); fi = fi + 1) {
                    if (c.funcs().get(fi).name() == name) return 1;
                }
                return 0;
            }
            return 0;
        }

        // cls 是否有名为 name 的事件。
        int hasEventInClass(string cls, string name) {
            if (tu_ == null || Str.len(cls) == 0) return 0;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int ei = 0; ei < c.events().size(); ei = ei + 1) {
                    if (c.events().get(ei).name() == name) return 1;
                }
                return 0;
            }
            return 0;
        }

        // 全局事件 ID（按类序、类内事件序编号；与 C++ event_id_map_ 一致，
        // 泛型模板跳过 + 按名去重，保证 fire 函数与注册用同一 ID）。
        int eventId(string cls, string ev) {
            if (tu_ == null) return 0;
            int eid = 0;
            ArrayList<string> seen = new ArrayList<string>();
            for (int i = 0; i < tu_.classes().size(); i = i + 1) {
                AstClass c = tu_.classes().get(i);
                if (c.typeParams().size() != 0 && c.isGenericInst() == 0) continue;
                int dup = 0;
                for (int di = 0; di < seen.size(); di = di + 1) {
                    if (seen.get(di) == c.name()) { dup = 1; break; }
                }
                if (dup != 0) continue;
                seen.add(c.name());
                for (int ei = 0; ei < c.events().size(); ei = ei + 1) {
                    if (c.name() == cls && c.events().get(ei).name() == ev) return eid;
                    eid = eid + 1;
                }
            }
            return 0;
        }

        // 找拥有事件 evName 的类（优先按类名 srcClass，回退全类名搜）。
        string findEventClass(string srcClass, string evName) {
            if (tu_ == null) return "";
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (Str.len(srcClass) != 0 && c.name() != srcClass) continue;
                for (int ei = 0; ei < c.events().size(); ei = ei + 1) {
                    if (c.events().get(ei).name() == evName) return c.name();
                }
            }
            if (Str.len(srcClass) != 0) {
                for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                    AstClass c = tu_.classes().get(ci);
                    for (int ei = 0; ei < c.events().size(); ei = ei + 1) {
                        if (c.events().get(ei).name() == evName) return c.name();
                    }
                }
            }
            return "";
        }

        // 事件参数列表（按类名 + 事件名）。
        AstEvent findEvent(string clsName, string evName) {
            if (tu_ == null) return null;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != clsName) continue;
                for (int ei = 0; ei < c.events().size(); ei = ei + 1) {
                    if (c.events().get(ei).name() == evName) return c.events().get(ei);
                }
                return null;
            }
            return null;
        }

        // 类是否有静态 action name（mapping 目标为静态方法时无需实例指针）。
        int isStaticAction(string cls, string name) {
            if (tu_ == null) return 0;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != cls) continue;
                for (int ai = 0; ai < c.staticActions().size(); ai = ai + 1) {
                    if (c.staticActions().get(ai).name() == name) return 1;
                }
                return 0;
            }
            return 0;
        }

        // name 是否为顶层函数或 FFI。
        int isTopLevelFunc(string name) {
            if (tu_ == null) return 0;
            for (int i = 0; i < tu_.functions().size(); i = i + 1) {
                if (tu_.functions().get(i).name() == name) return 1;
            }
            for (int i = 0; i < tu_.ffis().size(); i = i + 1) {
                if (tu_.ffis().get(i).name() == name) return 1;
            }
            return 0;
        }

        // name 是否为当前函数作用域内的变量（参数或局部）。
        int hasVar(string name) {
            for (int i = 0; i < paramNames_.size(); i = i + 1) {
                if (paramNames_.get(i) == name) return 1;
            }
            for (int i = 0; i < localNames_.size(); i = i + 1) {
                if (localNames_.get(i) == name) return 1;
            }
            return 0;
        }

        // name 是否为当前类的属性成员。
        int hasMember(string name) {
            if (Str.len(curClass_) == 0 || tu_ == null) return 0;
            for (int ci = 0; ci < tu_.classes().size(); ci = ci + 1) {
                AstClass c = tu_.classes().get(ci);
                if (c.name() != curClass_) continue;
                for (int pi = 0; pi < c.props().size(); pi = pi + 1) {
                    if (c.props().get(pi).name() == name) return 1;
                }
                return 0;
            }
            return 0;
        }

        // load this 指针（实例方法内）。
        string loadThis() {
            string t = newTmp();
            sb_.append("  " + t + " = load ptr, ptr %this.addr, align 8\n");
            return t;
        }

        // this.field 的地址（实例方法内裸属性名）。
        string thisMemberAddr(string field) {
            string thisV = loadThis();
            string cls = curClass_;
            int idx = propIndex(cls, field);
            string gep = newTmp();
            sb_.append("  " + gep + " = getelementptr %" + cls + ", ptr " + thisV + ", i32 0, i32 " + idx + "\n");
            return gep;
        }

        // double 常量 → LLVM 浮点文本（%e 格式，与 mypc --emit-llvm 一致）。
        string floatLiteral(double v) {
            return myp_fmt_double_e(v, 6);
        }

        // 字符串字面量 → 全局常量 + GEP 到 data ptr。
        // M8：immortal counted string { rc=0x7FFFFFFF, type_id=0xFFFFFFFE, [N x i8] }。
        string stringLiteral(string val) {
            int n = Str.len(val);
            string gvName = "@str";
            if (strCounter_ > 0) gvName = "@str." + strCounter_;
            strCounter_ = strCounter_ + 1;
            string sz = "" + (n + 1);
            string body = escapeLlvmString(val);
            stringGlobals_.append(gvName + " = private unnamed_addr global { i32, i32, [" + sz + " x i8] } { i32 2147483647, i32 -2, [" + sz + " x i8] c\"" + body + "\\00\" }\n");
            return "getelementptr ({ i32, i32, [" + sz + " x i8] }, ptr " + gvName + ", i32 0, i32 2)";
        }

        // LLVM c"..." 转义（\0A 换行 \09 tab \0D CR \22 引号 \5C 反斜杠 \00 NUL）。
        string escapeLlvmString(string s) {
            StringBuilder sb = new StringBuilder();
            string hex = "0123456789ABCDEF";
            for (int i = 0; i < Str.len(s); i = i + 1) {
                int c = __myp_ord(Str.substring(s, i, i + 1));
                if (c == 10) sb.append("\\0A");
                else if (c == 9) sb.append("\\09");
                else if (c == 13) sb.append("\\0D");
                else if (c == 34) sb.append("\\22");
                else if (c == 92) sb.append("\\5C");
                else if (c >= 32 && c < 127) sb.append(__myp_chr(c));
                else {
                    sb.append("\\");
                    sb.append(__myp_chr(__myp_ord(Str.substring(hex, c / 16, c / 16 + 1))));
                    sb.append(__myp_chr(__myp_ord(Str.substring(hex, c % 16, c % 16 + 1))));
                }
            }
            return sb.toString();
        }

        StringBuilder sb() { return sb_; }
        int tmp() { return tmp_; }
        ArrayList<string> paramNames() { return paramNames_; }
        ArrayList<string> paramTypes() { return paramTypes_; }
        ArrayList<AstType> paramAstTypes() { return paramAstTypes_; }
        ArrayList<string> localNames() { return localNames_; }
        ArrayList<string> localTypes() { return localTypes_; }
        ArrayList<AstType> localAstTypes() { return localAstTypes_; }
        ArrayList<string> localAllocas() { return localAllocas_; }
        ArrayList<string> localElemTypes() { return localElemTypes_; }
        ArrayList<int> localIsSlice() { return localIsSlice_; }
        int isMainFunc() { return isMainFunc_; }
        string curBlock() { return curBlock_; }
        int blockCounter() { return blockCounter_; }
        int terminated() { return terminated_; }
        string curRetLt() { return curRetLt_; }
        ArrayList<string> loopBreak() { return loopBreak_; }
        ArrayList<string> loopContinue() { return loopContinue_; }
        StringBuilder stringGlobals() { return stringGlobals_; }
        int strCounter() { return strCounter_; }
        AstTU tu() { return tu_; }
        string curClass() { return curClass_; }
        ArrayList<string> cellOwnerNames() { return cellOwnerNames_; }
        ArrayList<string> cellOwnerVals() { return cellOwnerVals_; }
        ArrayList<string> curTypeParams() { return curTypeParams_; }
        ArrayList<AstType> curTypeArgs() { return curTypeArgs_; }
        ArrayList<string> pendingTemps() { return pendingTemps_; }
        ArrayList<string> arcSlotNames() { return arcSlotNames_; }
        ArrayList<string> sliceSlotNames() { return sliceSlotNames_; }
        StringBuilder entryAllocas() { return entryAllocas_; }
        ArrayList<int> localIsArc() { return localIsArc_; }
        ArrayList<FinallyCtx> finallyStack() { return finallyStack_; }
        string finallyRetSlot() { return finallyRetSlot_; }
        ArrayList<int> tryArcBases() { return tryArcBases_; }
        ArrayList<string> threadHandles() { return threadHandles_; }
        StringBuilder mappingInitCalls() { return mappingInitCalls_; }
        StringBuilder mappingHandlers() { return mappingHandlers_; }
        ArrayList<string> instanceGlobals() { return instanceGlobals_; }
        int curFnScope() { return curFnScope_; }
        int testMode() { return testMode_; }
        int curFnCoro() { return curFnCoro_; }
        int curFnRegion() { return curFnRegion_; }
        string curRegionMark() { return curRegionMark_; }
        int parallelCounter() { return parallelCounter_; }
        StringBuilder parallelBodies() { return parallelBodies_; }
    property:
        StringBuilder sb_;
        int tmp_;
        ArrayList<string> paramNames_;
        ArrayList<string> paramTypes_;
        ArrayList<AstType> paramAstTypes_;
        ArrayList<string> localNames_;
        ArrayList<string> localTypes_;
        ArrayList<AstType> localAstTypes_;
        ArrayList<string> localAllocas_;
        ArrayList<string> localElemTypes_;
        ArrayList<int> localIsSlice_;
        int isMainFunc_;
        string curBlock_;
        int blockCounter_;
        int terminated_;
        string curRetLt_;
        ArrayList<string> loopBreak_;
        ArrayList<string> loopContinue_;
        StringBuilder stringGlobals_;
        int strCounter_;
        AstTU tu_;
        string curClass_;
        ArrayList<string> cellOwnerNames_;
        ArrayList<string> cellOwnerVals_;
        ArrayList<string> curTypeParams_;
        ArrayList<AstType> curTypeArgs_;
        ArrayList<string> pendingTemps_;
        ArrayList<string> arcSlotNames_;
        ArrayList<string> sliceSlotNames_;
        StringBuilder entryAllocas_;
        ArrayList<int> localIsArc_;
        ArrayList<FinallyCtx> finallyStack_;
        string finallyRetSlot_;
        ArrayList<int> tryArcBases_;
        ArrayList<string> threadHandles_;
        StringBuilder mappingInitCalls_;
        StringBuilder mappingHandlers_;
        ArrayList<string> instanceGlobals_;
        int curFnScope_;
        int testMode_;
        int curFnCoro_;
        int curFnRegion_;
        string curRegionMark_;
        int parallelCounter_;
        StringBuilder parallelBodies_;
}
