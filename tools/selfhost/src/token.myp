// token.myp — 词法 token 表示（F1）
//
// 对拍基准: src/token.cpp + canonicalTokenKindName（tools/selfhost/format.md §3）。
// Tok 直接携带 dump 所需字段：canonical kind 名、value、begin/end 偏移。
// 关键约定（C++ 语义，必须字节级复刻）：
//   - 关键字/类型/算子 token 的 kind = 单词/算子原文（如 "class"/"int"/"+="/"("）；
//   - 字面量 kind = "integer"/"long"/"uint"/"float"/"float32"/"string"/"char"；
//   - 标识符 "identifier"、EOF "eof"；
//   - 关键字/类型/标识符 token 的 value = 单词原文；算子/标点 value = ""。

// 单个 token。
class Tok {
    action:
        @constructor Tok(string k, string v, int b, int e) {
            kind_ = k;
            value_ = v;
            begin_ = b;
            end_ = e;
        }
        string kind() { return kind_; }
        string value() { return value_; }
        int begin() { return begin_; }
        int end() { return end_; }
        void setLineCol(int l, int c) { line_ = l; col_ = c; }
        int line() { return line_; }
        int col() { return col_; }
    property:
        string kind_;
        string value_;
        int begin_;
        int end_;
        int line_;
        int col_;
}

// 关键字/类型判定：命中则 canonical kind = 单词本身，否则 "identifier"。
// 列表与 src/lexer/lexer.cpp scanIdentifierOrKeyword 逐项对齐。
@static class TokKind {
    static:
        int isKeywordOrType(string w) {
            if (w == "class" || w == "action" || w == "event" || w == "property"
                || w == "interface" || w == "import" || w == "mapping" || w == "struct"
                || w == "function" || w == "static" || w == "if" || w == "else"
                || w == "while" || w == "for" || w == "return" || w == "break"
                || w == "continue" || w == "true" || w == "false" || w == "null"
                || w == "this" || w == "new" || w == "void" || w == "var" || w == "enum"
                || w == "match" || w == "ffi" || w == "try" || w == "catch"
                || w == "finally" || w == "throw" || w == "where" || w == "await"
                || w == "const" || w == "ref" || w == "operator" || w == "macro"
                || w == "nonlocal" || w == "bitfield") return 1;
            if (w == "byte" || w == "short" || w == "int" || w == "long" || w == "ubyte"
                || w == "ushort" || w == "uint" || w == "ulong" || w == "uint8"
                || w == "uint16" || w == "uint32" || w == "uint64" || w == "int8"
                || w == "int16" || w == "int32" || w == "int64" || w == "char"
                || w == "float" || w == "double" || w == "float4" || w == "double2"
                || w == "int4" || w == "bool" || w == "string" || w == "bit"
                || w == "bitvector") return 1;
            return 0;
        }
}

