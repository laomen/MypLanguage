import env;

class Counter {
    action:
        void init(int start) {
            this.value = start;
        }
        void increment() {
            this.value = this.value + 1;
        }
        int getValue() {
            return this.value;
        }
    property:
        int value;
}

int main() {
    Counter c;
    c = new Counter();
    c.init(42);
    int result = c.getValue();
    printInt(result);
    return result;
}
