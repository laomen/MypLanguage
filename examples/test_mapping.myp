import env;

class Sensor {
    action:
        void setValue(int v) {
            this.value = v;
        }
        int getValue() {
            return this.value;
        }
    event:
        valueReady(int v);
    property:
        int value;
}

class Display {
    action:
        void show(int v) {
            printInt(v);
        }
    event:
        done();
    property:
        int lastValue;
}

// Type-level mapping: Sensor.valueReady triggers Display.show
mapping() {
    Sensor.valueReady -> Display.show;
}

int main() {
    Sensor s;
    Display d;
    Logger l;

    // Create objects
    s = new Sensor();
    d = new Display();

    // Manually wire via direct method call
    s.setValue(99);
    int val = s.getValue();
    d.show(val);

    return val;
}
