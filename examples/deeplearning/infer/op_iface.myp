// op_iface.myp — 阶段4e POC：算子拆开，用 interface 实现（前向+后向双方法）
//
// 演示：把「巨型 if/else 分发」里的算子体搬进各自独立的类，实现统一接口
//   interface IOp {
//       void forward(InferenceRuntime rt, int opIdx);    // 前向
//       void backward(InferenceRuntime rt, int opIdx);   // 后向（训练梯度）
//   }
// 一个算子类同时实现前向与后向（如 ad.myp 的 IOp{forward,backward} 算子模式）。
// runtime 分发时按 opKind 查表：前向 opKind → forward()，反向 opKind → backward()。
// 注册用 registerFwdBwd(fwdKind, bwdKind, op, isGpu) 把同一实例放进前向/反向两个槽。
//
// 本文件迁移 relu：CPU ReluOp + GPU GpuReluOp（opKind 2 前向 / 51 反向）+
// registerIfaceOps(rt)。其余算子见 ops_iface_all.myp（阶段4e3 全量迁移）。
// 阶段4e4 起 run()/runGpu() 已删 if/else、只留接口分派（首调自动 registerAllIfaceOps）。
import env;
import "./runtime.myp";
import "./ops.myp";
import "./gpu_ops.myp";

// ---- relu（opKind 2 前向 / 51 反向），CPU ----
class ReluOp {
    interface class IOp;
    action:
        // 前向：y = relu(x)
        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i);
            int yb = rt.opBAt(i);
            InferOps.relu(rt.arenaRef(), rt.tensorOff(xa), rt.tensorOff(yb), rt.tensorRows(xa) * rt.tensorCols(xa));
        }
        // 后向：dX = dY · (x>0)；仅训练模式（trainMode_=1）执行
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dy = rt.opAAt(i);
                int x = rt.opBAt(i);
                int dx = rt.opCAt(i);
                InferOps.bwdRelu(rt.arenaRef(), rt.tensorOff(dy), rt.tensorOff(x), rt.tensorOff(dx), rt.tensorRows(x) * rt.tensorCols(x));
            }
        }
}

// ---- relu（opKind 2 前向 / 51 反向），GPU（@gpu for 内核）----
class GpuReluOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i);
            int yb = rt.opBAt(i);
            GpuInferOps.relu(rt.arenaRef(), rt.tensorRows(xa) * rt.tensorCols(xa), rt.tensorOff(xa), rt.tensorOff(yb), rt.devRef());
        }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dy = rt.opAAt(i);
                int x = rt.opBAt(i);
                int dx = rt.opCAt(i);
                GpuInferOps.bwdRelu(rt.arenaRef(), rt.devRef(), rt.tensorOff(dy), rt.tensorOff(x), rt.tensorOff(dx), rt.tensorRows(x) * rt.tensorCols(x));
            }
        }
}

// ---- 注册：relu 前向(2) + 反向(51)，CPU 与 GPU 各一个算子对象（同一实例进两个槽）----
void registerIfaceOps(InferenceRuntime rt) {
    rt.registerFwdBwd(2, 51, new ReluOp(), 0);
    rt.registerFwdBwd(2, 51, new GpuReluOp(), 1);
}
