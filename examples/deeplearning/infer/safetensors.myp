// safetensors.myp — 纯 MYP safetensors 权重读取器
// 格式：8B header_size(LE) + JSON header + 张量数据（data_offsets 为数据段字节偏移）。
// 仅解析 header 元数据；按张量读数据时 seek 到绝对偏移 + 按 dtype 转 float。
// 支持 dtype：F32 / BF16 / F16（BF16→F32 = bits<<16；F16 用标准 half 解码）。
// 读取 API：readF32All(i) / readF32AllByName(name) 整张量读入新 float[]；
//          readF32Into(i, dst, dstOff) 整张量读入调用方数组指定偏移（模型装配直写 arena）；
//          readF32Range(i, start, out, count) 部分读；readF32(i, out, maxN) 起读。
// 读取底层：load() 时 mmap 整个文件（stdlib/mmap.myp），readF32RangeAt 走 mmap
//          零拷贝读；mmap 不可用时回退 fread 逐字节。
// 用途：直接加载 HuggingFace 权重（如 qwen2-0.5b-instruct/model.safetensors），
//       替代 extract_*.py 转自定义 .bin 的流程。
import env;
import math;
import mmap;
import "./pb.myp";   // F32 位型↔double

class SafeTensors {
    action:
        @constructor SafeTensors() { count_ = 0; path_ = ""; mm_ = new MmapFile(); }

        // 加载并解析 header。返回 1=成功。
        int load(string path) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return 0;
            // 8 字节 header_size（小端）
            long hsize = 0;
            int k = 0;
            while (k < 8) {
                int b = __myp_io_read_byte();
                if (b < 0) { __myp_io_fclose(); return 0; }
                hsize = hsize | (long(b) << (k * 8));
                k = k + 1;
            }
            if (hsize <= 0 || hsize > 67108864L) { __myp_io_fclose(); return 0; }
            // 读 header 字节
            int hl = int(hsize);
            ubyte[] hb = new ubyte[hl];
            k = 0;
            while (k < hl) {
                int b = __myp_io_read_byte();
                if (b < 0) { __myp_io_fclose(); return 0; }
                hb[k] = ubyte(b);
                k = k + 1;
            }
            __myp_io_fclose();
            header_ = str(hb);
            headerLen_ = Str.len(header_);
            path_ = path;
            dataBase_ = 8 + hsize;
            // 元数据动态数组（按 header 长度估容量；类内固定数组零初始化会致 opt 指数爆炸）
            int cap = headerLen_ / 25 + 64;
            if (cap < 64) cap = 64;
            cap_ = cap;
            name_ = new string[cap];
            dtype_ = new string[cap];
            rank_ = new int[cap];
            dims_ = new int[cap * 4];
            byteOff_ = new long[cap];
            byteLen_ = new long[cap];
            count_ = 0;
            pos_ = 0;
            parseHeader();
            // mmap 整个文件：张量数据零拷贝读（失败则 readF32RangeAt 回退 fread）
            mm_.open(path);
            return 1;
        }

        int tensorCount() { return count_; }
        string tensorName(int i) { if (i < 0 || i >= count_) return ""; return name_[i]; }
        string tensorDtype(int i) { if (i < 0 || i >= count_) return ""; return dtype_[i]; }
        int tensorRank(int i) { if (i < 0 || i >= count_) return 0; return rank_[i]; }
        int tensorDim(int i, int d) {
            if (i < 0 || i >= count_ || d < 0 || d >= rank_[i]) return 0;
            return dims_[i * 4 + d];
        }
        long tensorByteOff(int i) { if (i < 0 || i >= count_) return 0; return byteOff_[i]; }
        long tensorByteLen(int i) { if (i < 0 || i >= count_) return 0; return byteLen_[i]; }

        // 张量名 → 下标（找不到 -1）
        int findTensor(string name) {
            int i = 0;
            while (i < count_) {
                if (name_[i] == name) return i;
                i = i + 1;
            }
            return -1;
        }

        // 张量元素总数（shape 乘积）
        int tensorElemCount(int i) {
            if (i < 0 || i >= count_) return 0;
            int n = 1;
            int d = 0;
            while (d < rank_[i]) { n = n * dims_[i * 4 + d]; d = d + 1; }
            return n;
        }

        // 按名称读张量为 float[]（F32/BF16/F16→float），最多 maxN 元素。
        // 返回读入元素数（失败 0）。
        int readF32ByName(string name, float[] out, int maxN) {
            int i = findTensor(name);
            if (i < 0) return 0;
            return readF32(i, out, maxN);
        }

        // 读张量 [startElem, startElem+count) 元素到 out（F32/BF16/F16→float）。
        // 返回读入元素数（失败 0）；startElem 越界或 dtype 不支持返回 0。
        int readF32Range(int i, int startElem, float[] out, int count) {
            return readF32RangeAt(i, startElem, out, 0, count);
        }

        // 读整个张量到 dst[dstOff..dstOff+n)（F32/BF16/F16→float）。返回读入元素数。
        // 供模型装配直接写入 arena 指定偏移（免中间数组拷贝）。
        int readF32Into(int i, float[] dst, int dstOff) {
            int n = tensorElemCount(i);
            if (i < 0 || i >= count_ || n <= 0 || dstOff < 0) return 0;
            string dt = dtype_[i];
            if (dt != "F32" && dt != "BF16" && dt != "F16") return 0;
            return readF32RangeAt(i, 0, dst, dstOff, n);
        }

        // 核心：读 [startElem, startElem+count) 到 out[outOff + j]（F32/BF16/F16→float）
        int readF32RangeAt(int i, int startElem, float[] out, int outOff, int count) {
            if (i < 0 || i >= count_) return 0;
            int n = tensorElemCount(i);
            if (n <= 0 || startElem < 0 || startElem >= n || count <= 0 || outOff < 0) return 0;
            string dt = dtype_[i];
            if (dt != "F32" && dt != "BF16" && dt != "F16") return 0;
            int elemSize = 2;
            if (dt == "F32") elemSize = 4;
            int limit = n - startElem;
            if (limit > count) limit = count;
            int j = 0;
            if (mm_.base() > 0) {
                // mmap 零拷贝路径（免 fopen/fseek/fread）；off 为文件相对偏移
                long base = byteOff_[i] + long(startElem) * elemSize;
                if (dt == "F32") {
                    while (j < limit) {
                        out[outOff + j] = float(F32.toDouble(mm_.i32(base + long(j) * 4)));
                        j = j + 1;
                    }
                } else if (dt == "BF16") {
                    while (j < limit) {
                        long a = base + long(j) * 2;
                        int bf = (mm_.u8(a) | (mm_.u8(a + 1) << 8)) & 65535;
                        int bits = bf << 16;   // BF16→F32 = bits<<16
                        out[outOff + j] = float(F32.toDouble(bits));
                        j = j + 1;
                    }
                } else {   // F16
                    while (j < limit) {
                        long a = base + long(j) * 2;
                        int h = (mm_.u8(a) | (mm_.u8(a + 1) << 8)) & 65535;
                        int bits = halfToF32Bits(h);
                        out[outOff + j] = float(F32.toDouble(bits));
                        j = j + 1;
                    }
                }
                return j;
            }
            // 回退：fread 逐字节（mmap 不可用时）
            long off = byteOff_[i] + long(startElem) * elemSize;
            int fd = __myp_io_fopen(path_, "rb");
            if (fd < 0) return 0;
            __myp_io_seek(int(off), 0);   // 绝对偏移（int32；safetensors 文件 <2GB）
            if (dt == "F32") {
                while (j < limit) {
                    int b0 = __myp_io_read_byte(); int b1 = __myp_io_read_byte();
                    int b2 = __myp_io_read_byte(); int b3 = __myp_io_read_byte();
                    if (b3 < 0) break;
                    int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                    out[outOff + j] = float(F32.toDouble(bits));
                    j = j + 1;
                }
            } else if (dt == "BF16") {
                while (j < limit) {
                    int b0 = __myp_io_read_byte(); int b1 = __myp_io_read_byte();
                    if (b1 < 0) break;
                    int bf = (b0 | (b1 << 8)) & 65535;
                    int bits = bf << 16;   // BF16 位型左移 16 位 = 同值 F32 位型
                    out[outOff + j] = float(F32.toDouble(bits));
                    j = j + 1;
                }
            } else {   // F16
                while (j < limit) {
                    int b0 = __myp_io_read_byte(); int b1 = __myp_io_read_byte();
                    if (b1 < 0) break;
                    int h = (b0 | (b1 << 8)) & 65535;
                    out[outOff + j] = float(F32.toDouble(halfToF32Bits(h)));
                    j = j + 1;
                }
            }
            __myp_io_fclose();
            return j;
        }

        // 从张量起始读最多 maxN 元素（部分读；out 由调用方分配）。
        int readF32(int i, float[] out, int maxN) {
            return readF32Range(i, 0, out, maxN);
        }

        // 读整个张量为新分配的 float[]（按张量元素数分配；F32/BF16/F16→float）。
        // 失败/不支持 dtype 返回空数组；调用方用 tensorElemCount(i) 取元素数。
        float[] readF32All(int i) {
            int n = tensorElemCount(i);
            if (i < 0 || i >= count_ || n <= 0) return new float[0];
            string dt = dtype_[i];
            if (dt != "F32" && dt != "BF16" && dt != "F16") return new float[0];
            float[] out = new float[n];
            readF32Range(i, 0, out, n);
            return out;
        }

        // 按名称读整个张量（失败返回空数组）。
        float[] readF32AllByName(string name) {
            int i = findTensor(name);
            if (i < 0) return new float[0];
            return readF32All(i);
        }

    function:
        // ---- 最小 JSON header 解析器（safetensors 固定 schema，无转义依赖）----
        void skipWs() {
            while (pos_ < headerLen_) {
                int c = __myp_charcode(header_, pos_);
                if (c == 32 || c == 9 || c == 10 || c == 13) pos_ = pos_ + 1;
                else break;
            }
        }
        string parseStr() {
            if (pos_ >= headerLen_ || __myp_charcode(header_, pos_) != 34) return "";
            pos_ = pos_ + 1;
            int start = pos_;
            while (pos_ < headerLen_) {
                if (__myp_charcode(header_, pos_) == 34) {
                    string r = Str.substring(header_, start, pos_);
                    pos_ = pos_ + 1;
                    return r;
                }
                pos_ = pos_ + 1;
            }
            return "";
        }
        long parseNum() {
            long v = 0;
            while (pos_ < headerLen_) {
                int c = __myp_charcode(header_, pos_);
                if (c >= 48 && c <= 57) { v = v * 10 + long(c - 48); pos_ = pos_ + 1; }
                else break;
            }
            return v;
        }
        // 跳过任意 JSON 值（对象/数组/标量），游标停在值后
        void skipValue() {
            skipWs();
            if (pos_ >= headerLen_) return;
            int c = __myp_charcode(header_, pos_);
            if (c == 123 || c == 91) {
                int open = c;
                int close = (c == 123) ? 125 : 93;
                int depth = 0;
                while (pos_ < headerLen_) {
                    int x = __myp_charcode(header_, pos_);
                    if (x == open) depth = depth + 1;
                    else if (x == close) { depth = depth - 1; pos_ = pos_ + 1; if (depth == 0) return; continue; }
                    pos_ = pos_ + 1;
                }
            } else {
                while (pos_ < headerLen_) {
                    int x = __myp_charcode(header_, pos_);
                    if (x == 44 || x == 125 || x == 93) return;
                    pos_ = pos_ + 1;
                }
            }
        }
        void parseHeader() {
            while (pos_ < headerLen_ && __myp_charcode(header_, pos_) != 123) pos_ = pos_ + 1;
            pos_ = pos_ + 1;   // '{'
            while (pos_ < headerLen_) {
                skipWs();
                int c = __myp_charcode(header_, pos_);
                if (c == 125) { pos_ = pos_ + 1; return; }
                if (c == 44) { pos_ = pos_ + 1; continue; }
                if (c == 34) {
                    string key = parseStr();
                    skipWs();
                    if (pos_ < headerLen_ && __myp_charcode(header_, pos_) == 58) pos_ = pos_ + 1;
                    skipWs();
                    if (key == "__metadata__") skipValue();
                    else parseTensorEntry(key);
                } else {
                    pos_ = pos_ + 1;
                }
            }
        }
        void parseTensorEntry(string key) {
            skipWs();
            if (pos_ >= headerLen_ || __myp_charcode(header_, pos_) != 123) return;
            pos_ = pos_ + 1;   // '{'
            string dt = "";
            int rk = 0;
            int d0 = 1; int d1 = 1; int d2 = 1; int d3 = 1;
            long off0 = 0; long off1 = 0;
            while (pos_ < headerLen_) {
                skipWs();
                int c = __myp_charcode(header_, pos_);
                if (c == 125) { pos_ = pos_ + 1; break; }
                if (c == 44) { pos_ = pos_ + 1; continue; }
                if (c == 34) {
                    string f = parseStr();
                    skipWs();
                    if (pos_ < headerLen_ && __myp_charcode(header_, pos_) == 58) pos_ = pos_ + 1;
                    skipWs();
                    if (f == "dtype") {
                        dt = parseStr();
                    } else if (f == "shape") {
                        if (pos_ < headerLen_ && __myp_charcode(header_, pos_) == 91) pos_ = pos_ + 1;
                        int dc = 0;
                        while (pos_ < headerLen_) {
                            skipWs();
                            int x = __myp_charcode(header_, pos_);
                            if (x == 93) { pos_ = pos_ + 1; break; }
                            if (x == 44) { pos_ = pos_ + 1; continue; }
                            long v = parseNum();
                            if (dc == 0) d0 = int(v); else if (dc == 1) d1 = int(v);
                            else if (dc == 2) d2 = int(v); else if (dc == 3) d3 = int(v);
                            dc = dc + 1;
                        }
                        rk = dc;
                    } else if (f == "data_offsets") {
                        if (pos_ < headerLen_ && __myp_charcode(header_, pos_) == 91) pos_ = pos_ + 1;
                        int dc = 0;
                        while (pos_ < headerLen_) {
                            skipWs();
                            int x = __myp_charcode(header_, pos_);
                            if (x == 93) { pos_ = pos_ + 1; break; }
                            if (x == 44) { pos_ = pos_ + 1; continue; }
                            long v = parseNum();
                            if (dc == 0) off0 = v; else off1 = v;
                            dc = dc + 1;
                        }
                    } else {
                        skipValue();
                    }
                } else {
                    pos_ = pos_ + 1;
                }
            }
            name_[count_] = key;
            dtype_[count_] = dt;
            rank_[count_] = rk;
            dims_[count_ * 4 + 0] = d0;
            dims_[count_ * 4 + 1] = d1;
            dims_[count_ * 4 + 2] = d2;
            dims_[count_ * 4 + 3] = d3;
            if (count_ >= cap_) return;
            byteOff_[count_] = dataBase_ + off0;
            byteLen_[count_] = off1 - off0;
            count_ = count_ + 1;
        }
        // IEEE half (F16) → F32 位型
        int halfToF32Bits(int h) {
            int sign = (h >> 15) & 1;
            int exp = (h >> 10) & 31;
            int man = h & 1023;
            if (exp == 0) {
                if (man == 0) return sign << 31;
                int e = -14;
                while ((man & 1024) == 0) { man = man << 1; e = e - 1; }
                man = man & 1023;
                exp = e + 127;
            } else if (exp == 31) {
                return (sign << 31) | (255 << 23) | (man << 13);
            } else {
                exp = exp - 15 + 127;
            }
            return (sign << 31) | (exp << 23) | (man << 13);
        }

    property:
        string[] name_;
        string[] dtype_;
        int[] rank_;
        int[] dims_;
        long[] byteOff_;
        long[] byteLen_;
        int count_;
        int cap_;
        string path_;
        long dataBase_;
        string header_;
        int headerLen_;
        int pos_;
        MmapFile mm_;
}
