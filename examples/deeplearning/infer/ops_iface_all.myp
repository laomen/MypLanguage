// ---- conv（opKind 7 前向 / 56 反向；2D NCHW）----
class ConvOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i); int wb = rt.opBAt(i); int bc = rt.opCAt(i); int yd = rt.opDAt(i);
            int bOff = -1; if (bc >= 0) bOff = rt.tensorOff(bc);
            InferOps.conv(rt.arenaRef(),
                rt.tensorOff(xa), rt.tensorN(xa), rt.tensorC(xa), rt.tensorH(xa), rt.tensorW(xa),
                rt.tensorOff(wb), bOff,
                rt.tensorOff(yd), rt.tensorC(yd), rt.tensorH(yd), rt.tensorW(yd),
                rt.tensorH(wb), rt.tensorW(wb),
                rt.opP0At(i), rt.opP1At(i), rt.opP2At(i), rt.opP3At(i), rt.opP4At(i), rt.opP5At(i),
                rt.opP6At(i), rt.opP7At(i), rt.opP8At(i));
        }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dy = rt.opAAt(i); int x = rt.opBAt(i); int w = rt.opCAt(i); int dx = rt.opDAt(i);
                int dw = rt.opP0At(i); int db = rt.opP1At(i);
                int dbOff = -1; if (db >= 0) dbOff = rt.tensorOff(db);
                InferOps.bwdConv(rt.arenaRef(), rt.tensorOff(dy), rt.tensorOff(x),
                                 rt.tensorN(x), rt.tensorC(x), rt.tensorH(x), rt.tensorW(x),
                                 rt.tensorOff(w), rt.tensorOff(dx), rt.tensorOff(dw), dbOff,
                                 rt.tensorC(dy), rt.tensorH(dy), rt.tensorW(dy),
                                 rt.tensorH(w), rt.tensorW(w),
                                 rt.opP2At(i), rt.opP3At(i), rt.opP4At(i), rt.opP5At(i), rt.opP6At(i), rt.opP7At(i), rt.opP8At(i));
            }
        }
}

// ---- maxpool（opKind 8 前向 / 57 反向）----
class MaxpoolOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i); int yd = rt.opBAt(i);
            InferOps.maxpool(rt.arenaRef(),
                rt.tensorOff(xa), rt.tensorN(xa), rt.tensorC(xa), rt.tensorH(xa), rt.tensorW(xa),
                rt.tensorOff(yd), rt.tensorH(yd), rt.tensorW(yd),
                rt.opP0At(i), rt.opP1At(i), rt.opP2At(i), rt.opP3At(i), rt.opP4At(i), rt.opP5At(i), rt.opP6At(i), rt.opP7At(i));
        }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dy = rt.opAAt(i); int x = rt.opBAt(i); int dx = rt.opCAt(i);
                InferOps.bwdMaxPool(rt.arenaRef(), rt.tensorOff(dy), rt.tensorOff(x),
                                    rt.tensorN(x), rt.tensorC(x), rt.tensorH(x), rt.tensorW(x),
                                    rt.tensorOff(dx), rt.tensorH(dy), rt.tensorW(dy),
                                    rt.opP0At(i), rt.opP1At(i), rt.opP2At(i), rt.opP3At(i), rt.opP4At(i), rt.opP5At(i));
            }
        }
}

