// ---- softmaxCE（GPU，训练专用）----
class GpuSoftmaxCeOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) { }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int lg = rt.opAAt(i); int lb = rt.opBAt(i); int dl = rt.opCAt(i); int lo = rt.opDAt(i);
                GpuInferOps.softmaxCE(rt.arenaRef(), rt.devRef(), rt.tensorOff(lg), rt.tensorOff(lb), rt.tensorRows(lg), rt.tensorCols(lg), rt.tensorOff(dl), rt.tensorOff(lo));
            }
        }
}

// ---- update（GPU，训练专用）----
class GpuUpdateOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) { }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int w = rt.opAAt(i); int g = rt.opBAt(i);
                int n = rt.tensorSize(w);
                double lr = rt.lrRef();
                double decay = lr * rt.optWd();
                int mode = rt.optMode();
                int mOff = rt.optOffAt(w);
                if (mode == 0) {
                    GpuInferOps.updateSGD(rt.arenaRef(), rt.devRef(), rt.tensorOff(w), rt.tensorOff(g), n, lr, decay);
                } else if (mode == 1) {
                    GpuInferOps.updateMom(rt.arenaRef(), rt.devRef(), rt.tensorOff(w), rt.tensorOff(g), mOff, n, lr, decay);
                } else {
                    double t = double(rt.optStep());
                    double bc1 = 1.0 - Math.pow(0.9, t);
                    double bc2 = 1.0 - Math.pow(0.999, t);
                    GpuInferOps.updateAdamW(rt.arenaRef(), rt.devRef(), rt.tensorOff(w), rt.tensorOff(g), mOff, n, lr, decay, bc1, bc2);
                }
            }
        }
}

// ---- diceLoss（GPU，训练专用）----
class GpuDiceLossOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) { }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int p = rt.opAAt(i); int y = rt.opBAt(i); int dp = rt.opCAt(i); int lo = rt.opDAt(i);
                GpuInferOps.diceLoss(rt.arenaRef(), rt.devRef(), rt.statsOffRef(), rt.tensorOff(p), rt.tensorOff(y), rt.tensorOff(dp), rt.tensorOff(lo),
                                     rt.tensorRows(p), rt.tensorCols(p), rt.opP1At(i));
            }
        }
}

// ---- concat 反向（opKind 72；5D U-Net 跳跃连接，CPU）----
// 反向图生成独立 BwdConcat 节点（dy → dx0/dx1/dx2），前向 ConcatOp(25) 的
// backward 保持空（concat 前向节点不承载反向）。
class BwdConcatOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) { }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dy = rt.opAAt(i);
                int dx0 = rt.opBAt(i); int dx1 = rt.opCAt(i); int dx2 = rt.opDAt(i);
                int dx2Off = -1; if (dx2 >= 0) dx2Off = rt.tensorOff(dx2);
                InferOps.bwdConcat(rt.arenaRef(), rt.tensorOff(dy), rt.tensorOff(dx0), rt.tensorOff(dx1), dx2Off,
                                   rt.opP0At(i), rt.opP1At(i), rt.opP2At(i), rt.opP3At(i), rt.opP4At(i), rt.opP5At(i),
                                   rt.opP6At(i), rt.opP7At(i), rt.opP8At(i));
            }
        }
}

// ---- concat 反向（GPU）----
class GpuBwdConcatOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) { }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dy = rt.opAAt(i);
                int dx0 = rt.opBAt(i); int dx1 = rt.opCAt(i); int dx2 = rt.opDAt(i);
                int dx2Off = -1; if (dx2 >= 0) dx2Off = rt.tensorOff(dx2);
                GpuInferOps.bwdConcat(rt.arenaRef(), rt.devRef(), rt.tensorOff(dy), rt.tensorOff(dx0), rt.tensorOff(dx1), dx2Off,
                                      rt.opP0At(i), rt.opP1At(i), rt.opP2At(i), rt.opP3At(i), rt.opP4At(i), rt.opP5At(i),
                                      rt.opP6At(i), rt.opP7At(i), rt.opP8At(i));
            }
        }
}

// ---- 全量注册：relu + 本文件所有算子（前向/反向 × CPU/GPU）----
// 61-71 全 opKind 均注册 CPU+GPU（2026-09-01 起含 LLM 61-67）→ run()/runGpu()
// 统一接口分派，无 if/else 回退。
void registerAllIfaceOps(InferenceRuntime rt) {
    registerIfaceOps(rt);   // relu（2/51，CPU+GPU）
    rt.registerFwdBwd(1, 50, new DenseOp(), 0);          rt.registerFwdBwd(1, 50, new GpuDenseOp(), 1);
    rt.registerFwdBwd(3, 70, new SoftmaxOp(), 0);        rt.registerFwdBwd(3, 70, new GpuSoftmaxOp(), 1);
    rt.registerFwdBwd(4, 52, new SigmoidOp(), 0);        rt.registerFwdBwd(4, 52, new GpuSigmoidOp(), 1);
    rt.registerFwdBwd(5, 53, new AddOp(), 0);            rt.registerFwdBwd(5, 53, new GpuAddOp(), 1);
    rt.registerFwd(6, new MatmulOp(), 0);                rt.registerFwd(6, new GpuMatmulOp(), 1);
    rt.registerFwdBwd(7, 56, new ConvOp(), 0);           rt.registerFwdBwd(7, 56, new GpuConvOp(), 1);
    rt.registerFwdBwd(8, 57, new MaxpoolOp(), 0);        rt.registerFwdBwd(8, 57, new GpuMaxpoolOp(), 1);
    rt.registerFwd(9, new GapoolOp(), 0);                rt.registerFwd(9, new GpuGapoolOp(), 1);
    rt.registerFwd(10, new FlattenOp(), 0);              rt.registerFwd(10, new GpuFlattenOp(), 1);
    rt.registerFwd(11, new ConvReluOp(), 0);             rt.registerFwd(11, new GpuConvReluOp(), 1);
    rt.registerFwd(12, new TransposeNchw2NhwcOp(), 0);   rt.registerFwd(12, new GpuTransposeNchw2NhwcOp(), 1);
    rt.registerFwd(13, new ConvNhwcOp(), 0);             rt.registerFwd(13, new GpuConvNhwcOp(), 1);
    rt.registerFwd(14, new ConvNhwcReluOp(), 0);         rt.registerFwd(14, new GpuConvNhwcReluOp(), 1);
    rt.registerFwd(15, new MaxpoolNhwcOp(), 0);          rt.registerFwd(15, new GpuMaxpoolNhwcOp(), 1);
    rt.registerFwd(16, new GapoolNhwcOp(), 0);           rt.registerFwd(16, new GpuGapoolNhwcOp(), 1);
    rt.registerFwd(17, new BatchnormOp(), 0);            rt.registerFwd(17, new GpuBatchnormOp(), 1);
    rt.registerFwd(18, new BatchnormNhwcOp(), 0);        rt.registerFwd(18, new GpuBatchnormNhwcOp(), 1);
    rt.registerFwd(19, new Relu6Op(), 0);                rt.registerFwd(19, new GpuRelu6Op(), 1);
    rt.registerFwd(20, new LeakyReluOp(), 0);            rt.registerFwd(20, new GpuLeakyReluOp(), 1);
    rt.registerFwd(21, new SiluOp(), 0);                 rt.registerFwd(21, new GpuSiluOp(), 1);
    rt.registerFwd(22, new HardSwishOp(), 0);            rt.registerFwd(22, new GpuHardSwishOp(), 1);
    rt.registerFwd(23, new ClipOp(), 0);                 rt.registerFwd(23, new GpuClipOp(), 1);
    rt.registerFwd(24, new ReshapeOp(), 0);              rt.registerFwd(24, new GpuReshapeOp(), 1);
    rt.registerFwd(25, new ConcatOp(), 0);               rt.registerFwd(25, new GpuConcatOp(), 1);
    rt.registerFwd(26, new TransposeOp(), 0);            rt.registerFwd(26, new GpuTransposeOp(), 1);
    rt.registerFwd(27, new SliceOp(), 0);                rt.registerFwd(27, new GpuSliceOp(), 1);
    rt.registerFwd(28, new Resize2dOp(), 0);             rt.registerFwd(28, new GpuResize2dOp(), 1);
    rt.registerFwd(29, new SplitOp(), 0);                rt.registerFwd(29, new GpuSplitOp(), 1);
    rt.registerFwd(30, new ReduceMeanOp(), 0);           rt.registerFwd(30, new GpuReduceMeanOp(), 1);
    rt.registerFwd(31, new SubOp(), 0);                  rt.registerFwd(31, new GpuSubOp(), 1);
    rt.registerFwd(32, new DivOp(), 0);                  rt.registerFwd(32, new GpuDivOp(), 1);
    rt.registerFwd(33, new MulOp(), 0);                  rt.registerFwd(33, new GpuMulOp(), 1);
    rt.registerFwd(34, new SqrtOp(), 0);                 rt.registerFwd(34, new GpuSqrtOp(), 1);
    rt.registerFwd(35, new InstanceNormOp(), 0);         rt.registerFwd(35, new GpuInstanceNormOp(), 1);
    rt.registerFwd(36, new AvgpoolOp(), 0);              rt.registerFwd(36, new GpuAvgpoolOp(), 1);
    rt.registerFwd(37, new AvgpoolNhwcOp(), 0);          rt.registerFwd(37, new GpuAvgpoolNhwcOp(), 1);
    rt.registerFwd(38, new PadOp(), 0);                  rt.registerFwd(38, new GpuPadOp(), 1);
    rt.registerFwd(39, new PadNhwcOp(), 0);              rt.registerFwd(39, new GpuPadNhwcOp(), 1);
    rt.registerFwdBwd(40, 68, new ConvTransposeOp(), 0); rt.registerFwdBwd(40, 68, new GpuConvTransposeOp(), 1);
    rt.registerFwdBwd(41, 58, new Conv3dOp(), 0);        rt.registerFwdBwd(41, 58, new GpuConv3dOp(), 1);
    rt.registerFwdBwd(42, 59, new Maxpool3dOp(), 0);     rt.registerFwdBwd(42, 59, new GpuMaxpool3dOp(), 1);
    rt.registerFwdBwd(43, 60, new Avgpool3dOp(), 0);     rt.registerFwdBwd(43, 60, new GpuAvgpool3dOp(), 1);
    rt.registerFwd(44, new Pad3dOp(), 0);                rt.registerFwd(44, new GpuPad3dOp(), 1);
    rt.registerFwdBwd(45, 71, new Resize3dOp(), 0);      rt.registerFwdBwd(45, 71, new GpuResize3dOp(), 1);
    // 训练专用（bwd 表）
    rt.registerBwd(54, new SoftmaxCeOp(), 0);            rt.registerBwd(54, new GpuSoftmaxCeOp(), 1);
    rt.registerBwd(55, new UpdateOp(), 0);               rt.registerBwd(55, new GpuUpdateOp(), 1);
    rt.registerBwd(69, new DiceLossOp(), 0);             rt.registerBwd(69, new GpuDiceLossOp(), 1);
    rt.registerBwd(72, new BwdConcatOp(), 0);            rt.registerBwd(72, new GpuBwdConcatOp(), 1);
    // LLM 算子（61-67，2026-09-01 起 CPU+GPU 全注册 → runGpu 统一分派）
    rt.registerFwd(61, new RmsNormOp(), 0);           rt.registerFwd(61, new GpuRmsNormOp(), 1);
    rt.registerFwd(62, new AttentionOp(), 0);         rt.registerFwd(62, new GpuAttentionOp(), 1);
    rt.registerFwd(63, new GatherRowsOp(), 0);        rt.registerFwd(63, new GpuGatherRowsOp(), 1);
    rt.registerFwd(64, new LayerNormOp(), 0);         rt.registerFwd(64, new GpuLayerNormOp(), 1);
    rt.registerFwd(65, new GeluOp(), 0);              rt.registerFwd(65, new GpuGeluOp(), 1);
    rt.registerFwd(66, new RopeOp(), 0);              rt.registerFwd(66, new GpuRopeOp(), 1);
    rt.registerFwd(67, new AttentionCachedOp(), 0);   rt.registerFwd(67, new GpuAttentionCachedOp(), 1);
}
