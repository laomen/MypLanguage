// ---- rope（GPU）----
class GpuRopeOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int x = rt.opAAt(i); int cos = rt.opBAt(i); int sin = rt.opCAt(i);
            int D = rt.opP0At(i); int S = rt.opP1At(i); int heads = rt.opP2At(i);
            GpuInferOps.rope(rt.arenaRef(), heads * (D / heads / 2) * S, rt.tensorOff(x), rt.tensorOff(cos),
                             rt.tensorOff(sin), D, S, heads, rt.devRef());
        }
        void backward(InferenceRuntime rt, int i) { }
}

