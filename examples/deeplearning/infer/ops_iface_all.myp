class DiceLossOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) { }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int p = rt.opAAt(i); int y = rt.opBAt(i); int dp = rt.opCAt(i); int lo = rt.opDAt(i);
                InferOps.diceLoss(rt.arenaRef(), rt.tensorOff(p), rt.tensorOff(y), rt.tensorOff(dp), rt.tensorOff(lo),
                                  rt.tensorRows(p), rt.tensorCols(p), rt.opP1At(i));
            }
        }
}

