// ---- convNHWC（GPU）----
class GpuConvNhwcOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i); int wb = rt.opBAt(i); int bc = rt.opCAt(i); int yd = rt.opDAt(i);
            int bOff = -1; if (bc >= 0) bOff = rt.tensorOff(bc);
            int work = rt.tensorRows(yd) * rt.tensorCols(yd);
            GpuInferOps.convNHWC(rt.arenaRef(), work,
                rt.tensorOff(xa), rt.tensorN(xa), rt.tensorC(xa), rt.tensorH(xa), rt.tensorW(xa),
                rt.tensorOff(wb), bOff,
                rt.tensorOff(yd), rt.tensorC(yd), rt.tensorH(yd), rt.tensorW(yd),
                rt.tensorC(wb), rt.tensorH(wb),
                rt.opP0At(i), rt.opP1At(i), rt.opP2At(i), rt.opP3At(i), rt.opP4At(i), rt.opP5At(i),
                rt.opP6At(i), rt.opP7At(i), rt.opP8At(i), rt.devRef());
        }
        void backward(InferenceRuntime rt, int i) { }
}

