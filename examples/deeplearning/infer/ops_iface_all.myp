// ---- resize3d（opKind 45 前向 / 71 反向）----
class Resize3dOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i); int yd = rt.opBAt(i);
            InferOps.resize3d(rt.arenaRef(), rt.tensorOff(xa), rt.tensorOff(yd),
                              rt.tensorN(xa), rt.tensorC(xa),
                              rt.opP0At(i), rt.opP1At(i), rt.opP2At(i), rt.opP3At(i), rt.opP4At(i), rt.opP5At(i),
                              rt.opP6At(i), rt.opP7At(i));
        }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dOut = rt.opAAt(i); int dIn = rt.opBAt(i);
                InferOps.bwdResize3d(rt.arenaRef(), rt.tensorOff(dOut), rt.tensorOff(dIn),
                                     rt.tensorN(dOut), rt.tensorC(dOut),
                                     rt.opP0At(i), rt.opP1At(i), rt.opP2At(i),
                                     rt.opP3At(i), rt.opP4At(i), rt.opP5At(i),
                                     rt.opP6At(i), rt.opP7At(i));
            }
        }
}

// ---- softmaxCE（opKind 54 训练专用；注册到 bwd 表，backward 内自检 trainMode）----
class SoftmaxCeOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) { }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int lg = rt.opAAt(i); int lb = rt.opBAt(i); int dl = rt.opCAt(i); int lo = rt.opDAt(i);
                InferOps.softmaxCE(rt.arenaRef(), rt.tensorOff(lg), rt.tensorOff(lb), rt.tensorRows(lg), rt.tensorCols(lg), rt.tensorOff(dl), rt.tensorOff(lo));
            }
        }
}

// ---- update（opKind 55 训练专用：W -= lr·grad）----
class UpdateOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) { }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int w = rt.opAAt(i); int g = rt.opBAt(i);
                int n = rt.tensorSize(w);
                double lr = rt.lrRef();
                double decay = lr * rt.optWd();
                int mode = rt.optMode();
                int mOff = rt.optOffAt(w);
                if (mode == 0) {
                    InferOps.updateSGD(rt.arenaRef(), rt.tensorOff(w), rt.tensorOff(g), n, lr, decay);
                } else if (mode == 1) {
                    InferOps.updateMom(rt.arenaRef(), rt.tensorOff(w), rt.tensorOff(g), mOff, n, lr, decay);
                } else {
                    double t = double(rt.optStep());
                    double bc1 = 1.0 - Math.pow(0.9, t);
                    double bc2 = 1.0 - Math.pow(0.999, t);
                    InferOps.updateAdamW(rt.arenaRef(), rt.tensorOff(w), rt.tensorOff(g), mOff, n, lr, decay, bc1, bc2);
                }
            }
        }
}

