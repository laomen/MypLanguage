class GpuAttentionCachedOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int q = rt.opAAt(i); int kc = rt.opBAt(i); int vc = rt.opCAt(i); int out = rt.opDAt(i); int sc = rt.opP0At(i);
            int D = rt.opP1At(i); int stride = rt.opP2At(i); int len = rt.opP3At(i); int heads = rt.opP4At(i);
            GpuInferOps.attentionCached(rt.arenaRef(), heads, rt.tensorOff(q), rt.tensorOff(kc), rt.tensorOff(vc),
                                        rt.tensorOff(out), rt.tensorOff(sc), D, stride, len, heads, rt.opP5At(i), rt.devRef());
        }
        void backward(InferenceRuntime rt, int i) { }
}

// =====================================================================
// GPU 算子类（第 5 批：ConvTranspose / 3D / 训练 loss）
// =====================================================================

// ---- convTranspose（GPU）----
class GpuConvTransposeOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i); int wb = rt.opBAt(i); int bc = rt.opCAt(i); int yd = rt.opDAt(i);
            int bOff = -1; if (bc >= 0) bOff = rt.tensorOff(bc);
            int work = rt.tensorRows(yd) * rt.tensorCols(yd);
            GpuInferOps.convTranspose(rt.arenaRef(), work,
                rt.tensorOff(xa), rt.tensorN(xa), rt.tensorC(xa), rt.tensorH(xa), rt.tensorW(xa),
                rt.tensorOff(wb), bOff,
                rt.tensorOff(yd), rt.tensorC(yd), rt.tensorH(yd), rt.tensorW(yd),
                rt.tensorH(wb), rt.tensorW(wb),
                rt.opP0At(i), rt.opP1At(i), rt.opP2At(i), rt.opP3At(i), rt.opP4At(i), rt.opP5At(i), rt.devRef());
        }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dy = rt.opAAt(i); int x = rt.opBAt(i); int w = rt.opCAt(i); int dx = rt.opDAt(i);
                int dw = rt.opP0At(i); int db = rt.opP1At(i);
                int dbOff = -1; if (db >= 0) dbOff = rt.tensorOff(db);
                GpuInferOps.bwdConvTranspose(rt.arenaRef(), rt.devRef(),
                    rt.tensorOff(dy), rt.tensorOff(x), rt.tensorN(x), rt.tensorC(x), rt.tensorH(x), rt.tensorW(x),
                    rt.tensorOff(w), rt.tensorOff(dx), rt.tensorOff(dw), dbOff,
                    rt.tensorC(dy), rt.tensorH(dy), rt.tensorW(dy),
                    rt.tensorH(w), rt.tensorW(w),
                    rt.opP2At(i), rt.opP3At(i), rt.opP4At(i), rt.opP5At(i), rt.opP6At(i), rt.opP7At(i));
            }
        }
}

// ---- conv3d（GPU，注意 GPU 用 conv3dTiled）----
class GpuConv3dOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i); int wb = rt.opBAt(i); int bc = rt.opCAt(i); int yd = rt.opDAt(i);
            int bOff = -1; if (bc >= 0) bOff = rt.tensorOff(bc);
            int work = rt.tensorRows(yd) * rt.tensorCols(yd);
            GpuInferOps.conv3dTiled(rt.arenaRef(), work,
                rt.tensorOff(xa), rt.tensorN(xa), rt.tensorC(xa), rt.tensorD(xa), rt.tensorH(xa), rt.tensorW(xa),
                rt.tensorOff(wb), bOff,
                rt.tensorOff(yd), rt.tensorC(yd), rt.tensorD(yd), rt.tensorH(yd), rt.tensorW(yd),
                rt.tensorD(wb), rt.tensorH(wb), rt.tensorW(wb),
                rt.opP0At(i), rt.opP1At(i), rt.opP2At(i), rt.opP3At(i), rt.opP4At(i), rt.opP5At(i), rt.opP6At(i), rt.opP7At(i), rt.opP8At(i),
                rt.opXAt(i, 0), rt.opXAt(i, 1), rt.opXAt(i, 2), rt.opXAt(i, 3), rt.devRef());
        }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dy = rt.opAAt(i); int x = rt.opBAt(i); int w = rt.opCAt(i); int dx = rt.opDAt(i);
                int dw = rt.opP0At(i); int db = rt.opP1At(i);
                int dbOff = -1; if (db >= 0) dbOff = rt.tensorOff(db);
                GpuInferOps.bwdConv3D(rt.arenaRef(), rt.devRef(), rt.tensorOff(dy), rt.tensorOff(x),
                                      rt.tensorN(x), rt.tensorC(x), rt.tensorD(x), rt.tensorH(x), rt.tensorW(x),
                                      rt.tensorOff(w), rt.tensorOff(dx), rt.tensorOff(dw), dbOff,
                                      rt.tensorC(dy), rt.tensorD(dy), rt.tensorH(dy), rt.tensorW(dy),
                                      rt.tensorD(w), rt.tensorH(w), rt.tensorW(w),
                                      rt.opP2At(i), rt.opP3At(i), rt.opP4At(i), rt.opP5At(i), rt.opP6At(i), rt.opP7At(i), rt.opP8At(i),
                                      rt.opXAt(i, 0), rt.opXAt(i, 1), 1, 1, 1, 1);
            }
        }
}

