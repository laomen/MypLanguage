// ops_iface_all.myp — 阶段4e3：全部算子按 interface 双方法（forward/backward）拆分
//
// 把 runtime run()/runGpu() 的巨型 if/else 分支体搬进每个算子的独立类：
//   interface IOp { void forward(rt, opIdx); void backward(rt, opIdx); }
// CPU 类调 InferOps 静态内核；GPU 类调 GpuInferOps @gpu for 内核（dev 经 rt.devRef()）。
// registerAllIfaceOps(rt) 全量注册：前向 opKind → forward()，反向 opKind → backward()。
// backward 实现内自检 rt.trainMode()==1（与原 if/else 守卫一致）。
//
// 阶段4e4：run()/runGpu() 已删除 if/else，只保留接口分派——runtime.myp 循环导入
// 本文件并在首调自动 registerAllIfaceOps(this)（ifaceInit_ 标记），全入口零改动。
import env;
import math;
import "./runtime.myp";
import "./ops.myp";
import "./gpu_ops.myp";
import "./op_iface.myp";   // relu（ReluOp/GpuReluOp + registerIfaceOps）

// =====================================================================
// CPU 算子类
// =====================================================================

// ---- dense（opKind 1 前向 / 50 反向）----
class DenseOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i);
            int wb = rt.opBAt(i);
            int bc = rt.opCAt(i);
            int yd = rt.opDAt(i);
            InferOps.dense(rt.arenaRef(), rt.tensorOff(xa), rt.tensorRows(xa), rt.tensorCols(xa),
                           rt.tensorOff(wb), rt.tensorRows(wb), rt.tensorOff(bc), rt.tensorOff(yd));
        }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dy = rt.opAAt(i);
                int x = rt.opBAt(i);
                int w = rt.opCAt(i);
                int dx = rt.opDAt(i);
                int dw = rt.opP0At(i);
                int db = rt.opP1At(i);
                InferOps.bwdDense(rt.arenaRef(), rt.tensorOff(dy), rt.tensorOff(x), rt.tensorRows(x), rt.tensorCols(x),
                                  rt.tensorOff(w), rt.tensorRows(w), rt.tensorOff(dx), rt.tensorOff(dw), rt.tensorOff(db));
            }
        }
}

// ---- softmax（opKind 3 前向 / 70 反向 bwdSoftmax，Dice 链）----
class SoftmaxOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i);
            int yb = rt.opBAt(i);
            InferOps.softmax(rt.arenaRef(), rt.tensorOff(xa), rt.tensorOff(yb), rt.tensorRows(xa), rt.tensorCols(xa));
        }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dp = rt.opAAt(i);
                int p = rt.opBAt(i);
                int dl = rt.opCAt(i);
                InferOps.bwdSoftmax(rt.arenaRef(), rt.tensorOff(p), rt.tensorOff(dp), rt.tensorOff(dl), rt.tensorRows(p), rt.tensorCols(p));
            }
        }
}

// ---- sigmoid（opKind 4 前向 / 52 反向）----
class SigmoidOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i);
            int yb = rt.opBAt(i);
            InferOps.sigmoid(rt.arenaRef(), rt.tensorOff(xa), rt.tensorOff(yb), rt.tensorRows(xa) * rt.tensorCols(xa));
        }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dy = rt.opAAt(i);
                int y = rt.opBAt(i);
                int dx = rt.opCAt(i);
                InferOps.bwdSigmoid(rt.arenaRef(), rt.tensorOff(dy), rt.tensorOff(y), rt.tensorOff(dx), rt.tensorRows(y) * rt.tensorCols(y));
            }
        }
}

// ---- add（opKind 5 前向 / 53 反向；opRelu 融合标志）----
class AddOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int aa = rt.opAAt(i);
            int bb = rt.opBAt(i);
            int oc = rt.opCAt(i);
            InferOps.add(rt.arenaRef(), rt.tensorOff(aa), rt.tensorOff(bb), rt.tensorOff(oc),
                         rt.tensorRows(aa) * rt.tensorCols(aa), rt.opReluAt(i));
        }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dy = rt.opAAt(i);
                int da = rt.opBAt(i);
                int db = rt.opCAt(i);
                InferOps.bwdAdd(rt.arenaRef(), rt.tensorOff(dy), rt.tensorOff(da), rt.tensorOff(db), rt.tensorRows(dy) * rt.tensorCols(dy));
            }
        }
}

// ---- matmul（opKind 6 前向；无独立反向）----
class MatmulOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i);
            int wb = rt.opBAt(i);
            int yd = rt.opCAt(i);
            InferOps.matmul(rt.arenaRef(), rt.tensorOff(xa), rt.tensorRows(xa), rt.tensorCols(xa),
                            rt.tensorOff(wb), rt.tensorRows(wb), rt.tensorOff(yd));
        }
        void backward(InferenceRuntime rt, int i) { }
}

// =====================================================================
// GPU 算子类
// =====================================================================

// ---- dense（GPU）----
class GpuDenseOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i);
            int wb = rt.opBAt(i);
            int bc = rt.opCAt(i);
            int yd = rt.opDAt(i);
            int work = rt.tensorRows(wb) * rt.tensorCols(xa);
            GpuInferOps.dense(rt.arenaRef(), work, rt.tensorOff(xa), rt.tensorRows(xa),
                              rt.tensorOff(wb), rt.tensorRows(wb), rt.tensorCols(xa),
                              rt.tensorOff(bc), rt.tensorOff(yd), rt.devRef());
        }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dy = rt.opAAt(i);
                int x = rt.opBAt(i);
                int w = rt.opCAt(i);
                int dx = rt.opDAt(i);
                int dw = rt.opP0At(i);
                int db = rt.opP1At(i);
                GpuInferOps.bwdDense(rt.arenaRef(), rt.devRef(), rt.tensorOff(dy), rt.tensorOff(x), rt.tensorRows(x), rt.tensorCols(x),
                                     rt.tensorOff(w), rt.tensorRows(w), rt.tensorOff(dx), rt.tensorOff(dw), rt.tensorOff(db));
            }
        }
}

