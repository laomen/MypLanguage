        void forward(InferenceRuntime rt, int i) {
            int xa = rt.opAAt(i); int yd = rt.opBAt(i);
            int work = (rt.opP0At(i) == 0) ? 1 : (rt.opP1At(i) * rt.opP2At(i));
            GpuInferOps.reduceMean(rt.arenaRef(), work, rt.tensorOff(xa), rt.tensorOff(yd),
                                   rt.opP0At(i), rt.opP1At(i), rt.opP2At(i), rt.opP3At(i), rt.opP4At(i), rt.opP5At(i), rt.devRef(), rt.statsOffRef());
