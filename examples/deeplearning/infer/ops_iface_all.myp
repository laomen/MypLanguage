// ---- add（GPU）----
class GpuAddOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int aa = rt.opAAt(i);
            int bb = rt.opBAt(i);
            int oc = rt.opCAt(i);
            GpuInferOps.add(rt.arenaRef(), rt.tensorRows(aa) * rt.tensorCols(aa),
                            rt.tensorOff(aa), rt.tensorOff(bb), rt.tensorOff(oc), rt.devRef(), rt.opReluAt(i));
        }
        void backward(InferenceRuntime rt, int i) {
            if (rt.trainMode() == 1) {
                int dy = rt.opAAt(i);
                int da = rt.opBAt(i);
                int db = rt.opCAt(i);
                GpuInferOps.bwdAdd(rt.arenaRef(), rt.devRef(), rt.tensorOff(dy), rt.tensorOff(da), rt.tensorOff(db), rt.tensorRows(dy) * rt.tensorCols(dy));
            }
        }
}

