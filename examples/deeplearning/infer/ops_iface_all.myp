// =====================================================================
// LLM 算子 GPU 类（opKind 61-67；2026-09-01 补全 → runGpu() 全 opKind 统一分派）
// =====================================================================

// ---- rmsNorm（GPU，复用通用 GpuInferOps.rmsnorm，stOff 用 arena 尾部暂存）----
class GpuRmsNormOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int in = rt.opAAt(i); int g = rt.opBAt(i); int out = rt.opCAt(i);
            int D = rt.opP0At(i); int S = rt.opP1At(i);
            GpuInferOps.rmsnorm(rt.arenaRef(), D * S, rt.tensorOff(in), rt.tensorOff(g), rt.tensorOff(out),
                                D, S, F32.toDouble(rt.opP2At(i)), rt.devRef(), rt.statsOffRef());
        }
        void backward(InferenceRuntime rt, int i) { }
}

// ---- attention（GPU，scOff 须 [heads*S*S]）----
class GpuAttentionOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int q = rt.opAAt(i); int k = rt.opBAt(i); int v = rt.opCAt(i); int out = rt.opDAt(i); int sc = rt.opP0At(i);
            int D = rt.opP1At(i); int S = rt.opP2At(i); int heads = rt.opP3At(i);
            GpuInferOps.attention(rt.arenaRef(), heads * S, rt.tensorOff(q), rt.tensorOff(k), rt.tensorOff(v),
                                  rt.tensorOff(out), rt.tensorOff(sc), D, S, heads, rt.opP4At(i), rt.opP5At(i), rt.devRef());
        }
        void backward(InferenceRuntime rt, int i) { }
}

// ---- gatherRows（GPU）----
class GpuGatherRowsOp {
    interface class IOp;
    action:
        void forward(InferenceRuntime rt, int i) {
            int e = rt.opAAt(i); int ids = rt.opBAt(i); int out = rt.opCAt(i);
            int vocab = rt.opP0At(i); int D = rt.opP1At(i); int S = rt.opP2At(i);
            GpuInferOps.gatherRows(rt.arenaRef(), D * S, rt.tensorOff(e), rt.tensorOff(ids), rt.tensorOff(out),
                                   vocab, D, S, rt.devRef());
        }
        void backward(InferenceRuntime rt, int i) { }
}

