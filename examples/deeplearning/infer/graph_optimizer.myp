// graph_optimizer.myp — Graph pass-pipeline orchestration.
import env;
import fmt;
import "./runtime.myp";
import "./graph_defs.myp";
import "./graph.myp";

interface IGraphOptimizeHost {
    int runIRPass(int pass);
    int runIRPassToFixpoint(int pass, int maxIter);
    int runTopoSort();
    int runPlanMemory();
    int lowerRuntime(InferenceRuntime rt);
    int buildReverseGraphForOptimizer();
    void setTrainingModeForOptimizer(int mode);
    void enableNoReuseForOptimizer();
    int shouldFuseConvAddForOptimizer();
    int shouldRunNHWCForOptimizer();
    void dumpResizeSizesForOptimizer();
}

class GraphOptimizer {
    action:
        // 具体 pass（从 Graph 迁移的试点：DCE）。Graph 通过 runIRPass 委托，
        // 用公共 compiler* 访问器跨类查询/改写，避免在 Graph 保留重复算法。
        int eliminateDeadNodes(Graph graph) {
            int changed = 1;
            while (changed == 1) {
                changed = 0;
                graph.ensureDefUseForOptimizer();
                int i = 0;
                while (i < graph.nodeCount()) {
                    if (graph.nodeTypeAt(i) == "") { i = i + 1; continue; }
                    string eff = graph.compilerEffectiveOut(i);
                    if (eff == "") { i = i + 1; continue; }
                    if (graph.compilerIsGraphOutput(eff) == 1) { i = i + 1; continue; }
                    // P3a：stateful/trainOnly 节点（Update/GradAcc/Bwd* 等）受 traits 保护，
                    // 不得按 use 数删除（Update 就地改权重、GradAcc 累加梯度）。
                    if (OpCode.opTraits(graph.nodeOp(i)) != 0) { i = i + 1; continue; }
                    if (graph.compilerValueUseCount(graph.compilerShapeIdx(eff)) == 0) {
                        graph.compilerEraseNode(i);   // tombstone + 标死有效输出 + 失效 DefUse
                        graph.compilerIncDce();
                        changed = 1;
                    }
                    i = i + 1;
                }
            }
            // 阶段五：死权重裁剪——DCE 后移除不被任何 live 节点引用的初始器
            // （markDeadTensor → registerTensor/planner/writeWeight 全跳过）。
            int wi = 0;
            while (wi < graph.weightCount()) {
                string nm = graph.weightName(wi);
                int si = graph.compilerShapeIdx(nm);
                if (si >= 0 && graph.compilerShapeDead(si) == 1) { wi = wi + 1; continue; }
                if (graph.compilerIsGraphOutput(nm) == 1) { wi = wi + 1; continue; }
                int used = 0;
                int ni = 0;
                while (ni < graph.nodeCount()) {
                    if (graph.nodeTypeAt(ni) == "") { ni = ni + 1; continue; }
                    int slot = 0;
                    while (slot < 8) {
                        if (graph.nodeInAt(ni, slot) == nm) { used = 1; slot = 8; }
                        else slot = slot + 1;
                    }
                    if (used == 1) break;
                    ni = ni + 1;
                }
                if (used == 0) graph.compilerMarkDeadTensor(nm);
                wi = wi + 1;
            }
            return 1;
        }

        // GAP+Flatten 融合：GlobalAveragePool → Flatten 折叠为一个 GAP 直写 flatten 输出。
        int fuseGapFlatten(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeOp(i) != OpCode.GLOBAL_AVG_POOL()) { i = i + 1; continue; }
                if (graph.compilerIsGraphOutput(graph.compilerNodeOutput(i, 0)) == 1) { i = i + 1; continue; }
                int s = graph.compilerShapeIdx(graph.compilerNodeOutput(i, 0));
                if (s >= 0 && graph.compilerShapeDim(s, 0) != 1) { i = i + 1; continue; }   // batch!=1 跳过
                int j = graph.matchSingleUseOp(graph.valueId(graph.compilerNodeOutput(i, 0)), "Flatten", 0);
                if (j < 0) { i = i + 1; continue; }
                graph.fuseSingleUseOutput(i, j, 0);
                graph.compilerIncGap();
                i = i + 1;
            }
            return 1;
        }

        // x op identity（x+0 / x*1 / x-0 / x/1）折叠。Add/Mul 可交换，id op x 也合法。
        int foldIdentityOps(Graph graph) {
            int changed = 0;
            int node = 0;
            while (node < graph.nodeCount()) {
                int code = graph.nodeOp(node);
                int commutable = 0;
                if (code == OpCode.ADD() || code == OpCode.MUL()) commutable = 1;
                else if (code != OpCode.SUB() && code != OpCode.DIV()) { node = node + 1; continue; }
                string output = graph.compilerEffectiveOut(node);
                if (output == "") { node = node + 1; continue; }
                double identity = (code == OpCode.ADD() || code == OpCode.SUB()) ? 0.0 : 1.0;
                int in0 = graph.nodeInputValue(node, 0);
                int in1 = graph.nodeInputValue(node, 1);
                int keep = -1;
                // x op id（四种全适用）；Add/Mul 可交换，id op x 也合法
                if (graph.isConstValue(graph.nodeInAt(node, 1), identity) == 1) keep = in0;
                else if (commutable == 1 && graph.isConstValue(graph.nodeInAt(node, 0), identity) == 1) keep = in1;
                int out = graph.nodeOutputValue(node, 0);
                if (keep >= 0 && out >= 0) {
                    graph.replaceAllUses(out, keep);
                    graph.compilerEraseNode(node);   // P3c：canonical 删除原语
                    changed = 1;
                }
                node = node + 1;
            }
            return changed;
        }

        // P2e：连续激活合并 Relu(Relu(x)) → Relu(x)。内层 producer 可以是独立 Relu 节点，
        // 或已融合（nFused_+nRelu_，如 ConvRelu）的 producer——其有效输出已过 ReLU，外层
        // Relu 冗余。外层输出改接内层有效输出（replaceAllUses 覆盖图输出 rename），tombstone 外层。
        int foldDoubleRelu(Graph graph) {
            int changed = 0;
            int node = 0;
            while (node < graph.nodeCount()) {
                if (graph.nodeOp(node) != OpCode.RELU()) { node = node + 1; continue; }
                string outName = graph.compilerEffectiveOut(node);
                if (outName == "") { node = node + 1; continue; }
                int in = graph.nodeInputValue(node, 0);
                int prod = graph.valueProducer(in);
                int alreadyRelu = 0;
                if (prod >= 0) {
                    if (graph.nodeOp(prod) == OpCode.RELU()) alreadyRelu = 1;
                    else if (graph.compilerAttrFused(prod) == 1 && graph.compilerAttrRelu(prod) == 1) alreadyRelu = 1;
                }
                if (alreadyRelu == 0) { node = node + 1; continue; }
                int out = graph.nodeOutputValue(node, 0);
                int innerOut = graph.nodeOutputValue(prod, 0);
                if (out >= 0 && innerOut >= 0) {
                    graph.replaceAllUses(out, innerOut);
                    graph.compilerEraseNode(node);   // P3c：canonical 删除原语
                    changed = 1;
                }
                node = node + 1;
            }
            return changed;
        }

        // Conv→Relu 融合（doRelu 后置单内核）。
        int fuseConvRelu(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeOp(i) != OpCode.CONV()) { i = i + 1; continue; }
                string eff = graph.compilerEffectiveOut(i);
                if (graph.compilerIsGraphOutput(eff) == 1) { i = i + 1; continue; }   // 中间张量不能是图输出
                int j = graph.matchSingleUseOp(graph.valueId(eff), "Relu", 0);
                if (j < 0) { i = i + 1; continue; }
                graph.fuseReluIntoProducer(i, j);
                i = i + 1;
            }
            return 1;
        }

        // G6：InstanceNormalization→Relu 融合（IN 输出直接过 ReLU，省一次 arena 往返）。
        int fuseReluOp(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeOp(i) != OpCode.INSTANCE_NORM()) { i = i + 1; continue; }
                string eff = graph.compilerEffectiveOut(i);
                if (graph.compilerIsGraphOutput(eff) == 1) { i = i + 1; continue; }
                int j = graph.matchSingleUseOp(graph.valueId(eff), "Relu", 0);
                if (j < 0) { i = i + 1; continue; }
                graph.fuseReluIntoProducer(i, j);
                i = i + 1;
            }
            return 1;
        }

        // P4-2/3：Conv+残差Add 融合。Conv（或 BN 折叠后）输出的唯一 Use = Add 的 slot0
        // （残差为 slot1）→ 卷积内核直接加残差写入 Add 输出，省掉 conv 中间张量 arena 往返。
        // Add 输出若唯一消费是 Relu → 一并折叠（conv+residual+relu 单内核，doRelu 后置）。
        int fuseConvAdd(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeOp(i) != OpCode.CONV()) { i = i + 1; continue; }
                if (graph.compilerAttrRelu(i) == 1) { i = i + 1; continue; }
                string eff = graph.compilerEffectiveOut(i);
                if (eff == "" || graph.compilerIsGraphOutput(eff) == 1) { i = i + 1; continue; }
                int j = graph.matchSingleUseOp(graph.valueId(eff), "Add", 0);
                if (j < 0) { i = i + 1; continue; }
                string resid = graph.nodeInAt(j, 1);
                if (resid == "" || graph.compilerIsGraphOutput(resid) == 1 || graph.compilerValueExists(resid) == 0) { i = i + 1; continue; }
                string addOut = graph.compilerNodeOutput(j, 0);
                graph.compilerAttrSetFused(i, 1);
                graph.compilerAttrSetFusedOut(i, addOut);
                graph.compilerSetNodeInput(i, 3, resid);
                graph.compilerSetNodeType(j, "");
                graph.compilerMarkDeadTensor(eff);
                // P4-3：Add 输出唯一消费是 Relu → 折叠（doRelu 后置：conv+residual 再过 relu）
                int r = graph.matchSingleUseOp(graph.valueId(addOut), "Relu", 0);
                if (r >= 0) {
                    graph.compilerAttrSetRelu(i, 1);
                    graph.compilerAttrSetFusedOut(i, graph.compilerNodeOutput(r, 0));
                    graph.compilerSetNodeType(r, "");
                    graph.compilerMarkDeadTensor(addOut);
                }
                graph.compilerIncFusedAdd();
                i = i + 1;
            }
            return 1;
        }

        // 拓扑排序（Kahn，精确 (user,slot) use edge 递减入度）。写 analysis 的 planOrder。
        int topoSort(Graph graph) {
            int[] indeg = new int[512];
            // P0：所有既有 mutation pass 已完成，此处统一重建 def-use，再消费 O(1) producer 索引。
            graph.compilerRebuildDefUse();
            if (Console.getEnv("MYP_IR_VERIFY") == "1" && graph.compilerVerifyIR() == 0) {
                Console.writeLine("DBG fail verifyIR");
                return 0;
            }
            int i = 0;
            while (i < graph.nodeCount()) {
                indeg[i] = 0;
                if (graph.nodeTypeAt(i) == "") { i = i + 1; continue; }
                if (graph.valueProducer(graph.nodeInputValue(i, 0)) >= 0) indeg[i] = indeg[i] + 1;
                if (graph.valueProducer(graph.nodeInputValue(i, 1)) >= 0) indeg[i] = indeg[i] + 1;
                if (graph.valueProducer(graph.nodeInputValue(i, 2)) >= 0) indeg[i] = indeg[i] + 1;
                if (graph.valueProducer(graph.nodeInputValue(i, 3)) >= 0) indeg[i] = indeg[i] + 1;
                i = i + 1;
            }
            graph.compilerAnalysisSetPlanOrderCount(0);
            int remaining = 0;
            i = 0;
            while (i < graph.nodeCount()) { if (graph.nodeTypeAt(i) != "") remaining = remaining + 1; i = i + 1; }
            while (graph.compilerAnalysisPlanOrderCount() < remaining) {
                int picked = -1;
                i = 0;
                while (i < graph.nodeCount()) {
                    if (graph.nodeTypeAt(i) != "" && indeg[i] == 0) { picked = i; i = graph.nodeCount(); }
                    i = i + 1;
                }
                if (picked < 0) {
                    if (Console.getEnv("MYP_GR_DBG") == "1") {
                        Console.writeString("topoSort stuck remaining=" + Fmt.i(remaining) + " indeg[0..]:");
                        Console.writeLine("");
                        int d = 0;
                        while (d < graph.nodeCount()) {
                            if (graph.nodeTypeAt(d) != "" && indeg[d] > 0) {
                                Console.writeString("  n" + Fmt.i(d) + " type=" + graph.nodeTypeAt(d) + " indeg=" + Fmt.i(indeg[d]) + " in0=" + graph.nodeInAt(d, 0) + " in1=" + graph.nodeInAt(d, 1) + " in2=" + graph.nodeInAt(d, 2));
                                Console.writeLine("");
                            }
                            d = d + 1;
                        }
                    }
                    return 0;   // 有环
                }
                graph.compilerAnalysisSetPlanOrder(graph.compilerAnalysisPlanOrderCount(), picked);
                graph.compilerAnalysisSetPlanOrderCount(graph.compilerAnalysisPlanOrderCount() + 1);
                indeg[picked] = -1;
                // 多输出（Split/BwdDense/SoftmaxCE）：递减所有输出（out0..out3）的消费者
                string out = graph.compilerEffectiveOut(picked);
                string o1 = graph.compilerNodeOutput(picked, 1);
                string o2 = graph.compilerNodeOutput(picked, 2);
                string o3 = graph.compilerNodeOutput(picked, 3);
                // P0：按精确 (user,slot) use edge 递减，重复 operand（Mul(x,x)）自然处理。
                int[] produced = new int[4];
                produced[0] = graph.valueId(out); produced[1] = graph.valueId(o1); produced[2] = graph.valueId(o2); produced[3] = graph.valueId(o3);
                int ps = 0;
                while (ps < 4) {
                    int pv = produced[ps];
                    if (pv >= 0) {
                        int use = 0;
                        while (use < graph.valueUseCount(pv)) {
                            int user = graph.valueUseNode(pv, use);
                            if (user >= 0 && indeg[user] >= 0) indeg[user] = indeg[user] - 1;
                            use = use + 1;
                        }
                    }
                    ps = ps + 1;
                }
            }
            graph.compilerAnalysisSetValidOr(IRAnalysis.TOPO());
            graph.compilerAnalysisSetTopoGeneration(graph.compilerAnalysisGeneration());
            return 1;
        }

        // first-fit 内存规划（写 planner 区域）。返回峰值内存（张量元素数）。
        int planMemory(Graph graph) {
            int si = 0;
            while (si < graph.compilerShapeCount()) { graph.compilerSetPlanProducer(si, -1); graph.compilerSetPlanLastUse(si, -1); graph.compilerSetPlanOff(si, 0); si = si + 1; }
            // producer = 产出该张量的节点在拓扑序中的位置（融合节点以 effectiveOut 计）
            int oi = 0;
            while (oi < graph.compilerAnalysisPlanOrderCount()) {
                int ni = graph.compilerAnalysisPlanOrder(oi);
                int s = graph.compilerShapeIdx(graph.compilerEffectiveOut(ni));
                if (s >= 0) graph.compilerSetPlanProducer(s, oi);
                oi = oi + 1;
            }
            // lastUse = 消费该张量的最大拓扑位置（活节点）
            oi = 0;
            while (oi < graph.compilerAnalysisPlanOrderCount()) {
                int ni = graph.compilerAnalysisPlanOrder(oi);
                int a = graph.compilerShapeIdx(graph.nodeInAt(ni, 0)); if (a >= 0 && oi > graph.compilerPlanLastUse(a)) graph.compilerSetPlanLastUse(a, oi);
                int b = graph.compilerShapeIdx(graph.nodeInAt(ni, 1)); if (b >= 0 && oi > graph.compilerPlanLastUse(b)) graph.compilerSetPlanLastUse(b, oi);
                int c = graph.compilerShapeIdx(graph.nodeInAt(ni, 2)); if (c >= 0 && oi > graph.compilerPlanLastUse(c)) graph.compilerSetPlanLastUse(c, oi);
                // P4-2：残差融合把 Add 的 slot1 登记进 Conv 的 nIn3_——liveness 须覆盖 nIn3_/nIn4_
                int d = graph.compilerShapeIdx(graph.nodeInAt(ni, 3)); if (d >= 0 && oi > graph.compilerPlanLastUse(d)) graph.compilerSetPlanLastUse(d, oi);
                int e = graph.compilerShapeIdx(graph.nodeInAt(ni, 4)); if (e >= 0 && oi > graph.compilerPlanLastUse(e)) graph.compilerSetPlanLastUse(e, oi);
                oi = oi + 1;
            }
            // first-fit 分配（按形状表顺序 = 拓扑序）
            // persistent：权重 / 图输入 / 图输出（多 pass 需全程存活，区域不可复用）
            int rc = 0;
            int highWater = 0;
            si = 0;
            while (si < graph.compilerShapeCount()) {
                if (graph.compilerShapeDead(si) == 1) { graph.compilerSetPlanOff(si, 0); si = si + 1; continue; }   // G2：死张量不分配
                int size = graph.compilerShapeDim(si, 0) * graph.compilerShapeDim(si, 1) * graph.compilerShapeDim(si, 2) * graph.compilerShapeDim(si, 3);
                if (graph.compilerShapeR5(si) == 1) size = size * graph.compilerShapeDim(si, 4);   // 3D：5D 张量乘 D 维
                int producer = graph.compilerPlanProducer(si);
                int lastUse = graph.compilerPlanLastUse(si);
                int persist = 0;
                if (producer < 0) persist = 1;            // 权重 / 图输入
                if (lastUse < 0) { persist = 1; lastUse = graph.nodeCount() - 1; }  // 图输出
                if (graph.compilerIsGraphOutput(graph.compilerShapeName(si)) == 1) persist = 1;   // 图输出：run 后用户仍读，缓冲不可复用
                if (graph.compilerNoReuse() == 1) persist = 1;            // 调试：不复用
                int best = -1;
                if (persist == 0) {
                    int r = 0;
                    while (r < rc) {
                        if (graph.compilerPlanRPersist(r) == 0 && graph.compilerPlanRLu(r) < producer && graph.compilerPlanRSize(r) >= size) { best = r; r = rc; }
                        r = r + 1;
                    }
                }
                int off = 0;
                if (best >= 0) {
                    off = graph.compilerPlanROff(best);
                    graph.compilerSetPlanRSize(best, size);
                    graph.compilerSetPlanRLu(best, lastUse);
                } else {
                    off = highWater;
                    highWater = highWater + size;
                    graph.compilerSetPlanROff(rc, off);
                    graph.compilerSetPlanRSize(rc, size);
                    graph.compilerSetPlanRLu(rc, lastUse);
                    graph.compilerSetPlanRPersist(rc, persist);
                    rc = rc + 1;
                }
                graph.compilerSetPlanOff(si, off);
                si = si + 1;
            }
            graph.compilerSetLivenessOr(IRAnalysis.LIVENESS());
            graph.compilerSetLivenessGeneration(graph.compilerAnalysisGeneration());
            return highWater;
        }

        // Phase A：按拓扑序标记节点布局（nNHWC_）
        int layoutNHWC(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                graph.compilerAttrSetNhwc(i, 0);
                string t = graph.nodeTypeAt(i);
                if (t == "Conv") graph.compilerAttrSetNhwc(i, 1);                       // 卷积主干始终 NHWC
                else if (t == "MaxPool" || t == "AveragePool" || t == "Pad" || t == "Add" || t == "Relu" || t == "BatchNormalization") {
                    int p0 = producerNHWC(graph, graph.nodeInAt(i, 0));
                    int p1 = producerNHWC(graph, graph.nodeInAt(i, 1));
                    if (p0 == 1 || p1 == 1) graph.compilerAttrSetNhwc(i, 1);
                } else if (t == "GlobalAveragePool") {
                    graph.compilerAttrSetNhwc(i, producerNHWC(graph, graph.nodeInAt(i, 0)));               // 输入侧 NHWC，输出为 NCHW 边界
                }
                i = i + 1;
            }
            // Phase A.5：NHWC 节点的输出张量登记为 NHWC（GAP 输出是边界，除外）
            i = 0;
            while (i < graph.nodeCount()) {
                if (graph.compilerAttrNhwc(i) == 1 && graph.nodeTypeAt(i) != "GlobalAveragePool") {
                    graph.compilerShapeSetNhwc(graph.compilerEffectiveOut(i));
                }
                i = i + 1;
            }
            // Phase B：确保 NHWC 节点的激活输入都在 NHWC（必要时插入转置节点）
            i = 0;
            while (i < graph.nodeCount()) {
                string t = graph.nodeTypeAt(i);
                if (graph.compilerAttrNhwc(i) == 1 && (t == "Conv" || t == "MaxPool" || t == "AveragePool" || t == "Pad" || t == "Add" || t == "Relu" || t == "GlobalAveragePool" || t == "BatchNormalization")) {
                    ensureNHWCInput(graph, i, 0);
                    if (t == "Conv") markWeightNHWC(graph, graph.nodeInAt(i, 1));
                    if (t == "Add") ensureNHWCInput(graph, i, 1);
                }
                i = i + 1;
            }
            return 1;
        }

        int producerNHWC(Graph graph, string name) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeTypeAt(i) == "") { i = i + 1; continue; }
                string eff = graph.compilerNodeOutput(i, 0);
                if (graph.compilerAttrFused(i) == 1) eff = graph.compilerAttrFusedOut(i);
                if (eff == name) return graph.compilerAttrNhwc(i);
                i = i + 1;
            }
            return 0;
        }
        void ensureNHWCInput(Graph graph, int nodeIdx, int slot) {
            string nm;
            if (slot == 0) nm = graph.nodeInAt(nodeIdx, 0);
            else nm = graph.nodeInAt(nodeIdx, 1);
            if (nm == "") return;
            if (producerNHWC(graph, nm) == 1) return;    // 已是 NHWC
            if (graph.compilerInitIdx(nm) >= 0) return;         // 初始器（权重单独处理）
            string tname = nm + "#nhwc";
            if (graph.compilerValueExists(tname) == 0) {
                int s = graph.compilerShapeIdx(nm);
                if (s < 0) return;
                int N = graph.compilerShapeDim(s, 0); int H = graph.compilerShapeDim(s, 1); int W = graph.compilerShapeDim(s, 2); int C = graph.compilerShapeDim(s, 3);
                graph.compilerAddShapeD4(tname, N, H, W, C);              // [N,H,W,C] 形状
                graph.compilerSetShapeKind(tname, Kind.CNN_ACT());
                graph.compilerShapeSetNhwc(tname);
                // 追加 NCHW2NHWC 转置节点
                graph.compilerSetNodeType(graph.nodeCount(), "NCHW2NHWC");
                graph.compilerSetNodeInput(graph.nodeCount(), 0, nm);
                graph.compilerNodeSetOutput(graph.nodeCount(), 0, tname);
                graph.compilerAttrSet(graph.nodeCount(), NodeField.CONST_VAL(), 0);
                graph.compilerAttrSetNhwc(graph.nodeCount(), 1);
                graph.compilerAttrSetFused(graph.nodeCount(), 0);
                graph.compilerAttrSetFusedBy(graph.nodeCount(), -1);
                graph.compilerAttrSetFusedOut(graph.nodeCount(), "");
                graph.compilerNodeEnd();
            }
            if (slot == 0) graph.compilerSetNodeInput(nodeIdx, 0, tname);
            else graph.compilerSetNodeInput(nodeIdx, 1, tname);
        }
        void markWeightNHWC(Graph graph, string name) {
            int wi = graph.compilerInitIdx(name);
            if (wi >= 0) {
                graph.compilerWeightSetField(wi, WeightField.NHWC(), 1);
                graph.compilerShapeSetNhwc(name);
            }
        }

        int shapeKindOf(Graph graph, string name) { return graph.compilerShapeKind(graph.compilerShapeIdx(name)); }

        // F8：把 4D 通用常量（非 Conv 权重/偏置）标记为 CNN 激活（buildRuntime 4D 登记）
        // 并设 wRole_=4（写权重时直接拷贝，不做 FC 转置）
        void markGeneric4DConst(Graph graph, string name) {
            int wi = graph.compilerInitIdx(name);
            if (wi < 0) return;
            if (graph.compilerWeightGetField(wi, WeightField.ROLE()) == 2 || graph.compilerWeightGetField(wi, WeightField.ROLE()) == 3) return;   // Conv 权重/偏置不覆盖
            int s = graph.compilerShapeIdx(name);
            if (s < 0) return;
            if (graph.compilerShapeDim(s, 2) <= 1 && graph.compilerShapeDim(s, 3) <= 1) return;       // 非 4D 不处理
            graph.compilerWeightSetField(wi, WeightField.ROLE(), 4);
            graph.compilerWeightSetField(wi, WeightField.TRANSPOSED(), 0);
            graph.compilerSetShapeKind(name, Kind.CNN_ACT());
        }
        // F8：int64 参数初始器（Reshape shape / Slice starts 等）标死——
        // 不登记为 f32 运行时张量（readI64Init 直接从 file_ 读，不依赖 runtime 张量）。
        // G2：同时登记 SHAPE role + INT64 dtype（shape tensor 显式建模）。
        void markInt64Param(Graph graph, string name) {
            int wi = graph.compilerInitIdx(name);
            if (wi < 0) return;
            if (graph.compilerWeightGetField(wi, WeightField.DTYPE()) != 7) return;   // 仅 int64 参数
            graph.compilerMarkDeadTensor(name);
            graph.compilerSetValueRole(name, TensorRole.SHAPE());
            graph.compilerSetValueDType(name, DType.INT64());
        }
        // F8：任意参数初始器标死（Resize scales/sizes 等，读自 file_）
        // G2：同时登记 PARAM role（float 参数输入显式建模）。
        void markParamDead(Graph graph, string name) {
            int wi = graph.compilerInitIdx(name);
            if (wi < 0) return;
            graph.compilerMarkDeadTensor(name);
            graph.compilerSetValueRole(name, TensorRole.PARAM());
            int dt = graph.compilerWeightGetField(wi, WeightField.DTYPE());
            if (dt != 0) graph.compilerSetValueDType(name, dt);
        }
        int isNodeOutputOf(Graph graph, string name) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.compilerNodeOutput(i, 0) == name || graph.compilerNodeOutput(i, 1) == name || graph.compilerNodeOutput(i, 2) == name || graph.compilerNodeOutput(i, 3) == name) return 1;
                i = i + 1;
            }
            return 0;
        }
        int consumerKindOf(Graph graph, string name) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeInAt(i, 0) == name || graph.nodeInAt(i, 1) == name || graph.nodeInAt(i, 2) == name) {
                    string t = graph.nodeTypeAt(i);
                    if (t == "Conv" || t == "MaxPool" || t == "AveragePool" || t == "GlobalAveragePool" || t == "BatchNormalization" || t == "Expand" || t == "Where" || t == "Tile" || t == "Squeeze" || t == "Gather" || t == "LogSoftmax" || t == "Dropout") return Kind.CNN_ACT();   // G4/G5：4D 广播/数据算子
                    if (t == "Conv3D" || t == "MaxPool3D" || t == "AveragePool3D") return Kind.CNN_ACT();   // 3D
                    // F8：Concat/Transpose/Reshape 等 —— 若张量本身 4D 则按 CNN 激活
                    int s = graph.compilerShapeIdx(name);
                    if (s >= 0 && (graph.compilerShapeDim(s, 2) > 1 || graph.compilerShapeDim(s, 3) > 1)) return Kind.CNN_ACT();
                    return Kind.FC_ACT();
                }
                i = i + 1;
            }
            return Kind.FC_ACT();
        }
        void markFCWeight(Graph graph, string name, int v) {
            int i = graph.compilerInitIdx(name);
            if (i >= 0) { graph.compilerWeightSetField(i, WeightField.TRANSPOSED(), v); graph.compilerWeightSetField(i, WeightField.ROLE(), 0); graph.compilerSetShapeKind(name, Kind.FC_W()); }
        }
        void markFCBias(Graph graph, string name) {
            int i = graph.compilerInitIdx(name);
            if (i >= 0) { graph.compilerWeightSetField(i, WeightField.BIAS(), 1); graph.compilerWeightSetField(i, WeightField.ROLE(), 1); graph.compilerSetShapeKind(name, Kind.FC_B()); }
        }
        void markCNNWeight(Graph graph, string name) {
            int i = graph.compilerInitIdx(name);
            if (i >= 0) { graph.compilerWeightSetField(i, WeightField.ROLE(), 2); graph.compilerSetShapeKind(name, Kind.CNN_W()); }
        }
        void markCNNBias(Graph graph, string name) {
            int i = graph.compilerInitIdx(name);
            if (i >= 0) { graph.compilerWeightSetField(i, WeightField.ROLE(), 3); graph.compilerSetShapeKind(name, Kind.CNN_B()); }
        }

        int classifyShapes(Graph graph) {
            // 1) 权重/偏置：由消费节点决定（初始器）
            int i = 0;
            while (i < graph.nodeCount()) {
                string t = graph.nodeTypeAt(i);
                if (t == "Gemm") {
                    markFCWeight(graph, graph.nodeInAt(i, 1), graph.compilerAttr(i, NodeField.TRANSB()));   // transB=1：wire=[N,K]；transB=0：wire=[K,N]
                    markFCBias(graph, graph.nodeInAt(i, 2));
                } else if (t == "MatMul") {
                    markFCWeight(graph, graph.nodeInAt(i, 1), 0);             // MatMul 无 transB，wire=[K,N]
                } else if (t == "Conv") {
                    markCNNWeight(graph, graph.nodeInAt(i, 1));
                    markCNNBias(graph, graph.nodeInAt(i, 2));
                } else if (t == "Conv3D") {
                    // 3D：权重 [Cout,Cin,kd,kh,kw] / 偏置 [Cout]
                    markCNNWeight(graph, graph.nodeInAt(i, 1));
                    markCNNBias(graph, graph.nodeInAt(i, 2));
                } else if (t == "ConvTranspose") {
                    // F8：权重 [Cin,Cout,kh,kw] 直接拷贝（wRole_=2 无需转置）
                    markCNNWeight(graph, graph.nodeInAt(i, 1));
                    markCNNBias(graph, graph.nodeInAt(i, 2));
                } else if (t == "Concat" || t == "Transpose" || t == "Reshape") {
                    // F8：4D 通用常量输入 → CNN 激活登记 + 直接拷贝（Concat 的非常量输入/常量）
                    markGeneric4DConst(graph, graph.nodeInAt(i, 0));
                    if (t == "Concat") { markGeneric4DConst(graph, graph.nodeInAt(i, 1)); markGeneric4DConst(graph, graph.nodeInAt(i, 2)); }
                    if (t == "Reshape") markInt64Param(graph, graph.nodeInAt(i, 1));   // shape 参数（int64）不登记为 f32 张量
                } else if (t == "Expand") {
                    // G4：Expand shape 参数（int64）不登记为 f32 张量
                    markInt64Param(graph, graph.nodeInAt(i, 1));
                } else if (t == "Tile") {
                    // G5：Tile repeats 参数（int64）不登记为 f32 张量
                    markInt64Param(graph, graph.nodeInAt(i, 1));
                } else if (t == "Gather") {
                    // G5：数据 Gather 的 indices（int64 初始器）不登记为 f32 张量
                    // （graph_compiler 用 readI64Init 读；形状链 Gather 由 foldShapeChains 折叠）
                    markInt64Param(graph, graph.nodeInAt(i, 1));
                } else if (t == "Embedding") {
                    // G5：Embedding 权重表 [vocab,D] 直接拷贝（transB=1），ids int64 标 dead
                    markFCWeight(graph, graph.nodeInAt(i, 0), 1);
                    markInt64Param(graph, graph.nodeInAt(i, 1));
                } else if (t == "Dropout") {
                    // G5：ratio（f32 标量初始器，opset12）不登记为 f32 激活张量
                    markParamDead(graph, graph.nodeInAt(i, 1));
                    markInt64Param(graph, graph.nodeInAt(i, 2));   // training_mode（bool/int64，若给出）
                } else if (t == "Slice") {
                    // F8：starts/ends/axes/steps 参数初始器（int64）不登记为 f32 张量
                    markInt64Param(graph, graph.nodeInAt(i, 1));
                    markInt64Param(graph, graph.nodeInAt(i, 2));
                    markInt64Param(graph, graph.nodeInAt(i, 3));
                    markInt64Param(graph, graph.nodeInAt(i, 4));
                } else if (t == "InstanceNormalization") {
                    // F8：scale/bias [C] 常量 → FC_B 登记（addTensorPlanned2(d0,1)）
                    markFCBias(graph, graph.nodeInAt(i, 1));
                    markFCBias(graph, graph.nodeInAt(i, 2));
                } else if (t == "Pad") {
                    // F8：pads（int64）与 constant_value（f32）参数不登记为 f32 激活张量
                    markInt64Param(graph, graph.nodeInAt(i, 1));
                    markParamDead(graph, graph.nodeInAt(i, 2));
                } else if (t == "Split") {
                    // F8：split 尺寸输入（opset13+，int64）不登记为 f32 张量
                    markInt64Param(graph, graph.nodeInAt(i, 1));
                } else if (t == "Resize" || t == "Upsample") {
                    // F8：scales/sizes 参数初始器不登记为激活（读自 file_）
                    markParamDead(graph, graph.nodeInAt(i, 1));
                    markParamDead(graph, graph.nodeInAt(i, 2));
                    markParamDead(graph, graph.nodeInAt(i, 3));
                }
                i = i + 1;
            }
            // 2) 图输入（非初始器、非任何节点输出）：由首个消费者决定 4D/FC
            int si = 0;
            while (si < graph.compilerShapeCount()) {
                string nm = graph.compilerShapeName(si);
                if (graph.compilerInitIdx(nm) >= 0) { si = si + 1; continue; }
                if (isNodeOutputOf(graph, nm) == 1) { si = si + 1; continue; }
                graph.compilerSetShapeKind(nm, consumerKindOf(graph, nm));
                si = si + 1;
            }
            // 3) 激活：按生产者传播（节点按拓扑序；死节点跳过）
            i = 0;
            while (i < graph.nodeCount()) {
                string t = graph.nodeTypeAt(i);
                if (t == "") { i = i + 1; continue; }
                int k = Kind.FC_ACT();
                if (t == "Conv" || t == "MaxPool" || t == "AveragePool" || t == "GlobalAveragePool") k = Kind.CNN_ACT();
                else if (t == "Conv3D" || t == "MaxPool3D" || t == "AveragePool3D") k = Kind.CNN_ACT();   // 3D
                else if (t == "Gemm" || t == "Flatten") k = Kind.FC_ACT();
                else if (t == "MatMul") k = shapeKindOf(graph, graph.nodeInAt(i, 0));   // 阶段四：4D 输入 → CNN_ACT（batch matmul）
                else {
                    // Relu / Sigmoid / Softmax / Add：沿用主输入 kind
                    k = shapeKindOf(graph, graph.nodeInAt(i, 0));
                }
                graph.compilerSetShapeKind(graph.compilerNodeOutput(i, 0), k);
                // G2：激活输出登记 DATA role（计算数据张量）。shape 链节点（Shape/
                // Constant/Cast 折叠产物）已在 foldShapeChains 标 SHAPE，不覆盖。
                if (graph.compilerValueRole(graph.compilerNodeOutput(i, 0)) == TensorRole.UNKNOWN()) {
                    graph.compilerSetValueRole(graph.compilerNodeOutput(i, 0), TensorRole.DATA());
                    graph.compilerSetValueDType(graph.compilerNodeOutput(i, 0), graph.compilerValueDType(graph.nodeInAt(i, 0)));
                }
                if (t == "Split") {   // F8：Split 所有输出沿用主输入 kind
                    graph.compilerSetShapeKind(graph.compilerNodeOutput(i, 1), k);
                    graph.compilerSetShapeKind(graph.compilerNodeOutput(i, 2), k);
                    graph.compilerSetShapeKind(graph.compilerNodeOutput(i, 3), k);
                    if (graph.compilerValueRole(graph.compilerNodeOutput(i, 1)) == TensorRole.UNKNOWN()) {
                        graph.compilerSetValueRole(graph.compilerNodeOutput(i, 1), TensorRole.DATA());
                        graph.compilerSetValueDType(graph.compilerNodeOutput(i, 1), graph.compilerValueDType(graph.nodeInAt(i, 0)));
                    }
                    if (graph.compilerValueRole(graph.compilerNodeOutput(i, 2)) == TensorRole.UNKNOWN()) {
                        graph.compilerSetValueRole(graph.compilerNodeOutput(i, 2), TensorRole.DATA());
                        graph.compilerSetValueDType(graph.compilerNodeOutput(i, 2), graph.compilerValueDType(graph.nodeInAt(i, 0)));
                    }
                    if (graph.compilerValueRole(graph.compilerNodeOutput(i, 3)) == TensorRole.UNKNOWN()) {
                        graph.compilerSetValueRole(graph.compilerNodeOutput(i, 3), TensorRole.DATA());
                        graph.compilerSetValueDType(graph.compilerNodeOutput(i, 3), graph.compilerValueDType(graph.nodeInAt(i, 0)));
                    }
                }
                i = i + 1;
            }
            return 1;
        }

        int fuseConvBN(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeOp(i) != OpCode.CONV()) { i = i + 1; continue; }
                if (graph.compilerAttrFused(i) == 1) { i = i + 1; continue; }
                if (graph.compilerIsGraphOutput(graph.compilerNodeOutput(i, 0)) == 1) { i = i + 1; continue; }
                // P2b：精确匹配 Conv 输出的唯一 Use = BatchNormalization operand0。
                int j = graph.matchSingleUseOp(graph.valueId(graph.compilerNodeOutput(i, 0)), "BatchNormalization", 0);
                if (j < 0) { i = i + 1; continue; }
                // BN 4 参数必须是初始器
                if (graph.compilerInitIdx(graph.nodeInAt(j, 1)) < 0 || graph.compilerInitIdx(graph.nodeInAt(j, 2)) < 0 || graph.compilerInitIdx(graph.nodeInAt(j, 3)) < 0 || graph.compilerInitIdx(graph.nodeInAt(j, 4)) < 0) { i = i + 1; continue; }
                // 标记 conv 权重/偏置折叠（记录 BN 参数初始器下标 + BN 节点下标）
                int wi = graph.compilerInitIdx(graph.nodeInAt(i, 1));
                int wb = graph.compilerInitIdx(graph.nodeInAt(i, 2));
                if (wi >= 0) { graph.compilerWeightSetField(wi, WeightField.BN(), 1); graph.compilerWeightSetField(wi, WeightField.BN_NODE(), j); graph.compilerWeightSetField(wi, WeightField.BN_SCALE(), graph.compilerInitIdx(graph.nodeInAt(j, 1))); graph.compilerWeightSetField(wi, WeightField.BN_BIAS(), graph.compilerInitIdx(graph.nodeInAt(j, 2))); graph.compilerWeightSetField(wi, WeightField.BN_MEAN(), graph.compilerInitIdx(graph.nodeInAt(j, 3))); graph.compilerWeightSetField(wi, WeightField.BN_VAR(), graph.compilerInitIdx(graph.nodeInAt(j, 4))); }
                if (wb >= 0) { graph.compilerWeightSetField(wb, WeightField.BN(), 1); graph.compilerWeightSetField(wb, WeightField.BN_NODE(), j); graph.compilerWeightSetField(wb, WeightField.BN_SCALE(), graph.compilerInitIdx(graph.nodeInAt(j, 1))); graph.compilerWeightSetField(wb, WeightField.BN_BIAS(), graph.compilerInitIdx(graph.nodeInAt(j, 2))); graph.compilerWeightSetField(wb, WeightField.BN_MEAN(), graph.compilerInitIdx(graph.nodeInAt(j, 3))); graph.compilerWeightSetField(wb, WeightField.BN_VAR(), graph.compilerInitIdx(graph.nodeInAt(j, 4))); }
                else {
                    // G4：无卷积偏置的 Conv（真实模型常见）→ 由 BN 参数合成偏置
                    int Cout = graph.compilerWeightRows(wi);
                    string bname = graph.compilerNodeOutput(i, 0) + "#bnb";
                    int[] bdims = new int[1];
                    bdims[0] = Cout;
                    int bw = graph.compilerWeightAdd(bname, Cout, 1, 1, 1, 0, Cout * 4);   // 无源字节，仅用于 count
                    graph.compilerWeightSetField(bw, WeightField.ROLE(), 3);
                    graph.compilerWeightSetField(bw, WeightField.BN(), 1);
                    graph.compilerWeightSetField(bw, WeightField.BN_ONLY(), 1);
                    graph.compilerWeightSetField(bw, WeightField.BN_NODE(), j);
                    graph.compilerWeightSetField(bw, WeightField.BN_SCALE(), graph.compilerInitIdx(graph.nodeInAt(j, 1)));
                    graph.compilerWeightSetField(bw, WeightField.BN_BIAS(), graph.compilerInitIdx(graph.nodeInAt(j, 2)));
                    graph.compilerWeightSetField(bw, WeightField.BN_MEAN(), graph.compilerInitIdx(graph.nodeInAt(j, 3)));
                    graph.compilerWeightSetField(bw, WeightField.BN_VAR(), graph.compilerInitIdx(graph.nodeInAt(j, 4)));
                    graph.addShapeD(bname, bdims, 1);
                    graph.compilerSetShapeKind(bname, Kind.CNN_B());
                    graph.compilerSetNodeInput(i, 2, bname);
                }
                graph.compilerAttrSetFused(i, 1);
                graph.compilerAttrSetFusedOut(i, graph.compilerNodeOutput(j, 0));
                graph.compilerSetNodeType(j, "");
                graph.compilerMarkDeadTensor(graph.compilerNodeOutput(i, 0));   // conv 中间输出
                // BN 参数不再被消费 → 标死（不分配/不登记/不写权重）
                if (graph.compilerLiveConsumers(graph.nodeInAt(j, 1)) == 0) graph.compilerMarkDeadTensor(graph.nodeInAt(j, 1));
                if (graph.compilerLiveConsumers(graph.nodeInAt(j, 2)) == 0) graph.compilerMarkDeadTensor(graph.nodeInAt(j, 2));
                if (graph.compilerLiveConsumers(graph.nodeInAt(j, 3)) == 0) graph.compilerMarkDeadTensor(graph.nodeInAt(j, 3));
                if (graph.compilerLiveConsumers(graph.nodeInAt(j, 4)) == 0) graph.compilerMarkDeadTensor(graph.nodeInAt(j, 4));
                graph.compilerIncBn();
                i = i + 1;
            }
            return 1;
        }

        int buildReverseGraph(Graph graph) {
            // 1) 定位「输出是图输出的 Softmax」节点 → logits = 其输入
            int smNode = -1;
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeOp(i) == OpCode.SOFTMAX() && graph.compilerIsGraphOutput(graph.compilerNodeOutput(i, 0)) == 1) { smNode = i; i = graph.nodeCount(); }
                i = i + 1;
            }
            if (smNode < 0) {
                Console.writeLine("buildReverseGraph: no Softmax graph output");
                return 0;
            }
            string logits = graph.nodeInAt(smNode, 0);
            int ls = graph.compilerShapeIdx(logits);
            if (graph.compilerValueExists(logits) == 0) return 0;

            // 2) label / loss / dlogits 张量（label 由训练循环灌 one-hot）
            // 注意：label 必须与 logits 同秩且同 shape kind——5D 分割 logits
            // [N,C,D,H,W] 走 addShapeD5，否则漏深度维（同 Flatten 5D BUG：4D
            // 注册丢 shD4 → label 越界/覆盖）；shape kind 直接镜像 logits（否则
            // FC_ACT 分支在 buildRuntime 里优先于 5D 分支 → label 被注册成 [C,1]）。
            if (graph.compilerShapeR5(ls) == 1)
                graph.addShapeD5("label", graph.compilerShapeDim(ls, 0), graph.compilerShapeDim(ls, 1), graph.compilerShapeDim(ls, 2), graph.compilerShapeDim(ls, 3), graph.compilerShapeDim(ls, 4));
            else
                graph.addShapeD4("label", graph.compilerShapeDim(ls, 0), graph.compilerShapeDim(ls, 1), graph.compilerShapeDim(ls, 2), graph.compilerShapeDim(ls, 3));
            graph.compilerSetShapeKind("label", graph.compilerShapeKind(ls));
            graph.addShapeD4("loss", 1, 1, 1, 1);
            graph.compilerSetShapeKind("loss", Kind.FC_ACT());
            graph.compilerEnsureGrad(logits);

            // 3) loss 节点：CE（SoftmaxCE(logits,label)→(dlogits,loss)）或
            //    Dice（DiceLoss(prob,label)→(dprob,loss) + BwdSoftmax(dprob,prob)→dlogits）
            if (graph.compilerLossMode() == 1) {
                // prob = Softmax 输出（图输出）；其梯度 dprob 由 DiceLoss 产出，
                // 经 BwdSoftmax 链式回传到 logits 梯度 dlogits。
                string prob = graph.compilerNodeOutput(smNode, 0);
                graph.compilerEnsureGrad(prob);
                int nid = graph.nodeCount();
                graph.beginNode();
                graph.nodeType(nid, "DiceLoss");
                graph.nodeIn(nid, 0, prob);
                graph.nodeIn(nid, 1, "label");
                graph.nodeOut(nid, graph.compilerGradName(prob));
                graph.nodeOut(nid, "loss");
                graph.endNode();
                int nid2 = graph.nodeCount();
                graph.beginNode();
                graph.nodeType(nid2, "BwdSoftmax");
                graph.nodeIn(nid2, 0, graph.compilerGradName(prob));
                graph.nodeIn(nid2, 1, prob);
                graph.nodeOut(nid2, graph.compilerGradName(logits));
                graph.endNode();
            } else {
                int nid = graph.nodeCount();
                graph.beginNode();
                graph.nodeType(nid, "SoftmaxCE");
                graph.nodeIn(nid, 0, logits);
                graph.nodeIn(nid, 1, "label");
                graph.nodeOut(nid, graph.compilerGradName(logits));
                graph.nodeOut(nid, "loss");
                graph.endNode();
            }

            // 4) 反向拓扑遍历（analysis_ order 逆序）：输出梯度已知 → 按算子类型追加 backward
            int oi = graph.compilerAnalysisPlanOrderCount() - 1;
            while (oi >= 0) {
                int ni = graph.compilerAnalysisPlanOrder(oi);
                string t = graph.nodeTypeAt(ni);
                if (t != "") {
                    string y = graph.compilerNodeOutput(ni, 0);
                    if (graph.compilerValueExists(graph.compilerGradName(y)) == 1) {
                        // 确保该节点各输入/输出的梯度张量形状都登记（否则 buildRuntime 注册不到）
                        graph.compilerEnsureGrad(graph.nodeInAt(ni, 0));
                        graph.compilerEnsureGrad(graph.nodeInAt(ni, 1));
                        graph.compilerEnsureGrad(graph.nodeInAt(ni, 2));
                        graph.compilerEnsureGrad(graph.nodeInAt(ni, 3));
                        if (t == "Gemm") {
                            // BwdDense(dy, x, w) → (dx, dw, db)
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdDense");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeIn(bd, 2, graph.nodeInAt(ni, 1));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 2)));
                            graph.endNode();
                        } else if (t == "MatMul") {
                            // 无偏置：db 输出用 0 占位（runtime 忽略）
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdDense");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeIn(bd, 2, graph.nodeInAt(ni, 1));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.nodeOut(bd, "");
                            graph.endNode();
                        } else if (t == "Relu") {
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdRelu");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.endNode();
                        } else if (t == "Sigmoid") {
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdSigmoid");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, y);              // 用前向输出 y
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.endNode();
                        } else if (t == "Add") {
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdAdd");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.endNode();
                        } else if (t == "Conv") {
                            // BwdConv(dy, x, w) → (dx, dw, db)；复制卷积参数
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdConv");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeIn(bd, 2, graph.nodeInAt(ni, 1));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 2)));   // 无偏置 → "" → runtime db=-1
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.SH(), graph.compilerAttr(ni, NodeField.SH())); graph.compilerAttrSet(bd, NodeField.SW(), graph.compilerAttr(ni, NodeField.SW()));
                            graph.compilerAttrSet(bd, NodeField.PT(), graph.compilerAttr(ni, NodeField.PT())); graph.compilerAttrSet(bd, NodeField.PL(), graph.compilerAttr(ni, NodeField.PL()));
                            graph.compilerAttrSet(bd, NodeField.DH(), graph.compilerAttr(ni, NodeField.DH())); graph.compilerAttrSet(bd, NodeField.DW(), graph.compilerAttr(ni, NodeField.DW())); graph.compilerAttrSet(bd, NodeField.GROUP(), graph.compilerAttr(ni, NodeField.GROUP()));
                        } else if (t == "MaxPool") {
                            // BwdMaxPool(dy, x) → (dx)；复制池化参数
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdMaxPool");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.KH(), graph.compilerAttr(ni, NodeField.KH())); graph.compilerAttrSet(bd, NodeField.KW(), graph.compilerAttr(ni, NodeField.KW()));
                            graph.compilerAttrSet(bd, NodeField.SH(), graph.compilerAttr(ni, NodeField.SH())); graph.compilerAttrSet(bd, NodeField.SW(), graph.compilerAttr(ni, NodeField.SW()));
                            graph.compilerAttrSet(bd, NodeField.PT(), graph.compilerAttr(ni, NodeField.PT())); graph.compilerAttrSet(bd, NodeField.PL(), graph.compilerAttr(ni, NodeField.PL()));
                        } else if (t == "ConvTranspose") {
                            // 阶段4d：BwdConvTranspose(dy, x, w) → (dx, dw, db)；复制转置卷积参数
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdConvTranspose");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeIn(bd, 2, graph.nodeInAt(ni, 1));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 2)));   // 无偏置 → "" → runtime db=-1
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.SH(), graph.compilerAttr(ni, NodeField.SH())); graph.compilerAttrSet(bd, NodeField.SW(), graph.compilerAttr(ni, NodeField.SW()));
                            graph.compilerAttrSet(bd, NodeField.PT(), graph.compilerAttr(ni, NodeField.PT())); graph.compilerAttrSet(bd, NodeField.PB(), graph.compilerAttr(ni, NodeField.PB()));
                            graph.compilerAttrSet(bd, NodeField.PL(), graph.compilerAttr(ni, NodeField.PL())); graph.compilerAttrSet(bd, NodeField.PR(), graph.compilerAttr(ni, NodeField.PR()));
                        } else if (t == "Conv3D") {
                            // 阶段4：BwdConv3D(dy, x, w) → (dx, dw, db)；复制 3D 卷积参数
                            // （kd/kh/kw 与 group 由 w 张量形状给出；dd/dh/dw 假定 1）
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdConv3D");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeIn(bd, 2, graph.nodeInAt(ni, 1));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 2)));   // 无偏置 → "" → runtime db=-1
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.SD3(), graph.compilerAttr(ni, NodeField.SD3())); graph.compilerAttrSet(bd, NodeField.SH(), graph.compilerAttr(ni, NodeField.SH())); graph.compilerAttrSet(bd, NodeField.SW(), graph.compilerAttr(ni, NodeField.SW()));
                            graph.compilerAttrSet(bd, NodeField.PDT(), graph.compilerAttr(ni, NodeField.PDT())); graph.compilerAttrSet(bd, NodeField.PDB(), graph.compilerAttr(ni, NodeField.PDB()));
                            graph.compilerAttrSet(bd, NodeField.PT(), graph.compilerAttr(ni, NodeField.PT())); graph.compilerAttrSet(bd, NodeField.PB(), graph.compilerAttr(ni, NodeField.PB()));
                            graph.compilerAttrSet(bd, NodeField.PL(), graph.compilerAttr(ni, NodeField.PL())); graph.compilerAttrSet(bd, NodeField.PR(), graph.compilerAttr(ni, NodeField.PR()));
                        } else if (t == "MaxPool3D") {
                            // 阶段4：BwdMaxPool3D(dy, x) → (dx)；复制 3D 池化参数
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdMaxPool3D");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.KD3(), graph.compilerAttr(ni, NodeField.KD3())); graph.compilerAttrSet(bd, NodeField.KH(), graph.compilerAttr(ni, NodeField.KH())); graph.compilerAttrSet(bd, NodeField.KW(), graph.compilerAttr(ni, NodeField.KW()));
                            graph.compilerAttrSet(bd, NodeField.SD3(), graph.compilerAttr(ni, NodeField.SD3())); graph.compilerAttrSet(bd, NodeField.SH(), graph.compilerAttr(ni, NodeField.SH())); graph.compilerAttrSet(bd, NodeField.SW(), graph.compilerAttr(ni, NodeField.SW()));
                            graph.compilerAttrSet(bd, NodeField.PDT(), graph.compilerAttr(ni, NodeField.PDT())); graph.compilerAttrSet(bd, NodeField.PDB(), graph.compilerAttr(ni, NodeField.PDB()));
                            graph.compilerAttrSet(bd, NodeField.PT(), graph.compilerAttr(ni, NodeField.PT())); graph.compilerAttrSet(bd, NodeField.PB(), graph.compilerAttr(ni, NodeField.PB()));
                            graph.compilerAttrSet(bd, NodeField.PL(), graph.compilerAttr(ni, NodeField.PL())); graph.compilerAttrSet(bd, NodeField.PR(), graph.compilerAttr(ni, NodeField.PR()));
                        } else if (t == "AveragePool3D") {
                            // 阶段4：BwdAvgPool3D(dy, x) → (dx)；复制 3D 池化参数 + cip
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdAvgPool3D");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.KD3(), graph.compilerAttr(ni, NodeField.KD3())); graph.compilerAttrSet(bd, NodeField.KH(), graph.compilerAttr(ni, NodeField.KH())); graph.compilerAttrSet(bd, NodeField.KW(), graph.compilerAttr(ni, NodeField.KW()));
                            graph.compilerAttrSet(bd, NodeField.SD3(), graph.compilerAttr(ni, NodeField.SD3())); graph.compilerAttrSet(bd, NodeField.SH(), graph.compilerAttr(ni, NodeField.SH())); graph.compilerAttrSet(bd, NodeField.SW(), graph.compilerAttr(ni, NodeField.SW()));
                            graph.compilerAttrSet(bd, NodeField.PDT(), graph.compilerAttr(ni, NodeField.PDT())); graph.compilerAttrSet(bd, NodeField.PDB(), graph.compilerAttr(ni, NodeField.PDB()));
                            graph.compilerAttrSet(bd, NodeField.PT(), graph.compilerAttr(ni, NodeField.PT())); graph.compilerAttrSet(bd, NodeField.PB(), graph.compilerAttr(ni, NodeField.PB()));
                            graph.compilerAttrSet(bd, NodeField.PL(), graph.compilerAttr(ni, NodeField.PL())); graph.compilerAttrSet(bd, NodeField.PR(), graph.compilerAttr(ni, NodeField.PR()));
                            graph.compilerAttrSet(bd, NodeField.CIP(), graph.compilerAttr(ni, NodeField.CIP()));
                        } else if (t == "Resize" || t == "Upsample") {
                            // 阶段4d：Resize3D 反向 → BwdResize(dy, x) → dx；复制 mode/transform。
                            // 仅 3D（U-Net 上采样）；2D 反向未实现 → 跳过（梯度 0）。
                            int osr = graph.compilerShapeIdx(y);
                            if (osr >= 0 && graph.compilerShapeR5(osr) == 1) {
                                int bd = graph.nodeCount();
                                graph.beginNode();
                                graph.nodeType(bd, "BwdResize");
                                graph.nodeIn(bd, 0, graph.compilerGradName(y));
                                graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                                graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                                graph.endNode();
                                graph.compilerAttrSet(bd, NodeField.MODE(), graph.compilerAttr(ni, NodeField.MODE()));
                                graph.compilerAttrSet(bd, NodeField.TRANSFORM(), graph.compilerAttr(ni, NodeField.TRANSFORM()));
                            }
                        } else if (t == "Concat") {
                            // U-Net 跳跃连接反向：BwdConcat(dy, x0, x1, x2) → (dx0, dx1, dx2)。
                            // nIn1_/nIn2_/nIn3_ = 原输入（buildRuntime 查轴长）；nOut0-2 = 各输入梯度。
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdConcat");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeIn(bd, 2, graph.nodeInAt(ni, 1));
                            graph.nodeIn(bd, 3, graph.nodeInAt(ni, 2));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 2)));
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.AXIS(), graph.compilerAttr(ni, NodeField.AXIS()));
                        }
                        // Softmax 由 CE 处理；Conv3D/池化等暂不支持（梯度 0，跳过）
                    }
                }
                oi = oi - 1;
            }

            // 5) 权重/偏置追加 Update(W, W#g)（可训参数：FC_W/FC_B/CNN_W/CNN_B）
            // 仅当梯度确实由某个反向算子产出（isNodeOutput）——Resize sizes/scales
            // 等参数初始器虽被 ensureGrad 登记了形状，但没有反向节点产出其梯度，
            // 不应生成 Update（否则 buildRuntime 因该常量非运行时张量而失败）。
            int wi = 0;
            while (wi < graph.compilerWeightCount()) {
                string nm = graph.compilerWeightNameAt(wi);
                int role = graph.compilerWeightGetField(wi, WeightField.ROLE());
                if ((role == 0 || role == 1 || role == 2 || role == 3) && graph.compilerIsNodeOutput(graph.compilerGradName(nm)) == 1) {
                    int uid = graph.nodeCount();
                    // 输出用独立 dummy 标量（不能复用权重名——那会让 producerIdx(权重)=Update，
                    // 权重"被产出"→ 前向消费权重 + Update 依赖梯度 → 环）
                    string dummy = "upd" + Fmt.i(uid);
                    graph.addShapeD4(dummy, 1, 1, 1, 1);
                    graph.compilerSetShapeKind(dummy, Kind.FC_ACT());
                    graph.beginNode();
                    graph.nodeType(uid, "Update");
                    graph.nodeIn(uid, 0, nm);
                    graph.nodeIn(uid, 1, graph.compilerGradName(nm));
                    graph.nodeOut(uid, dummy);
                    graph.endNode();
                }
                wi = wi + 1;
            }
            // 5c) 多消费者梯度（U-Net 跳跃连接）：skip 张量（如 r1/r3）同时被编码器
            //     算子与 Concat 消费 → 梯度名被多反向节点产出。BwdConcat 与主 producer
            //     存在依赖环（编码器反向依赖 concat 上游输出 u#g），不能靠执行顺序累加。
            //     改用显式累加：主 producer 输出改 g_a、BwdConcat 输出改 g_b、加
            //     GradAcc(g_a, g_b) → g（纯前向 Add，消费者读 g）。
            int cc = 0;
            while (cc < graph.nodeCount()) {
                if (graph.nodeOp(cc) == OpCode.BWD_CONCAT()) {
                    int slot = 0;
                    while (slot < 3) {
                        string g;
                        if (slot == 0) g = graph.compilerNodeOutput(cc, 0);
                        else if (slot == 1) g = graph.compilerNodeOutput(cc, 1);
                        else g = graph.compilerNodeOutput(cc, 2);
                        if (g != "" && Str.len(g) >= 2 && Str.substring(g, Str.len(g) - 2, Str.len(g)) == "#g") {
                            int other = -1;
                            int jj = 0;
                            while (jj < graph.nodeCount()) {
                                if (jj != cc && graph.nodeTypeAt(jj) != "" && graph.nodeTypeAt(jj) != "BwdConcat") {
                                    if (graph.compilerNodeOutput(jj, 0) == g || graph.compilerNodeOutput(jj, 1) == g || graph.compilerNodeOutput(jj, 2) == g || graph.compilerNodeOutput(jj, 3) == g) { other = jj; jj = graph.nodeCount(); }
                                }
                                jj = jj + 1;
                            }
                            if (other >= 0) {
                                string ga = g + "_a";
                                string gb = g + "_b";
                                // P3c：结果槽改写走 canonical mutation API（不再直写 SoA）
                                graph.replaceResult(cc, slot, gb);
                                if (graph.compilerNodeOutput(other, 0) == g) graph.replaceResult(other, 0, ga);
                                else if (graph.compilerNodeOutput(other, 1) == g) graph.replaceResult(other, 1, ga);
                                else if (graph.compilerNodeOutput(other, 2) == g) graph.replaceResult(other, 2, ga);
                                else if (graph.compilerNodeOutput(other, 3) == g) graph.replaceResult(other, 3, ga);
                                // 登记 g_a/g_b 形状（同 g）
                                int gs = graph.compilerShapeIdx(g);
                                if (gs >= 0) {
                                    if (graph.compilerShapeR5(gs) == 1) {
                                        graph.addShapeD5(ga, graph.compilerShapeDim(gs, 0), graph.compilerShapeDim(gs, 1), graph.compilerShapeDim(gs, 2), graph.compilerShapeDim(gs, 3), graph.compilerShapeDim(gs, 4));
                                        graph.addShapeD5(gb, graph.compilerShapeDim(gs, 0), graph.compilerShapeDim(gs, 1), graph.compilerShapeDim(gs, 2), graph.compilerShapeDim(gs, 3), graph.compilerShapeDim(gs, 4));
                                    } else {
                                        graph.addShapeD4(ga, graph.compilerShapeDim(gs, 0), graph.compilerShapeDim(gs, 1), graph.compilerShapeDim(gs, 2), graph.compilerShapeDim(gs, 3));
                                        graph.addShapeD4(gb, graph.compilerShapeDim(gs, 0), graph.compilerShapeDim(gs, 1), graph.compilerShapeDim(gs, 2), graph.compilerShapeDim(gs, 3));
                                    }
                                    graph.compilerSetShapeKind(ga, graph.compilerShapeKind(gs));
                                    graph.compilerSetShapeKind(gb, graph.compilerShapeKind(gs));
                                }
                                // GradAcc 纯前向累加节点
                                int an = graph.nodeCount();
                                graph.beginNode();
                                graph.nodeType(an, "GradAcc");
                                graph.nodeIn(an, 0, ga);
                                graph.nodeIn(an, 1, gb);
                                graph.nodeOut(an, g);
                                graph.endNode();
                            }
                        }
                        slot = slot + 1;
                    }
                }
                cc = cc + 1;
            }
            return 1;
        }

        void normalize3DNode(Graph graph, int i) {
            string t = graph.nodeTypeAt(i);
            if (t != "Conv" && t != "MaxPool" && t != "AveragePool" && t != "ConvTranspose") return;
            if (graph.compilerShapeRank5(graph.nodeInAt(i, 0)) != 1) return;
            graph.compilerSetNodeType(i, t + "3D");
            // strides [sd,sh,sw]
            int sd = graph.rawSt(i, 0); if (sd == 0) sd = 1;
            int sh = graph.rawSt(i, 1); if (sh == 0) sh = 1;
            int sw = graph.rawSt(i, 2); if (sw == 0) sw = 1;
            graph.compilerAttrSet(i, NodeField.SD3(), sd); graph.compilerAttrSet(i, NodeField.SH(), sh); graph.compilerAttrSet(i, NodeField.SW(), sw);
            // pads：ONNX 3D 格式 [d_begin, h_begin, w_begin, d_end, h_end, w_end]
            // （此前按 [pdt,pdb,pt,pb,pl,pr] 顺序读取——PyTorch 风格。对称 padding
            // 时各维 top==bottom 看不出；非对称 pads（如 [1,0,0,1,0,0]）会错位，
            // 导致 Conv/AvgPool 输出形状与切片位置错误）
            graph.compilerAttrSet(i, NodeField.PDT(), graph.rawPd(i, 0)); graph.compilerAttrSet(i, NodeField.PDB(), graph.rawPd(i, 3));
            graph.compilerAttrSet(i, NodeField.PT(), graph.rawPd(i, 1)); graph.compilerAttrSet(i, NodeField.PB(), graph.rawPd(i, 4));
            graph.compilerAttrSet(i, NodeField.PL(), graph.rawPd(i, 2)); graph.compilerAttrSet(i, NodeField.PR(), graph.rawPd(i, 5));
            // dilations [dd,dh,dw]
            int dd = graph.rawDl(i, 0); if (dd == 0) dd = 1;
            int dh = graph.rawDl(i, 1); if (dh == 0) dh = 1;
            int dw = graph.rawDl(i, 2); if (dw == 0) dw = 1;
            graph.compilerAttrSet(i, NodeField.DD3(), dd); graph.compilerAttrSet(i, NodeField.DH(), dh); graph.compilerAttrSet(i, NodeField.DW(), dw);
            // kernel_shape [kd,kh,kw]
            graph.compilerAttrSet(i, NodeField.KD3(), graph.rawKk(i, 0)); graph.compilerAttrSet(i, NodeField.KH(), graph.rawKk(i, 1)); graph.compilerAttrSet(i, NodeField.KW(), graph.rawKk(i, 2));
        }

int sliceAxis(Graph graph, int D, long stIn, long enIn, int step, int ax, int nodeIdx, int k) {
            graph.compilerAttrSetIntArray(nodeIdx, 0, k, ax);
            graph.compilerAttrSetIntArray(nodeIdx, 2, k, step);
            int st;
            int cnt = 0;
            if (step > 0) {
                long stL = stIn;
                long enL = enIn;
                if (stL == 9223372036854775807L) stL = long(D);
                if (stL < 0L) stL = stL + long(D);
                if (enL == 9223372036854775807L) enL = long(D);
                if (enL < 0L) enL = enL + long(D);
                if (stL < 0L) stL = 0L;
                if (stL > long(D)) stL = long(D);
                if (enL < 0L) enL = 0L;
                if (enL > long(D)) enL = long(D);
                st = int(stL);
                int en = int(enL);
                if (en > st) cnt = (en - st + step - 1) / step;
            } else {
                long stL = stIn;
                long enL = enIn;
                if (stL == 9223372036854775807L) stL = long(D - 1);
                if (stL < 0L) stL = stL + long(D);
                if (enL == 9223372036854775807L) enL = -1L;
                if (enL < 0L) enL = enL + long(D);
                if (stL < -1L) stL = -1L;
                if (stL > long(D - 1)) stL = long(D - 1);
                if (enL < -1L) enL = -1L;
                if (enL > long(D - 1)) enL = long(D - 1);
                st = int(stL);
                int en = int(enL);
                int nsp = 0 - step;
                if (st > en) cnt = (st - en + nsp - 1) / nsp;
            }
            graph.compilerAttrSetIntArray(nodeIdx, 1, k, st);
            return cnt;
        }

int inferShapes(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                string t = graph.nodeTypeAt(i);
                if (t == "") { i = i + 1; continue; }   // 死节点（折叠/融合消掉）跳过
                // P3：形状链节点（Shape/Constant/Cast/ReduceProd/Unsqueeze/Gather）由
                // foldShapeChains 折叠；仍活着则先尝试折叠（形状随 inferShapes 推进逐步已知）
                // Slice/Concat 仅当「数据输入」是 int64 形状链时才按形状链处理（float 数据
                // Slice/Concat 是运行时算子）：Slice 判 nIn0_（数据），不能看 nIn1_（starts
                // 恒为 int64 初始器，会把数据 Slice 误当形状链跳过 → 输出形状不登记 → 下游
                // Concat shapeIdx 失败 "DBG fail inferShapes"）。
                if (t == "Shape" || t == "Constant" || t == "Cast" || t == "ReduceProd" || t == "Unsqueeze" || t == "Gather" ||
                    (t == "Slice" && (graph.compilerI64Count(graph.nodeInAt(i, 0)) > 0 || graph.compilerI64ChainAlive(graph.nodeInAt(i, 0)) == 1)) ||
                    (t == "Concat" && (graph.compilerI64Count(graph.nodeInAt(i, 0)) > 0 || graph.compilerI64Count(graph.nodeInAt(i, 1)) > 0))) {
                    foldShapeChains(graph);
                    if (graph.nodeTypeAt(i) != "") { i = i + 1; continue; }   // 仍未折叠：跳过
                    t = "";
                }
                if (t == "") { i = i + 1; continue; }
                normalize3DNode(graph, i);
                t = graph.nodeTypeAt(i);
                if (t == "ConvTranspose") {
                    // F8：转置卷积（group=1；权重 [Cin,Cout,kh,kw]，d1=Cout，d2=kh，d3=kw）
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int w = graph.compilerShapeIdx(graph.nodeInAt(i, 1)); if (graph.compilerValueExists(graph.nodeInAt(i, 1)) == 0) return 0;
                    int N = graph.compilerShapeDim(a, 0); int Cin = graph.compilerShapeDim(a, 1); int H = graph.compilerShapeDim(a, 2); int W = graph.compilerShapeDim(a, 3);
                    int Cout = graph.compilerShapeDim(w, 1);
                    int kh = graph.compilerAttr(i, NodeField.KH()); if (kh <= 0) kh = graph.compilerShapeDim(w, 2);
                    int kw = graph.compilerAttr(i, NodeField.KW()); if (kw <= 0) kw = graph.compilerShapeDim(w, 3);
                    int sh_ = graph.compilerAttr(i, NodeField.SH()); if (sh_ <= 0) sh_ = 1;
                    int sw_ = graph.compilerAttr(i, NodeField.SW()); if (sw_ <= 0) sw_ = 1;
                    int yH = (H - 1) * sh_ - graph.compilerAttr(i, NodeField.PT()) - graph.compilerAttr(i, NodeField.PB()) + kh + graph.compilerAttr(i, NodeField.OPH());
                    int yW = (W - 1) * sw_ - graph.compilerAttr(i, NodeField.PL()) - graph.compilerAttr(i, NodeField.PR()) + kw + graph.compilerAttr(i, NodeField.OPW());
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), N, Cout, yH, yW);
                } else if (t == "Conv") {
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int w = graph.compilerShapeIdx(graph.nodeInAt(i, 1)); if (graph.compilerValueExists(graph.nodeInAt(i, 1)) == 0) return 0;
                    int N = graph.compilerShapeDim(a, 0); int H = graph.compilerShapeDim(a, 2); int W = graph.compilerShapeDim(a, 3);
                    int yC = graph.compilerShapeDim(w, 0);
                    int kh = graph.compilerShapeDim(w, 2); int kw = graph.compilerShapeDim(w, 3);
                    if (graph.compilerAttr(i, NodeField.KH()) > 0) kh = graph.compilerAttr(i, NodeField.KH());
                    if (graph.compilerAttr(i, NodeField.KW()) > 0) kw = graph.compilerAttr(i, NodeField.KW());
                    int yH = (H + graph.compilerAttr(i, NodeField.PT()) + graph.compilerAttr(i, NodeField.PB()) - graph.compilerAttr(i, NodeField.DH()) * (kh - 1) - 1) / graph.compilerAttr(i, NodeField.SH()) + 1;
                    int yW = (W + graph.compilerAttr(i, NodeField.PL()) + graph.compilerAttr(i, NodeField.PR()) - graph.compilerAttr(i, NodeField.DW()) * (kw - 1) - 1) / graph.compilerAttr(i, NodeField.SW()) + 1;
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), N, yC, yH, yW);
                } else if (t == "Conv3D") {
                    // 3D：权重 [Cout,Cin,kd,kh,kw]（5D）；kd/kh/kw = shD2/shD3/shD4
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int w = graph.compilerShapeIdx(graph.nodeInAt(i, 1)); if (graph.compilerValueExists(graph.nodeInAt(i, 1)) == 0) return 0;
                    int N = graph.compilerShapeDim(a, 0); int D = graph.compilerShapeDim(a, 2); int H = graph.compilerShapeDim(a, 3); int W = graph.compilerShapeDim(a, 4);
                    int yC = graph.compilerShapeDim(w, 0);
                    int kd = graph.compilerShapeDim(w, 2); int kh = graph.compilerShapeDim(w, 3); int kw = graph.compilerShapeDim(w, 4);
                    if (graph.compilerAttr(i, NodeField.KD3()) > 0) kd = graph.compilerAttr(i, NodeField.KD3());
                    if (graph.compilerAttr(i, NodeField.KH()) > 0) kh = graph.compilerAttr(i, NodeField.KH());
                    if (graph.compilerAttr(i, NodeField.KW()) > 0) kw = graph.compilerAttr(i, NodeField.KW());
                    int sd = graph.compilerAttr(i, NodeField.SD3()); if (sd <= 0) sd = 1;
                    int sh_ = graph.compilerAttr(i, NodeField.SH()); if (sh_ <= 0) sh_ = 1;
                    int sw_ = graph.compilerAttr(i, NodeField.SW()); if (sw_ <= 0) sw_ = 1;
                    int dd = graph.compilerAttr(i, NodeField.DD3()); if (dd <= 0) dd = 1;
                    int dh = graph.compilerAttr(i, NodeField.DH()); if (dh <= 0) dh = 1;
                    int dw = graph.compilerAttr(i, NodeField.DW()); if (dw <= 0) dw = 1;
                    int yD = (D + graph.compilerAttr(i, NodeField.PDT()) + graph.compilerAttr(i, NodeField.PDB()) - dd * (kd - 1) - 1) / sd + 1;
                    int yH = (H + graph.compilerAttr(i, NodeField.PT()) + graph.compilerAttr(i, NodeField.PB()) - dh * (kh - 1) - 1) / sh_ + 1;
                    int yW = (W + graph.compilerAttr(i, NodeField.PL()) + graph.compilerAttr(i, NodeField.PR()) - dw * (kw - 1) - 1) / sw_ + 1;
                    graph.addShapeD5(graph.compilerNodeOutput(i, 0), N, yC, yD, yH, yW);
                } else if (t == "MaxPool3D") {
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int N = graph.compilerShapeDim(a, 0); int C = graph.compilerShapeDim(a, 1); int D = graph.compilerShapeDim(a, 2); int H = graph.compilerShapeDim(a, 3); int W = graph.compilerShapeDim(a, 4);
                    int kd = graph.compilerAttr(i, NodeField.KD3()); if (kd <= 0) kd = 1;
                    int kh = graph.compilerAttr(i, NodeField.KH()); if (kh <= 0) kh = 1;
                    int kw = graph.compilerAttr(i, NodeField.KW()); if (kw <= 0) kw = 1;
                    int sd = graph.compilerAttr(i, NodeField.SD3()); if (sd <= 0) sd = 1;
                    int sh_ = graph.compilerAttr(i, NodeField.SH()); if (sh_ <= 0) sh_ = 1;
                    int sw_ = graph.compilerAttr(i, NodeField.SW()); if (sw_ <= 0) sw_ = 1;
                    int yD = (D + graph.compilerAttr(i, NodeField.PDT()) + graph.compilerAttr(i, NodeField.PDB()) - kd) / sd + 1;
                    int yH = (H + graph.compilerAttr(i, NodeField.PT()) + graph.compilerAttr(i, NodeField.PB()) - kh) / sh_ + 1;
                    int yW = (W + graph.compilerAttr(i, NodeField.PL()) + graph.compilerAttr(i, NodeField.PR()) - kw) / sw_ + 1;
                    graph.addShapeD5(graph.compilerNodeOutput(i, 0), N, C, yD, yH, yW);
                } else if (t == "AveragePool3D") {
                    // 3D：各向异性核 kd/kh/kw + 6 pads + cip
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int N = graph.compilerShapeDim(a, 0); int C = graph.compilerShapeDim(a, 1); int D = graph.compilerShapeDim(a, 2); int H = graph.compilerShapeDim(a, 3); int W = graph.compilerShapeDim(a, 4);
                    int kd = graph.compilerAttr(i, NodeField.KD3()); if (kd <= 0) kd = 1;
                    int kh = graph.compilerAttr(i, NodeField.KH()); if (kh <= 0) kh = 1;
                    int kw = graph.compilerAttr(i, NodeField.KW()); if (kw <= 0) kw = 1;
                    int sd = graph.compilerAttr(i, NodeField.SD3()); if (sd <= 0) sd = 1;
                    int sh_ = graph.compilerAttr(i, NodeField.SH()); if (sh_ <= 0) sh_ = 1;
                    int sw_ = graph.compilerAttr(i, NodeField.SW()); if (sw_ <= 0) sw_ = 1;
                    int yD = (D + graph.compilerAttr(i, NodeField.PDT()) + graph.compilerAttr(i, NodeField.PDB()) - kd) / sd + 1;
                    int yH = (H + graph.compilerAttr(i, NodeField.PT()) + graph.compilerAttr(i, NodeField.PB()) - kh) / sh_ + 1;
                    int yW = (W + graph.compilerAttr(i, NodeField.PL()) + graph.compilerAttr(i, NodeField.PR()) - kw) / sw_ + 1;
                    graph.addShapeD5(graph.compilerNodeOutput(i, 0), N, C, yD, yH, yW);
                } else if (t == "MaxPool") {
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int N = graph.compilerShapeDim(a, 0); int C = graph.compilerShapeDim(a, 1); int H = graph.compilerShapeDim(a, 2); int W = graph.compilerShapeDim(a, 3);
                    int kh = graph.compilerAttr(i, NodeField.KH()); int kw = graph.compilerAttr(i, NodeField.KW());
                    int yH = (H + graph.compilerAttr(i, NodeField.PT()) + graph.compilerAttr(i, NodeField.PB()) - kh) / graph.compilerAttr(i, NodeField.SH()) + 1;
                    int yW = (W + graph.compilerAttr(i, NodeField.PL()) + graph.compilerAttr(i, NodeField.PR()) - kw) / graph.compilerAttr(i, NodeField.SW()) + 1;
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), N, C, yH, yW);
                } else if (t == "AveragePool") {
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int N = graph.compilerShapeDim(a, 0); int C = graph.compilerShapeDim(a, 1); int H = graph.compilerShapeDim(a, 2); int W = graph.compilerShapeDim(a, 3);
                    int kh = graph.compilerAttr(i, NodeField.KH()); int kw = graph.compilerAttr(i, NodeField.KW());
                    int yH = (H + graph.compilerAttr(i, NodeField.PT()) + graph.compilerAttr(i, NodeField.PB()) - kh) / graph.compilerAttr(i, NodeField.SH()) + 1;
                    int yW = (W + graph.compilerAttr(i, NodeField.PL()) + graph.compilerAttr(i, NodeField.PR()) - kw) / graph.compilerAttr(i, NodeField.SW()) + 1;
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), N, C, yH, yW);
                } else if (t == "Pad") {
                    // F8：pads = [N,C,(D,)H,W] 各轴 begin/end（int64 初始器输入，opset11+）
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int is5 = graph.compilerShapeR5(a);
                    if (is5 == 1) {
                        int pc = graph.compilerI64Count(graph.nodeInAt(i, 1));
                        int fromPool = 0;
                        if (pc >= 10) fromPool = 1;
                        else { pc = graph.compilerReadI64Init(graph.nodeInAt(i, 1), 10); }
                        if (pc < 10) return 0;
                        int pnB, pcB, pdB, phB, pwB, pnE, pcE, pdE, phE, pwE;
                        if (fromPool == 1) {
                            pnB = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 0)); pcB = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 1)); pdB = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 2)); phB = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 3)); pwB = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 4));
                            pnE = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 5)); pcE = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 6)); pdE = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 7)); phE = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 8)); pwE = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 9));
                        } else {
                            pnB = int(graph.compilerI64Tmp(0)); pcB = int(graph.compilerI64Tmp(1)); pdB = int(graph.compilerI64Tmp(2)); phB = int(graph.compilerI64Tmp(3)); pwB = int(graph.compilerI64Tmp(4));
                            pnE = int(graph.compilerI64Tmp(5)); pcE = int(graph.compilerI64Tmp(6)); pdE = int(graph.compilerI64Tmp(7)); phE = int(graph.compilerI64Tmp(8)); pwE = int(graph.compilerI64Tmp(9));
                        }
                        graph.compilerAttrSetIntArray(i, 5, 0, pnB); graph.compilerAttrSetIntArray(i, 5, 1, pcB); graph.compilerAttrSetIntArray(i, 5, 2, pdB); graph.compilerAttrSetIntArray(i, 5, 3, phB); graph.compilerAttrSetIntArray(i, 5, 4, pwB);
                        graph.compilerAttrSetIntArray(i, 12, 0, pnE); graph.compilerAttrSetIntArray(i, 12, 1, pcE); graph.compilerAttrSetIntArray(i, 12, 2, pdE); graph.compilerAttrSetIntArray(i, 12, 3, phE); graph.compilerAttrSetIntArray(i, 12, 4, pwE);
                        double cv = 0.0;
                        if (graph.nodeInAt(i, 2) != "") { int cvc = graph.compilerReadF32Init(graph.nodeInAt(i, 2), 1); if (cvc > 0) cv = graph.compilerF32Tmp(0); }
                        graph.compilerSetNPadCval(i, F32.toBits(cv));
                        graph.addShapeD5(graph.compilerNodeOutput(i, 0), graph.compilerShapeDim(a, 0) + pnB + pnE, graph.compilerShapeDim(a, 1) + pcB + pcE,
                                   graph.compilerShapeDim(a, 2) + pdB + pdE, graph.compilerShapeDim(a, 3) + phB + phE, graph.compilerShapeDim(a, 4) + pwB + pwE);
                        // pads/constant_value 已折叠进 nPadB5_/nPadE5_/nPadCval_
                        // （buildRuntime 只读这些折叠数组）→ 清空悬空参数槽，避免
                        // verifyIR 报 val<0（foldShapeChains 折叠 pads 链时生产者
                        // 已 erase、其 shape 未登记）。
                        graph.compilerSetNodeInput(i, 1, ""); graph.compilerSetNodeInput(i, 2, "");
                    } else {
                        int pc = graph.compilerI64Count(graph.nodeInAt(i, 1));
                        int fromPool = 0;
                        if (pc >= 8) fromPool = 1;
                        else { pc = graph.compilerReadI64Init(graph.nodeInAt(i, 1), 8); }
                        if (pc < 8) return 0;
                        int pnB, pcB, phB, pwB, pnE, pcE, phE, pwE;
                        if (fromPool == 1) {
                            pnB = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 0)); pcB = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 1)); phB = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 2)); pwB = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 3));
                            pnE = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 4)); pcE = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 5)); phE = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 6)); pwE = int(graph.compilerI64Get(graph.nodeInAt(i, 1), 7));
                        } else {
                            pnB = int(graph.compilerI64Tmp(0)); pcB = int(graph.compilerI64Tmp(1)); phB = int(graph.compilerI64Tmp(2)); pwB = int(graph.compilerI64Tmp(3));
                            pnE = int(graph.compilerI64Tmp(4)); pcE = int(graph.compilerI64Tmp(5)); phE = int(graph.compilerI64Tmp(6)); pwE = int(graph.compilerI64Tmp(7));
                        }
                        graph.compilerAttrSetIntArray(i, 3, 0, pnB); graph.compilerAttrSetIntArray(i, 3, 1, pcB); graph.compilerAttrSetIntArray(i, 3, 2, phB); graph.compilerAttrSetIntArray(i, 3, 3, pwB);
                        graph.compilerAttrSetIntArray(i, 4, 0, pnE); graph.compilerAttrSetIntArray(i, 4, 1, pcE); graph.compilerAttrSetIntArray(i, 4, 2, phE); graph.compilerAttrSetIntArray(i, 4, 3, pwE);
                        double cv = 0.0;
                        if (graph.nodeInAt(i, 2) != "") { int cvc = graph.compilerReadF32Init(graph.nodeInAt(i, 2), 1); if (cvc > 0) cv = graph.compilerF32Tmp(0); }
                        graph.compilerSetNPadCval(i, F32.toBits(cv));
                        graph.addShapeD4(graph.compilerNodeOutput(i, 0), graph.compilerShapeDim(a, 0) + pnB + pnE, graph.compilerShapeDim(a, 1) + pcB + pcE,
                                   graph.compilerShapeDim(a, 2) + phB + phE, graph.compilerShapeDim(a, 3) + pwB + pwE);
                        // pads/constant_value 已折叠进 nPadB_/nPadE_/nPadCval_ → 清空参数槽
                        graph.compilerSetNodeInput(i, 1, ""); graph.compilerSetNodeInput(i, 2, "");
                    }
                } else if (t == "GlobalAveragePool") {
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), graph.compilerShapeDim(a, 0), graph.compilerShapeDim(a, 1), 1, 1);
                } else if (t == "Flatten") {
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    // F8 3D：5D 输入（NCDHW）须连深度维一起拍平（shD1*shD2*shD3*shD4）
                    int f = graph.compilerShapeDim(a, 1) * graph.compilerShapeDim(a, 2) * graph.compilerShapeDim(a, 3);
                    if (graph.compilerShapeR5(a) == 1) f = f * graph.compilerShapeDim(a, 4);
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), graph.compilerShapeDim(a, 0), f, 1, 1);
                } else if (t == "Gemm") {
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int w = graph.compilerShapeIdx(graph.nodeInAt(i, 1)); if (graph.compilerValueExists(graph.nodeInAt(i, 1)) == 0) return 0;
                    int m = graph.compilerShapeDim(a, 0);                     // [M,K]
                    int n = graph.compilerShapeDim(w, 0);                     // transB=1: [N,K] → N=d0
                    if (graph.compilerAttr(i, NodeField.TRANSB()) == 0) n = graph.compilerShapeDim(w, 1);   // transB=0: [K,N] → N=d1
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), m, n, 1, 1);
                } else if (t == "MatMul") {
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int b = graph.compilerShapeIdx(graph.nodeInAt(i, 1)); if (graph.compilerValueExists(graph.nodeInAt(i, 1)) == 0) return 0;
                    int ar = graph.compilerShapeR5(a) == 1 ? 5 : 4;
                    int br = graph.compilerShapeR5(b) == 1 ? 5 : 4;
                    if (ar >= 3 && br >= 3) {
                        // 阶段四：BatchMatMul——batch 维逐维 max 广播 + 最后两维 matmul
                        // A [ab0,ab1,M,K] × B [bb0,bb1,K,N] → [max(ab0,bb0), max(ab1,bb1), M, N]
                        int od0 = graph.compilerShapeDim(a, 0); if (graph.compilerShapeDim(b, 0) > od0) od0 = graph.compilerShapeDim(b, 0);
                        int od1 = graph.compilerShapeDim(a, 1); if (graph.compilerShapeDim(b, 1) > od1) od1 = graph.compilerShapeDim(b, 1);
                        graph.addShapeD4(graph.compilerNodeOutput(i, 0), od0, od1, graph.compilerShapeDim(a, 2), graph.compilerShapeDim(b, 3));
                    } else {
                        graph.addShapeD4(graph.compilerNodeOutput(i, 0), graph.compilerShapeDim(a, 0), graph.compilerShapeDim(b, 1), 1, 1);
                    }
                } else if (t == "Add") {
                    // 阶段三：统一 numpy 广播——输出 = a/b 逐维 max（无 shape 的输入按 1）
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int b = graph.compilerShapeIdx(graph.nodeInAt(i, 1));
                    int od0 = graph.compilerShapeDim(a, 0), od1 = graph.compilerShapeDim(a, 1), od2 = graph.compilerShapeDim(a, 2), od3 = graph.compilerShapeDim(a, 3);
                    if (b >= 0) {
                        if (graph.compilerShapeDim(b, 0) > od0) od0 = graph.compilerShapeDim(b, 0);
                        if (graph.compilerShapeDim(b, 1) > od1) od1 = graph.compilerShapeDim(b, 1);
                        if (graph.compilerShapeDim(b, 2) > od2) od2 = graph.compilerShapeDim(b, 2);
                        if (graph.compilerShapeDim(b, 3) > od3) od3 = graph.compilerShapeDim(b, 3);
                    }
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), od0, od1, od2, od3);
                } else if (t == "Relu" || t == "Sigmoid" || t == "Softmax" || t == "LogSoftmax" || t == "BatchNormalization"
                           || t == "ReLU6" || t == "LeakyRelu" || t == "SiLU" || t == "HardSwish" || t == "Clip" || t == "Dropout") {
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    graph.copyShape(graph.compilerNodeOutput(i, 0), a);
                } else if (t == "Embedding") {
                    // G5：查表。data[vocab,D] + ids[int64 初始器，S] → out[S,D,1,1]
                    int w = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int lenS = graph.compilerReadI64Init(graph.nodeInAt(i, 1), 64);
                    if (lenS <= 0) return 0;
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), lenS, graph.compilerShapeDim(w, 1), 1, 1);
                } else if (t == "Reshape") {
                    // F8：shape 来自输入[1]（int64 初始器）；-1 = 由总元素数推断，0 = 复制对应输入维
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int sc = graph.compilerReadI64Init(graph.nodeInAt(i, 1), 8);
                    if (sc <= 0) return 0;
                    int total = graph.compilerShapeDim(a, 0) * graph.compilerShapeDim(a, 1) * graph.compilerShapeDim(a, 2) * graph.compilerShapeDim(a, 3);
                    int[] outd = new int[8];
                    int inferIdx = -1;
                    int prod = 1;
                    int d = 0;
                    while (d < sc) {
                        int v = int(graph.compilerI64Tmp(d));
                        if (v == -1) { inferIdx = d; outd[d] = 1; }
                        else if (v == 0) {
                            if (d < 4) { outd[d] = (d == 0) ? graph.compilerShapeDim(a, 0) : ((d == 1) ? graph.compilerShapeDim(a, 1) : ((d == 2) ? graph.compilerShapeDim(a, 2) : graph.compilerShapeDim(a, 3))); }
                            else outd[d] = 1;
                        }
                        else outd[d] = v;
                        prod = prod * outd[d];
                        d = d + 1;
                    }
                    if (inferIdx >= 0 && prod > 0) outd[inferIdx] = total / prod;
                    int od0 = 1, od1 = 1, od2 = 1, od3 = 1;
                    if (sc >= 1) od0 = outd[0];
                    if (sc >= 2) od1 = outd[1];
                    if (sc >= 3) od2 = outd[2];
                    if (sc >= 4) od3 = outd[3];
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), od0, od1, od2, od3);
                } else if (t == "Expand") {
                    // G4：broadcast 复制。目标形状来自 int64 输入[1]；输入维=1 时沿该维复制。
                    // 输出 = 目标形状（左对齐广播，rank 不足时前置补 1）。
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int sc = graph.compilerReadI64Init(graph.nodeInAt(i, 1), 8);
                    if (sc <= 0) return 0;
                    int[] outd = new int[8];
                    int d = 0;
                    while (d < sc) { outd[d] = int(graph.compilerI64Tmp(d)); d = d + 1; }
                    // 左对齐：目标 rank=sc，输入 rank 前置补 1 到 sc
                    int inRank = graph.compilerShapeR5(a) == 1 ? 5 : 4;
                    int off = sc - inRank;
                    if (off < 0) off = 0;
                    int od0 = 1, od1 = 1, od2 = 1, od3 = 1;
                    if (sc >= 1) od0 = outd[0];
                    if (sc >= 2) od1 = outd[1];
                    if (sc >= 3) od2 = outd[2];
                    if (sc >= 4) od3 = outd[3];
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), od0, od1, od2, od3);
                } else if (t == "Where") {
                    // G5：逐元素选择 out = cond ? x : y（三输入广播，缺省维=1）。
                    // 输出 = cond/x/y 逐维 max（广播合并）；无 shape 的输入按 1。
                    int c = graph.compilerShapeIdx(graph.nodeInAt(i, 0));
                    int x = graph.compilerShapeIdx(graph.nodeInAt(i, 1));
                    int y = graph.compilerShapeIdx(graph.nodeInAt(i, 2));
                    int od0 = 1, od1 = 1, od2 = 1, od3 = 1;
                    if (c >= 0) {
                        if (graph.compilerShapeDim(c, 0) > od0) od0 = graph.compilerShapeDim(c, 0);
                        if (graph.compilerShapeDim(c, 1) > od1) od1 = graph.compilerShapeDim(c, 1);
                        if (graph.compilerShapeDim(c, 2) > od2) od2 = graph.compilerShapeDim(c, 2);
                        if (graph.compilerShapeDim(c, 3) > od3) od3 = graph.compilerShapeDim(c, 3);
                    }
                    if (x >= 0) {
                        if (graph.compilerShapeDim(x, 0) > od0) od0 = graph.compilerShapeDim(x, 0);
                        if (graph.compilerShapeDim(x, 1) > od1) od1 = graph.compilerShapeDim(x, 1);
                        if (graph.compilerShapeDim(x, 2) > od2) od2 = graph.compilerShapeDim(x, 2);
                        if (graph.compilerShapeDim(x, 3) > od3) od3 = graph.compilerShapeDim(x, 3);
                    }
                    if (y >= 0) {
                        if (graph.compilerShapeDim(y, 0) > od0) od0 = graph.compilerShapeDim(y, 0);
                        if (graph.compilerShapeDim(y, 1) > od1) od1 = graph.compilerShapeDim(y, 1);
                        if (graph.compilerShapeDim(y, 2) > od2) od2 = graph.compilerShapeDim(y, 2);
                        if (graph.compilerShapeDim(y, 3) > od3) od3 = graph.compilerShapeDim(y, 3);
                    }
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), od0, od1, od2, od3);
                } else if (t == "Tile") {
                    // G5：沿各维按倍数复制。输出 = 输入维 × repeats 维（逐元素乘）。
                    // repeats 来自 int64 输入[1]（左对齐，rank 不足前置补 1）。
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int sc = graph.compilerReadI64Init(graph.nodeInAt(i, 1), 8);
                    if (sc <= 0) return 0;
                    int inRank = graph.compilerShapeR5(a) == 1 ? 5 : 4;
                    int off = sc - inRank;
                    if (off < 0) off = 0;
                    int r0 = 1, r1 = 1, r2 = 1, r3 = 1;
                    if (off + 0 < sc) r0 = int(graph.compilerI64Tmp(off + 0));
                    if (off + 1 < sc) r1 = int(graph.compilerI64Tmp(off + 1));
                    if (off + 2 < sc) r2 = int(graph.compilerI64Tmp(off + 2));
                    if (off + 3 < sc) r3 = int(graph.compilerI64Tmp(off + 3));
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0),
                                     graph.compilerShapeDim(a, 0) * r0,
                                     graph.compilerShapeDim(a, 1) * r1,
                                     graph.compilerShapeDim(a, 2) * r2,
                                     graph.compilerShapeDim(a, 3) * r3);
                } else if (t == "Squeeze") {
                    // G5：去掉 size-1 维（axes 属性；无 axes → 全 size-1 维）。
                    // 数据不变（连续拷贝）；输出 = 去维后保持轴顺序 + 左对齐补 1 到 4D。
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int[] d = new int[4];
                    d[0] = graph.compilerShapeDim(a, 0); d[1] = graph.compilerShapeDim(a, 1); d[2] = graph.compilerShapeDim(a, 2); d[3] = graph.compilerShapeDim(a, 3);
                    int[] keep = new int[4];
                    keep[0] = 1; keep[1] = 1; keep[2] = 1; keep[3] = 1;
                    int nAx = graph.compilerAttr(i, NodeField.AXES_N());
                    if (nAx <= 0) {
                        int k = 0;
                        while (k < 4) { if (d[k] == 1) keep[k] = 0; k = k + 1; }
                    } else {
                        int k = 0;
                        while (k < nAx && k < 4) {
                            int ax = (k == 0) ? graph.compilerAttr(i, NodeField.AXES0()) : ((k == 1) ? graph.compilerAttr(i, NodeField.AXES1()) : ((k == 2) ? graph.compilerAttr(i, NodeField.AXES2()) : graph.compilerAttr(i, NodeField.AXES3())));
                            if (ax < 0) ax = ax + 4;
                            if (ax >= 0 && ax < 4) keep[ax] = 0;
                            k = k + 1;
                        }
                    }
                    int[] od = new int[4];
                    int n = 0;
                    int k = 0;
                    while (k < 4) { if (keep[k] == 1) { od[n] = d[k]; n = n + 1; } k = k + 1; }
                    while (n < 4) { od[n] = 1; n = n + 1; }
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), od[0], od[1], od[2], od[3]);
                } else if (t == "Gather") {
                    // G5：沿 axis 按 indices 收集（数据 Gather；indices int64 初始器）。
                    // 输出 = data dims 替换 axis 维为 len(indices)。形状链 Gather 已折叠跳过。
                    if (graph.compilerI64Count(graph.nodeInAt(i, 0)) > 0) { i = i + 1; continue; }
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int axis = graph.compilerAttr(i, NodeField.AXIS());
                    if (axis < 0) axis = 0;
                    int lenIdx = graph.compilerReadI64Init(graph.nodeInAt(i, 1), 64);
                    if (lenIdx <= 0) return 0;
                    int od0 = graph.compilerShapeDim(a, 0), od1 = graph.compilerShapeDim(a, 1), od2 = graph.compilerShapeDim(a, 2), od3 = graph.compilerShapeDim(a, 3);
                    if (axis == 0) od0 = lenIdx;
                    else if (axis == 1) od1 = lenIdx;
                    else if (axis == 2) od2 = lenIdx;
                    else od3 = lenIdx;
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), od0, od1, od2, od3);
                } else if (t == "Concat") {
                    // F8：沿 axis 拼接（2-3 输入），输出 = 各输入沿 axis 之和，其余维同输入0
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int axis = graph.compilerAttr(i, NodeField.AXIS());
                    if (axis < 0) axis = 0;
                    int is5 = graph.compilerShapeR5(a);
                    int[] dims = new int[5];
                    dims[0] = graph.compilerShapeDim(a, 0); dims[1] = graph.compilerShapeDim(a, 1); dims[2] = graph.compilerShapeDim(a, 2); dims[3] = graph.compilerShapeDim(a, 3); dims[4] = graph.compilerShapeDim(a, 4);
                    // 沿 axis 累计（最多 3 输入，与 runtime opA/opB/opC 一致）
                    int axisSum = 0;
                    int slot = 0;
                    while (slot < 3) {
                        string nm;
                        if (slot == 0) nm = graph.nodeInAt(i, 0);
                        else if (slot == 1) nm = graph.nodeInAt(i, 1);
                        else nm = graph.nodeInAt(i, 2);
                        if (nm == "") { slot = 3; break; }
                        int s = graph.compilerShapeIdx(nm); if (graph.compilerValueExists(nm) == 0) return 0;
                        int av = (axis == 0) ? graph.compilerShapeDim(s, 0) : ((axis == 1) ? graph.compilerShapeDim(s, 1) : ((axis == 2) ? graph.compilerShapeDim(s, 2) : ((axis == 3) ? graph.compilerShapeDim(s, 3) : graph.compilerShapeDim(s, 4))));
                        axisSum = axisSum + av;
                        slot = slot + 1;
                    }
                    if (axis == 0) dims[0] = axisSum;
                    else if (axis == 1) dims[1] = axisSum;
                    else if (axis == 2) dims[2] = axisSum;
                    else if (axis == 3) dims[3] = axisSum;
                    else dims[4] = axisSum;
                    if (is5 == 1) graph.addShapeD5(graph.compilerNodeOutput(i, 0), dims[0], dims[1], dims[2], dims[3], dims[4]);
                    else graph.addShapeD4(graph.compilerNodeOutput(i, 0), dims[0], dims[1], dims[2], dims[3]);
                } else if (t == "Transpose") {
                    // F8：perm 属性（缺省 = 反转维度）
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int nd = 4;
                    int p0, p1, p2, p3;
                    if (graph.compilerAttr(i, NodeField.PERM_N()) >= 4) { p0 = graph.compilerAttr(i, NodeField.PERM0()); p1 = graph.compilerAttr(i, NodeField.PERM1()); p2 = graph.compilerAttr(i, NodeField.PERM2()); p3 = graph.compilerAttr(i, NodeField.PERM3()); }
                    else if (graph.compilerAttr(i, NodeField.PERM_N()) == 3) { p0 = graph.compilerAttr(i, NodeField.PERM0()); p1 = graph.compilerAttr(i, NodeField.PERM1()); p2 = graph.compilerAttr(i, NodeField.PERM2()); p3 = 3; }
                    else if (graph.compilerAttr(i, NodeField.PERM_N()) == 2) { p0 = graph.compilerAttr(i, NodeField.PERM0()); p1 = graph.compilerAttr(i, NodeField.PERM1()); p2 = 2; p3 = 3; }
                    else if (graph.compilerAttr(i, NodeField.PERM_N()) == 1) { p0 = graph.compilerAttr(i, NodeField.PERM0()); p1 = 1; p2 = 2; p3 = 3; }
                    else { p0 = 3; p1 = 2; p2 = 1; p3 = 0; }   // 缺省反转
                    int id0 = graph.compilerShapeDim(a, 0), id1 = graph.compilerShapeDim(a, 1), id2 = graph.compilerShapeDim(a, 2), id3 = graph.compilerShapeDim(a, 3);
                    int[] od = new int[4];
                    od[0] = (p0 == 0) ? id0 : ((p0 == 1) ? id1 : ((p0 == 2) ? id2 : id3));
                    od[1] = (p1 == 0) ? id0 : ((p1 == 1) ? id1 : ((p1 == 2) ? id2 : id3));
                    od[2] = (p2 == 0) ? id0 : ((p2 == 1) ? id1 : ((p2 == 2) ? id2 : id3));
                    od[3] = (p3 == 0) ? id0 : ((p3 == 1) ? id1 : ((p3 == 2) ? id2 : id3));
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), od[0], od[1], od[2], od[3]);
                } else if (t == "Slice") {
                    // F8：starts/ends/axes/steps 为 int64 初始器输入（opset 10+）
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int sc = graph.compilerReadI64Init(graph.nodeInAt(i, 1), 8);   // starts
                    if (sc <= 0) return 0;
                    int k = 0;
                    while (k < sc) { graph.compilerAttrSetLongArray(i, 0, k, graph.compilerI64Tmp(k)); k = k + 1; }
                    int ec = graph.compilerReadI64Init(graph.nodeInAt(i, 2), 8);   // ends
                    if (ec <= 0) return 0;
                    k = 0;
                    while (k < ec) { graph.compilerAttrSetLongArray(i, 1, k, graph.compilerI64Tmp(k)); k = k + 1; }
                    int ac = graph.compilerReadI64Init(graph.nodeInAt(i, 3), 8);   // axes（可缺省 → 0..）
                    k = 0;
                    while (k < ac) { graph.compilerAttrSetLongArray(i, 2, k, graph.compilerI64Tmp(k)); k = k + 1; }
                    int pc = graph.compilerReadI64Init(graph.nodeInAt(i, 4), 8);   // steps（可缺省 → 全 1）
                    k = 0;
                    while (k < pc) { graph.compilerAttrSetLongArray(i, 3, k, graph.compilerI64Tmp(k)); k = k + 1; }
                    int cnt = sc;
                    if (cnt > 4) cnt = 4;
                    graph.compilerAttrSetSliceCount(i, cnt);
                    int id0 = graph.compilerShapeDim(a, 0), id1 = graph.compilerShapeDim(a, 1), id2 = graph.compilerShapeDim(a, 2), id3 = graph.compilerShapeDim(a, 3);
                    int[] odim = new int[4];
                    odim[0] = id0; odim[1] = id1; odim[2] = id2; odim[3] = id3;
                    k = 0;
                    while (k < cnt) {
                        int ax = 0;
                        if (ac > 0) ax = int(graph.compilerAttrLongArray(i, 2, k));
                        else ax = k;
                        int step = 1;
                        if (pc > 0) step = int(graph.compilerAttrLongArray(i, 3, k));
                        if (step == 0) return 0;   // 步长不能为 0
                        int D = (ax == 0) ? id0 : ((ax == 1) ? id1 : ((ax == 2) ? id2 : id3));
                        int co = sliceAxis(graph, D, graph.compilerAttrLongArray(i, 0, k), graph.compilerAttrLongArray(i, 1, k), step, ax, i, k);
                        if (ax >= 0 && ax < 4) odim[ax] = co;
                        k = k + 1;
                    }
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), odim[0], odim[1], odim[2], odim[3]);
                } else if (t == "Split") {
                    // F8：沿 axis 分割为 nOutN_ 个输出（split attr 或均分；starts/lens 存 nSplitSt_/nSplitLn_）
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int axis = graph.compilerAttr(i, NodeField.AXIS()); if (axis < 0) axis = 0;
                    int D = (axis == 0) ? graph.compilerShapeDim(a, 0) : ((axis == 1) ? graph.compilerShapeDim(a, 1) : ((axis == 2) ? graph.compilerShapeDim(a, 2) : graph.compilerShapeDim(a, 3)));
                    int no = graph.compilerAttrOutputCount(i); if (no < 1) no = 1;
                    int ns = graph.compilerAttr(i, NodeField.SPLIT_N());
                    int fromInput = 0;
                    if (ns <= 0 && graph.nodeInAt(i, 1) != "") { ns = graph.compilerReadI64Init(graph.nodeInAt(i, 1), 4); fromInput = 1; }   // opset13+：split 为输入
                    int acc = 0;
                    int j = 0;
                    while (j < no && j < 4) {
                        int sz;
                        if (ns > j) {
                            if (fromInput == 1) sz = int(graph.compilerI64Tmp(j));
                            else sz = (j == 0) ? graph.compilerAttr(i, NodeField.SPLIT0()) : ((j == 1) ? graph.compilerAttr(i, NodeField.SPLIT1()) : ((j == 2) ? graph.compilerAttr(i, NodeField.SPLIT2()) : graph.compilerAttr(i, NodeField.SPLIT3())));
                        } else {
                            sz = D / no;
                        }
                        if (j == no - 1) sz = D - acc;   // 最后一份吸收余数
                        if (sz < 0) sz = 0;
                        graph.compilerAttrSetIntArray(i, 6, j, acc);
                        graph.compilerAttrSetIntArray(i, 7, j, sz);
                        acc = acc + sz;
                        int d0 = graph.compilerShapeDim(a, 0), d1 = graph.compilerShapeDim(a, 1), d2 = graph.compilerShapeDim(a, 2), d3 = graph.compilerShapeDim(a, 3);
                        if (axis == 0) d0 = sz;
                        else if (axis == 1) d1 = sz;
                        else if (axis == 2) d2 = sz;
                        else d3 = sz;
                        string onm = (j == 0) ? graph.compilerNodeOutput(i, 0) : ((j == 1) ? graph.compilerNodeOutput(i, 1) : ((j == 2) ? graph.compilerNodeOutput(i, 2) : graph.compilerNodeOutput(i, 3)));
                        graph.addShapeD4(onm, d0, d1, d2, d3);
                        j = j + 1;
                    }
                } else if (t == "Sub" || t == "Div" || t == "Mul") {
                    // 阶段三：统一 numpy 广播——输出 = a/b 逐维 max（无 shape 的输入按 1）
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int b = graph.compilerShapeIdx(graph.nodeInAt(i, 1));
                    int od0 = graph.compilerShapeDim(a, 0), od1 = graph.compilerShapeDim(a, 1), od2 = graph.compilerShapeDim(a, 2), od3 = graph.compilerShapeDim(a, 3);
                    if (b >= 0) {
                        if (graph.compilerShapeDim(b, 0) > od0) od0 = graph.compilerShapeDim(b, 0);
                        if (graph.compilerShapeDim(b, 1) > od1) od1 = graph.compilerShapeDim(b, 1);
                        if (graph.compilerShapeDim(b, 2) > od2) od2 = graph.compilerShapeDim(b, 2);
                        if (graph.compilerShapeDim(b, 3) > od3) od3 = graph.compilerShapeDim(b, 3);
                    }
                    graph.addShapeD4(graph.compilerNodeOutput(i, 0), od0, od1, od2, od3);
                } else if (t == "Sqrt") {
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    graph.copyShape(graph.compilerNodeOutput(i, 0), a);
                } else if (t == "ReduceMean" || t == "ReduceSum" || t == "ReduceMax" || t == "ReduceMin") {
                    // F8：mode 0 = 全规约（标量）；mode 1 = 空间维规约（per-(n,c)，秩无关）
                    // G3：Reduce 族共用 axes 归一化 + mode 判定；redType 记录（mean/sum/max/min）。
                    int redType = 0;
                    if (t == "ReduceSum") redType = 1;
                    else if (t == "ReduceMax") redType = 2;
                    else if (t == "ReduceMin") redType = 3;
                    graph.compilerSetNRedType(i, redType);
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int rank = graph.compilerShapeR5(a) == 1 ? 5 : 4;
                    int nAx = graph.compilerReadI64Init(graph.nodeInAt(i, 1), 8);   // axes 输入（opset18+；可缺省）
                    if (nAx <= 0 && graph.compilerAttr(i, NodeField.AXES_N()) > 0) {
                        // 属性形式（opset<=17）
                        nAx = graph.compilerAttr(i, NodeField.AXES_N());
                        graph.compilerSetI64Tmp(0, graph.compilerAttr(i, NodeField.AXES0()));
                        graph.compilerSetI64Tmp(1, graph.compilerAttr(i, NodeField.AXES1()));
                        graph.compilerSetI64Tmp(2, graph.compilerAttr(i, NodeField.AXES2()));
                        graph.compilerSetI64Tmp(3, graph.compilerAttr(i, NodeField.AXES3()));
                    }
                    int mode = 0;
                    if (nAx > 0) {
                        int c0 = 0, c1 = 0, c2 = 0, c3 = 0;
                        int k = 0;
                        while (k < nAx) {
                            int ax = int(graph.compilerI64Tmp(k));
                            if (ax < 0) ax = ax + rank;   // G3：负轴归一化
                            if (ax == 0) c0 = 1;
                            else if (ax == 1) c1 = 1;
                            else if (ax == 2) c2 = 1;
                            else if (ax == 3) c3 = 1;
                            k = k + 1;
                        }
                        if (c0 == 1 || c1 == 1) mode = 0;          // 含 N/C → 全规约
                        else if (c2 == 1 && c3 == 1) mode = 1;     // 空间维
                        else return 0;                              // 单空间维等 → 暂不支持
                    }
                    graph.compilerSetNRedMode(i, mode);
                    int N = graph.compilerShapeDim(a, 0); int C = graph.compilerShapeDim(a, 1);
                    if (mode == 0) graph.addShapeD4(graph.compilerNodeOutput(i, 0), 1, 1, 1, 1);
                    else graph.addShapeD4(graph.compilerNodeOutput(i, 0), N, C, 1, 1);   // keepdims 0/1 均按 [N,C,1,1]
                } else if (t == "InstanceNormalization") {
                    // F8：per-(n,c) 空间归一化（秩无关；scale/bias 为 [C] 常量）
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int s = graph.compilerShapeIdx(graph.nodeInAt(i, 1)); if (graph.compilerValueExists(graph.nodeInAt(i, 1)) == 0) return 0;
                    int b = graph.compilerShapeIdx(graph.nodeInAt(i, 2)); if (graph.compilerValueExists(graph.nodeInAt(i, 2)) == 0) return 0;
                    graph.copyShape(graph.compilerNodeOutput(i, 0), a);
                } else if (t == "Resize" || t == "Upsample") {
                    // F8：2D/3D 上采样（nearest/linear/trilinear）。输出尺寸：sizes 初始器 > scales 初始器 > Upsample scales 属性
                    int a = graph.compilerShapeIdx(graph.nodeInAt(i, 0)); if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) return 0;
                    int N = graph.compilerShapeDim(a, 0), C = graph.compilerShapeDim(a, 1);
                    int D = graph.compilerShapeDim(a, 2), H = graph.compilerShapeDim(a, 3), W = graph.compilerShapeDim(a, 4);
                    int is5 = graph.compilerShapeR5(a);
                    if (is5 == 0) { D = 1; H = graph.compilerShapeDim(a, 2); W = graph.compilerShapeDim(a, 3); }   // 2D：D=1,H,W=shD2,shD3
                    int outD = D, outH = H, outW = W;
                    if (t == "Upsample") {
                        double sh = graph.attrFloat(i, NodeField.UPSH());   // P3d：统一属性访问
                        double sw = graph.attrFloat(i, NodeField.UPSW());
                        if (sh == 0.0) sh = 1.0;
                        if (sw == 0.0) sw = 1.0;
                        double hd = float(H);
                        double wd = float(W);
                        outH = int(hd * sh);
                        outW = int(wd * sw);
                    } else {
                        if (is5 == 1) {
                            // 3D：sizes [N,C,outD,outH,outW]。foldShapeChains 可能在
                            // 输入秩确定前跑（shapeRank5 误判 0 → 只填 nRszH/nRszW），
                            // 故 is5=1 须 nRszD/H/W 三者齐备才用折叠值；否则回退 readI64Init。
                            if (graph.compilerAttrResizeD(i) > 0 && graph.compilerAttrResizeH(i) > 0 && graph.compilerAttrResizeW(i) > 0) {
                                outD = graph.compilerAttrResizeD(i); outH = graph.compilerAttrResizeH(i); outW = graph.compilerAttrResizeW(i);
                            } else {
                                int szc = graph.compilerReadI64Init(graph.nodeInAt(i, 3), 8);   // sizes [N,C,outD,outH,outW]
                                if (szc >= 5) {
                                    outD = int(graph.compilerI64Tmp(2));
                                    outH = int(graph.compilerI64Tmp(3));
                                    outW = int(graph.compilerI64Tmp(4));
                                } else {
                                    int sc2 = graph.compilerReadF32Init(graph.nodeInAt(i, 2), 8);   // scales [1,1,sd,sh,sw]
                                    if (sc2 >= 3) {
                                        double dd = float(D);
                                        double hd = float(H);
                                        double wd = float(W);
                                        outD = int(dd * graph.compilerF32Tmp(2));
                                        outH = int(hd * graph.compilerF32Tmp(3));
                                        outW = int(wd * graph.compilerF32Tmp(4));
                                    }
                                }
                            }
                        } else {
                            if (graph.compilerAttrResizeH(i) > 0 && graph.compilerAttrResizeW(i) > 0) {
                                outH = graph.compilerAttrResizeH(i); outW = graph.compilerAttrResizeW(i);
                            } else {
                                int szc = graph.compilerReadI64Init(graph.nodeInAt(i, 3), 8);   // sizes [N,C,outH,outW]
                                if (szc >= 4) {
                                    outH = int(graph.compilerI64Tmp(2));
                                    outW = int(graph.compilerI64Tmp(3));
                                } else {
                                    int sc2 = graph.compilerReadF32Init(graph.nodeInAt(i, 2), 8);   // scales [1,1,sh,sw]
                                    if (sc2 >= 3) {
                                        double hd = float(H);
                                        double wd = float(W);
                                        outH = int(hd * graph.compilerF32Tmp(2));
                                        outW = int(wd * graph.compilerF32Tmp(3));
                                    }
                                }
                            }
                        }
                    }
                    if (outD < 1) outD = 1;
                    if (outH < 1) outH = 1;
                    if (outW < 1) outW = 1;
                    if (is5 == 1) graph.addShapeD5(graph.compilerNodeOutput(i, 0), N, C, outD, outH, outW);
                    else graph.addShapeD4(graph.compilerNodeOutput(i, 0), N, C, outH, outW);
                } else {
                    return 0;   // 不支持的算子
                }
                i = i + 1;
            }
            return 1;
        }

int foldConstants(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeTypeAt(i) == "Constant" && graph.compilerAttr(i, NodeField.CONST_VAL()) == 1) {
                    int off = graph.compilerAttr(i, NodeField.CONST_OFF());
                    int len = graph.compilerAttr(i, NodeField.CONST_LEN());
                    int end = off + len;
                    graph.compilerPbSeek(off);
                    int[] dims = new int[8];
                    int dimCount = 0;
                    int dt = 0;
                    int payloadKind = 0;
                    int payloadOff = 0;
                    int payloadLen = 0;
                    while (graph.compilerPbPos() < end) {
                        int f = graph.compilerPbNextTag();
                        if (f == -1) break;
                        if (f == 1) {
                            if (dimCount < 8) { dims[dimCount] = graph.compilerPbReadVarint(); dimCount = dimCount + 1; }
                            else { long v = graph.compilerPbReadVarint64(); }
                        } else if (f == 2) {
                            dt = graph.compilerPbReadVarint();
                        } else if (f == 4 || f == 9) {
                            payloadKind = 1;
                            payloadLen = graph.compilerPbReadLen();
                            payloadOff = graph.compilerPbPayloadOff();
                            graph.compilerPbSkipBytes(payloadLen);
                        } else if (f == 10) {
                            payloadKind = 2;
                            payloadLen = graph.compilerPbReadLen();
                            payloadOff = graph.compilerPbPayloadOff();
                            graph.compilerPbSkipBytes(payloadLen);
                        } else {
                            graph.compilerPbSkipField();
                        }
                    }
                    if (dt == 1 && payloadKind == 1) {   // FLOAT
                        int rows = 1; int cols = 1;
                        if (dimCount == 0) { rows = 1; cols = 1; }
                        else if (dimCount == 1) { rows = dims[0]; cols = 1; }
                        else if (dimCount == 2) { rows = dims[0]; cols = dims[1]; }
                        else {
                            rows = dims[0];
                            cols = 1;
                            int k = 1;
                            while (k < dimCount) { cols = cols * dims[k]; k = k + 1; }
                        }
                        int weight = graph.compilerWeightAdd(graph.compilerNodeOutput(i, 0), rows, cols, dt, payloadKind, payloadOff, payloadLen);
                        graph.compilerWeightSetField(weight, WeightField.ROLE(), 4);      // 通用常量：直接拷贝
                        graph.addShapeD(graph.compilerNodeOutput(i, 0), dims, dimCount);
                        graph.compilerSetShapeKind(graph.compilerNodeOutput(i, 0), Kind.FC_C());
                        graph.compilerSetNodeType(i, "");
                        graph.compilerIncFold();
                    }
                }
                i = i + 1;
            }
            return 1;
        }

int foldShapeChains(Graph graph) {
            // P3：int64 形状链折叠（Shape/Slice/Concat/Cast/Unsqueeze/Gather/ReduceProd）。
            // 可两次调用（inferShapes 前折叠 Resize sizes 链；后折叠剩余链）。幂等。
            // 先播种所有 int64 初始器常量
            int wi = 0;
            while (wi < graph.compilerWeightCount()) {
                if (graph.compilerWeightGetField(wi, WeightField.DTYPE()) == 7) graph.compilerI64RegInit(graph.compilerWeightNameAt(wi), graph.compilerWeightNameAt(wi), 64);
                wi = wi + 1;
            }
            int i = 0;
            while (i < graph.nodeCount()) {
                string t = graph.nodeTypeAt(i);
                if (t == "") { i = i + 1; continue; }
                if (t == "Constant") {
                    if (graph.compilerAttr(i, NodeField.CONST_VAL()) == 1) {
                        graph.compilerI64RegConstant(graph.compilerNodeOutput(i, 0), graph.compilerAttr(i, NodeField.CONST_OFF()), graph.compilerAttr(i, NodeField.CONST_LEN()));
                        if (graph.compilerI64Count(graph.compilerNodeOutput(i, 0)) > 0) { graph.compilerSetNodeType(i, ""); graph.compilerIncFold(); }
                    }
                } else if (t == "Shape") {
                    int s = graph.compilerShapeIdx(graph.nodeInAt(i, 0));
                    if (graph.compilerValueExists(graph.nodeInAt(i, 0)) == 0) { i = i + 1; continue; }
                    long[] v = new long[8];
                    int n = 4;
                    v[0] = long(graph.compilerShapeDim(s, 0)); v[1] = long(graph.compilerShapeDim(s, 1)); v[2] = long(graph.compilerShapeDim(s, 2)); v[3] = long(graph.compilerShapeDim(s, 3));
                    if (graph.compilerShapeR5(s) == 1) { v[4] = long(graph.compilerShapeDim(s, 4)); n = 5; }
                    graph.compilerI64Reg(graph.compilerNodeOutput(i, 0), v, n);
                    graph.compilerSetNodeType(i, "");
                } else if (t == "ReduceProd") {
                    if (graph.compilerI64Count(graph.nodeInAt(i, 0)) > 0) {
                        int c = graph.compilerI64Count(graph.nodeInAt(i, 0));
                        long prod = 1L;
                        int k = 0;
                        while (k < c) { prod = prod * graph.compilerI64Get(graph.nodeInAt(i, 0), k); k = k + 1; }
                        long[] v = new long[1];
                        v[0] = prod;
                        graph.compilerI64Reg(graph.compilerNodeOutput(i, 0), v, 1);
                        graph.compilerSetNodeType(i, "");
                    }
                } else if (t == "Unsqueeze") {
                    if (graph.compilerI64Count(graph.nodeInAt(i, 0)) > 0) {
                        int c = graph.compilerI64Count(graph.nodeInAt(i, 0));
                        long[] v = new long[32];
                        int k = 0;
                        while (k < c) { v[k] = graph.compilerI64Get(graph.nodeInAt(i, 0), k); k = k + 1; }
                        graph.compilerI64Reg(graph.compilerNodeOutput(i, 0), v, c);   // reshape：值不变
                        graph.compilerSetNodeType(i, "");
                    }
                } else if (t == "Gather") {
                    if (graph.compilerI64Count(graph.nodeInAt(i, 0)) > 0 && graph.compilerI64Count(graph.nodeInAt(i, 1)) > 0) {
                        int dataN = graph.compilerI64Count(graph.nodeInAt(i, 0));
                        int idxN = graph.compilerI64Count(graph.nodeInAt(i, 1));
                        long[] v = new long[32];
                        int k = 0;
                        while (k < idxN && k < 32) {
                            long ix = graph.compilerI64Get(graph.nodeInAt(i, 1), k);
                            int ii = int(ix);
                            if (ii < 0) ii = ii + dataN;
                            if (ii >= 0 && ii < dataN) v[k] = graph.compilerI64Get(graph.nodeInAt(i, 0), ii);
                            else v[k] = 0L;
                            k = k + 1;
                        }
                        graph.compilerI64Reg(graph.compilerNodeOutput(i, 0), v, idxN);
                        graph.compilerSetNodeType(i, "");
                    }
                } else if (t == "Slice") {
                    // 仅折叠 int64 数据链（float 数据 Slice 是运行时算子，不动）
                    if (graph.compilerI64Count(graph.nodeInAt(i, 0)) > 0) {
                        int dataN = graph.compilerI64Count(graph.nodeInAt(i, 0));
                        long[] st = new long[8]; int stc = graph.compilerI64Count(graph.nodeInAt(i, 1));
                        int k = 0; while (k < stc && k < 8) { st[k] = graph.compilerI64Get(graph.nodeInAt(i, 1), k); k = k + 1; }
                        if (stc <= 0) { stc = graph.compilerReadI64Init(graph.nodeInAt(i, 1), 8); k = 0; while (k < stc && k < 8) { st[k] = graph.compilerI64Tmp(k); k = k + 1; } }
                        long[] en = new long[8]; int enc = graph.compilerI64Count(graph.nodeInAt(i, 2));
                        k = 0; while (k < enc && k < 8) { en[k] = graph.compilerI64Get(graph.nodeInAt(i, 2), k); k = k + 1; }
                        if (enc <= 0) { enc = graph.compilerReadI64Init(graph.nodeInAt(i, 2), 8); k = 0; while (k < enc && k < 8) { en[k] = graph.compilerI64Tmp(k); k = k + 1; } }
                        long[] ax = new long[8]; int axc = graph.compilerI64Count(graph.nodeInAt(i, 3));
                        k = 0; while (k < axc && k < 8) { ax[k] = graph.compilerI64Get(graph.nodeInAt(i, 3), k); k = k + 1; }
                        if (axc <= 0) { axc = graph.compilerReadI64Init(graph.nodeInAt(i, 3), 8); k = 0; while (k < axc && k < 8) { ax[k] = graph.compilerI64Tmp(k); k = k + 1; } }
                        long[] sp = new long[8]; int spc = graph.compilerI64Count(graph.nodeInAt(i, 4));
                        k = 0; while (k < spc && k < 8) { sp[k] = graph.compilerI64Get(graph.nodeInAt(i, 4), k); k = k + 1; }
                        if (spc <= 0) { spc = graph.compilerReadI64Init(graph.nodeInAt(i, 4), 8); k = 0; while (k < spc && k < 8) { sp[k] = graph.compilerI64Tmp(k); k = k + 1; } }
                        int cnt = stc; if (cnt > 4) cnt = 4;
                        long[] v = new long[32];
                        int outc = 0;
                        int j = 0;
                        while (j < cnt) {
                            int a = 0;
                            if (axc > 0) a = int(ax[j]); else a = j;
                            int step = 1;
                            if (spc > 0) step = int(sp[j]);
                            if (step == 0) step = 1;
                            int D = dataN;
                            long stL = st[j]; long enL = en[j];
                            if (stL == 9223372036854775807L) stL = long(D);
                            if (stL < 0L) stL = stL + long(D);
                            if (enL == 9223372036854775807L) enL = long(D);
                            if (enL < 0L) enL = enL + long(D);
                            if (stL < 0L) stL = 0L;
                            if (stL > long(D)) stL = long(D);
                            if (enL < 0L) enL = 0L;
                            if (enL > long(D)) enL = long(D);
                            int sti = int(stL);
                            int eni = int(enL);
                            if (step > 0) {
                                int q = sti;
                                while (q < eni && outc < 32) { v[outc] = graph.compilerI64Get(graph.nodeInAt(i, 0), q); outc = outc + 1; q = q + step; }
                            } else {
                                int q = sti;
                                while (q > eni && outc < 32) { v[outc] = graph.compilerI64Get(graph.nodeInAt(i, 0), q); outc = outc + 1; q = q + step; }
                            }
                            j = j + 1;
                        }
                        graph.compilerI64Reg(graph.compilerNodeOutput(i, 0), v, outc);
                        graph.compilerSetNodeType(i, "");
                    }
                } else if (t == "Concat") {
                    // 仅折叠 int64 链（float Concat 是运行时算子）
                    if (graph.compilerI64Count(graph.nodeInAt(i, 0)) > 0 || graph.compilerI64Count(graph.nodeInAt(i, 1)) > 0) {
                        // 部分折叠保护：若任一输入是「尚未折叠的 shape 链节点」
                        // （其 int64 值后续才可知），本次不折叠，留给 inferShapes
                        // 推进后的内部 foldShapeChains（避免丢掉前缀/后缀）。
                        int wait = 0;
                        int wslot = 0;
                        while (wslot < 3) {
                            string wnm;
                            if (wslot == 0) wnm = graph.nodeInAt(i, 0);
                            else if (wslot == 1) wnm = graph.nodeInAt(i, 1);
                            else wnm = graph.nodeInAt(i, 2);
                            if (wnm == "") { wslot = 3; break; }
                            if (graph.compilerI64ChainAlive(wnm) == 1) { wait = 1; wslot = 3; break; }
                            wslot = wslot + 1;
                        }
                        if (wait == 0) {
                            long[] v = new long[64];
                            int outc = 0;
                            int slot = 0;
                            while (slot < 3) {
                                string nm;
                                if (slot == 0) nm = graph.nodeInAt(i, 0);
                                else if (slot == 1) nm = graph.nodeInAt(i, 1);
                                else nm = graph.nodeInAt(i, 2);
                                if (nm == "") { slot = 3; break; }
                                if (graph.compilerI64Count(nm) > 0) {
                                    int c = graph.compilerI64Count(nm);
                                    int k = 0;
                                    while (k < c && outc < 64) { v[outc] = graph.compilerI64Get(nm, k); outc = outc + 1; k = k + 1; }
                                }
                                slot = slot + 1;
                            }
                            if (outc > 0) { graph.compilerI64Reg(graph.compilerNodeOutput(i, 0), v, outc); graph.compilerSetNodeType(i, ""); }
                        }
                    }
                } else if (t == "Cast") {
                    int to = graph.compilerAttr(i, NodeField.CAST_TO());
                    if (to == 7 && graph.compilerI64Count(graph.nodeInAt(i, 0)) > 0) {
                        // int64 恒等（float 常量 Cast 折叠由第二次调用处理）
                        int c = graph.compilerI64Count(graph.nodeInAt(i, 0));
                        long[] v = new long[32];
                        int k = 0;
                        while (k < c) { v[k] = graph.compilerI64Get(graph.nodeInAt(i, 0), k); k = k + 1; }
                        graph.compilerI64Reg(graph.compilerNodeOutput(i, 0), v, c);
                        graph.compilerSetNodeType(i, "");
                    } else if (to == 1 && graph.compilerI64Count(graph.nodeInAt(i, 0)) > 0) {
                        // int64→float：注册为运行时 float 常量
                        int c = graph.compilerI64Count(graph.nodeInAt(i, 0));
                        int src = graph.compilerI64Find(graph.nodeInAt(i, 0));
                        long[] v = new long[32];
                        int k = 0;
                        while (k < c && k < 32) { v[k] = graph.compilerI64Get(graph.nodeInAt(i, 0), k); k = k + 1; }
                        graph.compilerRegComputedF32(graph.compilerNodeOutput(i, 0), v, c);
                        graph.compilerSetNodeType(i, "");
                        graph.compilerIncFold();
                    }
                } else if (t == "Resize" || t == "Upsample") {
                    // 记录折叠出的 sizes（优先于初始器）。用 sizes 元素个数判断 3D/2D
                    // （3D=[N,C,outD,outH,outW] 5 个；2D=[N,C,outH,outW] 4 个）——
                    // 不依赖 shapeRank5（fold 阶段输入秩可能未定）。
                    int c5 = graph.compilerI64Count(graph.nodeInAt(i, 3));
                    if (c5 >= 5) {
                        graph.compilerAttrSetResizeD(i, int(graph.compilerI64Get(graph.nodeInAt(i, 3), 2)));
                        graph.compilerAttrSetResizeH(i, int(graph.compilerI64Get(graph.nodeInAt(i, 3), 3)));
                        graph.compilerAttrSetResizeW(i, int(graph.compilerI64Get(graph.nodeInAt(i, 3), 4)));
                        // sizes 链已折叠（其生产者被 erase、shape 未登记）→ 清空
                        // 悬空输入槽，避免 verifyIR 报 val<0（buildRuntime 不读 nIn3_）。
                        graph.compilerSetNodeInput(i, 3, "");
                    } else if (c5 >= 4) {
                        graph.compilerAttrSetResizeH(i, int(graph.compilerI64Get(graph.nodeInAt(i, 3), 2)));
                        graph.compilerAttrSetResizeW(i, int(graph.compilerI64Get(graph.nodeInAt(i, 3), 3)));
                        graph.compilerSetNodeInput(i, 3, "");
                    }
                }
                i = i + 1;
            }
            return 1;
        }

                int runPipeline(IGraphOptimizeHost host) {
            if (Console.getEnv("MYP_NO_REUSE") == "1") host.enableNoReuseForOptimizer();
            host.runIRPass(IRPassKind.FOLD_SHAPES());  // P3：先折叠输入形状已知的 Resize sizes 链
            host.runIRPass(IRPassKind.FOLD_CONSTS());
            if (host.runIRPass(IRPassKind.INFER_SHAPES()) == 0) { Console.writeLine("DBG fail inferShapes"); return 0; }
            host.runIRPass(IRPassKind.FOLD_SHAPES());  // P3：inferShapes 后折叠剩余链（Shape(中间)→…→Cast）
            host.runIRPass(IRPassKind.CLASSIFY());
            host.runIRPass(IRPassKind.FUSE_BN());
            host.runIRPass(IRPassKind.FUSE_CONV_RELU());
            host.runIRPass(IRPassKind.FUSE_RELU());
            host.runIRPass(IRPassKind.FUSE_GAP_FLATTEN());
            if (host.runIRPassToFixpoint(IRPassKind.IDENTITY_FOLD(), 4) == 0) { Console.writeLine("DBG fail identityFold"); return 0; }
            if (host.runIRPassToFixpoint(IRPassKind.FOLD_RELU(), 4) == 0) { Console.writeLine("DBG fail foldRelu"); return 0; }
            // P4-2/3：Conv+残差Add 融合（仅推理；convResidual 无 backward，训练图不融合）
            if (host.shouldFuseConvAddForOptimizer() == 1) host.runIRPass(IRPassKind.FUSE_CONV_ADD());
            host.runIRPass(IRPassKind.DCE());
            if (host.shouldRunNHWCForOptimizer() == 1) { if (host.runIRPass(IRPassKind.LAYOUT_NHWC()) == 0) { Console.writeLine("DBG fail layoutNHWC"); return 0; } }
            if (host.runTopoSort() == 0) { Console.writeLine("DBG fail topoSort"); return 0; }
            return 1;
        }

        int optimize(IGraphOptimizeHost host, InferenceRuntime rt) {
            host.setTrainingModeForOptimizer(0);
            if (runPipeline(host) == 0) return 0;
            int peak = host.runPlanMemory();
            if (peak <= 0) { Console.writeLine("DBG fail planMemory"); return 0; }
            rt.resizeArena(peak);
            if (host.lowerRuntime(rt) == 0) { Console.writeLine("DBG fail buildRuntime"); return 0; }
            if (Console.getEnv("MYP_RSZ_DBG") == "1") host.dumpResizeSizesForOptimizer();
            return 1;
        }

        // 训练版管线：公共 pass → buildReverseGraph（追加反向/更新节点）→ 重排/重规划 → 构建。
        int optimizeTrain(IGraphOptimizeHost host, InferenceRuntime rt) {
            host.setTrainingModeForOptimizer(1);   // P4-3：训练图不跑 FUSE_CONV_ADD（convResidual 无 backward）
            if (runPipeline(host) == 0) return 0;
            if (host.buildReverseGraphForOptimizer() == 0) { Console.writeLine("DBG fail buildReverseGraph"); return 0; }
            if (host.runTopoSort() == 0) { Console.writeLine("DBG fail topoSort(reverse)"); return 0; }
            int peak = host.runPlanMemory();
            if (peak <= 0) { Console.writeLine("DBG fail planMemory"); return 0; }
            rt.resizeArena(peak);
            if (host.lowerRuntime(rt) == 0) { Console.writeLine("DBG fail buildRuntime"); return 0; }
            return 1;
        }
}