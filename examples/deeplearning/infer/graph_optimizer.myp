// graph_optimizer.myp — Graph pass-pipeline orchestration.
import env;
import fmt;
import "./runtime.myp";
import "./graph_defs.myp";
import "./graph.myp";

interface IGraphOptimizeHost {
    int runIRPass(int pass);
    int runIRPassToFixpoint(int pass, int maxIter);
    int runTopoSort();
    int runPlanMemory();
    int lowerRuntime(InferenceRuntime rt);
    int buildReverseGraphForOptimizer();
    void setTrainingModeForOptimizer(int mode);
    void enableNoReuseForOptimizer();
    int shouldFuseConvAddForOptimizer();
    int shouldRunNHWCForOptimizer();
    void dumpResizeSizesForOptimizer();
}

class GraphOptimizer {
    action:
        // 具体 pass（从 Graph 迁移的试点：DCE）。Graph 通过 runIRPass 委托，
        // 用公共 compiler* 访问器跨类查询/改写，避免在 Graph 保留重复算法。
        int eliminateDeadNodes(Graph graph) {
            int changed = 1;
            while (changed == 1) {
                changed = 0;
                graph.ensureDefUseForOptimizer();
                int i = 0;
                while (i < graph.nodeCount()) {
                    if (graph.nodeTypeAt(i) == "") { i = i + 1; continue; }
                    string eff = graph.compilerEffectiveOut(i);
                    if (eff == "") { i = i + 1; continue; }
                    if (graph.compilerIsGraphOutput(eff) == 1) { i = i + 1; continue; }
                    // P3a：stateful/trainOnly 节点（Update/GradAcc/Bwd* 等）受 traits 保护，
                    // 不得按 use 数删除（Update 就地改权重、GradAcc 累加梯度）。
                    if (OpCode.opTraits(graph.nodeOp(i)) != 0) { i = i + 1; continue; }
                    if (graph.compilerValueUseCount(graph.compilerShapeIdx(eff)) == 0) {
                        graph.compilerEraseNode(i);   // tombstone + 标死有效输出 + 失效 DefUse
                        graph.compilerIncDce();
                        changed = 1;
                    }
                    i = i + 1;
                }
            }
            return 1;
        }

        // GAP+Flatten 融合：GlobalAveragePool → Flatten 折叠为一个 GAP 直写 flatten 输出。
        int fuseGapFlatten(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeOp(i) != OpCode.GLOBAL_AVG_POOL()) { i = i + 1; continue; }
                if (graph.compilerIsGraphOutput(graph.compilerNodeOutput(i, 0)) == 1) { i = i + 1; continue; }
                int s = graph.compilerShapeIdx(graph.compilerNodeOutput(i, 0));
                if (s >= 0 && graph.compilerShapeDim(s, 0) != 1) { i = i + 1; continue; }   // batch!=1 跳过
                int j = graph.matchSingleUseOp(graph.valueId(graph.compilerNodeOutput(i, 0)), "Flatten", 0);
                if (j < 0) { i = i + 1; continue; }
                graph.fuseSingleUseOutput(i, j, 0);
                graph.compilerIncGap();
                i = i + 1;
            }
            return 1;
        }

        // x op identity（x+0 / x*1 / x-0 / x/1）折叠。Add/Mul 可交换，id op x 也合法。
        int foldIdentityOps(Graph graph) {
            int changed = 0;
            int node = 0;
            while (node < graph.nodeCount()) {
                int code = graph.nodeOp(node);
                int commutable = 0;
                if (code == OpCode.ADD() || code == OpCode.MUL()) commutable = 1;
                else if (code != OpCode.SUB() && code != OpCode.DIV()) { node = node + 1; continue; }
                string output = graph.compilerEffectiveOut(node);
                if (output == "") { node = node + 1; continue; }
                double identity = (code == OpCode.ADD() || code == OpCode.SUB()) ? 0.0 : 1.0;
                int in0 = graph.nodeInputValue(node, 0);
                int in1 = graph.nodeInputValue(node, 1);
                int keep = -1;
                // x op id（四种全适用）；Add/Mul 可交换，id op x 也合法
                if (graph.isConstValue(graph.nodeInAt(node, 1), identity) == 1) keep = in0;
                else if (commutable == 1 && graph.isConstValue(graph.nodeInAt(node, 0), identity) == 1) keep = in1;
                int out = graph.nodeOutputValue(node, 0);
                if (keep >= 0 && out >= 0) {
                    graph.replaceAllUses(out, keep);
                    graph.compilerEraseNode(node);   // P3c：canonical 删除原语
                    changed = 1;
                }
                node = node + 1;
            }
            return changed;
        }

        // P2e：连续激活合并 Relu(Relu(x)) → Relu(x)。内层 producer 可以是独立 Relu 节点，
        // 或已融合（nFused_+nRelu_，如 ConvRelu）的 producer——其有效输出已过 ReLU，外层
        // Relu 冗余。外层输出改接内层有效输出（replaceAllUses 覆盖图输出 rename），tombstone 外层。
        int foldDoubleRelu(Graph graph) {
            int changed = 0;
            int node = 0;
            while (node < graph.nodeCount()) {
                if (graph.nodeOp(node) != OpCode.RELU()) { node = node + 1; continue; }
                string outName = graph.compilerEffectiveOut(node);
                if (outName == "") { node = node + 1; continue; }
                int in = graph.nodeInputValue(node, 0);
                int prod = graph.valueProducer(in);
                int alreadyRelu = 0;
                if (prod >= 0) {
                    if (graph.nodeOp(prod) == OpCode.RELU()) alreadyRelu = 1;
                    else if (graph.compilerAttrFused(prod) == 1 && graph.compilerAttrRelu(prod) == 1) alreadyRelu = 1;
                }
                if (alreadyRelu == 0) { node = node + 1; continue; }
                int out = graph.nodeOutputValue(node, 0);
                int innerOut = graph.nodeOutputValue(prod, 0);
                if (out >= 0 && innerOut >= 0) {
                    graph.replaceAllUses(out, innerOut);
                    graph.compilerEraseNode(node);   // P3c：canonical 删除原语
                    changed = 1;
                }
                node = node + 1;
            }
            return changed;
        }

        // Conv→Relu 融合（doRelu 后置单内核）。
        int fuseConvRelu(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeOp(i) != OpCode.CONV()) { i = i + 1; continue; }
                string eff = graph.compilerEffectiveOut(i);
                if (graph.compilerIsGraphOutput(eff) == 1) { i = i + 1; continue; }   // 中间张量不能是图输出
                int j = graph.matchSingleUseOp(graph.valueId(eff), "Relu", 0);
                if (j < 0) { i = i + 1; continue; }
                graph.fuseReluIntoProducer(i, j);
                i = i + 1;
            }
            return 1;
        }

        // G6：InstanceNormalization→Relu 融合（IN 输出直接过 ReLU，省一次 arena 往返）。
        int fuseReluOp(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeOp(i) != OpCode.INSTANCE_NORM()) { i = i + 1; continue; }
                string eff = graph.compilerEffectiveOut(i);
                if (graph.compilerIsGraphOutput(eff) == 1) { i = i + 1; continue; }
                int j = graph.matchSingleUseOp(graph.valueId(eff), "Relu", 0);
                if (j < 0) { i = i + 1; continue; }
                graph.fuseReluIntoProducer(i, j);
                i = i + 1;
            }
            return 1;
        }

        // P4-2/3：Conv+残差Add 融合。Conv（或 BN 折叠后）输出的唯一 Use = Add 的 slot0
        // （残差为 slot1）→ 卷积内核直接加残差写入 Add 输出，省掉 conv 中间张量 arena 往返。
        // Add 输出若唯一消费是 Relu → 一并折叠（conv+residual+relu 单内核，doRelu 后置）。
        int fuseConvAdd(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeOp(i) != OpCode.CONV()) { i = i + 1; continue; }
                if (graph.compilerAttrRelu(i) == 1) { i = i + 1; continue; }
                string eff = graph.compilerEffectiveOut(i);
                if (eff == "" || graph.compilerIsGraphOutput(eff) == 1) { i = i + 1; continue; }
                int j = graph.matchSingleUseOp(graph.valueId(eff), "Add", 0);
                if (j < 0) { i = i + 1; continue; }
                string resid = graph.nodeInAt(j, 1);
                if (resid == "" || graph.compilerIsGraphOutput(resid) == 1 || graph.compilerShapeIdx(resid) < 0) { i = i + 1; continue; }
                string addOut = graph.compilerNodeOutput(j, 0);
                graph.compilerAttrSetFused(i, 1);
                graph.compilerAttrSetFusedOut(i, addOut);
                graph.compilerSetNodeInput(i, 3, resid);
                graph.compilerSetNodeType(j, "");
                graph.compilerMarkDeadTensor(eff);
                // P4-3：Add 输出唯一消费是 Relu → 折叠（doRelu 后置：conv+residual 再过 relu）
                int r = graph.matchSingleUseOp(graph.valueId(addOut), "Relu", 0);
                if (r >= 0) {
                    graph.compilerAttrSetRelu(i, 1);
                    graph.compilerAttrSetFusedOut(i, graph.compilerNodeOutput(r, 0));
                    graph.compilerSetNodeType(r, "");
                    graph.compilerMarkDeadTensor(addOut);
                }
                graph.compilerIncFusedAdd();
                i = i + 1;
            }
            return 1;
        }

        // 拓扑排序（Kahn，精确 (user,slot) use edge 递减入度）。写 analysis 的 planOrder。
        int topoSort(Graph graph) {
            int[] indeg = new int[512];
            // P0：所有既有 mutation pass 已完成，此处统一重建 def-use，再消费 O(1) producer 索引。
            graph.compilerRebuildDefUse();
            if (Console.getEnv("MYP_IR_VERIFY") == "1" && graph.compilerVerifyIR() == 0) {
                Console.writeLine("DBG fail verifyIR");
                return 0;
            }
            int i = 0;
            while (i < graph.nodeCount()) {
                indeg[i] = 0;
                if (graph.nodeTypeAt(i) == "") { i = i + 1; continue; }
                if (graph.valueProducer(graph.nodeInputValue(i, 0)) >= 0) indeg[i] = indeg[i] + 1;
                if (graph.valueProducer(graph.nodeInputValue(i, 1)) >= 0) indeg[i] = indeg[i] + 1;
                if (graph.valueProducer(graph.nodeInputValue(i, 2)) >= 0) indeg[i] = indeg[i] + 1;
                if (graph.valueProducer(graph.nodeInputValue(i, 3)) >= 0) indeg[i] = indeg[i] + 1;
                i = i + 1;
            }
            graph.compilerAnalysisSetPlanOrderCount(0);
            int remaining = 0;
            i = 0;
            while (i < graph.nodeCount()) { if (graph.nodeTypeAt(i) != "") remaining = remaining + 1; i = i + 1; }
            while (graph.compilerAnalysisPlanOrderCount() < remaining) {
                int picked = -1;
                i = 0;
                while (i < graph.nodeCount()) {
                    if (graph.nodeTypeAt(i) != "" && indeg[i] == 0) { picked = i; i = graph.nodeCount(); }
                    i = i + 1;
                }
                if (picked < 0) {
                    if (Console.getEnv("MYP_GR_DBG") == "1") {
                        Console.writeString("topoSort stuck remaining=" + Fmt.i(remaining) + " indeg[0..]:");
                        Console.writeLine("");
                        int d = 0;
                        while (d < graph.nodeCount()) {
                            if (graph.nodeTypeAt(d) != "" && indeg[d] > 0) {
                                Console.writeString("  n" + Fmt.i(d) + " type=" + graph.nodeTypeAt(d) + " indeg=" + Fmt.i(indeg[d]) + " in0=" + graph.nodeInAt(d, 0) + " in1=" + graph.nodeInAt(d, 1) + " in2=" + graph.nodeInAt(d, 2));
                                Console.writeLine("");
                            }
                            d = d + 1;
                        }
                    }
                    return 0;   // 有环
                }
                graph.compilerAnalysisSetPlanOrder(graph.compilerAnalysisPlanOrderCount(), picked);
                graph.compilerAnalysisSetPlanOrderCount(graph.compilerAnalysisPlanOrderCount() + 1);
                indeg[picked] = -1;
                // 多输出（Split/BwdDense/SoftmaxCE）：递减所有输出（out0..out3）的消费者
                string out = graph.compilerEffectiveOut(picked);
                string o1 = graph.compilerNodeOutput(picked, 1);
                string o2 = graph.compilerNodeOutput(picked, 2);
                string o3 = graph.compilerNodeOutput(picked, 3);
                // P0：按精确 (user,slot) use edge 递减，重复 operand（Mul(x,x)）自然处理。
                int[] produced = new int[4];
                produced[0] = graph.valueId(out); produced[1] = graph.valueId(o1); produced[2] = graph.valueId(o2); produced[3] = graph.valueId(o3);
                int ps = 0;
                while (ps < 4) {
                    int pv = produced[ps];
                    if (pv >= 0) {
                        int use = 0;
                        while (use < graph.valueUseCount(pv)) {
                            int user = graph.valueUseNode(pv, use);
                            if (user >= 0 && indeg[user] >= 0) indeg[user] = indeg[user] - 1;
                            use = use + 1;
                        }
                    }
                    ps = ps + 1;
                }
            }
            graph.compilerAnalysisSetValidOr(IRAnalysis.TOPO());
            graph.compilerAnalysisSetTopoGeneration(graph.compilerAnalysisGeneration());
            return 1;
        }

        // first-fit 内存规划（写 planner 区域）。返回峰值内存（张量元素数）。
        int planMemory(Graph graph) {
            int si = 0;
            while (si < graph.compilerShapeCount()) { graph.compilerSetPlanProducer(si, -1); graph.compilerSetPlanLastUse(si, -1); graph.compilerSetPlanOff(si, 0); si = si + 1; }
            // producer = 产出该张量的节点在拓扑序中的位置（融合节点以 effectiveOut 计）
            int oi = 0;
            while (oi < graph.compilerAnalysisPlanOrderCount()) {
                int ni = graph.compilerAnalysisPlanOrder(oi);
                int s = graph.compilerShapeIdx(graph.compilerEffectiveOut(ni));
                if (s >= 0) graph.compilerSetPlanProducer(s, oi);
                oi = oi + 1;
            }
            // lastUse = 消费该张量的最大拓扑位置（活节点）
            oi = 0;
            while (oi < graph.compilerAnalysisPlanOrderCount()) {
                int ni = graph.compilerAnalysisPlanOrder(oi);
                int a = graph.compilerShapeIdx(graph.nodeInAt(ni, 0)); if (a >= 0 && oi > graph.compilerPlanLastUse(a)) graph.compilerSetPlanLastUse(a, oi);
                int b = graph.compilerShapeIdx(graph.nodeInAt(ni, 1)); if (b >= 0 && oi > graph.compilerPlanLastUse(b)) graph.compilerSetPlanLastUse(b, oi);
                int c = graph.compilerShapeIdx(graph.nodeInAt(ni, 2)); if (c >= 0 && oi > graph.compilerPlanLastUse(c)) graph.compilerSetPlanLastUse(c, oi);
                // P4-2：残差融合把 Add 的 slot1 登记进 Conv 的 nIn3_——liveness 须覆盖 nIn3_/nIn4_
                int d = graph.compilerShapeIdx(graph.nodeInAt(ni, 3)); if (d >= 0 && oi > graph.compilerPlanLastUse(d)) graph.compilerSetPlanLastUse(d, oi);
                int e = graph.compilerShapeIdx(graph.nodeInAt(ni, 4)); if (e >= 0 && oi > graph.compilerPlanLastUse(e)) graph.compilerSetPlanLastUse(e, oi);
                oi = oi + 1;
            }
            // first-fit 分配（按形状表顺序 = 拓扑序）
            // persistent：权重 / 图输入 / 图输出（多 pass 需全程存活，区域不可复用）
            int rc = 0;
            int highWater = 0;
            si = 0;
            while (si < graph.compilerShapeCount()) {
                if (graph.compilerShapeDead(si) == 1) { graph.compilerSetPlanOff(si, 0); si = si + 1; continue; }   // G2：死张量不分配
                int size = graph.compilerShapeDim(si, 0) * graph.compilerShapeDim(si, 1) * graph.compilerShapeDim(si, 2) * graph.compilerShapeDim(si, 3);
                if (graph.compilerShapeR5(si) == 1) size = size * graph.compilerShapeDim(si, 4);   // 3D：5D 张量乘 D 维
                int producer = graph.compilerPlanProducer(si);
                int lastUse = graph.compilerPlanLastUse(si);
                int persist = 0;
                if (producer < 0) persist = 1;            // 权重 / 图输入
                if (lastUse < 0) { persist = 1; lastUse = graph.nodeCount() - 1; }  // 图输出
                if (graph.compilerIsGraphOutput(graph.compilerShapeName(si)) == 1) persist = 1;   // 图输出：run 后用户仍读，缓冲不可复用
                if (graph.compilerNoReuse() == 1) persist = 1;            // 调试：不复用
                int best = -1;
                if (persist == 0) {
                    int r = 0;
                    while (r < rc) {
                        if (graph.compilerPlanRPersist(r) == 0 && graph.compilerPlanRLu(r) < producer && graph.compilerPlanRSize(r) >= size) { best = r; r = rc; }
                        r = r + 1;
                    }
                }
                int off = 0;
                if (best >= 0) {
                    off = graph.compilerPlanROff(best);
                    graph.compilerSetPlanRSize(best, size);
                    graph.compilerSetPlanRLu(best, lastUse);
                } else {
                    off = highWater;
                    highWater = highWater + size;
                    graph.compilerSetPlanROff(rc, off);
                    graph.compilerSetPlanRSize(rc, size);
                    graph.compilerSetPlanRLu(rc, lastUse);
                    graph.compilerSetPlanRPersist(rc, persist);
                    rc = rc + 1;
                }
                graph.compilerSetPlanOff(si, off);
                si = si + 1;
            }
            graph.compilerSetLivenessOr(IRAnalysis.LIVENESS());
            graph.compilerSetLivenessGeneration(graph.compilerAnalysisGeneration());
            return highWater;
        }

        // Phase A：按拓扑序标记节点布局（nNHWC_）
        int layoutNHWC(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                graph.compilerAttrSetNhwc(i, 0);
                string t = graph.nodeTypeAt(i);
                if (t == "Conv") graph.compilerAttrSetNhwc(i, 1);                       // 卷积主干始终 NHWC
                else if (t == "MaxPool" || t == "AveragePool" || t == "Pad" || t == "Add" || t == "Relu" || t == "BatchNormalization") {
                    int p0 = producerNHWC(graph, graph.nodeInAt(i, 0));
                    int p1 = producerNHWC(graph, graph.nodeInAt(i, 1));
                    if (p0 == 1 || p1 == 1) graph.compilerAttrSetNhwc(i, 1);
                } else if (t == "GlobalAveragePool") {
                    graph.compilerAttrSetNhwc(i, producerNHWC(graph, graph.nodeInAt(i, 0)));               // 输入侧 NHWC，输出为 NCHW 边界
                }
                i = i + 1;
            }
            // Phase A.5：NHWC 节点的输出张量登记为 NHWC（GAP 输出是边界，除外）
            i = 0;
            while (i < graph.nodeCount()) {
                if (graph.compilerAttrNhwc(i) == 1 && graph.nodeTypeAt(i) != "GlobalAveragePool") {
                    graph.compilerShapeSetNhwc(graph.compilerEffectiveOut(i));
                }
                i = i + 1;
            }
            // Phase B：确保 NHWC 节点的激活输入都在 NHWC（必要时插入转置节点）
            i = 0;
            while (i < graph.nodeCount()) {
                string t = graph.nodeTypeAt(i);
                if (graph.compilerAttrNhwc(i) == 1 && (t == "Conv" || t == "MaxPool" || t == "AveragePool" || t == "Pad" || t == "Add" || t == "Relu" || t == "GlobalAveragePool" || t == "BatchNormalization")) {
                    ensureNHWCInput(graph, i, 0);
                    if (t == "Conv") markWeightNHWC(graph, graph.nodeInAt(i, 1));
                    if (t == "Add") ensureNHWCInput(graph, i, 1);
                }
                i = i + 1;
            }
            return 1;
        }

        int producerNHWC(Graph graph, string name) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeTypeAt(i) == "") { i = i + 1; continue; }
                string eff = graph.compilerNodeOutput(i, 0);
                if (graph.compilerAttrFused(i) == 1) eff = graph.compilerAttrFusedOut(i);
                if (eff == name) return graph.compilerAttrNhwc(i);
                i = i + 1;
            }
            return 0;
        }
        void ensureNHWCInput(Graph graph, int nodeIdx, int slot) {
            string nm;
            if (slot == 0) nm = graph.nodeInAt(nodeIdx, 0);
            else nm = graph.nodeInAt(nodeIdx, 1);
            if (nm == "") return;
            if (producerNHWC(graph, nm) == 1) return;    // 已是 NHWC
            if (graph.compilerInitIdx(nm) >= 0) return;         // 初始器（权重单独处理）
            string tname = nm + "#nhwc";
            if (graph.compilerShapeIdx(tname) < 0) {
                int s = graph.compilerShapeIdx(nm);
                if (s < 0) return;
                int N = graph.compilerShapeDim(s, 0); int H = graph.compilerShapeDim(s, 1); int W = graph.compilerShapeDim(s, 2); int C = graph.compilerShapeDim(s, 3);
                graph.compilerAddShapeD4(tname, N, H, W, C);              // [N,H,W,C] 形状
                graph.compilerSetShapeKind(tname, Kind.CNN_ACT());
                graph.compilerShapeSetNhwc(tname);
                // 追加 NCHW2NHWC 转置节点
                graph.compilerSetNodeType(graph.nodeCount(), "NCHW2NHWC");
                graph.compilerSetNodeInput(graph.nodeCount(), 0, nm);
                graph.compilerNodeSetOutput(graph.nodeCount(), 0, tname);
                graph.compilerAttrSet(graph.nodeCount(), NodeField.CONST_VAL(), 0);
                graph.compilerAttrSetNhwc(graph.nodeCount(), 1);
                graph.compilerAttrSetFused(graph.nodeCount(), 0);
                graph.compilerAttrSetFusedBy(graph.nodeCount(), -1);
                graph.compilerAttrSetFusedOut(graph.nodeCount(), "");
                graph.compilerNodeEnd();
            }
            if (slot == 0) graph.compilerSetNodeInput(nodeIdx, 0, tname);
            else graph.compilerSetNodeInput(nodeIdx, 1, tname);
        }
        void markWeightNHWC(Graph graph, string name) {
            int wi = graph.compilerInitIdx(name);
            if (wi >= 0) {
                graph.compilerWeightSetField(wi, WeightField.NHWC(), 1);
                graph.compilerShapeSetNhwc(name);
            }
        }

        int shapeKindOf(Graph graph, string name) { return graph.compilerShapeKind(graph.compilerShapeIdx(name)); }

        // F8：把 4D 通用常量（非 Conv 权重/偏置）标记为 CNN 激活（buildRuntime 4D 登记）
        // 并设 wRole_=4（写权重时直接拷贝，不做 FC 转置）
        void markGeneric4DConst(Graph graph, string name) {
            int wi = graph.compilerInitIdx(name);
            if (wi < 0) return;
            if (graph.compilerWeightGetField(wi, WeightField.ROLE()) == 2 || graph.compilerWeightGetField(wi, WeightField.ROLE()) == 3) return;   // Conv 权重/偏置不覆盖
            int s = graph.compilerShapeIdx(name);
            if (s < 0) return;
            if (graph.compilerShapeDim(s, 2) <= 1 && graph.compilerShapeDim(s, 3) <= 1) return;       // 非 4D 不处理
            graph.compilerWeightSetField(wi, WeightField.ROLE(), 4);
            graph.compilerWeightSetField(wi, WeightField.TRANSPOSED(), 0);
            graph.compilerSetShapeKind(name, Kind.CNN_ACT());
        }
        // F8：int64 参数初始器（Reshape shape / Slice starts 等）标死——
        // 不登记为 f32 运行时张量（readI64Init 直接从 file_ 读，不依赖 runtime 张量）。
        void markInt64Param(Graph graph, string name) {
            int wi = graph.compilerInitIdx(name);
            if (wi < 0) return;
            if (graph.compilerWeightGetField(wi, WeightField.DTYPE()) != 7) return;   // 仅 int64 参数
            graph.compilerMarkDeadTensor(name);
        }
        // F8：任意参数初始器标死（Resize scales/sizes 等，读自 file_）
        void markParamDead(Graph graph, string name) {
            int wi = graph.compilerInitIdx(name);
            if (wi < 0) return;
            graph.compilerMarkDeadTensor(name);
        }
        int isNodeOutputOf(Graph graph, string name) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.compilerNodeOutput(i, 0) == name || graph.compilerNodeOutput(i, 1) == name || graph.compilerNodeOutput(i, 2) == name || graph.compilerNodeOutput(i, 3) == name) return 1;
                i = i + 1;
            }
            return 0;
        }
        int consumerKindOf(Graph graph, string name) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeInAt(i, 0) == name || graph.nodeInAt(i, 1) == name || graph.nodeInAt(i, 2) == name) {
                    string t = graph.nodeTypeAt(i);
                    if (t == "Conv" || t == "MaxPool" || t == "AveragePool" || t == "GlobalAveragePool" || t == "BatchNormalization") return Kind.CNN_ACT();
                    if (t == "Conv3D" || t == "MaxPool3D" || t == "AveragePool3D") return Kind.CNN_ACT();   // 3D
                    // F8：Concat/Transpose/Reshape 等 —— 若张量本身 4D 则按 CNN 激活
                    int s = graph.compilerShapeIdx(name);
                    if (s >= 0 && (graph.compilerShapeDim(s, 2) > 1 || graph.compilerShapeDim(s, 3) > 1)) return Kind.CNN_ACT();
                    return Kind.FC_ACT();
                }
                i = i + 1;
            }
            return Kind.FC_ACT();
        }
        void markFCWeight(Graph graph, string name, int v) {
            int i = graph.compilerInitIdx(name);
            if (i >= 0) { graph.compilerWeightSetField(i, WeightField.TRANSPOSED(), v); graph.compilerWeightSetField(i, WeightField.ROLE(), 0); graph.compilerSetShapeKind(name, Kind.FC_W()); }
        }
        void markFCBias(Graph graph, string name) {
            int i = graph.compilerInitIdx(name);
            if (i >= 0) { graph.compilerWeightSetField(i, WeightField.BIAS(), 1); graph.compilerWeightSetField(i, WeightField.ROLE(), 1); graph.compilerSetShapeKind(name, Kind.FC_B()); }
        }
        void markCNNWeight(Graph graph, string name) {
            int i = graph.compilerInitIdx(name);
            if (i >= 0) { graph.compilerWeightSetField(i, WeightField.ROLE(), 2); graph.compilerSetShapeKind(name, Kind.CNN_W()); }
        }
        void markCNNBias(Graph graph, string name) {
            int i = graph.compilerInitIdx(name);
            if (i >= 0) { graph.compilerWeightSetField(i, WeightField.ROLE(), 3); graph.compilerSetShapeKind(name, Kind.CNN_B()); }
        }

        int classifyShapes(Graph graph) {
            // 1) 权重/偏置：由消费节点决定（初始器）
            int i = 0;
            while (i < graph.nodeCount()) {
                string t = graph.nodeTypeAt(i);
                if (t == "Gemm") {
                    markFCWeight(graph, graph.nodeInAt(i, 1), graph.compilerAttr(i, NodeField.TRANSB()));   // transB=1：wire=[N,K]；transB=0：wire=[K,N]
                    markFCBias(graph, graph.nodeInAt(i, 2));
                } else if (t == "MatMul") {
                    markFCWeight(graph, graph.nodeInAt(i, 1), 0);             // MatMul 无 transB，wire=[K,N]
                } else if (t == "Conv") {
                    markCNNWeight(graph, graph.nodeInAt(i, 1));
                    markCNNBias(graph, graph.nodeInAt(i, 2));
                } else if (t == "Conv3D") {
                    // 3D：权重 [Cout,Cin,kd,kh,kw] / 偏置 [Cout]
                    markCNNWeight(graph, graph.nodeInAt(i, 1));
                    markCNNBias(graph, graph.nodeInAt(i, 2));
                } else if (t == "ConvTranspose") {
                    // F8：权重 [Cin,Cout,kh,kw] 直接拷贝（wRole_=2 无需转置）
                    markCNNWeight(graph, graph.nodeInAt(i, 1));
                    markCNNBias(graph, graph.nodeInAt(i, 2));
                } else if (t == "Concat" || t == "Transpose" || t == "Reshape") {
                    // F8：4D 通用常量输入 → CNN 激活登记 + 直接拷贝（Concat 的非常量输入/常量）
                    markGeneric4DConst(graph, graph.nodeInAt(i, 0));
                    if (t == "Concat") { markGeneric4DConst(graph, graph.nodeInAt(i, 1)); markGeneric4DConst(graph, graph.nodeInAt(i, 2)); }
                    if (t == "Reshape") markInt64Param(graph, graph.nodeInAt(i, 1));   // shape 参数（int64）不登记为 f32 张量
                } else if (t == "Slice") {
                    // F8：starts/ends/axes/steps 参数初始器（int64）不登记为 f32 张量
                    markInt64Param(graph, graph.nodeInAt(i, 1));
                    markInt64Param(graph, graph.nodeInAt(i, 2));
                    markInt64Param(graph, graph.nodeInAt(i, 3));
                    markInt64Param(graph, graph.nodeInAt(i, 4));
                } else if (t == "InstanceNormalization") {
                    // F8：scale/bias [C] 常量 → FC_B 登记（addTensorPlanned2(d0,1)）
                    markFCBias(graph, graph.nodeInAt(i, 1));
                    markFCBias(graph, graph.nodeInAt(i, 2));
                } else if (t == "Pad") {
                    // F8：pads（int64）与 constant_value（f32）参数不登记为 f32 激活张量
                    markInt64Param(graph, graph.nodeInAt(i, 1));
                    markParamDead(graph, graph.nodeInAt(i, 2));
                } else if (t == "Split") {
                    // F8：split 尺寸输入（opset13+，int64）不登记为 f32 张量
                    markInt64Param(graph, graph.nodeInAt(i, 1));
                } else if (t == "Resize" || t == "Upsample") {
                    // F8：scales/sizes 参数初始器不登记为激活（读自 file_）
                    markParamDead(graph, graph.nodeInAt(i, 1));
                    markParamDead(graph, graph.nodeInAt(i, 2));
                    markParamDead(graph, graph.nodeInAt(i, 3));
                }
                i = i + 1;
            }
            // 2) 图输入（非初始器、非任何节点输出）：由首个消费者决定 4D/FC
            int si = 0;
            while (si < graph.compilerShapeCount()) {
                string nm = graph.compilerShapeName(si);
                if (graph.compilerInitIdx(nm) >= 0) { si = si + 1; continue; }
                if (isNodeOutputOf(graph, nm) == 1) { si = si + 1; continue; }
                graph.compilerSetShapeKind(nm, consumerKindOf(graph, nm));
                si = si + 1;
            }
            // 3) 激活：按生产者传播（节点按拓扑序；死节点跳过）
            i = 0;
            while (i < graph.nodeCount()) {
                string t = graph.nodeTypeAt(i);
                if (t == "") { i = i + 1; continue; }
                int k = Kind.FC_ACT();
                if (t == "Conv" || t == "MaxPool" || t == "AveragePool" || t == "GlobalAveragePool") k = Kind.CNN_ACT();
                else if (t == "Conv3D" || t == "MaxPool3D" || t == "AveragePool3D") k = Kind.CNN_ACT();   // 3D
                else if (t == "Gemm" || t == "MatMul" || t == "Flatten") k = Kind.FC_ACT();
                else {
                    // Relu / Sigmoid / Softmax / Add：沿用主输入 kind
                    k = shapeKindOf(graph, graph.nodeInAt(i, 0));
                }
                graph.compilerSetShapeKind(graph.compilerNodeOutput(i, 0), k);
                if (t == "Split") {   // F8：Split 所有输出沿用主输入 kind
                    graph.compilerSetShapeKind(graph.compilerNodeOutput(i, 1), k);
                    graph.compilerSetShapeKind(graph.compilerNodeOutput(i, 2), k);
                    graph.compilerSetShapeKind(graph.compilerNodeOutput(i, 3), k);
                }
                i = i + 1;
            }
            return 1;
        }

        int fuseConvBN(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeOp(i) != OpCode.CONV()) { i = i + 1; continue; }
                if (graph.compilerAttrFused(i) == 1) { i = i + 1; continue; }
                if (graph.compilerIsGraphOutput(graph.compilerNodeOutput(i, 0)) == 1) { i = i + 1; continue; }
                // P2b：精确匹配 Conv 输出的唯一 Use = BatchNormalization operand0。
                int j = graph.matchSingleUseOp(graph.valueId(graph.compilerNodeOutput(i, 0)), "BatchNormalization", 0);
                if (j < 0) { i = i + 1; continue; }
                // BN 4 参数必须是初始器
                if (graph.compilerInitIdx(graph.nodeInAt(j, 1)) < 0 || graph.compilerInitIdx(graph.nodeInAt(j, 2)) < 0 || graph.compilerInitIdx(graph.nodeInAt(j, 3)) < 0 || graph.compilerInitIdx(graph.nodeInAt(j, 4)) < 0) { i = i + 1; continue; }
                // 标记 conv 权重/偏置折叠（记录 BN 参数初始器下标 + BN 节点下标）
                int wi = graph.compilerInitIdx(graph.nodeInAt(i, 1));
                int wb = graph.compilerInitIdx(graph.nodeInAt(i, 2));
                if (wi >= 0) { graph.compilerWeightSetField(wi, WeightField.BN(), 1); graph.compilerWeightSetField(wi, WeightField.BN_NODE(), j); graph.compilerWeightSetField(wi, WeightField.BN_SCALE(), graph.compilerInitIdx(graph.nodeInAt(j, 1))); graph.compilerWeightSetField(wi, WeightField.BN_BIAS(), graph.compilerInitIdx(graph.nodeInAt(j, 2))); graph.compilerWeightSetField(wi, WeightField.BN_MEAN(), graph.compilerInitIdx(graph.nodeInAt(j, 3))); graph.compilerWeightSetField(wi, WeightField.BN_VAR(), graph.compilerInitIdx(graph.nodeInAt(j, 4))); }
                if (wb >= 0) { graph.compilerWeightSetField(wb, WeightField.BN(), 1); graph.compilerWeightSetField(wb, WeightField.BN_NODE(), j); graph.compilerWeightSetField(wb, WeightField.BN_SCALE(), graph.compilerInitIdx(graph.nodeInAt(j, 1))); graph.compilerWeightSetField(wb, WeightField.BN_BIAS(), graph.compilerInitIdx(graph.nodeInAt(j, 2))); graph.compilerWeightSetField(wb, WeightField.BN_MEAN(), graph.compilerInitIdx(graph.nodeInAt(j, 3))); graph.compilerWeightSetField(wb, WeightField.BN_VAR(), graph.compilerInitIdx(graph.nodeInAt(j, 4))); }
                else {
                    // G4：无卷积偏置的 Conv（真实模型常见）→ 由 BN 参数合成偏置
                    int Cout = graph.compilerWeightRows(wi);
                    string bname = graph.compilerNodeOutput(i, 0) + "#bnb";
                    int[] bdims = new int[1];
                    bdims[0] = Cout;
                    int bw = graph.compilerWeightAdd(bname, Cout, 1, 1, 1, 0, Cout * 4);   // 无源字节，仅用于 count
                    graph.compilerWeightSetField(bw, WeightField.ROLE(), 3);
                    graph.compilerWeightSetField(bw, WeightField.BN(), 1);
                    graph.compilerWeightSetField(bw, WeightField.BN_ONLY(), 1);
                    graph.compilerWeightSetField(bw, WeightField.BN_NODE(), j);
                    graph.compilerWeightSetField(bw, WeightField.BN_SCALE(), graph.compilerInitIdx(graph.nodeInAt(j, 1)));
                    graph.compilerWeightSetField(bw, WeightField.BN_BIAS(), graph.compilerInitIdx(graph.nodeInAt(j, 2)));
                    graph.compilerWeightSetField(bw, WeightField.BN_MEAN(), graph.compilerInitIdx(graph.nodeInAt(j, 3)));
                    graph.compilerWeightSetField(bw, WeightField.BN_VAR(), graph.compilerInitIdx(graph.nodeInAt(j, 4)));
                    graph.addShapeD(bname, bdims, 1);
                    graph.compilerSetShapeKind(bname, Kind.CNN_B());
                    graph.compilerSetNodeInput(i, 2, bname);
                }
                graph.compilerAttrSetFused(i, 1);
                graph.compilerAttrSetFusedOut(i, graph.compilerNodeOutput(j, 0));
                graph.compilerSetNodeType(j, "");
                graph.compilerMarkDeadTensor(graph.compilerNodeOutput(i, 0));   // conv 中间输出
                // BN 参数不再被消费 → 标死（不分配/不登记/不写权重）
                if (graph.compilerLiveConsumers(graph.nodeInAt(j, 1)) == 0) graph.compilerMarkDeadTensor(graph.nodeInAt(j, 1));
                if (graph.compilerLiveConsumers(graph.nodeInAt(j, 2)) == 0) graph.compilerMarkDeadTensor(graph.nodeInAt(j, 2));
                if (graph.compilerLiveConsumers(graph.nodeInAt(j, 3)) == 0) graph.compilerMarkDeadTensor(graph.nodeInAt(j, 3));
                if (graph.compilerLiveConsumers(graph.nodeInAt(j, 4)) == 0) graph.compilerMarkDeadTensor(graph.nodeInAt(j, 4));
                graph.compilerIncBn();
                i = i + 1;
            }
            return 1;
        }

        int buildReverseGraph(Graph graph) {
            // 1) 定位「输出是图输出的 Softmax」节点 → logits = 其输入
            int smNode = -1;
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeOp(i) == OpCode.SOFTMAX() && graph.compilerIsGraphOutput(graph.compilerNodeOutput(i, 0)) == 1) { smNode = i; i = graph.nodeCount(); }
                i = i + 1;
            }
            if (smNode < 0) {
                Console.writeLine("buildReverseGraph: no Softmax graph output");
                return 0;
            }
            string logits = graph.nodeInAt(smNode, 0);
            int ls = graph.compilerShapeIdx(logits);
            if (ls < 0) return 0;

            // 2) label / loss / dlogits 张量（label 由训练循环灌 one-hot）
            // 注意：label 必须与 logits 同秩且同 shape kind——5D 分割 logits
            // [N,C,D,H,W] 走 addShapeD5，否则漏深度维（同 Flatten 5D BUG：4D
            // 注册丢 shD4 → label 越界/覆盖）；shape kind 直接镜像 logits（否则
            // FC_ACT 分支在 buildRuntime 里优先于 5D 分支 → label 被注册成 [C,1]）。
            if (graph.compilerShapeR5(ls) == 1)
                graph.addShapeD5("label", graph.compilerShapeDim(ls, 0), graph.compilerShapeDim(ls, 1), graph.compilerShapeDim(ls, 2), graph.compilerShapeDim(ls, 3), graph.compilerShapeDim(ls, 4));
            else
                graph.addShapeD4("label", graph.compilerShapeDim(ls, 0), graph.compilerShapeDim(ls, 1), graph.compilerShapeDim(ls, 2), graph.compilerShapeDim(ls, 3));
            graph.compilerSetShapeKind("label", graph.compilerShapeKind(ls));
            graph.addShapeD4("loss", 1, 1, 1, 1);
            graph.compilerSetShapeKind("loss", Kind.FC_ACT());
            graph.compilerEnsureGrad(logits);

            // 3) loss 节点：CE（SoftmaxCE(logits,label)→(dlogits,loss)）或
            //    Dice（DiceLoss(prob,label)→(dprob,loss) + BwdSoftmax(dprob,prob)→dlogits）
            if (graph.compilerLossMode() == 1) {
                // prob = Softmax 输出（图输出）；其梯度 dprob 由 DiceLoss 产出，
                // 经 BwdSoftmax 链式回传到 logits 梯度 dlogits。
                string prob = graph.compilerNodeOutput(smNode, 0);
                graph.compilerEnsureGrad(prob);
                int nid = graph.nodeCount();
                graph.beginNode();
                graph.nodeType(nid, "DiceLoss");
                graph.nodeIn(nid, 0, prob);
                graph.nodeIn(nid, 1, "label");
                graph.nodeOut(nid, graph.compilerGradName(prob));
                graph.nodeOut(nid, "loss");
                graph.endNode();
                int nid2 = graph.nodeCount();
                graph.beginNode();
                graph.nodeType(nid2, "BwdSoftmax");
                graph.nodeIn(nid2, 0, graph.compilerGradName(prob));
                graph.nodeIn(nid2, 1, prob);
                graph.nodeOut(nid2, graph.compilerGradName(logits));
                graph.endNode();
            } else {
                int nid = graph.nodeCount();
                graph.beginNode();
                graph.nodeType(nid, "SoftmaxCE");
                graph.nodeIn(nid, 0, logits);
                graph.nodeIn(nid, 1, "label");
                graph.nodeOut(nid, graph.compilerGradName(logits));
                graph.nodeOut(nid, "loss");
                graph.endNode();
            }

            // 4) 反向拓扑遍历（analysis_ order 逆序）：输出梯度已知 → 按算子类型追加 backward
            int oi = graph.compilerAnalysisPlanOrderCount() - 1;
            while (oi >= 0) {
                int ni = graph.compilerAnalysisPlanOrder(oi);
                string t = graph.nodeTypeAt(ni);
                if (t != "") {
                    string y = graph.compilerNodeOutput(ni, 0);
                    if (graph.compilerShapeIdx(graph.compilerGradName(y)) >= 0) {
                        // 确保该节点各输入/输出的梯度张量形状都登记（否则 buildRuntime 注册不到）
                        graph.compilerEnsureGrad(graph.nodeInAt(ni, 0));
                        graph.compilerEnsureGrad(graph.nodeInAt(ni, 1));
                        graph.compilerEnsureGrad(graph.nodeInAt(ni, 2));
                        graph.compilerEnsureGrad(graph.nodeInAt(ni, 3));
                        if (t == "Gemm") {
                            // BwdDense(dy, x, w) → (dx, dw, db)
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdDense");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeIn(bd, 2, graph.nodeInAt(ni, 1));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 2)));
                            graph.endNode();
                        } else if (t == "MatMul") {
                            // 无偏置：db 输出用 0 占位（runtime 忽略）
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdDense");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeIn(bd, 2, graph.nodeInAt(ni, 1));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.nodeOut(bd, "");
                            graph.endNode();
                        } else if (t == "Relu") {
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdRelu");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.endNode();
                        } else if (t == "Sigmoid") {
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdSigmoid");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, y);              // 用前向输出 y
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.endNode();
                        } else if (t == "Add") {
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdAdd");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.endNode();
                        } else if (t == "Conv") {
                            // BwdConv(dy, x, w) → (dx, dw, db)；复制卷积参数
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdConv");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeIn(bd, 2, graph.nodeInAt(ni, 1));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 2)));   // 无偏置 → "" → runtime db=-1
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.SH(), graph.compilerAttr(ni, NodeField.SH())); graph.compilerAttrSet(bd, NodeField.SW(), graph.compilerAttr(ni, NodeField.SW()));
                            graph.compilerAttrSet(bd, NodeField.PT(), graph.compilerAttr(ni, NodeField.PT())); graph.compilerAttrSet(bd, NodeField.PL(), graph.compilerAttr(ni, NodeField.PL()));
                            graph.compilerAttrSet(bd, NodeField.DH(), graph.compilerAttr(ni, NodeField.DH())); graph.compilerAttrSet(bd, NodeField.DW(), graph.compilerAttr(ni, NodeField.DW())); graph.compilerAttrSet(bd, NodeField.GROUP(), graph.compilerAttr(ni, NodeField.GROUP()));
                        } else if (t == "MaxPool") {
                            // BwdMaxPool(dy, x) → (dx)；复制池化参数
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdMaxPool");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.KH(), graph.compilerAttr(ni, NodeField.KH())); graph.compilerAttrSet(bd, NodeField.KW(), graph.compilerAttr(ni, NodeField.KW()));
                            graph.compilerAttrSet(bd, NodeField.SH(), graph.compilerAttr(ni, NodeField.SH())); graph.compilerAttrSet(bd, NodeField.SW(), graph.compilerAttr(ni, NodeField.SW()));
                            graph.compilerAttrSet(bd, NodeField.PT(), graph.compilerAttr(ni, NodeField.PT())); graph.compilerAttrSet(bd, NodeField.PL(), graph.compilerAttr(ni, NodeField.PL()));
                        } else if (t == "ConvTranspose") {
                            // 阶段4d：BwdConvTranspose(dy, x, w) → (dx, dw, db)；复制转置卷积参数
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdConvTranspose");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeIn(bd, 2, graph.nodeInAt(ni, 1));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 2)));   // 无偏置 → "" → runtime db=-1
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.SH(), graph.compilerAttr(ni, NodeField.SH())); graph.compilerAttrSet(bd, NodeField.SW(), graph.compilerAttr(ni, NodeField.SW()));
                            graph.compilerAttrSet(bd, NodeField.PT(), graph.compilerAttr(ni, NodeField.PT())); graph.compilerAttrSet(bd, NodeField.PB(), graph.compilerAttr(ni, NodeField.PB()));
                            graph.compilerAttrSet(bd, NodeField.PL(), graph.compilerAttr(ni, NodeField.PL())); graph.compilerAttrSet(bd, NodeField.PR(), graph.compilerAttr(ni, NodeField.PR()));
                        } else if (t == "Conv3D") {
                            // 阶段4：BwdConv3D(dy, x, w) → (dx, dw, db)；复制 3D 卷积参数
                            // （kd/kh/kw 与 group 由 w 张量形状给出；dd/dh/dw 假定 1）
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdConv3D");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeIn(bd, 2, graph.nodeInAt(ni, 1));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 2)));   // 无偏置 → "" → runtime db=-1
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.SD3(), graph.compilerAttr(ni, NodeField.SD3())); graph.compilerAttrSet(bd, NodeField.SH(), graph.compilerAttr(ni, NodeField.SH())); graph.compilerAttrSet(bd, NodeField.SW(), graph.compilerAttr(ni, NodeField.SW()));
                            graph.compilerAttrSet(bd, NodeField.PDT(), graph.compilerAttr(ni, NodeField.PDT())); graph.compilerAttrSet(bd, NodeField.PDB(), graph.compilerAttr(ni, NodeField.PDB()));
                            graph.compilerAttrSet(bd, NodeField.PT(), graph.compilerAttr(ni, NodeField.PT())); graph.compilerAttrSet(bd, NodeField.PB(), graph.compilerAttr(ni, NodeField.PB()));
                            graph.compilerAttrSet(bd, NodeField.PL(), graph.compilerAttr(ni, NodeField.PL())); graph.compilerAttrSet(bd, NodeField.PR(), graph.compilerAttr(ni, NodeField.PR()));
                        } else if (t == "MaxPool3D") {
                            // 阶段4：BwdMaxPool3D(dy, x) → (dx)；复制 3D 池化参数
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdMaxPool3D");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.KD3(), graph.compilerAttr(ni, NodeField.KD3())); graph.compilerAttrSet(bd, NodeField.KH(), graph.compilerAttr(ni, NodeField.KH())); graph.compilerAttrSet(bd, NodeField.KW(), graph.compilerAttr(ni, NodeField.KW()));
                            graph.compilerAttrSet(bd, NodeField.SD3(), graph.compilerAttr(ni, NodeField.SD3())); graph.compilerAttrSet(bd, NodeField.SH(), graph.compilerAttr(ni, NodeField.SH())); graph.compilerAttrSet(bd, NodeField.SW(), graph.compilerAttr(ni, NodeField.SW()));
                            graph.compilerAttrSet(bd, NodeField.PDT(), graph.compilerAttr(ni, NodeField.PDT())); graph.compilerAttrSet(bd, NodeField.PDB(), graph.compilerAttr(ni, NodeField.PDB()));
                            graph.compilerAttrSet(bd, NodeField.PT(), graph.compilerAttr(ni, NodeField.PT())); graph.compilerAttrSet(bd, NodeField.PB(), graph.compilerAttr(ni, NodeField.PB()));
                            graph.compilerAttrSet(bd, NodeField.PL(), graph.compilerAttr(ni, NodeField.PL())); graph.compilerAttrSet(bd, NodeField.PR(), graph.compilerAttr(ni, NodeField.PR()));
                        } else if (t == "AveragePool3D") {
                            // 阶段4：BwdAvgPool3D(dy, x) → (dx)；复制 3D 池化参数 + cip
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdAvgPool3D");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.KD3(), graph.compilerAttr(ni, NodeField.KD3())); graph.compilerAttrSet(bd, NodeField.KH(), graph.compilerAttr(ni, NodeField.KH())); graph.compilerAttrSet(bd, NodeField.KW(), graph.compilerAttr(ni, NodeField.KW()));
                            graph.compilerAttrSet(bd, NodeField.SD3(), graph.compilerAttr(ni, NodeField.SD3())); graph.compilerAttrSet(bd, NodeField.SH(), graph.compilerAttr(ni, NodeField.SH())); graph.compilerAttrSet(bd, NodeField.SW(), graph.compilerAttr(ni, NodeField.SW()));
                            graph.compilerAttrSet(bd, NodeField.PDT(), graph.compilerAttr(ni, NodeField.PDT())); graph.compilerAttrSet(bd, NodeField.PDB(), graph.compilerAttr(ni, NodeField.PDB()));
                            graph.compilerAttrSet(bd, NodeField.PT(), graph.compilerAttr(ni, NodeField.PT())); graph.compilerAttrSet(bd, NodeField.PB(), graph.compilerAttr(ni, NodeField.PB()));
                            graph.compilerAttrSet(bd, NodeField.PL(), graph.compilerAttr(ni, NodeField.PL())); graph.compilerAttrSet(bd, NodeField.PR(), graph.compilerAttr(ni, NodeField.PR()));
                            graph.compilerAttrSet(bd, NodeField.CIP(), graph.compilerAttr(ni, NodeField.CIP()));
                        } else if (t == "Resize" || t == "Upsample") {
                            // 阶段4d：Resize3D 反向 → BwdResize(dy, x) → dx；复制 mode/transform。
                            // 仅 3D（U-Net 上采样）；2D 反向未实现 → 跳过（梯度 0）。
                            int osr = graph.compilerShapeIdx(y);
                            if (osr >= 0 && graph.compilerShapeR5(osr) == 1) {
                                int bd = graph.nodeCount();
                                graph.beginNode();
                                graph.nodeType(bd, "BwdResize");
                                graph.nodeIn(bd, 0, graph.compilerGradName(y));
                                graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                                graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                                graph.endNode();
                                graph.compilerAttrSet(bd, NodeField.MODE(), graph.compilerAttr(ni, NodeField.MODE()));
                                graph.compilerAttrSet(bd, NodeField.TRANSFORM(), graph.compilerAttr(ni, NodeField.TRANSFORM()));
                            }
                        } else if (t == "Concat") {
                            // U-Net 跳跃连接反向：BwdConcat(dy, x0, x1, x2) → (dx0, dx1, dx2)。
                            // nIn1_/nIn2_/nIn3_ = 原输入（buildRuntime 查轴长）；nOut0-2 = 各输入梯度。
                            int bd = graph.nodeCount();
                            graph.beginNode();
                            graph.nodeType(bd, "BwdConcat");
                            graph.nodeIn(bd, 0, graph.compilerGradName(y));
                            graph.nodeIn(bd, 1, graph.nodeInAt(ni, 0));
                            graph.nodeIn(bd, 2, graph.nodeInAt(ni, 1));
                            graph.nodeIn(bd, 3, graph.nodeInAt(ni, 2));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 0)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 1)));
                            graph.nodeOut(bd, graph.compilerGradName(graph.nodeInAt(ni, 2)));
                            graph.endNode();
                            graph.compilerAttrSet(bd, NodeField.AXIS(), graph.compilerAttr(ni, NodeField.AXIS()));
                        }
                        // Softmax 由 CE 处理；Conv3D/池化等暂不支持（梯度 0，跳过）
                    }
                }
                oi = oi - 1;
            }

            // 5) 权重/偏置追加 Update(W, W#g)（可训参数：FC_W/FC_B/CNN_W/CNN_B）
            // 仅当梯度确实由某个反向算子产出（isNodeOutput）——Resize sizes/scales
            // 等参数初始器虽被 ensureGrad 登记了形状，但没有反向节点产出其梯度，
            // 不应生成 Update（否则 buildRuntime 因该常量非运行时张量而失败）。
            int wi = 0;
            while (wi < graph.compilerWeightCount()) {
                string nm = graph.compilerWeightNameAt(wi);
                int role = graph.compilerWeightGetField(wi, WeightField.ROLE());
                if ((role == 0 || role == 1 || role == 2 || role == 3) && graph.compilerIsNodeOutput(graph.compilerGradName(nm)) == 1) {
                    int uid = graph.nodeCount();
                    // 输出用独立 dummy 标量（不能复用权重名——那会让 producerIdx(权重)=Update，
                    // 权重"被产出"→ 前向消费权重 + Update 依赖梯度 → 环）
                    string dummy = "upd" + Fmt.i(uid);
                    graph.addShapeD4(dummy, 1, 1, 1, 1);
                    graph.compilerSetShapeKind(dummy, Kind.FC_ACT());
                    graph.beginNode();
                    graph.nodeType(uid, "Update");
                    graph.nodeIn(uid, 0, nm);
                    graph.nodeIn(uid, 1, graph.compilerGradName(nm));
                    graph.nodeOut(uid, dummy);
                    graph.endNode();
                }
                wi = wi + 1;
            }
            // 5c) 多消费者梯度（U-Net 跳跃连接）：skip 张量（如 r1/r3）同时被编码器
            //     算子与 Concat 消费 → 梯度名被多反向节点产出。BwdConcat 与主 producer
            //     存在依赖环（编码器反向依赖 concat 上游输出 u#g），不能靠执行顺序累加。
            //     改用显式累加：主 producer 输出改 g_a、BwdConcat 输出改 g_b、加
            //     GradAcc(g_a, g_b) → g（纯前向 Add，消费者读 g）。
            int cc = 0;
            while (cc < graph.nodeCount()) {
                if (graph.nodeOp(cc) == OpCode.BWD_CONCAT()) {
                    int slot = 0;
                    while (slot < 3) {
                        string g;
                        if (slot == 0) g = graph.compilerNodeOutput(cc, 0);
                        else if (slot == 1) g = graph.compilerNodeOutput(cc, 1);
                        else g = graph.compilerNodeOutput(cc, 2);
                        if (g != "" && Str.len(g) >= 2 && Str.substring(g, Str.len(g) - 2, Str.len(g)) == "#g") {
                            int other = -1;
                            int jj = 0;
                            while (jj < graph.nodeCount()) {
                                if (jj != cc && graph.nodeTypeAt(jj) != "" && graph.nodeTypeAt(jj) != "BwdConcat") {
                                    if (graph.compilerNodeOutput(jj, 0) == g || graph.compilerNodeOutput(jj, 1) == g || graph.compilerNodeOutput(jj, 2) == g || graph.compilerNodeOutput(jj, 3) == g) { other = jj; jj = graph.nodeCount(); }
                                }
                                jj = jj + 1;
                            }
                            if (other >= 0) {
                                string ga = g + "_a";
                                string gb = g + "_b";
                                // P3c：结果槽改写走 canonical mutation API（不再直写 SoA）
                                graph.replaceResult(cc, slot, gb);
                                if (graph.compilerNodeOutput(other, 0) == g) graph.replaceResult(other, 0, ga);
                                else if (graph.compilerNodeOutput(other, 1) == g) graph.replaceResult(other, 1, ga);
                                else if (graph.compilerNodeOutput(other, 2) == g) graph.replaceResult(other, 2, ga);
                                else if (graph.compilerNodeOutput(other, 3) == g) graph.replaceResult(other, 3, ga);
                                // 登记 g_a/g_b 形状（同 g）
                                int gs = graph.compilerShapeIdx(g);
                                if (gs >= 0) {
                                    if (graph.compilerShapeR5(gs) == 1) {
                                        graph.addShapeD5(ga, graph.compilerShapeDim(gs, 0), graph.compilerShapeDim(gs, 1), graph.compilerShapeDim(gs, 2), graph.compilerShapeDim(gs, 3), graph.compilerShapeDim(gs, 4));
                                        graph.addShapeD5(gb, graph.compilerShapeDim(gs, 0), graph.compilerShapeDim(gs, 1), graph.compilerShapeDim(gs, 2), graph.compilerShapeDim(gs, 3), graph.compilerShapeDim(gs, 4));
                                    } else {
                                        graph.addShapeD4(ga, graph.compilerShapeDim(gs, 0), graph.compilerShapeDim(gs, 1), graph.compilerShapeDim(gs, 2), graph.compilerShapeDim(gs, 3));
                                        graph.addShapeD4(gb, graph.compilerShapeDim(gs, 0), graph.compilerShapeDim(gs, 1), graph.compilerShapeDim(gs, 2), graph.compilerShapeDim(gs, 3));
                                    }
                                    graph.compilerSetShapeKind(ga, graph.compilerShapeKind(gs));
                                    graph.compilerSetShapeKind(gb, graph.compilerShapeKind(gs));
                                }
                                // GradAcc 纯前向累加节点
                                int an = graph.nodeCount();
                                graph.beginNode();
                                graph.nodeType(an, "GradAcc");
                                graph.nodeIn(an, 0, ga);
                                graph.nodeIn(an, 1, gb);
                                graph.nodeOut(an, g);
                                graph.endNode();
                            }
                        }
                        slot = slot + 1;
                    }
                }
                cc = cc + 1;
            }
            return 1;
        }

                int runPipeline(IGraphOptimizeHost host) {
            if (Console.getEnv("MYP_NO_REUSE") == "1") host.enableNoReuseForOptimizer();
            host.runIRPass(IRPassKind.FOLD_SHAPES());  // P3：先折叠输入形状已知的 Resize sizes 链
            host.runIRPass(IRPassKind.FOLD_CONSTS());
            if (host.runIRPass(IRPassKind.INFER_SHAPES()) == 0) { Console.writeLine("DBG fail inferShapes"); return 0; }
            host.runIRPass(IRPassKind.FOLD_SHAPES());  // P3：inferShapes 后折叠剩余链（Shape(中间)→…→Cast）
            host.runIRPass(IRPassKind.CLASSIFY());
            host.runIRPass(IRPassKind.FUSE_BN());
            host.runIRPass(IRPassKind.FUSE_CONV_RELU());
            host.runIRPass(IRPassKind.FUSE_RELU());
            host.runIRPass(IRPassKind.FUSE_GAP_FLATTEN());
            if (host.runIRPassToFixpoint(IRPassKind.IDENTITY_FOLD(), 4) == 0) { Console.writeLine("DBG fail identityFold"); return 0; }
            if (host.runIRPassToFixpoint(IRPassKind.FOLD_RELU(), 4) == 0) { Console.writeLine("DBG fail foldRelu"); return 0; }
            // P4-2/3：Conv+残差Add 融合（仅推理；convResidual 无 backward，训练图不融合）
            if (host.shouldFuseConvAddForOptimizer() == 1) host.runIRPass(IRPassKind.FUSE_CONV_ADD());
            host.runIRPass(IRPassKind.DCE());
            if (host.shouldRunNHWCForOptimizer() == 1) { if (host.runIRPass(IRPassKind.LAYOUT_NHWC()) == 0) { Console.writeLine("DBG fail layoutNHWC"); return 0; } }
            if (host.runTopoSort() == 0) { Console.writeLine("DBG fail topoSort"); return 0; }
            return 1;
        }

        int optimize(IGraphOptimizeHost host, InferenceRuntime rt) {
            host.setTrainingModeForOptimizer(0);
            if (runPipeline(host) == 0) return 0;
            int peak = host.runPlanMemory();
            if (peak <= 0) { Console.writeLine("DBG fail planMemory"); return 0; }
            rt.resizeArena(peak);
            if (host.lowerRuntime(rt) == 0) { Console.writeLine("DBG fail buildRuntime"); return 0; }
            if (Console.getEnv("MYP_RSZ_DBG") == "1") host.dumpResizeSizesForOptimizer();
            return 1;
        }

        // 训练版管线：公共 pass → buildReverseGraph（追加反向/更新节点）→ 重排/重规划 → 构建。
        int optimizeTrain(IGraphOptimizeHost host, InferenceRuntime rt) {
            host.setTrainingModeForOptimizer(1);   // P4-3：训练图不跑 FUSE_CONV_ADD（convResidual 无 backward）
            if (runPipeline(host) == 0) return 0;
            if (host.buildReverseGraphForOptimizer() == 0) { Console.writeLine("DBG fail buildReverseGraph"); return 0; }
            if (host.runTopoSort() == 0) { Console.writeLine("DBG fail topoSort(reverse)"); return 0; }
            int peak = host.runPlanMemory();
            if (peak <= 0) { Console.writeLine("DBG fail planMemory"); return 0; }
            rt.resizeArena(peak);
            if (host.lowerRuntime(rt) == 0) { Console.writeLine("DBG fail buildRuntime"); return 0; }
            return 1;
        }
}