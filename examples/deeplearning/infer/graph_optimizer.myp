// graph_optimizer.myp — Graph pass-pipeline orchestration.
import env;
import fmt;
import "./runtime.myp";
import "./graph_defs.myp";
import "./graph.myp";

interface IGraphOptimizeHost {
    int runIRPass(int pass);
    int runIRPassToFixpoint(int pass, int maxIter);
    int runTopoSort();
    int runPlanMemory();
    int lowerRuntime(InferenceRuntime rt);
    int buildReverseGraphForOptimizer();
    void setTrainingModeForOptimizer(int mode);
    void enableNoReuseForOptimizer();
    int shouldFuseConvAddForOptimizer();
    int shouldRunNHWCForOptimizer();
    void dumpResizeSizesForOptimizer();
}

class GraphOptimizer {
    action:
        // 具体 pass（从 Graph 迁移的试点：DCE）。Graph 通过 runIRPass 委托，
        // 用公共 compiler* 访问器跨类查询/改写，避免在 Graph 保留重复算法。
        int eliminateDeadNodes(Graph graph) {
            int changed = 1;
            while (changed == 1) {
                changed = 0;
                graph.ensureDefUseForOptimizer();
                int i = 0;
                while (i < graph.nodeCount()) {
                    if (graph.nodeTypeAt(i) == "") { i = i + 1; continue; }
                    string eff = graph.compilerEffectiveOut(i);
                    if (eff == "") { i = i + 1; continue; }
                    if (graph.compilerIsGraphOutput(eff) == 1) { i = i + 1; continue; }
                    // P3a：stateful/trainOnly 节点（Update/GradAcc/Bwd* 等）受 traits 保护，
                    // 不得按 use 数删除（Update 就地改权重、GradAcc 累加梯度）。
                    if (OpCode.opTraits(graph.nodeOp(i)) != 0) { i = i + 1; continue; }
                    if (graph.compilerValueUseCount(graph.compilerShapeIdx(eff)) == 0) {
                        graph.compilerEraseNode(i);   // tombstone + 标死有效输出 + 失效 DefUse
                        graph.compilerIncDce();
                        changed = 1;
                    }
                    i = i + 1;
                }
            }
            return 1;
        }

        // GAP+Flatten 融合：GlobalAveragePool → Flatten 折叠为一个 GAP 直写 flatten 输出。
        int fuseGapFlatten(Graph graph) {
            int i = 0;
            while (i < graph.nodeCount()) {
                if (graph.nodeOp(i) != OpCode.GLOBAL_AVG_POOL()) { i = i + 1; continue; }
                if (graph.compilerIsGraphOutput(graph.compilerNodeOutput(i, 0)) == 1) { i = i + 1; continue; }
                int s = graph.compilerShapeIdx(graph.compilerNodeOutput(i, 0));
                if (s >= 0 && graph.compilerShapeDim(s, 0) != 1) { i = i + 1; continue; }   // batch!=1 跳过
                int j = graph.matchSingleUseOp(graph.valueId(graph.compilerNodeOutput(i, 0)), "Flatten", 0);
                if (j < 0) { i = i + 1; continue; }
                graph.fuseSingleUseOutput(i, j, 0);
                graph.compilerIncGap();
                i = i + 1;
            }
            return 1;
        }

        int runPipeline(IGraphOptimizeHost host) {
            if (Console.getEnv("MYP_NO_REUSE") == "1") host.enableNoReuseForOptimizer();
            host.runIRPass(IRPassKind.FOLD_SHAPES());  // P3：先折叠输入形状已知的 Resize sizes 链
            host.runIRPass(IRPassKind.FOLD_CONSTS());
            if (host.runIRPass(IRPassKind.INFER_SHAPES()) == 0) { Console.writeLine("DBG fail inferShapes"); return 0; }
            host.runIRPass(IRPassKind.FOLD_SHAPES());  // P3：inferShapes 后折叠剩余链（Shape(中间)→…→Cast）
            host.runIRPass(IRPassKind.CLASSIFY());
            host.runIRPass(IRPassKind.FUSE_BN());
            host.runIRPass(IRPassKind.FUSE_CONV_RELU());
            host.runIRPass(IRPassKind.FUSE_RELU());
            host.runIRPass(IRPassKind.FUSE_GAP_FLATTEN());
            if (host.runIRPassToFixpoint(IRPassKind.IDENTITY_FOLD(), 4) == 0) { Console.writeLine("DBG fail identityFold"); return 0; }
            if (host.runIRPassToFixpoint(IRPassKind.FOLD_RELU(), 4) == 0) { Console.writeLine("DBG fail foldRelu"); return 0; }
            // P4-2/3：Conv+残差Add 融合（仅推理；convResidual 无 backward，训练图不融合）
            if (host.shouldFuseConvAddForOptimizer() == 1) host.runIRPass(IRPassKind.FUSE_CONV_ADD());
            host.runIRPass(IRPassKind.DCE());
            if (host.shouldRunNHWCForOptimizer() == 1) { if (host.runIRPass(IRPassKind.LAYOUT_NHWC()) == 0) { Console.writeLine("DBG fail layoutNHWC"); return 0; } }
            if (host.runTopoSort() == 0) { Console.writeLine("DBG fail topoSort"); return 0; }
            return 1;
        }

        int optimize(IGraphOptimizeHost host, InferenceRuntime rt) {
            host.setTrainingModeForOptimizer(0);
            if (runPipeline(host) == 0) return 0;
            int peak = host.runPlanMemory();
            if (peak <= 0) { Console.writeLine("DBG fail planMemory"); return 0; }
            rt.resizeArena(peak);
            if (host.lowerRuntime(rt) == 0) { Console.writeLine("DBG fail buildRuntime"); return 0; }
            if (Console.getEnv("MYP_RSZ_DBG") == "1") host.dumpResizeSizesForOptimizer();
            return 1;
        }

        // 训练版管线：公共 pass → buildReverseGraph（追加反向/更新节点）→ 重排/重规划 → 构建。
        int optimizeTrain(IGraphOptimizeHost host, InferenceRuntime rt) {
            host.setTrainingModeForOptimizer(1);   // P4-3：训练图不跑 FUSE_CONV_ADD（convResidual 无 backward）
            if (runPipeline(host) == 0) return 0;
            if (host.buildReverseGraphForOptimizer() == 0) { Console.writeLine("DBG fail buildReverseGraph"); return 0; }
            if (host.runTopoSort() == 0) { Console.writeLine("DBG fail topoSort(reverse)"); return 0; }
            int peak = host.runPlanMemory();
            if (peak <= 0) { Console.writeLine("DBG fail planMemory"); return 0; }
            rt.resizeArena(peak);
            if (host.lowerRuntime(rt) == 0) { Console.writeLine("DBG fail buildRuntime"); return 0; }
            return 1;
        }
}