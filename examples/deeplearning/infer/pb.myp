// pb.myp — 极简 protobuf wire-format 读取器（纯 MYP，零依赖）
//
// 用于在运行时直接解析 ONNX（ModelProto）二进制文件。
// 只实现读取所需子集：varint / 64-bit / 32-bit / length-delimited 四类 wire type，
// 支持任意嵌套消息（以「进入 payload 子区间」方式递归）。float32→double 手写解码。
// 阶段七：字节源双模式——int[] 缓冲（readFile）或 MmapFile（mmap 零拷贝）。
import env;
import math;
import text;
import mmap;

class PbReader {
    action:
        @constructor PbReader() { mm_ = new MmapFile(); }

        void init(int[] data, int len) {
            data_ = data;
            len_ = len;
            mmapMode_ = 0;
            pos_ = 0;
            subEnd_ = len;
            field_ = 0;
            wire_ = 0;
        }

        // 阶段七：mmap 字节源模式（零拷贝，不复制到 int[]）。
        void initMmap(MmapFile mf) {
            mm_ = mf;
            len_ = int(mf.size());
            mmapMode_ = 1;
            pos_ = 0;
            subEnd_ = len_;
            field_ = 0;
            wire_ = 0;
        }

        // 统一字节读取：mmap 模式从映射文件读，否则从 int[] 缓冲读。
        int byteAt(int p) {
            if (mmapMode_ == 1) return mm_.u8(long(p));
            return data_[p];
        }

        bool atEnd() { return pos_ >= subEnd_; }
        int pos() { return pos_; }
        int field() { return field_; }
        int wire() { return wire_; }

        void seek(int p) { pos_ = p; }

        // 读取下一个字段的 tag；子区间结束返回 -1，否则返回 field number
        int nextTag() {
            if (atEnd()) return -1;
            long v = readVarint64();
            field_ = int(v >> 3);
            wire_ = int(v & 7L);
            return field_;
        }

        long readVarint64() {
            long v = 0L;
            int shift = 0;
            while (true) {
                int b = byteAt(pos_);
                pos_ = pos_ + 1;
                v = v | (long(b & 127) << shift);
                if ((b & 128) == 0) return v;
                shift = shift + 7;
            }
        }

        int readVarint() { return int(readVarint64()); }

        // length-delimited 字段的 payload 字节数
        int readLen() { return int(readVarint64()); }

        // 当前字段 payload 起始字节偏移（用于之后直接读浮点数据）
        int payloadOff() { return pos_; }

        void skipBytes(int n) { pos_ = pos_ + n; }

        // 跳过当前字段（nextTag 之后调用）
        void skipField() {
            if (wire_ == 0) { long v = readVarint64(); }
            else if (wire_ == 1) { pos_ = pos_ + 8; }
            else if (wire_ == 2) { int n = readLen(); pos_ = pos_ + n; }
            else if (wire_ == 5) { pos_ = pos_ + 4; }
        }

        // payload 字节 → string
        string readString(int n) {
            StringBuilder sb = new StringBuilder();
            int i = 0;
            while (i < n) {
                sb.append(__myp_chr(byteAt(pos_ + i)));
                i = i + 1;
            }
            pos_ = pos_ + n;
            return sb.toString();
        }

        // 4 字节小端 → 32 位位型（可含负数位型，位模式不变）
        int readU32() {
            int b0 = byteAt(pos_);
            int b1 = byteAt(pos_ + 1);
            int b2 = byteAt(pos_ + 2);
            int b3 = byteAt(pos_ + 3);
            pos_ = pos_ + 4;
            return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
        }

        // 8 字节小端 → 64 位（高位存进 outHi，低位存进 outLo）
        void readU64(int[] outLo, int[] outHi, int k) {
            long v = 0L;
            int i = 0;
            while (i < 8) {
                int b = byteAt(pos_ + i);
                v = v | (long(b) << (i * 8));
                i = i + 1;
            }
            pos_ = pos_ + 8;
            outLo[k] = int(v & 0xFFFFFFFFL);
            outHi[k] = int(v >> 32);
        }

    property:
        int[] data_;
        int len_;
        int pos_;
        int subEnd_;
        int field_;
        int wire_;
        MmapFile mm_;       // 阶段七：mmap 字节源（mmapMode_==1 时使用）
        int mmapMode_;      // 1=mmap，0=int[] 缓冲
}

// float32（IEEE754 位型）↔ double
class F32 {
    static:
        double toDouble(int bits) {
            int sign = (bits >> 31) & 1;
            int exp = (bits >> 23) & 255;
            int man = bits & 8388607;   // 2^23 - 1
            double s = 1.0;
            if (sign == 1) s = -1.0;
            if (exp == 0) {
                if (man == 0) return 0.0;
                // 非规格化：man * 2^-149
                return s * (man / 8388608.0) * 1.401298464324817e-45;
            }
            if (exp == 255) {
                return s * 1.0e300;   // inf/nan 近似（推理用不到）
            }
            double v = (8388608 + man) / 8388608.0;   // 1.man
            v = v * Math.pow(2.0, exp - 127);
            if (sign == 1) return -v;
            return v;
        }

        // double → float32 位型（IEEE754 编码，round-to-nearest）
        // MYP 无 bit_cast/doubleToBits，用纯数学求位型（供写 .bin 输出等）。
        int toBits(double x) {
            int sign = 0;
            if (x < 0.0) { sign = 1; x = 0.0 - x; }
            if (x == 0.0) { if (sign == 1) return -2147483648; return 0; }   // ±0
            if (x != x) return 2143289344;      // 0x7FC00000 NaN
            if (x > 3.4028234663852886e38) {    // ±inf
                if (sign == 1) return -8388608; // 0xFF800000
                return 2139095040;              // 0x7F800000
            }
            // 归一化到 [1,2)：x = m * 2^e
            int e = 0;
            double m = x;
            while (m >= 2.0) { m = m / 2.0; e = e + 1; }
            while (m < 1.0) { m = m * 2.0; e = e - 1; }
            int expBits = e + 127;
            // 取 23 位尾数 + 第 24 位舍入（round-to-nearest）
            double frac = m - 1.0;
            int mant = 0;
            int b = 0;
            while (b < 23) {
                frac = frac * 2.0;
                if (frac >= 1.0) { mant = mant | (1 << (22 - b)); frac = frac - 1.0; }
                b = b + 1;
            }
            frac = frac * 2.0;
            if (frac >= 1.0) {
                mant = mant + 1;
                if (mant >= 8388608) { mant = 0; expBits = expBits + 1; }   // 进位
            }
            int bits = (expBits << 23) | mant;
            if (sign == 1) bits = bits | -2147483648;   // 置符号位 bit31
            return bits;
        }
}
