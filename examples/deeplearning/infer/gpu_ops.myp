// gpu_ops.myp — GPU 算子（@gpu for 卸载 + M3 设备驻留，与 CPU 同一 arena 布局）
//
// 与 ops.myp 的 InferOps 语义一致，仅把 kernel 改为 @gpu for。
// - MYP_GPU=1 且有 CUDA 驱动时真正卸载到 GPU；
// - 否则 @gpu for 自动回退 CPU 顺序执行（结果一致）。
//
// M3 设备驻留（resident(a = dev)）：调用方（runGpu）先把整块 arena H2D 到
// GpuBufferF 一次，把 dev = arenaBuf.devicePtr() 传给每个算子；内核直接操作
// 设备内存，不再每个算子 H2D/D2H 整块搬运。循环上界 = work（实际输出数，
// 传输已跳过，无需再用足印上界）。
import env;
import math;
import atomic;
import fmt;
import gpu;   // 阶段六：cuBLAS SGEMM 厂商库 hook（GpuBackend.cublasAvailable/Sgemm）

class GpuInferOps {
    static:
        // y = W x + b（batch 沿列；每线程算一个输出元素 + 串行归约 j）
        // n = arena 长度（传输范围），work = 有效输出数 = outDim*batch
        void dense(float[] a, int work, int xOff, int xRows, int wOff, int outDim, int batch, int bOff, int yOff, long dev) {
            // 阶段六：cuBLAS SGEMM 优先（列主序 C[m×n]=A[m×k]·B[k×n]，同步执行）。
            // 行主序 y[outDim,batch]=W[outDim,xRows]·x[xRows,batch] 等价于列主序
            // y^T[batch,outDim] = x^T[batch,xRows]·W^T[xRows,outDim] → m=batch,n=outDim,k=xRows。
            // 规模足够（与 denseTiled 同阈值）且厂商库可用时走 cuBLAS（tensor core）。
            if (dev != 0L && GpuBackend.cublasAvailable() == 1 &&
                outDim >= 32 && batch >= 32 && long(outDim) * long(batch) >= 4096L) {
                int r = GpuBackend.cublasSgemm(dev + long(xOff) * 4L, dev + long(wOff) * 4L,
                                               dev + long(yOff) * 4L, batch, outDim, xRows, 1.0, 0.0);
                if (Console.getEnv("MYP_CUBLAS_LOG") == "1") {
                    Console.writeLine("cuBLAS dense m=" + Fmt.i(batch) + " n=" + Fmt.i(outDim) + " k=" + Fmt.i(xRows) + " r=" + Fmt.i(r));
                }
                if (r == 1) {
                    if (bOff >= 0) GpuInferOps.addBiasRows(a, yOff, bOff, outDim, batch, dev);
                    return;
                }
                // cuBLAS 失败 → 回退 denseTiled
            }
            if (outDim >= 32 && batch >= 32 && long(outDim) * long(batch) >= 4096L) {
                GpuInferOps.denseTiled(a, work, xOff, xRows, wOff, outDim, batch, bOff, yOff, dev);
                return;
            }
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long i = p / batch;
                    long k = p % batch;
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + i];   // 无偏置 Gemm（bOff=-1）
                    long j = 0L;
                    while (j < xRows) {
                        sum = sum + a[wOff + i * xRows + j] * a[xOff + j * batch + k];
                        j = j + 1L;
                    }
                    a[yOff + i * batch + k] = sum;
                }
            }
        }

        // cuBLAS SGEMM 后加 bias（y[outDim,batch] 每行加 b[outDim]）。
        void addBiasRows(float[] a, int yOff, int bOff, int outDim, int batch, long dev) {
            @gpu for (long p = 0L; p < long(outDim) * long(batch); p = p + 1L) resident(a = dev) {
                if (p < long(outDim) * long(batch)) {
                    long i = p / long(batch);
                    long k = p % long(batch);
                    a[yOff + i * long(batch) + k] = a[yOff + i * long(batch) + k] + a[bOff + i];
                }
            }
        }

        // dense/matmul 转置布局版（访存合并，2026-08-21，固化 LLM 验证的规律）：
        // 权重存 [xRows, outDim]（转置），线程=输出行 i，j 循环读 a[wOff + j*outDim + i] →
        // warp 内 i 连续 → 合并访存。对比现 dense（[outDim,xRows]，a[wOff+i*xRows+j] 线程读
        // 整行、warp 跨行 → 非合并），在 **batch=1（GEMV/单样本推理）** 场景收益最大
        // （LLM 实测 lm_head 转置 12→1.6ms，7.5x；batch>1 时现 dense 靠"同 i 广播"已 OK）。
        // 数学语义与 dense 相同：y = W x (+b)，y[i*batch+k]、x[j*batch+k] 批内布局不变，
        // 仅权重布局不同。bOff<0 表示无 bias（matmul 复用）。
        void denseTr(float[] a, int work, int xOff, int xRows, int wOff, int outDim, int batch, int bOff, int yOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long i = p / batch;
                    long k = p % batch;
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + i];
                    long j = 0L;
                    while (j < xRows) {
                        sum = sum + a[wOff + j * outDim + i] * a[xOff + j * batch + k];
                        j = j + 1L;
                    }
                    a[yOff + i * batch + k] = sum;
                }
            }
        }

        // y = W x（无偏置；batch 沿列）
        void matmul(float[] a, int work, int xOff, int xRows, int wOff, int outDim, int batch, int yOff, long dev) {
            // 阶段六：cuBLAS SGEMM 优先（同 dense 布局映射：m=batch,n=outDim,k=xRows，无 bias）。
            if (dev != 0L && GpuBackend.cublasAvailable() == 1 &&
                outDim >= 32 && batch >= 32 && long(outDim) * long(batch) >= 4096L) {
                int r = GpuBackend.cublasSgemm(dev + long(xOff) * 4L, dev + long(wOff) * 4L,
                                               dev + long(yOff) * 4L, batch, outDim, xRows, 1.0, 0.0);
                if (Console.getEnv("MYP_CUBLAS_LOG") == "1") {
                    Console.writeLine("cuBLAS matmul m=" + Fmt.i(batch) + " n=" + Fmt.i(outDim) + " k=" + Fmt.i(xRows) + " r=" + Fmt.i(r));
                }
                if (r == 1) return;
                // cuBLAS 失败 → 回退 denseTiled
            }
            if (outDim >= 32 && batch >= 32 && long(outDim) * long(batch) >= 4096L) {
                GpuInferOps.denseTiled(a, work, xOff, xRows, wOff, outDim, batch, -1, yOff, dev);
                return;
            }
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long i = p / batch;
                    long k = p % batch;
                    float sum = 0.0f;
                    long j = 0L;
                    while (j < xRows) {
                        sum = sum + a[wOff + i * xRows + j] * a[xOff + j * batch + k];
                        j = j + 1L;
                    }
                    a[yOff + i * batch + k] = sum;
                }
            }
        }
        // BatchMatMul（阶段四）：4D batch matmul。A [ab0,ab1,M,K] × B [bb0,bb1,K,N] →
        // [ob0,ob1,M,N]。batch 维逐维 max 广播（维=1 → 0）。thread-per-output-element。
        // G5 算子选择：batch 维全 1（ob0==ob1==1）时降级到普通 matmul/denseTiled
        // （denseTiled 按 outDim/batch 规模选分块 GEMM，大矩阵收益显著）。
        void matmulBcast(float[] a, int work, int aOff, int bOff, int oOff,
                         int aM, int aK, int bN,
                         int ab0, int ab1, int bb0, int bb1, int ob0, int ob1, long dev) {
            if (ob0 == 1 && ob1 == 1) {
                // 2D 降级：A=[M,K] 当 W（[outDim,inDim]），B=[K,N] 当 x（[inDim,batch]）
                GpuInferOps.matmul(a, work, bOff, aK, aOff, aM, bN, oOff, dev);
                return;
            }
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int n = int(p % long(bN));
                    int t = int(p / long(bN));
                    int m = t % aM;
                    t = t / aM;
                    int ob1_ = t % ob1;
                    int ob0_ = t / ob1;
                    int ab0_ = (ab0 == 1) ? 0 : (ob0_ % ab0);
                    int ab1_ = (ab1 == 1) ? 0 : (ob1_ % ab1);
                    int bb0_ = (bb0 == 1) ? 0 : (ob0_ % bb0);
                    int bb1_ = (bb1 == 1) ? 0 : (ob1_ % bb1);
                    int aBase = ((ab0_ * ab1 + ab1_) * aM + m) * aK;
                    int bRowBase = ((bb0_ * bb1 + bb1_) * aK) * bN;
                    float sum = 0.0f;
                    int k = 0;
                    while (k < aK) {
                        sum = sum + a[aOff + aBase + k] * a[bOff + bRowBase + k * bN + n];
                        k = k + 1;
                    }
                    a[oOff + ((ob0_ * ob1 + ob1_) * aM + m) * bN + n] = sum;
                }
            }
        }

        // §2.3 ② 分块 GEMM（dense 用）：y[outDim,batch] = W[outDim,xRows]·x[xRows,batch]
        // （+bias）。块 = 32×32 输出 tile；K 分块（BK=32）载 W/x tile 到共享；256 线程
        // 各算 2×2 子 tile（每 k 载 2W+2x → 4 FMA，寄存器复用）。尺寸不足/过小回退
        // thread-per-output。bOff<0 表示无偏置（matmul）。
        void denseTiled(float[] a, int work, int xOff, int xRows, int wOff, int outDim, int batch, int bOff, int yOff, long dev) {
            if (outDim < 32 || batch < 32 || long(outDim) * long(batch) < 4096L) {
                GpuInferOps.dense(a, work, xOff, xRows, wOff, outDim, batch, bOff, yOff, dev);
                return;
            }
            int TM = 32; int TN = 32; int BK = 32;
            int mT = (outDim + TM - 1) / TM;
            int nT = (batch + TN - 1) / TN;
            int nTiles = mT * nT;
            int nKB = (xRows + BK - 1) / BK;
            @gpu tile (float[6144] smem) grid(nTiles) resident(a = dev) {
                long tb = kernel.bx;
                long mi = tb / long(nT);
                long ni = tb % long(nT);
                long tid = kernel.tx;
                long ti = tid / 16L;              // 16×16 线程网格 → 2×2 子 tile
                long tj = tid % 16L;
                long i0 = mi * 32L + ti * 2L;
                long j0 = ni * 32L + tj * 2L;
                float a00 = 0.0f; float a01 = 0.0f; float a10 = 0.0f; float a11 = 0.0f;
                if (bOff >= 0 && i0 < long(outDim)) {
                    float bv = a[bOff + i0];
                    a00 = bv; a01 = bv;
                    if (i0 + 1L < long(outDim)) { float bv2 = a[bOff + i0 + 1L]; a10 = bv2; a11 = bv2; }
                }
                int kb = 0;
                while (kb < nKB) {
                    // 载 W tile [32×32] → smem[0,1024)
                    long rr = tid;
                    while (rr < 1024L) {
                        long wi = rr / 32L;
                        long wk = rr % 32L;
                        float wv = 0.0f;
                        long gi = mi * 32L + wi;
                        long gk = long(kb) * 32L + wk;
                        if (gi < long(outDim) && gk < long(xRows))
                            wv = a[wOff + gi * long(xRows) + gk];
                        smem[rr] = wv;
                        rr = rr + 256L;
                    }
                    // 载 x tile [32×32] → smem[1024,2048)
                    rr = tid;
                    while (rr < 1024L) {
                        long xk = rr / 32L;
                        long xj = rr % 32L;
                        float xv = 0.0f;
                        long gk2 = long(kb) * 32L + xk;
                        long gj = ni * 32L + xj;
                        if (gk2 < long(xRows) && gj < long(batch))
                            xv = a[xOff + gk2 * long(batch) + gj];
                        smem[1024L + rr] = xv;
                        rr = rr + 256L;
                    }
                    kernel.sync();
                    long k = 0L;
                    while (k < 32L) {
                        float w0 = smem[(ti * 2L) * 32L + k];
                        float w1 = smem[(ti * 2L + 1L) * 32L + k];
                        float x0 = smem[1024L + k * 32L + tj * 2L];
                        float x1 = smem[1024L + k * 32L + tj * 2L + 1L];
                        a00 = a00 + w0 * x0;
                        a01 = a01 + w0 * x1;
                        a10 = a10 + w1 * x0;
                        a11 = a11 + w1 * x1;
                        k = k + 1L;
                    }
                    kernel.sync();
                    kb = kb + 1;
                }
                // 写 2×2 输出（边界）
                long base = i0 * long(batch) + j0;
                if (i0 < long(outDim)) {
                    if (j0 < long(batch)) a[yOff + base + 0L] = a00;
                    if (j0 + 1L < long(batch)) a[yOff + base + 1L] = a01;
                }
                if (i0 + 1L < long(outDim)) {
                    if (j0 < long(batch)) a[yOff + base + long(batch)] = a10;
                    if (j0 + 1L < long(batch)) a[yOff + base + long(batch) + 1L] = a11;
                }
            }
        }

        // 逐元素 ReLU
        void relu(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float v = a[inOff + p];
                    if (v > 0.0f) a[outOff + p] = v;
                    else a[outOff + p] = 0.0f;
                }
            }
        }

        // 逐元素 Sigmoid
        void sigmoid(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float x = a[inOff + p];
                    float e = Math.exp(0.0f - x);
                    a[outOff + p] = 1.0f / (1.0f + e);
                }
            }
        }

        // 逐元素 Tanh：y = 2/(1+e^{-2x}) - 1（大 |x| 双侧均不溢出）
        void tanh(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float x = a[inOff + p];
                    float e = Math.exp(0.0f - 2.0f * x);
                    a[outOff + p] = 2.0f / (1.0f + e) - 1.0f;
                }
            }
        }

        // 每列一个样本，沿行 softmax。§2.3 ③：thread-per-column 两遍（先 max 再
        // sum 再写），消除原 thread-per-element 每元素 O(rows) 冗余重扫（总读
        // O(rows²·cols) → O(rows·cols)）。列数=并行度；列少时每线程工作小（快）。
        void softmax(float[] a, int work, int inOff, int outOff, int rows, int cols, long dev) {
            @gpu for (long p = 0L; p < long(cols); p = p + 1L) resident(a = dev) {
                if (p < cols) {
                    long k = p;
                    float m = a[inOff + 0L * long(cols) + k];
                    long j = 1L;
                    while (j < long(rows)) {
                        float v = a[inOff + j * long(cols) + k];
                        if (v > m) m = v;
                        j = j + 1L;
                    }
                    float s = 0.0f;
                    j = 0L;
                    while (j < long(rows)) {
                        s = s + Math.exp(a[inOff + j * long(cols) + k] - m);
                        j = j + 1L;
                    }
                    j = 0L;
                    while (j < long(rows)) {
                        a[outOff + j * long(cols) + k] = Math.exp(a[inOff + j * long(cols) + k] - m) / s;
                        j = j + 1L;
                    }
                }
            }
        }

        // 逐元素相加（doRelu=1：输出直接过 ReLU，图优化 Add+Relu 融合）
        // 阶段三：统一 4D numpy 广播（标量/同尺寸/逐通道/通用）
        void add(float[] a, int work, int aOff, int bOff, int outOff, int bSize, int doRelu,
                 int an, int ac, int ah, int aw, int bn, int bc, int bh, int bw,
                 int on, int oc, int oh, int ow, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float v;
                    if (bSize <= 1) {
                        v = a[aOff + p] + a[bOff + 0];
                    } else if (bSize == work && an == on && ac == oc && ah == oh && aw == ow && bn == on && bc == oc && bh == oh && bw == ow) {
                        v = a[aOff + p] + a[bOff + p];
                    } else if (bn == 1 && bc == oc && bh == 1 && bw == 1) {
                        v = a[aOff + p] + a[bOff + (int(p) / (oh * ow)) % oc];
                    } else {
                        int i = int(p);
                        int w3 = i % ow;
                        int t = i / ow;
                        int w2 = t % oh;
                        t = t / oh;
                        int w1 = t % oc;
                        int w0 = t / oc;
                        int a0 = (an == 1) ? 0 : (w0 % an);
                        int a1 = (ac == 1) ? 0 : (w1 % ac);
                        int a2 = (ah == 1) ? 0 : (w2 % ah);
                        int a3 = (aw == 1) ? 0 : (w3 % aw);
                        int aF = ((a0 * ac + a1) * ah + a2) * aw + a3;
                        int b0 = (bn == 1) ? 0 : (w0 % bn);
                        int b1 = (bc == 1) ? 0 : (w1 % bc);
                        int b2 = (bh == 1) ? 0 : (w2 % bh);
                        int b3 = (bw == 1) ? 0 : (w3 % bw);
                        int bF = ((b0 * bc + b1) * bh + b2) * bw + b3;
                        v = a[aOff + aF] + a[bOff + bF];
                    }
                    if (doRelu == 1 && v < 0.0f) v = 0.0f;
                    a[outOff + p] = v;
                }
            }
        }

        // ---- CNN：4D NCHW，每线程算一个输出元素 ----

        // 卷积（支持 group/strides/pads/dilations）— thread-per-output（tiled 回退路径）
        // x: [N,C,H,W] flat N*C*H*W；w: [yC, C/group, kh, kw]；b: [yC]；y: [N,yC,yH,yW]
        void convPlain(float[] a, int work,
                  int xOff, int xN, int xC, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yH, int yW,
                  int kh, int kw,
                  int sh, int sw, int pt, int pb, int pl, int pr,
                  int dh, int dw, int group, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oc = (p / (yW * yH)) % yC;
                    long nn = p / (yW * yH * yC);
                    int cpg = xC / group;
                    int ocpg = yC / group;
                    long g = oc / ocpg;
                    int wc = cpg * kh * kw;
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + oc];   // 无偏置卷积（bOff=-1）
                    int ic = 0;
                    while (ic < cpg) {
                        long cIn = g * cpg + ic;
                        int ky = 0;
                        while (ky < kh) {
                            long iy = oy * sh - pt + ky * dh;
                            if (iy >= 0 && iy < xH) {
                                int kx = 0;
                                while (kx < kw) {
                                    long ix = ox * sw - pl + kx * dw;
                                    if (ix >= 0 && ix < xW) {
                                        sum = sum + a[xOff + nn * xC * xH * xW + cIn * xH * xW + iy * xW + ix]
                                                   * a[wOff + oc * wc + ic * kh * kw + ky * kw + kx];
                                    }
                                    kx = kx + 1;
                                }
                            }
                            ky = ky + 1;
                        }
                        ic = ic + 1;
                    }
                    a[yOff + p] = sum;
                }
            }
        }

        // 融合 Conv+残差Add（P4-2/3，opKind=73）：与 conv 同，输出直接加残差（同布局同偏移），可接 doRelu。— thread-per-output（tiled 回退路径）
        void convResidualPlain(float[] a, int work,
                  int xOff, int xN, int xC, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yH, int yW,
                  int rOff,
                  int kh, int kw,
                  int sh, int sw, int pt, int pb, int pl, int pr,
                  int dh, int dw, int group, int doRelu, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oc = (p / (yW * yH)) % yC;
                    long nn = p / (yW * yH * yC);
                    int cpg = xC / group;
                    int ocpg = yC / group;
                    long g = oc / ocpg;
                    int wc = cpg * kh * kw;
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + oc];
                    int ic = 0;
                    while (ic < cpg) {
                        long cIn = g * cpg + ic;
                        int ky = 0;
                        while (ky < kh) {
                            long iy = oy * sh - pt + ky * dh;
                            if (iy >= 0 && iy < xH) {
                                int kx = 0;
                                while (kx < kw) {
                                    long ix = ox * sw - pl + kx * dw;
                                    if (ix >= 0 && ix < xW) {
                                        sum = sum + a[xOff + nn * xC * xH * xW + cIn * xH * xW + iy * xW + ix]
                                                   * a[wOff + oc * wc + ic * kh * kw + ky * kw + kx];
                                    }
                                    kx = kx + 1;
                                }
                            }
                            ky = ky + 1;
                        }
                        ic = ic + 1;
                    }
                    float v = sum + a[rOff + p];   // 残差同布局：p 即输出内偏移
                    if (doRelu == 1 && v < 0.0f) v = 0.0f;   // P4-3：可接 doRelu
                    a[yOff + p] = v;
                }
            }
        }

        // ---- 2D 卷积 tiled（implicit GEMM，P5，2026-09-01）----
        // 把卷积写成 GEMM：Y[M,N] = W[M,K]·X[K,N]
        //   M = yC（输出通道），N = xN*yH*yW（全部空间位置），K = cpg*kh*kw（归约维）。
        // 块 = 32×32 输出 tile（M×N）；K 分块 BK=32 载 W tile 与 im2col X tile 到共享；
        // 256 线程各算 2×2 子 tile。im2col 即时展开（stride/pad/dilation 全支持，越界填 0）。
        // 与 conv3dTiled 不同：本内核按 denseTiled 的 GEMM 分块 + im2col，任意核/stride 都走
        // 共享路径（不做 patch 尺寸假设）；group=1 才能进（group>1 罕见回退）。
        // doRelu=1 尾接 ReLU，rOff>=0 输出加残差（同布局同偏移，P4-2/3 融合卷积共用）。
        // 尺寸不足（M<32 或 N<32 或 M*N<4096）回退 thread-per-output。
        void conv2dTiled(float[] a, int work,
                  int xOff, int xN, int xC, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yH, int yW,
                  int rOff,
                  int kh, int kw,
                  int sh, int sw, int pt, int pb, int pl, int pr,
                  int dh, int dw, int group, int doRelu, long dev) {
            int cpg = xC / group;
            int N = xN * yH * yW;
            int K = cpg * kh * kw;
            if (group != 1 || yC < 32 || N < 32 || long(yC) * long(N) < 4096L) {
                if (rOff >= 0) { GpuInferOps.convResidualPlain(a, work, xOff, xN, xC, xH, xW, wOff, bOff, yOff, yC, yH, yW, rOff, kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group, doRelu, dev); return; }
                if (doRelu == 1) { GpuInferOps.convReluPlain(a, work, xOff, xN, xC, xH, xW, wOff, bOff, yOff, yC, yH, yW, kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group, dev); return; }
                GpuInferOps.convPlain(a, work, xOff, xN, xC, xH, xW, wOff, bOff, yOff, yC, yH, yW, kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group, dev);
                return;
            }
            int TM = 32; int TN = 32; int BK = 32;
            int mT = (yC + TM - 1) / TM;
            int nT = (N + TN - 1) / TN;
            int nTiles = mT * nT;
            int nKB = (K + BK - 1) / BK;
            @gpu tile (float[6144] smem) grid(nTiles) resident(a = dev) {
                long tb = kernel.bx;
                long mi = tb / long(nT);
                long ni = tb % long(nT);
                long tid = kernel.tx;
                long ti = tid / 16L;              // 16×16 线程网格 → 2×2 子 tile
                long tj = tid % 16L;
                long i0 = mi * 32L + ti * 2L;     // 输出通道起始（M 维）
                long j0 = ni * 32L + tj * 2L;     // 空间位置起始（N 维）
                float a00 = 0.0f; float a01 = 0.0f; float a10 = 0.0f; float a11 = 0.0f;
                if (bOff >= 0 && i0 < long(yC)) {
                    float bv = a[bOff + i0];
                    a00 = bv; a01 = bv;
                    if (i0 + 1L < long(yC)) { float bv2 = a[bOff + i0 + 1L]; a10 = bv2; a11 = bv2; }
                }
                int kb = 0;
                while (kb < nKB) {
                    // 载 W tile [32×32] → smem[0,1024)
                    long rr = tid;
                    while (rr < 1024L) {
                        long wi = rr / 32L;         // M 维（0..31）
                        long wk = rr % 32L;         // K 维（0..31）
                        float wv = 0.0f;
                        long gi = mi * 32L + wi;    // 全局输出通道
                        long gk = long(kb) * 32L + wk;   // 全局归约索引（K=cpg*kh*kw）
                        // 权重布局 w[oc, cIn, ky, kx]（oc=gi，cIn/ky/kx 由 gk 分解）
                        // = wOff + gi*K + gk（K=cpg*kh*kw，W 行连续）
                        if (gi < long(yC) && gk < long(K))
                            wv = a[wOff + gi * long(K) + gk];
                        smem[rr] = wv;
                        rr = rr + 256L;
                    }
                    // 载 im2col X tile [32×32] → smem[1024,2048)
                    rr = tid;
                    while (rr < 1024L) {
                        long xk = rr / 32L;         // K 维（0..31）
                        long xj = rr % 32L;         // N 维（0..31）
                        float xv = 0.0f;
                        long gk2 = long(kb) * 32L + xk;   // 全局归约索引
                        long gj = ni * 32L + xj;          // 全局空间位置
                        if (gk2 < long(K) && gj < long(N)) {
                            long cIdx = gk2 / (long(kh) * long(kw));
                            long remK = gk2 % (long(kh) * long(kw));
                            long ky = remK / long(kw);
                            long kx = remK % long(kw);
                            // 空间位置 gj → (n, oy, ox)
                            long nn = gj / (long(yH) * long(yW));
                            long remP = gj % (long(yH) * long(yW));
                            long oy = remP / long(yW);
                            long ox = remP % long(yW);
                            long iy = oy * long(sh) - long(pt) + ky * long(dh);
                            long ix = ox * long(sw) - long(pl) + kx * long(dw);
                            if (iy >= 0L && iy < long(xH) && ix >= 0L && ix < long(xW)) {
                                xv = a[xOff + nn * long(xC) * long(xH) * long(xW)
                                          + cIdx * long(xH) * long(xW) + iy * long(xW) + ix];
                            }
                        }
                        smem[1024L + rr] = xv;
                        rr = rr + 256L;
                    }
                    kernel.sync();
                    long k = 0L;
                    while (k < 32L) {
                        float w0 = smem[(ti * 2L) * 32L + k];
                        float w1 = smem[(ti * 2L + 1L) * 32L + k];
                        float x0 = smem[1024L + k * 32L + tj * 2L];
                        float x1 = smem[1024L + k * 32L + tj * 2L + 1L];
                        a00 = a00 + w0 * x0;
                        a01 = a01 + w0 * x1;
                        a10 = a10 + w1 * x0;
                        a11 = a11 + w1 * x1;
                        k = k + 1L;
                    }
                    kernel.sync();
                    kb = kb + 1;
                }
                // 写 2×2 输出（NCHW 布局 [N,yC,yH,yW]：p = nn*yC*yH*yW + oc*yH*yW + oy*yW + ox）。
                // GEMM 的 N 维 = 空间位置 gj = nn*yH*yW + oy*yW + ox（含 batch 偏移），
                // 输出内偏移需把 gj 分解回 (nn, oy, ox) 再加 oc 平面偏移。
                long HW = long(yH) * long(yW);
                // i0 行（oc=i0），j0/j0+1 两列（gj）
                if (i0 < long(yC)) {
                    long ocA = i0;
                    long nnA = j0 / HW;
                    long remA = j0 % HW;
                    long oA = nnA * long(yC) * HW + ocA * HW + remA;
                    float v = a00;
                    if (rOff >= 0) v = v + a[rOff + oA];
                    if (doRelu == 1 && v < 0.0f) v = 0.0f;
                    if (j0 < long(N)) a[yOff + oA] = v;
                    if (j0 + 1L < long(N)) {
                        long oB = (j0 + 1L) / HW * long(yC) * HW + ocA * HW + (j0 + 1L) % HW;
                        float v2 = a01;
                        if (rOff >= 0) v2 = v2 + a[rOff + oB];
                        if (doRelu == 1 && v2 < 0.0f) v2 = 0.0f;
                        a[yOff + oB] = v2;
                    }
                }
                if (i0 + 1L < long(yC)) {
                    long ocB2 = i0 + 1L;
                    long nnB = j0 / HW;
                    long remB = j0 % HW;
                    long oC = nnB * long(yC) * HW + ocB2 * HW + remB;
                    float v3 = a10;
                    if (rOff >= 0) v3 = v3 + a[rOff + oC];
                    if (doRelu == 1 && v3 < 0.0f) v3 = 0.0f;
                    if (j0 < long(N)) a[yOff + oC] = v3;
                    if (j0 + 1L < long(N)) {
                        long oD = (j0 + 1L) / HW * long(yC) * HW + ocB2 * HW + (j0 + 1L) % HW;
                        float v4 = a11;
                        if (rOff >= 0) v4 = v4 + a[rOff + oD];
                        if (doRelu == 1 && v4 < 0.0f) v4 = 0.0f;
                        a[yOff + oD] = v4;
                    }
                }
            }
        }

        // ---- 2D 卷积入口（P5：优先 tiled，不满足回退 thread-per-output）----
        void conv(float[] a, int work,
                  int xOff, int xN, int xC, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yH, int yW,
                  int kh, int kw,
                  int sh, int sw, int pt, int pb, int pl, int pr,
                  int dh, int dw, int group, long dev) {
            GpuInferOps.conv2dTiled(a, work, xOff, xN, xC, xH, xW, wOff, bOff, yOff, yC, yH, yW, -1, kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group, 0, dev);
        }

        // G5：Conv 1x1 专用（opKind 83）——纯 GEMM，thread-per-output-pixel × 通道归约。
        void conv1x1(float[] a, int work,
                  int xOff, int xN, int xC, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yH, int yW,
                  int doRelu, long dev) {
            @gpu for (long p = 0L; p < long(yH * yW); p = p + 1L) resident(a = dev) {
                if (p < long(yH * yW)) {
                    long pxy = p;
                    long n = 0L;
                    while (n < long(xN)) {
                        long oy = pxy / long(yW);
                        long ox = pxy % long(yW);
                        long oc = 0L;
                        while (oc < long(yC)) {
                            float sum = 0.0f;
                            if (bOff >= 0) sum = a[bOff + oc];
                            long ic = 0L;
                            while (ic < long(xC)) {
                                float xv = a[xOff + n * long(xC * xH * xW) + ic * long(xH * xW) + oy * long(xW) + ox];
                                float wv = a[wOff + oc * long(xC) + ic];
                                sum = sum + xv * wv;
                                ic = ic + 1L;
                            }
                            if (doRelu == 1 && sum < 0.0f) sum = 0.0f;
                            a[yOff + n * long(yC * yH * yW) + oc * long(yH * yW) + oy * long(yW) + ox] = sum;
                            oc = oc + 1L;
                        }
                        n = n + 1L;
                    }
                }
            }
        }

        void convRelu(float[] a, int work,
                  int xOff, int xN, int xC, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yH, int yW,
                  int kh, int kw,
                  int sh, int sw, int pt, int pb, int pl, int pr,
                  int dh, int dw, int group, long dev) {
            GpuInferOps.conv2dTiled(a, work, xOff, xN, xC, xH, xW, wOff, bOff, yOff, yC, yH, yW, -1, kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group, 1, dev);
        }

        void convResidual(float[] a, int work,
                  int xOff, int xN, int xC, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yH, int yW,
                  int rOff,
                  int kh, int kw,
                  int sh, int sw, int pt, int pb, int pl, int pr,
                  int dh, int dw, int group, int doRelu, long dev) {
            GpuInferOps.conv2dTiled(a, work, xOff, xN, xC, xH, xW, wOff, bOff, yOff, yC, yH, yW, rOff, kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group, doRelu, dev);
        }

        // ---- 训练：反向内核（阶段3d，GPU；thread-per-gradient-element + 内层归约，无原子）----

        // 反向 dense：db[o]=Σb dY[o,b]；dW[o,i]=Σb dY[o,b]·x[i,b]；dX[i,b]=Σo dY[o,b]·W[o,i]
        void bwdDense(float[] a, long dev,
                      int dyOff, int xOff, int inDim, int batch, int wOff, int outDim,
                      int dxOff, int dwOff, int dbOff) {
            if (dbOff >= 0) {   // 无偏置层 dbOff=-1 → 跳过 db 归约
                @gpu for (long p = 0L; p < long(outDim); p = p + 1L) resident(a = dev) {
                    if (p < long(outDim)) {
                        long o = p;
                        float s = 0.0f;
                        long k = 0L;
                        while (k < long(batch)) { s = s + a[dyOff + o * long(batch) + k]; k = k + 1L; }
                        a[dbOff + o] = s;
                    }
                }
            }
            @gpu for (long p = 0L; p < long(outDim) * long(inDim); p = p + 1L) resident(a = dev) {
                if (p < long(outDim) * long(inDim)) {
                    long o = p / long(inDim);
                    long i = p % long(inDim);
                    float s = 0.0f;
                    long k = 0L;
                    while (k < long(batch)) { s = s + a[dyOff + o * long(batch) + k] * a[xOff + i * long(batch) + k]; k = k + 1L; }
                    a[dwOff + o * long(inDim) + i] = s;
                }
            }
            @gpu for (long p = 0L; p < long(inDim) * long(batch); p = p + 1L) resident(a = dev) {
                if (p < long(inDim) * long(batch)) {
                    long i = p / long(batch);
                    long k = p % long(batch);
                    float s = 0.0f;
                    long o = 0L;
                    while (o < long(outDim)) { s = s + a[dyOff + o * long(batch) + k] * a[wOff + o * long(inDim) + i]; o = o + 1L; }
                    a[dxOff + i * long(batch) + k] = s;
                }
            }
        }

        void bwdRelu(float[] a, long dev, int dyOff, int xOff, int dxOff, int n) {
            @gpu for (long p = 0L; p < long(n); p = p + 1L) resident(a = dev) {
                if (p < long(n)) {
                    long i = p;
                    float xv = a[xOff + i];
                    if (xv > 0.0f) a[dxOff + i] = a[dyOff + i];
                    else a[dxOff + i] = 0.0f;
                }
            }
        }

        void bwdSigmoid(float[] a, long dev, int dyOff, int yOff, int dxOff, int n) {
            @gpu for (long p = 0L; p < long(n); p = p + 1L) resident(a = dev) {
                if (p < long(n)) {
                    long i = p;
                    float y = a[yOff + i];
                    a[dxOff + i] = a[dyOff + i] * y * (1.0f - y);
                }
            }
        }

        void bwdTanh(float[] a, long dev, int dyOff, int yOff, int dxOff, int n) {
            @gpu for (long p = 0L; p < long(n); p = p + 1L) resident(a = dev) {
                if (p < long(n)) {
                    long i = p;
                    float y = a[yOff + i];
                    a[dxOff + i] = a[dyOff + i] * (1.0f - y * y);
                }
            }
        }

        void bwdAdd(float[] a, long dev, int dyOff, int daOff, int dbOff, int n) {
            @gpu for (long p = 0L; p < long(n); p = p + 1L) resident(a = dev) {
                if (p < long(n)) {
                    long i = p;
                    float d = a[dyOff + i];
                    a[daOff + i] = d;
                    a[dbOff + i] = d;
                }
            }
        }

        // Softmax+CE 合并：thread-per-column；dlogit = softmax - onehot；loss = -log(p[label])
        void softmaxCE(float[] a, long dev, int logitOff, int labelOff, int rows, int cols,
                       int dlogitOff, int lossOff) {
            @gpu for (long p = 0L; p < long(cols); p = p + 1L) resident(a = dev) {
                if (p < long(cols)) {
                    long b = p;
                    float maxv = a[logitOff + 0L * long(cols) + b];
                    long r = 1L;
                    while (r < long(rows)) {
                        float v = a[logitOff + r * long(cols) + b];
                        if (v > maxv) maxv = v;
                        r = r + 1L;
                    }
                    float sum = 0.0f;
                    r = 0L;
                    while (r < long(rows)) {
                        float e = Math.exp(a[logitOff + r * long(cols) + b] - maxv);
                        a[dlogitOff + r * long(cols) + b] = e;
                        sum = sum + e;
                        r = r + 1L;
                    }
                    float lossb = 0.0f;
                    r = 0L;
                    while (r < long(rows)) {
                        float pv = a[dlogitOff + r * long(cols) + b] / sum;
                        a[dlogitOff + r * long(cols) + b] = pv - a[labelOff + r * long(cols) + b];
                        if (a[labelOff + r * long(cols) + b] > 0.5f) {
                            lossb = 0.0f - Math.log(pv);
                        }
                        r = r + 1L;
                    }
                    a[lossOff + b] = lossb;
                }
            }
        }

        // Dice loss（阶段4d，GPU，thread-per-class）：pOff=prob[C,N], yOff=label[C,N]
        // → dpOff=dProb[C,N], lossOff。每类一个线程串行统计 sumP/sumY/sumPY，
        // 写 dp；loss 由独立单线程 kernel 重算汇总（跨线程无 barrier，不能在同一
        // kernel 内由 thread0 读其他线程的 sum）。
        void diceLoss(float[] a, long dev, int stOff, int pOff, int yOff, int dpOff, int lossOff,
                      int rows, int cols, int wMode) {
            if (wMode == 1) {
                // 归一化逆频率（stOff 为 stats 区）：K1 每类 w_c→stOff+c；K2 单线程
                // W=Σ→stOff+rows；K3 每类梯度(wc=w_c/W)+写 loss 项 stOff+rows+1+c；
                // K4 单线程 loss=1-Σ项。eps=1e-5（B 平滑）。
                @gpu for (long p = 0L; p < long(rows); p = p + 1L) resident(a = dev) {
                    if (p < long(rows)) {
                        long c = p;
                        double freq = 0.0;
                        long s = 0L;
                        while (s < long(cols)) { freq = freq + double(a[yOff + c * long(cols) + s]); s = s + 1L; }
                        freq = freq / double(cols);
                        a[stOff + c] = float(1.0 / (freq + 0.001));
                    }
                }
                @gpu for (long p = 0L; p < 1L; p = p + 1L) resident(a = dev) {
                    double W = 0.0;
                    long c = 0L;
                    while (c < long(rows)) { W = W + double(a[stOff + c]); c = c + 1L; }
                    a[stOff + long(rows)] = float(W);
                }
                @gpu for (long p = 0L; p < long(rows); p = p + 1L) resident(a = dev) {
                    if (p < long(rows)) {
                        long c = p;
                        double wc = double(a[stOff + c]) / double(a[stOff + long(rows)]);
                        double sumP = 0.0;
                        double sumY = 0.0;
                        double sumPY = 0.0;
                        long s = 0L;
                        while (s < long(cols)) {
                            double pv = double(a[pOff + c * long(cols) + s]);
                            double yv = double(a[yOff + c * long(cols) + s]);
                            sumP = sumP + pv;
                            sumY = sumY + yv;
                            sumPY = sumPY + pv * yv;
                            s = s + 1L;
                        }
                        double B = sumP + sumY + 1.0e-5;
                        double denom = wc * 2.0 / (B * B);
                        s = 0L;
                        while (s < long(cols)) {
                            double yv = double(a[yOff + c * long(cols) + s]);
                            a[dpOff + c * long(cols) + s] = float(0.0 - denom * (yv * B - sumPY));
                            s = s + 1L;
                        }
                        a[stOff + long(rows) + 1L + c] = float(wc * 2.0 * sumPY / B);
                    }
                }
                @gpu for (long p = 0L; p < 1L; p = p + 1L) resident(a = dev) {
                    double sumLoss = 0.0;
                    long c = 0L;
                    while (c < long(rows)) { sumLoss = sumLoss + double(a[stOff + long(rows) + 1L + c]); c = c + 1L; }
                    a[lossOff] = float(1.0 - sumLoss);
                }
            } else {
                // 等权（wc=1/rows）：原 2-kernel 逻辑，eps=1e-5
                @gpu for (long p = 0L; p < long(rows); p = p + 1L) resident(a = dev) {
                    if (p < long(rows)) {
                        long c = p;
                        double sumP = 0.0;
                        double sumY = 0.0;
                        double sumPY = 0.0;
                        long s = 0L;
                        while (s < long(cols)) {
                            double pv = double(a[pOff + c * long(cols) + s]);
                            double yv = double(a[yOff + c * long(cols) + s]);
                            sumP = sumP + pv;
                            sumY = sumY + yv;
                            sumPY = sumPY + pv * yv;
                            s = s + 1L;
                        }
                        double B = sumP + sumY + 1.0e-5;
                        double denom = 2.0 / double(rows) / (B * B);
                        s = 0L;
                        while (s < long(cols)) {
                            double yv = double(a[yOff + c * long(cols) + s]);
                            a[dpOff + c * long(cols) + s] = float(0.0 - denom * (yv * B - sumPY));
                            s = s + 1L;
                        }
                    }
                }
                @gpu for (long p = 0L; p < 1L; p = p + 1L) resident(a = dev) {
                    double sumLoss = 0.0;
                    long c = 0L;
                    while (c < long(rows)) {
                        double sumP = 0.0;
                        double sumY = 0.0;
                        double sumPY = 0.0;
                        long s = 0L;
                        while (s < long(cols)) {
                            double pv = double(a[pOff + c * long(cols) + s]);
                            double yv = double(a[yOff + c * long(cols) + s]);
                            sumP = sumP + pv;
                            sumY = sumY + yv;
                            sumPY = sumPY + pv * yv;
                            s = s + 1L;
                        }
                        double B = sumP + sumY + 1.0e-5;
                        sumLoss = sumLoss + 2.0 * sumPY / B;
                        c = c + 1L;
                    }
                    a[lossOff] = float(1.0 - sumLoss / double(rows));
                }
            }
        }

        // P4：ArgMax over 1D flat（n 元素）→ out[0]=float(index)。单线程串行扫描（p<1）。
        void argmax(float[] a, long dev, int inOff, int outOff, int n) {
            @gpu for (long p = 0L; p < 1L; p = p + 1L) resident(a = dev) {
                if (p < 1L) {
                    int bi = 0;
                    double bv = double(a[inOff + 0]);
                    int i = 1;
                    while (i < n) {
                        double v = double(a[inOff + i]);
                        if (v > bv) { bv = v; bi = i; }
                        i = i + 1;
                    }
                    a[outOff] = float(double(bi));
                }
            }
        }

        // P4：ArgMin（同上取最小）
        void argmin(float[] a, long dev, int inOff, int outOff, int n) {
            @gpu for (long p = 0L; p < 1L; p = p + 1L) resident(a = dev) {
                if (p < 1L) {
                    int bi = 0;
                    double bv = double(a[inOff + 0]);
                    int i = 1;
                    while (i < n) {
                        double v = double(a[inOff + i]);
                        if (v < bv) { bv = v; bi = i; }
                        i = i + 1;
                    }
                    a[outOff] = float(double(bi));
                }
            }
        }

        // P4：TopK over 1D flat：前 k 大降序 values[0..k)@valOff、indices(float)@idxOff。
        // 单线程串行重复选择（O(k²·n)；k 小）。并列按下标小者先。
        void topk(float[] a, long dev, int inOff, int valOff, int idxOff, int n, int k) {
            @gpu for (long p = 0L; p < 1L; p = p + 1L) resident(a = dev) {
                if (p < 1L) {
                    if (k > n) k = n;
                    int rank = 0;
                    while (rank < k) {
                        int bi = -1;
                        double bv = 0.0;
                        int i = 0;
                        while (i < n) {
                            int taken = 0;
                            int j = 0;
                            while (j < rank) {
                                if (double(a[idxOff + j]) == double(i)) { taken = 1; j = rank; }
                                j = j + 1;
                            }
                            if (taken == 0) {
                                double v = double(a[inOff + i]);
                                if (bi < 0 || v > bv) { bv = v; bi = i; }
                            }
                            i = i + 1;
                        }
                        if (bi < 0) { a[idxOff + rank] = float(double(0)); a[valOff + rank] = 0.0f; }
                        else { a[idxOff + rank] = float(double(bi)); a[valOff + rank] = float(bv); }
                        rank = rank + 1;
                    }
                }
            }
        }

        // P6：OneHot。idxOff:[nIdx] → outOff:[nIdx*depth] 行优先；thread-per-output。
        void oneHot(float[] a, long dev, int idxOff, int outOff, int nIdx, int depth) {
            @gpu for (long p = 0L; p < long(nIdx) * long(depth); p = p + 1L) resident(a = dev) {
                if (p < long(nIdx) * long(depth)) {
                    int i = int(p / long(depth));
                    int c = int(p % long(depth));
                    int ix = int(double(a[idxOff + i]));
                    if (ix < 0) ix = 0;
                    if (ix >= depth) ix = depth - 1;
                    if (c == ix) a[outOff + i * depth + c] = 1.0f;
                    else a[outOff + i * depth + c] = 0.0f;
                }
            }
        }

        // P8：GatherElements（GPU）。thread-per-out；与 CPU 同索引/钳制。
        void gatherElements(float[] a, long dev, int dOff, int iOff, int oOff, int total,
                            int axis, int inner, int dataAxisDim, int outAxisDim) {
            @gpu for (long p = 0L; p < long(total); p = p + 1L) resident(a = dev) {
                if (p < long(total)) {
                    int i = int(p);
                    int q = i % inner;
                    int pp = i / inner;
                    int ax = pp % outAxisDim;
                    int outer = pp / outAxisDim;
                    int ix = int(double(a[iOff + i]));
                    if (ix < 0) ix = ix + dataAxisDim;
                    if (ix < 0) ix = 0;
                    if (ix >= dataAxisDim) ix = dataAxisDim - 1;
                    a[oOff + i] = a[dOff + (outer * dataAxisDim + ix) * inner + q];
                }
            }
        }

        // P8：ScatterND（GPU）。thread-per-(update-row, block-elem)；块长 block 各更新行
        // 相同（= data 维 k.. 乘积），主机侧预计算。重复前缀 = 未定义（唯一前缀常用）。
        void scatterND(float[] a, long dev, int dOff, int iOff, int uOff, int oOff,
                       int q, int k, int d0, int d1, int d2, int d3, int d4) {
            int total = d0 * d1 * d2 * d3 * d4;
            @gpu for (long p = 0L; p < long(total); p = p + 1L) resident(a = dev) {
                if (p < long(total)) { a[oOff + int(p)] = a[dOff + int(p)]; }   // data 副本
            }
            int block = total;
            int jb = 0;
            while (jb < k) {
                int dbj = (jb == 0) ? d0 : ((jb == 1) ? d1 : ((jb == 2) ? d2 : ((jb == 3) ? d3 : d4)));
                block = block / dbj;
                jb = jb + 1;
            }
            @gpu for (long p = 0L; p < long(q) * long(block); p = p + 1L) resident(a = dev) {
                if (p < long(q) * long(block)) {
                    long uu = p / long(block);
                    long e = p % long(block);
                    int base = 0;
                    int R = total;
                    int j = 0;
                    while (j < k) {
                        int dj = (j == 0) ? d0 : ((j == 1) ? d1 : ((j == 2) ? d2 : ((j == 3) ? d3 : d4)));
                        R = R / dj;
                        int cj = int(double(a[iOff + int(uu) * k + j]));
                        if (cj < 0) cj = cj + dj;
                        if (cj < 0) cj = 0;
                        if (cj >= dj) cj = dj - 1;
                        base = base + cj * R;
                        j = j + 1;
                    }
                    a[oOff + base + int(e)] = a[uOff + int(uu) * block + int(e)];
                }
            }
        }

        // Softmax 反向（阶段4d，GPU，thread-per-column）：dlogit[i] = p[i]·(dp[i] - Σ_j p[j]·dp[j])
        void bwdSoftmax(float[] a, long dev, int probOff, int dprobOff, int dlogitOff, int rows, int cols) {
            @gpu for (long p = 0L; p < long(cols); p = p + 1L) resident(a = dev) {
                if (p < long(cols)) {
                    long b = p;
                    double inner = 0.0;
                    long r = 0L;
                    while (r < long(rows)) {
                        inner = inner + double(a[probOff + r * long(cols) + b]) * double(a[dprobOff + r * long(cols) + b]);
                        r = r + 1L;
                    }
                    r = 0L;
                    while (r < long(rows)) {
                        double pv = double(a[probOff + r * long(cols) + b]);
                        double dpv = double(a[dprobOff + r * long(cols) + b]);
                        a[dlogitOff + r * long(cols) + b] = float(pv * (dpv - inner));
                        r = r + 1L;
                    }
                }
            }
        }

        // SGD 更新：W -= lr·grad（lr 位型存于调用方，经 long 传）
        // ---- 优化器（阶段5e，GPU）：SGD / 动量 / AdamW（与 CPU 同公式）----
        void updateSGD(float[] a, long dev, int wOff, int gradOff, int n, double lr, double decay) {
            @gpu for (long p = 0L; p < long(n); p = p + 1L) resident(a = dev) {
                if (p < long(n)) {
                    long i = p;
                    a[wOff + i] = a[wOff + i] - float(decay) * a[wOff + i] - float(lr) * a[gradOff + i];
                }
            }
        }
        void updateMom(float[] a, long dev, int wOff, int gradOff, int vOff, int n, double lr, double decay) {
            @gpu for (long p = 0L; p < long(n); p = p + 1L) resident(a = dev) {
                if (p < long(n)) {
                    long i = p;
                    float g = a[gradOff + i];
                    float v = a[vOff + i];
                    float vn = 0.9f * v + g;
                    a[vOff + i] = vn;
                    a[wOff + i] = a[wOff + i] - float(decay) * a[wOff + i] - float(lr) * vn;
                }
            }
        }
        void updateAdamW(float[] a, long dev, int wOff, int gradOff, int mOff, int n, double lr, double decay,
                         double bc1, double bc2) {
            double eps = 1.0e-8;
            @gpu for (long p = 0L; p < long(n); p = p + 1L) resident(a = dev) {
                if (p < long(n)) {
                    long i = p;
                    float g = a[gradOff + i];
                    float m = a[mOff + i];
                    float v = a[mOff + long(n) + i];
                    float mn = 0.9f * m + 0.1f * g;
                    float vn = 0.999f * v + 0.001f * g * g;
                    a[mOff + i] = mn;
                    a[mOff + long(n) + i] = vn;
                    double mhat = double(mn) / bc1;
                    double vhat = double(vn) / bc2;
                    double w = double(a[wOff + i]);
                    a[wOff + i] = float(w - double(lr) * mhat / (Math.sqrt(vhat) + eps) - double(decay) * w);
                }
            }
        }

        // 反向 conv：db[oc]=ΣdY；dW[oc,ic,ky,kx]=Σ dY·x；dX[n,cIn,iy,ix]=Σ dY·w
        // 三个 @gpu for，thread-per-gradient-element + 内层串行归约（无原子）。
        void bwdConv(float[] a, long dev,
                     int dyOff, int xOff, int xN, int xC, int xH, int xW,
                     int wOff, int dxOff, int dwOff, int dbOff,
                     int yC, int yH, int yW,
                     int kh, int kw, int sh, int sw, int pt, int pl,
                     int dh, int dw, int group) {
            int cpg = xC / group;
            int ocpg = yC / group;
            int wc = cpg * kh * kw;
            // db[oc]
            if (dbOff >= 0) {
                @gpu for (long p = 0L; p < long(yC); p = p + 1L) resident(a = dev) {
                    if (p < long(yC)) {
                        long oc = p;
                        float s = 0.0f;
                        long n = 0L;
                        while (n < long(xN)) {
                            long oy = 0L;
                            while (oy < long(yH)) {
                                long ox = 0L;
                                while (ox < long(yW)) {
                                    s = s + a[dyOff + n * long(yC) * long(yH) * long(yW) + oc * long(yH) * long(yW) + oy * long(yW) + ox];
                                    ox = ox + 1L;
                                }
                                oy = oy + 1L;
                            }
                            n = n + 1L;
                        }
                        a[dbOff + oc] = s;
                    }
                }
            }
            // dW[oc,ic,ky,kx]
            @gpu for (long p = 0L; p < long(yC) * long(wc); p = p + 1L) resident(a = dev) {
                if (p < long(yC) * long(wc)) {
                    long oc = p / long(wc);
                    long rr = p % long(wc);
                    long ic = rr / long(kh * kw);
                    long ky = (rr % long(kh * kw)) / long(kw);
                    long kx = rr % long(kw);
                    long g = oc / long(ocpg);
                    long cIn = g * long(cpg) + ic;
                    float s = 0.0f;
                    long n = 0L;
                    while (n < long(xN)) {
                        long oy = 0L;
                        while (oy < long(yH)) {
                            long iy = oy * long(sh) - long(pt) + ky * long(dh);
                            if (iy >= 0L && iy < long(xH)) {
                                long ox = 0L;
                                while (ox < long(yW)) {
                                    long ix = ox * long(sw) - long(pl) + kx * long(dw);
                                    if (ix >= 0L && ix < long(xW)) {
                                        s = s + a[dyOff + n * long(yC) * long(yH) * long(yW) + oc * long(yH) * long(yW) + oy * long(yW) + ox]
                                                 * a[xOff + n * long(xC) * long(xH) * long(xW) + cIn * long(xH) * long(xW) + iy * long(xW) + ix];
                                    }
                                    ox = ox + 1L;
                                }
                            }
                            oy = oy + 1L;
                        }
                        n = n + 1L;
                    }
                    a[dwOff + p] = s;
                }
            }
            // dX[n,cIn,iy,ix]
            @gpu for (long p = 0L; p < long(xN) * long(xC) * long(xH) * long(xW); p = p + 1L) resident(a = dev) {
                if (p < long(xN) * long(xC) * long(xH) * long(xW)) {
                    long xS = long(xC) * long(xH) * long(xW);
                    long nn = p / xS;
                    long rem = p % xS;
                    long cIn = rem / long(xH * xW);
                    long iy = (rem % long(xH * xW)) / long(xW);
                    long ix = rem % long(xW);
                    long g = cIn / long(cpg);
                    long ic = cIn % long(cpg);
                    float s = 0.0f;
                    long oc0 = g * long(ocpg);
                    long oc = 0L;
                    while (oc < long(ocpg)) {
                        long ocabs = oc0 + oc;
                        long ky = 0L;
                        while (ky < long(kh)) {
                            long num = iy + long(pt) - ky * long(dh);
                            if (num >= 0L && num % long(sh) == 0L) {
                                long oy = num / long(sh);
                                if (oy >= 0L && oy < long(yH)) {
                                    long kx = 0L;
                                    while (kx < long(kw)) {
                                        long wnum = ix + long(pl) - kx * long(dw);
                                        if (wnum >= 0L && wnum % long(sw) == 0L) {
                                            long ox = wnum / long(sw);
                                            if (ox >= 0L && ox < long(yW)) {
                                                s = s + a[dyOff + nn * long(yC) * long(yH) * long(yW) + ocabs * long(yH) * long(yW) + oy * long(yW) + ox]
                                                         * a[wOff + ocabs * long(wc) + ic * long(kh * kw) + ky * long(kw) + kx];
                                            }
                                        }
                                        kx = kx + 1L;
                                    }
                                }
                            }
                            ky = ky + 1L;
                        }
                        oc = oc + 1L;
                    }
                    a[dxOff + p] = s;
                }
            }
        }

        // 反向 maxpool：thread-per-output，重算 argmax 并路由 dY（假定 stride≥kernel 无重叠）
        void bwdMaxPool(float[] a, long dev,
                        int dyOff, int xOff, int xN, int xC, int xH, int xW,
                        int dxOff, int yH, int yW,
                        int kh, int kw, int sh, int sw, int pt, int pl) {
            @gpu for (long p = 0L; p < long(xN) * long(xC) * long(yH) * long(yW); p = p + 1L) resident(a = dev) {
                if (p < long(xN) * long(xC) * long(yH) * long(yW)) {
                    long yS = long(yH) * long(yW);
                    long nn = p / (long(xC) * yS);
                    long cc = (p / yS) % long(xC);
                    long oy = (p % yS) / long(yW);
                    long ox = p % long(yW);
                    float best = 0.0f - 1.0e30f;
                    long biy = 0L;
                    long bix = 0L;
                    long ky = 0L;
                    while (ky < long(kh)) {
                        long iy = oy * long(sh) - long(pt) + ky;
                        if (iy >= 0L && iy < long(xH)) {
                            long kx = 0L;
                            while (kx < long(kw)) {
                                long ix = ox * long(sw) - long(pl) + kx;
                                if (ix >= 0L && ix < long(xW)) {
                                    float v = a[xOff + nn * long(xC) * long(xH) * long(xW) + cc * long(xH) * long(xW) + iy * long(xW) + ix];
                                    if (v > best) { best = v; biy = iy; bix = ix; }
                                }
                                kx = kx + 1L;
                            }
                        }
                        ky = ky + 1L;
                    }
                    float dy = a[dyOff + p];
                    a[dxOff + nn * long(xC) * long(xH) * long(xW) + cc * long(xH) * long(xW) + biy * long(xW) + bix] = dy;
                }
            }
        }

        // 反向：y = convTranspose(x, W)（group=1，权重 W[Cin,Cout,kh,kw]）。db/dW/dX
        // 三内核，thread-per-元素全和赋值（无原子、无需清零）。索引与 CPU ops.myp 一致。
        void bwdConvTranspose(float[] a, long dev,
                              int dyOff, int xOff, int xN, int xC, int xH, int xW,
                              int wOff, int dxOff, int dwOff, int dbOff,
                              int yC, int yH, int yW,
                              int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr) {
            // db[co] = Σ dy
            if (dbOff >= 0) {
                @gpu for (long p = 0L; p < long(yC); p = p + 1L) resident(a = dev) {
                    if (p < long(yC)) {
                        float s = 0.0f;
                        long n = 0L;
                        while (n < long(xN)) {
                            long oy = 0L;
                            while (oy < long(yH)) {
                                long ox = 0L;
                                while (ox < long(yW)) {
                                    s = s + a[dyOff + n * long(yC) * long(yH) * long(yW) + p * long(yH) * long(yW) + oy * long(yW) + ox];
                                    ox = ox + 1L;
                                }
                                oy = oy + 1L;
                            }
                            n = n + 1L;
                        }
                        a[dbOff + p] = s;
                    }
                }
            }
            // dW[ci,co,ky,kx]（权重布局 [ci,co,ky,kx]，ci 步长 yC*kh*kw）
            long wc = long(yC) * long(kh) * long(kw);
            long nW = long(xC) * wc;
            @gpu for (long p = 0L; p < nW; p = p + 1L) resident(a = dev) {
                if (p < nW) {
                    long ci = p / wc;
                    long rem = p % wc;
                    long co = rem / long(kh * kw);
                    long ky = (rem % long(kh * kw)) / long(kw);
                    long kx = rem % long(kw);
                    float s = 0.0f;
                    long n = 0L;
                    while (n < long(xN)) {
                        long oy = 0L;
                        while (oy < long(yH)) {
                            long inum = oy + long(pt) - ky;
                            if (inum >= 0L && inum % long(sh) == 0L) {
                                long ih = inum / long(sh);
                                if (ih >= 0L && ih < long(xH)) {
                                    long ox = 0L;
                                    while (ox < long(yW)) {
                                        long wnum = ox + long(pl) - kx;
                                        if (wnum >= 0L && wnum % long(sw) == 0L) {
                                            long iw = wnum / long(sw);
                                            if (iw >= 0L && iw < long(xW)) {
                                                s = s + a[dyOff + n * long(yC) * long(yH) * long(yW) + co * long(yH) * long(yW) + oy * long(yW) + ox]
                                                         * a[xOff + n * long(xC) * long(xH) * long(xW) + ci * long(xH) * long(xW) + ih * long(xW) + iw];
                                            }
                                        }
                                        ox = ox + 1L;
                                    }
                                }
                            }
                            oy = oy + 1L;
                        }
                        n = n + 1L;
                    }
                    a[dwOff + p] = s;
                }
            }
            // dX[n,ci,ih,iw]
            @gpu for (long p = 0L; p < long(xN) * long(xC) * long(xH) * long(xW); p = p + 1L) resident(a = dev) {
                if (p < long(xN) * long(xC) * long(xH) * long(xW)) {
                    long xs = long(xC) * long(xH) * long(xW);
                    long nn = p / xs;
                    long rem = p % xs;
                    long ci = rem / long(xH * xW);
                    long ih = (rem % long(xH * xW)) / long(xW);
                    long iw = rem % long(xW);
                    float s = 0.0f;
                    long co = 0L;
                    while (co < long(yC)) {
                        long ky = 0L;
                        while (ky < long(kh)) {
                            long oh = ih * long(sh) - long(pt) + ky;
                            if (oh >= 0L && oh < long(yH)) {
                                long kx = 0L;
                                while (kx < long(kw)) {
                                    long ow = iw * long(sw) - long(pl) + kx;
                                    if (ow >= 0L && ow < long(yW)) {
                                        s = s + a[wOff + (ci * long(yC) + co) * long(kh) * long(kw) + ky * long(kw) + kx]
                                                 * a[dyOff + nn * long(yC) * long(yH) * long(yW) + co * long(yH) * long(yW) + oh * long(yW) + ow];
                                    }
                                    kx = kx + 1L;
                                }
                            }
                            ky = ky + 1L;
                        }
                        co = co + 1L;
                    }
                    a[dxOff + p] = s;
                }
            }
        }

        // ---- CNN 3D 反向（阶段4b，GPU）：bwdConv3D / bwdMaxPool3D / bwdAvgPool3D ----

        // 反向：y = convTranspose3d(x,w)。db/dW/dX 三内核（thread-per-元素全和，无原子/清零）。
        void bwdConvTranspose3d(float[] a, long dev,
                                int dyOff, int xOff, int xN, int xC, int xD, int xH, int xW,
                                int wOff, int dxOff, int dwOff, int dbOff,
                                int yC, int yD, int yH, int yW,
                                int kd, int kh, int kw, int sd, int sh, int sw,
                                int pdt, int pt, int pl) {
            // db[co] = Σ dy
            if (dbOff >= 0) {
                @gpu for (long p = 0L; p < long(yC); p = p + 1L) resident(a = dev) {
                    if (p < long(yC)) {
                        float s = 0.0f;
                        long n = 0L;
                        while (n < long(xN)) {
                            long od = 0L;
                            while (od < long(yD)) {
                                long oy = 0L;
                                while (oy < long(yH)) {
                                    long ox = 0L;
                                    while (ox < long(yW)) {
                                        s = s + a[dyOff + n * long(yC) * long(yD) * long(yH) * long(yW) + p * long(yD) * long(yH) * long(yW) + od * long(yH) * long(yW) + oy * long(yW) + ox];
                                        ox = ox + 1L;
                                    }
                                    oy = oy + 1L;
                                }
                                od = od + 1L;
                            }
                            n = n + 1L;
                        }
                        a[dbOff + p] = s;
                    }
                }
            }
            // dW[ci,co,kz,ky,kx]（ci 步长 = yC*kd*kh*kw）
            long wc = long(yC) * long(kd) * long(kh) * long(kw);
            long nW = long(xC) * wc;
            @gpu for (long p = 0L; p < nW; p = p + 1L) resident(a = dev) {
                if (p < nW) {
                    long ci = p / wc;
                    long rem = p % wc;
                    long co = rem / long(kd * kh * kw);
                    long rem2 = rem % long(kd * kh * kw);
                    long kz = rem2 / long(kh * kw);
                    long ky = (rem2 % long(kh * kw)) / long(kw);
                    long kx = rem2 % long(kw);
                    float s = 0.0f;
                    long n = 0L;
                    while (n < long(xN)) {
                        long od = 0L;
                        while (od < long(yD)) {
                            long dnum = od + long(pdt) - kz;
                            if (dnum >= 0L && dnum % long(sd) == 0L) {
                                long id = dnum / long(sd);
                                if (id >= 0L && id < long(xD)) {
                                    long oy = 0L;
                                    while (oy < long(yH)) {
                                        long hnum = oy + long(pt) - ky;
                                        if (hnum >= 0L && hnum % long(sh) == 0L) {
                                            long ih = hnum / long(sh);
                                            if (ih >= 0L && ih < long(xH)) {
                                                long ox = 0L;
                                                while (ox < long(yW)) {
                                                    long wnum = ox + long(pl) - kx;
                                                    if (wnum >= 0L && wnum % long(sw) == 0L) {
                                                        long iw = wnum / long(sw);
                                                        if (iw >= 0L && iw < long(xW)) {
                                                            s = s + a[dyOff + n * long(yC) * long(yD) * long(yH) * long(yW) + co * long(yD) * long(yH) * long(yW) + od * long(yH) * long(yW) + oy * long(yW) + ox]
                                                                     * a[xOff + n * long(xC) * long(xD) * long(xH) * long(xW) + ci * long(xD) * long(xH) * long(xW) + id * long(xH) * long(xW) + ih * long(xW) + iw];
                                                        }
                                                    }
                                                    ox = ox + 1L;
                                                }
                                            }
                                        }
                                        oy = oy + 1L;
                                    }
                                }
                            }
                            od = od + 1L;
                        }
                        n = n + 1L;
                    }
                    a[dwOff + p] = s;
                }
            }
            // dX[n,ci,id,ih,iw]
            @gpu for (long p = 0L; p < long(xN) * long(xC) * long(xD) * long(xH) * long(xW); p = p + 1L) resident(a = dev) {
                if (p < long(xN) * long(xC) * long(xD) * long(xH) * long(xW)) {
                    long xs = long(xC) * long(xD) * long(xH) * long(xW);
                    long nn = p / xs;
                    long rem = p % xs;
                    long ci = rem / long(xD * xH * xW);
                    long rem2 = rem % long(xD * xH * xW);
                    long id = rem2 / long(xH * xW);
                    long ih = (rem2 % long(xH * xW)) / long(xW);
                    long iw = rem2 % long(xW);
                    float s = 0.0f;
                    long co = 0L;
                    while (co < long(yC)) {
                        long kz = 0L;
                        while (kz < long(kd)) {
                            long od = id * long(sd) - long(pdt) + kz;
                            if (od >= 0L && od < long(yD)) {
                                long ky = 0L;
                                while (ky < long(kh)) {
                                    long oh = ih * long(sh) - long(pt) + ky;
                                    if (oh >= 0L && oh < long(yH)) {
                                        long kx = 0L;
                                        while (kx < long(kw)) {
                                            long ow = iw * long(sw) - long(pl) + kx;
                                            if (ow >= 0L && ow < long(yW)) {
                                                s = s + a[wOff + (ci * long(yC) + co) * long(kd) * long(kh) * long(kw) + kz * long(kh) * long(kw) + ky * long(kw) + kx]
                                                         * a[dyOff + nn * long(yC) * long(yD) * long(yH) * long(yW) + co * long(yD) * long(yH) * long(yW) + od * long(yH) * long(yW) + oh * long(yW) + ow];
                                            }
                                            kx = kx + 1L;
                                        }
                                    }
                                    ky = ky + 1L;
                                }
                            }
                            kz = kz + 1L;
                        }
                        co = co + 1L;
                    }
                    a[dxOff + p] = s;
                }
            }
        }

        // 反向：y = conv3d(x,w,b)。db/dW/dX 三内核，thread-per-元素全和赋值（无原子、无需清零）。
        void bwdConv3D(float[] a, long dev,
                       int dyOff, int xOff, int xN, int xC, int xD, int xH, int xW,
                       int wOff, int dxOff, int dwOff, int dbOff,
                       int yC, int yD, int yH, int yW,
                       int kd, int kh, int kw,
                       int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
                       int dd, int dh, int dw, int group) {
            int cpg = xC / group;
            int ocpg = yC / group;
            int wc = cpg * kd * kh * kw;
            // db[oc] = Σ dY
            if (dbOff >= 0) {
                @gpu for (long p = 0L; p < long(yC); p = p + 1L) resident(a = dev) {
                    if (p < long(yC)) {
                        long oc = p;
                        float s = 0.0f;
                        long n = 0L;
                        while (n < long(xN)) {
                            long oz = 0L;
                            while (oz < long(yD)) {
                                long oy = 0L;
                                while (oy < long(yH)) {
                                    long ox = 0L;
                                    while (ox < long(yW)) {
                                        s = s + a[dyOff + n * long(yC) * long(yD) * long(yH) * long(yW) + oc * long(yD) * long(yH) * long(yW) + oz * long(yH) * long(yW) + oy * long(yW) + ox];
                                        ox = ox + 1L;
                                    }
                                    oy = oy + 1L;
                                }
                                oz = oz + 1L;
                            }
                            n = n + 1L;
                        }
                        a[dbOff + oc] = s;
                    }
                }
            }
            // dW[oc,ic,kz,ky,kx]
            @gpu for (long p = 0L; p < long(yC) * long(wc); p = p + 1L) resident(a = dev) {
                if (p < long(yC) * long(wc)) {
                    long oc = p / long(wc);
                    long rr = p % long(wc);
                    long ic = rr / long(kd * kh * kw);
                    long rem = rr % long(kd * kh * kw);
                    long kz = rem / long(kh * kw);
                    long ky = (rem % long(kh * kw)) / long(kw);
                    long kx = rem % long(kw);
                    long g = oc / long(ocpg);
                    long cIn = g * long(cpg) + ic;
                    float s = 0.0f;
                    long n = 0L;
                    while (n < long(xN)) {
                        long oz = 0L;
                        while (oz < long(yD)) {
                            long oy = 0L;
                            while (oy < long(yH)) {
                                long iz = oz * long(sd) - long(pdt) + kz * long(dd);
                                if (iz >= 0L && iz < long(xD)) {
                                    long iy = oy * long(sh) - long(pt) + ky * long(dh);
                                    if (iy >= 0L && iy < long(xH)) {
                                        long ox = 0L;
                                        while (ox < long(yW)) {
                                            long ix = ox * long(sw) - long(pl) + kx * long(dw);
                                            if (ix >= 0L && ix < long(xW)) {
                                                s = s + a[dyOff + n * long(yC) * long(yD) * long(yH) * long(yW) + oc * long(yD) * long(yH) * long(yW) + oz * long(yH) * long(yW) + oy * long(yW) + ox]
                                                         * a[xOff + n * long(xC) * long(xD) * long(xH) * long(xW) + cIn * long(xD) * long(xH) * long(xW) + iz * long(xH) * long(xW) + iy * long(xW) + ix];
                                            }
                                            ox = ox + 1L;
                                        }
                                    }
                                }
                                oy = oy + 1L;
                            }
                            oz = oz + 1L;
                        }
                        n = n + 1L;
                    }
                    a[dwOff + p] = s;
                }
            }
            // dX[n,cIn,iz,iy,ix]
            @gpu for (long p = 0L; p < long(xN) * long(xC) * long(xD) * long(xH) * long(xW); p = p + 1L) resident(a = dev) {
                if (p < long(xN) * long(xC) * long(xD) * long(xH) * long(xW)) {
                    long xS = long(xC) * long(xD) * long(xH) * long(xW);
                    long dS = long(xD) * long(xH) * long(xW);
                    long nn = p / xS;
                    long rem = p % xS;
                    long cIn = rem / dS;
                    long rem2 = rem % dS;
                    long iz = rem2 / long(xH * xW);
                    long iy = (rem2 % long(xH * xW)) / long(xW);
                    long ix = rem2 % long(xW);
                    long g = cIn / long(cpg);
                    long ic = cIn % long(cpg);
                    float s = 0.0f;
                    long oc0 = g * long(ocpg);
                    long oc = 0L;
                    while (oc < long(ocpg)) {
                        long ocabs = oc0 + oc;
                        long kz = 0L;
                        while (kz < long(kd)) {
                            long znum = iz + long(pdt) - kz * long(dd);
                            if (znum >= 0L && znum % long(sd) == 0L) {
                                long oz = znum / long(sd);
                                if (oz >= 0L && oz < long(yD)) {
                                    long ky = 0L;
                                    while (ky < long(kh)) {
                                        long ynum = iy + long(pt) - ky * long(dh);
                                        if (ynum >= 0L && ynum % long(sh) == 0L) {
                                            long oy = ynum / long(sh);
                                            if (oy >= 0L && oy < long(yH)) {
                                                long kx = 0L;
                                                while (kx < long(kw)) {
                                                    long xnum = ix + long(pl) - kx * long(dw);
                                                    if (xnum >= 0L && xnum % long(sw) == 0L) {
                                                        long ox = xnum / long(sw);
                                                        if (ox >= 0L && ox < long(yW)) {
                                                            s = s + a[dyOff + nn * long(yC) * long(yD) * long(yH) * long(yW) + ocabs * long(yD) * long(yH) * long(yW) + oz * long(yH) * long(yW) + oy * long(yW) + ox]
                                                                     * a[wOff + ocabs * long(wc) + ic * long(kd * kh * kw) + kz * long(kh * kw) + ky * long(kw) + kx];
                                                        }
                                                    }
                                                    kx = kx + 1L;
                                                }
                                            }
                                        }
                                        ky = ky + 1L;
                                    }
                                }
                            }
                            kz = kz + 1L;
                        }
                        oc = oc + 1L;
                    }
                    a[dxOff + p] = s;
                }
            }
        }

        // 反向：y = maxpool3d(x)。清 dX 后 thread-per-output 重算 argmax 路由 dY
        // （stride≥kernel 无重叠，赋值安全）。
        void bwdMaxPool3D(float[] a, long dev,
                          int dyOff, int xOff, int xN, int xC, int xD, int xH, int xW,
                          int dxOff, int yD, int yH, int yW,
                          int kd, int kh, int kw,
                          int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr) {
            @gpu for (long p = 0L; p < long(xN) * long(xC) * long(xD) * long(xH) * long(xW); p = p + 1L) resident(a = dev) {
                a[dxOff + p] = 0.0f;
            }
            @gpu for (long p = 0L; p < long(xN) * long(xC) * long(yD) * long(yH) * long(yW); p = p + 1L) resident(a = dev) {
                if (p < long(xN) * long(xC) * long(yD) * long(yH) * long(yW)) {
                    long yS = long(yD) * long(yH) * long(yW);
                    long nn = p / (long(xC) * yS);
                    long cc = (p / yS) % long(xC);
                    long oz = (p % yS) / long(yH * yW);
                    long oy = (p % long(yH * yW)) / long(yW);
                    long ox = p % long(yW);
                    float best = 0.0f - 1.0e30f;
                    long biz = 0L; long biy = 0L; long bix = 0L;
                    long kz = 0L;
                    while (kz < long(kd)) {
                        long iz = oz * long(sd) - long(pdt) + kz;
                        if (iz >= 0L && iz < long(xD)) {
                            long ky = 0L;
                            while (ky < long(kh)) {
                                long iy = oy * long(sh) - long(pt) + ky;
                                if (iy >= 0L && iy < long(xH)) {
                                    long kx = 0L;
                                    while (kx < long(kw)) {
                                        long ix = ox * long(sw) - long(pl) + kx;
                                        if (ix >= 0L && ix < long(xW)) {
                                            float v = a[xOff + nn * long(xC) * long(xD) * long(xH) * long(xW) + cc * long(xD) * long(xH) * long(xW) + iz * long(xH) * long(xW) + iy * long(xW) + ix];
                                            if (v > best) { best = v; biz = iz; biy = iy; bix = ix; }
                                        }
                                        kx = kx + 1L;
                                    }
                                }
                                ky = ky + 1L;
                            }
                        }
                        kz = kz + 1L;
                    }
                    float dy = a[dyOff + p];
                    a[dxOff + nn * long(xC) * long(xD) * long(xH) * long(xW) + cc * long(xD) * long(xH) * long(xW) + biz * long(xH) * long(xW) + biy * long(xW) + bix] = dy;
                }
            }
        }

        // 反向：y = avgpool3d(x)。清 dX 后 thread-per-output 算 div 把 dy/div 散射到
        // 覆盖的每个输入（stride≥kernel 无重叠，赋值安全）。
        void bwdAvgPool3D(float[] a, long dev,
                          int dyOff, int xOff, int xN, int xC, int xD, int xH, int xW,
                          int dxOff, int yD, int yH, int yW,
                          int kd, int kh, int kw,
                          int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
                          int cip) {
            @gpu for (long p = 0L; p < long(xN) * long(xC) * long(xD) * long(xH) * long(xW); p = p + 1L) resident(a = dev) {
                a[dxOff + p] = 0.0f;
            }
            @gpu for (long p = 0L; p < long(xN) * long(xC) * long(yD) * long(yH) * long(yW); p = p + 1L) resident(a = dev) {
                if (p < long(xN) * long(xC) * long(yD) * long(yH) * long(yW)) {
                    long yS = long(yD) * long(yH) * long(yW);
                    long nn = p / (long(xC) * yS);
                    long cc = (p / yS) % long(xC);
                    long oz = (p % yS) / long(yH * yW);
                    long oy = (p % long(yH * yW)) / long(yW);
                    long ox = p % long(yW);
                    // 有效窗口元素数（与 forward 同公式）
                    long cnt = 0L;
                    long kz = 0L;
                    while (kz < long(kd)) {
                        long iz = oz * long(sd) - long(pdt) + kz;
                        if (iz >= 0L && iz < long(xD)) {
                            long ky = 0L;
                            while (ky < long(kh)) {
                                long iy = oy * long(sh) - long(pt) + ky;
                                if (iy >= 0L && iy < long(xH)) {
                                    long kx = 0L;
                                    while (kx < long(kw)) {
                                        long ix = ox * long(sw) - long(pl) + kx;
                                        if (ix >= 0L && ix < long(xW)) cnt = cnt + 1L;
                                        kx = kx + 1L;
                                    }
                                }
                                ky = ky + 1L;
                            }
                        }
                        kz = kz + 1L;
                    }
                    long div = cnt;
                    if (cip == 1) div = long(kd) * long(kh) * long(kw);
                    if (div < 1L) div = 1L;
                    float dy = a[dyOff + p];
                    float d = dy / float(div);
                    kz = 0L;
                    while (kz < long(kd)) {
                        long iz = oz * long(sd) - long(pdt) + kz;
                        if (iz >= 0L && iz < long(xD)) {
                            long ky = 0L;
                            while (ky < long(kh)) {
                                long iy = oy * long(sh) - long(pt) + ky;
                                if (iy >= 0L && iy < long(xH)) {
                                    long kx = 0L;
                                    while (kx < long(kw)) {
                                        long ix = ox * long(sw) - long(pl) + kx;
                                        if (ix >= 0L && ix < long(xW)) {
                                            a[dxOff + nn * long(xC) * long(xD) * long(xH) * long(xW) + cc * long(xD) * long(xH) * long(xW) + iz * long(xH) * long(xW) + iy * long(xW) + ix] = d;
                                        }
                                        kx = kx + 1L;
                                    }
                                }
                                ky = ky + 1L;
                            }
                        }
                        kz = kz + 1L;
                    }
                }
            }
        }

        // ConvTranspose（转置卷积，group=1）：thread-per-output，权重 W[Cin,Cout,kh,kw]
        void convTranspose(float[] a, int work,
                  int xOff, int xN, int xC, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yH, int yW,
                  int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oc = (p / (yW * yH)) % yC;
                    long nn = p / (yW * yH * yC);
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + oc];
                    int ic = 0;
                    while (ic < xC) {
                        int ky = 0;
                        while (ky < kh) {
                            long inum = oy + pt - ky;
                            if (inum >= 0 && inum % sh == 0) {
                                long iy = inum / sh;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        long wnum = ox + pl - kx;
                                        if (wnum >= 0 && wnum % sw == 0) {
                                            long iw = wnum / sw;
                                            if (iw >= 0 && iw < xW) {
                                                sum = sum + a[xOff + nn * xC * xH * xW + ic * xH * xW + iy * xW + iw]
                                                           * a[wOff + ((ic * yC + oc) * kh + ky) * kw + kx];
                                            }
                                        }
                                        kx = kx + 1;
                                    }
                                }
                            }
                            ky = ky + 1;
                        }
                        ic = ic + 1;
                    }
                    a[yOff + p] = sum;
                }
            }
        }

        // ConvTranspose3D：thread-per-output（权重 [Cin,Cout,kd,kh,kw]；begin pad pdt/pt/pl）
        void convTranspose3d(float[] a, int work,
                  int xOff, int xN, int xC, int xD, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yD, int yH, int yW,
                  int kd, int kh, int kw, int sd, int sh, int sw,
                  int pdt, int pt, int pl, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oz = (p / (yW * yH)) % yD;
                    long oc = (p / (yW * yH * yD)) % yC;
                    long nn = p / (yW * yH * yD * yC);
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + oc];
                    int ic = 0;
                    while (ic < xC) {
                        int kz = 0;
                        while (kz < kd) {
                            long dnum = oz + pdt - kz;
                            if (dnum >= 0 && dnum % sd == 0) {
                                long iz = dnum / sd;
                                if (iz >= 0 && iz < xD) {
                                    int ky = 0;
                                    while (ky < kh) {
                                        long hnum = oy + pt - ky;
                                        if (hnum >= 0 && hnum % sh == 0) {
                                            long iy = hnum / sh;
                                            if (iy >= 0 && iy < xH) {
                                                int kx = 0;
                                                while (kx < kw) {
                                                    long wnum = ox + pl - kx;
                                                    if (wnum >= 0 && wnum % sw == 0) {
                                                        long iw = wnum / sw;
                                                        if (iw >= 0 && iw < xW) {
                                                            sum = sum + a[xOff + nn * xC * xD * xH * xW + ic * xD * xH * xW + iz * xH * xW + iy * xW + iw]
                                                                       * a[wOff + (((ic * yC + oc) * kd + kz) * kh + ky) * kw + kx];
                                                        }
                                                    }
                                                    kx = kx + 1;
                                                }
                                            }
                                        }
                                        ky = ky + 1;
                                    }
                                }
                            }
                            kz = kz + 1;
                        }
                        ic = ic + 1;
                    }
                    a[yOff + p] = sum;
                }
            }
        }

        // Conv3D：thread-per-output（权重 [Cout,Cin,kd,kh,kw]）
        void conv3d(float[] a, int work,
                  int xOff, int xN, int xC, int xD, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yD, int yH, int yW,
                  int kd, int kh, int kw,
                  int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
                  int dd, int dh, int dw, int group, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oz = (p / (yW * yH)) % yD;
                    long oc = (p / (yW * yH * yD)) % yC;
                    long nn = p / (yW * yH * yD * yC);
                    int cpg = xC / group;
                    int ocpg = yC / group;
                    long g = oc / ocpg;
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + oc];
                    int ic = 0;
                    while (ic < cpg) {
                        long cIn = g * cpg + ic;
                        int kz = 0;
                        while (kz < kd) {
                            long iz = oz * sd - pdt + kz * dd;
                            if (iz >= 0 && iz < xD) {
                                int ky = 0;
                                while (ky < kh) {
                                    long iy = oy * sh - pt + ky * dh;
                                    if (iy >= 0 && iy < xH) {
                                        int kx = 0;
                                        while (kx < kw) {
                                            long ix = ox * sw - pl + kx * dw;
                                            if (ix >= 0 && ix < xW) {
                                                sum = sum + a[xOff + nn * xC * xD * xH * xW + cIn * xD * xH * xW + iz * xH * xW + iy * xW + ix]
                                                           * a[wOff + oc * (cpg * kd * kh * kw) + ic * kd * kh * kw + kz * kh * kw + ky * kw + kx];
                                            }
                                            kx = kx + 1;
                                        }
                                    }
                                    ky = ky + 1;
                                }
                            }
                            kz = kz + 1;
                        }
                        ic = ic + 1;
                    }
                    a[yOff + p] = sum;
                }
            }
        }

        // Conv3D 通用 tiled（§2.3 ① 通用版，2026-08-13）：共享内存分块 + 输出通道
        // 分组（OC_GRP=4，输入窗口跨 oc 寄存器复用）+ 输入通道分块（CC，任意 Cin）。
        // **通用性**：任意核大小 kd/kh/kw、任意 stride/dilation、任意 pads 都走
        // 该共享路径——patch 尺寸按 stride/dilation 自适应，compute 窗口循环通用
        // （不假设 k≤3 / s=1 / d=1）。仅 group=1（group>1 罕见回退）；共享超限
        // （超大核/大 stride）回退 thread-per-output conv3d。
        // 每线程算 RW=4 连续 W 输出 × 4 oc（每 (ic,kz,ky,kx) 载 4 输入 + 4 权重 → 16 FMA）。
        // 块序 og 最快 → 同空间 tile 各 oc-group 连续执行，L2 跨组缓存 patch。
        void conv3dTiledPatch(float[] a, int work,
                  int xOff, int xN, int xC, int xD, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yD, int yH, int yW,
                  int kd, int kh, int kw,
                  int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
                  int dd, int dh, int dw, int group, long dev) {
            int TD = 4; int TH = 8; int TW = 32;   // 空间输出 tile（4×8×32=1024 输出）
            int RW = 4;                            // 每线程连续 W 输出数
            int OC_GRP = 4;                        // 输出通道/块（输入复用）
            int cpg = xC / group;
            if (group != 1) {   // group>1 罕见 → 回退通用 thread-per-output conv3d
                GpuInferOps.conv3d(a, work, xOff, xN, xC, xD, xH, xW, wOff, bOff, yOff, yC,
                       yD, yH, yW, kd, kh, kw, sd, sh, sw, pdt, pdb, pt, pb, pl, pr,
                       dd, dh, dw, group, dev);
                return;
            }
            // 通用 patch 尺寸（含 stride/dilation 跨度）
            int pz = (TD - 1) * sd + (kd - 1) * dd + 1;
            int ph = (TH - 1) * sh + (kh - 1) * dh + 1;
            int pw = (TW - 1) * sw + (kw - 1) * dw + 1;
            int perChan = pz * ph * pw + OC_GRP * kd * kh * kw;
            int CC = 6144 / perChan;               // 通道分块（共享 ≤24KB）
            if (CC < 1) CC = 1;
            if (CC > 4) CC = 4;
            int patchSz = CC * pz * ph * pw;
            int wSz = OC_GRP * CC * kd * kh * kw;
            if (patchSz + wSz > 6144) {   // 超大核 / 大 stride → 共享超限回退
                GpuInferOps.conv3d(a, work, xOff, xN, xC, xD, xH, xW, wOff, bOff, yOff, yC,
                       yD, yH, yW, kd, kh, kw, sd, sh, sw, pdt, pdb, pt, pb, pl, pr,
                       dd, dh, dw, group, dev);
                return;
            }
            int zT = (yD + TD - 1) / TD;
            int hT = (yH + TH - 1) / TH;
            int wT = (yW + TW - 1) / TW;
            int perPlane = zT * hT * wT;
            int nGroups = (yC + OC_GRP - 1) / OC_GRP;
            int nChunks = (cpg + CC - 1) / CC;
            int nTiles = xN * nGroups * perPlane;
            @gpu tile (float[6144] smem) grid(nTiles) resident(a = dev) {
                long tb = kernel.bx;
                long og = tb % long(nGroups);       // og 最快 → L2 跨组缓存 patch
                long tile = tb / long(nGroups);
                long nn = tile / long(perPlane);
                long rest = tile % long(perPlane);
                long zt = rest / long(hT * wT);
                long yt = (rest / long(wT)) % long(hT);
                long xt = rest % long(wT);
                long oz0 = zt * long(TD);
                long oy0 = yt * long(TH);
                long ox0 = xt * long(TW);
                long tid = kernel.tx;
                long od = tid / long(TH * (TW / RW));
                long oh = (tid / long(TW / RW)) % long(TH);
                long ws = tid % long(TW / RW);
                long oxL0 = ws * long(RW);
                long patchTot = long(patchSz);
                long oc0 = og * long(OC_GRP) + 0L;
                long oc1 = og * long(OC_GRP) + 1L;
                long oc2 = og * long(OC_GRP) + 2L;
                long oc3 = og * long(OC_GRP) + 3L;
                float A0 = 0.0f; float A1 = 0.0f; float A2 = 0.0f; float A3 = 0.0f;   // oc0: W0..W3
                float B0 = 0.0f; float B1 = 0.0f; float B2 = 0.0f; float B3 = 0.0f;   // oc1
                float C0 = 0.0f; float C1 = 0.0f; float C2 = 0.0f; float C3 = 0.0f;   // oc2
                float D0 = 0.0f; float D1 = 0.0f; float D2 = 0.0f; float D3 = 0.0f;   // oc3
                if (bOff >= 0) {
                    if (oc0 < long(yC)) { float bv = a[bOff + oc0]; A0 = bv; A1 = bv; A2 = bv; A3 = bv; }
                    if (oc1 < long(yC)) { float bv = a[bOff + oc1]; B0 = bv; B1 = bv; B2 = bv; B3 = bv; }
                    if (oc2 < long(yC)) { float bv = a[bOff + oc2]; C0 = bv; C1 = bv; C2 = bv; C3 = bv; }
                    if (oc3 < long(yC)) { float bv = a[bOff + oc3]; D0 = bv; D1 = bv; D2 = bv; D3 = bv; }
                }
                long c = 0L;
                while (c < long(nChunks)) {
                    // 协作载入输入 patch 块（CC 通道；通用 stride/dilation；越界填 0）
                    long rr = tid;
                    while (rr < patchTot) {
                        long ic = rr / (long(pz) * long(ph) * long(pw));
                        long iz = (rr / (long(ph) * long(pw))) % long(pz);
                        long iy = (rr / long(pw)) % long(ph);
                        long ix = rr % long(pw);
                        float v = 0.0f;
                        long gcin = c * long(CC) + ic;
                        if (gcin < long(cpg)) {
                            long gz = oz0 * long(sd) - long(pdt) + iz;
                            long gy = oy0 * long(sh) - long(pt) + iy;
                            long gx = ox0 * long(sw) - long(pl) + ix;
                            if (gz >= 0L && gz < long(xD) && gy >= 0L && gy < long(xH)
                                && gx >= 0L && gx < long(xW)) {
                                v = a[xOff + nn * long(xC) * long(xD) * long(xH) * long(xW)
                                      + gcin * long(xD) * long(xH) * long(xW)
                                      + gz * long(xH) * long(xW) + gy * long(xW) + gx];
                            }
                        }
                        smem[((ic * long(pz) + iz) * long(ph) + iy) * long(pw) + ix] = v;
                        rr = rr + 256L;
                    }
                    // 协作载入权重块（OC_GRP 输出通道 × CC 输入通道；越界填 0）
                    long j = tid;
                    while (j < long(wSz)) {
                        long ocIdx = j / (long(CC) * long(kd) * long(kh) * long(kw));
                        long rem = j % (long(CC) * long(kd) * long(kh) * long(kw));
                        long jic = rem / (long(kd) * long(kh) * long(kw));
                        long jz = (rem / (long(kh) * long(kw))) % long(kd);
                        long jy = (rem / long(kw)) % long(kh);
                        long jx = rem % long(kw);
                        float wv = 0.0f;
                        long ocJ = og * long(OC_GRP) + ocIdx;
                        long gcin2 = c * long(CC) + jic;
                        if (ocJ < long(yC) && gcin2 < long(cpg)) {
                            wv = a[wOff + ocJ * long(cpg) * long(kd) * long(kh) * long(kw)
                                    + gcin2 * long(kd) * long(kh) * long(kw)
                                    + jz * long(kh) * long(kw) + jy * long(kw) + jx];
                        }
                        smem[long(patchSz) + j] = wv;
                        j = j + 256L;
                    }
                    kernel.sync();
                    // 通用窗口累积（4 W × 4 oc；stride/dilation 经索引体现，无核大小假设）
                    long ic2 = 0L;
                    while (ic2 < long(CC)) {
                        long gcin3 = c * long(CC) + ic2;
                        if (gcin3 < long(cpg)) {
                            long kz = 0L;
                            while (kz < long(kd)) {
                                long iz = od * long(sd) + kz * long(dd);
                                long ky = 0L;
                                while (ky < long(kh)) {
                                    long iy = oh * long(sh) + ky * long(dh);
                                    long rowBase = ((ic2 * long(pz) + iz) * long(ph) + iy) * long(pw)
                                                 + oxL0 * long(sw);
                                    long wbase0 = (ic2 * long(kd) + kz) * long(kh) * long(kw) + ky * long(kw);
                                    long ocStride = long(CC) * long(kd) * long(kh) * long(kw);
                                    long kx = 0L;
                                    while (kx < long(kw)) {
                                        long col = kx * long(dw);
                                        float v0 = smem[rowBase + col];
                                        float v1 = smem[rowBase + col + long(sw)];
                                        float v2 = smem[rowBase + col + 2L * long(sw)];
                                        float v3 = smem[rowBase + col + 3L * long(sw)];
                                        float w0 = smem[patchTot + wbase0 + kx];
                                        float w1 = smem[patchTot + ocStride + wbase0 + kx];
                                        float w2 = smem[patchTot + 2L * ocStride + wbase0 + kx];
                                        float w3 = smem[patchTot + 3L * ocStride + wbase0 + kx];
                                        A0 = A0 + v0 * w0; A1 = A1 + v1 * w0; A2 = A2 + v2 * w0; A3 = A3 + v3 * w0;
                                        B0 = B0 + v0 * w1; B1 = B1 + v1 * w1; B2 = B2 + v2 * w1; B3 = B3 + v3 * w1;
                                        C0 = C0 + v0 * w2; C1 = C1 + v1 * w2; C2 = C2 + v2 * w2; C3 = C3 + v3 * w2;
                                        D0 = D0 + v0 * w3; D1 = D1 + v1 * w3; D2 = D2 + v2 * w3; D3 = D3 + v3 * w3;
                                        kx = kx + 1L;
                                    }
                                    ky = ky + 1L;
                                }
                                kz = kz + 1L;
                            }
                        }
                        ic2 = ic2 + 1L;
                    }
                    kernel.sync();
                    c = c + 1L;
                }
                // 写 16 个输出（4 oc × 4 W；越界 oc/空间跳过）
                long oz = oz0 + od;
                long oy = oy0 + oh;
                long ox1 = ox0 + oxL0;
                if (oz < long(yD) && oy < long(yH)) {
                    long yb0 = (nn * long(yC) + oc0) * long(yD) * long(yH) * long(yW) + oz * long(yH) * long(yW) + oy * long(yW);
                    long yb1 = (nn * long(yC) + oc1) * long(yD) * long(yH) * long(yW) + oz * long(yH) * long(yW) + oy * long(yW);
                    long yb2 = (nn * long(yC) + oc2) * long(yD) * long(yH) * long(yW) + oz * long(yH) * long(yW) + oy * long(yW);
                    long yb3 = (nn * long(yC) + oc3) * long(yD) * long(yH) * long(yW) + oz * long(yH) * long(yW) + oy * long(yW);
                    if (oc0 < long(yC)) {
                        if (ox1 + 0L < long(yW)) a[yOff + yb0 + ox1 + 0L] = A0;
                        if (ox1 + 1L < long(yW)) a[yOff + yb0 + ox1 + 1L] = A1;
                        if (ox1 + 2L < long(yW)) a[yOff + yb0 + ox1 + 2L] = A2;
                        if (ox1 + 3L < long(yW)) a[yOff + yb0 + ox1 + 3L] = A3;
                    }
                    if (oc1 < long(yC)) {
                        if (ox1 + 0L < long(yW)) a[yOff + yb1 + ox1 + 0L] = B0;
                        if (ox1 + 1L < long(yW)) a[yOff + yb1 + ox1 + 1L] = B1;
                        if (ox1 + 2L < long(yW)) a[yOff + yb1 + ox1 + 2L] = B2;
                        if (ox1 + 3L < long(yW)) a[yOff + yb1 + ox1 + 3L] = B3;
                    }
                    if (oc2 < long(yC)) {
                        if (ox1 + 0L < long(yW)) a[yOff + yb2 + ox1 + 0L] = C0;
                        if (ox1 + 1L < long(yW)) a[yOff + yb2 + ox1 + 1L] = C1;
                        if (ox1 + 2L < long(yW)) a[yOff + yb2 + ox1 + 2L] = C2;
                        if (ox1 + 3L < long(yW)) a[yOff + yb2 + ox1 + 3L] = C3;
                    }
                    if (oc3 < long(yC)) {
                        if (ox1 + 0L < long(yW)) a[yOff + yb3 + ox1 + 0L] = D0;
                        if (ox1 + 1L < long(yW)) a[yOff + yb3 + ox1 + 1L] = D1;
                        if (ox1 + 2L < long(yW)) a[yOff + yb3 + ox1 + 2L] = D2;
                        if (ox1 + 3L < long(yW)) a[yOff + yb3 + ox1 + 3L] = D3;
                    }
                }
            }
        }

        // ---- 3D 卷积 tiled im2col-GEMM（P5d，2026-09-01）----
        // 把 3D 卷积写成 GEMM：Y[M,N] = W[M,K]·Xim2col[K,N]
        //   M = yC（输出通道），N = xN*yD*yH*yW（全部空间位置），K = cpg*kd*kh*kw。
        // 块 = 32×32 输出 tile（M×N）；K 分块 BK=32 载 W tile 与 im2col X tile 到共享；
        // 256 线程各算 2×2 子 tile。im2col 即时展开（stride/pad/dilation 全支持，越界填 0）。
        // 与 conv3dTiledPatch（patch 版）相比：权重经 32 oc 复用（patch 版仅 OC_GRP=4），
        // 摊薄 patch 重载——docs「fine 需 im2col+GEMM（Cin=256/yC=128 大权重 conv）」落地。
        // group=1 且 M≥32/N≥32/M*N≥4096 才进；否则回退 conv3dTiledPatch。
        void conv3dTiledGEMM(float[] a, int work,
                  int xOff, int xN, int xC, int xD, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yD, int yH, int yW,
                  int kd, int kh, int kw,
                  int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
                  int dd, int dh, int dw, int group, long dev) {
            int cpg = xC / group;
            int N = xN * yD * yH * yW;
            int K = cpg * kd * kh * kw;
            if (group != 1 || yC < 32 || N < 32 || long(yC) * long(N) < 4096L) {
                GpuInferOps.conv3dTiledPatch(a, work, xOff, xN, xC, xD, xH, xW, wOff, bOff, yOff, yC,
                       yD, yH, yW, kd, kh, kw, sd, sh, sw, pdt, pdb, pt, pb, pl, pr,
                       dd, dh, dw, group, dev);
                return;
            }
            int TM = 32; int TN = 32; int BK = 32;
            int mT = (yC + TM - 1) / TM;
            int nT = (N + TN - 1) / TN;
            int nTiles = mT * nT;
            int nKB = (K + BK - 1) / BK;
            @gpu tile (float[6144] smem) grid(nTiles) resident(a = dev) {
                long tb = kernel.bx;
                long mi = tb / long(nT);
                long ni = tb % long(nT);
                long tid = kernel.tx;
                long ti = tid / 16L;              // 16×16 线程网格 → 2×2 子 tile
                long tj = tid % 16L;
                long i0 = mi * 32L + ti * 2L;     // 输出通道起始（M 维）
                long j0 = ni * 32L + tj * 2L;     // 空间位置起始（N 维）
                float a00 = 0.0f; float a01 = 0.0f; float a10 = 0.0f; float a11 = 0.0f;
                if (bOff >= 0 && i0 < long(yC)) {
                    float bv = a[bOff + i0];
                    a00 = bv; a01 = bv;
                    if (i0 + 1L < long(yC)) { float bv2 = a[bOff + i0 + 1L]; a10 = bv2; a11 = bv2; }
                }
                int kb = 0;
                while (kb < nKB) {
                    // 载 W tile [32×32] → smem[0,1024)
                    long rr = tid;
                    while (rr < 1024L) {
                        long wi = rr / 32L;         // M 维（0..31）
                        long wk = rr % 32L;         // K 维（0..31）
                        float wv = 0.0f;
                        long gi = mi * 32L + wi;    // 全局输出通道
                        long gk = long(kb) * 32L + wk;   // 全局归约索引（K=cpg*kd*kh*kw）
                        // 权重布局 w[oc, cIn, kz, ky, kx]（group=1：oc=gi）
                        // = wOff + gi*K + gk（K=cpg*kd*kh*kw，W 行连续）
                        if (gi < long(yC) && gk < long(K))
                            wv = a[wOff + gi * long(K) + gk];
                        smem[rr] = wv;
                        rr = rr + 256L;
                    }
                    // 载 im2col X tile [32×32] → smem[1024,2048)
                    rr = tid;
                    while (rr < 1024L) {
                        long xk = rr / 32L;         // K 维（0..31）
                        long xj = rr % 32L;         // N 维（0..31）
                        float xv = 0.0f;
                        long gk2 = long(kb) * 32L + xk;   // 全局归约索引
                        long gj = ni * 32L + xj;          // 全局空间位置
                        if (gk2 < long(K) && gj < long(N)) {
                            long cIdx = gk2 / (long(kd) * long(kh) * long(kw));
                            long remK = gk2 % (long(kd) * long(kh) * long(kw));
                            long kz = remK / (long(kh) * long(kw));
                            long ky = (remK / long(kw)) % long(kh);
                            long kx = remK % long(kw);
                            // 空间位置 gj → (n, oz, oy, ox)
                            long DHW = long(yD) * long(yH) * long(yW);
                            long nn = gj / DHW;
                            long remP = gj % DHW;
                            long oz = remP / (long(yH) * long(yW));
                            long oy = (remP / long(yW)) % long(yH);
                            long ox = remP % long(yW);
                            long iz = oz * long(sd) - long(pdt) + kz * long(dd);
                            long iy = oy * long(sh) - long(pt) + ky * long(dh);
                            long ix = ox * long(sw) - long(pl) + kx * long(dw);
                            if (iz >= 0L && iz < long(xD) && iy >= 0L && iy < long(xH)
                                && ix >= 0L && ix < long(xW)) {
                                xv = a[xOff + nn * long(xC) * long(xD) * long(xH) * long(xW)
                                          + cIdx * long(xD) * long(xH) * long(xW)
                                          + iz * long(xH) * long(xW) + iy * long(xW) + ix];
                            }
                        }
                        smem[1024L + rr] = xv;
                        rr = rr + 256L;
                    }
                    kernel.sync();
                    long k = 0L;
                    while (k < 32L) {
                        float w0 = smem[(ti * 2L) * 32L + k];
                        float w1 = smem[(ti * 2L + 1L) * 32L + k];
                        float x0 = smem[1024L + k * 32L + tj * 2L];
                        float x1 = smem[1024L + k * 32L + tj * 2L + 1L];
                        a00 = a00 + w0 * x0;
                        a01 = a01 + w0 * x1;
                        a10 = a10 + w1 * x0;
                        a11 = a11 + w1 * x1;
                        k = k + 1L;
                    }
                    kernel.sync();
                    kb = kb + 1;
                }
                // 写 2×2 输出（NCDHW 布局 [N,yC,yD,yH,yW]：p = nn*yC*yD*yH*yW + oc*yD*yH*yW
                //   + oz*yH*yW + oy*yW + ox）。GEMM N 维=空间位置 gj = nn*DHW + oz*yH*yW
                //   + oy*yW + ox（含 batch 偏移），输出内偏移需把 gj 分解回 (nn,oz,oy,ox)
                //   再加 oc 平面偏移。
                long DHW = long(yD) * long(yH) * long(yW);
                if (i0 < long(yC)) {
                    long ocA = i0;
                    long nnA = j0 / DHW;
                    long remA = j0 % DHW;
                    long oA = nnA * long(yC) * DHW + ocA * DHW + remA;
                    if (j0 < long(N)) a[yOff + oA] = a00;
                    if (j0 + 1L < long(N)) {
                        long oB = (j0 + 1L) / DHW * long(yC) * DHW + ocA * DHW + (j0 + 1L) % DHW;
                        a[yOff + oB] = a01;
                    }
                }
                if (i0 + 1L < long(yC)) {
                    long ocB2 = i0 + 1L;
                    long nnB = j0 / DHW;
                    long remB = j0 % DHW;
                    long oC = nnB * long(yC) * DHW + ocB2 * DHW + remB;
                    if (j0 < long(N)) a[yOff + oC] = a10;
                    if (j0 + 1L < long(N)) {
                        long oD = (j0 + 1L) / DHW * long(yC) * DHW + ocB2 * DHW + (j0 + 1L) % DHW;
                        a[yOff + oD] = a11;
                    }
                }
            }
        }

        // ---- 3D 卷积入口（P5d：优先 im2col-GEMM，不满足回退 patch 版）----
        void conv3dTiled(float[] a, int work,
                  int xOff, int xN, int xC, int xD, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yD, int yH, int yW,
                  int kd, int kh, int kw,
                  int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
                  int dd, int dh, int dw, int group, long dev) {
            GpuInferOps.conv3dTiledGEMM(a, work, xOff, xN, xC, xD, xH, xW, wOff, bOff, yOff, yC,
                   yD, yH, yW, kd, kh, kw, sd, sh, sw, pdt, pdb, pt, pb, pl, pr,
                   dd, dh, dw, group, dev);
        }

        // MaxPool3D：thread-per-output
        void maxpool3d(float[] a, int work,
                  int xOff, int xN, int xC, int xD, int xH, int xW,
                  int yOff, int yD, int yH, int yW,
                  int kd, int kh, int kw,
                  int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oz = (p / (yW * yH)) % yD;
                    long c = (p / (yW * yH * yD)) % xC;
                    long nn = p / (yW * yH * yD * xC);
                    float best = 0.0f - 1.0e30f;
                    int kz = 0;
                    while (kz < kd) {
                        long iz = oz * sd - pdt + kz;
                        if (iz >= 0 && iz < xD) {
                            int ky = 0;
                            while (ky < kh) {
                                long iy = oy * sh - pt + ky;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        long ix = ox * sw - pl + kx;
                                        if (ix >= 0 && ix < xW) {
                                            float v = a[xOff + nn * xC * xD * xH * xW + c * xD * xH * xW + iz * xH * xW + iy * xW + ix];
                                            if (v > best) best = v;
                                        }
                                        kx = kx + 1;
                                    }
                                }
                                ky = ky + 1;
                            }
                        }
                        kz = kz + 1;
                    }
                    a[yOff + p] = best;
                }
            }
        }

        // AveragePool3D：thread-per-output（支持各向异性核）
        void avgpool3d(float[] a, int work,
                  int xOff, int xN, int xC, int xD, int xH, int xW,
                  int yOff, int yD, int yH, int yW,
                  int kd, int kh, int kw,
                  int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
                  int cip, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oz = (p / (yW * yH)) % yD;
                    long c = (p / (yW * yH * yD)) % xC;
                    long nn = p / (yW * yH * yD * xC);
                    // §2.3 ⑤：float 累加（窗口小，无精度风险；double 在 GPU 上
                    // 慢 1/32——RTX 消费卡 FP64 吞吐仅为 FP32 的 1/32）
                    float sum = 0.0f;
                    int cnt = 0;
                    int kz = 0;
                    while (kz < kd) {
                        long iz = oz * sd - pdt + kz;
                        if (iz >= 0 && iz < xD) {
                            int ky = 0;
                            while (ky < kh) {
                                long iy = oy * sh - pt + ky;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        long ix = ox * sw - pl + kx;
                                        if (ix >= 0 && ix < xW) {
                                            sum = sum + a[xOff + nn * xC * xD * xH * xW + c * xD * xH * xW + iz * xH * xW + iy * xW + ix];
                                            cnt = cnt + 1;
                                        }
                                        kx = kx + 1;
                                    }
                                }
                                ky = ky + 1;
                            }
                        }
                        kz = kz + 1;
                    }
                    int div = cnt;
                    if (cip == 1) div = kd * kh * kw;
                    if (div < 1) div = 1;
                    a[yOff + p] = sum / float(div);
                }
            }
        }

        // 融合 Conv+ReLU（G1）：卷积输出直接过 ReLU，不写回中间张量（少一次
        // kernel 启动 + 少一次中间张量读写）。参数与 conv 相同，y 处写 max(sum,0)。
        void convReluPlain(float[] a, int work,
                  int xOff, int xN, int xC, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yH, int yW,
                  int kh, int kw,
                  int sh, int sw, int pt, int pb, int pl, int pr,
                  int dh, int dw, int group, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oc = (p / (yW * yH)) % yC;
                    long nn = p / (yW * yH * yC);
                    int cpg = xC / group;
                    int ocpg = yC / group;
                    long g = oc / ocpg;
                    int wc = cpg * kh * kw;
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + oc];   // 无偏置卷积（bOff=-1）
                    int ic = 0;
                    while (ic < cpg) {
                        long cIn = g * cpg + ic;
                        int ky = 0;
                        while (ky < kh) {
                            long iy = oy * sh - pt + ky * dh;
                            if (iy >= 0 && iy < xH) {
                                int kx = 0;
                                while (kx < kw) {
                                    long ix = ox * sw - pl + kx * dw;
                                    if (ix >= 0 && ix < xW) {
                                        sum = sum + a[xOff + nn * xC * xH * xW + cIn * xH * xW + iy * xW + ix]
                                                   * a[wOff + oc * wc + ic * kh * kw + ky * kw + kx];
                                    }
                                    kx = kx + 1;
                                }
                            }
                            ky = ky + 1;
                        }
                        ic = ic + 1;
                    }
                    if (sum > 0.0f) a[yOff + p] = sum;
                    else a[yOff + p] = 0.0f;
                }
            }
        }

        // 最大池化：x: [N,C,H,W] → y: [N,C,yH,yW]
        void maxpool(float[] a, int work,
                     int xOff, int xN, int xC, int xH, int xW,
                     int yOff, int yH, int yW,
                     int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long c = (p / (yW * yH)) % xC;
                    long nn = p / (yW * yH * xC);
                    float best = 0.0f - 1.0e30f;
                    int ky = 0;
                    while (ky < kh) {
                        long iy = oy * sh - pt + ky;
                        if (iy >= 0 && iy < xH) {
                            int kx = 0;
                            while (kx < kw) {
                                long ix = ox * sw - pl + kx;
                                if (ix >= 0 && ix < xW) {
                                    float v = a[xOff + nn * xC * xH * xW + c * xH * xW + iy * xW + ix];
                                    if (v > best) best = v;
                                }
                                kx = kx + 1;
                            }
                        }
                        ky = ky + 1;
                    }
                    a[yOff + p] = best;
                }
            }
        }

        // AveragePool：x: [N,C,H,W] → y: [N,C,yH,yW]（thread-per-output；cip=count_include_pad）
        void avgpool(float[] a, int work,
                     int xOff, int xN, int xC, int xH, int xW,
                     int yOff, int yH, int yW,
                     int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr, int cip, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long c = (p / (yW * yH)) % xC;
                    long nn = p / (yW * yH * xC);
                    float sum = 0.0f;
                    int cnt = 0;
                    int ky = 0;
                    while (ky < kh) {
                        long iy = oy * sh - pt + ky;
                        if (iy >= 0 && iy < xH) {
                            int kx = 0;
                            while (kx < kw) {
                                long ix = ox * sw - pl + kx;
                                if (ix >= 0 && ix < xW) {
                                    sum = sum + a[xOff + nn * xC * xH * xW + c * xH * xW + iy * xW + ix];
                                    cnt = cnt + 1;
                                }
                                kx = kx + 1;
                            }
                        }
                        ky = ky + 1;
                    }
                    if (cip == 1) cnt = kh * kw;
                    if (cnt > 0) a[yOff + p] = sum / cnt;
                    else a[yOff + p] = 0.0f;
                }
            }
        }

        // Pad：constant/reflect/edge（thread-per-output；mode 0=const,1=reflect,2=edge）
        void pad(float[] a, int work,
                 int xOff, int xN, int xC, int xH, int xW,
                 int yOff, int yN, int yC, int yH, int yW,
                 int pnB, int pcB, int phB, int pwB, int pnE, int pcE, int phE, int pwE,
                 int mode, double cval, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long w = p % yW;
                    long t = p / yW;
                    long h = t % yH;
                    t = t / yH;
                    long c = t % yC;
                    long n = t / yC;
                    long sn = n - pnB;
                    long sc = c - pcB;
                    long sh = h - phB;
                    long sw = w - pwB;
                    int inb = 1;
                    if (sn < 0 || sn >= xN) inb = 0;
                    if (sc < 0 || sc >= xC) inb = 0;
                    if (sh < 0 || sh >= xH) inb = 0;
                    if (sw < 0 || sw >= xW) inb = 0;
                    float v = 0.0f;
                    if (inb == 1) {
                        v = a[xOff + ((sn * xC + sc) * xH + sh) * xW + sw];
                    } else if (mode == 1) {
                        if (sn < 0) sn = 0L - sn;
                        if (sc < 0) sc = 0L - sc;
                        if (sh < 0) sh = 0L - sh;
                        if (sw < 0) sw = 0L - sw;
                        if (sn >= xN) sn = long(2 * (xN - 1)) - sn;
                        if (sc >= xC) sc = long(2 * (xC - 1)) - sc;
                        if (sh >= xH) sh = long(2 * (xH - 1)) - sh;
                        if (sw >= xW) sw = long(2 * (xW - 1)) - sw;
                        v = a[xOff + ((sn * xC + sc) * xH + sh) * xW + sw];
                    } else if (mode == 2) {
                        if (sn < 0) sn = 0L;
                        if (sc < 0) sc = 0L;
                        if (sh < 0) sh = 0L;
                        if (sw < 0) sw = 0L;
                        if (sn >= xN) sn = long(xN - 1);
                        if (sc >= xC) sc = long(xC - 1);
                        if (sh >= xH) sh = long(xH - 1);
                        if (sw >= xW) sw = long(xW - 1);
                        v = a[xOff + ((sn * xC + sc) * xH + sh) * xW + sw];
                    } else {
                        v = float(cval);
                    }
                    a[yOff + p] = v;
                }
            }
        }

        // Pad3D：thread-per-output（5D，10 个 pad）
        void pad3d(float[] a, int work,
                 int xOff, int xN, int xC, int xD, int xH, int xW,
                 int yOff, int yN, int yC, int yD, int yH, int yW,
                 int pnB, int pnE, int pcB, int pcE, int pdB, int pdE, int phB, int phE, int pwB, int pwE,
                 int mode, double cval, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long w = p % yW;
                    long t = p / yW;
                    long h = t % yH;
                    t = t / yH;
                    long d = t % yD;
                    t = t / yD;
                    long c = t % yC;
                    long n = t / yC;
                    long sn = n - pnB;
                    long sc = c - pcB;
                    long sd = d - pdB;
                    long sh = h - phB;
                    long sw = w - pwB;
                    int inb = 1;
                    if (sn < 0 || sn >= xN) inb = 0;
                    if (sc < 0 || sc >= xC) inb = 0;
                    if (sd < 0 || sd >= xD) inb = 0;
                    if (sh < 0 || sh >= xH) inb = 0;
                    if (sw < 0 || sw >= xW) inb = 0;
                    float v = 0.0f;
                    if (inb == 1) {
                        v = a[xOff + (((sn * xC + sc) * xD + sd) * xH + sh) * xW + sw];
                    } else if (mode == 1) {
                        if (sn < 0) sn = 0L - sn;
                        if (sc < 0) sc = 0L - sc;
                        if (sd < 0) sd = 0L - sd;
                        if (sh < 0) sh = 0L - sh;
                        if (sw < 0) sw = 0L - sw;
                        if (sn >= xN) sn = long(2 * (xN - 1)) - sn;
                        if (sc >= xC) sc = long(2 * (xC - 1)) - sc;
                        if (sd >= xD) sd = long(2 * (xD - 1)) - sd;
                        if (sh >= xH) sh = long(2 * (xH - 1)) - sh;
                        if (sw >= xW) sw = long(2 * (xW - 1)) - sw;
                        v = a[xOff + (((sn * xC + sc) * xD + sd) * xH + sh) * xW + sw];
                    } else if (mode == 2) {
                        if (sn < 0) sn = 0L;
                        if (sc < 0) sc = 0L;
                        if (sd < 0) sd = 0L;
                        if (sh < 0) sh = 0L;
                        if (sw < 0) sw = 0L;
                        if (sn >= xN) sn = long(xN - 1);
                        if (sc >= xC) sc = long(xC - 1);
                        if (sd >= xD) sd = long(xD - 1);
                        if (sh >= xH) sh = long(xH - 1);
                        if (sw >= xW) sw = long(xW - 1);
                        v = a[xOff + (((sn * xC + sc) * xD + sd) * xH + sh) * xW + sw];
                    } else {
                        v = float(cval);
                    }
                    a[yOff + p] = v;
                }
            }
        }

        // 全局平均池化：x: [N,C,H,W] → y: [N,C,1,1]（work = N*C）
        void gapool(float[] a, int work,
                    int xOff, int xN, int xC, int xH, int xW, int yOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % xC;
                    long nn = p / xC;
                    float sum = 0.0f;
                    int i = 0;
                    while (i < xH * xW) {
                        sum = sum + a[xOff + nn * xC * xH * xW + c * xH * xW + i];
                        i = i + 1;
                    }
                    a[yOff + p] = sum / float(xH * xW);
                }
            }
        }

        // GAP 3D：thread-per-(n,c)，均值 over D*H*W 连续段
        void gapoolD(float[] a, int work,
                     int xOff, int xN, int xC, int xD, int xH, int xW, int yOff, long dev) {
            int per = xD * xH * xW;
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % xC;
                    long nn = p / xC;
                    float sum = 0.0f;
                    int i = 0;
                    while (i < per) { sum = sum + a[xOff + nn * xC * per + c * per + i]; i = i + 1; }
                    a[yOff + p] = sum / float(per);
                }
            }
        }

        // Flatten：数据连续，直接拷贝
        void flatten(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    a[outOff + p] = a[inOff + p];
                }
            }
        }

        // ---- G2：NHWC 布局（x:[N,H,W,C] 行优先）----

        // NCHW→NHWC 转置：x:[N,C,H,W] → y:[N,H,W,C]（每线程一个元素）
        void transposeNCHW2NHWC(float[] a, int work,
                int xOff, int xN, int xC, int xH, int xW, int yOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % xC;
                    long h = (p / xC) % xH;
                    long w = (p / (xC * xH)) % xW;
                    long nn = p / (xC * xH * xW);
                    a[yOff + ((nn * xH + h) * xW + w) * xC + c] = a[xOff + ((nn * xC + c) * xH + h) * xW + w];
                }
            }
        }

        // NHWC 卷积：x:[N,H,W,Cin]，w:[Cout,KH,KW,Cin]，b:[Cout]，y:[N,Hout,Wout,Cout]
        // 每线程算一个输出元素（co,ox,oy,nn），串行归约 cpg*kh*kw
        void convNHWC(float[] a, int work,
                int xOff, int xN, int xH, int xW, int xC,
                int wOff, int bOff,
                int yOff, int yH, int yW, int yC,
                int kh, int kw,
                int sh, int sw, int pt, int pb, int pl, int pr,
                int dh, int dw, int group, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long co = p % yC;
                    long ox = (p / yC) % yW;
                    long oy = (p / (yC * yW)) % yH;
                    long nn = p / (yC * yW * yH);
                    int cpg = xC / group;
                    int ocpg = yC / group;
                    long g = co / ocpg;
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + co];   // 无偏置卷积（bOff=-1）
                    int ky = 0;
                    while (ky < kh) {
                        long iy = oy * sh - pt + ky * dh;
                        if (iy >= 0 && iy < xH) {
                            int kx = 0;
                            while (kx < kw) {
                                long ix = ox * sw - pl + kx * dw;
                                if (ix >= 0 && ix < xW) {
                                    int ic = 0;
                                    while (ic < cpg) {
                                        long cIn = g * cpg + ic;
                                        sum = sum + a[xOff + ((nn * xH + iy) * xW + ix) * xC + cIn]
                                                   * a[wOff + ((co * kh + ky) * kw + kx) * cpg + ic];
                                        ic = ic + 1;
                                    }
                                }
                                kx = kx + 1;
                            }
                        }
                        ky = ky + 1;
                    }
                    a[yOff + p] = sum;
                }
            }
        }

        // NHWC 卷积 + ReLU（G1 融合的 NHWC 对应）：y 处写 max(sum,0)
        void convNHWCRelu(float[] a, int work,
                int xOff, int xN, int xH, int xW, int xC,
                int wOff, int bOff,
                int yOff, int yH, int yW, int yC,
                int kh, int kw,
                int sh, int sw, int pt, int pb, int pl, int pr,
                int dh, int dw, int group, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long co = p % yC;
                    long ox = (p / yC) % yW;
                    long oy = (p / (yC * yW)) % yH;
                    long nn = p / (yC * yW * yH);
                    int cpg = xC / group;
                    int ocpg = yC / group;
                    long g = co / ocpg;
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + co];   // 无偏置卷积（bOff=-1）
                    int ky = 0;
                    while (ky < kh) {
                        long iy = oy * sh - pt + ky * dh;
                        if (iy >= 0 && iy < xH) {
                            int kx = 0;
                            while (kx < kw) {
                                long ix = ox * sw - pl + kx * dw;
                                if (ix >= 0 && ix < xW) {
                                    int ic = 0;
                                    while (ic < cpg) {
                                        long cIn = g * cpg + ic;
                                        sum = sum + a[xOff + ((nn * xH + iy) * xW + ix) * xC + cIn]
                                                   * a[wOff + ((co * kh + ky) * kw + kx) * cpg + ic];
                                        ic = ic + 1;
                                    }
                                }
                                kx = kx + 1;
                            }
                        }
                        ky = ky + 1;
                    }
                    if (sum > 0.0f) a[yOff + p] = sum;
                    else a[yOff + p] = 0.0f;
                }
            }
        }

        // NHWC 最大池化：x:[N,H,W,C] → y:[N,yH,yW,C]
        void maxpoolNHWC(float[] a, int work,
                int xOff, int xN, int xH, int xW, int xC,
                int yOff, int yH, int yW,
                int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % xC;
                    long ox = (p / xC) % yW;
                    long oy = (p / (xC * yW)) % yH;
                    long nn = p / (xC * yW * yH);
                    float best = 0.0f - 1.0e30f;
                    int ky = 0;
                    while (ky < kh) {
                        long iy = oy * sh - pt + ky;
                        if (iy >= 0 && iy < xH) {
                            int kx = 0;
                            while (kx < kw) {
                                long ix = ox * sw - pl + kx;
                                if (ix >= 0 && ix < xW) {
                                    float v = a[xOff + ((nn * xH + iy) * xW + ix) * xC + c];
                                    if (v > best) best = v;
                                }
                                kx = kx + 1;
                            }
                        }
                        ky = ky + 1;
                    }
                    a[yOff + p] = best;
                }
            }
        }

        // AveragePool（NHWC）：x:[N,H,W,C] → y:[N,yH,yW,C]
        void avgpoolNHWC(float[] a, int work,
                int xOff, int xN, int xH, int xW, int xC,
                int yOff, int yH, int yW,
                int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr, int cip, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % xC;
                    long ox = (p / xC) % yW;
                    long oy = (p / (xC * yW)) % yH;
                    long nn = p / (xC * yW * yH);
                    float sum = 0.0f;
                    int cnt = 0;
                    int ky = 0;
                    while (ky < kh) {
                        long iy = oy * sh - pt + ky;
                        if (iy >= 0 && iy < xH) {
                            int kx = 0;
                            while (kx < kw) {
                                long ix = ox * sw - pl + kx;
                                if (ix >= 0 && ix < xW) {
                                    sum = sum + a[xOff + ((nn * xH + iy) * xW + ix) * xC + c];
                                    cnt = cnt + 1;
                                }
                                kx = kx + 1;
                            }
                        }
                        ky = ky + 1;
                    }
                    if (cip == 1) cnt = kh * kw;
                    if (cnt > 0) a[yOff + p] = sum / cnt;
                    else a[yOff + p] = 0.0f;
                }
            }
        }

        // Pad（NHWC）：x:[N,H,W,C] → y:[N,yH,yW,C]
        void padNHWC(float[] a, int work,
                 int xOff, int xN, int xH, int xW, int xC,
                 int yOff, int yN, int yH, int yW, int yC,
                 int pnB, int phB, int pwB, int pcB, int pnE, int phE, int pwE, int pcE,
                 int mode, double cval, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % yC;
                    long t = p / yC;
                    long w = t % yW;
                    t = t / yW;
                    long h = t % yH;
                    long n = t / yH;
                    long sn = n - pnB;
                    long sc = c - pcB;
                    long sh = h - phB;
                    long sw = w - pwB;
                    int inb = 1;
                    if (sn < 0 || sn >= xN) inb = 0;
                    if (sc < 0 || sc >= xC) inb = 0;
                    if (sh < 0 || sh >= xH) inb = 0;
                    if (sw < 0 || sw >= xW) inb = 0;
                    float v = 0.0f;
                    if (inb == 1) {
                        v = a[xOff + ((sn * xH + sh) * xW + sw) * xC + sc];
                    } else if (mode == 1) {
                        if (sn < 0) sn = 0L - sn;
                        if (sc < 0) sc = 0L - sc;
                        if (sh < 0) sh = 0L - sh;
                        if (sw < 0) sw = 0L - sw;
                        if (sn >= xN) sn = long(2 * (xN - 1)) - sn;
                        if (sc >= xC) sc = long(2 * (xC - 1)) - sc;
                        if (sh >= xH) sh = long(2 * (xH - 1)) - sh;
                        if (sw >= xW) sw = long(2 * (xW - 1)) - sw;
                        v = a[xOff + ((sn * xH + sh) * xW + sw) * xC + sc];
                    } else if (mode == 2) {
                        if (sn < 0) sn = 0L;
                        if (sc < 0) sc = 0L;
                        if (sh < 0) sh = 0L;
                        if (sw < 0) sw = 0L;
                        if (sn >= xN) sn = long(xN - 1);
                        if (sc >= xC) sc = long(xC - 1);
                        if (sh >= xH) sh = long(xH - 1);
                        if (sw >= xW) sw = long(xW - 1);
                        v = a[xOff + ((sn * xH + sh) * xW + sw) * xC + sc];
                    } else {
                        v = float(cval);
                    }
                    a[yOff + p] = v;
                }
            }
        }

        // NHWC 全局平均池化：x:[N,H,W,C] → y:[N,C]（work = N*C）
        void gapoolNHWC(float[] a, int work,
                int xOff, int xN, int xH, int xW, int xC, int yOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % xC;
                    long nn = p / xC;
                    float sum = 0.0f;
                    int i = 0;
                    while (i < xH * xW) {
                        long h = i / xW;
                        long w = i % xW;
                        sum = sum + a[xOff + ((nn * xH + h) * xW + w) * xC + c];
                        i = i + 1;
                    }
                    a[yOff + p] = sum / float(xH * xW);
                }
            }
        }

        // ---- G3：BatchNormalization ----
        // 每线程一个元素；通道 = (p/(H*W))%C（NCHW）。eps 由宿主解析传入，
        // Math.sqrt → libdevice __nv_sqrt；内核局部用 float（与 ORT float32 输出一致，
        // 混型运算已支持，double 局部也可用但无需更高精度）。
        void batchnorm(float[] a, int work,
                       int xOff, int xN, int xC, int xH, int xW, int yOff,
                       int sOff, int bOff, int mOff, int vOff, double eps, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = (p / (xH * xW)) % xC;
                    float scale = a[sOff + c];
                    float mean = a[mOff + c];
                    float variance = a[vOff + c];
                    float bias = a[bOff + c];
                    float invStd = scale / Math.sqrt(float(variance) + float(eps));
                    a[yOff + p] = float((a[xOff + p] - mean) * invStd + bias);
                }
            }
        }

        // G3：BatchNormalization（NHWC）：通道 = p % C
        void batchnormNHWC(float[] a, int work,
                           int xOff, int xN, int xH, int xW, int xC, int yOff,
                           int sOff, int bOff, int mOff, int vOff, double eps, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % xC;
                    float scale = a[sOff + c];
                    float mean = a[mOff + c];
                    float variance = a[vOff + c];
                    float bias = a[bOff + c];
                    float invStd = scale / Math.sqrt(float(variance) + float(eps));
                    a[yOff + p] = float((a[xOff + p] - mean) * invStd + bias);
                }
            }
        }

        // ---- G4：通用激活（逐元素，布局无关）----
        // ReLU6：y = min(max(x,0),6)
        void relu6(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float v = a[inOff + p];
                    if (v > 6.0f) v = 6.0f;
                    if (v < 0.0f) v = 0.0f;
                    a[outOff + p] = v;
                }
            }
        }
        // LeakyRelu：y = x>0 ? x : alpha*x
        void leakyrelu(float[] a, int work, int inOff, int outOff, double alpha, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float v = a[inOff + p];
                    if (v > 0.0f) a[outOff + p] = v;
                    else a[outOff + p] = float(alpha) * v;
                }
            }
        }
        // SiLU / Swish：y = x * sigmoid(x) = x / (1 + exp(-x))
        void silu(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float x = a[inOff + p];
                    float s = x / float(1.0 + Math.exp(0.0f - x));
                    a[outOff + p] = s;
                }
            }
        }
        // HardSwish：y = x * relu6(x+3) / 6
        void hardswish(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float x = a[inOff + p];
                    float r = x + 3.0f;
                    if (r < 0.0f) r = 0.0f;
                    if (r > 6.0f) r = 6.0f;
                    a[outOff + p] = x * r / 6.0f;
                }
            }
        }
        // Clip：y = clamp(x, min, max)；minOff/maxOff 为标量边界偏移（-1 = 不限）
        void clip(float[] a, int work, int inOff, int outOff, int minOff, int maxOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float v = a[inOff + p];
                    if (minOff >= 0 && v < a[minOff + 0]) v = a[minOff + 0];
                    if (maxOff >= 0 && v > a[maxOff + 0]) v = a[maxOff + 0];
                    a[outOff + p] = v;
                }
            }
        }

        // ---- F8：张量操作（Reshape / Concat / Transpose）----
        // Reshape：连续拷贝
        void copyFlat(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    a[outOff + p] = a[inOff + p];
                }
            }
        }
        // Concat：沿 axis 拼接 2-3 输入
        void concat(float[] a, int work, int off0, int off1, int off2, int offO,
                    int od0, int od1, int od2, int od3,
                    int ax0, int ax1, int ax2, int axis, int nIn, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int i = int(p);
                    int x3 = i % od3;
                    int t = i / od3;
                    int x2 = t % od2;
                    t = t / od2;
                    int x1 = t % od1;
                    int x0 = t / od1;
                    int ac = x3;
                    if (axis == 0) ac = x0;
                    else if (axis == 1) ac = x1;
                    else if (axis == 2) ac = x2;
                    int which = 0;
                    int local = ac;
                    int aLen = ax0;
                    if (local >= aLen) {
                        local = local - aLen;
                        which = 1;
                        aLen = ax1;
                        if (nIn >= 3 && local >= aLen) { local = local - aLen; which = 2; aLen = ax2; }
                    }
                    int inOff = off0;
                    if (which == 1) inOff = off1;
                    else if (which == 2) inOff = off2;
                    int inFlat = 0;
                    if (axis == 0) inFlat = ((local * od1 + x1) * od2 + x2) * od3 + x3;
                    else if (axis == 1) inFlat = ((x0 * aLen + local) * od2 + x2) * od3 + x3;
                    else if (axis == 2) inFlat = ((x0 * od1 + x1) * aLen + local) * od3 + x3;
                    else inFlat = ((x0 * od1 + x1) * od2 + x2) * aLen + local;
                    a[offO + i] = a[inOff + inFlat];
                }
            }
        }
        // Concat 反向（opKind 72）：thread-per-output-element，每线程把 dy 散射到
        // 唯一对应的输入 dx 位置（concat 双射 → 无竞争、无需清零）。布局同前向。
        void bwdConcat(float[] a, long dev, int dyOff, int dx0Off, int dx1Off, int dx2Off,
                       int axis, int nIn, int od0, int od1, int od2, int od3,
                       int ax0, int ax1, int ax2) {
            @gpu for (long p = 0L; p < long(od0 * od1 * od2 * od3); p = p + 1L) resident(a = dev) {
                if (p < od0 * od1 * od2 * od3) {
                    int i = int(p);
                    int x3 = i % od3;
                    int t = i / od3;
                    int x2 = t % od2;
                    t = t / od2;
                    int x1 = t % od1;
                    int x0 = t / od1;
                    int ac = x3;
                    if (axis == 0) ac = x0;
                    else if (axis == 1) ac = x1;
                    else if (axis == 2) ac = x2;
                    int which = 0;
                    int local = ac;
                    int aLen = ax0;
                    if (local >= aLen) {
                        local = local - aLen;
                        which = 1;
                        aLen = ax1;
                        if (nIn >= 3 && local >= aLen) { local = local - aLen; which = 2; aLen = ax2; }
                    }
                    int dxOff = dx0Off;
                    if (which == 1) dxOff = dx1Off;
                    else if (which == 2) dxOff = dx2Off;
                    int inFlat = 0;
                    if (axis == 0) inFlat = ((local * od1 + x1) * od2 + x2) * od3 + x3;
                    else if (axis == 1) inFlat = ((x0 * aLen + local) * od2 + x2) * od3 + x3;
                    else if (axis == 2) inFlat = ((x0 * od1 + x1) * aLen + local) * od3 + x3;
                    else inFlat = ((x0 * od1 + x1) * od2 + x2) * aLen + local;
                    a[dxOff + inFlat] = a[dyOff + i];
                }
            }
        }
        // Transpose：按 perm 转置 4D（pc = perm 元素数，0 = 缺省反转）
        void transpose(float[] a, int work, int offIn, int offOut,
                       int id0, int id1, int id2, int id3,
                       int p0, int p1, int p2, int p3, int pc, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int perm0 = p0, perm1 = p1, perm2 = p2, perm3 = p3;
                    if (pc == 0) { perm0 = 3; perm1 = 2; perm2 = 1; perm3 = 0; }
                    else if (pc == 1) { perm1 = 1; perm2 = 2; perm3 = 3; }
                    else if (pc == 2) { perm2 = 2; perm3 = 3; }
                    else if (pc == 3) { perm3 = 3; }
                    int od0 = id3, od1 = id3, od2 = id3, od3 = id3;
                    if (perm0 == 0) od0 = id0; else if (perm0 == 1) od0 = id1; else if (perm0 == 2) od0 = id2;
                    if (perm1 == 0) od1 = id0; else if (perm1 == 1) od1 = id1; else if (perm1 == 2) od1 = id2;
                    if (perm2 == 0) od2 = id0; else if (perm2 == 1) od2 = id1; else if (perm2 == 2) od2 = id2;
                    if (perm3 == 0) od3 = id0; else if (perm3 == 1) od3 = id1; else if (perm3 == 2) od3 = id2;
                    int inv0 = 3, inv1 = 3, inv2 = 3, inv3 = 3;
                    if (perm0 == 0) inv0 = 0; else if (perm1 == 0) inv0 = 1; else if (perm2 == 0) inv0 = 2;
                    if (perm0 == 1) inv1 = 0; else if (perm1 == 1) inv1 = 1; else if (perm2 == 1) inv1 = 2;
                    if (perm0 == 2) inv2 = 0; else if (perm1 == 2) inv2 = 1; else if (perm2 == 2) inv2 = 2;
                    if (perm0 == 3) inv3 = 0; else if (perm1 == 3) inv3 = 1; else if (perm2 == 3) inv3 = 2;
                    int i = int(p);
                    int o3 = i % od3;
                    int t = i / od3;
                    int o2 = t % od2;
                    t = t / od2;
                    int o1 = t % od1;
                    int o0 = t / od1;
                    int i0 = o3, i1 = o3, i2 = o3, i3 = o3;
                    if (inv0 == 0) i0 = o0; else if (inv0 == 1) i0 = o1; else if (inv0 == 2) i0 = o2;
                    if (inv1 == 0) i1 = o0; else if (inv1 == 1) i1 = o1; else if (inv1 == 2) i1 = o2;
                    if (inv2 == 0) i2 = o0; else if (inv2 == 1) i2 = o1; else if (inv2 == 2) i2 = o2;
                    if (inv3 == 0) i3 = o0; else if (inv3 == 1) i3 = o1; else if (inv3 == 2) i3 = o2;
                    int inFlat = ((i0 * id1 + i1) * id2 + i2) * id3 + i3;
                    a[offOut + i] = a[offIn + inFlat];
                }
            }
        }
        // Slice：沿任意轴切片（支持负 step 反向）；轴循环展开（GPU codegen 不支持内核内 while）
        void sliceOp(float[] a, int work, int offIn, int offOut,
                     int cnt, int id0, int id1, int id2, int id3,
                     int od0, int od1, int od2, int od3,
                     int ax0, int st0, int sp0, int ax1, int st1, int sp1,
                     int ax2, int st2, int sp2, int ax3, int st3, int sp3, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int i = int(p);
                    int x3 = i % od3;
                    int t = i / od3;
                    int x2 = t % od2;
                    t = t / od2;
                    int x1 = t % od1;
                    int x0 = t / od1;
                    int c0 = x0, c1 = x1, c2 = x2, c3 = x3;
                    int oc = x0; int ic = 0;
                    if (cnt >= 1) {
                        oc = x0;
                        if (ax0 == 0) oc = x0; else if (ax0 == 1) oc = x1; else if (ax0 == 2) oc = x2; else oc = x3;
                        ic = st0 + oc * sp0;
                        if (ax0 == 0) c0 = ic; else if (ax0 == 1) c1 = ic; else if (ax0 == 2) c2 = ic; else c3 = ic;
                    }
                    if (cnt >= 2) {
                        oc = x0;
                        if (ax1 == 0) oc = x0; else if (ax1 == 1) oc = x1; else if (ax1 == 2) oc = x2; else oc = x3;
                        ic = st1 + oc * sp1;
                        if (ax1 == 0) c0 = ic; else if (ax1 == 1) c1 = ic; else if (ax1 == 2) c2 = ic; else c3 = ic;
                    }
                    if (cnt >= 3) {
                        oc = x0;
                        if (ax2 == 0) oc = x0; else if (ax2 == 1) oc = x1; else if (ax2 == 2) oc = x2; else oc = x3;
                        ic = st2 + oc * sp2;
                        if (ax2 == 0) c0 = ic; else if (ax2 == 1) c1 = ic; else if (ax2 == 2) c2 = ic; else c3 = ic;
                    }
                    if (cnt >= 4) {
                        oc = x0;
                        if (ax3 == 0) oc = x0; else if (ax3 == 1) oc = x1; else if (ax3 == 2) oc = x2; else oc = x3;
                        ic = st3 + oc * sp3;
                        if (ax3 == 0) c0 = ic; else if (ax3 == 1) c1 = ic; else if (ax3 == 2) c2 = ic; else c3 = ic;
                    }
                    int inFlat = ((c0 * id1 + c1) * id2 + c2) * id3 + c3;
                    a[offOut + i] = a[offIn + inFlat];
                }
            }
        }

        // ---- F8：秩无关逐元素 / 规约 / 归一化 / 分割 / 上采样（GPU）----
        // Sub：y = a - b（bSize==1 标量；bSize==n 同尺寸；bSize==C 逐通道广播）
        void sub(float[] a, int work, int aOff, int bOff, int outOff, int bSize, int C, int S,
                 int an, int ac, int ah, int aw, int bn, int bc, int bh, int bw,
                 int on, int oc, int oh, int ow, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float bv = 0.0f;
                    if (bSize <= 1) bv = a[bOff + 0];
                    float v = a[aOff + p];
                    if (bSize <= 1) a[outOff + p] = v - bv;
                    else if (bSize == work && an == on && ac == oc && ah == oh && aw == ow && bn == on && bc == oc && bh == oh && bw == ow) a[outOff + p] = v - a[bOff + p];
                    else if (bSize == C && bn == 1 && bc == C && bh == 1 && bw == 1) a[outOff + p] = v - a[bOff + (int(p) / S) % C];
                    else {
                        int i = int(p);
                        int w3 = i % ow;
                        int t = i / ow;
                        int w2 = t % oh;
                        t = t / oh;
                        int w1 = t % oc;
                        int w0 = t / oc;
                        int a0 = (an == 1) ? 0 : (w0 % an);
                        int a1 = (ac == 1) ? 0 : (w1 % ac);
                        int a2 = (ah == 1) ? 0 : (w2 % ah);
                        int a3 = (aw == 1) ? 0 : (w3 % aw);
                        int aF = ((a0 * ac + a1) * ah + a2) * aw + a3;
                        int b0 = (bn == 1) ? 0 : (w0 % bn);
                        int b1 = (bc == 1) ? 0 : (w1 % bc);
                        int b2 = (bh == 1) ? 0 : (w2 % bh);
                        int b3 = (bw == 1) ? 0 : (w3 % bw);
                        int bF = ((b0 * bc + b1) * bh + b2) * bw + b3;
                        a[outOff + i] = a[aOff + aF] - a[bOff + bF];
                    }
                }
            }
        }
        // Div：y = a / b
        void div(float[] a, int work, int aOff, int bOff, int outOff, int bSize, int C, int S,
                 int an, int ac, int ah, int aw, int bn, int bc, int bh, int bw,
                 int on, int oc, int oh, int ow, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float bv = 0.0f;
                    if (bSize <= 1) bv = a[bOff + 0];
                    float v = a[aOff + p];
                    if (bSize <= 1) a[outOff + p] = v / bv;
                    else if (bSize == work && an == on && ac == oc && ah == oh && aw == ow && bn == on && bc == oc && bh == oh && bw == ow) a[outOff + p] = v / a[bOff + p];
                    else if (bSize == C && bn == 1 && bc == C && bh == 1 && bw == 1) a[outOff + p] = v / a[bOff + (int(p) / S) % C];
                    else {
                        int i = int(p);
                        int w3 = i % ow;
                        int t = i / ow;
                        int w2 = t % oh;
                        t = t / oh;
                        int w1 = t % oc;
                        int w0 = t / oc;
                        int a0 = (an == 1) ? 0 : (w0 % an);
                        int a1 = (ac == 1) ? 0 : (w1 % ac);
                        int a2 = (ah == 1) ? 0 : (w2 % ah);
                        int a3 = (aw == 1) ? 0 : (w3 % aw);
                        int aF = ((a0 * ac + a1) * ah + a2) * aw + a3;
                        int b0 = (bn == 1) ? 0 : (w0 % bn);
                        int b1 = (bc == 1) ? 0 : (w1 % bc);
                        int b2 = (bh == 1) ? 0 : (w2 % bh);
                        int b3 = (bw == 1) ? 0 : (w3 % bw);
                        int bF = ((b0 * bc + b1) * bh + b2) * bw + b3;
                        a[outOff + i] = a[aOff + aF] / a[bOff + bF];
                    }
                }
            }
        }
        // Mul：y = a * b
        void mul(float[] a, int work, int aOff, int bOff, int outOff, int bSize, int C, int S,
                 int an, int ac, int ah, int aw, int bn, int bc, int bh, int bw,
                 int on, int oc, int oh, int ow, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float bv = 0.0f;
                    if (bSize <= 1) bv = a[bOff + 0];
                    float v = a[aOff + p];
                    if (bSize <= 1) a[outOff + p] = v * bv;
                    else if (bSize == work && an == on && ac == oc && ah == oh && aw == ow && bn == on && bc == oc && bh == oh && bw == ow) a[outOff + p] = v * a[bOff + p];
                    else if (bSize == C && bn == 1 && bc == C && bh == 1 && bw == 1) a[outOff + p] = v * a[bOff + (int(p) / S) % C];
                    else {
                        int i = int(p);
                        int w3 = i % ow;
                        int t = i / ow;
                        int w2 = t % oh;
                        t = t / oh;
                        int w1 = t % oc;
                        int w0 = t / oc;
                        int a0 = (an == 1) ? 0 : (w0 % an);
                        int a1 = (ac == 1) ? 0 : (w1 % ac);
                        int a2 = (ah == 1) ? 0 : (w2 % ah);
                        int a3 = (aw == 1) ? 0 : (w3 % aw);
                        int aF = ((a0 * ac + a1) * ah + a2) * aw + a3;
                        int b0 = (bn == 1) ? 0 : (w0 % bn);
                        int b1 = (bc == 1) ? 0 : (w1 % bc);
                        int b2 = (bh == 1) ? 0 : (w2 % bh);
                        int b3 = (bw == 1) ? 0 : (w3 % bw);
                        int bF = ((b0 * bc + b1) * bh + b2) * bw + b3;
                        a[outOff + i] = a[aOff + aF] * a[bOff + bF];
                    }
                }
            }
        }
        // Sqrt：y = sqrt(x)
        void sqrt1(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    a[outOff + p] = Math.sqrt(a[inOff + p]);
                }
            }
        }
        // Expand：broadcast 复制（G4）。输入 4D id0-3，输出 4D od0-3；维=1 复制。
        void expand(float[] a, int work, int inOff, int outOff,
                    int id0, int id1, int id2, int id3,
                    int od0, int od1, int od2, int od3, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int i = int(p);
                    int x3 = i % od3;
                    int t = i / od3;
                    int x2 = t % od2;
                    t = t / od2;
                    int x1 = t % od1;
                    int x0 = t / od1;
                    int c0 = (id0 == 1) ? 0 : x0;
                    int c1 = (id1 == 1) ? 0 : x1;
                    int c2 = (id2 == 1) ? 0 : x2;
                    int c3 = (id3 == 1) ? 0 : x3;
                    int inFlat = ((c0 * id1 + c1) * id2 + c2) * id3 + c3;
                    a[outOff + i] = a[inOff + inFlat];
                }
            }
        }
        // Where（G5）：逐元素选择 out = cond ? x : y，三输入各自 4D 广播
        // （维=1 → 0，其余 % 输入维）。thread-per-output-element。
        // 注意：`where` 是 MYP 保留字（mapping 过滤），函数名用 where1。
        void where1(float[] a, int work, int cOff, int xOff, int yOff, int oOff,
                   int oc, int oh, int ow,
                   int cn, int cc, int ch, int cw,
                   int xn, int xc, int xh, int xw,
                   int yn, int yc, int yh, int yw, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int i = int(p);
                    int w3 = i % ow;
                    int t = i / ow;
                    int w2 = t % oh;
                    t = t / oh;
                    int w1 = t % oc;
                    int w0 = t / oc;
                    int c0 = (cn == 1) ? 0 : (w0 % cn);
                    int c1 = (cc == 1) ? 0 : (w1 % cc);
                    int c2 = (ch == 1) ? 0 : (w2 % ch);
                    int c3 = (cw == 1) ? 0 : (w3 % cw);
                    int cFlat = ((c0 * cc + c1) * ch + c2) * cw + c3;
                    int x0 = (xn == 1) ? 0 : (w0 % xn);
                    int x1 = (xc == 1) ? 0 : (w1 % xc);
                    int x2 = (xh == 1) ? 0 : (w2 % xh);
                    int x3 = (xw == 1) ? 0 : (w3 % xw);
                    int xFlat = ((x0 * xc + x1) * xh + x2) * xw + x3;
                    int y0 = (yn == 1) ? 0 : (w0 % yn);
                    int y1 = (yc == 1) ? 0 : (w1 % yc);
                    int y2 = (yh == 1) ? 0 : (w2 % yh);
                    int y3 = (yw == 1) ? 0 : (w3 % yw);
                    int yFlat = ((y0 * yc + y1) * yh + y2) * yw + y3;
                    if (a[cOff + cFlat] > float(0.0)) { a[oOff + i] = a[xOff + xFlat]; }
                    else { a[oOff + i] = a[yOff + yFlat]; }
                }
            }
        }
        // Tile（G5）：沿各维按倍数复制 out = tile(in, repeats)。输出 index % 输入维
        // （维=1 → 0）。thread-per-output-element。
        void tile(float[] a, int work, int inOff, int outOff,
                  int id0, int id1, int id2, int id3,
                  int od0, int od1, int od2, int od3, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int i = int(p);
                    int x3 = i % od3;
                    int t = i / od3;
                    int x2 = t % od2;
                    t = t / od2;
                    int x1 = t % od1;
                    int x0 = t / od1;
                    int c0 = (id0 == 1) ? 0 : (x0 % id0);
                    int c1 = (id1 == 1) ? 0 : (x1 % id1);
                    int c2 = (id2 == 1) ? 0 : (x2 % id2);
                    int c3 = (id3 == 1) ? 0 : (x3 % id3);
                    int inFlat = ((c0 * id1 + c1) * id2 + c2) * id3 + c3;
                    a[outOff + i] = a[inOff + inFlat];
                }
            }
        }
        // Gather（G5）：沿 axis 按 indices 收集。thread-per-output-element。
        // indices 存 float arena（int→float），读 int(a[iOff+k])；负索引 +dim，clamp。
        void gather(float[] a, int work, int dOff, int iOff, int oOff,
                    int axis, int lenIdx, int dn, int dc, int dh, int dw,
                    int on, int oc, int oh, int ow, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int i = int(p);
                    int w3 = i % ow;
                    int t = i / ow;
                    int w2 = t % oh;
                    t = t / oh;
                    int w1 = t % oc;
                    int w0 = t / oc;
                    int axIdx = (axis == 0) ? w0 : ((axis == 1) ? w1 : ((axis == 2) ? w2 : w3));
                    int dim = (axis == 0) ? dn : ((axis == 1) ? dc : ((axis == 2) ? dh : dw));
                    int id = int(a[iOff + axIdx]);
                    if (id < 0) id = id + dim;
                    if (id < 0) id = 0;
                    if (id >= dim) id = dim - 1;
                    int dn2 = (axis == 0) ? id : w0;
                    int dc2 = (axis == 1) ? id : w1;
                    int dh2 = (axis == 2) ? id : w2;
                    int dw2 = (axis == 3) ? id : w3;
                    int dFlat = ((dn2 * dc + dc2) * dh + dh2) * dw + dw2;
                    a[oOff + i] = a[dOff + dFlat];
                }
            }
        }
        // LogSoftmax（G5）：沿 axis 稳定 log-softmax。thread-per-(outer*inner) 列，
        // 每线程在 axisDim 上归约（同 softmax 模式）。
        void logSoftmax(float[] a, int work, int inOff, int outOff, int outer, int axisDim, int inner, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int oi = int(p / long(inner));
                    int ii = int(p % long(inner));
                    float m = a[inOff + (oi * axisDim + 0) * inner + ii];
                    int k = 1;
                    while (k < axisDim) {
                        float v = a[inOff + (oi * axisDim + k) * inner + ii];
                        if (v > m) m = v;
                        k = k + 1;
                    }
                    float sum = 0.0f;
                    k = 0;
                    while (k < axisDim) {
                        float e = Math.exp(a[inOff + (oi * axisDim + k) * inner + ii] - m);
                        sum = sum + e;
                        k = k + 1;
                    }
                    float lse = m + Math.log(sum);
                    k = 0;
                    while (k < axisDim) {
                        float v = a[inOff + (oi * axisDim + k) * inner + ii];
                        a[outOff + (oi * axisDim + k) * inner + ii] = float(v - lse);
                        k = k + 1;
                    }
                }
            }
        }
        // Embedding（G5）：查表 out[s*D+d] = w[ids[s]*D+d]。thread-per-(s*D)。
        void embedding(float[] a, int work, int wOff, int idOff, int oOff, int vocab, int D, int S, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int s = int(p / long(D));
                    int d = int(p % long(D));
                    int id = int(a[idOff + s]);
                    if (id < 0) id = 0;
                    if (id >= vocab) id = vocab - 1;
                    a[oOff + p] = a[wOff + id * D + d];
                }
            }
        }
        // InstanceNormalization：逐 (n,c) 线程，S 上归约（float 累加）
        // 激进优化（2026-08-12）：3 阶段满并行，替代原"每通道 1 线程 × 串行 3 趟"
        // （原实现 work=N*C 个线程，每线程串行 3 趟 7M double → GPU 欠利用，占推理 87%）。
        //   P1：grid-stride 每线程寄存器累加 Σx → 每线程 1 次 double 原子入 sums[nc]
        //   P2：grid-stride 每线程寄存器累加 Σ(x-mean)² → 原子入 sqs[nc]
        //   Host：mean / invStd=scale/sqrt(var+eps)（每通道 nC 个）
        //   P3：thread-per-element 归一化（满并行）
        // 精度：保持 double 累加 + 两趟（与 CPU/ORT 一致）；仅求和顺序变（~1e-15）。
        // scale/bias 是只读 Constant，host arena 未被设备改写，可 host 读。
        // 激进优化（全 resident 单数组版，2026-08-12）：3 阶段满并行，替代原
        // "每通道 1 线程 × 串行 3 趟"（原 412ms/层，占推理 87%）。
        // 约束（已验证）：@gpu for 只能可靠使用"单数组 resident(a=dev)"；多数组/
        // 原子路径均坏。故 stats（partials/mean/invStd）写入 arena 尾部预留区 stOff，
        // 全部在设备上计算，host 不介入。精度：partial 存 float（均值误差~1e-7，
        // 因除以大 S 后被稀释），保持两趟 double 累加语义。
        // K1: grid-stride Σx → p1   K2: 每通道 Σp1 → mean
        // K3: grid-stride Σ(x-mean)² → p2   K4: 每通道 Σp2 → variance, invStd
        // K5: thread-per-element 归一化
        void instancenorm(float[] a, int work, int xOff, int sOff, int bOff, int yOff,
                          int N, int C, int S, double eps, long dev, int stOff, int doRelu) {
            int nC = work;
            long total = long(nC) * long(S);
            int pt = 512;                 // 每通道归约线程数
            long nTh = long(nC) * long(pt);
            int p1Off = stOff;
            int p2Off = stOff + nC * pt;
            int mnOff = stOff + 2 * nC * pt;
            int ivOff = mnOff + nC;
            // K1：grid-stride Σx → p1
            @gpu for (long p = 0L; p < nTh; p = p + 1L) resident(a = dev) {
                if (p < nTh) {
                    int nc1 = int(p / long(pt));
                    int b1 = int(p % long(pt));
                    long base1 = long(nc1) * long(S);
                    double acc1 = 0.0;
                    long q1 = base1 + long(b1);
                    while (q1 < base1 + long(S)) {
                        double xv1 = a[xOff + int(q1)];
                        acc1 = acc1 + xv1;
                        q1 = q1 + long(pt);
                    }
                    a[p1Off + nc1 * pt + b1] = float(acc1);
                }
            }
            // K2：每通道 mean = Σp1 / S
            @gpu for (long p = 0L; p < long(nC); p = p + 1L) resident(a = dev) {
                if (p < nC) {
                    int c2 = int(p);
                    double s2 = 0.0;
                    int b2 = 0;
                    while (b2 < pt) {
                        double v2 = a[p1Off + c2 * pt + b2];
                        s2 = s2 + v2;
                        b2 = b2 + 1;
                    }
                    a[mnOff + c2] = float(s2 / S);
                }
            }
            // K3：grid-stride Σ(x-mean)² → p2
            @gpu for (long p = 0L; p < nTh; p = p + 1L) resident(a = dev) {
                if (p < nTh) {
                    int nc3 = int(p / long(pt));
                    int b3 = int(p % long(pt));
                    long base3 = long(nc3) * long(S);
                    double mn3 = a[mnOff + nc3];
                    double acc3 = 0.0;
                    long q3 = base3 + long(b3);
                    while (q3 < base3 + long(S)) {
                        double xv3 = a[xOff + int(q3)];
                        double d3 = xv3 - mn3;
                        acc3 = acc3 + d3 * d3;
                        q3 = q3 + long(pt);
                    }
                    a[p2Off + nc3 * pt + b3] = float(acc3);
                }
            }
            // K4：每通道 variance / invStd = scale / sqrt(var+eps)
            @gpu for (long p = 0L; p < long(nC); p = p + 1L) resident(a = dev) {
                if (p < nC) {
                    int c4 = int(p);
                    double sq4 = 0.0;
                    int b4 = 0;
                    while (b4 < pt) {
                        double v4 = a[p2Off + c4 * pt + b4];
                        sq4 = sq4 + v4;
                        b4 = b4 + 1;
                    }
                    double variance = sq4 / S;
                    double scale = a[sOff + c4];
                    a[ivOff + c4] = float(scale / Math.sqrt(variance + eps));
                }
            }
            // K5：归一化——每线程 pt5 元素网格步进（除法仅线程级一次，循环内顺序访问
            // 无除法；pt5=1024 保持足够线程数/MLP——此前 256 线程太少反更慢）
            int pt5 = 1024;
            long nTh5 = long(nC) * long(pt5);
            @gpu for (long p = 0L; p < nTh5; p = p + 1L) resident(a = dev) {
                if (p < nTh5) {
                    int nc5 = int(p / long(pt5));
                    int b5 = int(p % long(pt5));
                    long base5 = long(nc5) * long(S);
                    double mn5 = a[mnOff + nc5];
                    double iv5 = a[ivOff + nc5];
                    int cc5 = nc5 % C;
                    double bias5 = a[bOff + cc5];
                    long q5 = base5 + long(b5);
                    if (doRelu == 1) {
                        while (q5 < base5 + long(S)) {
                            double xv5 = a[xOff + int(q5)];
                            float v5 = float((xv5 - mn5) * iv5 + bias5);
                            if (v5 < 0.0f) v5 = 0.0f;
                            a[yOff + int(q5)] = v5;
                            q5 = q5 + long(pt5);
                        }
                    } else {
                        while (q5 < base5 + long(S)) {
                            double xv5 = a[xOff + int(q5)];
                            a[yOff + int(q5)] = float((xv5 - mn5) * iv5 + bias5);
                            q5 = q5 + long(pt5);
                        }
                    }
                }
            }
        }
        // RMSNorm（通用，2026-08-21）：现代 LLM 标准归一化。
        // 固化 LLM GPU 优化验证的「rstd 独立小核」模式（gpu_llm_ops_batch.rstdBatch）：
        //   K1：rstd[N] 独立 grid=N 小核 —— 统计量只算一次，避免"每元素线程冗余重算
        //       mean(x²)"（batch/维度大时这是隐藏热点；LLM 实测 gateup 2.4x）。
        //   K2：thread-per-element 满并行归一化（instancenorm K5 同款）。
        // 布局：x/y 按 [D, N] feature-major（x[d*N+s]，LLM 批量布局约定；N=1 即单向量）。
        //   y[d*N+s] = x[d*N+s] * rstd[s] * gamma[d]，rstd[s] = 1/sqrt(mean_d x²+eps)。
        // gOff<0 表示无 gamma（y = x*rstd）。stats 写 stOff（须 N 个 float 预留，arena 尾部）。
        void rmsnorm(float[] a, int work, int xOff, int gOff, int yOff, int D, int N, double eps, long dev, int stOff) {
            // K1：rstd[N] 独立小核（grid=N）—— 统计量预计算一次，消除冗余重算
            @gpu for (long si = 0L; si < long(N); si = si + 1L) resident(a = dev) {
                if (si < long(N)) {
                    int st = int(si);
                    double sum2 = 0.0;
                    int dd = 0;
                    while (dd < D) {
                        double xv = a[xOff + dd * N + st];
                        sum2 = sum2 + xv * xv;
                        dd = dd + 1;
                    }
                    a[stOff + st] = float(1.0 / Math.sqrt(sum2 / double(D) + eps));
                }
            }
            // K2：thread-per-element 归一化（满并行；每线程只读一次 rstd，无除法）
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int dd = int(p / long(N));
                    int ss = int(p % long(N));
                    float rstd = a[stOff + ss];
                    float gv = 1.0f;
                    if (gOff >= 0) gv = a[gOff + dd];
                    a[yOff + p] = a[xOff + p] * rstd * gv;
                }
            }
        }
        // LayerNorm（通用，2026-08-21）：与 rmsnorm 同构的「统计量独立小核」模式，但带
        // mean/var（每 token 一次两趟归约）+ gamma/beta[D]（GPT-2 等使用）。
        //   y[d*N+s] = (x[d*N+s]-mean[s]) * invStd[s] * gamma[d] + beta[d]
        // K1：mean[s]/invStd[s] 独立 grid=N 小核（统计量只算一次）；K2：thread-per-element。
        // stOff 须 2*N 个 float（mean、invStd 交错）。gOff<0 无 gamma，bOff<0 无 beta。
        void layernorm(float[] a, int work, int xOff, int gOff, int bOff, int yOff, int D, int N, double eps, long dev, int stOff) {
            // K1：mean/invStd 独立小核（grid=N）
            @gpu for (long si = 0L; si < long(N); si = si + 1L) resident(a = dev) {
                if (si < long(N)) {
                    int st = int(si);
                    double sum = 0.0;
                    int dd = 0;
                    while (dd < D) { sum = sum + double(a[xOff + dd * N + st]); dd = dd + 1; }
                    double mean = sum / double(D);
                    double ss = 0.0;
                    dd = 0;
                    while (dd < D) {
                        double dv = double(a[xOff + dd * N + st]) - mean;
                        ss = ss + dv * dv;
                        dd = dd + 1;
                    }
                    a[stOff + st * 2] = float(mean);
                    a[stOff + st * 2 + 1] = float(1.0 / Math.sqrt(ss / double(D) + eps));
                }
            }
            // K2：thread-per-element 归一化（每线程只读一次 mean/invStd）
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int dd = int(p / long(N));
                    int ss = int(p % long(N));
                    float mean = a[stOff + ss * 2];
                    float iv = a[stOff + ss * 2 + 1];
                    float gv = 1.0f;
                    float bv = 0.0f;
                    if (gOff >= 0) gv = a[gOff + dd];
                    if (bOff >= 0) bv = a[bOff + dd];
                    a[yOff + p] = (a[xOff + p] - mean) * iv * gv + bv;
                }
            }
        }
        // GroupNorm（GPU）：x:[N*C,H*W]（NCHW 行优先），gamma/beta:[C]。K1 grid=N*groups
        // 每线程一 (n,g) 算 mean/rstd→stOff[n*groups+g]；K2 thread-per-element 应用。
        void groupnorm(float[] a, int work, int xOff, int gOff, int bOff, int yOff,
                       int N, int C, int H, int W, int groups, double eps, long dev, int stOff) {
            int cpg = C / groups;
            if (cpg < 1) cpg = 1;
            int hw = H * W;
            long ng = long(N) * long(groups);
            @gpu for (long gi = 0L; gi < ng; gi = gi + 1L) resident(a = dev) {
                if (gi < ng) {
                    int nn = int(gi / long(groups));
                    int g = int(gi % long(groups));
                    int nch = cpg * hw;
                    double sum = 0.0;
                    int c = 0;
                    while (c < cpg) {
                        int p = 0;
                        while (p < hw) { sum = sum + double(a[xOff + (nn * C + g * cpg + c) * hw + p]); p = p + 1; }
                        c = c + 1;
                    }
                    double mean = sum / double(nch);
                    double ss = 0.0;
                    c = 0;
                    while (c < cpg) {
                        int p = 0;
                        while (p < hw) {
                            double dv = double(a[xOff + (nn * C + g * cpg + c) * hw + p]) - mean;
                            ss = ss + dv * dv;
                            p = p + 1;
                        }
                        c = c + 1;
                    }
                    a[stOff + int(gi) * 2] = float(mean);
                    a[stOff + int(gi) * 2 + 1] = float(1.0 / Math.sqrt(ss / double(nch) + eps));
                }
            }
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int row = int(p / long(hw));   // [0, N*C)
                    int pp = int(p % long(hw));
                    int nn = row / C;
                    int cc = row % C;
                    int g = cc / cpg;
                    float mean = a[stOff + (nn * groups + g) * 2];
                    float iv = a[stOff + (nn * groups + g) * 2 + 1];
                    float gv = 1.0f;
                    float bv = 0.0f;
                    if (gOff >= 0) gv = a[gOff + cc];
                    if (bOff >= 0) bv = a[bOff + cc];
                    a[yOff + p] = (a[xOff + p] - mean) * iv * gv + bv;
                }
            }
        }
        // GELU（通用，element-wise，2026-08-21）：y = 0.5*x*(1+erf(x/√2))。
        // 内联 Abramowitz-Stegun 7.1.26 erf 近似（与 ops.myp InferOps.gelu 同实现，误差<1.5e-7）。
        void gelu(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    double x = double(a[inOff + p]);
                    double z = x / 1.4142135623730951;
                    double az = Math.abs(z);
                    double t = 1.0 / (1.0 + 0.3275911 * az);
                    double y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(0.0 - az * az);
                    double erf = y;
                    if (z < 0.0) erf = 0.0 - y;
                    a[outOff + p] = float(0.5 * x * (1.0 + erf));
                }
            }
        }
        // ==================== LLM 算子 GPU 内核补全（2026-09-01，opKind 62/63/66/67）====================
        // 对齐 ops.myp InferOps 语义 + 本文件「resident 单数组 + @gpu for」模式，配合
        // ops_iface_all.myp 的 Gpu* 接口类 → runGpu() 全 opKind 统一分派（接口框架
        // CPU+GPU 100% 覆盖）。rmsnorm(61)/layernorm(64)/gelu(65) 已有，此处补
        // gatherRows/rope/attention/attentionCached。

        // gatherRows（opKind 63）：embedding 查表。eOff:[vocab,D]，idOff:[S]（token id），
        // xOff:[D,S] 输出。thread-per-output-element：x[d*S+s] = e[id(s)*D + d]。
        void gatherRows(float[] a, int work, int eOff, int idOff, int xOff, int vocab, int D, int S, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int dd = int(p / long(S));
                    int ss = int(p % long(S));
                    int id = int(a[idOff + ss]);
                    if (id < 0) id = 0;
                    if (id >= vocab) id = vocab - 1;
                    a[xOff + int(p)] = a[eOff + id * D + dd];
                }
            }
        }

        // rope（opKind 66）：RoPE（Llama 逐头、head_dim 内半配对）。xOff:[D,S] 原地，
        // cosOff/sinOff:[dh/2,S]。thread-per-(h,a,s) 对（每线程写旋转的两行元素）。
        void rope(float[] a, int work, int xOff, int cosOff, int sinOff, int D, int S, int heads, long dev) {
            int dh = D / heads;
            int half = dh / 2;
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int ss = int(p % long(S));
                    int rem = int(p / long(S));
                    int aa = rem % half;
                    int h = rem / half;
                    int i0 = (h * dh + aa) * S + ss;
                    int i1 = (h * dh + half + aa) * S + ss;
                    double x0 = double(a[xOff + i0]);
                    double x1 = double(a[xOff + i1]);
                    double c = double(a[cosOff + aa * S + ss]);
                    double si = double(a[sinOff + aa * S + ss]);
                    a[xOff + i0] = float(x0 * c - x1 * si);
                    a[xOff + i1] = float(x0 * si + x1 * c);
                }
            }
        }

        // attention（opKind 62）：满序列缩放点积注意力（可选因果）。q/k/v/out:[D,S]
        // （行=特征，列=token），causal 时 j>i → -1e30。scOff 须 [heads*S*S]
        // （每 (head,i) 独立 score 行，多 head/query 并行不竞争）。thread=(head,i)。
        void attention(float[] a, int work, int qOff, int kOff, int vOff, int outOff, int scOff,
                       int D, int S, int heads, int causal, int groups, long dev) {
            int dh = D / heads;
            double scale = 1.0 / Math.sqrt(double(dh));
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int bh = int(p / long(S));
                    int i = int(p % long(S));
                    int kvh = bh / groups;
                    int sb = (bh * S + i) * S;
                    int j = 0;
                    while (j < S) {
                        double sum = 0.0;
                        int d = 0;
                        while (d < dh) {
                            sum = sum + double(a[qOff + (bh * dh + d) * S + i]) * double(a[kOff + (kvh * dh + d) * S + j]);
                            d = d + 1;
                        }
                        double sc = sum * scale;
                        if (causal == 1 && j > i) sc = -1.0e30;
                        a[scOff + sb + j] = float(sc);
                        j = j + 1;
                    }
                    float maxv = a[scOff + sb + 0];
                    j = 1;
                    while (j < S) { if (a[scOff + sb + j] > maxv) maxv = a[scOff + sb + j]; j = j + 1; }
                    double sumE = 0.0;
                    j = 0;
                    while (j < S) {
                        double e = Math.exp(double(a[scOff + sb + j]) - double(maxv));
                        a[scOff + sb + j] = float(e);
                        sumE = sumE + e;
                        j = j + 1;
                    }
                    j = 0;
                    while (j < S) { a[scOff + sb + j] = float(double(a[scOff + sb + j]) / sumE); j = j + 1; }
                    int d = 0;
                    while (d < dh) {
                        double sum = 0.0;
                        int j2 = 0;
                        while (j2 < S) {
                            sum = sum + double(a[scOff + sb + j2]) * double(a[vOff + (kvh * dh + d) * S + j2]);
                            j2 = j2 + 1;
                        }
                        a[outOff + (bh * dh + d) * S + i] = float(sum);
                        d = d + 1;
                    }
                }
            }
        }

        // attentionCached（opKind 67）：KV cache 增量注意力（decode 每步一个 token）。
        // qOff:[D]，kcOff/vcOff:[kvD,stride]（缓存容量/行步长，位置沿列，前 len 列参与），
        // outOff:[D]，scOff 须 [heads*len]（每头独立 score 行）。thread=head。
        void attentionCached(float[] a, int work, int qOff, int kcOff, int vcOff, int outOff, int scOff,
                             int D, int stride, int len, int heads, int groups, long dev) {
            int dh = D / heads;
            double scale = 1.0 / Math.sqrt(double(dh));
            @gpu for (long b = 0L; b < long(work); b = b + 1L) resident(a = dev) {
                if (b < work) {
                    int kvh = int(b) / groups;
                    int i = 0;
                    while (i < len) {
                        double sum = 0.0;
                        int d = 0;
                        while (d < dh) {
                            sum = sum + double(a[qOff + int(b) * dh + d]) * double(a[kcOff + (kvh * dh + d) * stride + i]);
                            d = d + 1;
                        }
                        a[scOff + int(b) * len + i] = float(sum * scale);
                        i = i + 1;
                    }
                    float maxv = a[scOff + int(b) * len + 0];
                    i = 1;
                    while (i < len) { if (a[scOff + int(b) * len + i] > maxv) maxv = a[scOff + int(b) * len + i]; i = i + 1; }
                    double sumE = 0.0;
                    i = 0;
                    while (i < len) {
                        double e = Math.exp(double(a[scOff + int(b) * len + i]) - double(maxv));
                        a[scOff + int(b) * len + i] = float(e);
                        sumE = sumE + e;
                        i = i + 1;
                    }
                    i = 0;
                    while (i < len) { a[scOff + int(b) * len + i] = float(double(a[scOff + int(b) * len + i]) / sumE); i = i + 1; }
                    int d = 0;
                    while (d < dh) {
                        double sum = 0.0;
                        int i2 = 0;
                        while (i2 < len) {
                            sum = sum + double(a[scOff + int(b) * len + i2]) * double(a[vcOff + (kvh * dh + d) * stride + i2]);
                            i2 = i2 + 1;
                        }
                        a[outOff + int(b) * dh + d] = float(sum);
                        d = d + 1;
                    }
                }
            }
        }
        // ReduceMean 激进优化（全 resident 单数组版，2026-08-12）：并行归约替代
        // 原"单线程串行"（mode 0 原 1 线程串行 total；mode 1 原每通道 1 线程串行 S）。
        // stats 写入 arena 尾部预留区 stOff，全设备计算（单数组 resident，无原子）。
        void reduceMean(float[] a, int work, int inOff, int outOff, int mode,
                        int N, int C, int S, int total, int keepdims, long dev, int stOff, int redType) {
            // G3：GPU 支持 mean(0)/sum(1)/max(2)/min(3)（归约聚合按 redType 分派）
            if (mode == 0) {
                long totalL = long(total);
                int np = 1024;
                @gpu for (long p0 = 0L; p0 < long(np); p0 = p0 + 1L) resident(a = dev) {
                    if (p0 < np) {
                        double s0 = 0.0;
                        if (redType == 2) s0 = -1.0e30;
                        else if (redType == 3) s0 = 1.0e30;
                        long q0 = p0;
                        if (redType == 2) {
                            while (q0 < totalL) { double xv0 = a[inOff + int(q0)]; if (xv0 > s0) s0 = xv0; q0 = q0 + long(np); }
                        } else if (redType == 3) {
                            while (q0 < totalL) { double xv0 = a[inOff + int(q0)]; if (xv0 < s0) s0 = xv0; q0 = q0 + long(np); }
                        } else {
                            while (q0 < totalL) { double xv0 = a[inOff + int(q0)]; s0 = s0 + xv0; q0 = q0 + long(np); }
                        }
                        a[stOff + int(p0)] = float(s0);
                    }
                }
                @gpu for (long p1 = 0L; p1 < 1L; p1 = p1 + 1L) resident(a = dev) {
                    if (p1 < 1L) {
                        double sum = 0.0;
                        if (redType == 2) sum = -1.0e30;
                        else if (redType == 3) sum = 1.0e30;
                        int i0 = 0;
                        if (redType == 2) {
                            while (i0 < np) { double v0 = a[stOff + i0]; if (v0 > sum) sum = v0; i0 = i0 + 1; }
                        } else if (redType == 3) {
                            while (i0 < np) { double v0 = a[stOff + i0]; if (v0 < sum) sum = v0; i0 = i0 + 1; }
                        } else {
                            while (i0 < np) { double v0 = a[stOff + i0]; sum = sum + v0; i0 = i0 + 1; }
                            if (redType == 0) sum = sum / double(totalL);
                        }
                        a[outOff + 0] = float(sum);
                    }
                }
            } else {
                int nC = N * C;
                long totalL = long(nC) * long(S);
                int pt = 512;
                long nTh = long(nC) * long(pt);
                @gpu for (long pp = 0L; pp < nTh; pp = pp + 1L) resident(a = dev) {
                    if (pp < nTh) {
                        int nc1 = int(pp / long(pt));
                        int b1 = int(pp % long(pt));
                        long base1 = long(nc1) * long(S);
                        double s1 = 0.0;
                        if (redType == 2) s1 = -1.0e30;
                        else if (redType == 3) s1 = 1.0e30;
                        long q1 = base1 + long(b1);
                        if (redType == 2) {
                            while (q1 < base1 + long(S)) { double xv1 = a[inOff + int(q1)]; if (xv1 > s1) s1 = xv1; q1 = q1 + long(pt); }
                        } else if (redType == 3) {
                            while (q1 < base1 + long(S)) { double xv1 = a[inOff + int(q1)]; if (xv1 < s1) s1 = xv1; q1 = q1 + long(pt); }
                        } else {
                            while (q1 < base1 + long(S)) { double xv1 = a[inOff + int(q1)]; s1 = s1 + xv1; q1 = q1 + long(pt); }
                        }
                        a[stOff + nc1 * pt + b1] = float(s1);
                    }
                }
                @gpu for (long pp2 = 0L; pp2 < long(nC); pp2 = pp2 + 1L) resident(a = dev) {
                    if (pp2 < nC) {
                        int c2 = int(pp2);
                        double s2 = 0.0;
                        if (redType == 2) s2 = -1.0e30;
                        else if (redType == 3) s2 = 1.0e30;
                        int b2 = 0;
                        if (redType == 2) {
                            while (b2 < pt) { double v2 = a[stOff + c2 * pt + b2]; if (v2 > s2) s2 = v2; b2 = b2 + 1; }
                        } else if (redType == 3) {
                            while (b2 < pt) { double v2 = a[stOff + c2 * pt + b2]; if (v2 < s2) s2 = v2; b2 = b2 + 1; }
                        } else {
                            while (b2 < pt) { double v2 = a[stOff + c2 * pt + b2]; s2 = s2 + v2; b2 = b2 + 1; }
                            if (redType == 0) s2 = s2 / double(S);
                        }
                        a[outOff + c2] = float(s2);
                    }
                }
            }
        }
        // Split：沿 axis 复制 [start, start+len)（5 维解码，2D 时 d4=1；od 内部推出）
        void splitOp(float[] a, int work, int offIn, int offOut,
                     int axis, int start, int len,
                     int d0, int d1, int d2, int d3, int d4, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int od0 = d0, od1 = d1, od2 = d2, od3 = d3, od4 = d4;
                    if (axis == 0) od0 = len;
                    else if (axis == 1) od1 = len;
                    else if (axis == 2) od2 = len;
                    else if (axis == 3) od3 = len;
                    else od4 = len;
                    int i = int(p);
                    int x4 = i % od4;
                    int t = i / od4;
                    int x3 = t % od3;
                    t = t / od3;
                    int x2 = t % od2;
                    t = t / od2;
                    int x1 = t % od1;
                    int x0 = t / od1;
                    int c0 = x0, c1 = x1, c2 = x2, c3 = x3, c4 = x4;
                    if (axis == 0) c0 = x0 + start;
                    else if (axis == 1) c1 = x1 + start;
                    else if (axis == 2) c2 = x2 + start;
                    else if (axis == 3) c3 = x3 + start;
                    else c4 = x4 + start;
                    int inFlat = (((c0 * d1 + c1) * d2 + c2) * d3 + c3) * d4 + c4;
                    a[offOut + i] = a[offIn + inFlat];
                }
            }
        }
        // Resize2D：nearest/bilinear（thread-per-output-element）
        void resize2d(float[] a, int work, int offIn, int offOut,
                      int N, int C, int inH, int inW, int outH, int outW,
                      int mode, int transform, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int i = int(p);
                    int x = i % outW;
                    int t = i / outW;
                    int y = t % outH;
                    t = t / outH;
                    int c = t % C;
                    int n = t / C;
                    float sy = 0.0f;
                    float sx = 0.0f;
                    if (transform == 0) {
                        if (outH > 1) sy = float(y) * float(inH - 1) / float(outH - 1);
                        if (outW > 1) sx = float(x) * float(inW - 1) / float(outW - 1);
                    } else if (transform == 2) {
                        sy = float(y) * float(inH) / float(outH);
                        sx = float(x) * float(inW) / float(outW);
                    } else {
                        sy = (float(y) + 0.5f) * float(inH) / float(outH) - 0.5f;
                        sx = (float(x) + 0.5f) * float(inW) / float(outW) - 0.5f;
                    }
                    int base = (n * C + c) * inH * inW;
                    int obase = (n * C + c) * outH * outW;
                    if (mode == 0) {
                        int iy = int(sy);
                        int ix = int(sx);
                        if (iy < 0) iy = 0;
                        if (iy >= inH) iy = inH - 1;
                        if (ix < 0) ix = 0;
                        if (ix >= inW) ix = inW - 1;
                        a[offOut + obase + y * outW + x] = a[offIn + base + iy * inW + ix];
                    } else {
                        int iy = int(sy);
                        int ix = int(sx);
                        float fy = sy - float(iy);
                        float fx = sx - float(ix);
                        if (iy < 0) { iy = 0; fy = 0.0f; }
                        if (iy >= inH - 1) { iy = inH - 1; fy = 0.0f; }
                        if (ix < 0) { ix = 0; fx = 0.0f; }
                        if (ix >= inW - 1) { ix = inW - 1; fx = 0.0f; }
                        int iy2 = iy + 1;
                        int ix2 = ix + 1;
                        if (iy2 >= inH) iy2 = inH - 1;
                        if (ix2 >= inW) ix2 = inW - 1;
                        float v00 = a[offIn + base + iy * inW + ix];
                        float v01 = a[offIn + base + iy * inW + ix2];
                        float v10 = a[offIn + base + iy2 * inW + ix];
                        float v11 = a[offIn + base + iy2 * inW + ix2];
                        float v = v00 * (1.0f - fx) * (1.0f - fy) + v01 * fx * (1.0f - fy) + v10 * (1.0f - fx) * fy + v11 * fx * fy;
                        a[offOut + obase + y * outW + x] = v;
                    }
                }
            }
        }

        // Resize3D：thread-per-output（trilinear/nearest）
        void resize3d(float[] a, int work, int offIn, int offOut,
                      int N, int C, int inD, int inH, int inW, int outD, int outH, int outW,
                      int mode, int transform, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int i = int(p);
                    int x = i % outW;
                    int t = i / outW;
                    int y = t % outH;
                    t = t / outH;
                    int z = t % outD;
                    t = t / outD;
                    int c = t % C;
                    int n = t / C;
                    float sz = 0.0f;
                    float sy = 0.0f;
                    float sx = 0.0f;
                    if (transform == 0) {
                        if (outD > 1) sz = float(z) * float(inD - 1) / float(outD - 1);
                        if (outH > 1) sy = float(y) * float(inH - 1) / float(outH - 1);
                        if (outW > 1) sx = float(x) * float(inW - 1) / float(outW - 1);
                    } else if (transform == 2) {
                        sz = float(z) * float(inD) / float(outD);
                        sy = float(y) * float(inH) / float(outH);
                        sx = float(x) * float(inW) / float(outW);
                    } else {
                        sz = (float(z) + 0.5f) * float(inD) / float(outD) - 0.5f;
                        sy = (float(y) + 0.5f) * float(inH) / float(outH) - 0.5f;
                        sx = (float(x) + 0.5f) * float(inW) / float(outW) - 0.5f;
                    }
                    int base = (n * C + c) * inD * inH * inW;
                    int obase = (n * C + c) * outD * outH * outW;
                    if (mode == 0) {
                        int iz = int(sz);
                        int iy = int(sy);
                        int ix = int(sx);
                        if (iz < 0) iz = 0;
                        if (iz >= inD) iz = inD - 1;
                        if (iy < 0) iy = 0;
                        if (iy >= inH) iy = inH - 1;
                        if (ix < 0) ix = 0;
                        if (ix >= inW) ix = inW - 1;
                        a[offOut + obase + z * outH * outW + y * outW + x] = a[offIn + base + iz * inH * inW + iy * inW + ix];
                    } else {
                        int iz = int(sz);
                        int iy = int(sy);
                        int ix = int(sx);
                        float fz = sz - float(iz);
                        float fy = sy - float(iy);
                        float fx = sx - float(ix);
                        if (iz < 0) { iz = 0; fz = 0.0f; }
                        if (iz >= inD - 1) { iz = inD - 1; fz = 0.0f; }
                        if (iy < 0) { iy = 0; fy = 0.0f; }
                        if (iy >= inH - 1) { iy = inH - 1; fy = 0.0f; }
                        if (ix < 0) { ix = 0; fx = 0.0f; }
                        if (ix >= inW - 1) { ix = inW - 1; fx = 0.0f; }
                        int iz2 = iz + 1; if (iz2 >= inD) iz2 = inD - 1;
                        int iy2 = iy + 1; if (iy2 >= inH) iy2 = inH - 1;
                        int ix2 = ix + 1; if (ix2 >= inW) ix2 = inW - 1;
                        float w000 = (1.0f - fx) * (1.0f - fy) * (1.0f - fz);
                        float w100 = fx * (1.0f - fy) * (1.0f - fz);
                        float w010 = (1.0f - fx) * fy * (1.0f - fz);
                        float w110 = fx * fy * (1.0f - fz);
                        float w001 = (1.0f - fx) * (1.0f - fy) * fz;
                        float w101 = fx * (1.0f - fy) * fz;
                        float w011 = (1.0f - fx) * fy * fz;
                        float w111 = fx * fy * fz;
                        float v = a[offIn + base + iz * inH * inW + iy * inW + ix] * w000
                                + a[offIn + base + iz * inH * inW + iy * inW + ix2] * w100
                                + a[offIn + base + iz * inH * inW + iy2 * inW + ix] * w010
                                + a[offIn + base + iz * inH * inW + iy2 * inW + ix2] * w110
                                + a[offIn + base + iz2 * inH * inW + iy * inW + ix] * w001
                                + a[offIn + base + iz2 * inH * inW + iy * inW + ix2] * w101
                                + a[offIn + base + iz2 * inH * inW + iy2 * inW + ix] * w011
                                + a[offIn + base + iz2 * inH * inW + iy2 * inW + ix2] * w111;
                        a[offOut + obase + z * outH * outW + y * outW + x] = v;
                    }
                }
            }
        }

        // Resize3D 反向（阶段4d，GPU）：清 dIn + thread-per-output 按前向坐标
        // 散射回 dIn（nearest → 单输入累加；trilinear → 8 邻居按权重累加）。
        void bwdResize3d(float[] a, long dev, int dOutOff, int dInOff,
                         int N, int C, int inD, int inH, int inW, int outD, int outH, int outW,
                         int mode, int transform) {
            // 每输入一个线程：dIn[i] = Σ_输出 dy[w] * weight(i, w)。避免散射累加竞争。
            @gpu for (long p = 0L; p < long(N) * long(C) * long(inD) * long(inH) * long(inW); p = p + 1L) resident(a = dev) {
                long iS = long(inD) * long(inH) * long(inW);
                long oS = long(outD) * long(outH) * long(outW);
                long nn = p / (long(C) * iS);
                long cc = (p / iS) % long(C);
                long iz = (p % iS) / long(inH * inW);
                long iy = (p % long(inH * inW)) / long(inW);
                long ix = p % long(inW);
                long base = (nn * long(C) + cc) * iS;
                long obase = (nn * long(C) + cc) * oS;
                float acc = 0.0f;
                long z = 0L;
                while (z < long(outD)) {
                    long y = 0L;
                    while (y < long(outH)) {
                        long x = 0L;
                        while (x < long(outW)) {
                            float sz = 0.0f;
                            float sy = 0.0f;
                            float sx = 0.0f;
                            if (transform == 0) {
                                if (outD > 1) sz = float(z) * float(inD - 1) / float(outD - 1);
                                if (outH > 1) sy = float(y) * float(inH - 1) / float(outH - 1);
                                if (outW > 1) sx = float(x) * float(inW - 1) / float(outW - 1);
                            } else if (transform == 2) {
                                sz = float(z) * float(inD) / float(outD);
                                sy = float(y) * float(inH) / float(outH);
                                sx = float(x) * float(inW) / float(outW);
                            } else {
                                sz = (float(z) + 0.5f) * float(inD) / float(outD) - 0.5f;
                                sy = (float(y) + 0.5f) * float(inH) / float(outH) - 0.5f;
                                sx = (float(x) + 0.5f) * float(inW) / float(outW) - 0.5f;
                            }
                            long ooff = obase + z * long(outH * outW) + y * long(outW) + x;
                            float dy = a[dOutOff + ooff];
                            if (mode == 0) {
                                // nearest：输入 (iz,iy,ix) 若为该输出的最近点则权重 1
                                long izn = long(sz);
                                long iyn = long(sy);
                                long ixn = long(sx);
                                if (izn < 0L) izn = 0L;
                                if (izn >= long(inD)) izn = long(inD - 1);
                                if (iyn < 0L) iyn = 0L;
                                if (iyn >= long(inH)) iyn = long(inH - 1);
                                if (ixn < 0L) ixn = 0L;
                                if (ixn >= long(inW)) ixn = long(inW - 1);
                                if (izn == iz && iyn == iy && ixn == ix) acc = acc + dy;
                            } else {
                                // trilinear：输入 (iz,iy,ix) 的权重 = (z 维 w)*(y 维 w)*(x 维 w)
                                long izf = long(sz);
                                long iyf = long(sy);
                                long ixf = long(sx);
                                float fz = sz - float(izf);
                                float fy = sy - float(iyf);
                                float fx = sx - float(ixf);
                                if (izf < 0L) { izf = 0L; fz = 0.0f; }
                                if (izf >= long(inD - 1)) { izf = long(inD - 1); fz = 0.0f; }
                                if (iyf < 0L) { iyf = 0L; fy = 0.0f; }
                                if (iyf >= long(inH - 1)) { iyf = long(inH - 1); fy = 0.0f; }
                                if (ixf < 0L) { ixf = 0L; fx = 0.0f; }
                                if (ixf >= long(inW - 1)) { ixf = long(inW - 1); fx = 0.0f; }
                                float wz = 0.0f;
                                if (iz == izf) wz = 1.0f - fz;
                                else if (iz == izf + 1L) wz = fz;
                                float wy = 0.0f;
                                if (iy == iyf) wy = 1.0f - fy;
                                else if (iy == iyf + 1L) wy = fy;
                                float wx = 0.0f;
                                if (ix == ixf) wx = 1.0f - fx;
                                else if (ix == ixf + 1L) wx = fx;
                                float w = wz * wy * wx;
                                if (w != 0.0f) acc = acc + dy * w;
                            }
                            x = x + 1L;
                        }
                        y = y + 1L;
                    }
                    z = z + 1L;
                }
                a[dInOff + p] = acc;
            }
        }
}
