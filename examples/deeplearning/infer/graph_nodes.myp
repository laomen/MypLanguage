// graph_nodes.myp — Core node records for Graph IR.
// Owns node opcode and fixed input/output name slots; Graph owns attributes separately.
class GraphNodes {
    action:
        @constructor GraphNodes() { count_ = 0; }

        void reset() { count_ = 0; }
        int count() { return count_; }
        int begin() {
            int node = count_;
            type_[node] = "";
            in0_[node] = ""; in1_[node] = ""; in2_[node] = ""; in3_[node] = ""; in4_[node] = "";
            out0_[node] = ""; out1_[node] = ""; out2_[node] = ""; out3_[node] = "";
            return node;
        }
        void end() { count_ = count_ + 1; }

        // Parser fills attributes and outputs before end(); permit access to the
        // in-progress slot while Graph itself still bounds live traversal by count().
        string typeAt(int node) { if (node < 0 || node >= 512) return ""; return type_[node]; }
        void setType(int node, string value) { if (node >= 0 && node < 512) type_[node] = value; }
        string inputAt(int node, int slot) {
            if (node < 0 || node >= 512) return "";
            if (slot == 0) return in0_[node];
            if (slot == 1) return in1_[node];
            if (slot == 2) return in2_[node];
            if (slot == 3) return in3_[node];
            if (slot == 4) return in4_[node];
            return "";
        }
        void setInput(int node, int slot, string value) {
            if (node < 0 || node >= 512) return;
            if (slot == 0) in0_[node] = value;
            else if (slot == 1) in1_[node] = value;
            else if (slot == 2) in2_[node] = value;
            else if (slot == 3) in3_[node] = value;
            else if (slot == 4) in4_[node] = value;
        }
        string outputAt(int node, int slot) {
            if (node < 0 || node >= 512) return "";
            if (slot == 0) return out0_[node];
            if (slot == 1) return out1_[node];
            if (slot == 2) return out2_[node];
            if (slot == 3) return out3_[node];
            return "";
        }
        void setOutput(int node, int slot, string value) {
            if (node < 0 || node >= 512) return;
            if (slot == 0) out0_[node] = value;
            else if (slot == 1) out1_[node] = value;
            else if (slot == 2) out2_[node] = value;
            else if (slot == 3) out3_[node] = value;
        }

    property:
        string[512] type_;
        string[512] in0_;
        string[512] in1_;
        string[512] in2_;
        string[512] in3_;
        string[512] in4_;
        string[512] out0_;
        string[512] out1_;
        string[512] out2_;
        string[512] out3_;
        int count_;
}