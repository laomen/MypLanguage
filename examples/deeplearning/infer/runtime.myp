// runtime.myp — Tiny static-graph inference runtime
import env;
import gpu;
import fmt;
import text;
import "./tensor.myp";
import "./ops.myp";
import "./gpu_ops.myp";
import "./pb.myp";   // F32（分发时把 BN eps 位型解析为 double）

class InferenceRuntime {
    action:
        void init(int arenaCapacity) {
            arenaTop_ = 0;
            tensorCount_ = 0;
            opCount_ = 0;
            trainMode_ = 0;
            lr_ = 0.1;
            gpuPersist_ = 0;   // 阶段3d：持久化设备 arena 默认关闭
            gpuSyncN_ = 0;
            statsOff_ = arenaCapacity;
            arenaCap_ = arenaCapacity + statsSize();
            if (arenaCap_ < 1) arenaCap_ = 1;
            arena = new float[arenaCap_];
        }

        // 重建 arena 到指定容量（用于 ONNX 路径：加载器先做内存规划再建 arena）。
        // 尾部预留 statsSize() 个 float 作为全 resident 归约暂存区（instancenorm/reduceMean）。
        void resizeArena(int cap) {
            statsOff_ = cap;
            arena = new float[cap + statsSize()];
            arenaCap_ = cap + statsSize();
        }

        // 全 resident 归约暂存区大小（float 数）：nC*pt*2 + nC*2，1M 覆盖 nC≤1023
        int statsSize() { return 1048576; }

        // 边界转换：调用方仍传 double，内部以 float（FP32）存储
        void setFlat(int tid, int index, double v) {
            arena[tOff_[tid] + index] = float(v);
            // 阶段3d：持久化 arena 模式下标记该张量脏（runGpu 只增量上传脏张量）
            if (gpuPersist_ == 1) dirtyTid_[tid] = 1;
        }

        double getFlat(int tid, int index) {
            double v = arena[tOff_[tid] + index];
            return v;
        }

        int addTensor(int rows, int cols) {
            int id = tensorCount_;
            int n = TensorOps.size(rows, cols);
            if (arenaTop_ + n > arenaCap_) return -1;
            tRows_[id] = rows;
            tCols_[id] = cols;
            tN_[id] = rows;
            tC_[id] = cols;
            tH_[id] = 1;
            tW_[id] = 1;
            tOff_[id] = arenaTop_;
            int i = 0;
            while (i < n) {
                arena[arenaTop_ + i] = float(0.0);
                i = i + 1;
            }
            arenaTop_ = arenaTop_ + n;
            tensorCount_ = tensorCount_ + 1;
            return id;
        }

        // 4D 张量（NCHW 行优先），bump 分配
        int addTensor4(int d0, int d1, int d2, int d3) {
            int id = tensorCount_;
            int n = d0 * d1 * d2 * d3;
            if (arenaTop_ + n > arenaCap_) return -1;
            tRows_[id] = d0 * d1;
            tCols_[id] = d2 * d3;
            tN_[id] = d0;
            tC_[id] = d1;
            tD_[id] = 1;
            tH_[id] = d2;
            tW_[id] = d3;
            tOff_[id] = arenaTop_;
            arenaTop_ = arenaTop_ + n;
            tensorCount_ = tensorCount_ + 1;
            return id;
        }

        // 5D 张量（NCDHW 行优先，3D 扩展），bump 分配
        int addTensor5(int d0, int d1, int d2, int d3, int d4) {
            int id = tensorCount_;
            int n = d0 * d1 * d2 * d3 * d4;
            if (arenaTop_ + n > arenaCap_) return -1;
            tRows_[id] = d0 * d1;
            tCols_[id] = d2 * d3 * d4;
            tN_[id] = d0;
            tC_[id] = d1;
            tD_[id] = d2;
            tH_[id] = d3;
            tW_[id] = d4;
            tOff_[id] = arenaTop_;
            arenaTop_ = arenaTop_ + n;
            tensorCount_ = tensorCount_ + 1;
            return id;
        }

        // 在指定偏移登记 CNN 张量（运行时视角 4D NCHW；rows=N*C, cols=H*W）
        int addTensorPlanned4(int d0, int d1, int d2, int d3, int offset) {
            int id = tensorCount_;
            tRows_[id] = d0 * d1;
            tCols_[id] = d2 * d3;
            tN_[id] = d0;
            tC_[id] = d1;
            tD_[id] = 1;
            tH_[id] = d2;
            tW_[id] = d3;
            tOff_[id] = offset;
            tensorCount_ = tensorCount_ + 1;
            return id;
        }

        // 在指定偏移登记 5D CNN 张量（NCDHW；rows=N*C, cols=D*H*W，3D 扩展）
        int addTensorPlanned5(int d0, int d1, int d2, int d3, int d4, int offset) {
            int id = tensorCount_;
            tRows_[id] = d0 * d1;
            tCols_[id] = d2 * d3 * d4;
            tN_[id] = d0;
            tC_[id] = d1;
            tD_[id] = d2;
            tH_[id] = d3;
            tW_[id] = d4;
            tOff_[id] = offset;
            tensorCount_ = tensorCount_ + 1;
            return id;
        }

        // 在指定偏移登记 FC 张量（2D 视图：rows/cols 即真实维度）
        int addTensorPlanned2(int rows, int cols, int offset) {
            int id = tensorCount_;
            tRows_[id] = rows;
            tCols_[id] = cols;
            tN_[id] = rows;
            tC_[id] = cols;
            tH_[id] = 1;
            tW_[id] = 1;
            tOff_[id] = offset;
            tensorCount_ = tensorCount_ + 1;
            return id;
        }

        void setElem(int tid, int r, int c, double v) {
            int idx = tOff_[tid] + TensorOps.flatIndex(tCols_[tid], r, c);
            arena[idx] = float(v);
        }

        double getElem(int tid, int r, int c) {
            int idx = tOff_[tid] + TensorOps.flatIndex(tCols_[tid], r, c);
            double v = arena[idx];
            return v;
        }

        void addDense(int inputTid, int weightTid, int biasTid, int outputTid) {
            int id = opCount_;
            opKind_[id] = 1;
            opA_[id] = inputTid;
            opB_[id] = weightTid;
            opC_[id] = biasTid;
            opD_[id] = outputTid;
            opCount_ = opCount_ + 1;
        }

        void addRelu(int inputTid, int outputTid) {
            int id = opCount_;
            opKind_[id] = 2;
            opA_[id] = inputTid;
            opB_[id] = outputTid;
            opC_[id] = 0;
            opD_[id] = 0;
            opCount_ = opCount_ + 1;
        }

        void addSoftmax(int inputTid, int outputTid) {
            int id = opCount_;
            opKind_[id] = 3;
            opA_[id] = inputTid;
            opB_[id] = outputTid;
            opC_[id] = 0;
            opD_[id] = 0;
            opCount_ = opCount_ + 1;
        }

        // ---- 训练（阶段2）：反向/更新算子注册 ----
        // opKind 50-55；trainMode_=1 时 run() 才执行（eval 跳过）
        void addBwdDense(int dyT, int xT, int wT, int dxT, int dwT, int dbT) {
            int id = opCount_;
            opKind_[id] = 50;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = wT; opD_[id] = dxT;
            opP0_[id] = dwT; opP1_[id] = dbT;
            opCount_ = opCount_ + 1;
        }
        void addBwdRelu(int dyT, int xT, int dxT) {
            int id = opCount_;
            opKind_[id] = 51;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opCount_ = opCount_ + 1;
        }
        void addBwdSigmoid(int dyT, int yT, int dxT) {
            int id = opCount_;
            opKind_[id] = 52;
            opA_[id] = dyT; opB_[id] = yT; opC_[id] = dxT;
            opCount_ = opCount_ + 1;
        }
        void addBwdAdd(int dyT, int daT, int dbT) {
            int id = opCount_;
            opKind_[id] = 53;
            opA_[id] = dyT; opB_[id] = daT; opC_[id] = dbT;
            opCount_ = opCount_ + 1;
        }
        // Softmax+CE 合并：输入 logits + 标签(one-hot)，输出 dlogits + loss
        void addSoftmaxCE(int logitT, int labelT, int dlogitT, int lossT) {
            int id = opCount_;
            opKind_[id] = 54;
            opA_[id] = logitT; opB_[id] = labelT; opC_[id] = dlogitT; opD_[id] = lossT;
            opCount_ = opCount_ + 1;
        }
        void addUpdate(int wT, int gradT) {
            int id = opCount_;
            opKind_[id] = 55;
            opA_[id] = wT; opB_[id] = gradT;
            opCount_ = opCount_ + 1;
        }
        // 阶段3：卷积反向（opKind 56）。dy=opA, x=opB, w=opC, dx=opD;
        // dw=opP0, db=opP1, sh=opP2, sw=opP3, pt=opP4, pl=opP5, dh=opP6, dw=opP7, group=opP8
        void addBwdConv(int dyT, int xT, int wT, int dxT, int dwT, int dbT,
                        int sh, int sw, int pt, int pl, int dh, int dw, int group) {
            int id = opCount_;
            opKind_[id] = 56;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = wT; opD_[id] = dxT;
            opP0_[id] = dwT; opP1_[id] = dbT;
            opP2_[id] = sh; opP3_[id] = sw; opP4_[id] = pt; opP5_[id] = pl;
            opP6_[id] = dh; opP7_[id] = dw; opP8_[id] = group;
            opCount_ = opCount_ + 1;
        }
        // 阶段3：MaxPool 反向（opKind 57）。dy=opA, x=opB, dx=opC;
        // kh=opP0, kw=opP1, sh=opP2, sw=opP3, pt=opP4, pl=opP5
        void addBwdMaxPool(int dyT, int xT, int dxT,
                           int kh, int kw, int sh, int sw, int pt, int pl) {
            int id = opCount_;
            opKind_[id] = 57;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opP0_[id] = kh; opP1_[id] = kw; opP2_[id] = sh; opP3_[id] = sw;
            opP4_[id] = pt; opP5_[id] = pl;
            opCount_ = opCount_ + 1;
        }
        // 阶段4：Conv3D 反向（opKind 58）。dy=opA, x=opB, w=opC, dx=opD;
        // dw=opP0, db=opP1; sd=opP2, sh=opP3, sw=opP4, pdt=opP5, pdb=opP6,
        // pt=opP7, pb=opP8; pl=opX0, pr=opX1。
        // 假设膨胀 dd=dh=dw=1、group=1（3D U-Net 常用；需膨胀/分组时再扩槽）。
        // kd/kh/kw 从 w 张量形状取（w=[yC,C/group,kd,kh,kw] → tD_/tH_/tW_）。
        void addBwdConv3D(int dyT, int xT, int wT, int dxT, int dwT, int dbT,
                          int sd, int sh, int sw, int pdt, int pdb, int pt, int pb,
                          int pl, int pr) {
            int id = opCount_;
            opKind_[id] = 58;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = wT; opD_[id] = dxT;
            opP0_[id] = dwT; opP1_[id] = dbT;
            opP2_[id] = sd; opP3_[id] = sh; opP4_[id] = sw;
            opP5_[id] = pdt; opP6_[id] = pdb; opP7_[id] = pt; opP8_[id] = pb;
            opX_[id * 4 + 0] = pl; opX_[id * 4 + 1] = pr;
            opCount_ = opCount_ + 1;
        }
        // 阶段4：MaxPool3D 反向（opKind 59）。dy=opA, x=opB, dx=opC;
        // kd=opP0, kh=opP1, kw=opP2, sd=opP3, sh=opP4, sw=opP5,
        // pdt=opP6, pdb=opP7, pt=opP8, pb=opX0, pl=opX1, pr=opX2
        void addBwdMaxPool3D(int dyT, int xT, int dxT,
                             int kd, int kh, int kw, int sd, int sh, int sw,
                             int pdt, int pdb, int pt, int pb, int pl, int pr) {
            int id = opCount_;
            opKind_[id] = 59;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opP0_[id] = kd; opP1_[id] = kh; opP2_[id] = kw;
            opP3_[id] = sd; opP4_[id] = sh; opP5_[id] = sw;
            opP6_[id] = pdt; opP7_[id] = pdb; opP8_[id] = pt;
            opX_[id * 4 + 0] = pb; opX_[id * 4 + 1] = pl; opX_[id * 4 + 2] = pr;
            opCount_ = opCount_ + 1;
        }
        // 阶段4：AveragePool3D 反向（opKind 60）。dy=opA, x=opB, dx=opC;
        // kd=opP0, kh=opP1, kw=opP2, sd=opP3, sh=opP4, sw=opP5,
        // pdt=opP6, pdb=opP7, pt=opP8, pb=opX0, pl=opX1, pr=opX2, cip=opX3
        void addBwdAvgPool3D(int dyT, int xT, int dxT,
                             int kd, int kh, int kw, int sd, int sh, int sw,
                             int pdt, int pdb, int pt, int pb, int pl, int pr, int cip) {
            int id = opCount_;
            opKind_[id] = 60;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opP0_[id] = kd; opP1_[id] = kh; opP2_[id] = kw;
            opP3_[id] = sd; opP4_[id] = sh; opP5_[id] = sw;
            opP6_[id] = pdt; opP7_[id] = pdb; opP8_[id] = pt;
            opX_[id * 4 + 0] = pb; opX_[id * 4 + 1] = pl; opX_[id * 4 + 2] = pr; opX_[id * 4 + 3] = cip;
            opCount_ = opCount_ + 1;
        }
        // 阶段4d：ConvTranspose 反向（opKind 68）。dy=opA, x=opB, w=opC, dx=opD;
        // dw=opP0, db=opP1; sh=opP2, sw=opP3, pt=opP4, pb=opP5, pl=opP6, pr=opP7;
        // kh/kw 从 w 张量形状取（w=[Cin,Cout,kh,kw] → tH_/tW_，同前向 convTranspose）。
        void addBwdConvTranspose(int dyT, int xT, int wT, int dxT, int dwT, int dbT,
                                 int sh, int sw, int pt, int pb, int pl, int pr) {
            int id = opCount_;
            opKind_[id] = 68;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = wT; opD_[id] = dxT;
            opP0_[id] = dwT; opP1_[id] = dbT;
            opP2_[id] = sh; opP3_[id] = sw; opP4_[id] = pt; opP5_[id] = pb;
            opP6_[id] = pl; opP7_[id] = pr;
            opCount_ = opCount_ + 1;
        }
        // 阶段5：RMSNorm（opKind 61）。in=opA, gamma=opB, out=opC; D=opP0, S=opP1, eps=opP2(位型)
        void addRmsNorm(int inT, int gT, int outT, int D, int S, double eps) {
            int id = opCount_;
            opKind_[id] = 61;
            opA_[id] = inT; opB_[id] = gT; opC_[id] = outT;
            opP0_[id] = D; opP1_[id] = S; opP2_[id] = F32.toBits(eps);
            opCount_ = opCount_ + 1;
        }
        // 阶段5：缩放点积注意力（opKind 62）。q=opA, k=opB, v=opC, out=opD, sc=opP0(暂存 tid);
        // D=opP1, S=opP2, heads=opP3, causal=opP4, groups=opP5（GQA：Q 头数/KV 头数，MHA=1）
        void addAttention(int qT, int kT, int vT, int outT, int scT, int D, int S, int heads, int causal, int groups) {
            int id = opCount_;
            opKind_[id] = 62;
            opA_[id] = qT; opB_[id] = kT; opC_[id] = vT; opD_[id] = outT;
            opP0_[id] = scT; opP1_[id] = D; opP2_[id] = S; opP3_[id] = heads; opP4_[id] = causal; opP5_[id] = groups;
            opCount_ = opCount_ + 1;
        }
        // 阶段5：embedding 查表（opKind 63）。e=opA, ids=opB, out=opC; vocab=opP0, D=opP1, S=opP2
        void addGatherRows(int eT, int idT, int outT, int vocab, int D, int S) {
            int id = opCount_;
            opKind_[id] = 63;
            opA_[id] = eT; opB_[id] = idT; opC_[id] = outT;
            opP0_[id] = vocab; opP1_[id] = D; opP2_[id] = S;
            opCount_ = opCount_ + 1;
        }
        // 阶段5：LayerNorm（opKind 64）。in=opA, gamma=opB, beta=opC, out=opD; D=opP0, S=opP1, eps=opP2(位型)
        void addLayerNorm(int inT, int gT, int bT, int outT, int D, int S, double eps) {
            int id = opCount_;
            opKind_[id] = 64;
            opA_[id] = inT; opB_[id] = gT; opC_[id] = bT; opD_[id] = outT;
            opP0_[id] = D; opP1_[id] = S; opP2_[id] = F32.toBits(eps);
            opCount_ = opCount_ + 1;
        }
        // 阶段5：GELU（opKind 65）。in=opA, out=opB; n=opP0
        void addGelu(int inT, int outT, int n) {
            int id = opCount_;
            opKind_[id] = 65;
            opA_[id] = inT; opB_[id] = outT;
            opP0_[id] = n;
            opCount_ = opCount_ + 1;
        }
        // 阶段5：RoPE（opKind 66）。in/out=opA（原地）, cos=opB, sin=opC; D=opP0, S=opP1, heads=opP2
        void addRope(int xT, int cosT, int sinT, int D, int S, int heads) {
            int id = opCount_;
            opKind_[id] = 66;
            opA_[id] = xT; opB_[id] = cosT; opC_[id] = sinT;
            opP0_[id] = D; opP1_[id] = S; opP2_[id] = heads;
            opCount_ = opCount_ + 1;
        }
        // 阶段5：KV cache 增量注意力（opKind 67）。q=opA, kcache=opB, vcache=opC, out=opD, sc=opP0;
        // D=opP1, stride=opP2（缓存容量/行步长）, len=opP3（参与注意力列数）, heads=opP4, groups=opP5
        void addAttentionCached(int qT, int kcT, int vcT, int outT, int scT, int D, int stride, int len, int heads, int groups) {
            int id = opCount_;
            opKind_[id] = 67;
            opA_[id] = qT; opB_[id] = kcT; opC_[id] = vcT; opD_[id] = outT;
            opP0_[id] = scT; opP1_[id] = D; opP2_[id] = stride; opP3_[id] = len; opP4_[id] = heads; opP5_[id] = groups;
            opCount_ = opCount_ + 1;
        }
        void setTrain(int v) { trainMode_ = v; }
        void setLr(double v) { lr_ = v; }
        double lr() { return lr_; }
        // 调试访问器（MYP_DUMP_OPS=1 时训练入口打印 op 清单）
        int opCountDebug() { return opCount_; }
        int opKindDebug(int i) { if (i < 0 || i >= opCount_) return -1; return opKind_[i]; }
        int opATDebug(int i) { if (i < 0 || i >= opCount_) return -1; return opA_[i]; }
        int opBTDebug(int i) { if (i < 0 || i >= opCount_) return -1; return opB_[i]; }
        int opCDebug(int i) { if (i < 0 || i >= opCount_) return -1; return opC_[i]; }
        int opDDebug(int i) { if (i < 0 || i >= opCount_) return -1; return opD_[i]; }
        int tensorCountDebug() { return tensorCount_; }
        int tensorOffDebug(int tid) { if (tid < 0 || tid >= tensorCount_) return -1; return tOff_[tid]; }
        int tensorSizeDebug(int tid) { if (tid < 0 || tid >= tensorCount_) return -1; return tRows_[tid] * tCols_[tid]; }

        void addSigmoid(int inputTid, int outputTid) {
            int id = opCount_;
            opKind_[id] = 4;
            opA_[id] = inputTid;
            opB_[id] = outputTid;
            opC_[id] = 0;
            opD_[id] = 0;
            opCount_ = opCount_ + 1;
        }

        void addAdd(int aTid, int bTid, int outputTid, int doRelu) {
            int id = opCount_;
            opKind_[id] = 5;
            opA_[id] = aTid;
            opB_[id] = bTid;
            opC_[id] = outputTid;
            opD_[id] = 0;
            opRelu_[id] = doRelu;
            opCount_ = opCount_ + 1;
        }

        void addMatmul(int aTid, int bTid, int outputTid) {
            int id = opCount_;
            opKind_[id] = 6;
            opA_[id] = aTid;
            opB_[id] = bTid;
            opC_[id] = outputTid;
            opD_[id] = 0;
            opCount_ = opCount_ + 1;
        }

        void addConv(int inTid, int wTid, int bTid, int outTid,
                     int strideH, int strideW, int padT, int padB, int padL, int padR,
                     int dilH, int dilW, int group) {
            int id = opCount_;
            opKind_[id] = 7;
            opA_[id] = inTid;
            opB_[id] = wTid;
            opC_[id] = bTid;
            opD_[id] = outTid;
            opP0_[id] = strideH; opP1_[id] = strideW; opP2_[id] = padT; opP3_[id] = padB;
            opP4_[id] = padL; opP5_[id] = padR; opP6_[id] = dilH; opP7_[id] = dilW;
            opP8_[id] = group;
            opCount_ = opCount_ + 1;
        }

        // 融合 Conv+ReLU（G1，opKind=11）：参数同 addConv
        void addConvRelu(int inTid, int wTid, int bTid, int outTid,
                         int strideH, int strideW, int padT, int padB, int padL, int padR,
                         int dilH, int dilW, int group) {
            int id = opCount_;
            opKind_[id] = 11;
            opA_[id] = inTid;
            opB_[id] = wTid;
            opC_[id] = bTid;
            opD_[id] = outTid;
            opP0_[id] = strideH; opP1_[id] = strideW; opP2_[id] = padT; opP3_[id] = padB;
            opP4_[id] = padL; opP5_[id] = padR; opP6_[id] = dilH; opP7_[id] = dilW;
            opP8_[id] = group;
            opCount_ = opCount_ + 1;
        }

        // ---- F8：ConvTranspose（opKind 40，group=1）----
        // 权重 [Cin,Cout,kh,kw] 直接拷贝（ONNX 布局）；outPad 已并入输出形状（内核用不到）
        void addConvTranspose(int inTid, int wTid, int bTid, int outTid,
                              int sh, int sw, int pt, int pb, int pl, int pr,
                              int outPadH, int outPadW, int group) {
            int id = opCount_;
            opKind_[id] = 40;
            opA_[id] = inTid;
            opB_[id] = wTid;
            opC_[id] = bTid;
            opD_[id] = outTid;
            opP0_[id] = sh; opP1_[id] = sw; opP2_[id] = pt; opP3_[id] = pb;
            opP4_[id] = pl; opP5_[id] = pr; opP6_[id] = outPadH; opP7_[id] = outPadW;
            opP8_[id] = group;
            opCount_ = opCount_ + 1;
        }

        // ---- 3D：Conv3D（opKind 41）----
        // 权重 [Cout,Cin,kd,kh,kw]；sd/sh/sw 与 6 个 pads；dd/dh/dw/group 存 opX_
        void addConv3D(int inTid, int wTid, int bTid, int outTid,
                       int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
                       int dd, int dh, int dw, int group) {
            int id = opCount_;
            opKind_[id] = 41;
            opA_[id] = inTid; opB_[id] = wTid; opC_[id] = bTid; opD_[id] = outTid;
            opP0_[id] = sd; opP1_[id] = sh; opP2_[id] = sw; opP3_[id] = pdt; opP4_[id] = pdb;
            opP5_[id] = pt; opP6_[id] = pb; opP7_[id] = pl; opP8_[id] = pr;
            opX_[id * 4 + 0] = dd; opX_[id * 4 + 1] = dh; opX_[id * 4 + 2] = dw; opX_[id * 4 + 3] = group;
            opCount_ = opCount_ + 1;
        }
        // ---- 3D：MaxPool3D（opKind 42）----
        // kd/kh/kw + sd/sh/sw + 6 pads（pb/pl/pr 存 opX_）
        void addMaxPool3D(int inTid, int outTid, int kd, int kh, int kw,
                          int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr) {
            int id = opCount_;
            opKind_[id] = 42;
            opA_[id] = inTid; opB_[id] = outTid;
            opP0_[id] = kd; opP1_[id] = kh; opP2_[id] = kw;
            opP3_[id] = sd; opP4_[id] = sh; opP5_[id] = sw;
            opP6_[id] = pdt; opP7_[id] = pdb; opP8_[id] = pt;
            opX_[id * 4 + 0] = pb; opX_[id * 4 + 1] = pl; opX_[id * 4 + 2] = pr;
            opCount_ = opCount_ + 1;
        }
        // ---- 3D：AveragePool3D（opKind 43）----
        // kd/kh/kw + sd/sh/sw + 6 pads（pb/pl/pr 存 opX_，cip 存 opX_[3]）
        void addAvgPool3D(int inTid, int outTid, int kd, int kh, int kw,
                          int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
                          int cip) {
            int id = opCount_;
            opKind_[id] = 43;
            opA_[id] = inTid; opB_[id] = outTid;
            opP0_[id] = kd; opP1_[id] = kh; opP2_[id] = kw;
            opP3_[id] = sd; opP4_[id] = sh; opP5_[id] = sw;
            opP6_[id] = pdt; opP7_[id] = pdb; opP8_[id] = pt;
            opX_[id * 4 + 0] = pb; opX_[id * 4 + 1] = pl; opX_[id * 4 + 2] = pr;
            opX_[id * 4 + 3] = cip;
            opCount_ = opCount_ + 1;
        }

        void addMaxPool(int inTid, int outTid, int kh, int kw,
                        int sh, int sw, int pt, int pb, int pl, int pr) {
            int id = opCount_;
            opKind_[id] = 8;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = kh; opP1_[id] = kw; opP2_[id] = sh; opP3_[id] = sw;
            opP4_[id] = pt; opP5_[id] = pb; opP6_[id] = pl; opP7_[id] = pr;
            opCount_ = opCount_ + 1;
        }

        // ---- F8：AveragePool（opKind 36 NCHW / 37 NHWC）----
        // cip = count_include_pad（0=默认，除数排除 pad；1=含 pad）
        void addAvgPool(int inTid, int outTid, int kh, int kw,
                        int sh, int sw, int pt, int pb, int pl, int pr, int cip) {
            int id = opCount_;
            opKind_[id] = 36;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = kh; opP1_[id] = kw; opP2_[id] = sh; opP3_[id] = sw;
            opP4_[id] = pt; opP5_[id] = pb; opP6_[id] = pl; opP7_[id] = pr;
            opP8_[id] = cip;
            opCount_ = opCount_ + 1;
        }

        void addGAPool(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 9;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }

        void addFlatten(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 10;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }

        // ---- G2：NHWC 布局算子（布局变换 NCHW→NHWC，opt-in）----
        // 张量元数据约定（NHWC 区）：激活 [N,H,W,C]→(tN,tC,tH,tW)=(N,H,W,C)；
        // 权重 [Cout,KH,KW,Cin]→(Cout,KH,KW,Cin)；偏置/FC 不变。

        // NCHW→NHWC 转置
        void addTransposeNCHW2NHWC(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 12;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }

        // NHWC 卷积（参数同 addConv）
        void addConvNHWC(int inTid, int wTid, int bTid, int outTid,
                         int strideH, int strideW, int padT, int padB, int padL, int padR,
                         int dilH, int dilW, int group) {
            int id = opCount_;
            opKind_[id] = 13;
            opA_[id] = inTid;
            opB_[id] = wTid;
            opC_[id] = bTid;
            opD_[id] = outTid;
            opP0_[id] = strideH; opP1_[id] = strideW; opP2_[id] = padT; opP3_[id] = padB;
            opP4_[id] = padL; opP5_[id] = padR; opP6_[id] = dilH; opP7_[id] = dilW;
            opP8_[id] = group;
            opCount_ = opCount_ + 1;
        }

        // NHWC 卷积 + ReLU（G1 融合在 NHWC 布局的对应）
        void addConvNHWCRelu(int inTid, int wTid, int bTid, int outTid,
                             int strideH, int strideW, int padT, int padB, int padL, int padR,
                             int dilH, int dilW, int group) {
            int id = opCount_;
            opKind_[id] = 14;
            opA_[id] = inTid;
            opB_[id] = wTid;
            opC_[id] = bTid;
            opD_[id] = outTid;
            opP0_[id] = strideH; opP1_[id] = strideW; opP2_[id] = padT; opP3_[id] = padB;
            opP4_[id] = padL; opP5_[id] = padR; opP6_[id] = dilH; opP7_[id] = dilW;
            opP8_[id] = group;
            opCount_ = opCount_ + 1;
        }

        // NHWC 最大池化
        void addMaxPoolNHWC(int inTid, int outTid, int kh, int kw,
                            int sh, int sw, int pt, int pb, int pl, int pr) {
            int id = opCount_;
            opKind_[id] = 15;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = kh; opP1_[id] = kw; opP2_[id] = sh; opP3_[id] = sw;
            opP4_[id] = pt; opP5_[id] = pb; opP6_[id] = pl; opP7_[id] = pr;
            opCount_ = opCount_ + 1;
        }
        // NHWC AveragePool
        void addAvgPoolNHWC(int inTid, int outTid, int kh, int kw,
                            int sh, int sw, int pt, int pb, int pl, int pr, int cip) {
            int id = opCount_;
            opKind_[id] = 37;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = kh; opP1_[id] = kw; opP2_[id] = sh; opP3_[id] = sw;
            opP4_[id] = pt; opP5_[id] = pb; opP6_[id] = pl; opP7_[id] = pr;
            opP8_[id] = cip;
            opCount_ = opCount_ + 1;
        }

        // ---- F8：Pad（opKind 38 NCHW / 39 NHWC）----
        // pads = 各轴 begin/end；mode 0=constant,1=reflect,2=edge；cval 位型（constant 用）
        void addPad(int inTid, int outTid,
                    int pnB, int pcB, int phB, int pwB, int pnE, int pcE, int phE, int pwE,
                    int mode, int cvalBits) {
            int id = opCount_;
            opKind_[id] = 38;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = pnB; opP1_[id] = pcB; opP2_[id] = phB; opP3_[id] = pwB;
            opP4_[id] = pnE; opP5_[id] = pcE; opP6_[id] = phE; opP7_[id] = pwE;
            opP8_[id] = mode;
            pCval_[id] = cvalBits;
            opCount_ = opCount_ + 1;
        }
        // NHWC Pad：pads 已在 graph 按逻辑轴 [N,H,W,C] 重排为 (pn,ph,pw,pc)
        void addPadNHWC(int inTid, int outTid,
                        int pnB, int phB, int pwB, int pcB, int pnE, int phE, int pwE, int pcE,
                        int mode, int cvalBits) {
            int id = opCount_;
            opKind_[id] = 39;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = pnB; opP1_[id] = phB; opP2_[id] = pwB; opP3_[id] = pcB;
            opP4_[id] = pnE; opP5_[id] = phE; opP6_[id] = pwE; opP7_[id] = pcE;
            opP8_[id] = mode;
            pCval_[id] = cvalBits;
            opCount_ = opCount_ + 1;
        }
        // ---- 3D：Pad3D（opKind 44）----
        // 10 个 pad（N,C,D,H,W 各 begin/end）；mode + cval 存 opX_
        void addPad3D(int inTid, int outTid,
                      int pnB, int pnE, int pcB, int pcE, int pdB, int pdE, int phB, int phE, int pwB, int pwE,
                      int mode, int cvalBits) {
            int id = opCount_;
            opKind_[id] = 44;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = pnB; opP1_[id] = pnE; opP2_[id] = pcB; opP3_[id] = pcE; opP4_[id] = pdB;
            opP5_[id] = pdE; opP6_[id] = phB; opP7_[id] = phE; opP8_[id] = pwB;
            opX_[id * 4 + 0] = pwE; opX_[id * 4 + 1] = mode; opX_[id * 4 + 2] = cvalBits;
            opCount_ = opCount_ + 1;
        }

        // NHWC 全局平均池化：读 [N,H,W,C]，写 [N,C]
        void addGAPoolNHWC(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 16;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }

        // ---- G3：BatchNormalization ----
        // y[n,c,...] = (x - mean[c]) * invStd[c] + bias[c]，invStd = scale/sqrt(var+eps)
        // 参数张量均为 [C] 初始器；eps 以位型 + hasEps 传入，分发时解析为 double。
        void addBatchNorm(int inTid, int outTid, int sT, int bT, int mT, int vT, int epsBits, int hasEps) {
            int id = opCount_;
            opKind_[id] = 17;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opC_[id] = sT;
            opD_[id] = bT;
            opP0_[id] = mT;
            opP1_[id] = vT;
            opP2_[id] = epsBits;
            opP3_[id] = hasEps;
            opCount_ = opCount_ + 1;
        }
        // G3：BatchNormalization（NHWC）
        void addBatchNormNHWC(int inTid, int outTid, int sT, int bT, int mT, int vT, int epsBits, int hasEps) {
            int id = opCount_;
            opKind_[id] = 18;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opC_[id] = sT;
            opD_[id] = bT;
            opP0_[id] = mT;
            opP1_[id] = vT;
            opP2_[id] = epsBits;
            opP3_[id] = hasEps;
            opCount_ = opCount_ + 1;
        }

        // ---- G4：通用激活（逐元素，布局无关）----
        void addReLU6(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 19;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }
        void addLeakyRelu(int inTid, int outTid, int alphaBits, int hasAlpha) {
            int id = opCount_;
            opKind_[id] = 20;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = alphaBits;
            opP1_[id] = hasAlpha;
            opCount_ = opCount_ + 1;
        }
        void addSiLU(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 21;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }
        void addHardSwish(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 22;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }
        // G4：Clip（ReLU6 = Clip(x,0,6)）：min/max 为标量张量 id（-1 = 不限）
        void addClip(int inTid, int outTid, int minTid, int maxTid) {
            int id = opCount_;
            opKind_[id] = 23;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = minTid;
            opP1_[id] = maxTid;
            opCount_ = opCount_ + 1;
        }

        // ---- F8：张量操作算子 ----
        // Reshape：连续拷贝（输出形状由 graph 按 shape 初始器登记）
        void addReshape(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 24;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }
        // Concat：沿 axis 拼接（2-3 输入；a2=-1 表示无第三输入）
        // od0..od3 = 输出 4D 维度；ax0/ax1/ax2 = 各输入沿 axis 的长度（内存行优先序）
        void addConcat(int a0T, int a1T, int a2T, int outT, int axis, int nIn,
                       int od0, int od1, int od2, int od3,
                       int ax0, int ax1, int ax2) {
            int id = opCount_;
            opKind_[id] = 25;
            opA_[id] = a0T;
            opB_[id] = a1T;
            opC_[id] = a2T;
            opD_[id] = outT;
            opP0_[id] = axis;
            opP1_[id] = nIn;
            opP2_[id] = od0; opP3_[id] = od1; opP4_[id] = od2; opP5_[id] = od3;
            opP6_[id] = ax0; opP7_[id] = ax1; opP8_[id] = ax2;
            opCount_ = opCount_ + 1;
        }
        // Transpose：perm 转置（pc=perm 元素数；0=缺省反转）
        // id0..id3 = 输入 4D 维度（内存行优先序）
        void addTranspose(int inTid, int outTid, int p0, int p1, int p2, int p3, int pc,
                          int id0, int id1, int id2, int id3) {
            int id = opCount_;
            opKind_[id] = 26;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = p0; opP1_[id] = p1; opP2_[id] = p2; opP3_[id] = p3;
            opP4_[id] = pc;
            opP5_[id] = id0; opP6_[id] = id1; opP7_[id] = id2; opP8_[id] = id3;
            opCount_ = opCount_ + 1;
        }

        // ---- F8：Slice（opKind 27）----
        // 沿任意轴切片；ax/st/sp 为调整后的 轴索引/start/step（cnt 轴，最多 4）；
        // od/id 为输出/输入 4D 维度（内存行优先序）。
        void addSlice(int inTid, int outTid, int cnt,
                      int id0, int id1, int id2, int id3,
                      int od0, int od1, int od2, int od3,
                      int ax0, int st0, int sp0, int ax1, int st1, int sp1,
                      int ax2, int st2, int sp2, int ax3, int st3, int sp3) {
            int id = opCount_;
            opKind_[id] = 27;
            opA_[id] = inTid;
            opB_[id] = outTid;
            sCnt_[id] = cnt;
            sId_[id * 4 + 0] = id0; sId_[id * 4 + 1] = id1; sId_[id * 4 + 2] = id2; sId_[id * 4 + 3] = id3;
            sOd_[id * 4 + 0] = od0; sOd_[id * 4 + 1] = od1; sOd_[id * 4 + 2] = od2; sOd_[id * 4 + 3] = od3;
            sAx_[id * 4 + 0] = ax0; sSt_[id * 4 + 0] = st0; sSp_[id * 4 + 0] = sp0;
            sAx_[id * 4 + 1] = ax1; sSt_[id * 4 + 1] = st1; sSp_[id * 4 + 1] = sp1;
            sAx_[id * 4 + 2] = ax2; sSt_[id * 4 + 2] = st2; sSp_[id * 4 + 2] = sp2;
            sAx_[id * 4 + 3] = ax3; sSt_[id * 4 + 3] = st3; sSp_[id * 4 + 3] = sp3;
            opCount_ = opCount_ + 1;
        }

        // ---- F8：2D 补齐（opKind 28-35，秩无关设计）----
        // Resize2D（opKind 28）：nearest/bilinear 上采样
        void addResize2d(int inTid, int outTid,
                         int N, int C, int inH, int inW, int outH, int outW,
                         int mode, int transform) {
            int id = opCount_;
            opKind_[id] = 28;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = N; opP1_[id] = C; opP2_[id] = inH; opP3_[id] = inW;
            opP4_[id] = outH; opP5_[id] = outW; opP6_[id] = mode; opP7_[id] = transform;
            opCount_ = opCount_ + 1;
        }
        // Resize3D（opKind 45）：N/C 由张量给出；mode 0=nearest 1=trilinear；transform 0=align_corners 1=half_pixel 2=asymmetric
        void addResize3d(int inTid, int outTid,
                         int inD, int inH, int inW, int outD, int outH, int outW,
                         int mode, int transform) {
            int id = opCount_;
            opKind_[id] = 45;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = inD; opP1_[id] = inH; opP2_[id] = inW;
            opP3_[id] = outD; opP4_[id] = outH; opP5_[id] = outW;
            opP6_[id] = mode; opP7_[id] = transform;
            opCount_ = opCount_ + 1;
        }
        // Split（opKind 29）：沿 axis 复制 [start, start+len)（一个输出一个 op）
        // d0..d4 为输入 5 维（2D 时 d4=1）；len = 该输出沿 axis 长度
        void addSplit(int inTid, int outTid, int axis, int start, int len,
                      int d0, int d1, int d2, int d3, int d4) {
            int id = opCount_;
            opKind_[id] = 29;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = axis; opP1_[id] = start; opP2_[id] = len;
            opP3_[id] = d0; opP4_[id] = d1; opP5_[id] = d2; opP6_[id] = d3; opP7_[id] = d4;
            opCount_ = opCount_ + 1;
        }
        // ReduceMean（opKind 30）：mode 0 = 全规约；mode 1 = 空间维规约 per-(n,c)
        void addReduceMean(int inTid, int outTid, int mode,
                           int N, int C, int S, int total, int keepdims) {
            int id = opCount_;
            opKind_[id] = 30;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = mode; opP1_[id] = N; opP2_[id] = C; opP3_[id] = S;
            opP4_[id] = total; opP5_[id] = keepdims;
            opCount_ = opCount_ + 1;
        }
        // Sub / Div / Mul（opKind 31-33）：逐元素（b 标量/同尺寸/逐通道广播；C=通道数, S=空间乘积）
        void addSub(int aTid, int bTid, int outTid, int C, int S) { int id = opCount_; opKind_[id] = 31; opA_[id] = aTid; opB_[id] = bTid; opC_[id] = outTid; opP0_[id] = C; opP1_[id] = S; opCount_ = opCount_ + 1; }
        void addDiv(int aTid, int bTid, int outTid, int C, int S) { int id = opCount_; opKind_[id] = 32; opA_[id] = aTid; opB_[id] = bTid; opC_[id] = outTid; opP0_[id] = C; opP1_[id] = S; opCount_ = opCount_ + 1; }
        void addMul(int aTid, int bTid, int outTid, int C, int S) { int id = opCount_; opKind_[id] = 33; opA_[id] = aTid; opB_[id] = bTid; opC_[id] = outTid; opP0_[id] = C; opP1_[id] = S; opCount_ = opCount_ + 1; }
        // Sqrt（opKind 34）：y = sqrt(x)
        void addSqrt(int inTid, int outTid) { int id = opCount_; opKind_[id] = 34; opA_[id] = inTid; opB_[id] = outTid; opCount_ = opCount_ + 1; }
        // InstanceNormalization（opKind 35）：per-(n,c) 空间归一化（秩无关，S=空间乘积）
        // doRelu=1 时输出直接过 ReLU（图优化 IN+Relu 融合，省一次 arena 往返）
        void addInstanceNorm(int inTid, int sTid, int bTid, int outTid,
                             int N, int C, int S, int epsBits, int hasEps, int doRelu) {
            int id = opCount_;
            opKind_[id] = 35;
            opA_[id] = inTid; opB_[id] = sTid; opC_[id] = bTid; opD_[id] = outTid;
            opP0_[id] = N; opP1_[id] = C; opP2_[id] = S; opP3_[id] = epsBits; opP4_[id] = hasEps;
            opRelu_[id] = doRelu;
            opCount_ = opCount_ + 1;
        }

        int opCount() { return opCount_; }
        int tensorOff(int tid) { return tOff_[tid]; }   // 调试用

        void run() {
            int prof = 0;
            if (Console.getEnv("MYP_PROF_CPU") == "1") prof = 1;
            int i = 0;
            while (i < opCount_) {
                long tOp0 = 0L;
                if (prof == 1) tOp0 = __myp_now_ms();
                if (opKind_[i] == 1) {
                    int xa = opA_[i];
                    int wb = opB_[i];
                    int bc = opC_[i];
                    int yd = opD_[i];
                    InferOps.dense(arena, tOff_[xa], tRows_[xa], tCols_[xa], tOff_[wb], tRows_[wb], tOff_[bc], tOff_[yd]);
                } else if (opKind_[i] == 2) {
                    int xa = opA_[i];
                    int yb = opB_[i];
                    InferOps.relu(arena, tOff_[xa], tOff_[yb], tRows_[xa] * tCols_[xa]);
                } else if (opKind_[i] == 3) {
                    int xa = opA_[i];
                    int yb = opB_[i];
                    InferOps.softmax(arena, tOff_[xa], tOff_[yb], tRows_[xa], tCols_[xa]);
                } else if (opKind_[i] == 4) {
                    int xa = opA_[i];
                    int yb = opB_[i];
                    InferOps.sigmoid(arena, tOff_[xa], tOff_[yb], tRows_[xa] * tCols_[xa]);
                } else if (opKind_[i] == 5) {
                    int aa = opA_[i];
                    int bb = opB_[i];
                    int oc = opC_[i];
                    InferOps.add(arena, tOff_[aa], tOff_[bb], tOff_[oc], tRows_[aa] * tCols_[aa], opRelu_[i]);
                } else if (opKind_[i] == 6) {
                    int xa = opA_[i];
                    int wb = opB_[i];
                    int yd = opC_[i];
                    InferOps.matmul(arena, tOff_[xa], tRows_[xa], tCols_[xa], tOff_[wb], tRows_[wb], tOff_[yd]);
                } else if (opKind_[i] == 7) {
                    int xa = opA_[i]; int wb = opB_[i]; int bc = opC_[i]; int yd = opD_[i];
                    int bOff = -1; if (bc >= 0) bOff = tOff_[bc];   // 无偏置卷积（bc=-1）
                    InferOps.conv(arena,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[wb], bOff,
                        tOff_[yd], tC_[yd], tH_[yd], tW_[yd],
                        tH_[wb], tW_[wb],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i], opP8_[i]);
                } else if (opKind_[i] == 40) {
                    // F8：ConvTranspose（group=1）
                    int xa = opA_[i]; int wb = opB_[i]; int bc = opC_[i]; int yd = opD_[i];
                    int bOff = -1; if (bc >= 0) bOff = tOff_[bc];
                    InferOps.convTranspose(arena,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[wb], bOff,
                        tOff_[yd], tC_[yd], tH_[yd], tW_[yd],
                        tH_[wb], tW_[wb],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i]);
                } else if (opKind_[i] == 41) {
                    // 3D：Conv3D（权重 [Cout,Cin,kd,kh,kw]；kd=tD_[wb]）
                    int xa = opA_[i]; int wb = opB_[i]; int bc = opC_[i]; int yd = opD_[i];
                    int bOff = -1; if (bc >= 0) bOff = tOff_[bc];
                    InferOps.conv3d(arena,
                        tOff_[xa], tN_[xa], tC_[xa], tD_[xa], tH_[xa], tW_[xa],
                        tOff_[wb], bOff,
                        tOff_[yd], tC_[yd], tD_[yd], tH_[yd], tW_[yd],
                        tD_[wb], tH_[wb], tW_[wb],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], opP8_[i],
                        opX_[i * 4 + 0], opX_[i * 4 + 1], opX_[i * 4 + 2], opX_[i * 4 + 3]);
                } else if (opKind_[i] == 42) {
                    // 3D：MaxPool3D
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.maxpool3d(arena,
                        tOff_[xa], tN_[xa], tC_[xa], tD_[xa], tH_[xa], tW_[xa],
                        tOff_[yd], tD_[yd], tH_[yd], tW_[yd],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i], opP8_[i], opX_[i * 4 + 0], opX_[i * 4 + 1], opX_[i * 4 + 2]);
                } else if (opKind_[i] == 43) {
                    // 3D：AveragePool3D
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.avgpool3d(arena,
                        tOff_[xa], tN_[xa], tC_[xa], tD_[xa], tH_[xa], tW_[xa],
                        tOff_[yd], tD_[yd], tH_[yd], tW_[yd],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i], opP8_[i], opX_[i * 4 + 0], opX_[i * 4 + 1], opX_[i * 4 + 2],
                        opX_[i * 4 + 3]);
                } else if (opKind_[i] == 45) {
                    // 3D：Resize3D（N/C 由张量给出）
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.resize3d(arena, tOff_[xa], tOff_[yd],
                        tN_[xa], tC_[xa],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i]);
                } else if (opKind_[i] == 11) {
                    int xa = opA_[i]; int wb = opB_[i]; int bc = opC_[i]; int yd = opD_[i];
                    int bOff = -1; if (bc >= 0) bOff = tOff_[bc];   // 无偏置卷积（bc=-1）
                    InferOps.convRelu(arena,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[wb], bOff,
                        tOff_[yd], tC_[yd], tH_[yd], tW_[yd],
                        tH_[wb], tW_[wb],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i], opP8_[i]);
                } else if (opKind_[i] == 8) {
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.maxpool(arena,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[yd], tH_[yd], tW_[yd],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i]);
                } else if (opKind_[i] == 36) {
                    // F8：AveragePool
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.avgpool(arena,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[yd], tH_[yd], tW_[yd],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], opP8_[i]);
                } else if (opKind_[i] == 38) {
                    // F8：Pad
                    int xa = opA_[i]; int yd = opB_[i];
                    double cv = F32.toDouble(pCval_[i]);
                    InferOps.pad(arena, tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                                 tOff_[yd], tN_[yd], tC_[yd], tH_[yd], tW_[yd],
                                 opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i],
                                 opP8_[i], cv);
                } else if (opKind_[i] == 44) {
                    // 3D：Pad3D
                    int xa = opA_[i]; int yd = opB_[i];
                    double cv = F32.toDouble(opX_[i * 4 + 2]);
                    InferOps.pad3d(arena, tOff_[xa], tN_[xa], tC_[xa], tD_[xa], tH_[xa], tW_[xa],
                                 tOff_[yd], tN_[yd], tC_[yd], tD_[yd], tH_[yd], tW_[yd],
                                 opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], opP8_[i], opX_[i * 4 + 0],
                                 opX_[i * 4 + 1], cv);
                } else if (opKind_[i] == 9) {
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.gapool(arena, tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa], tOff_[yd]);
                } else if (opKind_[i] == 10) {
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.flatten(arena, tOff_[xa], tOff_[yd], tRows_[xa] * tCols_[xa]);
                } else if (opKind_[i] == 12) {
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.transposeNCHW2NHWC(arena, tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa], tOff_[yd]);
                } else if (opKind_[i] == 13) {
                    int xa = opA_[i]; int wb = opB_[i]; int bc = opC_[i]; int yd = opD_[i];
                    int bOff = -1; if (bc >= 0) bOff = tOff_[bc];   // 无偏置卷积（bc=-1）
                    InferOps.convNHWC(arena,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[wb], bOff,
                        tOff_[yd], tC_[yd], tH_[yd], tW_[yd],
                        tC_[wb], tH_[wb],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i], opP8_[i]);
                } else if (opKind_[i] == 14) {
                    int xa = opA_[i]; int wb = opB_[i]; int bc = opC_[i]; int yd = opD_[i];
                    int bOff = -1; if (bc >= 0) bOff = tOff_[bc];   // 无偏置卷积（bc=-1）
                    InferOps.convNHWCRelu(arena,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[wb], bOff,
                        tOff_[yd], tC_[yd], tH_[yd], tW_[yd],
                        tC_[wb], tH_[wb],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i], opP8_[i]);
                } else if (opKind_[i] == 15) {
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.maxpoolNHWC(arena,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[yd], tC_[yd], tH_[yd],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i]);
                } else if (opKind_[i] == 37) {
                    // F8：AveragePool（NHWC）
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.avgpoolNHWC(arena,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[yd], tC_[yd], tH_[yd],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], opP8_[i]);
                } else if (opKind_[i] == 39) {
                    // F8：Pad（NHWC）
                    int xa = opA_[i]; int yd = opB_[i];
                    double cv = F32.toDouble(pCval_[i]);
                    InferOps.padNHWC(arena, tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                                     tOff_[yd], tN_[yd], tC_[yd], tH_[yd], tW_[yd],
                                     opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i],
                                     opP8_[i], cv);
                } else if (opKind_[i] == 16) {
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.gapoolNHWC(arena, tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa], tOff_[yd]);
                } else if (opKind_[i] == 17) {
                    int xa = opA_[i]; int yd = opB_[i];
                    double eps = 1.0e-5;
                    if (opP3_[i] == 1) eps = F32.toDouble(opP2_[i]);
                    InferOps.batchnorm(arena, tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa], tOff_[yd],
                        tOff_[opC_[i]], tOff_[opD_[i]], tOff_[opP0_[i]], tOff_[opP1_[i]], eps);
                } else if (opKind_[i] == 18) {
                    int xa = opA_[i]; int yd = opB_[i];
                    double eps = 1.0e-5;
                    if (opP3_[i] == 1) eps = F32.toDouble(opP2_[i]);
                    InferOps.batchnormNHWC(arena, tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa], tOff_[yd],
                        tOff_[opC_[i]], tOff_[opD_[i]], tOff_[opP0_[i]], tOff_[opP1_[i]], eps);
                } else if (opKind_[i] == 19) {
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.relu6(arena, tOff_[xa], tOff_[yd], tRows_[xa] * tCols_[xa]);
                } else if (opKind_[i] == 20) {
                    int xa = opA_[i]; int yd = opB_[i];
                    double alpha = 0.01;
                    if (opP1_[i] == 1) alpha = F32.toDouble(opP0_[i]);
                    InferOps.leakyrelu(arena, tOff_[xa], tOff_[yd], tRows_[xa] * tCols_[xa], alpha);
                } else if (opKind_[i] == 21) {
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.silu(arena, tOff_[xa], tOff_[yd], tRows_[xa] * tCols_[xa]);
                } else if (opKind_[i] == 22) {
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.hardswish(arena, tOff_[xa], tOff_[yd], tRows_[xa] * tCols_[xa]);
                } else if (opKind_[i] == 23) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int minOff = -1; if (opP0_[i] >= 0) minOff = tOff_[opP0_[i]];
                    int maxOff = -1; if (opP1_[i] >= 0) maxOff = tOff_[opP1_[i]];
                    InferOps.clip(arena, tOff_[xa], tOff_[yd], tRows_[xa] * tCols_[xa], minOff, maxOff);
                } else if (opKind_[i] == 24) {
                    // F8：Reshape —— 连续拷贝
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.copyFlat(arena, tOff_[xa], tOff_[yd], tRows_[xa] * tCols_[xa]);
                } else if (opKind_[i] == 25) {
                    // F8：Concat —— 沿 axis 拼接（维度/轴长 = op 参数，内存行优先）
                    int a0 = opA_[i]; int a1 = opB_[i]; int a2 = opC_[i]; int yd = opD_[i];
                    int axis = opP0_[i]; int nIn = opP1_[i];
                    int od0 = opP2_[i], od1 = opP3_[i], od2 = opP4_[i], od3 = opP5_[i];
                    int ax0 = opP6_[i], ax1 = opP7_[i], ax2 = opP8_[i];
                    int off2 = 0;
                    if (a2 >= 0) off2 = tOff_[a2];
                    InferOps.concat(arena, tOff_[a0], tOff_[a1], off2, tOff_[yd],
                                    od0, od1, od2, od3, ax0, ax1, ax2, axis, nIn);
                } else if (opKind_[i] == 26) {
                    // F8：Transpose —— perm 转置（输入维度 = op 参数）
                    int xa = opA_[i]; int yd = opB_[i];
                    int p0 = opP0_[i], p1 = opP1_[i], p2 = opP2_[i], p3 = opP3_[i];
                    int pc = opP4_[i];
                    int id0 = opP5_[i], id1 = opP6_[i], id2 = opP7_[i], id3 = opP8_[i];
                    InferOps.transpose(arena, tOff_[xa], tOff_[yd],
                                       id0, id1, id2, id3, p0, p1, p2, p3, pc);
                } else if (opKind_[i] == 27) {
                    // F8：Slice —— 沿任意轴切片
                    int xa = opA_[i]; int yd = opB_[i];
                    int cnt = sCnt_[i];
                    int id0 = sId_[i * 4 + 0], id1 = sId_[i * 4 + 1], id2 = sId_[i * 4 + 2], id3 = sId_[i * 4 + 3];
                    int od0 = sOd_[i * 4 + 0], od1 = sOd_[i * 4 + 1], od2 = sOd_[i * 4 + 2], od3 = sOd_[i * 4 + 3];
                    int ax0 = sAx_[i * 4 + 0], st0 = sSt_[i * 4 + 0], sp0 = sSp_[i * 4 + 0];
                    int ax1 = sAx_[i * 4 + 1], st1 = sSt_[i * 4 + 1], sp1 = sSp_[i * 4 + 1];
                    int ax2 = sAx_[i * 4 + 2], st2 = sSt_[i * 4 + 2], sp2 = sSp_[i * 4 + 2];
                    int ax3 = sAx_[i * 4 + 3], st3 = sSt_[i * 4 + 3], sp3 = sSp_[i * 4 + 3];
                    InferOps.sliceOp(arena, tOff_[xa], tOff_[yd], cnt, id0, id1, id2, id3, od0, od1, od2, od3,
                                     ax0, st0, sp0, ax1, st1, sp1, ax2, st2, sp2, ax3, st3, sp3);
                } else if (opKind_[i] == 28) {
                    // F8：Resize2D —— nearest/bilinear
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.resize2d(arena, tOff_[xa], tOff_[yd],
                                      opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                                      opP6_[i], opP7_[i]);
                } else if (opKind_[i] == 29) {
                    // F8：Split —— 沿 axis 复制 [start, start+len)
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.splitOp(arena, tOff_[xa], tOff_[yd],
                                     opP0_[i], opP1_[i], opP2_[i],
                                     opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i]);
                } else if (opKind_[i] == 30) {
                    // F8：ReduceMean —— 全/空间规约
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.reduceMean(arena, tOff_[xa], tOff_[yd],
                                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i]);
                } else if (opKind_[i] == 31) {
                    int aa = opA_[i]; int bb = opB_[i]; int oc = opC_[i];
                    InferOps.sub(arena, tOff_[aa], tOff_[bb], tOff_[oc], tensorSize(oc), tensorSize(bb), opP0_[i], opP1_[i]);
                } else if (opKind_[i] == 32) {
                    int aa = opA_[i]; int bb = opB_[i]; int oc = opC_[i];
                    InferOps.div(arena, tOff_[aa], tOff_[bb], tOff_[oc], tensorSize(oc), tensorSize(bb), opP0_[i], opP1_[i]);
                } else if (opKind_[i] == 33) {
                    int aa = opA_[i]; int bb = opB_[i]; int oc = opC_[i];
                    InferOps.mul(arena, tOff_[aa], tOff_[bb], tOff_[oc], tensorSize(oc), tensorSize(bb), opP0_[i], opP1_[i]);
                } else if (opKind_[i] == 34) {
                    int xa = opA_[i]; int yd = opB_[i];
                    InferOps.sqrt1(arena, tOff_[xa], tOff_[yd], tensorSize(yd));
                } else if (opKind_[i] == 35) {
                    // F8：InstanceNormalization —— per-(n,c) 空间归一化
                    int xa = opA_[i]; int sT = opB_[i]; int bT = opC_[i]; int yd = opD_[i];
                    double eps = 1.0e-5;
                    if (opP4_[i] == 1) eps = F32.toDouble(opP3_[i]);
                    InferOps.instancenorm(arena, tOff_[xa], tOff_[sT], tOff_[bT], tOff_[yd],
                                          opP0_[i], opP1_[i], opP2_[i], eps, opRelu_[i]);
                } else if (opKind_[i] == 50) {
                    // 训练：dense 反向（仅 trainMode）
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int w = opC_[i]; int dx = opD_[i];
                        int dw = opP0_[i]; int db = opP1_[i];
                        InferOps.bwdDense(arena, tOff_[dy], tOff_[x], tRows_[x], tCols_[x], tOff_[w], tRows_[w],
                                          tOff_[dx], tOff_[dw], tOff_[db]);
                    }
                } else if (opKind_[i] == 51) {
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int dx = opC_[i];
                        InferOps.bwdRelu(arena, tOff_[dy], tOff_[x], tOff_[dx], tRows_[x] * tCols_[x]);
                    }
                } else if (opKind_[i] == 52) {
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int y = opB_[i]; int dx = opC_[i];
                        InferOps.bwdSigmoid(arena, tOff_[dy], tOff_[y], tOff_[dx], tRows_[y] * tCols_[y]);
                    }
                } else if (opKind_[i] == 53) {
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int da = opB_[i]; int db = opC_[i];
                        InferOps.bwdAdd(arena, tOff_[dy], tOff_[da], tOff_[db], tRows_[dy] * tCols_[dy]);
                    }
                } else if (opKind_[i] == 54) {
                    // 训练：Softmax+CE 合并（loss + dlogits）
                    if (trainMode_ == 1) {
                        int lg = opA_[i]; int lb = opB_[i]; int dl = opC_[i]; int lo = opD_[i];
                        InferOps.softmaxCE(arena, tOff_[lg], tOff_[lb], tRows_[lg], tCols_[lg], tOff_[dl], tOff_[lo]);
                    }
                } else if (opKind_[i] == 55) {
                    // 训练：参数更新 W -= lr·grad
                    if (trainMode_ == 1) {
                        int w = opA_[i]; int g = opB_[i];
                        InferOps.update(arena, tOff_[w], tOff_[g], tRows_[w] * tCols_[w], lr_);
                    }
                } else if (opKind_[i] == 56) {
                    // 阶段3：conv 反向（db=-1 表示无偏置卷积）
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int w = opC_[i]; int dx = opD_[i];
                        int dw = opP0_[i]; int db = opP1_[i];
                        int dbOff = -1;
                        if (db >= 0) dbOff = tOff_[db];
                        InferOps.bwdConv(arena, tOff_[dy], tOff_[x], tN_[x], tC_[x], tH_[x], tW_[x],
                                         tOff_[w], tOff_[dx], tOff_[dw], dbOff,
                                         tC_[dy], tH_[dy], tW_[dy],
                                         tH_[w], tW_[w],
                                         opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], opP8_[i]);
                    }
                } else if (opKind_[i] == 57) {
                    // 阶段3：maxpool 反向
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int dx = opC_[i];
                        InferOps.bwdMaxPool(arena, tOff_[dy], tOff_[x], tN_[x], tC_[x], tH_[x], tW_[x],
                                            tOff_[dx], tH_[dy], tW_[dy],
                                            opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i]);
                    }
                } else if (opKind_[i] == 58) {
                    // 阶段4：Conv3D 反向（膨胀 dd=dh=dw=1、group=1；kd/kh/kw 取 w 形状）
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int w = opC_[i]; int dx = opD_[i];
                        int dw = opP0_[i]; int db = opP1_[i];
                        int dbOff = -1;
                        if (db >= 0) dbOff = tOff_[db];
                        InferOps.bwdConv3D(arena, tOff_[dy], tOff_[x], tN_[x], tC_[x], tD_[x], tH_[x], tW_[x],
                                           tOff_[w], tOff_[dx], tOff_[dw], dbOff,
                                           tC_[dy], tD_[dy], tH_[dy], tW_[dy],
                                           tD_[w], tH_[w], tW_[w],
                                           opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], opP8_[i],
                                           opX_[i * 4 + 0], opX_[i * 4 + 1], 1, 1, 1, 1);
                    }
                } else if (opKind_[i] == 59) {
                    // 阶段4：MaxPool3D 反向
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int dx = opC_[i];
                        InferOps.bwdMaxPool3D(arena, tOff_[dy], tOff_[x], tN_[x], tC_[x], tD_[x], tH_[x], tW_[x],
                                              tOff_[dx], tD_[dy], tH_[dy], tW_[dy],
                                              opP0_[i], opP1_[i], opP2_[i],
                                              opP3_[i], opP4_[i], opP5_[i],
                                              opP6_[i], opP7_[i], opP8_[i],
                                              opX_[i * 4 + 0], opX_[i * 4 + 1], opX_[i * 4 + 2]);
                    }
                } else if (opKind_[i] == 60) {
                    // 阶段4：AveragePool3D 反向
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int dx = opC_[i];
                        InferOps.bwdAvgPool3D(arena, tOff_[dy], tOff_[x], tN_[x], tC_[x], tD_[x], tH_[x], tW_[x],
                                              tOff_[dx], tD_[dy], tH_[dy], tW_[dy],
                                              opP0_[i], opP1_[i], opP2_[i],
                                              opP3_[i], opP4_[i], opP5_[i],
                                              opP6_[i], opP7_[i], opP8_[i],
                                              opX_[i * 4 + 0], opX_[i * 4 + 1], opX_[i * 4 + 2], opX_[i * 4 + 3]);
                    }
                } else if (opKind_[i] == 68) {
                    // 阶段4d：ConvTranspose 反向（CPU，group=1）
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int w = opC_[i]; int dx = opD_[i];
                        int dw = opP0_[i]; int db = opP1_[i];
                        int dbOff = -1; if (db >= 0) dbOff = tOff_[db];
                        InferOps.bwdConvTranspose(arena,
                            tOff_[dy], tOff_[x], tN_[x], tC_[x], tH_[x], tW_[x],
                            tOff_[w], tOff_[dx], tOff_[dw], dbOff,
                            tC_[dy], tH_[dy], tW_[dy],
                            tH_[w], tW_[w],
                            opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i]);
                    }
                } else if (opKind_[i] == 61) {
                    // 阶段5：RMSNorm
                    int in = opA_[i]; int g = opB_[i]; int out = opC_[i];
                    InferOps.rmsNorm(arena, tOff_[in], tOff_[g], tOff_[out], opP0_[i], opP1_[i], F32.toDouble(opP2_[i]));
                } else if (opKind_[i] == 62) {
                    // 阶段5：缩放点积注意力（因果掩码；groups=1 即 MHA）
                    int q = opA_[i]; int k = opB_[i]; int v = opC_[i]; int out = opD_[i]; int sc = opP0_[i];
                    InferOps.attention(arena, tOff_[q], tOff_[k], tOff_[v], tOff_[out], tOff_[sc],
                                       opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i]);
                } else if (opKind_[i] == 63) {
                    // 阶段5：embedding 查表
                    int e = opA_[i]; int ids = opB_[i]; int out = opC_[i];
                    InferOps.gatherRows(arena, tOff_[e], tOff_[ids], tOff_[out], opP0_[i], opP1_[i], opP2_[i]);
                } else if (opKind_[i] == 64) {
                    // 阶段5：LayerNorm（GPT-2）
                    int in = opA_[i]; int g = opB_[i]; int b = opC_[i]; int out = opD_[i];
                    InferOps.layerNorm(arena, tOff_[in], tOff_[g], tOff_[b], tOff_[out], opP0_[i], opP1_[i], F32.toDouble(opP2_[i]));
                } else if (opKind_[i] == 65) {
                    // 阶段5：GELU（GPT-2 精确 erf 版）
                    int in = opA_[i]; int out = opB_[i];
                    InferOps.gelu(arena, tOff_[in], tOff_[out], opP0_[i]);
                } else if (opKind_[i] == 66) {
                    // 阶段5：RoPE（Llama 逐头半旋转，原地）
                    int x = opA_[i]; int cos = opB_[i]; int sin = opC_[i];
                    InferOps.rope(arena, tOff_[x], tOff_[cos], tOff_[sin], opP0_[i], opP1_[i], opP2_[i]);
                } else if (opKind_[i] == 67) {
                    // 阶段5：KV cache 增量注意力
                    int q = opA_[i]; int kc = opB_[i]; int vc = opC_[i]; int out = opD_[i]; int sc = opP0_[i];
                    InferOps.attentionCached(arena, tOff_[q], tOff_[kc], tOff_[vc], tOff_[out], tOff_[sc],
                                             opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i]);
                }
                if (prof == 1) {
                    int k = opKind_[i];
                    cpuOpMs_[k] = cpuOpMs_[k] + (__myp_now_ms() - tOp0);
                    cpuOpCnt_[k] = cpuOpCnt_[k] + 1;
                }
                i = i + 1;
            }
            if (prof == 1) printCpuProfile();
        }

        // CPU 性能剖析（MYP_PROF_CPU=1 时 run 末尾调用）：按算子类型降序耗时
        void printCpuProfile() {
            Console.writeLine("==== MYP CPU PROFILE ====");
            Console.writeLine("ops-loop=" + Fmt.f(double(totalCpuMs()), 0) + "ms  ops=" + Fmt.i(opCount_));
            int[] sk = new int[64];
            long[] sm = new long[64];
            int n = 0;
            int k = 0;
            while (k < 64) {
                if (cpuOpCnt_[k] > 0) { sk[n] = k; sm[n] = cpuOpMs_[k]; n = n + 1; }
                k = k + 1;
            }
            int a = 0;
            while (a < n) {
                int bm = a;
                int b = a + 1;
                while (b < n) {
                    if (sm[b] > sm[bm]) bm = b;
                    b = b + 1;
                }
                int tk = sk[a]; sk[a] = sk[bm]; sk[bm] = tk;
                long tm = sm[a]; sm[a] = sm[bm]; sm[bm] = tm;
                a = a + 1;
            }
            int p = 0;
            while (p < n) {
                int kk = sk[p];
                long ms = sm[p];
                double avg = double(ms) / double(cpuOpCnt_[kk]);
                Console.writeLine("  kind=" + Fmt.i(kk, 2) + "  " + opKindName(kk) + "  n=" + Fmt.i(cpuOpCnt_[kk], 3) + "  ms=" + Fmt.f(double(ms), 0, 7) + "  avg=" + Fmt.f(avg, 1));
                p = p + 1;
            }
            Console.writeLine("==== end ====");
        }

        long totalCpuMs() {
            long s = 0L;
            int k = 0;
            while (k < 64) { s = s + cpuOpMs_[k]; k = k + 1; }
            return s;
        }

        // ==================== M3 持久化设备 arena（阶段3d 优化） ====================
        // 背景：旧 runGpu 每次调用都整块 16MB arena H2D→算子→整块 D2H→释放。训练
        // 每样本调用一次（batch=1），12k 样本 = 12k 次 32MB 往返 ≈ 384GB PCIe 传输
        // → GPU 训练反而比 CPU 慢 ~5 倍（实测 23s vs ~120s）。
        // 方案：训练期间 arena 一次性驻留显存（gpuPersistentStart），每次 runGpu 只
        // 增量上传 setFlat 置脏的输入张量（data/label），只下载宿主要读的输出张量
        // （markGpuSync 标记的 loss/prob）；gpuPersistentEnd 整块 D2H 一次取回最终
        // 权重并释放。非持久化调用方（推理 run_onnx 等）行为不变。
        int gpuPersistentStart() {
            if (GpuBackend.available() != 1) return 0;
            if (gpuPersist_ == 1) return 1;   // 已在持久化模式
            gpuArena_ = new GpuBufferF(arena, arenaCap_);
            if (gpuArena_.valid() != 1) return 0;
            gpuPersist_ = 1;
            int t = 0;
            while (t < tensorCount_) { dirtyTid_[t] = 0; t = t + 1; }
            return 1;
        }

        // 结束持久化：整块 D2H 取回最终宿主状态（权重等）+ 释放设备 arena。
        // 训练中若宿主中途要读权重，须先调用本方法（或改用 getFlat 已 sync 的张量）。
        void gpuPersistentEnd() {
            if (gpuPersist_ == 1) {
                gpuArena_.copyToHost(arena, 0, 0, arenaCap_);
                gpuArena_.free();
                gpuPersist_ = 0;
            }
        }

        // 标记某张量在每次 runGpu 后需 D2H 回宿主（宿主在 step 后要读：loss/prob）。
        void markGpuSync(int tid) {
            if (gpuSyncN_ >= 32) return;
            int i = 0;
            while (i < gpuSyncN_) {
                if (gpuSyncTids_[i] == tid) return;
                i = i + 1;
            }
            gpuSyncTids_[gpuSyncN_] = tid;
            gpuSyncN_ = gpuSyncN_ + 1;
        }

        // GPU 执行：M3 设备驻留。
        // 整块 arena 一次 H2D 到设备（GpuBufferF），各算子 resident(a=dev) 直接
        // 操作设备内存（零逐算子传输），最后一次 D2H 取回。
        // GPU 不可用时 dev=0，@gpu for 自动回退 CPU（结果一致，arenaBuf no-op）。
        // MYP_PROF_GPU=1 时按算子类型统计耗时（H2D/算子循环/D2H 三段 + 分型汇总）。
        // 持久化模式（gpuPersist_==1）：复用 gpuArena_，只增量 H2D 脏输入 + 增量 D2H sync 输出。
        void runGpu() {
            long dev = 0L;
            GpuBufferF arenaBuf = null;
            int gpuActive = 0;
            int prof = 0;
            if (Console.getEnv("MYP_PROF_GPU") == "1") prof = 1;
            long tH2D0 = __myp_now_ms();
            if (GpuBackend.available() == 1) {
                if (gpuPersist_ == 1) {
                    // 持久化：复用常驻设备 arena，只上传 setFlat 置脏的输入张量
                    arenaBuf = gpuArena_;
                    dev = arenaBuf.devicePtr();
                    gpuActive = 1;
                    int t = 0;
                    while (t < tensorCount_) {
                        if (dirtyTid_[t] == 1) {
                            arenaBuf.copyFromHost(arena, tOff_[t], tOff_[t], tensorSize(t));
                            dirtyTid_[t] = 0;
                        }
                        t = t + 1;
                    }
                } else {
                    arenaBuf = new GpuBufferF(arena, arenaCap_);
                    dev = arenaBuf.devicePtr();
                    gpuActive = 1;
                }
            }
            long tH2D1 = __myp_now_ms();
            long tLoop0 = __myp_now_ms();
            int i = 0;
            while (i < opCount_) {
                long tOp0 = __myp_now_ms();
                if (Console.getEnv("MYP_LOG_OPS") == "1") {
                    int fd = __myp_io_fopen("/tmp/fine_ops.txt", "ab");
                    __myp_io_write("op " + Fmt.i(i) + " kind=" + Fmt.i(opKind_[i]) + " xa=" + Fmt.i(opA_[i]) + " xb=" + Fmt.i(opB_[i]) + " xc=" + Fmt.i(opC_[i]) + " xd=" + Fmt.i(opD_[i]) + " szY=" + Fmt.i(tensorSize(opB_[i])) + " P0=" + Fmt.i(opP0_[i]) + " P1=" + Fmt.i(opP1_[i]) + " P2=" + Fmt.i(opP2_[i]) + " P3=" + Fmt.i(opP3_[i]) + " P4=" + Fmt.i(opP4_[i]) + " P5=" + Fmt.i(opP5_[i]) + "\n");
                    __myp_io_fclose();
                }
                if (opKind_[i] == 1) {
                    int xa = opA_[i];
                    int wb = opB_[i];
                    int bc = opC_[i];
                    int yd = opD_[i];
                    int work = tRows_[wb] * tCols_[xa];
                    GpuInferOps.dense(arena, work, tOff_[xa], tRows_[xa], tOff_[wb], tRows_[wb], tCols_[xa], tOff_[bc], tOff_[yd], dev);
                } else if (opKind_[i] == 2) {
                    int xa = opA_[i];
                    int yb = opB_[i];
                    GpuInferOps.relu(arena, tRows_[xa] * tCols_[xa], tOff_[xa], tOff_[yb], dev);
                } else if (opKind_[i] == 3) {
                    int xa = opA_[i];
                    int yb = opB_[i];
                    GpuInferOps.softmax(arena, tRows_[xa] * tCols_[xa], tOff_[xa], tOff_[yb], tRows_[xa], tCols_[xa], dev);
                } else if (opKind_[i] == 4) {
                    int xa = opA_[i];
                    int yb = opB_[i];
                    GpuInferOps.sigmoid(arena, tRows_[xa] * tCols_[xa], tOff_[xa], tOff_[yb], dev);
                } else if (opKind_[i] == 5) {
                    int aa = opA_[i];
                    int bb = opB_[i];
                    int oc = opC_[i];
                    GpuInferOps.add(arena, tRows_[aa] * tCols_[aa], tOff_[aa], tOff_[bb], tOff_[oc], dev, opRelu_[i]);
                } else if (opKind_[i] == 6) {
                    int xa = opA_[i];
                    int wb = opB_[i];
                    int yd = opC_[i];
                    int work = tRows_[wb] * tCols_[xa];
                    GpuInferOps.matmul(arena, work, tOff_[xa], tRows_[xa], tOff_[wb], tRows_[wb], tCols_[xa], tOff_[yd], dev);
                } else if (opKind_[i] == 7) {
                    int xa = opA_[i]; int wb = opB_[i]; int bc = opC_[i]; int yd = opD_[i];
                    int bOff = -1; if (bc >= 0) bOff = tOff_[bc];   // 无偏置卷积（bc=-1）
                    int work = tensorSize(yd);
                    GpuInferOps.conv(arena, work,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[wb], bOff,
                        tOff_[yd], tC_[yd], tH_[yd], tW_[yd],
                        tH_[wb], tW_[wb],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i], opP8_[i], dev);
                } else if (opKind_[i] == 40) {
                    // F8：ConvTranspose（group=1）
                    int xa = opA_[i]; int wb = opB_[i]; int bc = opC_[i]; int yd = opD_[i];
                    int bOff = -1; if (bc >= 0) bOff = tOff_[bc];
                    int work = tensorSize(yd);
                    GpuInferOps.convTranspose(arena, work,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[wb], bOff,
                        tOff_[yd], tC_[yd], tH_[yd], tW_[yd],
                        tH_[wb], tW_[wb],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], dev);
                } else if (opKind_[i] == 41) {
                    // 3D：Conv3D
                    int xa = opA_[i]; int wb = opB_[i]; int bc = opC_[i]; int yd = opD_[i];
                    int bOff = -1; if (bc >= 0) bOff = tOff_[bc];
                    int work = tensorSize(yd);
                    if (Console.getEnv("MYP_DEBUG_CONV") == "1") {
                        Console.writeString("conv " + " C" + tC_[xa] + ">" + tC_[yd] + " " + tD_[yd] + "x" + tH_[yd] + "x" + tW_[yd] + " k" + tD_[wb] + "x" + tH_[wb] + "x" + tW_[wb]);
                        Console.writeLine("");
                    }
                    GpuInferOps.conv3dTiled(arena, work,
                        tOff_[xa], tN_[xa], tC_[xa], tD_[xa], tH_[xa], tW_[xa],
                        tOff_[wb], bOff,
                        tOff_[yd], tC_[yd], tD_[yd], tH_[yd], tW_[yd],
                        tD_[wb], tH_[wb], tW_[wb],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], opP8_[i],
                        opX_[i * 4 + 0], opX_[i * 4 + 1], opX_[i * 4 + 2], opX_[i * 4 + 3], dev);
                } else if (opKind_[i] == 42) {
                    // 3D：MaxPool3D
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.maxpool3d(arena, work,
                        tOff_[xa], tN_[xa], tC_[xa], tD_[xa], tH_[xa], tW_[xa],
                        tOff_[yd], tD_[yd], tH_[yd], tW_[yd],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i], opP8_[i], opX_[i * 4 + 0], opX_[i * 4 + 1], opX_[i * 4 + 2], dev);
                } else if (opKind_[i] == 43) {
                    // 3D：AveragePool3D
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.avgpool3d(arena, work,
                        tOff_[xa], tN_[xa], tC_[xa], tD_[xa], tH_[xa], tW_[xa],
                        tOff_[yd], tD_[yd], tH_[yd], tW_[yd],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i], opP8_[i], opX_[i * 4 + 0], opX_[i * 4 + 1], opX_[i * 4 + 2],
                        opX_[i * 4 + 3], dev);
                } else if (opKind_[i] == 45) {
                    // 3D：Resize3D
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.resize3d(arena, work, tOff_[xa], tOff_[yd],
                        tN_[xa], tC_[xa],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i], dev);
                } else if (opKind_[i] == 11) {
                    int xa = opA_[i]; int wb = opB_[i]; int bc = opC_[i]; int yd = opD_[i];
                    int bOff = -1; if (bc >= 0) bOff = tOff_[bc];   // 无偏置卷积（bc=-1）
                    int work = tensorSize(yd);
                    GpuInferOps.convRelu(arena, work,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[wb], bOff,
                        tOff_[yd], tC_[yd], tH_[yd], tW_[yd],
                        tH_[wb], tW_[wb],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i], opP8_[i], dev);
                } else if (opKind_[i] == 8) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.maxpool(arena, work,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[yd], tH_[yd], tW_[yd],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], dev);
                } else if (opKind_[i] == 36) {
                    // F8：AveragePool
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.avgpool(arena, work,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[yd], tH_[yd], tW_[yd],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], opP8_[i], dev);
                } else if (opKind_[i] == 38) {
                    // F8：Pad
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    double cv = F32.toDouble(pCval_[i]);
                    GpuInferOps.pad(arena, work, tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                                    tOff_[yd], tN_[yd], tC_[yd], tH_[yd], tW_[yd],
                                    opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i],
                                    opP8_[i], cv, dev);
                } else if (opKind_[i] == 44) {
                    // 3D：Pad3D
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    double cv = F32.toDouble(opX_[i * 4 + 2]);
                    GpuInferOps.pad3d(arena, work, tOff_[xa], tN_[xa], tC_[xa], tD_[xa], tH_[xa], tW_[xa],
                                    tOff_[yd], tN_[yd], tC_[yd], tD_[yd], tH_[yd], tW_[yd],
                                    opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], opP8_[i], opX_[i * 4 + 0],
                                    opX_[i * 4 + 1], cv, dev);
                } else if (opKind_[i] == 9) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.gapool(arena, work,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa], tOff_[yd], dev);
                } else if (opKind_[i] == 10) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(xa);
                    GpuInferOps.flatten(arena, work, tOff_[xa], tOff_[yd], dev);
                } else if (opKind_[i] == 12) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(xa);
                    GpuInferOps.transposeNCHW2NHWC(arena, work, tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa], tOff_[yd], dev);
                } else if (opKind_[i] == 13) {
                    int xa = opA_[i]; int wb = opB_[i]; int bc = opC_[i]; int yd = opD_[i];
                    int bOff = -1; if (bc >= 0) bOff = tOff_[bc];   // 无偏置卷积（bc=-1）
                    int work = tensorSize(yd);
                    GpuInferOps.convNHWC(arena, work,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[wb], bOff,
                        tOff_[yd], tC_[yd], tH_[yd], tW_[yd],
                        tC_[wb], tH_[wb],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i], opP8_[i], dev);
                } else if (opKind_[i] == 14) {
                    int xa = opA_[i]; int wb = opB_[i]; int bc = opC_[i]; int yd = opD_[i];
                    int bOff = -1; if (bc >= 0) bOff = tOff_[bc];   // 无偏置卷积（bc=-1）
                    int work = tensorSize(yd);
                    GpuInferOps.convNHWCRelu(arena, work,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[wb], bOff,
                        tOff_[yd], tC_[yd], tH_[yd], tW_[yd],
                        tC_[wb], tH_[wb],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                        opP6_[i], opP7_[i], opP8_[i], dev);
                } else if (opKind_[i] == 15) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.maxpoolNHWC(arena, work,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[yd], tC_[yd], tH_[yd],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], dev);
                } else if (opKind_[i] == 37) {
                    // F8：AveragePool（NHWC）
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.avgpoolNHWC(arena, work,
                        tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                        tOff_[yd], tC_[yd], tH_[yd],
                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], opP8_[i], dev);
                } else if (opKind_[i] == 39) {
                    // F8：Pad（NHWC）
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    double cv = F32.toDouble(pCval_[i]);
                    GpuInferOps.padNHWC(arena, work, tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa],
                                        tOff_[yd], tN_[yd], tC_[yd], tH_[yd], tW_[yd],
                                        opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i],
                                        opP8_[i], cv, dev);
                } else if (opKind_[i] == 16) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.gapoolNHWC(arena, work, tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa], tOff_[yd], dev);
                } else if (opKind_[i] == 17) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    double eps = 1.0e-5;
                    if (opP3_[i] == 1) eps = F32.toDouble(opP2_[i]);
                    GpuInferOps.batchnorm(arena, work, tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa], tOff_[yd],
                        tOff_[opC_[i]], tOff_[opD_[i]], tOff_[opP0_[i]], tOff_[opP1_[i]], eps, dev);
                } else if (opKind_[i] == 18) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    double eps = 1.0e-5;
                    if (opP3_[i] == 1) eps = F32.toDouble(opP2_[i]);
                    GpuInferOps.batchnormNHWC(arena, work, tOff_[xa], tN_[xa], tC_[xa], tH_[xa], tW_[xa], tOff_[yd],
                        tOff_[opC_[i]], tOff_[opD_[i]], tOff_[opP0_[i]], tOff_[opP1_[i]], eps, dev);
                } else if (opKind_[i] == 19) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.relu6(arena, work, tOff_[xa], tOff_[yd], dev);
                } else if (opKind_[i] == 20) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    double alpha = 0.01;
                    if (opP1_[i] == 1) alpha = F32.toDouble(opP0_[i]);
                    GpuInferOps.leakyrelu(arena, work, tOff_[xa], tOff_[yd], alpha, dev);
                } else if (opKind_[i] == 21) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.silu(arena, work, tOff_[xa], tOff_[yd], dev);
                } else if (opKind_[i] == 22) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.hardswish(arena, work, tOff_[xa], tOff_[yd], dev);
                } else if (opKind_[i] == 23) {
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    int minOff = -1; if (opP0_[i] >= 0) minOff = tOff_[opP0_[i]];
                    int maxOff = -1; if (opP1_[i] >= 0) maxOff = tOff_[opP1_[i]];
                    GpuInferOps.clip(arena, work, tOff_[xa], tOff_[yd], minOff, maxOff, dev);
                } else if (opKind_[i] == 24) {
                    // F8：Reshape —— 连续拷贝
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.copyFlat(arena, work, tOff_[xa], tOff_[yd], dev);
                } else if (opKind_[i] == 25) {
                    // F8：Concat —— 沿 axis 拼接（维度/轴长 = op 参数）
                    int a0 = opA_[i]; int a1 = opB_[i]; int a2 = opC_[i]; int yd = opD_[i];
                    int axis = opP0_[i]; int nIn = opP1_[i];
                    int od0 = opP2_[i], od1 = opP3_[i], od2 = opP4_[i], od3 = opP5_[i];
                    int ax0 = opP6_[i], ax1 = opP7_[i], ax2 = opP8_[i];
                    int off2 = 0;
                    if (a2 >= 0) off2 = tOff_[a2];
                    int work = tensorSize(yd);
                    GpuInferOps.concat(arena, work, tOff_[a0], tOff_[a1], off2, tOff_[yd],
                                       od0, od1, od2, od3, ax0, ax1, ax2, axis, nIn, dev);
                } else if (opKind_[i] == 26) {
                    // F8：Transpose —— perm 转置（输入维度 = op 参数）
                    int xa = opA_[i]; int yd = opB_[i];
                    int p0 = opP0_[i], p1 = opP1_[i], p2 = opP2_[i], p3 = opP3_[i];
                    int pc = opP4_[i];
                    int id0 = opP5_[i], id1 = opP6_[i], id2 = opP7_[i], id3 = opP8_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.transpose(arena, work, tOff_[xa], tOff_[yd],
                                          id0, id1, id2, id3, p0, p1, p2, p3, pc, dev);
                } else if (opKind_[i] == 27) {
                    // F8：Slice —— 沿任意轴切片
                    int xa = opA_[i]; int yd = opB_[i];
                    int cnt = sCnt_[i];
                    int id0 = sId_[i * 4 + 0], id1 = sId_[i * 4 + 1], id2 = sId_[i * 4 + 2], id3 = sId_[i * 4 + 3];
                    int od0 = sOd_[i * 4 + 0], od1 = sOd_[i * 4 + 1], od2 = sOd_[i * 4 + 2], od3 = sOd_[i * 4 + 3];
                    int ax0 = sAx_[i * 4 + 0], st0 = sSt_[i * 4 + 0], sp0 = sSp_[i * 4 + 0];
                    int ax1 = sAx_[i * 4 + 1], st1 = sSt_[i * 4 + 1], sp1 = sSp_[i * 4 + 1];
                    int ax2 = sAx_[i * 4 + 2], st2 = sSt_[i * 4 + 2], sp2 = sSp_[i * 4 + 2];
                    int ax3 = sAx_[i * 4 + 3], st3 = sSt_[i * 4 + 3], sp3 = sSp_[i * 4 + 3];
                    int work = tensorSize(yd);
                    GpuInferOps.sliceOp(arena, work, tOff_[xa], tOff_[yd], cnt, id0, id1, id2, id3, od0, od1, od2, od3,
                                        ax0, st0, sp0, ax1, st1, sp1, ax2, st2, sp2, ax3, st3, sp3, dev);
                } else if (opKind_[i] == 28) {
                    // F8：Resize2D
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.resize2d(arena, work, tOff_[xa], tOff_[yd],
                                         opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i],
                                         opP6_[i], opP7_[i], dev);
                } else if (opKind_[i] == 29) {
                    // F8：Split
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = tensorSize(yd);
                    GpuInferOps.splitOp(arena, work, tOff_[xa], tOff_[yd],
                                        opP0_[i], opP1_[i], opP2_[i],
                                        opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], dev);
                } else if (opKind_[i] == 30) {
                    // F8：ReduceMean
                    int xa = opA_[i]; int yd = opB_[i];
                    int work = (opP0_[i] == 0) ? 1 : (opP1_[i] * opP2_[i]);
                    GpuInferOps.reduceMean(arena, work, tOff_[xa], tOff_[yd],
                                           opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i], dev, statsOff_);
                } else if (opKind_[i] == 31) {
                    int aa = opA_[i]; int bb = opB_[i]; int oc = opC_[i];
                    GpuInferOps.sub(arena, tensorSize(oc), tOff_[aa], tOff_[bb], tOff_[oc], tensorSize(bb), opP0_[i], opP1_[i], dev);
                } else if (opKind_[i] == 32) {
                    int aa = opA_[i]; int bb = opB_[i]; int oc = opC_[i];
                    GpuInferOps.div(arena, tensorSize(oc), tOff_[aa], tOff_[bb], tOff_[oc], tensorSize(bb), opP0_[i], opP1_[i], dev);
                } else if (opKind_[i] == 33) {
                    int aa = opA_[i]; int bb = opB_[i]; int oc = opC_[i];
                    GpuInferOps.mul(arena, tensorSize(oc), tOff_[aa], tOff_[bb], tOff_[oc], tensorSize(bb), opP0_[i], opP1_[i], dev);
                } else if (opKind_[i] == 34) {
                    int xa = opA_[i]; int yd = opB_[i];
                    GpuInferOps.sqrt1(arena, tensorSize(yd), tOff_[xa], tOff_[yd], dev);
                } else if (opKind_[i] == 35) {
                    // F8：InstanceNormalization
                    int xa = opA_[i]; int sT = opB_[i]; int bT = opC_[i]; int yd = opD_[i];
                    double eps = 1.0e-5;
                    if (opP4_[i] == 1) eps = F32.toDouble(opP3_[i]);
                    int work = opP0_[i] * opP1_[i];
                    GpuInferOps.instancenorm(arena, work, tOff_[xa], tOff_[sT], tOff_[bT], tOff_[yd],
                                             opP0_[i], opP1_[i], opP2_[i], eps, dev, statsOff_, opRelu_[i]);
                } else if (opKind_[i] == 50) {
                    // 阶段2：dense 反向（GPU）
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int w = opC_[i]; int dx = opD_[i];
                        int dw = opP0_[i]; int db = opP1_[i];
                        GpuInferOps.bwdDense(arena, dev, tOff_[dy], tOff_[x], tRows_[x], tCols_[x],
                                             tOff_[w], tRows_[w], tOff_[dx], tOff_[dw], tOff_[db]);
                    }
                } else if (opKind_[i] == 51) {
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int dx = opC_[i];
                        GpuInferOps.bwdRelu(arena, dev, tOff_[dy], tOff_[x], tOff_[dx], tRows_[x] * tCols_[x]);
                    }
                } else if (opKind_[i] == 52) {
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int y = opB_[i]; int dx = opC_[i];
                        GpuInferOps.bwdSigmoid(arena, dev, tOff_[dy], tOff_[y], tOff_[dx], tRows_[y] * tCols_[y]);
                    }
                } else if (opKind_[i] == 53) {
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int da = opB_[i]; int db = opC_[i];
                        GpuInferOps.bwdAdd(arena, dev, tOff_[dy], tOff_[da], tOff_[db], tRows_[dy] * tCols_[dy]);
                    }
                } else if (opKind_[i] == 54) {
                    if (trainMode_ == 1) {
                        int lg = opA_[i]; int lb = opB_[i]; int dl = opC_[i]; int lo = opD_[i];
                        GpuInferOps.softmaxCE(arena, dev, tOff_[lg], tOff_[lb], tRows_[lg], tCols_[lg],
                                              tOff_[dl], tOff_[lo]);
                    }
                } else if (opKind_[i] == 55) {
                    if (trainMode_ == 1) {
                        int w = opA_[i]; int g = opB_[i];
                        GpuInferOps.update(arena, dev, tOff_[w], tOff_[g], tRows_[w] * tCols_[w], lr_);
                    }
                } else if (opKind_[i] == 56) {
                    // 阶段3：conv 反向（GPU）
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int w = opC_[i]; int dx = opD_[i];
                        int dw = opP0_[i]; int db = opP1_[i];
                        int dbOff = -1;
                        if (db >= 0) dbOff = tOff_[db];
                        GpuInferOps.bwdConv(arena, dev, tOff_[dy], tOff_[x], tN_[x], tC_[x], tH_[x], tW_[x],
                                            tOff_[w], tOff_[dx], tOff_[dw], dbOff,
                                            tC_[dy], tH_[dy], tW_[dy],
                                            tH_[w], tW_[w],
                                            opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], opP8_[i]);
                    }
                } else if (opKind_[i] == 57) {
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int dx = opC_[i];
                        GpuInferOps.bwdMaxPool(arena, dev, tOff_[dy], tOff_[x], tN_[x], tC_[x], tH_[x], tW_[x],
                                               tOff_[dx], tH_[dy], tW_[dy],
                                               opP0_[i], opP1_[i], opP2_[i], opP3_[i], opP4_[i], opP5_[i]);
                    }
                } else if (opKind_[i] == 58) {
                    // 阶段4b：Conv3D 反向（GPU；膨胀=1、group=1，kd/kh/kw 取 w 形状）
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int w = opC_[i]; int dx = opD_[i];
                        int dw = opP0_[i]; int db = opP1_[i];
                        int dbOff = -1;
                        if (db >= 0) dbOff = tOff_[db];
                        GpuInferOps.bwdConv3D(arena, dev, tOff_[dy], tOff_[x], tN_[x], tC_[x], tD_[x], tH_[x], tW_[x],
                                              tOff_[w], tOff_[dx], tOff_[dw], dbOff,
                                              tC_[dy], tD_[dy], tH_[dy], tW_[dy],
                                              tD_[w], tH_[w], tW_[w],
                                              opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i], opP8_[i],
                                              opX_[i * 4 + 0], opX_[i * 4 + 1], 1, 1, 1, 1);
                    }
                } else if (opKind_[i] == 59) {
                    // 阶段4b：MaxPool3D 反向（GPU）
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int dx = opC_[i];
                        GpuInferOps.bwdMaxPool3D(arena, dev, tOff_[dy], tOff_[x], tN_[x], tC_[x], tD_[x], tH_[x], tW_[x],
                                                 tOff_[dx], tD_[dy], tH_[dy], tW_[dy],
                                                 opP0_[i], opP1_[i], opP2_[i],
                                                 opP3_[i], opP4_[i], opP5_[i],
                                                 opP6_[i], opP7_[i], opP8_[i],
                                                 opX_[i * 4 + 0], opX_[i * 4 + 1], opX_[i * 4 + 2]);
                    }
                } else if (opKind_[i] == 60) {
                    // 阶段4b：AveragePool3D 反向（GPU）
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int dx = opC_[i];
                        GpuInferOps.bwdAvgPool3D(arena, dev, tOff_[dy], tOff_[x], tN_[x], tC_[x], tD_[x], tH_[x], tW_[x],
                                                 tOff_[dx], tD_[dy], tH_[dy], tW_[dy],
                                                 opP0_[i], opP1_[i], opP2_[i],
                                                 opP3_[i], opP4_[i], opP5_[i],
                                                 opP6_[i], opP7_[i], opP8_[i],
                                                 opX_[i * 4 + 0], opX_[i * 4 + 1], opX_[i * 4 + 2],
                                                 opX_[i * 4 + 3]);
                    }
                } else if (opKind_[i] == 68) {
                    // 阶段4d：ConvTranspose 反向（GPU，group=1）
                    if (trainMode_ == 1) {
                        int dy = opA_[i]; int x = opB_[i]; int w = opC_[i]; int dx = opD_[i];
                        int dw = opP0_[i]; int db = opP1_[i];
                        int dbOff = -1;
                        if (db >= 0) dbOff = tOff_[db];
                        GpuInferOps.bwdConvTranspose(arena, dev,
                            tOff_[dy], tOff_[x], tN_[x], tC_[x], tH_[x], tW_[x],
                            tOff_[w], tOff_[dx], tOff_[dw], dbOff,
                            tC_[dy], tH_[dy], tW_[dy],
                            tH_[w], tW_[w],
                            opP2_[i], opP3_[i], opP4_[i], opP5_[i], opP6_[i], opP7_[i]);
                    }
                }
                string dumpOpStr = Console.getEnv("MYP_DUMP_OP");
                int dumpOp = -1;
                if (dumpOpStr != "") {
                    // 支持 "a,b,c" 列表
                    int nparts = Str.splitCount(dumpOpStr, ",");
                    int pi = 0;
                    while (pi < nparts) {
                        string part = Str.splitGet(dumpOpStr, ",", pi);
                        if (Str.toInt(part) == i) { dumpOp = i; }
                        pi = pi + 1;
                    }
                }
                if ((Console.getEnv("MYP_DUMP_TAIL") == "1" && i >= opCount_ - 4) || i == dumpOp) {
                    int ot = opOutTid(i);
                    int fd = __myp_io_fopen("/tmp/fine_op_map.txt", "ab");
                    __myp_io_write("op " + Fmt.i(i) + " kind=" + Fmt.i(opKind_[i]) + " tid=" + Fmt.i(ot) + " size=" + Fmt.i(tensorSize(ot)) + " dev=" + Fmt.i(int(dev)) + "\n");
                    __myp_io_fclose();
                    if (ot >= 0) {
                        int osz = tensorSize(ot);
                        arenaBuf.copyToHost(arena, tOff_[ot], 0, osz);
                        int fd2 = __myp_io_fopen("/tmp/fine_op_" + Fmt.i(i) + ".f32", "wb");
                        if (fd2 >= 0) {
                            int j = 0;
                            while (j < osz) {
                                int bits = F32.toBits(arena[j]);
                                __myp_io_write_byte(bits & 255);
                                __myp_io_write_byte((bits >> 8) & 255);
                                __myp_io_write_byte((bits >> 16) & 255);
                                __myp_io_write_byte((bits >> 24) & 255);
                                j = j + 1;
                            }
                            __myp_io_fclose();
                        }
                    }
                }
                if (prof == 1) {
                    int k = opKind_[i];
                    gpuOpMs_[k] = gpuOpMs_[k] + (__myp_now_ms() - tOp0);
                    gpuOpCnt_[k] = gpuOpCnt_[k] + 1;
                }
                i = i + 1;
            }
            long tLoop1 = __myp_now_ms();
            // 用 int 标志 gpuActive 判断（勿用 dev != 0L：设备指针高地址低 32 位
            // 可能为 0，MYP 的 long 比较会误判为相等）。
            long tD2H0 = __myp_now_ms();
            if (gpuActive == 1) {
                if (gpuPersist_ == 1) {
                    // 持久化：只下载宿主要读的输出张量（markGpuSync 标记的 loss/prob）
                    int s = 0;
                    while (s < gpuSyncN_) {
                        int st = gpuSyncTids_[s];
                        if (st >= 0 && st < tensorCount_) {
                            arenaBuf.copyToHost(arena, tOff_[st], tOff_[st], tensorSize(st));
                        }
                        s = s + 1;
                    }
                } else {
                    arenaBuf.copyToHost(arena, 0, 0, arenaCap_);
                    arenaBuf.free();
                }
            }
            long tD2H1 = __myp_now_ms();
            if (prof == 1) {
                printGpuProfile(tH2D1 - tH2D0, tLoop1 - tLoop0, tD2H1 - tD2H0);
            }
        }

        // GPU 性能剖析（MYP_PROF_GPU=1 时 runGpu 末尾调用）：
        // 输出 H2D / 算子循环 / D2H 三段耗时，并按算子类型降序列出累计耗时。
        void printGpuProfile(long h2dMs, long loopMs, long d2hMs) {
            Console.writeLine("==== MYP GPU PROFILE ====");
            Console.writeLine("H2D=" + Fmt.f(double(h2dMs), 0) + "ms  ops-loop=" + Fmt.f(double(loopMs), 0) + "ms  D2H=" + Fmt.f(double(d2hMs), 0) + "ms  ops=" + Fmt.i(opCount_));
            int[] sk = new int[64];
            long[] sm = new long[64];
            int n = 0;
            int k = 0;
            while (k < 64) {
                if (gpuOpCnt_[k] > 0) { sk[n] = k; sm[n] = gpuOpMs_[k]; n = n + 1; }
                k = k + 1;
            }
            // 按累计耗时降序（选择排序）
            int a = 0;
            while (a < n) {
                int bm = a;
                int b = a + 1;
                while (b < n) {
                    if (sm[b] > sm[bm]) bm = b;
                    b = b + 1;
                }
                int tk = sk[a]; sk[a] = sk[bm]; sk[bm] = tk;
                long tm = sm[a]; sm[a] = sm[bm]; sm[bm] = tm;
                a = a + 1;
            }
            int p = 0;
            while (p < n) {
                int kk = sk[p];
                long ms = sm[p];
                double avg = double(ms) / double(gpuOpCnt_[kk]);
                Console.writeLine("  kind=" + Fmt.i(kk, 2) + "  " + opKindName(kk) + "  n=" + Fmt.i(gpuOpCnt_[kk], 3) + "  ms=" + Fmt.f(double(ms), 0, 7) + "  avg=" + Fmt.f(avg, 1));
                p = p + 1;
            }
            Console.writeLine("==== end ====");
        }

        // opKind 的可读名称（供剖析输出）
        string opKindName(int k) {
            if (k == 1) return "dense";
            if (k == 2) return "relu";
            if (k == 3) return "softmax";
            if (k == 4) return "sigmoid";
            if (k == 5) return "add";
            if (k == 6) return "matmul";
            if (k == 7) return "conv";
            if (k == 8) return "maxpool";
            if (k == 9) return "gapool";
            if (k == 10) return "flatten";
            if (k == 11) return "convRelu";
            if (k == 12) return "transposeNCHW2NHWC";
            if (k == 13) return "convNHWC";
            if (k == 14) return "convNHWCRelu";
            if (k == 15) return "maxpoolNHWC";
            if (k == 16) return "gapoolNHWC";
            if (k == 17) return "batchnorm";
            if (k == 18) return "batchnormNHWC";
            if (k == 19) return "relu6";
            if (k == 20) return "leakyrelu";
            if (k == 21) return "silu";
            if (k == 22) return "hardswish";
            if (k == 23) return "clip";
            if (k == 24) return "reshape/copy";
            if (k == 25) return "concat";
            if (k == 26) return "transpose";
            if (k == 27) return "slice";
            if (k == 28) return "resize2d";
            if (k == 29) return "split";
            if (k == 30) return "reduceMean";
            if (k == 31) return "sub";
            if (k == 32) return "div";
            if (k == 33) return "mul";
            if (k == 34) return "sqrt";
            if (k == 35) return "instancenorm";
            if (k == 36) return "avgpool";
            if (k == 37) return "avgpoolNHWC";
            if (k == 38) return "pad";
            if (k == 39) return "padNHWC";
            if (k == 40) return "convTranspose";
            if (k == 41) return "conv3d";
            if (k == 42) return "maxpool3d";
            if (k == 43) return "avgpool3d";
            if (k == 44) return "pad3d";
            if (k == 45) return "resize3d";
            if (k == 68) return "bwdConvTranspose";
            return "kind" + Fmt.i(k);
        }

        int argmax1d(int tid) {
            int n = tRows_[tid] * tCols_[tid];
            int bi = 0;
            double bv = arena[tOff_[tid] + 0];
            int i = 1;
            while (i < n) {
                double v = arena[tOff_[tid] + i];
                if (v > bv) { bv = v; bi = i; }
                i = i + 1;
            }
            return bi;
        }

        // 指定列（样本）的行 argmax
        int argmaxCol(int tid, int col) {
            int batch = tCols_[tid];
            int rows = tRows_[tid];
            int bi = 0;
            double bv = arena[tOff_[tid] + 0 * batch + col];
            int i = 1;
            while (i < rows) {
                double v = arena[tOff_[tid] + i * batch + col];
                if (v > bv) { bv = v; bi = i; }
                i = i + 1;
            }
            return bi;
        }

        int tensorSize(int tid) {
            return tRows_[tid] * tCols_[tid];
        }

        // 调试：返回 op i 的输出张量 id
        int opOutTid(int i) {
            int k = opKind_[i];
            if (k == 1 || k == 7 || k == 11 || k == 13 || k == 14 || k == 25 ||
                k == 35 || k == 41) return opD_[i];
            if (k == 5 || k == 6 || k == 31 || k == 32 || k == 33) return opC_[i];
            return opB_[i];
        }

        // 算子足迹：涉及张量的最大 [偏移, 偏移+大小)，作为 @gpu for 传输上界
        int fp2(int a, int b) {
            int m = tOff_[a] + tensorSize(a);
            int m2 = tOff_[b] + tensorSize(b);
            if (m2 > m) m = m2;
            return m;
        }
        int fp3(int a, int b, int c) {
            int m = fp2(a, b);
            int m2 = tOff_[c] + tensorSize(c);
            if (m2 > m) m = m2;
            return m;
        }
        int fp4(int a, int b, int c, int d) {
            int m = fp3(a, b, c);
            int m2 = tOff_[d] + tensorSize(d);
            if (m2 > m) m = m2;
            return m;
        }

    property:
        float[] arena;
        int[512] tRows_;
        int[512] tCols_;
        int[512] tN_;
        int[512] tC_;
        int[512] tD_;      // 3D 扩展：第 5 维（深度 D，NCDHW）
        int[512] tH_;
        int[512] tW_;
        int[512] tOff_;
        int[512] opKind_;
        int[512] opA_;
        int[512] opB_;
        int[512] opC_;
        int[512] opD_;
        int[512] opP0_;
        int[512] opP1_;
        int[512] opP2_;
        int[512] opP3_;
        int[512] opP4_;
        int[512] opP5_;
        int[512] opP6_;
        int[512] opP7_;
        int[512] opP8_;
        int[2048] opX_;       // 3D：额外参数 [id*4+k]（Conv3D dd/dh/dw/group，MaxPool3D pb/pl/pr）
        int[512] pCval_;      // F8：Pad constant_value（float 位型）
        long[64] gpuOpMs_;    // GPU profiling：按 opKind 累计耗时（ms，MYP_PROF_GPU=1）
        int[64] gpuOpCnt_;    // GPU profiling：按 opKind 计数
        long[64] cpuOpMs_;    // CPU profiling：按 opKind 累计耗时（ms，MYP_PROF_CPU=1）
        int[64] cpuOpCnt_;    // CPU profiling：按 opKind 计数
        int[512] opRelu_;     // 图优化：1 = op 输出直接过 ReLU（IN+Relu 融合等）
        int statsOff_;        // 全 resident 归约暂存区（arena 尾部预留）偏移
        // ---- F8：Slice 参数（按 op id 索引；per-axis [id*4+k]）----
        int[512] sCnt_;
        int[2048] sAx_;
        int[2048] sSt_;
        int[2048] sSp_;
        int[2048] sOd_;
        int[2048] sId_;
        int arenaCap_;
        int arenaTop_;
        int tensorCount_;
        int opCount_;
        int trainMode_;      // 阶段2：1 = 执行反向/更新算子（eval=0 跳过）
        double lr_;          // 阶段2：SGD 学习率（Update 用）
        GpuBufferF gpuArena_;      // 阶段3d：持久化设备 arena（gpuPersist_=1 时有效）
        int gpuPersist_;           // 阶段3d：持久化 arena 模式激活标志
        int[512] dirtyTid_;        // 阶段3d：setFlat 置脏的张量（runGpu 增量 H2D）
        int[32] gpuSyncTids_;      // 阶段3d：runGpu 后需 D2H 的张量（宿主要读：loss/prob）
        int gpuSyncN_;
}
