// runtime.myp — Tiny static-graph inference runtime
import env;
import gpu;
import fmt;
import text;
import "./tensor.myp";
import "./ops.myp";
import "./gpu_ops.myp";
import "./pb.myp";   // F32（分发时把 BN eps 位型解析为 double）
import "./ops_iface_all.myp";   // 全接口算子类 + registerAllIfaceOps（循环导入，LoadedSet 去重）

// 阶段4e：算子接口——每个算子类同时实现前向(forward)与后向(backward)两个方法，
// run()/runGpu() 分发按 opKind 查表：前向 opKind → forward()，反向 opKind → backward()。
// 阶段4e4 起已删除 if/else，只保留接口分派；run()/runGpu() 首调自动
// registerAllIfaceOps(this)（ifaceInit_ 标记，循环导入 ops_iface_all.myp）。
// 算子对象经 rt 公共访问器读参数表/张量表，调 InferOps/GpuInferOps 静态内核。
// （MYP interface = fat-pointer vtable，见 docs/manual.md §Interface 与
// examples/ad.myp 的 IOp{forward,backward} 算子模式）
interface IOp {
    void forward(InferenceRuntime rt, int opIdx);    // 前向（推理/前向传播）
    void backward(InferenceRuntime rt, int opIdx);   // 后向（训练梯度；实现内自检 trainMode）
}

class InferenceRuntime {
    action:
        void init(int arenaCapacity) {
            arenaTop_ = 0;
            tensorCount_ = 0;
            opCount_ = 0;
            trainMode_ = 0;
            lr_ = 0.1;
            gpuPersist_ = 0;   // 阶段3d：持久化设备 arena 默认关闭
            gpuSyncN_ = 0;
            optMode_ = 0; optWd_ = 0.0; optStep_ = 0;
            gradAccEvery_ = 0; gradAccStep_ = 0;
            ampSim_ = 0;
            statsOff_ = arenaCapacity;
            arenaCap_ = arenaCapacity + statsSize();
            if (arenaCap_ < 1) arenaCap_ = 1;
            arena = new float[arenaCap_];
            optBase_ = arenaCap_;
            int oi = 0;
            while (oi < 512) { optOff_[oi] = -1; oi = oi + 1; }
            oi = 0;
            while (oi < 512) { gradAccOff_[oi] = -1; oi = oi + 1; }
        }

        // 重建 arena 到指定容量（用于 ONNX 路径：加载器先做内存规划再建 arena）。
        // 尾部预留 statsSize() 个 float 作为全 resident 归约暂存区（instancenorm/reduceMean）。
        void resizeArena(int cap) {
            statsOff_ = cap;
            arena = new float[cap + statsSize()];
            arenaCap_ = cap + statsSize();
            optMode_ = 0; optWd_ = 0.0; optStep_ = 0;
            gradAccEvery_ = 0; gradAccStep_ = 0;
            ampSim_ = 0;
            optBase_ = arenaCap_;
            int oi = 0;
            while (oi < 512) { optOff_[oi] = -1; oi = oi + 1; }
            oi = 0;
            while (oi < 512) { gradAccOff_[oi] = -1; oi = oi + 1; }
        }

        // 全 resident 归约暂存区大小（float 数）：nC*pt*2 + nC*2，1M 覆盖 nC≤1023
        int statsSize() { return 1048576; }

        // lowerRuntime 前调用：把 bump 分配基移到规划峰值——buildRuntime 的临时
        // 张量（readI64Init 建的 Gather indices / Slice 参数等）用 addTensor bump，
        // 若从 arenaTop_=0 起会覆盖规划区/图输入（曾致 Gather idxT off=0 覆盖 data）。
        void setBumpBase(int base) { arenaTop_ = base; }

        // 边界转换：调用方仍传 double，内部以 float（FP32）存储
        void setFlat(int tid, int index, double v) {
            arena[tOff_[tid] + index] = float(v);
            // 阶段3d：持久化 arena 模式下标记该张量脏（runGpu 只增量上传脏张量）
            if (gpuPersist_ == 1) dirtyTid_[tid] = 1;
        }

        double getFlat(int tid, int index) {
            double v = arena[tOff_[tid] + index];
            return v;
        }

        int addTensor(int rows, int cols) {
            int id = tensorCount_;
            int n = TensorOps.size(rows, cols);
            if (arenaTop_ + n > arenaCap_) return -1;
            tRows_[id] = rows;
            tCols_[id] = cols;
            tN_[id] = rows;
            tC_[id] = cols;
            tH_[id] = 1;
            tW_[id] = 1;
            tOff_[id] = arenaTop_;
            int i = 0;
            while (i < n) {
                arena[arenaTop_ + i] = float(0.0);
                i = i + 1;
            }
            arenaTop_ = arenaTop_ + n;
            tensorCount_ = tensorCount_ + 1;
            return id;
        }

        // 4D 张量（NCHW 行优先），bump 分配
        int addTensor4(int d0, int d1, int d2, int d3) {
            int id = tensorCount_;
            int n = d0 * d1 * d2 * d3;
            if (arenaTop_ + n > arenaCap_) return -1;
            tRows_[id] = d0 * d1;
            tCols_[id] = d2 * d3;
            tN_[id] = d0;
            tC_[id] = d1;
            tD_[id] = 1;
            tH_[id] = d2;
            tW_[id] = d3;
            tOff_[id] = arenaTop_;
            arenaTop_ = arenaTop_ + n;
            tensorCount_ = tensorCount_ + 1;
            return id;
        }

        // 5D 张量（NCDHW 行优先，3D 扩展），bump 分配
        int addTensor5(int d0, int d1, int d2, int d3, int d4) {
            int id = tensorCount_;
            int n = d0 * d1 * d2 * d3 * d4;
            if (arenaTop_ + n > arenaCap_) return -1;
            tRows_[id] = d0 * d1;
            tCols_[id] = d2 * d3 * d4;
            tN_[id] = d0;
            tC_[id] = d1;
            tD_[id] = d2;
            tH_[id] = d3;
            tW_[id] = d4;
            tOff_[id] = arenaTop_;
            arenaTop_ = arenaTop_ + n;
            tensorCount_ = tensorCount_ + 1;
            return id;
        }

        // 在指定偏移登记 CNN 张量（运行时视角 4D NCHW；rows=N*C, cols=H*W）
        int addTensorPlanned4(int d0, int d1, int d2, int d3, int offset) {
            int id = tensorCount_;
            tRows_[id] = d0 * d1;
            tCols_[id] = d2 * d3;
            tN_[id] = d0;
            tC_[id] = d1;
            tD_[id] = 1;
            tH_[id] = d2;
            tW_[id] = d3;
            tOff_[id] = offset;
            tensorCount_ = tensorCount_ + 1;
            return id;
        }

        // 在指定偏移登记 5D CNN 张量（NCDHW；rows=N*C, cols=D*H*W，3D 扩展）
        int addTensorPlanned5(int d0, int d1, int d2, int d3, int d4, int offset) {
            int id = tensorCount_;
            tRows_[id] = d0 * d1;
            tCols_[id] = d2 * d3 * d4;
            tN_[id] = d0;
            tC_[id] = d1;
            tD_[id] = d2;
            tH_[id] = d3;
            tW_[id] = d4;
            tOff_[id] = offset;
            tensorCount_ = tensorCount_ + 1;
            return id;
        }

        // 在指定偏移登记 FC 张量（2D 视图：rows/cols 即真实维度）
        int addTensorPlanned2(int rows, int cols, int offset) {
            int id = tensorCount_;
            tRows_[id] = rows;
            tCols_[id] = cols;
            tN_[id] = rows;
            tC_[id] = cols;
            tH_[id] = 1;
            tW_[id] = 1;
            tOff_[id] = offset;
            tensorCount_ = tensorCount_ + 1;
            return id;
        }

        void setElem(int tid, int r, int c, double v) {
            int idx = tOff_[tid] + TensorOps.flatIndex(tCols_[tid], r, c);
            arena[idx] = float(v);
        }

        double getElem(int tid, int r, int c) {
            int idx = tOff_[tid] + TensorOps.flatIndex(tCols_[tid], r, c);
            double v = arena[idx];
            return v;
        }

        void addDense(int inputTid, int weightTid, int biasTid, int outputTid) {
            int id = opCount_;
            opKind_[id] = 1;
            opA_[id] = inputTid;
            opB_[id] = weightTid;
            opC_[id] = biasTid;
            opD_[id] = outputTid;
            opCount_ = opCount_ + 1;
        }

        void addRelu(int inputTid, int outputTid) {
            int id = opCount_;
            opKind_[id] = 2;
            opA_[id] = inputTid;
            opB_[id] = outputTid;
            opC_[id] = 0;
            opD_[id] = 0;
            opCount_ = opCount_ + 1;
        }

        void addSoftmax(int inputTid, int outputTid) {
            int id = opCount_;
            opKind_[id] = 3;
            opA_[id] = inputTid;
            opB_[id] = outputTid;
            opC_[id] = 0;
            opD_[id] = 0;
            opCount_ = opCount_ + 1;
        }

        // ---- 训练（阶段2）：反向/更新算子注册 ----
        // opKind 50-55；trainMode_=1 时 run() 才执行（eval 跳过）
        void addBwdDense(int dyT, int xT, int wT, int dxT, int dwT, int dbT) {
            int id = opCount_;
            opKind_[id] = 50;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = wT; opD_[id] = dxT;
            opP0_[id] = dwT; opP1_[id] = dbT;
            opCount_ = opCount_ + 1;
        }
        void addBwdRelu(int dyT, int xT, int dxT) {
            int id = opCount_;
            opKind_[id] = 51;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opCount_ = opCount_ + 1;
        }
        void addBwdSigmoid(int dyT, int yT, int dxT) {
            int id = opCount_;
            opKind_[id] = 52;
            opA_[id] = dyT; opB_[id] = yT; opC_[id] = dxT;
            opCount_ = opCount_ + 1;
        }
        // 激活反向（opKind 102-107；CPU-only 训练）：ReLU6/LeakyRelu/SiLU/HardSwish/
        // LogSoftmax/Clip。均 A=dy, B=x（fwd 输入，重算导数掩码/σ），C=dx。
        void addBwdRelu6(int dyT, int xT, int dxT) {
            int id = opCount_;
            opKind_[id] = 102;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opCount_ = opCount_ + 1;
        }
        void addBwdLeakyRelu(int dyT, int xT, int dxT, int alphaBits, int hasAlpha) {
            int id = opCount_;
            opKind_[id] = 103;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opP0_[id] = alphaBits; opP1_[id] = hasAlpha;
            opCount_ = opCount_ + 1;
        }
        void addBwdSilu(int dyT, int xT, int dxT) {
            int id = opCount_;
            opKind_[id] = 104;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opCount_ = opCount_ + 1;
        }
        void addBwdHardSwish(int dyT, int xT, int dxT) {
            int id = opCount_;
            opKind_[id] = 105;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opCount_ = opCount_ + 1;
        }
        // LogSoftmax 反向：outer/axisDim/inner 同 fwd（opP1-3，由 graph_compiler 从 x shape+axis 算）
        void addBwdLogSoftmax(int dyT, int xT, int dxT, int outer, int axisDim, int inner) {
            int id = opCount_;
            opKind_[id] = 106;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opP1_[id] = outer; opP2_[id] = axisDim; opP3_[id] = inner;
            opCount_ = opCount_ + 1;
        }
        // Clip 反向：A=dy, B=x, C=minT, D=maxT（标量张量，-1 不限），P0=dx
        void addBwdClip(int dyT, int xT, int dxT, int minT, int maxT) {
            int id = opCount_;
            opKind_[id] = 107;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = minT; opD_[id] = maxT;
            opP0_[id] = dxT;
            opCount_ = opCount_ + 1;
        }
        // Tanh 反向（opKind 108）：A=dy, B=y（fwd 输出），C=dx。dx=dy·(1-y²)
        void addBwdTanh(int dyT, int yT, int dxT) {
            int id = opCount_;
            opKind_[id] = 108;
            opA_[id] = dyT; opB_[id] = yT; opC_[id] = dxT;
            opCount_ = opCount_ + 1;
        }
        void addBwdAdd(int dyT, int daT, int dbT) {
            int id = opCount_;
            opKind_[id] = 53;
            opA_[id] = dyT; opB_[id] = daT; opC_[id] = dbT;
            opCount_ = opCount_ + 1;
        }
        // A2：Sub/Mul/Div 反向（同尺寸线性；训练广播无驱动，与 Add 反向一致）。
        // 槽：opA=dy, opB=x0, opC=x1, opD=dx0, opP0=dx1。
        // Sub: dx0=dy, dx1=-dy；Mul: dx0=dy*x1, dx1=dy*x0；
        // Div: dx0=dy/x1, dx1=-dy*x0/(x1*x1)。
        void addBwdSub(int dyT, int x0T, int x1T, int dx0T, int dx1T) {
            int id = opCount_;
            opKind_[id] = 90;
            opA_[id] = dyT; opB_[id] = x0T; opC_[id] = x1T; opD_[id] = dx0T; opP0_[id] = dx1T;
            opCount_ = opCount_ + 1;
        }
        void addBwdMul(int dyT, int x0T, int x1T, int dx0T, int dx1T) {
            int id = opCount_;
            opKind_[id] = 91;
            opA_[id] = dyT; opB_[id] = x0T; opC_[id] = x1T; opD_[id] = dx0T; opP0_[id] = dx1T;
            opCount_ = opCount_ + 1;
        }
        void addBwdDiv(int dyT, int x0T, int x1T, int dx0T, int dx1T) {
            int id = opCount_;
            opKind_[id] = 92;
            opA_[id] = dyT; opB_[id] = x0T; opC_[id] = x1T; opD_[id] = dx0T; opP0_[id] = dx1T;
            opCount_ = opCount_ + 1;
        }
        // B：Reshape 反向（opKind 93）：dy 连续拷回 dx（reshape 不重排内存）。
        void addBwdReshape(int dyT, int dxT) {
            int id = opCount_;
            opKind_[id] = 93;
            opA_[id] = dyT; opB_[id] = dxT;
            opCount_ = opCount_ + 1;
        }
        // B：Transpose 反向（opKind 94）：dx = 逆排列搬回 x 布局。
        // opP0-3=perm, opP4=pc, opP5-8=x(id) dims。
        void addBwdTranspose(int dyT, int dxT, int p0, int p1, int p2, int p3, int pc,
                             int id0, int id1, int id2, int id3) {
            int id = opCount_;
            opKind_[id] = 94;
            opA_[id] = dyT; opB_[id] = dxT;
            opP0_[id] = p0; opP1_[id] = p1; opP2_[id] = p2; opP3_[id] = p3; opP4_[id] = pc;
            opP5_[id] = id0; opP6_[id] = id1; opP7_[id] = id2; opP8_[id] = id3;
            opCount_ = opCount_ + 1;
        }
        // B2：Expand/Tile 反向（opKind 95/96）：dy 按源坐标 scatter-add 回 dx。
        // opA=dy, opB=dx, opP0-3=id(x) dims, opP4-7=od(y) dims。
        void addBwdExpand(int dyT, int dxT, int id0, int id1, int id2, int id3,
                          int od0, int od1, int od2, int od3) {
            int id = opCount_;
            opKind_[id] = 95;
            opA_[id] = dyT; opB_[id] = dxT;
            opP0_[id] = id0; opP1_[id] = id1; opP2_[id] = id2; opP3_[id] = id3;
            opP4_[id] = od0; opP5_[id] = od1; opP6_[id] = od2; opP7_[id] = od3;
            opCount_ = opCount_ + 1;
        }
        void addBwdTile(int dyT, int dxT, int id0, int id1, int id2, int id3,
                        int od0, int od1, int od2, int od3) {
            int id = opCount_;
            opKind_[id] = 96;
            opA_[id] = dyT; opB_[id] = dxT;
            opP0_[id] = id0; opP1_[id] = id1; opP2_[id] = id2; opP3_[id] = id3;
            opP4_[id] = od0; opP5_[id] = od1; opP6_[id] = od2; opP7_[id] = od3;
            opCount_ = opCount_ + 1;
        }
        // B：ReduceSum/Mean 反向（opKind 97）：梯度广播回 x。
        // opA=dy, opB=dx, opP0=mode, opP1=N, opP2=C, opP3=S, opP4=total, opP5=redType。
        void addBwdReduce(int dyT, int dxT, int mode, int N, int C, int S, int total, int redType) {
            int id = opCount_;
            opKind_[id] = 97;
            opA_[id] = dyT; opB_[id] = dxT;
            opP0_[id] = mode; opP1_[id] = N; opP2_[id] = C; opP3_[id] = S; opP4_[id] = total; opP5_[id] = redType;
            opCount_ = opCount_ + 1;
        }
        // B：ReduceMax/Min 反向（opKind 100）。A=dy B=x C=dx；
        // P0=mode P1=N P2=C P3=S P4=total P5=redType（2=max 3=min）。
        void addBwdReduceMM(int dyT, int xT, int dxT, int mode, int N, int C, int S, int total, int redType) {
            int id = opCount_;
            opKind_[id] = 100;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opP0_[id] = mode; opP1_[id] = N; opP2_[id] = C; opP3_[id] = S; opP4_[id] = total; opP5_[id] = redType;
            opCount_ = opCount_ + 1;
        }
        // B：Pad(constant) 反向（opKind 101）。A=dy B=x C=dx；
        // opP0-3=N,C,H,W 各轴 begin；opP4-7=end（kernel 只用 begin；end 供参考）。
        void addBwdPad(int dyT, int xT, int dxT,
                       int b0, int b1, int b2, int b3,
                       int e0, int e1, int e2, int e3) {
            int id = opCount_;
            opKind_[id] = 101;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opP0_[id] = b0; opP1_[id] = b1; opP2_[id] = b2; opP3_[id] = b3;
            opP4_[id] = e0; opP5_[id] = e1; opP6_[id] = e2; opP7_[id] = e3;
            opCount_ = opCount_ + 1;
        }
        // B：Gather 反向（opKind 98）：dy 沿 axis scatter-add 回 data 梯度 dx。
        // opA=dy, opB=idxT(临时 f32), opC=dx, opP0=axis, opP1=lenIdx, opP2-5=data dims。
        void addBwdGather(int dyT, int idxT, int dxT, int axis, int lenIdx,
                          int dn, int dc, int dh, int dw) {
            int id = opCount_;
            opKind_[id] = 98;
            opA_[id] = dyT; opB_[id] = idxT; opC_[id] = dxT;
            opP0_[id] = axis; opP1_[id] = lenIdx;
            opP2_[id] = dn; opP3_[id] = dc; opP4_[id] = dh; opP5_[id] = dw;
            opCount_ = opCount_ + 1;
        }
        // Softmax+CE 合并：输入 logits + 标签(one-hot)，输出 dlogits + loss
        void addSoftmaxCE(int logitT, int labelT, int dlogitT, int lossT) {
            int id = opCount_;
            opKind_[id] = 54;
            opA_[id] = logitT; opB_[id] = labelT; opC_[id] = dlogitT; opD_[id] = lossT;
            opCount_ = opCount_ + 1;
        }
        void addUpdate(int wT, int gradT) {
            int id = opCount_;
            opKind_[id] = 55;
            opA_[id] = wT; opB_[id] = gradT;
            opCount_ = opCount_ + 1;
        }
        // 阶段3：卷积反向（opKind 56）。dy=opA, x=opB, w=opC, dx=opD;
        // dw=opP0, db=opP1, sh=opP2, sw=opP3, pt=opP4, pl=opP5, dh=opP6, dw=opP7, group=opP8
        void addBwdConv(int dyT, int xT, int wT, int dxT, int dwT, int dbT,
                        int sh, int sw, int pt, int pl, int dh, int dw, int group) {
            int id = opCount_;
            opKind_[id] = 56;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = wT; opD_[id] = dxT;
            opP0_[id] = dwT; opP1_[id] = dbT;
            opP2_[id] = sh; opP3_[id] = sw; opP4_[id] = pt; opP5_[id] = pl;
            opP6_[id] = dh; opP7_[id] = dw; opP8_[id] = group;
            opCount_ = opCount_ + 1;
        }
        // 阶段3：MaxPool 反向（opKind 57）。dy=opA, x=opB, dx=opC;
        // kh=opP0, kw=opP1, sh=opP2, sw=opP3, pt=opP4, pl=opP5
        void addBwdMaxPool(int dyT, int xT, int dxT,
                           int kh, int kw, int sh, int sw, int pt, int pl) {
            int id = opCount_;
            opKind_[id] = 57;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opP0_[id] = kh; opP1_[id] = kw; opP2_[id] = sh; opP3_[id] = sw;
            opP4_[id] = pt; opP5_[id] = pl;
            opCount_ = opCount_ + 1;
        }
        // 阶段4：Conv3D 反向（opKind 58）。dy=opA, x=opB, w=opC, dx=opD;
        // dw=opP0, db=opP1; sd=opP2, sh=opP3, sw=opP4, pdt=opP5, pdb=opP6,
        // pt=opP7, pb=opP8; pl=opX0, pr=opX1。
        // 假设膨胀 dd=dh=dw=1、group=1（3D U-Net 常用；需膨胀/分组时再扩槽）。
        // kd/kh/kw 从 w 张量形状取（w=[yC,C/group,kd,kh,kw] → tD_/tH_/tW_）。
        void addBwdConv3D(int dyT, int xT, int wT, int dxT, int dwT, int dbT,
                          int sd, int sh, int sw, int pdt, int pdb, int pt, int pb,
                          int pl, int pr) {
            int id = opCount_;
            opKind_[id] = 58;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = wT; opD_[id] = dxT;
            opP0_[id] = dwT; opP1_[id] = dbT;
            opP2_[id] = sd; opP3_[id] = sh; opP4_[id] = sw;
            opP5_[id] = pdt; opP6_[id] = pdb; opP7_[id] = pt; opP8_[id] = pb;
            opX_[id * 4 + 0] = pl; opX_[id * 4 + 1] = pr;
            opCount_ = opCount_ + 1;
        }
        // 阶段4：MaxPool3D 反向（opKind 59）。dy=opA, x=opB, dx=opC;
        // kd=opP0, kh=opP1, kw=opP2, sd=opP3, sh=opP4, sw=opP5,
        // pdt=opP6, pdb=opP7, pt=opP8, pb=opX0, pl=opX1, pr=opX2
        void addBwdMaxPool3D(int dyT, int xT, int dxT,
                             int kd, int kh, int kw, int sd, int sh, int sw,
                             int pdt, int pdb, int pt, int pb, int pl, int pr) {
            int id = opCount_;
            opKind_[id] = 59;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opP0_[id] = kd; opP1_[id] = kh; opP2_[id] = kw;
            opP3_[id] = sd; opP4_[id] = sh; opP5_[id] = sw;
            opP6_[id] = pdt; opP7_[id] = pdb; opP8_[id] = pt;
            opX_[id * 4 + 0] = pb; opX_[id * 4 + 1] = pl; opX_[id * 4 + 2] = pr;
            opCount_ = opCount_ + 1;
        }
        // 阶段4：AveragePool3D 反向（opKind 60）。dy=opA, x=opB, dx=opC;
        // kd=opP0, kh=opP1, kw=opP2, sd=opP3, sh=opP4, sw=opP5,
        // pdt=opP6, pdb=opP7, pt=opP8, pb=opX0, pl=opX1, pr=opX2, cip=opX3
        void addBwdAvgPool3D(int dyT, int xT, int dxT,
                             int kd, int kh, int kw, int sd, int sh, int sw,
                             int pdt, int pdb, int pt, int pb, int pl, int pr, int cip) {
            int id = opCount_;
            opKind_[id] = 60;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opP0_[id] = kd; opP1_[id] = kh; opP2_[id] = kw;
            opP3_[id] = sd; opP4_[id] = sh; opP5_[id] = sw;
            opP6_[id] = pdt; opP7_[id] = pdb; opP8_[id] = pt;
            opX_[id * 4 + 0] = pb; opX_[id * 4 + 1] = pl; opX_[id * 4 + 2] = pr; opX_[id * 4 + 3] = cip;
            opCount_ = opCount_ + 1;
        }
        // A：AvgPool2D 反向（opKind 99）。dy=opA, x=opB, dx=opC;
        // opP0=kh opP1=kw opP2=sh opP3=sw opP4=pt opP5=pb opP6=pl opP7=pr opP8=cip。
        void addBwdAvgPool(int dyT, int xT, int dxT,
                           int kh, int kw, int sh, int sw,
                           int pt, int pb, int pl, int pr, int cip) {
            int id = opCount_;
            opKind_[id] = 99;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = dxT;
            opP0_[id] = kh; opP1_[id] = kw; opP2_[id] = sh; opP3_[id] = sw;
            opP4_[id] = pt; opP5_[id] = pb; opP6_[id] = pl; opP7_[id] = pr; opP8_[id] = cip;
            opCount_ = opCount_ + 1;
        }
        // 阶段4d：ConvTranspose 反向（opKind 68）。dy=opA, x=opB, w=opC, dx=opD;
        // dw=opP0, db=opP1; sh=opP2, sw=opP3, pt=opP4, pb=opP5, pl=opP6, pr=opP7;
        // kh/kw 从 w 张量形状取（w=[Cin,Cout,kh,kw] → tH_/tW_，同前向 convTranspose）。
        void addBwdConvTranspose(int dyT, int xT, int wT, int dxT, int dwT, int dbT,
                                 int sh, int sw, int pt, int pb, int pl, int pr) {
            int id = opCount_;
            opKind_[id] = 68;
            opA_[id] = dyT; opB_[id] = xT; opC_[id] = wT; opD_[id] = dxT;
            opP0_[id] = dwT; opP1_[id] = dbT;
            opP2_[id] = sh; opP3_[id] = sw; opP4_[id] = pt; opP5_[id] = pb;
            opP6_[id] = pl; opP7_[id] = pr;
            opCount_ = opCount_ + 1;
        }
        // 阶段4d：Dice loss（opKind 69）。p=opA(prob), y=opB(label), dp=opC, loss=opD;
        // rows/cols 取 prob 张量 tRows_/tCols_。wMode=opP1（0=等权，1=归一化逆频率）。
        void addDiceLoss(int pT, int yT, int dpT, int lossT, int wMode) {
            int id = opCount_;
            opKind_[id] = 69;
            opA_[id] = pT; opB_[id] = yT; opC_[id] = dpT; opD_[id] = lossT;
            opP1_[id] = wMode;
            opCount_ = opCount_ + 1;
        }
        // MSE loss（opKind 109 训练专用）。p=opA(预测), y=opB(label), dp=opC, loss=opD。
        // 逐元素 mean：N=rows*cols（p/y 同形状）；dp=2(p-y)/N；loss 单值。
        void addMseLoss(int pT, int yT, int dpT, int lossT) {
            int id = opCount_;
            opKind_[id] = 109;
            opA_[id] = pT; opB_[id] = yT; opC_[id] = dpT; opD_[id] = lossT;
            opCount_ = opCount_ + 1;
        }
        // BCE loss（opKind 110 训练专用）。p=opA(∈[0,1], 应用前须 Sigmoid), y=opB(label),
        // dp=opC, loss=opD。逐元素 mean；dp 见 kernel。
        void addBceLoss(int pT, int yT, int dpT, int lossT) {
            int id = opCount_;
            opKind_[id] = 110;
            opA_[id] = pT; opB_[id] = yT; opC_[id] = dpT; opD_[id] = lossT;
            opCount_ = opCount_ + 1;
        }
        // 阶段4d：Softmax 反向（opKind 70）。dprob=opA, prob=opB, dlogit=opC
        void addBwdSoftmax(int dpT, int pT, int dlT) {
            int id = opCount_;
            opKind_[id] = 70;
            opA_[id] = dpT; opB_[id] = pT; opC_[id] = dlT;
            opCount_ = opCount_ + 1;
        }
        // 阶段5：RMSNorm（opKind 61）。in=opA, gamma=opB, out=opC; D=opP0, S=opP1, eps=opP2(位型)
        void addRmsNorm(int inT, int gT, int outT, int D, int S, double eps) {
            int id = opCount_;
            opKind_[id] = 61;
            opA_[id] = inT; opB_[id] = gT; opC_[id] = outT;
            opP0_[id] = D; opP1_[id] = S; opP2_[id] = F32.toBits(eps);
            opCount_ = opCount_ + 1;
        }
        // 阶段5：缩放点积注意力（opKind 62）。q=opA, k=opB, v=opC, out=opD, sc=opP0(暂存 tid);
        // D=opP1, S=opP2, heads=opP3, causal=opP4, groups=opP5（GQA：Q 头数/KV 头数，MHA=1）
        void addAttention(int qT, int kT, int vT, int outT, int scT, int D, int S, int heads, int causal, int groups) {
            int id = opCount_;
            opKind_[id] = 62;
            opA_[id] = qT; opB_[id] = kT; opC_[id] = vT; opD_[id] = outT;
            opP0_[id] = scT; opP1_[id] = D; opP2_[id] = S; opP3_[id] = heads; opP4_[id] = causal; opP5_[id] = groups;
            opCount_ = opCount_ + 1;
        }
        // 阶段5：embedding 查表（opKind 63）。e=opA, ids=opB, out=opC; vocab=opP0, D=opP1, S=opP2
        void addGatherRows(int eT, int idT, int outT, int vocab, int D, int S) {
            int id = opCount_;
            opKind_[id] = 63;
            opA_[id] = eT; opB_[id] = idT; opC_[id] = outT;
            opP0_[id] = vocab; opP1_[id] = D; opP2_[id] = S;
            opCount_ = opCount_ + 1;
        }
        // 阶段5：LayerNorm（opKind 64）。in=opA, gamma=opB, beta=opC, out=opD; D=opP0, S=opP1, eps=opP2(位型)
        void addLayerNorm(int inT, int gT, int bT, int outT, int D, int S, double eps) {
            int id = opCount_;
            opKind_[id] = 64;
            opA_[id] = inT; opB_[id] = gT; opC_[id] = bT; opD_[id] = outT;
            opP0_[id] = D; opP1_[id] = S; opP2_[id] = F32.toBits(eps);
            opCount_ = opCount_ + 1;
        }
        // 阶段5：GELU（opKind 65）。in=opA, out=opB; n=opP0
        void addGelu(int inT, int outT, int n) {
            int id = opCount_;
            opKind_[id] = 65;
            opA_[id] = inT; opB_[id] = outT;
            opP0_[id] = n;
            opCount_ = opCount_ + 1;
        }
        // 阶段5：RoPE（opKind 66）。in/out=opA（原地）, cos=opB, sin=opC; D=opP0, S=opP1, heads=opP2
        void addRope(int xT, int cosT, int sinT, int D, int S, int heads) {
            int id = opCount_;
            opKind_[id] = 66;
            opA_[id] = xT; opB_[id] = cosT; opC_[id] = sinT;
            opP0_[id] = D; opP1_[id] = S; opP2_[id] = heads;
            opCount_ = opCount_ + 1;
        }
        // 阶段5：KV cache 增量注意力（opKind 67）。q=opA, kcache=opB, vcache=opC, out=opD, sc=opP0;
        // D=opP1, stride=opP2（缓存容量/行步长）, len=opP3（参与注意力列数）, heads=opP4, groups=opP5
        void addAttentionCached(int qT, int kcT, int vcT, int outT, int scT, int D, int stride, int len, int heads, int groups) {
            int id = opCount_;
            opKind_[id] = 67;
            opA_[id] = qT; opB_[id] = kcT; opC_[id] = vcT; opD_[id] = outT;
            opP0_[id] = scT; opP1_[id] = D; opP2_[id] = stride; opP3_[id] = len; opP4_[id] = heads; opP5_[id] = groups;
            opCount_ = opCount_ + 1;
        }
        void setTrain(int v) { trainMode_ = v; }
        void setLr(double v) { lr_ = v; }
        // ---- AMP 模拟（阶段四训练专项）：1 = 更新前梯度经 fp16 舍入（模拟 fp16 梯度）----
        void setAmpSim(int v) { ampSim_ = v; }
        int ampSim() { return ampSim_; }
        // ---- 优化器（阶段5e）：0=SGD（默认），1=动量，2=AdamW；wd=weight decay ----
        void setOptMode(int v) { optMode_ = v; }
        int optMode() { return optMode_; }
        void setOptWd(double v) { optWd_ = v; }
        double optWd() { return optWd_; }
        int optStep() { return optStep_; }
        int optOffAt(int tid) { if (tid < 0 || tid >= 512) return -1; return optOff_[tid]; }
        // 为权重张量预留优化器状态区（动量 v / Adam 的 m+v，2*n floats）于 arena 尾部
        void prepOptState(int tid) {
            if (tid < 0 || tid >= 512) return;
            if (optOff_[tid] >= 0) return;
            int n = tensorSize(tid);
            if (optBase_ + 2 * n > arenaCap_) growOptArena(optBase_ + 2 * n - arenaCap_);
            optOff_[tid] = optBase_;
            optBase_ = optBase_ + 2 * n;
        }
        // 复制保真的 arena 扩容（优化器状态区追加到尾部）
        void growOptArena(int extra) {
            int newCap = arenaCap_ + extra;
            float[] na = new float[newCap];
            int i = 0;
            while (i < arenaCap_) { na[i] = arena[i]; i = i + 1; }
            arena = na;
            arenaCap_ = newCap;
        }
        double lr() { return lr_; }
        // ---- 梯度累积（阶段4 训练专项）：K>0 时每 K 次 runTrain 才应用一次权重更新 ----
        // 启用时遍历 Update(55) 权重预分配 gAcc 缓冲（arena 尾部，optBase_ 继续增长）。
        // 语义：累积 ΣK 个 micro 梯度 → 应用 gAcc/K × lr（等效 batch×K 且 loss 平均）。
        void prepGradAcc(int tid) {
            if (tid < 0 || tid >= 512) return;
            if (gradAccOff_[tid] >= 0) return;
            int n = tensorSize(tid);
            if (optBase_ + n > arenaCap_) growOptArena(optBase_ + n - arenaCap_);
            gradAccOff_[tid] = optBase_;
            optBase_ = optBase_ + n;
        }
        void setGradAccumEvery(int k) {
            gradAccEvery_ = k;
            gradAccStep_ = 0;
            if (k > 0) {
                int i = 0;
                while (i < opCount_) {
                    if (opKind_[i] == 55) prepGradAcc(opA_[i]);
                    i = i + 1;
                }
            }
        }
        int gradAccumEvery() { return gradAccEvery_; }
        int gradAccumStep() { return gradAccStep_; }
        int gradAccOffAt(int tid) { if (tid < 0 || tid >= 512) return -1; return gradAccOff_[tid]; }
        // 调试访问器（MYP_DUMP_OPS=1 时训练入口打印 op 清单）
        int opCountDebug() { return opCount_; }
        int opKindDebug(int i) { if (i < 0 || i >= opCount_) return -1; return opKind_[i]; }
        int opATDebug(int i) { if (i < 0 || i >= opCount_) return -1; return opA_[i]; }
        int opBTDebug(int i) { if (i < 0 || i >= opCount_) return -1; return opB_[i]; }
        int opCDebug(int i) { if (i < 0 || i >= opCount_) return -1; return opC_[i]; }
        int opDDebug(int i) { if (i < 0 || i >= opCount_) return -1; return opD_[i]; }
        int tensorCountDebug() { return tensorCount_; }
        int tensorOffDebug(int tid) { if (tid < 0 || tid >= tensorCount_) return -1; return tOff_[tid]; }
        int tensorSizeDebug(int tid) { if (tid < 0 || tid >= tensorCount_) return -1; return tRows_[tid] * tCols_[tid]; }

        void addSigmoid(int inputTid, int outputTid) {
            int id = opCount_;
            opKind_[id] = 4;
            opA_[id] = inputTid;
            opB_[id] = outputTid;
            opC_[id] = 0;
            opD_[id] = 0;
            opCount_ = opCount_ + 1;
        }

        // Tanh（opKind 46）：逐元素激活
        void addTanh(int inputTid, int outputTid) {
            int id = opCount_;
            opKind_[id] = 46;
            opA_[id] = inputTid;
            opB_[id] = outputTid;
            opC_[id] = 0;
            opD_[id] = 0;
            opCount_ = opCount_ + 1;
        }
        // ArgMax（opKind 47）/ArgMin（48）：1D flat → 单值 float(index)（分类/采样轴）
        void addArgMax(int inT, int outT) {
            int id = opCount_;
            opKind_[id] = 47;
            opA_[id] = inT; opB_[id] = outT;
            opCount_ = opCount_ + 1;
        }
        void addArgMin(int inT, int outT) {
            int id = opCount_;
            opKind_[id] = 48;
            opA_[id] = inT; opB_[id] = outT;
            opCount_ = opCount_ + 1;
        }
        // TopK（opKind 49）：1D flat 前 k 大 → values=opB[k]、indices=opC[k]（float）；k=opP0
        void addTopK(int inT, int valT, int idxT, int k) {
            int id = opCount_;
            opKind_[id] = 49;
            opA_[id] = inT; opB_[id] = valT; opC_[id] = idxT;
            opP0_[id] = k;
            opCount_ = opCount_ + 1;
        }
        // GroupNorm（opKind 84）：in=opA, gamma=opB, beta=opC, out=opD；groups=opP0,
        // eps=opP1(位型)。N/C/H/W 由运行时张量自带（tensorN/C/H/W）。
        void addGroupNorm(int inT, int gT, int bT, int outT, int groups, double eps) {
            int id = opCount_;
            opKind_[id] = 84;
            opA_[id] = inT; opB_[id] = gT; opC_[id] = bT; opD_[id] = outT;
            opP0_[id] = groups;
            opP1_[id] = F32.toBits(eps);
            opCount_ = opCount_ + 1;
        }

        void addAdd(int aTid, int bTid, int outputTid, int doRelu,
                    int an, int ac, int ah, int aw, int bn, int bc, int bh, int bw) {
            int id = opCount_;
            opKind_[id] = 5;
            opA_[id] = aTid;
            opB_[id] = bTid;
            opC_[id] = outputTid;
            opD_[id] = 0;
            opRelu_[id] = doRelu;
            opP0_[id] = an; opP1_[id] = ac; opP2_[id] = ah; opP3_[id] = aw;
            opP4_[id] = bn; opP5_[id] = bc; opP6_[id] = bh; opP7_[id] = bw;
            opCount_ = opCount_ + 1;
        }

        void addMatmul(int aTid, int bTid, int outputTid) {
            int id = opCount_;
            opKind_[id] = 6;
            opA_[id] = aTid;
            opB_[id] = bTid;
            opC_[id] = outputTid;
            opD_[id] = 0;
            opCount_ = opCount_ + 1;
        }
        // BatchMatMul（opKind 82）：4D batch matmul，A [ab0,ab1,M,K] × B [bb0,bb1,K,N]
        // → [ob0,ob1,M,N]（batch 维逐维 max 广播，维=1 → 0）。
        // aM=opP0, aK=opP1, bN=opP2, ab0=opP3, ab1=opP4, bb0=opP5, bb1=opP6, ob0=opP7, ob1=opP8。
        void addBatchMatmul(int aTid, int bTid, int outTid,
                            int aM, int aK, int bN,
                            int ab0, int ab1, int bb0, int bb1, int ob0, int ob1) {
            int id = opCount_;
            opKind_[id] = 82;
            opA_[id] = aTid;
            opB_[id] = bTid;
            opC_[id] = outTid;
            opP0_[id] = aM; opP1_[id] = aK; opP2_[id] = bN;
            opP3_[id] = ab0; opP4_[id] = ab1; opP5_[id] = bb0; opP6_[id] = bb1;
            opP7_[id] = ob0; opP8_[id] = ob1;
            opCount_ = opCount_ + 1;
        }

        void addConv(int inTid, int wTid, int bTid, int outTid,
                     int strideH, int strideW, int padT, int padB, int padL, int padR,
                     int dilH, int dilW, int group) {
            int id = opCount_;
            opKind_[id] = 7;
            opA_[id] = inTid;
            opB_[id] = wTid;
            opC_[id] = bTid;
            opD_[id] = outTid;
            opP0_[id] = strideH; opP1_[id] = strideW; opP2_[id] = padT; opP3_[id] = padB;
            opP4_[id] = padL; opP5_[id] = padR; opP6_[id] = dilH; opP7_[id] = dilW;
            opP8_[id] = group;
            opCount_ = opCount_ + 1;
        }

        // 融合 Conv+ReLU（G1，opKind=11）：参数同 addConv
        void addConvRelu(int inTid, int wTid, int bTid, int outTid,
                         int strideH, int strideW, int padT, int padB, int padL, int padR,
                         int dilH, int dilW, int group) {
            int id = opCount_;
            opKind_[id] = 11;
            opA_[id] = inTid;
            opB_[id] = wTid;
            opC_[id] = bTid;
            opD_[id] = outTid;
            opP0_[id] = strideH; opP1_[id] = strideW; opP2_[id] = padT; opP3_[id] = padB;
            opP4_[id] = padL; opP5_[id] = padR; opP6_[id] = dilH; opP7_[id] = dilW;
            opP8_[id] = group;
            opCount_ = opCount_ + 1;
        }

        // 融合 Conv+残差Add（P4-2/3，opKind=73）：卷积输出直接加残差张量写入 out，可接 doRelu。
        // 参数同 addConv；残差 tid 存 opX_[id*4+0]（residual 与 out 同形状同布局），doRelu 存 opRelu_。
        void addConvResidual(int inTid, int wTid, int bTid, int outTid, int residTid,
                             int strideH, int strideW, int padT, int padB, int padL, int padR,
                             int dilH, int dilW, int group, int doRelu) {
            int id = opCount_;
            opKind_[id] = 73;
            opA_[id] = inTid;
            opB_[id] = wTid;
            opC_[id] = bTid;
            opD_[id] = outTid;
            opP0_[id] = strideH; opP1_[id] = strideW; opP2_[id] = padT; opP3_[id] = padB;
            opP4_[id] = padL; opP5_[id] = padR; opP6_[id] = dilH; opP7_[id] = dilW;
            opP8_[id] = group;
            opX_[id * 4 + 0] = residTid;
            opRelu_[id] = doRelu;
            opCount_ = opCount_ + 1;
        }

        // ---- F8：ConvTranspose（opKind 40，group=1）----
        // 权重 [Cin,Cout,kh,kw] 直接拷贝（ONNX 布局）；outPad 已并入输出形状（内核用不到）
        void addConvTranspose(int inTid, int wTid, int bTid, int outTid,
                              int sh, int sw, int pt, int pb, int pl, int pr,
                              int outPadH, int outPadW, int group) {
            int id = opCount_;
            opKind_[id] = 40;
            opA_[id] = inTid;
            opB_[id] = wTid;
            opC_[id] = bTid;
            opD_[id] = outTid;
            opP0_[id] = sh; opP1_[id] = sw; opP2_[id] = pt; opP3_[id] = pb;
            opP4_[id] = pl; opP5_[id] = pr; opP6_[id] = outPadH; opP7_[id] = outPadW;
            opP8_[id] = group;
            opCount_ = opCount_ + 1;
        }

        // ---- G5：Conv 1x1 专用（opKind 83）----
        // kh==kw==1 && stride==1 && 无 padding && dil==1 && group==1 的普通卷积——
        // 高频 ResNet bottleneck 路径，降级为纯 GEMM（无窗口归约）。doRelu 存 opRelu_。
        // 输入/输出维度从 tensor 元数据读（kernel 侧），无需额外参数槽。
        void addConv1x1(int inTid, int wTid, int bTid, int outTid, int doRelu) {
            int id = opCount_;
            opKind_[id] = 83;
            opA_[id] = inTid;
            opB_[id] = wTid;
            opC_[id] = bTid;
            opD_[id] = outTid;
            opRelu_[id] = doRelu;
            opCount_ = opCount_ + 1;
        }

        // ---- 3D：Conv3D（opKind 41）----
        // 权重 [Cout,Cin,kd,kh,kw]；sd/sh/sw 与 6 个 pads；dd/dh/dw/group 存 opX_
        void addConv3D(int inTid, int wTid, int bTid, int outTid,
                       int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
                       int dd, int dh, int dw, int group) {
            int id = opCount_;
            opKind_[id] = 41;
            opA_[id] = inTid; opB_[id] = wTid; opC_[id] = bTid; opD_[id] = outTid;
            opP0_[id] = sd; opP1_[id] = sh; opP2_[id] = sw; opP3_[id] = pdt; opP4_[id] = pdb;
            opP5_[id] = pt; opP6_[id] = pb; opP7_[id] = pl; opP8_[id] = pr;
            opX_[id * 4 + 0] = dd; opX_[id * 4 + 1] = dh; opX_[id * 4 + 2] = dw; opX_[id * 4 + 3] = group;
            opCount_ = opCount_ + 1;
        }
        // ---- 3D：MaxPool3D（opKind 42）----
        // kd/kh/kw + sd/sh/sw + 6 pads（pb/pl/pr 存 opX_）
        void addMaxPool3D(int inTid, int outTid, int kd, int kh, int kw,
                          int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr) {
            int id = opCount_;
            opKind_[id] = 42;
            opA_[id] = inTid; opB_[id] = outTid;
            opP0_[id] = kd; opP1_[id] = kh; opP2_[id] = kw;
            opP3_[id] = sd; opP4_[id] = sh; opP5_[id] = sw;
            opP6_[id] = pdt; opP7_[id] = pdb; opP8_[id] = pt;
            opX_[id * 4 + 0] = pb; opX_[id * 4 + 1] = pl; opX_[id * 4 + 2] = pr;
            opCount_ = opCount_ + 1;
        }
        // ---- 3D：AveragePool3D（opKind 43）----
        // kd/kh/kw + sd/sh/sw + 6 pads（pb/pl/pr 存 opX_，cip 存 opX_[3]）
        void addAvgPool3D(int inTid, int outTid, int kd, int kh, int kw,
                          int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
                          int cip) {
            int id = opCount_;
            opKind_[id] = 43;
            opA_[id] = inTid; opB_[id] = outTid;
            opP0_[id] = kd; opP1_[id] = kh; opP2_[id] = kw;
            opP3_[id] = sd; opP4_[id] = sh; opP5_[id] = sw;
            opP6_[id] = pdt; opP7_[id] = pdb; opP8_[id] = pt;
            opX_[id * 4 + 0] = pb; opX_[id * 4 + 1] = pl; opX_[id * 4 + 2] = pr;
            opX_[id * 4 + 3] = cip;
            opCount_ = opCount_ + 1;
        }

        void addMaxPool(int inTid, int outTid, int kh, int kw,
                        int sh, int sw, int pt, int pb, int pl, int pr) {
            int id = opCount_;
            opKind_[id] = 8;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = kh; opP1_[id] = kw; opP2_[id] = sh; opP3_[id] = sw;
            opP4_[id] = pt; opP5_[id] = pb; opP6_[id] = pl; opP7_[id] = pr;
            opCount_ = opCount_ + 1;
        }

        // ---- F8：AveragePool（opKind 36 NCHW / 37 NHWC）----
        // cip = count_include_pad（0=默认，除数排除 pad；1=含 pad）
        void addAvgPool(int inTid, int outTid, int kh, int kw,
                        int sh, int sw, int pt, int pb, int pl, int pr, int cip) {
            int id = opCount_;
            opKind_[id] = 36;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = kh; opP1_[id] = kw; opP2_[id] = sh; opP3_[id] = sw;
            opP4_[id] = pt; opP5_[id] = pb; opP6_[id] = pl; opP7_[id] = pr;
            opP8_[id] = cip;
            opCount_ = opCount_ + 1;
        }

        void addGAPool(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 9;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }

        void addFlatten(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 10;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }

        // ---- G2：NHWC 布局算子（布局变换 NCHW→NHWC，opt-in）----
        // 张量元数据约定（NHWC 区）：激活 [N,H,W,C]→(tN,tC,tH,tW)=(N,H,W,C)；
        // 权重 [Cout,KH,KW,Cin]→(Cout,KH,KW,Cin)；偏置/FC 不变。

        // NCHW→NHWC 转置
        void addTransposeNCHW2NHWC(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 12;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }

        // NHWC 卷积（参数同 addConv）
        void addConvNHWC(int inTid, int wTid, int bTid, int outTid,
                         int strideH, int strideW, int padT, int padB, int padL, int padR,
                         int dilH, int dilW, int group) {
            int id = opCount_;
            opKind_[id] = 13;
            opA_[id] = inTid;
            opB_[id] = wTid;
            opC_[id] = bTid;
            opD_[id] = outTid;
            opP0_[id] = strideH; opP1_[id] = strideW; opP2_[id] = padT; opP3_[id] = padB;
            opP4_[id] = padL; opP5_[id] = padR; opP6_[id] = dilH; opP7_[id] = dilW;
            opP8_[id] = group;
            opCount_ = opCount_ + 1;
        }

        // NHWC 卷积 + ReLU（G1 融合在 NHWC 布局的对应）
        void addConvNHWCRelu(int inTid, int wTid, int bTid, int outTid,
                             int strideH, int strideW, int padT, int padB, int padL, int padR,
                             int dilH, int dilW, int group) {
            int id = opCount_;
            opKind_[id] = 14;
            opA_[id] = inTid;
            opB_[id] = wTid;
            opC_[id] = bTid;
            opD_[id] = outTid;
            opP0_[id] = strideH; opP1_[id] = strideW; opP2_[id] = padT; opP3_[id] = padB;
            opP4_[id] = padL; opP5_[id] = padR; opP6_[id] = dilH; opP7_[id] = dilW;
            opP8_[id] = group;
            opCount_ = opCount_ + 1;
        }

        // NHWC 最大池化
        void addMaxPoolNHWC(int inTid, int outTid, int kh, int kw,
                            int sh, int sw, int pt, int pb, int pl, int pr) {
            int id = opCount_;
            opKind_[id] = 15;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = kh; opP1_[id] = kw; opP2_[id] = sh; opP3_[id] = sw;
            opP4_[id] = pt; opP5_[id] = pb; opP6_[id] = pl; opP7_[id] = pr;
            opCount_ = opCount_ + 1;
        }
        // NHWC AveragePool
        void addAvgPoolNHWC(int inTid, int outTid, int kh, int kw,
                            int sh, int sw, int pt, int pb, int pl, int pr, int cip) {
            int id = opCount_;
            opKind_[id] = 37;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = kh; opP1_[id] = kw; opP2_[id] = sh; opP3_[id] = sw;
            opP4_[id] = pt; opP5_[id] = pb; opP6_[id] = pl; opP7_[id] = pr;
            opP8_[id] = cip;
            opCount_ = opCount_ + 1;
        }

        // ---- F8：Pad（opKind 38 NCHW / 39 NHWC）----
        // pads = 各轴 begin/end；mode 0=constant,1=reflect,2=edge；cval 位型（constant 用）
        void addPad(int inTid, int outTid,
                    int pnB, int pcB, int phB, int pwB, int pnE, int pcE, int phE, int pwE,
                    int mode, int cvalBits) {
            int id = opCount_;
            opKind_[id] = 38;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = pnB; opP1_[id] = pcB; opP2_[id] = phB; opP3_[id] = pwB;
            opP4_[id] = pnE; opP5_[id] = pcE; opP6_[id] = phE; opP7_[id] = pwE;
            opP8_[id] = mode;
            pCval_[id] = cvalBits;
            opCount_ = opCount_ + 1;
        }
        // NHWC Pad：pads 已在 graph 按逻辑轴 [N,H,W,C] 重排为 (pn,ph,pw,pc)
        void addPadNHWC(int inTid, int outTid,
                        int pnB, int phB, int pwB, int pcB, int pnE, int phE, int pwE, int pcE,
                        int mode, int cvalBits) {
            int id = opCount_;
            opKind_[id] = 39;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = pnB; opP1_[id] = phB; opP2_[id] = pwB; opP3_[id] = pcB;
            opP4_[id] = pnE; opP5_[id] = phE; opP6_[id] = pwE; opP7_[id] = pcE;
            opP8_[id] = mode;
            pCval_[id] = cvalBits;
            opCount_ = opCount_ + 1;
        }
        // ---- 3D：Pad3D（opKind 44）----
        // 10 个 pad（N,C,D,H,W 各 begin/end）；mode + cval 存 opX_
        void addPad3D(int inTid, int outTid,
                      int pnB, int pnE, int pcB, int pcE, int pdB, int pdE, int phB, int phE, int pwB, int pwE,
                      int mode, int cvalBits) {
            int id = opCount_;
            opKind_[id] = 44;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = pnB; opP1_[id] = pnE; opP2_[id] = pcB; opP3_[id] = pcE; opP4_[id] = pdB;
            opP5_[id] = pdE; opP6_[id] = phB; opP7_[id] = phE; opP8_[id] = pwB;
            opX_[id * 4 + 0] = pwE; opX_[id * 4 + 1] = mode; opX_[id * 4 + 2] = cvalBits;
            opCount_ = opCount_ + 1;
        }

        // NHWC 全局平均池化：读 [N,H,W,C]，写 [N,C]
        void addGAPoolNHWC(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 16;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }

        // ---- G3：BatchNormalization ----
        // y[n,c,...] = (x - mean[c]) * invStd[c] + bias[c]，invStd = scale/sqrt(var+eps)
        // 参数张量均为 [C] 初始器；eps 以位型 + hasEps 传入，分发时解析为 double。
        void addBatchNorm(int inTid, int outTid, int sT, int bT, int mT, int vT, int epsBits, int hasEps) {
            int id = opCount_;
            opKind_[id] = 17;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opC_[id] = sT;
            opD_[id] = bT;
            opP0_[id] = mT;
            opP1_[id] = vT;
            opP2_[id] = epsBits;
            opP3_[id] = hasEps;
            opCount_ = opCount_ + 1;
        }
        // G3：BatchNormalization（NHWC）
        void addBatchNormNHWC(int inTid, int outTid, int sT, int bT, int mT, int vT, int epsBits, int hasEps) {
            int id = opCount_;
            opKind_[id] = 18;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opC_[id] = sT;
            opD_[id] = bT;
            opP0_[id] = mT;
            opP1_[id] = vT;
            opP2_[id] = epsBits;
            opP3_[id] = hasEps;
            opCount_ = opCount_ + 1;
        }

        // ---- G4：通用激活（逐元素，布局无关）----
        void addReLU6(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 19;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }
        void addLeakyRelu(int inTid, int outTid, int alphaBits, int hasAlpha) {
            int id = opCount_;
            opKind_[id] = 20;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = alphaBits;
            opP1_[id] = hasAlpha;
            opCount_ = opCount_ + 1;
        }
        void addSiLU(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 21;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }
        void addHardSwish(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 22;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }
        // G4：Clip（ReLU6 = Clip(x,0,6)）：min/max 为标量张量 id（-1 = 不限）
        void addClip(int inTid, int outTid, int minTid, int maxTid) {
            int id = opCount_;
            opKind_[id] = 23;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = minTid;
            opP1_[id] = maxTid;
            opCount_ = opCount_ + 1;
        }

        // ---- F8：张量操作算子 ----
        // Reshape：连续拷贝（输出形状由 graph 按 shape 初始器登记）
        void addReshape(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 24;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }
        // Concat：沿 axis 拼接（2-3 输入；a2=-1 表示无第三输入）
        // od0..od3 = 输出 4D 维度；ax0/ax1/ax2 = 各输入沿 axis 的长度（内存行优先序）
        void addConcat(int a0T, int a1T, int a2T, int outT, int axis, int nIn,
                       int od0, int od1, int od2, int od3,
                       int ax0, int ax1, int ax2) {
            int id = opCount_;
            opKind_[id] = 25;
            opA_[id] = a0T;
            opB_[id] = a1T;
            opC_[id] = a2T;
            opD_[id] = outT;
            opP0_[id] = axis;
            opP1_[id] = nIn;
            opP2_[id] = od0; opP3_[id] = od1; opP4_[id] = od2; opP5_[id] = od3;
            opP6_[id] = ax0; opP7_[id] = ax1; opP8_[id] = ax2;
            opCount_ = opCount_ + 1;
        }
        // Concat 反向（opKind 72）：dy → (dx0, dx1, dx2)。参数布局同 addConcat
        // （axis/nIn/输出 4D 视图 od0-3/各输入轴长 ax0-2）；dx2T=-1 表示 2 输入。
        void addBwdConcat(int dyT, int dx0T, int dx1T, int dx2T, int axis, int nIn,
                          int od0, int od1, int od2, int od3,
                          int ax0, int ax1, int ax2) {
            int id = opCount_;
            opKind_[id] = 72;
            opA_[id] = dyT;
            opB_[id] = dx0T;
            opC_[id] = dx1T;
            opD_[id] = dx2T;
            opP0_[id] = axis;
            opP1_[id] = nIn;
            opP2_[id] = od0; opP3_[id] = od1; opP4_[id] = od2; opP5_[id] = od3;
            opP6_[id] = ax0; opP7_[id] = ax1; opP8_[id] = ax2;
            opCount_ = opCount_ + 1;
        }
        // Transpose：perm 转置（pc=perm 元素数；0=缺省反转）
        // id0..id3 = 输入 4D 维度（内存行优先序）
        void addTranspose(int inTid, int outTid, int p0, int p1, int p2, int p3, int pc,
                          int id0, int id1, int id2, int id3) {
            int id = opCount_;
            opKind_[id] = 26;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = p0; opP1_[id] = p1; opP2_[id] = p2; opP3_[id] = p3;
            opP4_[id] = pc;
            opP5_[id] = id0; opP6_[id] = id1; opP7_[id] = id2; opP8_[id] = id3;
            opCount_ = opCount_ + 1;
        }

        // ---- F8：Slice（opKind 27）----
        // 沿任意轴切片；ax/st/sp 为调整后的 轴索引/start/step（cnt 轴，最多 4）；
        // od/id 为输出/输入 4D 维度（内存行优先序）。
        void addSlice(int inTid, int outTid, int cnt,
                      int id0, int id1, int id2, int id3,
                      int od0, int od1, int od2, int od3,
                      int ax0, int st0, int sp0, int ax1, int st1, int sp1,
                      int ax2, int st2, int sp2, int ax3, int st3, int sp3) {
            int id = opCount_;
            opKind_[id] = 27;
            opA_[id] = inTid;
            opB_[id] = outTid;
            sCnt_[id] = cnt;
            sId_[id * 4 + 0] = id0; sId_[id * 4 + 1] = id1; sId_[id * 4 + 2] = id2; sId_[id * 4 + 3] = id3;
            sOd_[id * 4 + 0] = od0; sOd_[id * 4 + 1] = od1; sOd_[id * 4 + 2] = od2; sOd_[id * 4 + 3] = od3;
            sAx_[id * 4 + 0] = ax0; sSt_[id * 4 + 0] = st0; sSp_[id * 4 + 0] = sp0;
            sAx_[id * 4 + 1] = ax1; sSt_[id * 4 + 1] = st1; sSp_[id * 4 + 1] = sp1;
            sAx_[id * 4 + 2] = ax2; sSt_[id * 4 + 2] = st2; sSp_[id * 4 + 2] = sp2;
            sAx_[id * 4 + 3] = ax3; sSt_[id * 4 + 3] = st3; sSp_[id * 4 + 3] = sp3;
            opCount_ = opCount_ + 1;
        }

        // ---- F8：2D 补齐（opKind 28-35，秩无关设计）----
        // Resize2D（opKind 28）：nearest/bilinear 上采样
        void addResize2d(int inTid, int outTid,
                         int N, int C, int inH, int inW, int outH, int outW,
                         int mode, int transform) {
            int id = opCount_;
            opKind_[id] = 28;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = N; opP1_[id] = C; opP2_[id] = inH; opP3_[id] = inW;
            opP4_[id] = outH; opP5_[id] = outW; opP6_[id] = mode; opP7_[id] = transform;
            opCount_ = opCount_ + 1;
        }
        // Resize3D（opKind 45）：N/C 由张量给出；mode 0=nearest 1=trilinear；transform 0=align_corners 1=half_pixel 2=asymmetric
        void addResize3d(int inTid, int outTid,
                         int inD, int inH, int inW, int outD, int outH, int outW,
                         int mode, int transform) {
            int id = opCount_;
            opKind_[id] = 45;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = inD; opP1_[id] = inH; opP2_[id] = inW;
            opP3_[id] = outD; opP4_[id] = outH; opP5_[id] = outW;
            opP6_[id] = mode; opP7_[id] = transform;
            opCount_ = opCount_ + 1;
        }
        // 阶段4d：Resize3D 反向（opKind 71）。dOut=opA, dIn=opB;
        // inD=opP0, inH=opP1, inW=opP2, outD=opP3, outH=opP4, outW=opP5,
        // mode=opP6, transform=opP7（同 addResize3d）；N/C 取 dOut 张量。
        void addBwdResize3d(int dOutT, int dInT,
                            int inD, int inH, int inW, int outD, int outH, int outW,
                            int mode, int transform) {
            int id = opCount_;
            opKind_[id] = 71;
            opA_[id] = dOutT;
            opB_[id] = dInT;
            opP0_[id] = inD; opP1_[id] = inH; opP2_[id] = inW;
            opP3_[id] = outD; opP4_[id] = outH; opP5_[id] = outW;
            opP6_[id] = mode; opP7_[id] = transform;
            opCount_ = opCount_ + 1;
        }
        // Expand（opKind 74）：broadcast 复制。输入 4D 维度 id0-3，输出 4D 维度 od0-3
        // （输入维=1 时沿该维复制；opP0-3=od, opP4-7=id）
        void addExpand(int inTid, int outTid,
                       int id0, int id1, int id2, int id3,
                       int od0, int od1, int od2, int od3) {
            int id = opCount_;
            opKind_[id] = 74;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = od0; opP1_[id] = od1; opP2_[id] = od2; opP3_[id] = od3;
            opP4_[id] = id0; opP5_[id] = id1; opP6_[id] = id2; opP7_[id] = id3;
            opCount_ = opCount_ + 1;
        }
        // Where（opKind 75）：逐元素选择 out = cond ? x : y（三输入，各自 4D 广播）。
        // cond/x/y/out 的 4D 维度由 forward 从各自 tid 的 tN_/tC_/tH_/tW_ 读取（dim=1 广播）。
        void addWhere(int condT, int xT, int yT, int outT) {
            int id = opCount_;
            opKind_[id] = 75;
            opA_[id] = condT;
            opB_[id] = xT;
            opC_[id] = yT;
            opD_[id] = outT;
            opCount_ = opCount_ + 1;
        }
        // Tile（opKind 76）：沿各维按倍数复制 out = tile(in, repeats)。
        // 输入 4D 维度 id0-3（opP0-3），输出 4D 维度 od0-3（opP4-7）。
        void addTile(int inTid, int outTid,
                     int id0, int id1, int id2, int id3,
                     int od0, int od1, int od2, int od3) {
            int id = opCount_;
            opKind_[id] = 76;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = id0; opP1_[id] = id1; opP2_[id] = id2; opP3_[id] = id3;
            opP4_[id] = od0; opP5_[id] = od1; opP6_[id] = od2; opP7_[id] = od3;
            opCount_ = opCount_ + 1;
        }
        // Squeeze（opKind 77）：去掉 size-1 维。数据不变 → 连续拷贝（同 reshape）。
        void addSqueeze(int inTid, int outTid) {
            int id = opCount_;
            opKind_[id] = 77;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opCount_ = opCount_ + 1;
        }
        // Gather（opKind 78）：沿 axis 按 indices 收集（数据 Gather）。
        // data=opA, indices=opB, out=opC; axis=opP0, lenIdx=opP1, data 4D=opP2-5。
        // 输出 4D 维度由 forward 从 outT 的 tN_/tC_/tH_/tW_ 读取。
        void addGather(int dT, int iT, int outT, int axis, int lenIdx,
                       int dn, int dc, int dh, int dw) {
            int id = opCount_;
            opKind_[id] = 78;
            opA_[id] = dT;
            opB_[id] = iT;
            opC_[id] = outT;
            opP0_[id] = axis; opP1_[id] = lenIdx;
            opP2_[id] = dn; opP3_[id] = dc; opP4_[id] = dh; opP5_[id] = dw;
            opCount_ = opCount_ + 1;
        }
        // LogSoftmax（opKind 79）：沿 axis 的稳定 log-softmax。
        // 张量视作 [outer, axisDim, inner]（行优先）；outer=opP1, axisDim=opP2, inner=opP3。
        void addLogSoftmax(int inTid, int outTid, int axis, int outer, int axisDim, int inner) {
            int id = opCount_;
            opKind_[id] = 79;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = axis; opP1_[id] = outer; opP2_[id] = axisDim; opP3_[id] = inner;
            opCount_ = opCount_ + 1;
        }
        // Embedding（opKind 80）：查表 out[s*D+d] = w[ids[s]*D+d]（row-major [S,D]）。
        // weights=opA, ids=opB, out=opC; vocab=opP0, D=opP1, S=opP2。
        void addEmbedding(int wT, int idT, int outT, int vocab, int D, int S) {
            int id = opCount_;
            opKind_[id] = 80;
            opA_[id] = wT;
            opB_[id] = idT;
            opC_[id] = outT;
            opP0_[id] = vocab; opP1_[id] = D; opP2_[id] = S;
            opCount_ = opCount_ + 1;
        }
        // Dropout（opKind 81）：推理恒等 / 训练随机 mask（由 trainMode_ 决定）。
        // in=opA, out=opB; ratio=opP0（F32 位型）。
        void addDropout(int inTid, int outTid, int ratioBits) {
            int id = opCount_;
            opKind_[id] = 81;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = ratioBits;
            opCount_ = opCount_ + 1;
        }
        // Split（opKind 29）：沿 axis 复制 [start, start+len)（一个输出一个 op）
        // d0..d4 为输入 5 维（2D 时 d4=1）；len = 该输出沿 axis 长度
        void addSplit(int inTid, int outTid, int axis, int start, int len,
                      int d0, int d1, int d2, int d3, int d4) {
            int id = opCount_;
            opKind_[id] = 29;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = axis; opP1_[id] = start; opP2_[id] = len;
            opP3_[id] = d0; opP4_[id] = d1; opP5_[id] = d2; opP6_[id] = d3; opP7_[id] = d4;
            opCount_ = opCount_ + 1;
        }
        // Reduce 族（opKind 30）：mode 0 = 全规约；mode 1 = 空间维规约 per-(n,c)
        // redType：0=mean,1=sum,2=max,3=min（G3：ReduceMean/Sum/Max/Min 共用）
        void addReduceMean(int inTid, int outTid, int mode,
                           int N, int C, int S, int total, int keepdims, int redType) {
            int id = opCount_;
            opKind_[id] = 30;
            opA_[id] = inTid;
            opB_[id] = outTid;
            opP0_[id] = mode; opP1_[id] = N; opP2_[id] = C; opP3_[id] = S;
            opP4_[id] = total; opP5_[id] = keepdims; opP6_[id] = redType;
            opCount_ = opCount_ + 1;
        }
        // Sub / Div / Mul（opKind 31-33）：逐元素（b 标量/同尺寸/逐通道广播；C=通道数, S=空间乘积）
        void addSub(int aTid, int bTid, int outTid, int C, int S,
                    int an, int ac, int ah, int aw, int bn, int bc, int bh, int bw) {
            int id = opCount_;
            opKind_[id] = 31;
            opA_[id] = aTid; opB_[id] = bTid; opC_[id] = outTid;
            opP0_[id] = C; opP1_[id] = S;
            opP2_[id] = an; opP3_[id] = ac; opP4_[id] = ah; opP5_[id] = aw;
            opP6_[id] = bn; opP7_[id] = bc; opP8_[id] = bh;
            opX_[id * 4 + 0] = bw;
            opCount_ = opCount_ + 1;
        }
        void addDiv(int aTid, int bTid, int outTid, int C, int S,
                    int an, int ac, int ah, int aw, int bn, int bc, int bh, int bw) {
            int id = opCount_;
            opKind_[id] = 32;
            opA_[id] = aTid; opB_[id] = bTid; opC_[id] = outTid;
            opP0_[id] = C; opP1_[id] = S;
            opP2_[id] = an; opP3_[id] = ac; opP4_[id] = ah; opP5_[id] = aw;
            opP6_[id] = bn; opP7_[id] = bc; opP8_[id] = bh;
            opX_[id * 4 + 0] = bw;
            opCount_ = opCount_ + 1;
        }
        void addMul(int aTid, int bTid, int outTid, int C, int S,
                    int an, int ac, int ah, int aw, int bn, int bc, int bh, int bw) {
            int id = opCount_;
            opKind_[id] = 33;
            opA_[id] = aTid; opB_[id] = bTid; opC_[id] = outTid;
            opP0_[id] = C; opP1_[id] = S;
            opP2_[id] = an; opP3_[id] = ac; opP4_[id] = ah; opP5_[id] = aw;
            opP6_[id] = bn; opP7_[id] = bc; opP8_[id] = bh;
            opX_[id * 4 + 0] = bw;
            opCount_ = opCount_ + 1;
        }
        // Sqrt（opKind 34）：y = sqrt(x)
        void addSqrt(int inTid, int outTid) { int id = opCount_; opKind_[id] = 34; opA_[id] = inTid; opB_[id] = outTid; opCount_ = opCount_ + 1; }
        // InstanceNormalization（opKind 35）：per-(n,c) 空间归一化（秩无关，S=空间乘积）
        // doRelu=1 时输出直接过 ReLU（图优化 IN+Relu 融合，省一次 arena 往返）
        void addInstanceNorm(int inTid, int sTid, int bTid, int outTid,
                             int N, int C, int S, int epsBits, int hasEps, int doRelu) {
            int id = opCount_;
            opKind_[id] = 35;
            opA_[id] = inTid; opB_[id] = sTid; opC_[id] = bTid; opD_[id] = outTid;
            opP0_[id] = N; opP1_[id] = C; opP2_[id] = S; opP3_[id] = epsBits; opP4_[id] = hasEps;
            opRelu_[id] = doRelu;
            opCount_ = opCount_ + 1;
        }

        int opCount() { return opCount_; }
        int tensorOff(int tid) { if (tid < 0) return -1; return tOff_[tid]; }   // 调试用（tid=-1=无该张量，如无偏置层）

        // ---- 阶段4e POC：接口算子分派 ----
        // fwdCpu_/fwdGpu_：前向 opKind → 算子对象（调 forward）；bwdCpu_/bwdGpu_：反向
        // opKind → 算子对象（调 backward）。null = 未注册 → 回退 if/else。
        // 一个算子类同时实现 forward+backward（同一实例可注册到前向与反向两个槽）。
        void registerFwd(int k, IOp op, int isGpu) {
            if (k < 0 || k >= 128) return;
            if (isGpu == 1) fwdGpu_[k] = op;
            else fwdCpu_[k] = op;
        }
        void registerBwd(int k, IOp op, int isGpu) {
            if (k < 0 || k >= 128) return;
            if (isGpu == 1) bwdGpu_[k] = op;
            else bwdCpu_[k] = op;
        }
        // 完整算子：同一个对象注册到前向 fwdKind 与反向 bwdKind 两个槽
        void registerFwdBwd(int fwdKind, int bwdKind, IOp op, int isGpu) {
            registerFwd(fwdKind, op, isGpu);
            registerBwd(bwdKind, op, isGpu);
        }
        // 公共访问器（接口算子读参数/张量/上下文用）
        float[] arenaRef() { return arena; }
        long devRef() { return curDev_; }
        int trainMode() { return trainMode_; }
        double lrRef() { return lr_; }
        int tensorRows(int tid) { return tRows_[tid]; }
        int tensorCols(int tid) { return tCols_[tid]; }
        int tensorN(int tid) { return tN_[tid]; }
        int tensorC(int tid) { return tC_[tid]; }
        int tensorD(int tid) { return tD_[tid]; }
        int tensorH(int tid) { return tH_[tid]; }
        int tensorW(int tid) { return tW_[tid]; }
        int opAAt(int i) { return opA_[i]; }
        int opBAt(int i) { return opB_[i]; }
        int opCAt(int i) { return opC_[i]; }
        int opDAt(int i) { return opD_[i]; }
        int opP0At(int i) { return opP0_[i]; }
        int opP1At(int i) { return opP1_[i]; }
        int opP2At(int i) { return opP2_[i]; }
        int opP3At(int i) { return opP3_[i]; }
        int opP4At(int i) { return opP4_[i]; }
        int opP5At(int i) { return opP5_[i]; }
        int opP6At(int i) { return opP6_[i]; }
        int opP7At(int i) { return opP7_[i]; }
        int opP8At(int i) { return opP8_[i]; }
        int opXAt(int i, int j) { return opX_[i * 4 + j]; }
        int opReluAt(int i) { return opRelu_[i]; }
        // Slice 并行参数表（opKind 27）
        int sCntAt(int i) { return sCnt_[i]; }
        int sIdAt(int i, int j) { return sId_[i * 4 + j]; }
        int sOdAt(int i, int j) { return sOd_[i * 4 + j]; }
        int sAxAt(int i, int j) { return sAx_[i * 4 + j]; }
        int sStAt(int i, int j) { return sSt_[i * 4 + j]; }
        int sSpAt(int i, int j) { return sSp_[i * 4 + j]; }
        // Pad constant_value 位型（opKind 38/39/44）
        int pCvalAt(int i) { return pCval_[i]; }
        // 归约/归一化 GPU 暂存区偏移（opKind 30/35 GPU 用）
        int statsOffRef() { return statsOff_; }

        void run() {
            int prof = 0;
            if (Console.getEnv("MYP_PROF_CPU") == "1") prof = 1;
            if (ifaceInit_ == 0) { ifaceInit_ = 1; registerAllIfaceOps(this); }   // 全接口分派：首调自动注册
            if (trainMode_ == 1) optStep_ = optStep_ + 1;   // 阶段5e：每训练步计数（Adam 偏差修正 t）
            if (trainMode_ == 1 && gradAccEvery_ > 0) gradAccStep_ = gradAccStep_ + 1;   // 梯度累积 micro-step
            int i = 0;
            while (i < opCount_) {
                long tOp0 = 0L;
                if (prof == 1) tOp0 = __myp_now_ms();
                int kk = opKind_[i];
                if (kk >= 0 && kk < 128 && fwdCpu_[kk] != null) {
                    fwdCpu_[kk].forward(this, i);
                } else if (kk >= 0 && kk < 128 && bwdCpu_[kk] != null) {
                    bwdCpu_[kk].backward(this, i);
                }
                if (prof == 1) {
                    int k = opKind_[i];
                    cpuOpMs_[k] = cpuOpMs_[k] + (__myp_now_ms() - tOp0);
                    cpuOpCnt_[k] = cpuOpCnt_[k] + 1;
                }
                i = i + 1;
            }
            if (prof == 1) printCpuProfile();
        }

        // CPU 性能剖析（MYP_PROF_CPU=1 时 run 末尾调用）：按算子类型降序耗时
        void printCpuProfile() {
            Console.writeLine("==== MYP CPU PROFILE ====");
            Console.writeLine("ops-loop=" + Fmt.f(double(totalCpuMs()), 0) + "ms  ops=" + Fmt.i(opCount_));
            int[] sk = new int[64];
            long[] sm = new long[64];
            int n = 0;
            int k = 0;
            while (k < 64) {
                if (cpuOpCnt_[k] > 0) { sk[n] = k; sm[n] = cpuOpMs_[k]; n = n + 1; }
                k = k + 1;
            }
            int a = 0;
            while (a < n) {
                int bm = a;
                int b = a + 1;
                while (b < n) {
                    if (sm[b] > sm[bm]) bm = b;
                    b = b + 1;
                }
                int tk = sk[a]; sk[a] = sk[bm]; sk[bm] = tk;
                long tm = sm[a]; sm[a] = sm[bm]; sm[bm] = tm;
                a = a + 1;
            }
            int p = 0;
            while (p < n) {
                int kk = sk[p];
                long ms = sm[p];
                double avg = double(ms) / double(cpuOpCnt_[kk]);
                Console.writeLine("  kind=" + Fmt.i(kk, 2) + "  " + opKindName(kk) + "  n=" + Fmt.i(cpuOpCnt_[kk], 3) + "  ms=" + Fmt.f(double(ms), 0, 7) + "  avg=" + Fmt.f(avg, 1));
                p = p + 1;
            }
            Console.writeLine("==== end ====");
        }

        long totalCpuMs() {
            long s = 0L;
            int k = 0;
            while (k < 64) { s = s + cpuOpMs_[k]; k = k + 1; }
            return s;
        }

        // ==================== M3 持久化设备 arena（阶段3d 优化） ====================
        // 背景：旧 runGpu 每次调用都整块 16MB arena H2D→算子→整块 D2H→释放。训练
        // 每样本调用一次（batch=1），12k 样本 = 12k 次 32MB 往返 ≈ 384GB PCIe 传输
        // → GPU 训练反而比 CPU 慢 ~5 倍（实测 23s vs ~120s）。
        // 方案：训练期间 arena 一次性驻留显存（gpuPersistentStart），每次 runGpu 只
        // 增量上传 setFlat 置脏的输入张量（data/label），只下载宿主要读的输出张量
        // （markGpuSync 标记的 loss/prob）；gpuPersistentEnd 整块 D2H 一次取回最终
        // 权重并释放。非持久化调用方（推理 run_onnx 等）行为不变。
        int gpuPersistentStart() {
            if (GpuBackend.available() != 1) return 0;
            if (gpuPersist_ == 1) return 1;   // 已在持久化模式
            gpuArena_ = new GpuBufferF(arena, arenaCap_);
            if (gpuArena_.valid() != 1) return 0;
            gpuPersist_ = 1;
            int t = 0;
            while (t < tensorCount_) { dirtyTid_[t] = 0; t = t + 1; }
            return 1;
        }

        // 结束持久化：整块 D2H 取回最终宿主状态（权重等）+ 释放设备 arena。
        // 训练中若宿主中途要读权重，须先调用本方法（或改用 getFlat 已 sync 的张量）。
        void gpuPersistentEnd() {
            if (gpuPersist_ == 1) {
                gpuArena_.copyToHost(arena, 0, 0, arenaCap_);
                gpuArena_.free();
                gpuPersist_ = 0;
            }
        }

        // 标记某张量在每次 runGpu 后需 D2H 回宿主（宿主在 step 后要读：loss/prob）。
        void markGpuSync(int tid) {
            if (gpuSyncN_ >= 32) return;
            int i = 0;
            while (i < gpuSyncN_) {
                if (gpuSyncTids_[i] == tid) return;
                i = i + 1;
            }
            gpuSyncTids_[gpuSyncN_] = tid;
            gpuSyncN_ = gpuSyncN_ + 1;
        }

        // ============ 推理持久化（P5b，2026-09-01）============
        // 推理默认每次 runGpu 都整块 arena H2D（~100MB 权重）+ 整块 D2H（含全部权重）。
        // 推理持久化：权重一次性驻留显存，之后每次 runGpu 只增量 H2D 置脏输入 + 只
        // D2H 输出张量（markGpuSync 标记）。用于单模型多帧推理（视频/批量/服务）。
        // 返回 1 表示进入持久化推理模式（输出张量 outTid 已标记 D2H），0 表示失败
        // （无 GPU 或设备分配失败）——调用方此时走原 runGpu 路径。
        int gpuInferStart(int outTid) {
            if (GpuBackend.available() != 1) return 0;
            if (gpuPersist_ == 1) return 1;
            gpuArena_ = new GpuBufferF(arena, arenaCap_);
            if (gpuArena_.valid() != 1) return 0;
            gpuPersist_ = 1;
            int t = 0;
            while (t < tensorCount_) { dirtyTid_[t] = 0; t = t + 1; }
            if (outTid >= 0) markGpuSync(outTid);
            return 1;
        }

        // 结束推理持久化：整块 D2H 取回 + 释放设备 arena。
        void gpuInferEnd() {
            if (gpuPersist_ == 1) {
                gpuArena_.copyToHost(arena, 0, 0, arenaCap_);
                gpuArena_.free();
                gpuPersist_ = 0;
            }
        }

        // 阶段六：持久化模式下最近一次 runGpu 增量 H2D 上传 / D2H 下载的张量数。
        // 非持久化（整块往返）上传数=0（整块 H2D 由 GpuBufferF 构造器完成，D2H 整块）。
        int gpuH2DUploads() { return h2dUploads_; }
        int gpuH2DDownloads() { return h2dDownloads_; }

        // ==================== 阶段七：计划缓存（dumpPlan/loadPlan） ====================
        // 把 buildRuntime 之后的执行计划（op 表 + tensor 表 + Slice 参数 + arena 权重）
        // 序列化到磁盘；重复加载同一模型时 loadPlan 直接恢复，跳过 ONNX 解析 + 优化
        // pass + buildRuntime（大模型加载从 ~秒级降到毫秒级）。
        // 二进制格式（小端）：
        //   magic[4]="MYPP" version:int32 tensorCount:int32 opCount:int32 arenaTop:int32
        //   每张量：rows cols N C D H W off（7×int32）
        //   每 op：kind A B C D P0..P8 X0..X3 Relu Cval（19×int32）
        //   每 op：sCnt sAx0..3 sSt0..3 sSp0..3 sOd0..3 sId0..3（1+20 int32）
        //   arena：arenaTop 个 float（权重/常量已写入）
        int dumpPlan(string path) {
            int fd = __myp_io_fopen(path, "wb");
            if (fd < 0) return 0;
            // ONNX 路径用 addTensorPlanned*（内存规划，不 bump arenaTop_），故权重区
            // 边界 = max(arenaTop_, 各张量 off+size)。为简单可靠，dump 整个 arena 数据区
            // （arenaCap_ - statsSize() 前的规划容量 = 规划峰值，权重/常量全在其中）。
            int dataLen = arenaCap_ - statsSize();
            if (dataLen < arenaTop_) dataLen = arenaTop_;
            __myp_io_write_byte(80); __myp_io_write_byte(89); __myp_io_write_byte(80); __myp_io_write_byte(80);   // "MYPP"
            writeI32(1);   // version
            writeI32(tensorCount_);
            writeI32(opCount_);
            writeI32(dataLen);
            int t = 0;
            while (t < tensorCount_) {
                writeI32(tRows_[t]); writeI32(tCols_[t]); writeI32(tN_[t]); writeI32(tC_[t]);
                writeI32(tD_[t]); writeI32(tH_[t]); writeI32(tW_[t]); writeI32(tOff_[t]);
                t = t + 1;
            }
            int i = 0;
            while (i < opCount_) {
                writeI32(opKind_[i]);
                writeI32(opA_[i]); writeI32(opB_[i]); writeI32(opC_[i]); writeI32(opD_[i]);
                writeI32(opP0_[i]); writeI32(opP1_[i]); writeI32(opP2_[i]); writeI32(opP3_[i]);
                writeI32(opP4_[i]); writeI32(opP5_[i]); writeI32(opP6_[i]); writeI32(opP7_[i]); writeI32(opP8_[i]);
                writeI32(opX_[i * 4 + 0]); writeI32(opX_[i * 4 + 1]); writeI32(opX_[i * 4 + 2]); writeI32(opX_[i * 4 + 3]);
                writeI32(opRelu_[i]); writeI32(pCval_[i]);
                writeI32(sCnt_[i]);
                writeI32(sAx_[i * 4 + 0]); writeI32(sAx_[i * 4 + 1]); writeI32(sAx_[i * 4 + 2]); writeI32(sAx_[i * 4 + 3]);
                writeI32(sSt_[i * 4 + 0]); writeI32(sSt_[i * 4 + 1]); writeI32(sSt_[i * 4 + 2]); writeI32(sSt_[i * 4 + 3]);
                writeI32(sSp_[i * 4 + 0]); writeI32(sSp_[i * 4 + 1]); writeI32(sSp_[i * 4 + 2]); writeI32(sSp_[i * 4 + 3]);
                writeI32(sOd_[i * 4 + 0]); writeI32(sOd_[i * 4 + 1]); writeI32(sOd_[i * 4 + 2]); writeI32(sOd_[i * 4 + 3]);
                writeI32(sId_[i * 4 + 0]); writeI32(sId_[i * 4 + 1]); writeI32(sId_[i * 4 + 2]); writeI32(sId_[i * 4 + 3]);
                i = i + 1;
            }
            // arena 权重区（buildRuntime 后 writeWeight 已写入；序列化 dataLen 前全部）
            int a = 0;
            while (a < dataLen) {
                int bits = floatToBits(arena[a]);
                writeI32(bits);
                a = a + 1;
            }
            __myp_io_fclose();
            return 1;
        }

        // 从计划文件恢复执行计划（跳过 ONNX 解析+优化+buildRuntime）。
        // 返回 1=成功。恢复后 run()/runGpu() 直接可用（权重在 arena 已就位）。
        int loadPlan(string path) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return 0;
            int m0 = readByte(); int m1 = readByte(); int m2 = readByte(); int m3 = readByte();
            if (m0 != 80 || m1 != 89 || m2 != 80 || m3 != 80) { __myp_io_fclose(); return 0; }
            int version = readI32();
            if (version != 1) { __myp_io_fclose(); return 0; }
            int tn = readI32();
            int on = readI32();
            int dataLen = readI32();
            arenaTop_ = 0;
            tensorCount_ = 0;
            opCount_ = 0;
            gpuPersist_ = 0;
            gpuSyncN_ = 0;
            int t = 0;
            while (t < tn) {
                tRows_[t] = readI32(); tCols_[t] = readI32(); tN_[t] = readI32(); tC_[t] = readI32();
                tD_[t] = readI32(); tH_[t] = readI32(); tW_[t] = readI32(); tOff_[t] = readI32();
                t = t + 1;
            }
            tensorCount_ = tn;
            int i = 0;
            while (i < on) {
                opKind_[i] = readI32();
                opA_[i] = readI32(); opB_[i] = readI32(); opC_[i] = readI32(); opD_[i] = readI32();
                opP0_[i] = readI32(); opP1_[i] = readI32(); opP2_[i] = readI32(); opP3_[i] = readI32();
                opP4_[i] = readI32(); opP5_[i] = readI32(); opP6_[i] = readI32(); opP7_[i] = readI32(); opP8_[i] = readI32();
                opX_[i * 4 + 0] = readI32(); opX_[i * 4 + 1] = readI32(); opX_[i * 4 + 2] = readI32(); opX_[i * 4 + 3] = readI32();
                opRelu_[i] = readI32(); pCval_[i] = readI32();
                sCnt_[i] = readI32();
                sAx_[i * 4 + 0] = readI32(); sAx_[i * 4 + 1] = readI32(); sAx_[i * 4 + 2] = readI32(); sAx_[i * 4 + 3] = readI32();
                sSt_[i * 4 + 0] = readI32(); sSt_[i * 4 + 1] = readI32(); sSt_[i * 4 + 2] = readI32(); sSt_[i * 4 + 3] = readI32();
                sSp_[i * 4 + 0] = readI32(); sSp_[i * 4 + 1] = readI32(); sSp_[i * 4 + 2] = readI32(); sSp_[i * 4 + 3] = readI32();
                sOd_[i * 4 + 0] = readI32(); sOd_[i * 4 + 1] = readI32(); sOd_[i * 4 + 2] = readI32(); sOd_[i * 4 + 3] = readI32();
                sId_[i * 4 + 0] = readI32(); sId_[i * 4 + 1] = readI32(); sId_[i * 4 + 2] = readI32(); sId_[i * 4 + 3] = readI32();
                i = i + 1;
            }
            opCount_ = on;
            // 重建 arena（容量 = dataLen + stats 尾部）并恢复权重区
            resizeArena(dataLen);
            int a = 0;
            while (a < dataLen) {
                int bits = readI32();
                arena[a] = float(bitsToFloat(bits));
                a = a + 1;
            }
            arenaTop_ = dataLen;
            __myp_io_fclose();
            return 1;
        }

        // ---- 计划缓存内部小工具 ----
        void writeI32(int v) {
            __myp_io_write_byte(v & 255);
            __myp_io_write_byte((v >> 8) & 255);
            __myp_io_write_byte((v >> 16) & 255);
            __myp_io_write_byte((v >> 24) & 255);
        }
        int readByte() {
            int b = __myp_io_read_byte();
            if (b < 0) return 0;
            return b;
        }
        int readI32() {
            int b0 = readByte(); int b1 = readByte(); int b2 = readByte(); int b3 = readByte();
            return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
        }
        int floatToBits(double v) {
            int bits = F32.toBits(v);
            return bits;
        }
        double bitsToFloat(int bits) {
            return F32.toDouble(bits);
        }

        // GPU 执行：M3 设备驻留。
        // 整块 arena 一次 H2D 到设备（GpuBufferF），各算子 resident(a=dev) 直接
        // 操作设备内存（零逐算子传输），最后一次 D2H 取回。
        // GPU 不可用时 dev=0，@gpu for 自动回退 CPU（结果一致，arenaBuf no-op）。
        // MYP_PROF_GPU=1 时按算子类型统计耗时（H2D/算子循环/D2H 三段 + 分型汇总）。
        // 持久化模式（gpuPersist_==1）：复用 gpuArena_，只增量 H2D 脏输入 + 增量 D2H sync 输出。
        void runGpu() {
            long dev = 0L;
            GpuBufferF arenaBuf = null;
            int gpuActive = 0;
            int prof = 0;
            if (Console.getEnv("MYP_PROF_GPU") == "1") prof = 1;
            long tH2D0 = __myp_now_ms();
            if (GpuBackend.available() == 1) {
                h2dUploads_ = 0;
                h2dDownloads_ = 0;
                if (gpuPersist_ == 1) {
                    // 持久化：复用常驻设备 arena，只上传 setFlat 置脏的输入张量
                    arenaBuf = gpuArena_;
                    dev = arenaBuf.devicePtr();
                    gpuActive = 1;
                    int t = 0;
                    while (t < tensorCount_) {
                        if (dirtyTid_[t] == 1) {
                            arenaBuf.copyFromHost(arena, tOff_[t], tOff_[t], tensorSize(t));
                            dirtyTid_[t] = 0;
                            h2dUploads_ = h2dUploads_ + 1;
                        }
                        t = t + 1;
                    }
                } else {
                    arenaBuf = new GpuBufferF(arena, arenaCap_);
                    dev = arenaBuf.devicePtr();
                    gpuActive = 1;
                }
            }
            long tH2D1 = __myp_now_ms();
            long tLoop0 = __myp_now_ms();
            curDev_ = dev;
            if (ifaceInit_ == 0) { ifaceInit_ = 1; registerAllIfaceOps(this); }   // 全接口分派：首调自动注册
            if (trainMode_ == 1) optStep_ = optStep_ + 1;   // 阶段5e：每训练步计数（Adam 偏差修正 t）
            if (trainMode_ == 1 && gradAccEvery_ > 0) gradAccStep_ = gradAccStep_ + 1;   // 梯度累积 micro-step
            int i = 0;
            while (i < opCount_) {
                long tOp0 = __myp_now_ms();
                if (Console.getEnv("MYP_LOG_OPS") == "1") {
                    int fd = __myp_io_fopen("/tmp/fine_ops.txt", "ab");
                    __myp_io_write("op " + Fmt.i(i) + " kind=" + Fmt.i(opKind_[i]) + " xa=" + Fmt.i(opA_[i]) + " xb=" + Fmt.i(opB_[i]) + " xc=" + Fmt.i(opC_[i]) + " xd=" + Fmt.i(opD_[i]) + " szY=" + Fmt.i(tensorSize(opB_[i])) + " P0=" + Fmt.i(opP0_[i]) + " P1=" + Fmt.i(opP1_[i]) + " P2=" + Fmt.i(opP2_[i]) + " P3=" + Fmt.i(opP3_[i]) + " P4=" + Fmt.i(opP4_[i]) + " P5=" + Fmt.i(opP5_[i]) + "\n");
                    __myp_io_fclose();
                }
                int kk = opKind_[i];
                if (kk >= 0 && kk < 128 && fwdGpu_[kk] != null) {
                    fwdGpu_[kk].forward(this, i);
                } else if (kk >= 0 && kk < 128 && bwdGpu_[kk] != null) {
                    bwdGpu_[kk].backward(this, i);
                }
                if (prof == 1) {
                    int k = opKind_[i];
                    gpuOpMs_[k] = gpuOpMs_[k] + (__myp_now_ms() - tOp0);
                    gpuOpCnt_[k] = gpuOpCnt_[k] + 1;
                }
                i = i + 1;
            }
            long tLoop1 = __myp_now_ms();
            // 用 int 标志 gpuActive 判断（勿用 dev != 0L：设备指针高地址低 32 位
            // 可能为 0，MYP 的 long 比较会误判为相等）。
            long tD2H0 = __myp_now_ms();
            if (gpuActive == 1) {
                if (gpuPersist_ == 1) {
                    // 持久化：只下载宿主要读的输出张量（markGpuSync 标记的 loss/prob）
                    int s = 0;
                    while (s < gpuSyncN_) {
                        int st = gpuSyncTids_[s];
                        if (st >= 0 && st < tensorCount_) {
                            arenaBuf.copyToHost(arena, tOff_[st], tOff_[st], tensorSize(st));
                            h2dDownloads_ = h2dDownloads_ + 1;
                        }
                        s = s + 1;
                    }
                } else {
                    arenaBuf.copyToHost(arena, 0, 0, arenaCap_);
                    arenaBuf.free();
                }
            }
            long tD2H1 = __myp_now_ms();
            if (prof == 1) {
                printGpuProfile(tH2D1 - tH2D0, tLoop1 - tLoop0, tD2H1 - tD2H0);
            }
        }

        // GPU 性能剖析（MYP_PROF_GPU=1 时 runGpu 末尾调用）：
        // 输出 H2D / 算子循环 / D2H 三段耗时，并按算子类型降序列出累计耗时。
        void printGpuProfile(long h2dMs, long loopMs, long d2hMs) {
            Console.writeLine("==== MYP GPU PROFILE ====");
            Console.writeLine("H2D=" + Fmt.f(double(h2dMs), 0) + "ms  ops-loop=" + Fmt.f(double(loopMs), 0) + "ms  D2H=" + Fmt.f(double(d2hMs), 0) + "ms  ops=" + Fmt.i(opCount_));
            int[] sk = new int[64];
            long[] sm = new long[64];
            int n = 0;
            int k = 0;
            while (k < 64) {
                if (gpuOpCnt_[k] > 0) { sk[n] = k; sm[n] = gpuOpMs_[k]; n = n + 1; }
                k = k + 1;
            }
            // 按累计耗时降序（选择排序）
            int a = 0;
            while (a < n) {
                int bm = a;
                int b = a + 1;
                while (b < n) {
                    if (sm[b] > sm[bm]) bm = b;
                    b = b + 1;
                }
                int tk = sk[a]; sk[a] = sk[bm]; sk[bm] = tk;
                long tm = sm[a]; sm[a] = sm[bm]; sm[bm] = tm;
                a = a + 1;
            }
            int p = 0;
            while (p < n) {
                int kk = sk[p];
                long ms = sm[p];
                double avg = double(ms) / double(gpuOpCnt_[kk]);
                Console.writeLine("  kind=" + Fmt.i(kk, 2) + "  " + opKindName(kk) + "  n=" + Fmt.i(gpuOpCnt_[kk], 3) + "  ms=" + Fmt.f(double(ms), 0, 7) + "  avg=" + Fmt.f(avg, 1));
                p = p + 1;
            }
            Console.writeLine("==== end ====");
        }

        // opKind 的可读名称（供剖析输出）
        string opKindName(int k) {
            if (k == 1) return "dense";
            if (k == 2) return "relu";
            if (k == 3) return "softmax";
            if (k == 4) return "sigmoid";
            if (k == 5) return "add";
            if (k == 6) return "matmul";
            if (k == 7) return "conv";
            if (k == 8) return "maxpool";
            if (k == 9) return "gapool";
            if (k == 10) return "flatten";
            if (k == 11) return "convRelu";
            if (k == 12) return "transposeNCHW2NHWC";
            if (k == 13) return "convNHWC";
            if (k == 14) return "convNHWCRelu";
            if (k == 15) return "maxpoolNHWC";
            if (k == 16) return "gapoolNHWC";
            if (k == 17) return "batchnorm";
            if (k == 18) return "batchnormNHWC";
            if (k == 19) return "relu6";
            if (k == 20) return "leakyrelu";
            if (k == 21) return "silu";
            if (k == 22) return "hardswish";
            if (k == 23) return "clip";
            if (k == 24) return "reshape/copy";
            if (k == 25) return "concat";
            if (k == 26) return "transpose";
            if (k == 27) return "slice";
            if (k == 28) return "resize2d";
            if (k == 29) return "split";
            if (k == 30) return "reduceMean";
            if (k == 31) return "sub";
            if (k == 32) return "div";
            if (k == 33) return "mul";
            if (k == 34) return "sqrt";
            if (k == 35) return "instancenorm";
            if (k == 36) return "avgpool";
            if (k == 37) return "avgpoolNHWC";
            if (k == 38) return "pad";
            if (k == 39) return "padNHWC";
            if (k == 40) return "convTranspose";
            if (k == 41) return "conv3d";
            if (k == 42) return "maxpool3d";
            if (k == 43) return "avgpool3d";
            if (k == 44) return "pad3d";
            if (k == 45) return "resize3d";
            if (k == 68) return "bwdConvTranspose";
            if (k == 69) return "diceLoss";
            if (k == 70) return "bwdSoftmax";
            if (k == 71) return "bwdResize3d";
            return "kind" + Fmt.i(k);
        }

        int argmax1d(int tid) {
            int n = tRows_[tid] * tCols_[tid];
            int bi = 0;
            double bv = arena[tOff_[tid] + 0];
            int i = 1;
            while (i < n) {
                double v = arena[tOff_[tid] + i];
                if (v > bv) { bv = v; bi = i; }
                i = i + 1;
            }
            return bi;
        }

        // 指定列（样本）的行 argmax
        int argmaxCol(int tid, int col) {
            int batch = tCols_[tid];
            int rows = tRows_[tid];
            int bi = 0;
            double bv = arena[tOff_[tid] + 0 * batch + col];
            int i = 1;
            while (i < rows) {
                double v = arena[tOff_[tid] + i * batch + col];
                if (v > bv) { bv = v; bi = i; }
                i = i + 1;
            }
            return bi;
        }

        int tensorSize(int tid) {
            return tRows_[tid] * tCols_[tid];
        }

        // 调试：返回 op i 的输出张量 id
        int opOutTid(int i) {
            int k = opKind_[i];
            if (k == 1 || k == 7 || k == 11 || k == 13 || k == 14 || k == 25 ||
                k == 35 || k == 41) return opD_[i];
            if (k == 5 || k == 6 || k == 31 || k == 32 || k == 33) return opC_[i];
            return opB_[i];
        }

        // 算子足迹：涉及张量的最大 [偏移, 偏移+大小)，作为 @gpu for 传输上界
        int fp2(int a, int b) {
            int m = tOff_[a] + tensorSize(a);
            int m2 = tOff_[b] + tensorSize(b);
            if (m2 > m) m = m2;
            return m;
        }
        int fp3(int a, int b, int c) {
            int m = fp2(a, b);
            int m2 = tOff_[c] + tensorSize(c);
            if (m2 > m) m = m2;
            return m;
        }
        int fp4(int a, int b, int c, int d) {
            int m = fp3(a, b, c);
            int m2 = tOff_[d] + tensorSize(d);
            if (m2 > m) m = m2;
            return m;
        }

    property:
        float[] arena;
        int[512] tRows_;
        int[512] tCols_;
        int[512] tN_;
        int[512] tC_;
        int[512] tD_;      // 3D 扩展：第 5 维（深度 D，NCDHW）
        int[512] tH_;
        int[512] tW_;
        int[512] tOff_;
        int[512] opKind_;
        int[512] opA_;
        int[512] opB_;
        int[512] opC_;
        int[512] opD_;
        int[512] opP0_;
        int[512] opP1_;
        int[512] opP2_;
        int[512] opP3_;
        int[512] opP4_;
        int[512] opP5_;
        int[512] opP6_;
        int[512] opP7_;
        int[512] opP8_;
        int[2048] opX_;       // 3D：额外参数 [id*4+k]（Conv3D dd/dh/dw/group，MaxPool3D pb/pl/pr）
        int[512] pCval_;      // F8：Pad constant_value（float 位型）
        IOp[128] fwdCpu_;     // 阶段4e POC：接口算子分派表（CPU 前向）
        IOp[128] bwdCpu_;     // 阶段4e POC：接口算子分派表（CPU 反向）
        IOp[128] fwdGpu_;     // 阶段4e POC：接口算子分派表（GPU 前向）
        IOp[128] bwdGpu_;     // 阶段4e POC：接口算子分派表（GPU 反向）
        int ifaceInit_;        // 全接口分派：首调自动注册标记
        long curDev_;         // 阶段4e POC：runGpu 当前设备指针（接口 GPU 算子取 dev）
        long[64] gpuOpMs_;    // GPU profiling：按 opKind 累计耗时（ms，MYP_PROF_GPU=1）
        int[64] gpuOpCnt_;    // GPU profiling：按 opKind 计数
        long[64] cpuOpMs_;    // CPU profiling：按 opKind 累计耗时（ms，MYP_PROF_CPU=1）
        int[64] cpuOpCnt_;    // CPU profiling：按 opKind 计数
        int[512] opRelu_;     // 图优化：1 = op 输出直接过 ReLU（IN+Relu 融合等）
        int statsOff_;        // 全 resident 归约暂存区（arena 尾部预留）偏移
        // ---- F8：Slice 参数（按 op id 索引；per-axis [id*4+k]）----
        int[512] sCnt_;
        int[2048] sAx_;
        int[2048] sSt_;
        int[2048] sSp_;
        int[2048] sOd_;
        int[2048] sId_;
        int arenaCap_;
        int arenaTop_;
        int tensorCount_;
        int opCount_;
        int trainMode_;      // 阶段2：1 = 执行反向/更新算子（eval=0 跳过）
        double lr_;          // 阶段2：SGD 学习率（Update 用）
        int optMode_;        // 阶段5e：优化器 0=SGD 1=动量 2=AdamW
        double optWd_;       // 阶段5e：weight decay（L2/解耦）
        int optStep_;        // 阶段5e：优化步数（Adam 偏差修正 t）
        int[512] optOff_;    // 阶段5e：每权重优化器状态区偏移（-1=未分配）
        int optBase_;        // 阶段5e：状态区下一个空闲偏移（arena 尾部）
        int gradAccEvery_;   // 梯度累积：每 K 步才应用一次权重更新（0=禁用）
        int gradAccStep_;    // 梯度累积：当前累积的 micro-step 计数
        int[512] gradAccOff_; // 梯度累积：每权重 gAcc 缓冲偏移（arena 尾部，-1=未分配）
        int ampSim_;         // AMP 模拟：1 = 梯度 fp16 舍入（模拟 fp16 训练）
        GpuBufferF gpuArena_;      // 阶段3d：持久化设备 arena（gpuPersist_=1 时有效）
        int gpuPersist_;           // 阶段3d：持久化 arena 模式激活标志
        int[512] dirtyTid_;        // 阶段3d：setFlat 置脏的张量（runGpu 增量 H2D）
        int[32] gpuSyncTids_;      // 阶段3d：runGpu 后需 D2H 的张量（宿主要读：loss/prob）
        int gpuSyncN_;
        int h2dUploads_;           // 阶段六：最近一次 runGpu 增量 H2D 上传的张量数（持久化）
        int h2dDownloads_;         // 阶段六：最近一次 runGpu D2H 下载的张量数（持久化）;
}
