// ops.myp — Core inference operators (CPU/FP32 style using double)
import env;
import math;
import pool;

class InferOps {
    static:
        // y = W x + b（batch 沿列并行）
        // x: [inDim, batch], W: [outDim, inDim], b: [outDim, 1], y: [outDim, batch]
        void dense(
            float[] arena,
            int xOff, int inDim, int batch,
            int wOff, int outDim,
            int bOff,
            int yOff
        ) {
            @parallel for (int i = 0; i < outDim; i = i + 1) {
                int k = 0;
                while (k < batch) {
                    float sum = arena[bOff + i];
                    int j = 0;
                    while (j < inDim) {
                        sum = sum + arena[wOff + i * inDim + j] * arena[xOff + j * batch + k];
                        j = j + 1;
                    }
                    arena[yOff + i * batch + k] = sum;
                    k = k + 1;
                }
            }
        }

        // y = W x（无偏置；batch 沿列）
        // x: [inDim, batch], W: [outDim, inDim], y: [outDim, batch]
        void matmul(float[] arena, int xOff, int inDim, int batch, int wOff, int outDim, int yOff) {
            @parallel for (int i = 0; i < outDim; i = i + 1) {
                int k = 0;
                while (k < batch) {
                    float sum = 0.0f;
                    int j = 0;
                    while (j < inDim) {
                        sum = sum + arena[wOff + i * inDim + j] * arena[xOff + j * batch + k];
                        j = j + 1;
                    }
                    arena[yOff + i * batch + k] = sum;
                    k = k + 1;
                }
            }
        }

        void relu(float[] arena, int inOff, int outOff, int n) {
            int i = 0;
            while (i < n) {
                float v = arena[inOff + i];
                if (v > 0.0f) arena[outOff + i] = v;
                else arena[outOff + i] = 0.0f;
                i = i + 1;
            }
        }

        void sigmoid(float[] arena, int inOff, int outOff, int n) {
            int i = 0;
            while (i < n) {
                float x = arena[inOff + i];
                float e = Math.exp(0.0f - x);
                arena[outOff + i] = 1.0f / (1.0f + e);
                i = i + 1;
            }
        }

        // 每列一个样本，沿行做 softmax（batch=1 时等价于整行 softmax）
        void softmax(float[] arena, int inOff, int outOff, int rows, int cols) {
            int k = 0;
            while (k < cols) {
                float maxv = arena[inOff + 0 * cols + k];
                int i = 1;
                while (i < rows) {
                    float v = arena[inOff + i * cols + k];
                    if (v > maxv) maxv = v;
                    i = i + 1;
                }

                float sum = 0.0f;
                i = 0;
                while (i < rows) {
                    float e = Math.exp(arena[inOff + i * cols + k] - maxv);
                    arena[outOff + i * cols + k] = e;
                    sum = sum + e;
                    i = i + 1;
                }

                i = 0;
                while (i < rows) {
                    arena[outOff + i * cols + k] = arena[outOff + i * cols + k] / sum;
                    i = i + 1;
                }
                k = k + 1;
            }
        }

        // ---- 阶段5：Transformer 算子（CPU）----

        // embedding 查表：eOff:[vocab,D]，idOff: 浮点编码的 token id [S]，xOff:[D,S]（行=特征，列=序列）。
        // x[d,s] = e[id[s]*D + d]。
        void gatherRows(float[] arena, int eOff, int idOff, int xOff, int vocab, int D, int S) {
            int s = 0;
            while (s < S) {
                int id = int(arena[idOff + s]);
                if (id < 0) id = 0;
                if (id >= vocab) id = vocab - 1;
                int d = 0;
                while (d < D) {
                    arena[xOff + d * S + s] = arena[eOff + id * D + d];
                    d = d + 1;
                }
                s = s + 1;
            }
        }

        // RMSNorm：xOff:[D,S]（行=特征，列=token），gOff:[D]，yOff:[D,S]。
        // y[d,s] = x[d,s] / sqrt(mean_d(x[:,s]^2) + eps) * g[d]
        void rmsNorm(float[] arena, int xOff, int gOff, int yOff, int D, int S, double eps) {
            int s = 0;
            while (s < S) {
                double sum = 0.0;
                int d = 0;
                while (d < D) { double v = arena[xOff + d * S + s]; sum = sum + v * v; d = d + 1; }
                double rstd = 1.0 / Math.sqrt(sum / double(D) + eps);
                d = 0;
                while (d < D) {
                    arena[yOff + d * S + s] = float(double(arena[xOff + d * S + s]) * rstd * double(arena[gOff + d]));
                    d = d + 1;
                }
                s = s + 1;
            }
        }

        // 缩放点积注意力（全序列，无 KV cache；可选因果掩码）。
        // q,k,v,out:[D,S]（行=heads*dh 特征，列=token）。score[b,i,j]=Σ_dh q·k/√dh；causal 时 j>i → -inf；
        // softmax(j)；out[b,dh,i]=Σ_j p[b,i,j]·v[b,dh,j]。scOff 为 S*S 暂存（分数/softmax）。
        // GQA：groups = H / num_kv_heads（Q 头 b 共享 KV 头 b/groups）；groups=1 即标准 MHA。
        void attention(float[] arena, int qOff, int kOff, int vOff, int outOff, int scOff,
                       int D, int S, int heads, int causal, int groups) {
            int dh = D / heads;
            int kvHeads = heads / groups;
            double scale = 1.0 / Math.sqrt(double(dh));
            int b = 0;
            while (b < heads) {
                int kvh = b / groups;   // GQA：该 Q 头共享的 KV 头
                int i = 0;
                while (i < S) {
                    int j = 0;
                    while (j < S) {
                        double sum = 0.0;
                        int d = 0;
                        while (d < dh) {
                            sum = sum + double(arena[qOff + (b * dh + d) * S + i]) * double(arena[kOff + (kvh * dh + d) * S + j]);
                            d = d + 1;
                        }
                        double sc = sum * scale;
                        if (causal == 1 && j > i) sc = -1.0e30;
                        arena[scOff + i * S + j] = float(sc);
                        j = j + 1;
                    }
                    // softmax over j
                    float maxv = arena[scOff + i * S];
                    j = 1;
                    while (j < S) {
                        if (arena[scOff + i * S + j] > maxv) maxv = arena[scOff + i * S + j];
                        j = j + 1;
                    }
                    double sumE = 0.0;
                    j = 0;
                    while (j < S) {
                        double e = Math.exp(double(arena[scOff + i * S + j]) - double(maxv));
                        arena[scOff + i * S + j] = float(e);
                        sumE = sumE + e;
                        j = j + 1;
                    }
                    j = 0;
                    while (j < S) {
                        arena[scOff + i * S + j] = float(double(arena[scOff + i * S + j]) / sumE);
                        j = j + 1;
                    }
                    i = i + 1;
                }
                // out[b,dh,i] = Σ_j p[b,i,j]·v[kvh,dh,j]
                int d = 0;
                while (d < dh) {
                    int i2 = 0;
                    while (i2 < S) {
                        double sum = 0.0;
                        int j = 0;
                        while (j < S) {
                            sum = sum + double(arena[scOff + i2 * S + j]) * double(arena[vOff + (kvh * dh + d) * S + j]);
                            j = j + 1;
                        }
                        arena[outOff + (b * dh + d) * S + i2] = float(sum);
                        i2 = i2 + 1;
                    }
                    d = d + 1;
                }
                b = b + 1;
            }
        }

        // 阶段5：LayerNorm（GPT-2）。xOff:[D,S]（行=特征，列=token），gamma/beta:[D]，yOff:[D,S]。
        // y[d,s] = (x[d,s]-mean_s)/sqrt(var_s+eps)*gamma[d]+beta[d]（mean/var 按特征维、每 token）。
        void layerNorm(float[] arena, int xOff, int gOff, int bOff, int yOff, int D, int S, double eps) {
            int s = 0;
            while (s < S) {
                double mean = 0.0;
                int d = 0;
                while (d < D) { mean = mean + double(arena[xOff + d * S + s]); d = d + 1; }
                mean = mean / double(D);
                double vsum = 0.0;
                d = 0;
                while (d < D) {
                    double v = double(arena[xOff + d * S + s]) - mean;
                    vsum = vsum + v * v;
                    d = d + 1;
                }
                double rstd = 1.0 / Math.sqrt(vsum / double(D) + eps);
                d = 0;
                while (d < D) {
                    double v = (double(arena[xOff + d * S + s]) - mean) * rstd;
                    arena[yOff + d * S + s] = float(v * double(arena[gOff + d]) + double(arena[bOff + d]));
                    d = d + 1;
                }
                s = s + 1;
            }
        }

        // 阶段5：GELU（GPT-2 精确版）：0.5*x*(1+erf(x/√2))。MYP Math 无 erf，内联 Abramowitz-Stegun 7.1.26 近似（误差 <1.5e-7）。
        void gelu(float[] arena, int inOff, int outOff, int n) {
            int i = 0;
            while (i < n) {
                double x = double(arena[inOff + i]);
                double z = x / 1.4142135623730951;
                double a = Math.abs(z);
                double t = 1.0 / (1.0 + 0.3275911 * a);
                double y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(0.0 - a * a);
                double erf = y;
                if (z < 0.0) erf = 0.0 - y;
                arena[outOff + i] = float(0.5 * x * (1.0 + erf));
                i = i + 1;
            }
        }

        // 阶段5：RoPE（Llama 真实约定：**逐头**、head_dim 内半配对）。xOff:[D,S]（行=heads*dh 特征，列=token），
        // cosOff/sinOff:[dh/2,S]（按 dim-pair 行 × 位置列；所有头共享同一张表）。
        // 对每头 h、dim-pair a∈[0,dh/2)：旋转行 (h*dh+a) 与 (h*dh+dh/2+a)：
        //   x' = x0*c - x1*s；x1' = x0*s + x1*c
        void rope(float[] arena, int xOff, int cosOff, int sinOff, int D, int S, int heads) {
            int dh = D / heads;
            int half = dh / 2;
            int h = 0;
            while (h < heads) {
                int s = 0;
                while (s < S) {
                    int a = 0;
                    while (a < half) {
                        int i0 = (h * dh + a) * S + s;
                        int i1 = (h * dh + half + a) * S + s;
                        double x0 = double(arena[xOff + i0]);
                        double x1 = double(arena[xOff + i1]);
                        double c = double(arena[cosOff + a * S + s]);
                        double si = double(arena[sinOff + a * S + s]);
                        arena[xOff + i0] = float(x0 * c - x1 * si);
                        arena[xOff + i1] = float(x0 * si + x1 * c);
                        a = a + 1;
                    }
                    s = s + 1;
                }
                h = h + 1;
            }
        }

        // 阶段5：KV cache 增量注意力（decode 每步一个 token）。qOff:[D]（当前 token 的 Q，D=heads*dh），
        // kcOff/vcOff:[kvD, stride]（历史 K/V 缓存，kvD=num_kv*dh，stride=缓存容量 Wmax，位置沿列），
        // 参与注意力的是前 len 列。outOff:[D]，scOff:[len]。
        // score[b,i] = Σ_dh q[b,dh]·kcache[kvh(b),dh,i] / √dh；softmax(i)；out[b,dh] = Σ_i p[i]·vcache[kvh(b),dh,i]。
        // GQA：kvh = b/groups。因果天然满足（缓存只有历史位置）。
        void attentionCached(float[] arena, int qOff, int kcOff, int vcOff, int outOff, int scOff,
                             int D, int stride, int len, int heads, int groups) {
            int dh = D / heads;
            double scale = 1.0 / Math.sqrt(double(dh));
            int b = 0;
            while (b < heads) {
                int kvh = b / groups;
                int i = 0;
                while (i < len) {
                    double sum = 0.0;
                    int d = 0;
                    while (d < dh) {
                        sum = sum + double(arena[qOff + (b * dh + d)]) * double(arena[kcOff + (kvh * dh + d) * stride + i]);
                        d = d + 1;
                    }
                    arena[scOff + i] = float(sum * scale);
                    i = i + 1;
                }
                // softmax over i
                float maxv = arena[scOff + 0];
                i = 1;
                while (i < len) {
                    if (arena[scOff + i] > maxv) maxv = arena[scOff + i];
                    i = i + 1;
                }
                double sumE = 0.0;
                i = 0;
                while (i < len) {
                    double e = Math.exp(double(arena[scOff + i]) - double(maxv));
                    arena[scOff + i] = float(e);
                    sumE = sumE + e;
                    i = i + 1;
                }
                i = 0;
                while (i < len) {
                    arena[scOff + i] = float(double(arena[scOff + i]) / sumE);
                    i = i + 1;
                }
                // out[b,dh] = Σ_i p[i]·vcache[kvh,dh,i]
                int d = 0;
                while (d < dh) {
                    double sum = 0.0;
                    int i2 = 0;
                    while (i2 < len) {
                        sum = sum + double(arena[scOff + i2]) * double(arena[vcOff + (kvh * dh + d) * stride + i2]);
                        i2 = i2 + 1;
                    }
                    arena[outOff + (b * dh + d)] = float(sum);
                    d = d + 1;
                }
                b = b + 1;
            }
        }

        void add(float[] arena, int aOff, int bOff, int outOff, int n, int doRelu) {
            int i = 0;
            if (doRelu == 1) {
                while (i < n) {
                    float v = arena[aOff + i] + arena[bOff + i];
                    if (v < 0.0f) v = 0.0f;
                    arena[outOff + i] = v;
                    i = i + 1;
                }
            } else {
                while (i < n) {
                    arena[outOff + i] = arena[aOff + i] + arena[bOff + i];
                    i = i + 1;
                }
            }
        }

        // ---- 训练：反向内核（阶段2，CPU；供图级反向 pass 用）----

        // 反向：y = W x + b；给定上游梯度 dY[outDim,batch]
        //   dW[o,i] = Σ_b dY[o,b]·x[i,b]；dX[i,b] = Σ_o dY[o,b]·W[o,i]；db[o] = Σ_b dY[o,b]
        void bwdDense(float[] arena,
                      int dyOff, int xOff, int inDim, int batch,
                      int wOff, int outDim,
                      int dxOff, int dwOff, int dbOff) {
            // db[o] = Σ_b dY[o,b]
            int i = 0;
            while (i < outDim) {
                float s = 0.0f;
                int k = 0;
                while (k < batch) { s = s + arena[dyOff + i * batch + k]; k = k + 1; }
                arena[dbOff + i] = s;
                i = i + 1;
            }
            // dW[o,i] = Σ_b dY[o,b]·x[i,b]
            i = 0;
            while (i < outDim) {
                int j = 0;
                while (j < inDim) {
                    float s = 0.0f;
                    int k = 0;
                    while (k < batch) { s = s + arena[dyOff + i * batch + k] * arena[xOff + j * batch + k]; k = k + 1; }
                    arena[dwOff + i * inDim + j] = s;
                    j = j + 1;
                }
                i = i + 1;
            }
            // dX[i,b] = Σ_o dY[o,b]·W[o,i]
            int j = 0;
            while (j < inDim) {
                int k = 0;
                while (k < batch) {
                    float s = 0.0f;
                    int o = 0;
                    while (o < outDim) { s = s + arena[dyOff + o * batch + k] * arena[wOff + o * inDim + j]; o = o + 1; }
                    arena[dxOff + j * batch + k] = s;
                    k = k + 1;
                }
                j = j + 1;
            }
        }

        // 反向：y = relu(x)；dX[i] = dY[i]·(x[i]>0)
        void bwdRelu(float[] arena, int dyOff, int xOff, int dxOff, int n) {
            int i = 0;
            while (i < n) {
                float x = arena[xOff + i];
                if (x > 0.0f) arena[dxOff + i] = arena[dyOff + i];
                else arena[dxOff + i] = 0.0f;
                i = i + 1;
            }
        }

        // 反向：y = sigmoid(x)；dX[i] = dY[i]·y[i]·(1-y[i])（用前向输出 y）
        void bwdSigmoid(float[] arena, int dyOff, int yOff, int dxOff, int n) {
            int i = 0;
            while (i < n) {
                float y = arena[yOff + i];
                arena[dxOff + i] = arena[dyOff + i] * y * (1.0f - y);
                i = i + 1;
            }
        }

        // 反向：y = a + b；dA = dY, dB = dY
        void bwdAdd(float[] arena, int dyOff, int daOff, int dbOff, int n) {
            int i = 0;
            while (i < n) {
                float d = arena[dyOff + i];
                arena[daOff + i] = d;
                arena[dbOff + i] = d;
                i = i + 1;
            }
        }

        // Softmax + CrossEntropy 合并（batch=cols；标签 one-hot [rows,cols]）
        // 前向：probs = softmax(logits)；loss[每样本] = -log(probs[label])
        // 反向：dlogit[r,b] = probs[r,b] - label[r,b]
        void softmaxCE(float[] arena, int logitOff, int labelOff, int rows, int cols,
                       int dlogitOff, int lossOff) {
            int b = 0;
            while (b < cols) {
                float maxv = arena[logitOff + 0 * cols + b];
                int r = 1;
                while (r < rows) {
                    float v = arena[logitOff + r * cols + b];
                    if (v > maxv) maxv = v;
                    r = r + 1;
                }
                float sum = 0.0f;
                r = 0;
                while (r < rows) {
                    float e = Math.exp(arena[logitOff + r * cols + b] - maxv);
                    arena[dlogitOff + r * cols + b] = e;   // 先存 exp
                    sum = sum + e;
                    r = r + 1;
                }
                float lossb = 0.0f;
                r = 0;
                while (r < rows) {
                    float p = arena[dlogitOff + r * cols + b] / sum;
                    arena[dlogitOff + r * cols + b] = p - arena[labelOff + r * cols + b];   // dlogit
                    if (arena[labelOff + r * cols + b] > 0.5f) {
                        lossb = 0.0f - Math.log(p);
                    }
                    r = r + 1;
                }
                arena[lossOff + b] = lossb;
                b = b + 1;
            }
        }

        // SGD 更新：W -= lr·grad（lr 由调用方传 double，内部转 float）
        // ---- 优化器（阶段5e）：SGD / 动量 / AdamW（weight decay 可选）----
        // SGD + L2：W -= lr*grad + decay*W（decay=lr*wd；wd=0 即纯 SGD，与旧版一致）
        void updateSGD(float[] arena, int wOff, int gradOff, int n, double lr, double decay) {
            int i = 0;
            while (i < n) {
                float g = arena[gradOff + i];
                float w = arena[wOff + i];
                arena[wOff + i] = w - float(decay) * w - float(lr) * g;
                i = i + 1;
            }
        }

        // 动量（经典，beta1=0.9 固定）：v = beta1*v + grad；W -= lr*v + decay*W
        void updateMom(float[] arena, int wOff, int gradOff, int vOff, int n, double lr, double decay) {
            int i = 0;
            while (i < n) {
                float g = arena[gradOff + i];
                float v = arena[vOff + i];
                float vn = 0.9f * v + g;
                arena[vOff + i] = vn;
                float w = arena[wOff + i];
                arena[wOff + i] = w - float(decay) * w - float(lr) * vn;
                i = i + 1;
            }
        }

        // AdamW（解耦权重衰减 + 偏差修正）：m=0.9m+0.1g；v=0.999v+0.001g²；
        // mhat=m/bc1；vhat=v/bc2；W -= decay*W + lr*mhat/(sqrt(vhat)+eps)，eps=1e-8。
        // bc1/bc2 = 1-β^t 由调用方 host 端预计算（Math.pow）。状态：m 在 mOff，v 在 mOff+n。
        void updateAdamW(float[] arena, int wOff, int gradOff, int mOff, int n, double lr, double decay,
                         double bc1, double bc2) {
            double eps = 1.0e-8;
            int i = 0;
            while (i < n) {
                float g = arena[gradOff + i];
                float m = arena[mOff + i];
                float v = arena[mOff + n + i];
                float mn = 0.9f * m + 0.1f * g;
                float vn = 0.999f * v + 0.001f * g * g;
                arena[mOff + i] = mn;
                arena[mOff + n + i] = vn;
                double mhat = double(mn) / bc1;
                double vhat = double(vn) / bc2;
                double w = double(arena[wOff + i]);
                arena[wOff + i] = float(w - double(lr) * mhat / (Math.sqrt(vhat) + eps) - double(decay) * w);
                i = i + 1;
            }
        }

        // Dice 损失（阶段4，分割）：L = 1 - (1/C)·Σ_c 2·Σ_s(p·y) / (Σp + Σy + eps)。
        // p,y: [rows=C 类别, cols=S 空间]，y 为 one-hot。
        // 反向：dp[c,s] = -(2/rows)·(y[c,s]·B_c - A_c)/B_c²（B_c=Σp+Σy+eps，A_c=Σp·y）。
        void diceLoss(float[] arena, int pOff, int yOff, int dpOff, int lossOff,
                      int rows, int cols, int wMode) {
            // 类权重（归一化，防 loss 尺度爆炸）：wMode=0 等权（w_c=1，W=rows →
            // wc=1/rows 与旧版逐位一致）；wMode=1 逆频率 w_c=1/(freq_c+0.001)、
            // wc=w_c/Σw——小前景类梯度上采样，缓解类不平衡（真实肝脏前景 ~5% 时防
            // 塌缩到全背景）。loss = 1 - Σ_c wc_c·Dice_c 有界。eps=1e-5（B 平滑）。
            double eps = 1.0e-5;
            double[] w = new double[32];
            double W = 0.0;
            int c = 0;
            while (c < rows) {
                double wc = 1.0;
                if (wMode == 1) {
                    double freq = 0.0;
                    int s = 0;
                    while (s < cols) { freq = freq + double(arena[yOff + c * cols + s]); s = s + 1; }
                    freq = freq / double(cols);
                    wc = 1.0 / (freq + 0.001);
                }
                w[c] = wc;
                W = W + wc;
                c = c + 1;
            }
            double sumLoss = 0.0;
            c = 0;
            while (c < rows) {
                double wc = w[c] / W;
                double sumP = 0.0;
                double sumY = 0.0;
                double sumPY = 0.0;
                int s = 0;
                while (s < cols) {
                    double p = arena[pOff + c * cols + s];
                    double y = arena[yOff + c * cols + s];
                    sumP = sumP + p;
                    sumY = sumY + y;
                    sumPY = sumPY + p * y;
                    s = s + 1;
                }
                double B = sumP + sumY + eps;
                double dice = 2.0 * sumPY / B;
                sumLoss = sumLoss + wc * dice;
                // 梯度（含权重；wMode=0 时 wc=1/rows 与旧版一致）
                double denom = wc * 2.0 / (B * B);
                s = 0;
                while (s < cols) {
                    double yv = arena[yOff + c * cols + s];
                    double g = 0.0 - denom * (yv * B - sumPY);
                    arena[dpOff + c * cols + s] = float(g);
                    s = s + 1;
                }
                c = c + 1;
            }
            arena[lossOff] = float(1.0 - sumLoss);
        }

        // Softmax 反向（阶段4d）：dProb → dLogit。dlogit[i] = p[i]·(dp[i] - Σ_j p[j]·dp[j])
        // （softmax 雅可比 J_ij = p_i(δ_ij - p_j) 的转置作用于 dp）
        void bwdSoftmax(float[] arena, int probOff, int dprobOff, int dlogitOff, int rows, int cols) {
            int b = 0;
            while (b < cols) {
                double inner = 0.0;
                int r = 0;
                while (r < rows) {
                    inner = inner + double(arena[probOff + r * cols + b]) * double(arena[dprobOff + r * cols + b]);
                    r = r + 1;
                }
                r = 0;
                while (r < rows) {
                    double p = arena[probOff + r * cols + b];
                    double dp = arena[dprobOff + r * cols + b];
                    arena[dlogitOff + r * cols + b] = float(p * (dp - inner));
                    r = r + 1;
                }
                b = b + 1;
            }
        }

        // ---- 训练：卷积/池化反向（阶段3，CPU）----

        // 反向：y = conv(x, w)；给定 dY[N,yC,yH,yW]
        //   db[oc] = Σ_{n,oy,ox} dY
        //   dW[oc,ic,ky,kx] = Σ_{n,oy,ox} dY·x[n,cIn,iy,ix]   (iy=oy*sh-pt+ky*dh, ix=ox*sw-pl+kx*dw 在界内)
        //   dX[n,cIn,iy,ix] = Σ_{oc,oy,ox} dY·w[oc,ic,ky,kx]  （同 iy/ix 约束）
        // 与 forward conv 同索引（7 重循环一次同时累加 dW/dX）。dW/dX 先清零再累加。
        void bwdConv(
            float[] arena,
            int dyOff, int xOff, int xN, int xC, int xH, int xW,
            int wOff,
            int dxOff, int dwOff, int dbOff,
            int yC, int yH, int yW,
            int kh, int kw, int sh, int sw, int pt, int pl,
            int dh, int dw, int group
        ) {
            int cpg = xC / group;
            int ocpg = yC / group;
            int wc = cpg * kh * kw;
            // 清 dW / dX
            int i = 0;
            while (i < yC * wc) { arena[dwOff + i] = 0.0f; i = i + 1; }
            i = 0;
            while (i < xN * xC * xH * xW) { arena[dxOff + i] = 0.0f; i = i + 1; }
            int oc = 0;
            // db[oc] = Σ_{n,oy,ox} dY[n,oc,oy,ox]（无偏置卷积 dbOff=-1 → 跳过）
            if (dbOff >= 0) {
                oc = 0;
                while (oc < yC) {
                    float s = 0.0f;
                    int n = 0;
                    while (n < xN) {
                        int oy = 0;
                        while (oy < yH) {
                            int ox = 0;
                            while (ox < yW) {
                                s = s + arena[dyOff + n * yC * yH * yW + oc * yH * yW + oy * yW + ox];
                                ox = ox + 1;
                            }
                            oy = oy + 1;
                        }
                        n = n + 1;
                    }
                    arena[dbOff + oc] = s;
                    oc = oc + 1;
                }
            }
            // dW + dX（一次 7 重循环）
            int n = 0;
            while (n < xN) {
                oc = 0;
                while (oc < yC) {
                    int g = oc / ocpg;
                    int oy = 0;
                    while (oy < yH) {
                        int ox = 0;
                        while (ox < yW) {
                            float dy = arena[dyOff + n * yC * yH * yW + oc * yH * yW + oy * yW + ox];
                            int ic = 0;
                            while (ic < cpg) {
                                int cIn = g * cpg + ic;
                                int ky = 0;
                                while (ky < kh) {
                                    int iy = oy * sh - pt + ky * dh;
                                    if (iy >= 0 && iy < xH) {
                                        int kx = 0;
                                        while (kx < kw) {
                                            int ix = ox * sw - pl + kx * dw;
                                            if (ix >= 0 && ix < xW) {
                                                float xv = arena[xOff + n * xC * xH * xW + cIn * xH * xW + iy * xW + ix];
                                                float wv = arena[wOff + oc * wc + ic * kh * kw + ky * kw + kx];
                                                arena[dwOff + oc * wc + ic * kh * kw + ky * kw + kx] = arena[dwOff + oc * wc + ic * kh * kw + ky * kw + kx] + dy * xv;
                                                arena[dxOff + n * xC * xH * xW + cIn * xH * xW + iy * xW + ix] = arena[dxOff + n * xC * xH * xW + cIn * xH * xW + iy * xW + ix] + dy * wv;
                                            }
                                            kx = kx + 1;
                                        }
                                    }
                                    ky = ky + 1;
                                }
                                ic = ic + 1;
                            }
                            ox = ox + 1;
                        }
                        oy = oy + 1;
                    }
                    oc = oc + 1;
                }
                n = n + 1;
            }
        }

        // 反向：y = maxpool(x)；给定 dY[N,C,yH,yW]。
        // 重算每个输出的 argmax 位置（与 forward 同扫描序），把 dY 路由到该位置。
        void bwdMaxPool(
            float[] arena,
            int dyOff, int xOff, int xN, int xC, int xH, int xW,
            int dxOff, int yH, int yW,
            int kh, int kw, int sh, int sw, int pt, int pl
        ) {
            int i = 0;
            while (i < xN * xC * xH * xW) { arena[dxOff + i] = 0.0f; i = i + 1; }
            int n = 0;
            while (n < xN) {
                int c = 0;
                while (c < xC) {
                    int oy = 0;
                    while (oy < yH) {
                        int ox = 0;
                        while (ox < yW) {
                            float best = 0.0f - 1.0e30f;
                            int biy = 0;
                            int bix = 0;
                            int ky = 0;
                            while (ky < kh) {
                                int iy = oy * sh - pt + ky;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        int ix = ox * sw - pl + kx;
                                        if (ix >= 0 && ix < xW) {
                                            float v = arena[xOff + n * xC * xH * xW + c * xH * xW + iy * xW + ix];
                                            if (v > best) { best = v; biy = iy; bix = ix; }
                                        }
                                        kx = kx + 1;
                                    }
                                }
                                ky = ky + 1;
                            }
                            float dy = arena[dyOff + n * xC * yH * yW + c * yH * yW + oy * yW + ox];
                            arena[dxOff + n * xC * xH * xW + c * xH * xW + biy * xW + bix] = arena[dxOff + n * xC * xH * xW + c * xH * xW + biy * xW + bix] + dy;
                            ox = ox + 1;
                        }
                        oy = oy + 1;
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // 反向：y = convTranspose(x, W)（group=1，权重 W[Cin,Cout,kh,kw] 同前向 ONNX 布局）。
        // 前向 gather：y[n,co,oh,ow] = Σ_{ci,ky,kx} x[n,ci,ih,iw]·W[ci,co,ky,kx]，
        //   其中 ih=(oh+pt-ky)/sh 整除且 0<=ih<xH（iw 同理）。output_padding 已含在 yH/yW。
        //   dW[ci,co,ky,kx] = Σ_{n,oh,ow} dy[n,co,oh,ow]·x[n,ci,ih,iw]（ih/iw 同前向整除界内）
        //   dX[n,ci,ih,iw] = Σ_{co,ky,kx} W[ci,co,ky,kx]·dy[n,co,oh,ow]（oh=ih*sh-pt+ky 界内）
        //   db[co] = Σ dy[n,co,:,:]（无偏置 dbOff=-1 → 跳过）
        void bwdConvTranspose(
            float[] arena,
            int dyOff, int xOff, int xN, int xC, int xH, int xW,
            int wOff,
            int dxOff, int dwOff, int dbOff,
            int yC, int yH, int yW,
            int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr
        ) {
            int wc = yC * kh * kw;   // dW 布局 [ci,co,ky,kx]：每个 ci 的块大小
            // 清 dW / dX
            int i = 0;
            while (i < xC * yC * kh * kw) { arena[dwOff + i] = 0.0f; i = i + 1; }
            i = 0;
            while (i < xN * xC * xH * xW) { arena[dxOff + i] = 0.0f; i = i + 1; }
            // db[co] = Σ dy
            if (dbOff >= 0) {
                int oc = 0;
                while (oc < yC) {
                    float s = 0.0f;
                    int n = 0;
                    while (n < xN) {
                        int oy = 0;
                        while (oy < yH) {
                            int ox = 0;
                            while (ox < yW) {
                                s = s + arena[dyOff + n * yC * yH * yW + oc * yH * yW + oy * yW + ox];
                                ox = ox + 1;
                            }
                            oy = oy + 1;
                        }
                        n = n + 1;
                    }
                    arena[dbOff + oc] = s;
                    oc = oc + 1;
                }
            }
            // dW（7 重循环：n,co,oh,ow,ci,ky,kx）
            int n = 0;
            while (n < xN) {
                int co = 0;
                while (co < yC) {
                    int oy = 0;
                    while (oy < yH) {
                        int ox = 0;
                        while (ox < yW) {
                            float dy = arena[dyOff + n * yC * yH * yW + co * yH * yW + oy * yW + ox];
                            int ci = 0;
                            while (ci < xC) {
                                int ky = 0;
                                while (ky < kh) {
                                    int inum = oy + pt - ky;
                                    if (inum >= 0 && inum % sh == 0) {
                                        int ih = inum / sh;
                                        if (ih >= 0 && ih < xH) {
                                            int kx = 0;
                                            while (kx < kw) {
                                                int wnum = ox + pl - kx;
                                                if (wnum >= 0 && wnum % sw == 0) {
                                                    int iw = wnum / sw;
                                                    if (iw >= 0 && iw < xW) {
                                                        float xv = arena[xOff + n * xC * xH * xW + ci * xH * xW + ih * xW + iw];
                                                        int wi = (ci * wc + co * kh * kw) + ky * kw + kx;
                                                        arena[dwOff + wi] = arena[dwOff + wi] + dy * xv;
                                                    }
                                                }
                                                kx = kx + 1;
                                            }
                                        }
                                    }
                                    ky = ky + 1;
                                }
                                ci = ci + 1;
                            }
                            ox = ox + 1;
                        }
                        oy = oy + 1;
                    }
                    co = co + 1;
                }
                n = n + 1;
            }
            // dX（7 重循环：n,ci,ih,iw,co,ky,kx）
            n = 0;
            while (n < xN) {
                int ci = 0;
                while (ci < xC) {
                    int ih = 0;
                    while (ih < xH) {
                        int iw = 0;
                        while (iw < xW) {
                            float s = 0.0f;
                            int co = 0;
                            while (co < yC) {
                                int ky = 0;
                                while (ky < kh) {
                                    int oh = ih * sh - pt + ky;
                                    if (oh >= 0 && oh < yH) {
                                        int kx = 0;
                                        while (kx < kw) {
                                            int ow = iw * sw - pl + kx;
                                            if (ow >= 0 && ow < yW) {
                                                float wv = arena[wOff + (ci * wc + co * kh * kw) + ky * kw + kx];
                                                s = s + wv * arena[dyOff + n * yC * yH * yW + co * yH * yW + oh * yW + ow];
                                            }
                                            kx = kx + 1;
                                        }
                                    }
                                    ky = ky + 1;
                                }
                                co = co + 1;
                            }
                            arena[dxOff + n * xC * xH * xW + ci * xH * xW + ih * xW + iw] = s;
                            iw = iw + 1;
                        }
                        ih = ih + 1;
                    }
                    ci = ci + 1;
                }
                n = n + 1;
            }
        }

        // ---- CNN 3D 反向（阶段4）：x[N,C,D,H,W]，y[N,yC,yD,yH,yW] ----

        // 反向：y = conv3d(x, w, b)。给定 dY[N,yC,yD,yH,yW] → dW（累加）、dX（累加）、db。
        // 参数与 conv3d 前向一致：非对称 padding（pdt/pdb、pt/pb、pl/pr）+ 膨胀（dd/dh/dw）。
        // 命名：dwOff = 权重梯度偏移；dw = 膨胀-宽（同 conv3d 前向）。
        void bwdConv3D(
            float[] arena,
            int dyOff, int xOff, int xN, int xC, int xD, int xH, int xW,
            int wOff,
            int dxOff, int dwOff, int dbOff,
            int yC, int yD, int yH, int yW,
            int kd, int kh, int kw,
            int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
            int dd, int dh, int dw, int group
        ) {
            int cpg = xC / group;
            int ocpg = yC / group;
            int wc = cpg * kd * kh * kw;
            // 清 dW / dX
            int i = 0;
            while (i < yC * wc) { arena[dwOff + i] = 0.0f; i = i + 1; }
            i = 0;
            while (i < xN * xC * xD * xH * xW) { arena[dxOff + i] = 0.0f; i = i + 1; }
            int oc = 0;
            // db[oc] = Σ_{n,oz,oy,ox} dY[n,oc,oz,oy,ox]（无偏置 dbOff=-1 → 跳过）
            if (dbOff >= 0) {
                oc = 0;
                while (oc < yC) {
                    float s = 0.0f;
                    int n = 0;
                    while (n < xN) {
                        int oz = 0;
                        while (oz < yD) {
                            int oy = 0;
                            while (oy < yH) {
                                int ox = 0;
                                while (ox < yW) {
                                    s = s + arena[dyOff + n * yC * yD * yH * yW + oc * yD * yH * yW + oz * yH * yW + oy * yW + ox];
                                    ox = ox + 1;
                                }
                                oy = oy + 1;
                            }
                            oz = oz + 1;
                        }
                        n = n + 1;
                    }
                    arena[dbOff + oc] = s;
                    oc = oc + 1;
                }
            }
            // dW + dX（一次 9 重循环：n,oc,oz,oy,ox,ic,kz,ky,kx）
            int n = 0;
            while (n < xN) {
                oc = 0;
                while (oc < yC) {
                    int g = oc / ocpg;
                    int oz = 0;
                    while (oz < yD) {
                        int oy = 0;
                        while (oy < yH) {
                            int ox = 0;
                            while (ox < yW) {
                                float dy = arena[dyOff + n * yC * yD * yH * yW + oc * yD * yH * yW + oz * yH * yW + oy * yW + ox];
                                int ic = 0;
                                while (ic < cpg) {
                                    int cIn = g * cpg + ic;
                                    int kz = 0;
                                    while (kz < kd) {
                                        int iz = oz * sd - pdt + kz * dd;
                                        if (iz >= 0 && iz < xD) {
                                            int ky = 0;
                                            while (ky < kh) {
                                                int iy = oy * sh - pt + ky * dh;
                                                if (iy >= 0 && iy < xH) {
                                                    int kx = 0;
                                                    while (kx < kw) {
                                                        int ix = ox * sw - pl + kx * dw;
                                                        if (ix >= 0 && ix < xW) {
                                                            float xv = arena[xOff + n * xC * xD * xH * xW + cIn * xD * xH * xW + iz * xH * xW + iy * xW + ix];
                                                            float wv = arena[wOff + oc * wc + ic * kd * kh * kw + kz * kh * kw + ky * kw + kx];
                                                            arena[dwOff + oc * wc + ic * kd * kh * kw + kz * kh * kw + ky * kw + kx] = arena[dwOff + oc * wc + ic * kd * kh * kw + kz * kh * kw + ky * kw + kx] + dy * xv;
                                                            arena[dxOff + n * xC * xD * xH * xW + cIn * xD * xH * xW + iz * xH * xW + iy * xW + ix] = arena[dxOff + n * xC * xD * xH * xW + cIn * xD * xH * xW + iz * xH * xW + iy * xW + ix] + dy * wv;
                                                        }
                                                        kx = kx + 1;
                                                    }
                                                }
                                                ky = ky + 1;
                                            }
                                        }
                                        kz = kz + 1;
                                    }
                                    ic = ic + 1;
                                }
                                ox = ox + 1;
                            }
                            oy = oy + 1;
                        }
                        oz = oz + 1;
                    }
                    oc = oc + 1;
                }
                n = n + 1;
            }
        }

        // 反向：y = maxpool3d(x)；给定 dY[N,C,yD,yH,yW]。
        // 重算每个输出的 argmax 位置（与 forward 同扫描序），把 dY 路由到该位置。
        void bwdMaxPool3D(
            float[] arena,
            int dyOff, int xOff, int xN, int xC, int xD, int xH, int xW,
            int dxOff, int yD, int yH, int yW,
            int kd, int kh, int kw,
            int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr
        ) {
            int i = 0;
            while (i < xN * xC * xD * xH * xW) { arena[dxOff + i] = 0.0f; i = i + 1; }
            int n = 0;
            while (n < xN) {
                int c = 0;
                while (c < xC) {
                    int oz = 0;
                    while (oz < yD) {
                        int oy = 0;
                        while (oy < yH) {
                            int ox = 0;
                            while (ox < yW) {
                                float best = 0.0f - 1.0e30f;
                                int biz = 0;
                                int biy = 0;
                                int bix = 0;
                                int kz = 0;
                                while (kz < kd) {
                                    int iz = oz * sd - pdt + kz;
                                    if (iz >= 0 && iz < xD) {
                                        int ky = 0;
                                        while (ky < kh) {
                                            int iy = oy * sh - pt + ky;
                                            if (iy >= 0 && iy < xH) {
                                                int kx = 0;
                                                while (kx < kw) {
                                                    int ix = ox * sw - pl + kx;
                                                    if (ix >= 0 && ix < xW) {
                                                        float v = arena[xOff + n * xC * xD * xH * xW + c * xD * xH * xW + iz * xH * xW + iy * xW + ix];
                                                        if (v > best) { best = v; biz = iz; biy = iy; bix = ix; }
                                                    }
                                                    kx = kx + 1;
                                                }
                                            }
                                            ky = ky + 1;
                                        }
                                    }
                                    kz = kz + 1;
                                }
                                float dy = arena[dyOff + n * xC * yD * yH * yW + c * yD * yH * yW + oz * yH * yW + oy * yW + ox];
                                arena[dxOff + n * xC * xD * xH * xW + c * xD * xH * xW + biz * xH * xW + biy * xW + bix] = arena[dxOff + n * xC * xD * xH * xW + c * xD * xH * xW + biz * xH * xW + biy * xW + bix] + dy;
                                ox = ox + 1;
                            }
                            oy = oy + 1;
                        }
                        oz = oz + 1;
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // 反向：y = avgpool3d(x)；给定 dY[N,C,yD,yH,yW]。
        // 前向 y[o] = Σ_{有效 k} x[i(k)] / div，div = cnt（cip=0）或 kd*kh*kw（cip=1）。
        // 反向：对每个输出 o，其覆盖的每个有效输入 i(k) 累加 dY[o]/div(o)。
        void bwdAvgPool3D(
            float[] arena,
            int dyOff, int xOff, int xN, int xC, int xD, int xH, int xW,
            int dxOff, int yD, int yH, int yW,
            int kd, int kh, int kw,
            int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
            int cip
        ) {
            int i = 0;
            while (i < xN * xC * xD * xH * xW) { arena[dxOff + i] = 0.0f; i = i + 1; }
            int n = 0;
            while (n < xN) {
                int c = 0;
                while (c < xC) {
                    int oz = 0;
                    while (oz < yD) {
                        int oy = 0;
                        while (oy < yH) {
                            int ox = 0;
                            while (ox < yW) {
                                // 该窗口有效元素数（与 forward 同公式）
                                int cnt = 0;
                                int kz = 0;
                                while (kz < kd) {
                                    int iz = oz * sd - pdt + kz;
                                    if (iz >= 0 && iz < xD) {
                                        int ky = 0;
                                        while (ky < kh) {
                                            int iy = oy * sh - pt + ky;
                                            if (iy >= 0 && iy < xH) {
                                                int kx = 0;
                                                while (kx < kw) {
                                                    int ix = ox * sw - pl + kx;
                                                    if (ix >= 0 && ix < xW) cnt = cnt + 1;
                                                    kx = kx + 1;
                                                }
                                            }
                                            ky = ky + 1;
                                        }
                                    }
                                    kz = kz + 1;
                                }
                                int div = cnt;
                                if (cip == 1) div = kd * kh * kw;
                                if (div < 1) div = 1;
                                float dy = arena[dyOff + n * xC * yD * yH * yW + c * yD * yH * yW + oz * yH * yW + oy * yW + ox];
                                float d = float(dy) / float(div);
                                kz = 0;
                                while (kz < kd) {
                                    int iz = oz * sd - pdt + kz;
                                    if (iz >= 0 && iz < xD) {
                                        int ky = 0;
                                        while (ky < kh) {
                                            int iy = oy * sh - pt + ky;
                                            if (iy >= 0 && iy < xH) {
                                                int kx = 0;
                                                while (kx < kw) {
                                                    int ix = ox * sw - pl + kx;
                                                    if (ix >= 0 && ix < xW) {
                                                        arena[dxOff + n * xC * xD * xH * xW + c * xD * xH * xW + iz * xH * xW + iy * xW + ix] = arena[dxOff + n * xC * xD * xH * xW + c * xD * xH * xW + iz * xH * xW + iy * xW + ix] + d;
                                                    }
                                                    kx = kx + 1;
                                                }
                                            }
                                            ky = ky + 1;
                                        }
                                    }
                                    kz = kz + 1;
                                }
                                ox = ox + 1;
                            }
                            oy = oy + 1;
                        }
                        oz = oz + 1;
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // ---- CNN：4D NCHW 行优先（flat = N*C*H*W）----

        // 卷积（支持 group、strides、pads、dilations）
        // x: [N, C, H, W]，w: [yC, C/group, kh, kw]，b: [yC]，y: [N, yC, yH, yW]
        void conv(
            float[] arena,
            int xOff, int xN, int xC, int xH, int xW,
            int wOff, int bOff,
            int yOff, int yC, int yH, int yW,
            int kh, int kw,
            int sh, int sw, int pt, int pb, int pl, int pr,
            int dh, int dw, int group
        ) {
            int cpg = xC / group;          // 每组的输入通道
            int ocpg = yC / group;          // 每组的输出通道
            int wc = cpg * kh * kw;         // 每个输出通道的权重数
            int n = 0;
            while (n < xN) {
                // 空间并行：每线程一个 (oy,ox) 遍历全部输出通道（输入窗口复用，参照 3D conv）
                @parallel for (int p = 0; p < yH * yW; p = p + 1) {
                    int oy = p / yW;
                    int ox = p % yW;
                    int oc = 0;
                    while (oc < yC) {
                        int g = oc / ocpg;
                        float sum = 0.0f;
                        if (bOff >= 0) sum = arena[bOff + oc];   // 无偏置卷积（bOff=-1）
                        int ic = 0;
                        while (ic < cpg) {
                            int cIn = g * cpg + ic;
                            int ky = 0;
                            while (ky < kh) {
                                int iy = oy * sh - pt + ky * dh;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        int ix = ox * sw - pl + kx * dw;
                                        if (ix >= 0 && ix < xW) {
                                            float xv = arena[xOff + n * xC * xH * xW + cIn * xH * xW + iy * xW + ix];
                                            float wv = arena[wOff + oc * wc + ic * kh * kw + ky * kw + kx];
                                            sum = sum + xv * wv;
                                        }
                                        kx = kx + 1;
                                    }
                                }
                                ky = ky + 1;
                            }
                            ic = ic + 1;
                        }
                        arena[yOff + n * yC * yH * yW + oc * yH * yW + oy * yW + ox] = sum;
                        oc = oc + 1;
                    }
                }
                n = n + 1;
            }
        }

        // 融合 Conv+残差Add（P4-2/3，opKind=73）：与 conv 同，输出直接加残差张量（同形状同布局），可接 doRelu。
        void convResidual(
            float[] arena,
            int xOff, int xN, int xC, int xH, int xW,
            int wOff, int bOff,
            int yOff, int yC, int yH, int yW,
            int rOff,
            int kh, int kw,
            int sh, int sw, int pt, int pb, int pl, int pr,
            int dh, int dw, int group, int doRelu
        ) {
            int cpg = xC / group;
            int ocpg = yC / group;
            int wc = cpg * kh * kw;
            int n = 0;
            while (n < xN) {
                @parallel for (int p = 0; p < yH * yW; p = p + 1) {
                    int oy = p / yW;
                    int ox = p % yW;
                    int oc = 0;
                    while (oc < yC) {
                        int g = oc / ocpg;
                        float sum = 0.0f;
                        if (bOff >= 0) sum = arena[bOff + oc];
                        int ic = 0;
                        while (ic < cpg) {
                            int cIn = g * cpg + ic;
                            int ky = 0;
                            while (ky < kh) {
                                int iy = oy * sh - pt + ky * dh;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        int ix = ox * sw - pl + kx * dw;
                                        if (ix >= 0 && ix < xW) {
                                            float xv = arena[xOff + n * xC * xH * xW + cIn * xH * xW + iy * xW + ix];
                                            float wv = arena[wOff + oc * wc + ic * kh * kw + ky * kw + kx];
                                            sum = sum + xv * wv;
                                        }
                                        kx = kx + 1;
                                    }
                                }
                                ky = ky + 1;
                            }
                            ic = ic + 1;
                        }
                        // 残差与输出同形状同布局：同内偏移相加；P4-3：可接 doRelu
                        int yoff = yOff + n * yC * yH * yW + oc * yH * yW + oy * yW + ox;
                        float v = sum + arena[rOff + (yoff - yOff)];
                        if (doRelu == 1 && v < 0.0f) v = 0.0f;
                        arena[yoff] = v;
                        oc = oc + 1;
                    }
                }
                n = n + 1;
            }
        }

        // ConvTranspose（转置卷积/反卷积，group=1）：x[N,Cin,H,W] → y[N,Cout,yH,yW]
        // 权重 W[Cin,Cout,kh,kw]（ONNX 布局，直接拷贝，不转置）。
        // gather 公式：y[n,co,oh,ow] = Σ_{ci,ky,kx} x[n,ci,ih,iw] * W[ci,co,ky,kx]
        //   其中 ih=(oh+pt-ky)/sh 需整除且 0<=ih<H（iw 同理）。output_padding 已含在 yH/yW。
        void convTranspose(
            float[] arena,
            int xOff, int xN, int xC, int xH, int xW,
            int wOff, int bOff,
            int yOff, int yC, int yH, int yW,
            int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr
        ) {
            int n = 0;
            while (n < xN) {
                int oc = 0;
                while (oc < yC) {
                    int oy = 0;
                    while (oy < yH) {
                        int ox = 0;
                        while (ox < yW) {
                            float sum = 0.0f;
                            if (bOff >= 0) sum = arena[bOff + oc];
                            int ic = 0;
                            while (ic < xC) {
                                int ky = 0;
                                while (ky < kh) {
                                    int inum = oy + pt - ky;
                                    if (inum >= 0 && inum % sh == 0) {
                                        int iy = inum / sh;
                                        if (iy >= 0 && iy < xH) {
                                            int kx = 0;
                                            while (kx < kw) {
                                                int wnum = ox + pl - kx;
                                                if (wnum >= 0 && wnum % sw == 0) {
                                                    int iw = wnum / sw;
                                                    if (iw >= 0 && iw < xW) {
                                                        float xv = arena[xOff + n * xC * xH * xW + ic * xH * xW + iy * xW + iw];
                                                        float wv = arena[wOff + ((ic * yC + oc) * kh + ky) * kw + kx];
                                                        sum = sum + xv * wv;
                                                    }
                                                }
                                                kx = kx + 1;
                                            }
                                        }
                                    }
                                    ky = ky + 1;
                                }
                                ic = ic + 1;
                            }
                            arena[yOff + n * yC * yH * yW + oc * yH * yW + oy * yW + ox] = sum;
                            ox = ox + 1;
                        }
                        oy = oy + 1;
                    }
                    oc = oc + 1;
                }
                n = n + 1;
            }
        }

        // Conv3D：x[N,Cin,D,H,W] → y[N,Cout,yD,yH,yW]（3D 扩展，权重 [Cout,Cin,kd,kh,kw]）
        // 参数：pdt/pdb/pt/pb/pl/pr = 6 个 pad（d/w/h 各 begin/end），dd/dh/dw = 膨胀。
        void conv3d(
            float[] arena,
            int xOff, int xN, int xC, int xD, int xH, int xW,
            int wOff, int bOff,
            int yOff, int yC, int yD, int yH, int yW,
            int kd, int kh, int kw,
            int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
            int dd, int dh, int dw, int group
        ) {
            int cpg = xC / group;
            int ocpg = yC / group;
            int wc = cpg * kd * kh * kw;
            int n = 0;
            while (n < xN) {
                // 中间段 ox：ix=ox*sw-pl+kx*dw 对全部 kx 都落在 [0,xW) 内（无边界判断）
                int oxL = 0;
                if (pl > 0) oxL = (pl + sw - 1) / sw;
                int numer = xW + pl - (kw - 1) * dw;
                int oxR = 0;
                if (numer > 0) oxR = (numer + sw - 1) / sw;
                if (oxR > yW) oxR = yW;
                // 空间并行（@parallel 在 (oz,oy) 上）：每线程固定空间行遍历全部 oc，
                // 输入窗口在 oc 循环内复用（LLVM LICM），避免 oc 并行时输入从内存重读 yC 倍
                @parallel for (int p = 0; p < yD * yH; p = p + 1) {
                    int oz = p / yH;
                    int oy = p % yH;
                    int ox = 0;
                    while (ox < yW) {
                        if (ox < oxL || ox + 3 >= oxR) {
                            // 边界：标量，遍历 oc
                            int oc = 0;
                            while (oc < yC) {
                                int g = oc / ocpg;
                                float sum = 0.0f;
                                if (bOff >= 0) sum = arena[bOff + oc];
                                int ic = 0;
                                while (ic < cpg) {
                                    int cIn = g * cpg + ic;
                                    int kz = 0;
                                    while (kz < kd) {
                                        int iz = oz * sd - pdt + kz * dd;
                                        if (iz >= 0 && iz < xD) {
                                            int ky = 0;
                                            while (ky < kh) {
                                                int iy = oy * sh - pt + ky * dh;
                                                if (iy >= 0 && iy < xH) {
                                                    int kx = 0;
                                                    while (kx < kw) {
                                                        int ix = ox * sw - pl + kx * dw;
                                                        if (ix >= 0 && ix < xW) {
                                                            float xv = arena[xOff + n * xC * xD * xH * xW + cIn * xD * xH * xW + iz * xH * xW + iy * xW + ix];
                                                            float wv = arena[wOff + oc * wc + ic * kd * kh * kw + kz * kh * kw + ky * kw + kx];
                                                            sum = sum + xv * wv;
                                                        }
                                                        kx = kx + 1;
                                                    }
                                                }
                                                ky = ky + 1;
                                            }
                                        }
                                        kz = kz + 1;
                                    }
                                    ic = ic + 1;
                                }
                                arena[yOff + n * yC * yD * yH * yW + oc * yD * yH * yW + oz * yH * yW + oy * yW + ox] = sum;
                                oc = oc + 1;
                            }
                            ox = ox + 1;
                        } else {
                            // 中间：4-wide（无 ix if），遍历 oc；输入窗口跨 oc 复用（L1/LICM）
                            int oc = 0;
                            while (oc < yC) {
                                int g = oc / ocpg;
                                float s0 = 0.0f;
                                float s1 = 0.0f;
                                float s2 = 0.0f;
                                float s3 = 0.0f;
                                if (bOff >= 0) { s0 = arena[bOff + oc]; s1 = arena[bOff + oc]; s2 = arena[bOff + oc]; s3 = arena[bOff + oc]; }
                                int ic = 0;
                                while (ic < cpg) {
                                    int cIn = g * cpg + ic;
                                    int kz = 0;
                                    while (kz < kd) {
                                        int iz = oz * sd - pdt + kz * dd;
                                        if (iz >= 0 && iz < xD) {
                                            int ky = 0;
                                            while (ky < kh) {
                                                int iy = oy * sh - pt + ky * dh;
                                                if (iy >= 0 && iy < xH) {
                                                    int kx = 0;
                                                    while (kx < kw) {
                                                        float wv = arena[wOff + oc * wc + ic * kd * kh * kw + kz * kh * kw + ky * kw + kx];
                                                        int xb = xOff + n * xC * xD * xH * xW + cIn * xD * xH * xW + iz * xH * xW + iy * xW + ox * sw - pl + kx * dw;
                                                        s0 = s0 + wv * arena[xb + 0];
                                                        s1 = s1 + wv * arena[xb + sw];
                                                        s2 = s2 + wv * arena[xb + 2 * sw];
                                                        s3 = s3 + wv * arena[xb + 3 * sw];
                                                        kx = kx + 1;
                                                    }
                                                }
                                                ky = ky + 1;
                                            }
                                        }
                                        kz = kz + 1;
                                    }
                                    ic = ic + 1;
                                }
                                int ob = yOff + n * yC * yD * yH * yW + oc * yD * yH * yW + oz * yH * yW + oy * yW + ox;
                                arena[ob + 0] = s0;
                                arena[ob + 1] = s1;
                                arena[ob + 2] = s2;
                                arena[ob + 3] = s3;
                                oc = oc + 1;
                            }
                            ox = ox + 4;
                        }
                    }
                }
                n = n + 1;
            }
        }

        // MaxPool3D：x[N,C,D,H,W] → y[N,C,yD,yH,yW]
        void maxpool3d(
            float[] arena,
            int xOff, int xN, int xC, int xD, int xH, int xW,
            int yOff, int yD, int yH, int yW,
            int kd, int kh, int kw,
            int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr
        ) {
            int n = 0;
            while (n < xN) {
                @parallel for (int c = 0; c < xC; c = c + 1) {
                    int oz = 0;
                    while (oz < yD) {
                        int oy = 0;
                        while (oy < yH) {
                            int ox = 0;
                            while (ox < yW) {
                                float best = 0.0f - 1.0e30f;
                                int kz = 0;
                                while (kz < kd) {
                                    int iz = oz * sd - pdt + kz;
                                    if (iz >= 0 && iz < xD) {
                                        int ky = 0;
                                        while (ky < kh) {
                                            int iy = oy * sh - pt + ky;
                                            if (iy >= 0 && iy < xH) {
                                                int kx = 0;
                                                while (kx < kw) {
                                                    int ix = ox * sw - pl + kx;
                                                    if (ix >= 0 && ix < xW) {
                                                        float v = arena[xOff + n * xC * xD * xH * xW + c * xD * xH * xW + iz * xH * xW + iy * xW + ix];
                                                        if (v > best) best = v;
                                                    }
                                                    kx = kx + 1;
                                                }
                                            }
                                            ky = ky + 1;
                                        }
                                    }
                                    kz = kz + 1;
                                }
                                arena[yOff + n * xC * yD * yH * yW + c * yD * yH * yW + oz * yH * yW + oy * yW + ox] = best;
                                ox = ox + 1;
                            }
                            oy = oy + 1;
                        }
                        oz = oz + 1;
                    }
                }
                n = n + 1;
            }
        }

        // AveragePool3D：x[N,C,D,H,W] → y[N,C,yD,yH,yW]（3D 扩展，支持各向异性核）
        // cip = count_include_pad（0 = 排除 padding，1 = 除以核体积）
        void avgpool3d(
            float[] arena,
            int xOff, int xN, int xC, int xD, int xH, int xW,
            int yOff, int yD, int yH, int yW,
            int kd, int kh, int kw,
            int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
            int cip
        ) {
            int n = 0;
            while (n < xN) {
                @parallel for (int c = 0; c < xC; c = c + 1) {
                    int oz = 0;
                    while (oz < yD) {
                        int oy = 0;
                        while (oy < yH) {
                            int ox = 0;
                            while (ox < yW) {
                                double sum = 0.0;
                                int cnt = 0;
                                int kz = 0;
                                while (kz < kd) {
                                    int iz = oz * sd - pdt + kz;
                                    if (iz >= 0 && iz < xD) {
                                        int ky = 0;
                                        while (ky < kh) {
                                            int iy = oy * sh - pt + ky;
                                            if (iy >= 0 && iy < xH) {
                                                int kx = 0;
                                                while (kx < kw) {
                                                    int ix = ox * sw - pl + kx;
                                                    if (ix >= 0 && ix < xW) {
                                                        sum = sum + arena[xOff + n * xC * xD * xH * xW + c * xD * xH * xW + iz * xH * xW + iy * xW + ix];
                                                        cnt = cnt + 1;
                                                    }
                                                    kx = kx + 1;
                                                }
                                            }
                                            ky = ky + 1;
                                        }
                                    }
                                    kz = kz + 1;
                                }
                                int div = cnt;
                                if (cip == 1) div = kd * kh * kw;
                                if (div < 1) div = 1;
                                arena[yOff + n * xC * yD * yH * yW + c * yD * yH * yW + oz * yH * yW + oy * yW + ox] = float(sum / div);
                                ox = ox + 1;
                            }
                            oy = oy + 1;
                        }
                        oz = oz + 1;
                    }
                }
                n = n + 1;
            }
        }

        // 融合 Conv+ReLU（G1）：卷积输出直接过 ReLU，不写回中间张量。
        // 参数与 conv 相同，唯一区别：y 处写 max(sum, 0)。
        void convRelu(
            float[] arena,
            int xOff, int xN, int xC, int xH, int xW,
            int wOff, int bOff,
            int yOff, int yC, int yH, int yW,
            int kh, int kw,
            int sh, int sw, int pt, int pb, int pl, int pr,
            int dh, int dw, int group
        ) {
            int cpg = xC / group;
            int ocpg = yC / group;
            int wc = cpg * kh * kw;
            int n = 0;
            while (n < xN) {
                int oc = 0;
                while (oc < yC) {
                    int g = oc / ocpg;
                    int oy = 0;
                    while (oy < yH) {
                        int ox = 0;
                        while (ox < yW) {
                            float sum = 0.0f;
                            if (bOff >= 0) sum = arena[bOff + oc];   // 无偏置卷积（bOff=-1）
                            int ic = 0;
                            while (ic < cpg) {
                                int cIn = g * cpg + ic;
                                int ky = 0;
                                while (ky < kh) {
                                    int iy = oy * sh - pt + ky * dh;
                                    if (iy >= 0 && iy < xH) {
                                        int kx = 0;
                                        while (kx < kw) {
                                            int ix = ox * sw - pl + kx * dw;
                                            if (ix >= 0 && ix < xW) {
                                                float xv = arena[xOff + n * xC * xH * xW + cIn * xH * xW + iy * xW + ix];
                                                float wv = arena[wOff + oc * wc + ic * kh * kw + ky * kw + kx];
                                                sum = sum + xv * wv;
                                            }
                                            kx = kx + 1;
                                        }
                                    }
                                    ky = ky + 1;
                                }
                                ic = ic + 1;
                            }
                            if (sum > 0.0f) arena[yOff + n * yC * yH * yW + oc * yH * yW + oy * yW + ox] = sum;
                            else arena[yOff + n * yC * yH * yW + oc * yH * yW + oy * yW + ox] = 0.0f;
                            ox = ox + 1;
                        }
                        oy = oy + 1;
                    }
                    oc = oc + 1;
                }
                n = n + 1;
            }
        }

        // 最大池化：x: [N,C,H,W] → y: [N,C,yH,yW]
        void maxpool(
            float[] arena,
            int xOff, int xN, int xC, int xH, int xW,
            int yOff, int yH, int yW,
            int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr
        ) {
            int n = 0;
            while (n < xN) {
                int c = 0;
                while (c < xC) {
                    int oy = 0;
                    while (oy < yH) {
                        int ox = 0;
                        while (ox < yW) {
                            float best = 0.0f - 1.0e30f;
                            int ky = 0;
                            while (ky < kh) {
                                int iy = oy * sh - pt + ky;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        int ix = ox * sw - pl + kx;
                                        if (ix >= 0 && ix < xW) {
                                            float v = arena[xOff + n * xC * xH * xW + c * xH * xW + iy * xW + ix];
                                            if (v > best) best = v;
                                        }
                                        kx = kx + 1;
                                    }
                                }
                                ky = ky + 1;
                            }
                            arena[yOff + n * xC * yH * yW + c * yH * yW + oy * yW + ox] = best;
                            ox = ox + 1;
                        }
                        oy = oy + 1;
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // AveragePool：x: [N,C,H,W] → y: [N,C,yH,yW]
        // yH/yW 由 graph 按 (H+padT+padB-kh)/sh+1 计算；cip = count_include_pad：
        // 0（默认）= 除数只算窗口内在界元素（ONNX 默认），1 = 除数为 kh*kw（含 pad，pad 贡献 0）。
        // 秩无关：2D 直接用 (N,C,H,W)；3D 由调用方按 (N,C,DH,DW) 展开（D 维并入 C 或拆层）。
        void avgpool(
            float[] arena,
            int xOff, int xN, int xC, int xH, int xW,
            int yOff, int yH, int yW,
            int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr, int cip
        ) {
            int n = 0;
            while (n < xN) {
                int c = 0;
                while (c < xC) {
                    int oy = 0;
                    while (oy < yH) {
                        int ox = 0;
                        while (ox < yW) {
                            double sum = 0.0;
                            int cnt = 0;
                            int ky = 0;
                            while (ky < kh) {
                                int iy = oy * sh - pt + ky;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        int ix = ox * sw - pl + kx;
                                        if (ix >= 0 && ix < xW) {
                                            sum = sum + arena[xOff + n * xC * xH * xW + c * xH * xW + iy * xW + ix];
                                            cnt = cnt + 1;
                                        }
                                        kx = kx + 1;
                                    }
                                }
                                ky = ky + 1;
                            }
                            if (cip == 1) cnt = kh * kw;
                            if (cnt > 0) arena[yOff + n * xC * yH * yW + c * yH * yW + oy * yW + ox] = float(sum / cnt);
                            else arena[yOff + n * xC * yH * yW + c * yH * yW + oy * yW + ox] = 0.0f;
                            ox = ox + 1;
                        }
                        oy = oy + 1;
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // Pad：constant/reflect/edge（ONNX Pad opset11+；pads = [N,C,H,W] 各轴 begin/end）
        // mode: 0=constant, 1=reflect, 2=edge。cval 仅 constant 用（float 位型经宿主解码为 double）。
        void pad(
            float[] arena,
            int xOff, int xN, int xC, int xH, int xW,
            int yOff, int yN, int yC, int yH, int yW,
            int pnB, int pcB, int phB, int pwB, int pnE, int pcE, int phE, int pwE,
            int mode, double cval
        ) {
            int n = 0;
            while (n < yN) {
                int c = 0;
                while (c < yC) {
                    int h = 0;
                    while (h < yH) {
                        int w = 0;
                        while (w < yW) {
                            int sn = n - pnB;
                            int sc = c - pcB;
                            int sh = h - phB;
                            int sw = w - pwB;
                            int inb = 1;
                            if (sn < 0 || sn >= xN) inb = 0;
                            if (sc < 0 || sc >= xC) inb = 0;
                            if (sh < 0 || sh >= xH) inb = 0;
                            if (sw < 0 || sw >= xW) inb = 0;
                            float v = 0.0f;
                            if (inb == 1) {
                                v = arena[xOff + ((sn * xC + sc) * xH + sh) * xW + sw];
                            } else if (mode == 1) {
                                if (sn < 0) sn = 0 - sn;
                                if (sc < 0) sc = 0 - sc;
                                if (sh < 0) sh = 0 - sh;
                                if (sw < 0) sw = 0 - sw;
                                if (sn >= xN) sn = 2 * (xN - 1) - sn;
                                if (sc >= xC) sc = 2 * (xC - 1) - sc;
                                if (sh >= xH) sh = 2 * (xH - 1) - sh;
                                if (sw >= xW) sw = 2 * (xW - 1) - sw;
                                v = arena[xOff + ((sn * xC + sc) * xH + sh) * xW + sw];
                            } else if (mode == 2) {
                                if (sn < 0) sn = 0;
                                if (sc < 0) sc = 0;
                                if (sh < 0) sh = 0;
                                if (sw < 0) sw = 0;
                                if (sn >= xN) sn = xN - 1;
                                if (sc >= xC) sc = xC - 1;
                                if (sh >= xH) sh = xH - 1;
                                if (sw >= xW) sw = xW - 1;
                                v = arena[xOff + ((sn * xC + sc) * xH + sh) * xW + sw];
                            } else {
                                v = float(cval);
                            }
                            arena[yOff + ((n * yC + c) * yH + h) * yW + w] = v;
                            w = w + 1;
                        }
                        h = h + 1;
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // Pad3D：x[N,C,D,H,W] → y（5D，10 个 pad 各维 begin/end）
        // mode：0 = constant，1 = reflect，2 = edge
        void pad3d(
            float[] arena,
            int xOff, int xN, int xC, int xD, int xH, int xW,
            int yOff, int yN, int yC, int yD, int yH, int yW,
            int pnB, int pnE, int pcB, int pcE, int pdB, int pdE, int phB, int phE, int pwB, int pwE,
            int mode, double cval
        ) {
            int n = 0;
            while (n < yN) {
                int c = 0;
                while (c < yC) {
                    int d = 0;
                    while (d < yD) {
                        int h = 0;
                        while (h < yH) {
                            int w = 0;
                            while (w < yW) {
                                int sn = n - pnB;
                                int sc = c - pcB;
                                int sd = d - pdB;
                                int sh = h - phB;
                                int sw = w - pwB;
                                int inb = 1;
                                if (sn < 0 || sn >= xN) inb = 0;
                                if (sc < 0 || sc >= xC) inb = 0;
                                if (sd < 0 || sd >= xD) inb = 0;
                                if (sh < 0 || sh >= xH) inb = 0;
                                if (sw < 0 || sw >= xW) inb = 0;
                                float v = 0.0f;
                                if (inb == 1) {
                                    v = arena[xOff + (((sn * xC + sc) * xD + sd) * xH + sh) * xW + sw];
                                } else if (mode == 1) {
                                    if (sn < 0) sn = 0 - sn;
                                    if (sc < 0) sc = 0 - sc;
                                    if (sd < 0) sd = 0 - sd;
                                    if (sh < 0) sh = 0 - sh;
                                    if (sw < 0) sw = 0 - sw;
                                    if (sn >= xN) sn = 2 * (xN - 1) - sn;
                                    if (sc >= xC) sc = 2 * (xC - 1) - sc;
                                    if (sd >= xD) sd = 2 * (xD - 1) - sd;
                                    if (sh >= xH) sh = 2 * (xH - 1) - sh;
                                    if (sw >= xW) sw = 2 * (xW - 1) - sw;
                                    v = arena[xOff + (((sn * xC + sc) * xD + sd) * xH + sh) * xW + sw];
                                } else if (mode == 2) {
                                    if (sn < 0) sn = 0;
                                    if (sc < 0) sc = 0;
                                    if (sd < 0) sd = 0;
                                    if (sh < 0) sh = 0;
                                    if (sw < 0) sw = 0;
                                    if (sn >= xN) sn = xN - 1;
                                    if (sc >= xC) sc = xC - 1;
                                    if (sd >= xD) sd = xD - 1;
                                    if (sh >= xH) sh = xH - 1;
                                    if (sw >= xW) sw = xW - 1;
                                    v = arena[xOff + (((sn * xC + sc) * xD + sd) * xH + sh) * xW + sw];
                                } else {
                                    v = float(cval);
                                }
                                arena[yOff + (((n * yC + c) * yD + d) * yH + h) * yW + w] = v;
                                w = w + 1;
                            }
                            h = h + 1;
                        }
                        d = d + 1;
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // 全局平均池化：x: [N,C,H,W] → y: [N,C,1,1]
        void gapool(float[] arena, int xOff, int xN, int xC, int xH, int xW, int yOff) {
            int n = 0;
            while (n < xN) {
                int c = 0;
                while (c < xC) {
                    float sum = 0.0f;
                    int i = 0;
                    while (i < xH * xW) {
                        sum = sum + arena[xOff + n * xC * xH * xW + c * xH * xW + i];
                        i = i + 1;
                    }
                    arena[yOff + n * xC + c] = sum / float(xH * xW);
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // Flatten：数据已连续，按 flat 拷贝
        void flatten(float[] arena, int inOff, int outOff, int n) {
            int i = 0;
            while (i < n) {
                arena[outOff + i] = arena[inOff + i];
                i = i + 1;
            }
        }

        // ---- G2：NHWC 布局（x:[N,H,W,C] 行优先）----

        // NCHW→NHWC 转置：x:[N,C,H,W] → y:[N,H,W,C]
        void transposeNCHW2NHWC(float[] arena, int xOff, int xN, int xC, int xH, int xW, int yOff) {
            int n = 0;
            while (n < xN) {
                int c = 0;
                while (c < xC) {
                    int h = 0;
                    while (h < xH) {
                        int w = 0;
                        while (w < xW) {
                            arena[yOff + ((n * xH + h) * xW + w) * xC + c] = arena[xOff + ((n * xC + c) * xH + h) * xW + w];
                            w = w + 1;
                        }
                        h = h + 1;
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // NHWC 卷积：x:[N,H,W,Cin]，w:[Cout,KH,KW,Cin]，b:[Cout]，y:[N,Hout,Wout,Cout]
        void convNHWC(
            float[] arena,
            int xOff, int xN, int xH, int xW, int xC,
            int wOff, int bOff,
            int yOff, int yH, int yW, int yC,
            int kh, int kw,
            int sh, int sw, int pt, int pb, int pl, int pr,
            int dh, int dw, int group
        ) {
            int cpg = xC / group;
            int ocpg = yC / group;
            int n = 0;
            while (n < xN) {
                int oy = 0;
                while (oy < yH) {
                    int ox = 0;
                    while (ox < yW) {
                        int co = 0;
                        while (co < yC) {
                            int g = co / ocpg;
                            float sum = 0.0f;
                            if (bOff >= 0) sum = arena[bOff + co];   // 无偏置卷积（bOff=-1）
                            int ky = 0;
                            while (ky < kh) {
                                int iy = oy * sh - pt + ky * dh;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        int ix = ox * sw - pl + kx * dw;
                                        if (ix >= 0 && ix < xW) {
                                            int ic = 0;
                                            while (ic < cpg) {
                                                int cIn = g * cpg + ic;
                                                float xv = arena[xOff + ((n * xH + iy) * xW + ix) * xC + cIn];
                                                float wv = arena[wOff + ((co * kh + ky) * kw + kx) * cpg + ic];
                                                sum = sum + xv * wv;
                                                ic = ic + 1;
                                            }
                                        }
                                        kx = kx + 1;
                                    }
                                }
                                ky = ky + 1;
                            }
                            arena[yOff + ((n * yH + oy) * yW + ox) * yC + co] = sum;
                            co = co + 1;
                        }
                        ox = ox + 1;
                    }
                    oy = oy + 1;
                }
                n = n + 1;
            }
        }

        // NHWC 卷积 + ReLU（G1 融合的 NHWC 对应）：y 处写 max(sum,0)
        void convNHWCRelu(
            float[] arena,
            int xOff, int xN, int xH, int xW, int xC,
            int wOff, int bOff,
            int yOff, int yH, int yW, int yC,
            int kh, int kw,
            int sh, int sw, int pt, int pb, int pl, int pr,
            int dh, int dw, int group
        ) {
            int cpg = xC / group;
            int ocpg = yC / group;
            int n = 0;
            while (n < xN) {
                int oy = 0;
                while (oy < yH) {
                    int ox = 0;
                    while (ox < yW) {
                        int co = 0;
                        while (co < yC) {
                            int g = co / ocpg;
                            float sum = 0.0f;
                            if (bOff >= 0) sum = arena[bOff + co];   // 无偏置卷积（bOff=-1）
                            int ky = 0;
                            while (ky < kh) {
                                int iy = oy * sh - pt + ky * dh;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        int ix = ox * sw - pl + kx * dw;
                                        if (ix >= 0 && ix < xW) {
                                            int ic = 0;
                                            while (ic < cpg) {
                                                int cIn = g * cpg + ic;
                                                float xv = arena[xOff + ((n * xH + iy) * xW + ix) * xC + cIn];
                                                float wv = arena[wOff + ((co * kh + ky) * kw + kx) * cpg + ic];
                                                sum = sum + xv * wv;
                                                ic = ic + 1;
                                            }
                                        }
                                        kx = kx + 1;
                                    }
                                }
                                ky = ky + 1;
                            }
                            float ov = sum;
                            if (ov > 0.0f) arena[yOff + ((n * yH + oy) * yW + ox) * yC + co] = ov;
                            else arena[yOff + ((n * yH + oy) * yW + ox) * yC + co] = 0.0f;
                            co = co + 1;
                        }
                        ox = ox + 1;
                    }
                    oy = oy + 1;
                }
                n = n + 1;
            }
        }

        // NHWC 最大池化：x:[N,H,W,C] → y:[N,yH,yW,C]
        void maxpoolNHWC(
            float[] arena,
            int xOff, int xN, int xH, int xW, int xC,
            int yOff, int yH, int yW,
            int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr
        ) {
            int n = 0;
            while (n < xN) {
                int oy = 0;
                while (oy < yH) {
                    int ox = 0;
                    while (ox < yW) {
                        int c = 0;
                        while (c < xC) {
                            float best = 0.0f - 1.0e30f;
                            int ky = 0;
                            while (ky < kh) {
                                int iy = oy * sh - pt + ky;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        int ix = ox * sw - pl + kx;
                                        if (ix >= 0 && ix < xW) {
                                            float v = arena[xOff + ((n * xH + iy) * xW + ix) * xC + c];
                                            if (v > best) best = v;
                                        }
                                        kx = kx + 1;
                                    }
                                }
                                ky = ky + 1;
                            }
                            arena[yOff + ((n * yH + oy) * yW + ox) * xC + c] = best;
                            c = c + 1;
                        }
                        ox = ox + 1;
                    }
                    oy = oy + 1;
                }
                n = n + 1;
            }
        }

        // AveragePool（NHWC）：x:[N,H,W,C] → y:[N,yH,yW,C]（元数据 (tN,tC,tH,tW)=(N,H,W,C)）
        void avgpoolNHWC(
            float[] arena,
            int xOff, int xN, int xH, int xW, int xC,
            int yOff, int yH, int yW,
            int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr, int cip
        ) {
            int n = 0;
            while (n < xN) {
                int oy = 0;
                while (oy < yH) {
                    int ox = 0;
                    while (ox < yW) {
                        int c = 0;
                        while (c < xC) {
                            double sum = 0.0;
                            int cnt = 0;
                            int ky = 0;
                            while (ky < kh) {
                                int iy = oy * sh - pt + ky;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        int ix = ox * sw - pl + kx;
                                        if (ix >= 0 && ix < xW) {
                                            sum = sum + arena[xOff + ((n * xH + iy) * xW + ix) * xC + c];
                                            cnt = cnt + 1;
                                        }
                                        kx = kx + 1;
                                    }
                                }
                                ky = ky + 1;
                            }
                            if (cip == 1) cnt = kh * kw;
                            if (cnt > 0) arena[yOff + ((n * yH + oy) * yW + ox) * xC + c] = float(sum / cnt);
                            else arena[yOff + ((n * yH + oy) * yW + ox) * xC + c] = 0.0f;
                            c = c + 1;
                        }
                        ox = ox + 1;
                    }
                    oy = oy + 1;
                }
                n = n + 1;
            }
        }

        // Pad（NHWC）：pads 在逻辑轴 [N,H,W,C] 上的 begin/end（内存元数据 (tN,tC,tH,tW)=(N,H,W,C)）
        void padNHWC(
            float[] arena,
            int xOff, int xN, int xH, int xW, int xC,
            int yOff, int yN, int yH, int yW, int yC,
            int pnB, int phB, int pwB, int pcB, int pnE, int phE, int pwE, int pcE,
            int mode, double cval
        ) {
            int n = 0;
            while (n < yN) {
                int h = 0;
                while (h < yH) {
                    int w = 0;
                    while (w < yW) {
                        int c = 0;
                        while (c < yC) {
                            int sn = n - pnB;
                            int sc = c - pcB;
                            int sh = h - phB;
                            int sw = w - pwB;
                            int inb = 1;
                            if (sn < 0 || sn >= xN) inb = 0;
                            if (sc < 0 || sc >= xC) inb = 0;
                            if (sh < 0 || sh >= xH) inb = 0;
                            if (sw < 0 || sw >= xW) inb = 0;
                            float v = 0.0f;
                            if (inb == 1) {
                                v = arena[xOff + ((sn * xH + sh) * xW + sw) * xC + sc];
                            } else if (mode == 1) {
                                if (sn < 0) sn = 0 - sn;
                                if (sc < 0) sc = 0 - sc;
                                if (sh < 0) sh = 0 - sh;
                                if (sw < 0) sw = 0 - sw;
                                if (sn >= xN) sn = 2 * (xN - 1) - sn;
                                if (sc >= xC) sc = 2 * (xC - 1) - sc;
                                if (sh >= xH) sh = 2 * (xH - 1) - sh;
                                if (sw >= xW) sw = 2 * (xW - 1) - sw;
                                v = arena[xOff + ((sn * xH + sh) * xW + sw) * xC + sc];
                            } else if (mode == 2) {
                                if (sn < 0) sn = 0;
                                if (sc < 0) sc = 0;
                                if (sh < 0) sh = 0;
                                if (sw < 0) sw = 0;
                                if (sn >= xN) sn = xN - 1;
                                if (sc >= xC) sc = xC - 1;
                                if (sh >= xH) sh = xH - 1;
                                if (sw >= xW) sw = xW - 1;
                                v = arena[xOff + ((sn * xH + sh) * xW + sw) * xC + sc];
                            } else {
                                v = float(cval);
                            }
                            arena[yOff + ((n * yH + h) * yW + w) * yC + c] = v;
                            c = c + 1;
                        }
                        w = w + 1;
                    }
                    h = h + 1;
                }
                n = n + 1;
            }
        }

        // NHWC 全局平均池化：x:[N,H,W,C] → y:[N,C]（按通道平均 H*W）
        void gapoolNHWC(float[] arena, int xOff, int xN, int xH, int xW, int xC, int yOff) {
            int n = 0;
            while (n < xN) {
                int c = 0;
                while (c < xC) {
                    float sum = 0.0f;
                    int i = 0;
                    while (i < xH * xW) {
                        int h = i / xW;
                        int w = i % xW;
                        sum = sum + arena[xOff + ((n * xH + h) * xW + w) * xC + c];
                        i = i + 1;
                    }
                    arena[yOff + n * xC + c] = sum / float(xH * xW);
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // ---- G3：BatchNormalization ----
        // y[n,c,h,w] = (x - mean[c]) * invStd[c] + bias[c]，invStd[c]=scale[c]/sqrt(var[c]+eps)
        // x:[N,C,H,W] NCHW；scale/bias/mean/var 均为 [C]（flat 下标 = 通道）
        void batchnorm(float[] arena, int xOff, int xN, int xC, int xH, int xW, int yOff,
                       int sOff, int bOff, int mOff, int vOff, double eps) {
            int n = 0;
            while (n < xN) {
                int c = 0;
                while (c < xC) {
                    double scale = arena[sOff + c];
                    double mean = arena[mOff + c];
                    double variance = arena[vOff + c];
                    double bias = arena[bOff + c];
                    double invStd = scale / Math.sqrt(variance + eps);
                    int i = 0;
                    while (i < xH * xW) {
                        int idx = n * xC * xH * xW + c * xH * xW + i;
                        double xv = arena[xOff + idx];
                        arena[yOff + idx] = float((xv - mean) * invStd + bias);
                        i = i + 1;
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // G3：BatchNormalization（NHWC）：x:[N,H,W,C]，通道 = p % C
        void batchnormNHWC(float[] arena, int xOff, int xN, int xH, int xW, int xC, int yOff,
                           int sOff, int bOff, int mOff, int vOff, double eps) {
            int n = 0;
            while (n < xN) {
                int c = 0;
                while (c < xC) {
                    double scale = arena[sOff + c];
                    double mean = arena[mOff + c];
                    double variance = arena[vOff + c];
                    double bias = arena[bOff + c];
                    double invStd = scale / Math.sqrt(variance + eps);
                    int i = 0;
                    while (i < xH * xW) {
                        int h = i / xW;
                        int w = i % xW;
                        int idx = ((n * xH + h) * xW + w) * xC + c;
                        double xv = arena[xOff + idx];
                        arena[yOff + idx] = float((xv - mean) * invStd + bias);
                        i = i + 1;
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // ---- G4：通用激活（逐元素，布局无关；flat n = 元素数）----
        // ReLU6：y = min(max(x, 0), 6)
        void relu6(float[] arena, int inOff, int outOff, int n) {
            int i = 0;
            while (i < n) {
                float v = arena[inOff + i];
                if (v > 6.0f) v = 6.0f;
                if (v < 0.0f) v = 0.0f;
                arena[outOff + i] = v;
                i = i + 1;
            }
        }
        // LeakyRelu：y = x>0 ? x : alpha*x（alpha 默认 0.01）
        void leakyrelu(float[] arena, int inOff, int outOff, int n, double alpha) {
            int i = 0;
            while (i < n) {
                double v = arena[inOff + i];
                if (v > 0.0) arena[outOff + i] = float(v);
                else arena[outOff + i] = float(alpha * v);
                i = i + 1;
            }
        }
        // SiLU / Swish：y = x * sigmoid(x) = x / (1 + exp(-x))
        void silu(float[] arena, int inOff, int outOff, int n) {
            @parallel for (int i = 0; i < n; i = i + 1) {
                double x = arena[inOff + i];
                double s = x / (1.0 + Math.exp(0.0 - x));
                arena[outOff + i] = float(s);
            }
        }
        // HardSwish：y = x * relu6(x+3) / 6
        void hardswish(float[] arena, int inOff, int outOff, int n) {
            int i = 0;
            while (i < n) {
                double x = arena[inOff + i];
                double r = x + 3.0;
                if (r < 0.0) r = 0.0;
                if (r > 6.0) r = 6.0;
                arena[outOff + i] = float(x * r / 6.0);
                i = i + 1;
            }
        }
        // Clip：y = clamp(x, min, max)；minOff/maxOff 为标量边界偏移（-1 = 不限）
        void clip(float[] arena, int inOff, int outOff, int n, int minOff, int maxOff) {
            double lo = 0.0;
            double hi = 0.0;
            int hasLo = 0;
            int hasHi = 0;
            if (minOff >= 0) { double mv = arena[minOff + 0]; lo = mv; hasLo = 1; }
            if (maxOff >= 0) { double mv = arena[maxOff + 0]; hi = mv; hasHi = 1; }
            int i = 0;
            while (i < n) {
                double v = arena[inOff + i];
                if (hasLo == 1 && v < lo) v = lo;
                if (hasHi == 1 && v > hi) v = hi;
                arena[outOff + i] = float(v);
                i = i + 1;
            }
        }

        // ---- F8：张量操作（Concat / Transpose / Reshape）----
        // Reshape：连续拷贝（输入输出元素数相同、内存布局不变）
        void copyFlat(float[] arena, int inOff, int outOff, int n) {
            int i = 0;
            while (i < n) {
                arena[outOff + i] = arena[inOff + i];
                i = i + 1;
            }
        }
        // Concat：沿 axis 拼接 2-3 个输入
        // od0..od3 = 输出 4D 维度；ax0/ax1/ax2 = 各输入沿 axis 的长度；非 axis 维各输入一致
        // inFlat 用所选输入的自身轴长（aLen）计算，batch>1 时 stride 才正确。
        void concat(float[] arena, int off0, int off1, int off2, int offO,
                    int od0, int od1, int od2, int od3,
                    int ax0, int ax1, int ax2, int axis, int nIn) {
            int total = od0 * od1 * od2 * od3;
            int i = 0;
            while (i < total) {
                int x3 = i % od3;
                int t = i / od3;
                int x2 = t % od2;
                t = t / od2;
                int x1 = t % od1;
                int x0 = t / od1;
                int ac = 0;
                if (axis == 0) ac = x0;
                else if (axis == 1) ac = x1;
                else if (axis == 2) ac = x2;
                else ac = x3;
                int which = 0;
                int local = ac;
                int aLen = ax0;
                if (local >= aLen) {
                    local = local - aLen;
                    which = 1;
                    aLen = ax1;
                    if (nIn >= 3 && local >= aLen) { local = local - aLen; which = 2; aLen = ax2; }
                }
                int inOff = 0;
                if (which == 0) inOff = off0;
                else if (which == 1) inOff = off1;
                else inOff = off2;
                int inFlat = 0;
                if (axis == 0) inFlat = ((local * od1 + x1) * od2 + x2) * od3 + x3;
                else if (axis == 1) inFlat = ((x0 * aLen + local) * od2 + x2) * od3 + x3;
                else if (axis == 2) inFlat = ((x0 * od1 + x1) * aLen + local) * od3 + x3;
                else inFlat = ((x0 * od1 + x1) * od2 + x2) * aLen + local;
                arena[offO + i] = arena[inOff + inFlat];
                i = i + 1;
            }
        }
        // Concat 反向（opKind 72）：把输出梯度 dy 散射回各输入梯度 dx0/dx1/dx2。
        // 布局同 concat 前向（4D 视图 + axis + 各输入轴长 ax0/1/2）。concat 是双射
        // （每个输出元素唯一对应一个输入元素）→ 直接赋值，无需清零/累加。
        // 2 输入时 dx2Off=-1（which 不会=2，不访问）。U-Net 跳跃连接：axis=1（C）
        // 5D 视图 od3 折叠 H*W。
        void bwdConcat(float[] arena, int dyOff, int dx0Off, int dx1Off, int dx2Off,
                       int axis, int nIn, int od0, int od1, int od2, int od3,
                       int ax0, int ax1, int ax2) {
            int total = od0 * od1 * od2 * od3;
            int i = 0;
            while (i < total) {
                int x3 = i % od3;
                int t = i / od3;
                int x2 = t % od2;
                t = t / od2;
                int x1 = t % od1;
                int x0 = t / od1;
                int ac = 0;
                if (axis == 0) ac = x0;
                else if (axis == 1) ac = x1;
                else if (axis == 2) ac = x2;
                else ac = x3;
                int which = 0;
                int local = ac;
                int aLen = ax0;
                if (local >= aLen) {
                    local = local - aLen;
                    which = 1;
                    aLen = ax1;
                    if (nIn >= 3 && local >= aLen) { local = local - aLen; which = 2; aLen = ax2; }
                }
                int dxOff = 0;
                if (which == 0) dxOff = dx0Off;
                else if (which == 1) dxOff = dx1Off;
                else dxOff = dx2Off;
                int inFlat = 0;
                if (axis == 0) inFlat = ((local * od1 + x1) * od2 + x2) * od3 + x3;
                else if (axis == 1) inFlat = ((x0 * aLen + local) * od2 + x2) * od3 + x3;
                else if (axis == 2) inFlat = ((x0 * od1 + x1) * aLen + local) * od3 + x3;
                else inFlat = ((x0 * od1 + x1) * od2 + x2) * aLen + local;
                arena[dxOff + inFlat] = arena[dyOff + i];
                i = i + 1;
            }
        }
        // Transpose：按 perm 转置 4D 张量（pc = perm 元素数，0 = 缺省反转）
        void transpose(float[] arena, int offIn, int offOut,
                       int id0, int id1, int id2, int id3,
                       int p0, int p1, int p2, int p3, int pc) {
            int perm0 = p0, perm1 = p1, perm2 = p2, perm3 = p3;
            if (pc == 0) { perm0 = 3; perm1 = 2; perm2 = 1; perm3 = 0; }
            else if (pc == 1) { perm1 = 1; perm2 = 2; perm3 = 3; }
            else if (pc == 2) { perm2 = 2; perm3 = 3; }
            else if (pc == 3) { perm3 = 3; }
            int od0 = (perm0 == 0) ? id0 : ((perm0 == 1) ? id1 : ((perm0 == 2) ? id2 : id3));
            int od1 = (perm1 == 0) ? id0 : ((perm1 == 1) ? id1 : ((perm1 == 2) ? id2 : id3));
            int od2 = (perm2 == 0) ? id0 : ((perm2 == 1) ? id1 : ((perm2 == 2) ? id2 : id3));
            int od3 = (perm3 == 0) ? id0 : ((perm3 == 1) ? id1 : ((perm3 == 2) ? id2 : id3));
            // 逆 perm：invPerm[perm[k]] = k
            int inv0 = (perm0 == 0) ? 0 : ((perm1 == 0) ? 1 : ((perm2 == 0) ? 2 : 3));
            int inv1 = (perm0 == 1) ? 0 : ((perm1 == 1) ? 1 : ((perm2 == 1) ? 2 : 3));
            int inv2 = (perm0 == 2) ? 0 : ((perm1 == 2) ? 1 : ((perm2 == 2) ? 2 : 3));
            int inv3 = (perm0 == 3) ? 0 : ((perm1 == 3) ? 1 : ((perm2 == 3) ? 2 : 3));
            int total = od0 * od1 * od2 * od3;
            int i = 0;
            while (i < total) {
                int o3 = i % od3;
                int t = i / od3;
                int o2 = t % od2;
                t = t / od2;
                int o1 = t % od1;
                int o0 = t / od1;
                int i0 = (inv0 == 0) ? o0 : ((inv0 == 1) ? o1 : ((inv0 == 2) ? o2 : o3));
                int i1 = (inv1 == 0) ? o0 : ((inv1 == 1) ? o1 : ((inv1 == 2) ? o2 : o3));
                int i2 = (inv2 == 0) ? o0 : ((inv2 == 1) ? o1 : ((inv2 == 2) ? o2 : o3));
                int i3 = (inv3 == 0) ? o0 : ((inv3 == 1) ? o1 : ((inv3 == 2) ? o2 : o3));
                int inFlat = ((i0 * id1 + i1) * id2 + i2) * id3 + i3;
                arena[offOut + i] = arena[offIn + inFlat];
                i = i + 1;
            }
        }
        // Slice：沿任意轴切片（支持负 step 反向）
        // id0..3 = 输入 4D 维；od0..3 = 输出 4D 维；每轴 (ax, st, sp) = 轴索引/调整后 start/step
        void sliceOp(float[] arena, int offIn, int offOut,
                     int cnt, int id0, int id1, int id2, int id3,
                     int od0, int od1, int od2, int od3,
                     int ax0, int st0, int sp0, int ax1, int st1, int sp1,
                     int ax2, int st2, int sp2, int ax3, int st3, int sp3) {
            int total = od0 * od1 * od2 * od3;
            int i = 0;
            while (i < total) {
                int x3 = i % od3;
                int t = i / od3;
                int x2 = t % od2;
                t = t / od2;
                int x1 = t % od1;
                int x0 = t / od1;
                int c0 = x0, c1 = x1, c2 = x2, c3 = x3;
                int k = 0;
                while (k < cnt) {
                    int ax = (k == 0) ? ax0 : ((k == 1) ? ax1 : ((k == 2) ? ax2 : ax3));
                    int sp = (k == 0) ? sp0 : ((k == 1) ? sp1 : ((k == 2) ? sp2 : sp3));
                    int st = (k == 0) ? st0 : ((k == 1) ? st1 : ((k == 2) ? st2 : st3));
                    int oc = (ax == 0) ? x0 : ((ax == 1) ? x1 : ((ax == 2) ? x2 : x3));
                    int ic = st + oc * sp;
                    if (ax == 0) c0 = ic;
                    else if (ax == 1) c1 = ic;
                    else if (ax == 2) c2 = ic;
                    else c3 = ic;
                    k = k + 1;
                }
                int inFlat = ((c0 * id1 + c1) * id2 + c2) * id3 + c3;
                arena[offOut + i] = arena[offIn + inFlat];
                i = i + 1;
            }
        }

        // Expand：broadcast 复制（G4）。输入 4D id0-3，输出 4D od0-3。
        // 每维：输入维=1 时复制（映射到 0），否则须等于输出维（直接映射）。
        void expand(float[] arena, int offIn, int offOut,
                    int id0, int id1, int id2, int id3,
                    int od0, int od1, int od2, int od3) {
            int total = od0 * od1 * od2 * od3;
            int i = 0;
            while (i < total) {
                int x3 = i % od3;
                int t = i / od3;
                int x2 = t % od2;
                t = t / od2;
                int x1 = t % od1;
                int x0 = t / od1;
                int c0 = (id0 == 1) ? 0 : x0;
                int c1 = (id1 == 1) ? 0 : x1;
                int c2 = (id2 == 1) ? 0 : x2;
                int c3 = (id3 == 1) ? 0 : x3;
                int inFlat = ((c0 * id1 + c1) * id2 + c2) * id3 + c3;
                arena[offOut + i] = arena[offIn + inFlat];
                i = i + 1;
            }
        }

        // Where（G5）：逐元素选择 out = cond ? x : y。三输入各自 4D 广播
        // （维=1 的输入维度映射到 0；其余维 % 输入维）。输出 dims (oc,oh,ow)
        // 由 work=on*oc*oh*ow 隐含，decode 用 (oc,oh,ow)。
        // 注意：`where` 是 MYP 保留字（mapping 过滤），函数名用 where1。
        void where1(float[] arena, int cOff, int xOff, int yOff, int oOff, int work,
                   int oc, int oh, int ow,
                   int cn, int cc, int ch, int cw,
                   int xn, int xc, int xh, int xw,
                   int yn, int yc, int yh, int yw) {
            int i = 0;
            while (i < work) {
                int w3 = i % ow;
                int t = i / ow;
                int w2 = t % oh;
                t = t / oh;
                int w1 = t % oc;
                int w0 = t / oc;
                int c0 = (cn == 1) ? 0 : (w0 % cn);
                int c1 = (cc == 1) ? 0 : (w1 % cc);
                int c2 = (ch == 1) ? 0 : (w2 % ch);
                int c3 = (cw == 1) ? 0 : (w3 % cw);
                int cFlat = ((c0 * cc + c1) * ch + c2) * cw + c3;
                int x0 = (xn == 1) ? 0 : (w0 % xn);
                int x1 = (xc == 1) ? 0 : (w1 % xc);
                int x2 = (xh == 1) ? 0 : (w2 % xh);
                int x3 = (xw == 1) ? 0 : (w3 % xw);
                int xFlat = ((x0 * xc + x1) * xh + x2) * xw + x3;
                int y0 = (yn == 1) ? 0 : (w0 % yn);
                int y1 = (yc == 1) ? 0 : (w1 % yc);
                int y2 = (yh == 1) ? 0 : (w2 % yh);
                int y3 = (yw == 1) ? 0 : (w3 % yw);
                int yFlat = ((y0 * yc + y1) * yh + y2) * yw + y3;
                if (arena[cOff + cFlat] > float(0.0)) { arena[oOff + i] = arena[xOff + xFlat]; }
                else { arena[oOff + i] = arena[yOff + yFlat]; }
                i = i + 1;
            }
        }

        // Tile（G5）：沿各维按倍数复制 out = tile(in, repeats)。
        // 输入 4D id0-3、输出 4D od0-3（odX = idX × repeatsX）。逐元素 decode：
        // 输出 index % 输入维（维=1 → 0）。与 expand 同构但输入维可为任意倍数。
        void tile(float[] arena, int inOff, int outOff, int work,
                  int id0, int id1, int id2, int id3,
                  int od0, int od1, int od2, int od3) {
            int i = 0;
            while (i < work) {
                int x3 = i % od3;
                int t = i / od3;
                int x2 = t % od2;
                t = t / od2;
                int x1 = t % od1;
                int x0 = t / od1;
                int c0 = (id0 == 1) ? 0 : (x0 % id0);
                int c1 = (id1 == 1) ? 0 : (x1 % id1);
                int c2 = (id2 == 1) ? 0 : (x2 % id2);
                int c3 = (id3 == 1) ? 0 : (x3 % id3);
                int inFlat = ((c0 * id1 + c1) * id2 + c2) * id3 + c3;
                arena[outOff + i] = arena[inOff + inFlat];
                i = i + 1;
            }
        }

        // Gather（G5）：沿 axis 按 indices 收集。data 4D dn/dc/dh/dw，out 4D on/oc/oh/ow
        // （out 的 axis 维 = lenIdx，其余维 = data 对应维）。indices 存 float arena
        // （int→float，<2^24 精确），读 int(a[iOff+k])；负索引 +dim，越界 clamp。
        void gather(float[] arena, int dOff, int iOff, int oOff, int work,
                    int axis, int lenIdx, int dn, int dc, int dh, int dw,
                    int on, int oc, int oh, int ow) {
            int i = 0;
            while (i < work) {
                int w3 = i % ow;
                int t = i / ow;
                int w2 = t % oh;
                t = t / oh;
                int w1 = t % oc;
                int w0 = t / oc;
                int axIdx = (axis == 0) ? w0 : ((axis == 1) ? w1 : ((axis == 2) ? w2 : w3));
                int dim = (axis == 0) ? dn : ((axis == 1) ? dc : ((axis == 2) ? dh : dw));
                int id = int(arena[iOff + axIdx]);
                if (id < 0) id = id + dim;
                if (id < 0) id = 0;
                if (id >= dim) id = dim - 1;
                int dn2 = (axis == 0) ? id : w0;
                int dc2 = (axis == 1) ? id : w1;
                int dh2 = (axis == 2) ? id : w2;
                int dw2 = (axis == 3) ? id : w3;
                int dFlat = ((dn2 * dc + dc2) * dh + dh2) * dw + dw2;
                arena[oOff + i] = arena[dOff + dFlat];
                i = i + 1;
            }
        }

        // LogSoftmax（G5）：沿 axis 的稳定 log-softmax。张量视作 [outer, axisDim, inner]
        // （行优先）；对每 (outer,inner) 组：m=max、lse=m+log(Σexp(x-m))、y=x-lse。
        void logSoftmax(float[] arena, int inOff, int outOff, int outer, int axisDim, int inner) {
            int oi = 0;
            while (oi < outer) {
                int ii = 0;
                while (ii < inner) {
                    float m = arena[inOff + (oi * axisDim + 0) * inner + ii];
                    int k = 1;
                    while (k < axisDim) {
                        float v = arena[inOff + (oi * axisDim + k) * inner + ii];
                        if (v > m) m = v;
                        k = k + 1;
                    }
                    float sum = 0.0f;
                    k = 0;
                    while (k < axisDim) {
                        float e = Math.exp(arena[inOff + (oi * axisDim + k) * inner + ii] - m);
                        sum = sum + e;
                        k = k + 1;
                    }
                    float lse = m + Math.log(sum);
                    k = 0;
                    while (k < axisDim) {
                        float v = arena[inOff + (oi * axisDim + k) * inner + ii];
                        arena[outOff + (oi * axisDim + k) * inner + ii] = float(v - lse);
                        k = k + 1;
                    }
                    ii = ii + 1;
                }
                oi = oi + 1;
            }
        }

        // Embedding（G5）：查表 out[s*D+d] = w[ids[s]*D+d]（row-major [S,D]）。
        // ids 存 float arena（int→float）；负索引 clamp 0，越界 clamp vocab-1。
        void embedding(float[] arena, int wOff, int idOff, int oOff, int vocab, int D, int S) {
            int s = 0;
            while (s < S) {
                int id = int(arena[idOff + s]);
                if (id < 0) id = 0;
                if (id >= vocab) id = vocab - 1;
                int d = 0;
                while (d < D) {
                    arena[oOff + s * D + d] = arena[wOff + id * D + d];
                    d = d + 1;
                }
                s = s + 1;
            }
        }

        // Dropout 训练（G5）：y[i] = (u < ratio) ? 0 : x[i]（u 为确定性 LCG 序列）。
        // 推理恒等用 copyFlat（DropoutOp.forward 按 rt.trainMode() 分派）。
        void dropoutTrain(float[] arena, int inOff, int outOff, int n, double ratio) {
            int state = 12345;
            int i = 0;
            while (i < n) {
                state = (state * 1103515245 + 12345) & 2147483647;
                double u = double(state) / 2147483647.0;
                if (u < ratio) arena[outOff + i] = 0.0f;
                else arena[outOff + i] = arena[inOff + i];
                i = i + 1;
            }
        }

        // ---- F8：秩无关逐元素 / 规约 / 归一化 / 分割 / 上采样 ----
        // 设计原则：2D/3D 通用。元素级用 flat n；InstanceNorm/ReduceMean 用
        // (N, C, 空间乘积 S)；Split 用 rank≤5 的 5 维解码（2D 时 d4=1，3D 时真实）。
        // 混型运算已由编译器修复（int→double/float 自动提升）：除法直接用 int 除数。
        // Sub：y = a - b（bSize==1 标量；bSize==n 同尺寸；bSize==C 逐通道广播 [1,C,1,1]）
        void sub(float[] arena, int aOff, int bOff, int outOff, int n, int bSize, int C, int S) {
            int i = 0;
            if (bSize <= 1) {
                double bv = arena[bOff + 0];
                while (i < n) { double av = arena[aOff + i]; arena[outOff + i] = float(av - bv); i = i + 1; }
            } else if (bSize == n) {
                while (i < n) { double av = arena[aOff + i]; double bv2 = arena[bOff + i]; arena[outOff + i] = float(av - bv2); i = i + 1; }
            } else {
                // 逐通道：b[(i/S)%C]
                while (i < n) { double av = arena[aOff + i]; double bv2 = arena[bOff + (i / S) % C]; arena[outOff + i] = float(av - bv2); i = i + 1; }
            }
        }
        // Div：y = a / b（同上广播）
        void div(float[] arena, int aOff, int bOff, int outOff, int n, int bSize, int C, int S) {
            int i = 0;
            if (bSize <= 1) {
                double bv = arena[bOff + 0];
                while (i < n) { double av = arena[aOff + i]; arena[outOff + i] = float(av / bv); i = i + 1; }
            } else if (bSize == n) {
                while (i < n) { double av = arena[aOff + i]; double bv2 = arena[bOff + i]; arena[outOff + i] = float(av / bv2); i = i + 1; }
            } else {
                while (i < n) { double av = arena[aOff + i]; double bv2 = arena[bOff + (i / S) % C]; arena[outOff + i] = float(av / bv2); i = i + 1; }
            }
        }
        // Mul：y = a * b（同上广播）
        void mul(float[] arena, int aOff, int bOff, int outOff, int n, int bSize, int C, int S) {
            int i = 0;
            if (bSize <= 1) {
                double bv = arena[bOff + 0];
                while (i < n) { double av = arena[aOff + i]; arena[outOff + i] = float(av * bv); i = i + 1; }
            } else if (bSize == n) {
                while (i < n) { double av = arena[aOff + i]; double bv2 = arena[bOff + i]; arena[outOff + i] = float(av * bv2); i = i + 1; }
            } else {
                while (i < n) { double av = arena[aOff + i]; double bv2 = arena[bOff + (i / S) % C]; arena[outOff + i] = float(av * bv2); i = i + 1; }
            }
        }
        // Sqrt：y = sqrt(x)
        void sqrt1(float[] arena, int inOff, int outOff, int n) {
            int i = 0;
            while (i < n) { arena[outOff + i] = Math.sqrt(arena[inOff + i]); i = i + 1; }
        }
        // InstanceNormalization：per-(n,c) 在 S=空间元素数 上 mean/var（biased）+ affine
        // x: [N,C,S] flat；scale/bias: [C]；eps。秩无关（2D S=H*W；3D S=D*H*W）。
        void instancenorm(float[] arena, int xOff, int sOff, int bOff, int yOff,
                          int N, int C, int S, double eps, int doRelu) {
            int n = 0;
            while (n < N) {
                int c = 0;
                while (c < C) {
                    int base = (n * C + c) * S;
                    // 一趟同时算 Σx 与 Σx²（double 累加保精度；内存读同 float 带宽）
                    // 原 3 趟（sum/ss/normalize）→ 2 趟，省 1/3 内存读（带宽受限算子）
                    double sum = 0.0;
                    double sumSq = 0.0;
                    int i = 0;
                    while (i < S) {
                        double xv = arena[xOff + base + i];
                        sum = sum + xv;
                        sumSq = sumSq + xv * xv;
                        i = i + 1;
                    }
                    double mean = sum / S;
                    double variance = sumSq / S - mean * mean;
                    double scale = arena[sOff + c];
                    double bias = arena[bOff + c];
                    double invStd = scale / Math.sqrt(variance + eps);
                    i = 0;
                    if (doRelu == 1) {
                        while (i < S) {
                            double xv = arena[xOff + base + i];
                            float v = float((xv - mean) * invStd + bias);
                            if (v < 0.0f) v = 0.0f;
                            arena[yOff + base + i] = v;
                            i = i + 1;
                        }
                    } else {
                        while (i < S) { double xv = arena[xOff + base + i]; arena[yOff + base + i] = float((xv - mean) * invStd + bias); i = i + 1; }
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }
        // ReduceMean：mode 0 = 全规约（输出 1 元素）；mode 1 = 空间维规约（per-(n,c)）
        // Reduce 族（G3）：mode 0 = 全规约；mode 1 = 空间维规约 per-(n,c)
        // redType：0=mean（除以元素数）,1=sum,2=max,3=min
        void reduceMean(float[] arena, int inOff, int outOff, int mode,
                        int N, int C, int S, int total, int keepdims, int redType) {
            if (mode == 0) {
                double acc = 0.0;
                if (redType == 2) acc = -1.0e30;   // max 初始 -inf
                else if (redType == 3) acc = 1.0e30;   // min 初始 +inf
                int i = 0;
                if (redType == 2 || redType == 3) {
                    while (i < total) { double xv = arena[inOff + i]; if (redType == 2) { if (xv > acc) acc = xv; } else { if (xv < acc) acc = xv; } i = i + 1; }
                    arena[outOff + 0] = float(acc);
                } else {
                    while (i < total) { double xv = arena[inOff + i]; acc = acc + xv; i = i + 1; }
                    if (redType == 0) arena[outOff + 0] = float(acc / total);
                    else arena[outOff + 0] = float(acc);
                }
            } else {
                int n = 0;
                while (n < N) {
                    int c = 0;
                    while (c < C) {
                        int base = (n * C + c) * S;
                        double acc = 0.0;
                        if (redType == 2) acc = -1.0e30;
                        else if (redType == 3) acc = 1.0e30;
                        int i = 0;
                        if (redType == 2 || redType == 3) {
                            while (i < S) { double xv = arena[inOff + base + i]; if (redType == 2) { if (xv > acc) acc = xv; } else { if (xv < acc) acc = xv; } i = i + 1; }
                        } else {
                            while (i < S) { double xv = arena[inOff + base + i]; acc = acc + xv; i = i + 1; }
                            if (redType == 0) acc = acc / S;
                        }
                        arena[outOff + n * C + c] = float(acc);
                        c = c + 1;
                    }
                    n = n + 1;
                }
            }
        }
        // Split：从输入沿 axis 复制 [start, start+len) 到输出（秩 ≤5，5 维解码）
        // 输出形状 = 输入形状仅 axis 维 = len；od 由 d/axis/len 内部推出（2D 时 d4=1）。
        void splitOp(float[] arena, int offIn, int offOut,
                     int axis, int start, int len,
                     int d0, int d1, int d2, int d3, int d4) {
            int od0 = d0, od1 = d1, od2 = d2, od3 = d3, od4 = d4;
            if (axis == 0) od0 = len;
            else if (axis == 1) od1 = len;
            else if (axis == 2) od2 = len;
            else if (axis == 3) od3 = len;
            else od4 = len;
            int total = od0 * od1 * od2 * od3 * od4;
            int i = 0;
            while (i < total) {
                int x4 = i % od4;
                int t = i / od4;
                int x3 = t % od3;
                t = t / od3;
                int x2 = t % od2;
                t = t / od2;
                int x1 = t % od1;
                int x0 = t / od1;
                int c0 = x0, c1 = x1, c2 = x2, c3 = x3, c4 = x4;
                if (axis == 0) c0 = x0 + start;
                else if (axis == 1) c1 = x1 + start;
                else if (axis == 2) c2 = x2 + start;
                else if (axis == 3) c3 = x3 + start;
                else c4 = x4 + start;
                int inFlat = (((c0 * d1 + c1) * d2 + c2) * d3 + c3) * d4 + c4;
                arena[offOut + i] = arena[offIn + inFlat];
                i = i + 1;
            }
        }
        // Resize2D：nearest / bilinear 上采样（坐标变换 align_corners / half_pixel / asymmetric）
        // x: [N,C,inH,inW] flat；y: [N,C,outH,outW] flat。mode: 0=nearest, 1=linear。
        // 坐标计算刻意保持全 float（arena 为 float，与 ORT float32 位型一致）；
        // 混型运算现已被编译器支持，此处不需要 double 精度。
        void resize2d(float[] arena, int offIn, int offOut,
                      int N, int C, int inH, int inW, int outH, int outW,
                      int mode, int transform) {
            int n = 0;
            while (n < N) {
                int c = 0;
                while (c < C) {
                    int y = 0;
                    while (y < outH) {
                        int x = 0;
                        while (x < outW) {
                            float sy = 0.0f;
                            float sx = 0.0f;
                            if (transform == 0) {
                                // align_corners：src = dst * (in-1)/(out-1)
                                sy = (outH > 1) ? float(y) * float(inH - 1) / float(outH - 1) : 0.0f;
                                sx = (outW > 1) ? float(x) * float(inW - 1) / float(outW - 1) : 0.0f;
                            } else if (transform == 2) {
                                // asymmetric：src = dst * in/out
                                sy = float(y) * float(inH) / float(outH);
                                sx = float(x) * float(inW) / float(outW);
                            } else {
                                // half_pixel：src = (dst + 0.5) * in/out - 0.5
                                sy = (float(y) + 0.5f) * float(inH) / float(outH) - 0.5f;
                                sx = (float(x) + 0.5f) * float(inW) / float(outW) - 0.5f;
                            }
                            int base = (n * C + c) * inH * inW;
                            int obase = (n * C + c) * outH * outW;
                            if (mode == 0) {
                                // nearest
                                int iy = int(sy);
                                int ix = int(sx);
                                if (iy < 0) iy = 0;
                                if (iy >= inH) iy = inH - 1;
                                if (ix < 0) ix = 0;
                                if (ix >= inW) ix = inW - 1;
                                arena[offOut + obase + y * outW + x] = arena[offIn + base + iy * inW + ix];
                            } else {
                                // bilinear
                                int iy = int(sy);
                                int ix = int(sx);
                                float fy = sy - float(iy);
                                float fx = sx - float(ix);
                                if (iy < 0) { iy = 0; fy = 0.0f; }
                                if (iy >= inH - 1) { iy = inH - 1; fy = 0.0f; }
                                if (ix < 0) { ix = 0; fx = 0.0f; }
                                if (ix >= inW - 1) { ix = inW - 1; fx = 0.0f; }
                                int iy2 = iy + 1;
                                int ix2 = ix + 1;
                                if (iy2 >= inH) iy2 = inH - 1;
                                if (ix2 >= inW) ix2 = inW - 1;
                                float v00 = arena[offIn + base + iy * inW + ix];
                                float v01 = arena[offIn + base + iy * inW + ix2];
                                float v10 = arena[offIn + base + iy2 * inW + ix];
                                float v11 = arena[offIn + base + iy2 * inW + ix2];
                                float v = v00 * (1.0f - fx) * (1.0f - fy) + v01 * fx * (1.0f - fy) + v10 * (1.0f - fx) * fy + v11 * fx * fy;
                                arena[offOut + obase + y * outW + x] = v;
                            }
                            x = x + 1;
                        }
                        y = y + 1;
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // Resize3D：x[N,C,inD,inH,inW] → y[N,C,outD,outH,outW]（3D 扩展）
        // mode：0 = nearest，1 = trilinear；transform：0 = align_corners，1 = half_pixel，2 = asymmetric
        void resize3d(float[] arena, int offIn, int offOut,
                      int N, int C, int inD, int inH, int inW, int outD, int outH, int outW,
                      int mode, int transform) {
            int n = 0;
            while (n < N) {
                int c = 0;
                while (c < C) {
                    int z = 0;
                    while (z < outD) {
                        int y = 0;
                        while (y < outH) {
                            int x = 0;
                            while (x < outW) {
                                float sz = 0.0f;
                                float sy = 0.0f;
                                float sx = 0.0f;
                                if (transform == 0) {
                                    // align_corners：src = dst * (in-1)/(out-1)
                                    sz = (outD > 1) ? float(z) * float(inD - 1) / float(outD - 1) : 0.0f;
                                    sy = (outH > 1) ? float(y) * float(inH - 1) / float(outH - 1) : 0.0f;
                                    sx = (outW > 1) ? float(x) * float(inW - 1) / float(outW - 1) : 0.0f;
                                } else if (transform == 2) {
                                    // asymmetric：src = dst * in/out
                                    sz = float(z) * float(inD) / float(outD);
                                    sy = float(y) * float(inH) / float(outH);
                                    sx = float(x) * float(inW) / float(outW);
                                } else {
                                    // half_pixel：src = (dst + 0.5) * in/out - 0.5
                                    sz = (float(z) + 0.5f) * float(inD) / float(outD) - 0.5f;
                                    sy = (float(y) + 0.5f) * float(inH) / float(outH) - 0.5f;
                                    sx = (float(x) + 0.5f) * float(inW) / float(outW) - 0.5f;
                                }
                                int base = (n * C + c) * inD * inH * inW;
                                int obase = (n * C + c) * outD * outH * outW;
                                if (mode == 0) {
                                    // nearest
                                    int iz = int(sz);
                                    int iy = int(sy);
                                    int ix = int(sx);
                                    if (iz < 0) iz = 0;
                                    if (iz >= inD) iz = inD - 1;
                                    if (iy < 0) iy = 0;
                                    if (iy >= inH) iy = inH - 1;
                                    if (ix < 0) ix = 0;
                                    if (ix >= inW) ix = inW - 1;
                                    arena[offOut + obase + z * outH * outW + y * outW + x] = arena[offIn + base + iz * inH * inW + iy * inW + ix];
                                } else {
                                    // trilinear
                                    int iz = int(sz);
                                    int iy = int(sy);
                                    int ix = int(sx);
                                    float fz = sz - float(iz);
                                    float fy = sy - float(iy);
                                    float fx = sx - float(ix);
                                    if (iz < 0) { iz = 0; fz = 0.0f; }
                                    if (iz >= inD - 1) { iz = inD - 1; fz = 0.0f; }
                                    if (iy < 0) { iy = 0; fy = 0.0f; }
                                    if (iy >= inH - 1) { iy = inH - 1; fy = 0.0f; }
                                    if (ix < 0) { ix = 0; fx = 0.0f; }
                                    if (ix >= inW - 1) { ix = inW - 1; fx = 0.0f; }
                                    int iz2 = iz + 1; if (iz2 >= inD) iz2 = inD - 1;
                                    int iy2 = iy + 1; if (iy2 >= inH) iy2 = inH - 1;
                                    int ix2 = ix + 1; if (ix2 >= inW) ix2 = inW - 1;
                                    float w000 = (1.0f - fx) * (1.0f - fy) * (1.0f - fz);
                                    float w100 = fx * (1.0f - fy) * (1.0f - fz);
                                    float w010 = (1.0f - fx) * fy * (1.0f - fz);
                                    float w110 = fx * fy * (1.0f - fz);
                                    float w001 = (1.0f - fx) * (1.0f - fy) * fz;
                                    float w101 = fx * (1.0f - fy) * fz;
                                    float w011 = (1.0f - fx) * fy * fz;
                                    float w111 = fx * fy * fz;
                                    float v = arena[offIn + base + iz * inH * inW + iy * inW + ix] * w000
                                            + arena[offIn + base + iz * inH * inW + iy * inW + ix2] * w100
                                            + arena[offIn + base + iz * inH * inW + iy2 * inW + ix] * w010
                                            + arena[offIn + base + iz * inH * inW + iy2 * inW + ix2] * w110
                                            + arena[offIn + base + iz2 * inH * inW + iy * inW + ix] * w001
                                            + arena[offIn + base + iz2 * inH * inW + iy * inW + ix2] * w101
                                            + arena[offIn + base + iz2 * inH * inW + iy2 * inW + ix] * w011
                                            + arena[offIn + base + iz2 * inH * inW + iy2 * inW + ix2] * w111;
                                    arena[offOut + obase + z * outH * outW + y * outW + x] = v;
                                }
                                x = x + 1;
                            }
                            y = y + 1;
                        }
                        z = z + 1;
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }

        // Resize3D 反向（阶段4d）：thread-per-output，把 dOut[z,y,x] 按前向坐标
        // 映射散射回 dIn。nearest → 单输入累加；trilinear → 8 邻居按权重累加。
        // 参数与 resize3d 前向一致（mode/transform）。dIn 先清零。
        void bwdResize3d(float[] arena, int dOutOff, int dInOff,
                         int N, int C, int inD, int inH, int inW, int outD, int outH, int outW,
                         int mode, int transform) {
            int i = 0;
            while (i < N * C * inD * inH * inW) { arena[dInOff + i] = 0.0f; i = i + 1; }
            int n = 0;
            while (n < N) {
                int c = 0;
                while (c < C) {
                    int z = 0;
                    while (z < outD) {
                        int y = 0;
                        while (y < outH) {
                            int x = 0;
                            while (x < outW) {
                                float sz = 0.0f;
                                float sy = 0.0f;
                                float sx = 0.0f;
                                if (transform == 0) {
                                    sz = (outD > 1) ? float(z) * float(inD - 1) / float(outD - 1) : 0.0f;
                                    sy = (outH > 1) ? float(y) * float(inH - 1) / float(outH - 1) : 0.0f;
                                    sx = (outW > 1) ? float(x) * float(inW - 1) / float(outW - 1) : 0.0f;
                                } else if (transform == 2) {
                                    sz = float(z) * float(inD) / float(outD);
                                    sy = float(y) * float(inH) / float(outH);
                                    sx = float(x) * float(inW) / float(outW);
                                } else {
                                    sz = (float(z) + 0.5f) * float(inD) / float(outD) - 0.5f;
                                    sy = (float(y) + 0.5f) * float(inH) / float(outH) - 0.5f;
                                    sx = (float(x) + 0.5f) * float(inW) / float(outW) - 0.5f;
                                }
                                int base = (n * C + c) * inD * inH * inW;
                                int obase = (n * C + c) * outD * outH * outW;
                                float dy = arena[dOutOff + obase + z * outH * outW + y * outW + x];
                                if (mode == 0) {
                                    // nearest
                                    int iz = int(sz);
                                    int iy = int(sy);
                                    int ix = int(sx);
                                    if (iz < 0) iz = 0;
                                    if (iz >= inD) iz = inD - 1;
                                    if (iy < 0) iy = 0;
                                    if (iy >= inH) iy = inH - 1;
                                    if (ix < 0) ix = 0;
                                    if (ix >= inW) ix = inW - 1;
                                    arena[dInOff + base + iz * inH * inW + iy * inW + ix] = arena[dInOff + base + iz * inH * inW + iy * inW + ix] + dy;
                                } else {
                                    // trilinear（8 邻居权重同前向）
                                    int iz = int(sz);
                                    int iy = int(sy);
                                    int ix = int(sx);
                                    float fz = sz - float(iz);
                                    float fy = sy - float(iy);
                                    float fx = sx - float(ix);
                                    if (iz < 0) { iz = 0; fz = 0.0f; }
                                    if (iz >= inD - 1) { iz = inD - 1; fz = 0.0f; }
                                    if (iy < 0) { iy = 0; fy = 0.0f; }
                                    if (iy >= inH - 1) { iy = inH - 1; fy = 0.0f; }
                                    if (ix < 0) { ix = 0; fx = 0.0f; }
                                    if (ix >= inW - 1) { ix = inW - 1; fx = 0.0f; }
                                    int iz2 = iz + 1; if (iz2 >= inD) iz2 = inD - 1;
                                    int iy2 = iy + 1; if (iy2 >= inH) iy2 = inH - 1;
                                    int ix2 = ix + 1; if (ix2 >= inW) ix2 = inW - 1;
                                    float w000 = (1.0f - fx) * (1.0f - fy) * (1.0f - fz);
                                    float w100 = fx * (1.0f - fy) * (1.0f - fz);
                                    float w010 = (1.0f - fx) * fy * (1.0f - fz);
                                    float w110 = fx * fy * (1.0f - fz);
                                    float w001 = (1.0f - fx) * (1.0f - fy) * fz;
                                    float w101 = fx * (1.0f - fy) * fz;
                                    float w011 = (1.0f - fx) * fy * fz;
                                    float w111 = fx * fy * fz;
                                    arena[dInOff + base + iz * inH * inW + iy * inW + ix] = arena[dInOff + base + iz * inH * inW + iy * inW + ix] + dy * w000;
                                    arena[dInOff + base + iz * inH * inW + iy * inW + ix2] = arena[dInOff + base + iz * inH * inW + iy * inW + ix2] + dy * w100;
                                    arena[dInOff + base + iz * inH * inW + iy2 * inW + ix] = arena[dInOff + base + iz * inH * inW + iy2 * inW + ix] + dy * w010;
                                    arena[dInOff + base + iz * inH * inW + iy2 * inW + ix2] = arena[dInOff + base + iz * inH * inW + iy2 * inW + ix2] + dy * w110;
                                    arena[dInOff + base + iz2 * inH * inW + iy * inW + ix] = arena[dInOff + base + iz2 * inH * inW + iy * inW + ix] + dy * w001;
                                    arena[dInOff + base + iz2 * inH * inW + iy * inW + ix2] = arena[dInOff + base + iz2 * inH * inW + iy * inW + ix2] + dy * w101;
                                    arena[dInOff + base + iz2 * inH * inW + iy2 * inW + ix] = arena[dInOff + base + iz2 * inH * inW + iy2 * inW + ix] + dy * w011;
                                    arena[dInOff + base + iz2 * inH * inW + iy2 * inW + ix2] = arena[dInOff + base + iz2 * inH * inW + iy2 * inW + ix2] + dy * w111;
                                }
                                x = x + 1;
                            }
                            y = y + 1;
                        }
                        z = z + 1;
                    }
                    c = c + 1;
                }
                n = n + 1;
            }
        }
}
