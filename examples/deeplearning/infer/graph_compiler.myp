// graph_compiler.myp — Runtime tensor mapping storage + Graph IR -> runtime lowering.
import env;
import fmt;
import "./runtime.myp";
import "./graph_defs.myp";
import "./graph.myp";

class GraphCompiler {
    action:
        @constructor GraphCompiler() { reset(); }

        void reset() { tCount_ = 0; }

        int tensorId(string name) {
            int i = 0;
            while (i < tCount_) {
                if (tName_[i] == name) return tId_[i];
                i = i + 1;
            }
            return -1;
        }

        string nameAt(int index) { return index < 0 || index >= tCount_ ? "" : tName_[index]; }
        int idAt(int index) { return index < 0 || index >= tCount_ ? -1 : tId_[index]; }
        void addMapping(string name, int id) {
            if (tCount_ >= 512) return;
            tName_[tCount_] = name;
            tId_[tCount_] = id;
            tCount_ = tCount_ + 1;
        }

        // Lower the optimized IR into the runtime. `graph` provides all shape/weight/
        // node/plan state via its public compiler* accessors (MYP property privacy).
        int lower(Graph graph, InferenceRuntime rt) {
            // 1) 登记张量（按形状表顺序，用规划偏移；死张量跳过）
            int si = 0;
            while (si < graph.compilerShapeCount()) {
                if (graph.compilerShapeDead(si) == 1) { si = si + 1; continue; }
                string nm = graph.compilerShapeName(si);
                int kind = graph.compilerShapeKind(si);
                int d0 = graph.compilerShapeDim(si, 0); int d1 = graph.compilerShapeDim(si, 1); int d2 = graph.compilerShapeDim(si, 2); int d3 = graph.compilerShapeDim(si, 3);
                int off = graph.compilerPlanOff(si);
                int tid = -1;
                if (kind == Kind.FC_ACT()) {
                    tid = rt.addTensorPlanned2(d1, d0, off);            // ONNX [M,N] → 运行时 [N,M]
                } else if (kind == Kind.FC_W()) {
                    int ii = graph.compilerWeightIdx(nm);
                    if (ii >= 0 && graph.compilerWeightTransposed(ii) == 1) tid = rt.addTensorPlanned2(d0, d1, off);   // [N,K]
                    else tid = rt.addTensorPlanned2(d1, d0, off);       // [K,N] → [N,K]
                } else if (kind == Kind.FC_B()) {
                    tid = rt.addTensorPlanned2(d0, 1, off);             // [N] → [N,1]
                } else if (kind == Kind.CNN_B()) {
                    tid = rt.addTensorPlanned2(d0, 1, off);             // [Cout] → [Cout,1]
                } else if (kind == Kind.FC_C()) {
                    tid = rt.addTensorPlanned2(d0, d1, off);            // G2：折叠常量，直接拷贝 [d0,d1]
                } else if (kind == Kind.FC_G()) {
                    // 阶段2：权重梯度——布局镜像基底权重（含 transB，保证 Update 对齐）
                    string base = graph.stripGrad(nm);
                    int ii = graph.compilerWeightIdx(base);
                    if (ii >= 0 && graph.compilerWeightTransposed(ii) == 1) tid = rt.addTensorPlanned2(d0, d1, off);
                    else tid = rt.addTensorPlanned2(d1, d0, off);
                } else if (graph.compilerShapeR5(si) == 1) {
                    tid = rt.addTensorPlanned5(d0, d1, d2, d3, graph.compilerShapeDim(si, 4), off);  // 3D：CNN 权重/激活 NCDHW
                } else if (graph.compilerShapeNhwc(si) == 1) {
                    tid = rt.addTensorPlanned4(d0, d2, d3, d1, off);    // G2：NHWC 激活 [N,H,W,C] / 权重 [Cout,KH,KW,Cin]
                } else {
                    tid = rt.addTensorPlanned4(d0, d1, d2, d3, off);    // CNN 权重/激活 NCHW
                }
                if (tid < 0) return 0;
                addMapping(nm, tid);
                if (Console.getEnv("MYP_DUMP_TENSORS") == "1") {
                    int fd = __myp_io_fopen("/tmp/fine_tensors.txt", "ab");
                    if (fd >= 0) {
                        __myp_io_write("t" + Fmt.i(tid) + " name=" + nm +
                                       " d0=" + Fmt.i(d0) + " d1=" + Fmt.i(d1) + " d2=" + Fmt.i(d2) + " d3=" + Fmt.i(d3) +
                                       " d4=" + Fmt.i((graph.compilerShapeR5(si) == 1) ? graph.compilerShapeDim(si, 4) : 1) + " r5=" + Fmt.i(graph.compilerShapeR5(si)) + " off=" + Fmt.i(off) + "\n");
                        __myp_io_fclose();
                    }
                }
                si = si + 1;
            }
            // 2) 接线算子（按拓扑序：G2 转置节点先于消费者执行）
            int oi = 0;
            while (oi < graph.compilerPlanOrderCount()) {
                int ni = graph.compilerPlanOrder(oi);
                if (graph.nodeTypeAt(ni) == "") { oi = oi + 1; continue; }   // 死节点跳过
                int code = graph.nodeOp(ni);   // P3b：按 op 枚举分派
                int a = tensorId(graph.nodeInAt(ni, 0));
                int out = tensorId(graph.compilerEffectiveOut(ni));     // G2：融合节点用有效输出（nFusedOut_）
                // 反向节点豁免 out 检查：dx（slot0）可为空（图输入 fan-out 的 BwdDense），
                // 输出槽在各自分派分支内做空安全处理（tensorId("")=-1 → addXxx 接受）。
                int bwdLike = 0;
                if (code >= OpCode.BWD_DENSE() && code <= OpCode.BWD_SOFTMAX()) bwdLike = 1;
                if (code == OpCode.BWD_SUB() || code == OpCode.BWD_MUL() || code == OpCode.BWD_DIV()) bwdLike = 1;
                if (code == OpCode.BWD_RESHAPE() || code == OpCode.BWD_TRANSPOSE()) bwdLike = 1;
                if (code == OpCode.BWD_EXPAND() || code == OpCode.BWD_TILE()) bwdLike = 1;
                if (code == OpCode.BWD_REDUCE()) bwdLike = 1;
                if (code == OpCode.BWD_GATHER()) bwdLike = 1;
                if (code == OpCode.BWD_AVGPOOL()) bwdLike = 1;
                if (code == OpCode.BWD_REDUCEMM()) bwdLike = 1;
                if (code == OpCode.BWD_PAD()) bwdLike = 1;
                if (code >= OpCode.BWD_RELU6() && code <= OpCode.BWD_CLIP()) bwdLike = 1;   // 激活反向
                if (a < 0 || (out < 0 && bwdLike == 0)) {
                    if (Console.getEnv("MYP_GR_DBG") == "1") {
                        Console.writeString("buildRuntime wire fail type=" + graph.nodeTypeAt(ni) + " in0=" + graph.nodeInAt(ni, 0) + "(" + Fmt.i(a) + ") out=" + graph.compilerEffectiveOut(ni) + "(" + Fmt.i(out) + ")");
                        Console.writeLine("");
                    }
                    return 0;
                }
                if (code == OpCode.GEMM()) {
                    int w = tensorId(graph.nodeInAt(ni, 1));
                    int b = tensorId(graph.nodeInAt(ni, 2));
                    rt.addDense(a, w, b, out);
                } else if (code == OpCode.MATMUL()) {
                    int w = tensorId(graph.nodeInAt(ni, 1));
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int ws = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    // 2D vs 4D/5D（与 inferShapes MatMul 判据一致）：双方 2D 视图 → addMatmul
                    int a2d = 1;
                    if (graph.compilerShapeR5(is) == 1) a2d = 0;
                    if (graph.compilerShapeDim(is, 2) > 1 || graph.compilerShapeDim(is, 3) > 1) a2d = 0;
                    int b2d = 1;
                    if (graph.compilerShapeR5(ws) == 1) b2d = 0;
                    if (graph.compilerShapeDim(ws, 2) > 1 || graph.compilerShapeDim(ws, 3) > 1) b2d = 0;
                    if (a2d == 0 || b2d == 0) {
                        // 阶段四：BatchMatMul——batch 维逐维 max + 最后两维 matmul
                        int aM = graph.compilerShapeDim(is, 2), aK = graph.compilerShapeDim(is, 3);
                        int bN = graph.compilerShapeDim(ws, 3);
                        int os = graph.compilerShapeIdx(graph.compilerEffectiveOut(ni));
                        if (os < 0) return 0;
                        int ob0 = graph.compilerShapeDim(os, 0), ob1 = graph.compilerShapeDim(os, 1);
                        rt.addBatchMatmul(a, w, out, aM, aK, bN,
                                          graph.compilerShapeDim(is, 0), graph.compilerShapeDim(is, 1),
                                          graph.compilerShapeDim(ws, 0), graph.compilerShapeDim(ws, 1),
                                          ob0, ob1);
                    } else {
                        rt.addMatmul(a, w, out);
                    }
                } else if (code == OpCode.ADD()) {
                    int b = tensorId(graph.nodeInAt(ni, 1));
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int bs = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    int an = 1, ac = 1, ah = 1, aw = 1, bn = 1, bc = 1, bh = 1, bw = 1;
                    if (is >= 0) { an = graph.compilerShapeDim(is, 0); ac = graph.compilerShapeDim(is, 1); ah = graph.compilerShapeDim(is, 2); aw = graph.compilerShapeDim(is, 3); }
                    if (bs >= 0) { bn = graph.compilerShapeDim(bs, 0); bc = graph.compilerShapeDim(bs, 1); bh = graph.compilerShapeDim(bs, 2); bw = graph.compilerShapeDim(bs, 3); }
                    rt.addAdd(a, b, out, graph.compilerAttrRelu(ni), an, ac, ah, aw, bn, bc, bh, bw);
                } else if (code == OpCode.RELU()) {
                    rt.addRelu(a, out);
                } else if (code == OpCode.SIGMOID()) {
                    rt.addSigmoid(a, out);
                } else if (code == OpCode.SOFTMAX()) {
                    rt.addSoftmax(a, out);
                } else if (code == OpCode.LAYER_NORM() || code == OpCode.RMS_NORM()) {
                    // 图归一化：复用 LLM kernel（opKind 64/61）。D/S 传 0 → Op 运行时自省
                    // tensor rows/cols（[D 特征, S 样本] 布局，归一特征行）。gamma=nodeIn1，
                    // LayerNorm beta=nodeIn2（可空 → b=-1，kernel bOff guard）。eps attr。
                    int g = tensorId(graph.nodeInAt(ni, 1));
                    double eps = graph.attrFloat(ni, NodeField.EPS_INT());
                    if (graph.compilerAttr(ni, NodeField.HAS_EPS()) != 1) eps = 1.0e-5;
                    if (code == OpCode.RMS_NORM()) {
                        rt.addRmsNorm(a, g, out, 0, 0, eps);
                    } else {
                        int b = tensorId(graph.nodeInAt(ni, 2));
                        rt.addLayerNorm(a, g, b, out, 0, 0, eps);
                    }
                } else if (code == OpCode.GELU()) {
                    // GELU（精确 erf 近似；n 传 0 → Op 自省 rows*cols）
                    rt.addGelu(a, out, 0);
                } else if (code == OpCode.BWD_DENSE()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int w = tensorId(graph.nodeInAt(ni, 2));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    int dw = tensorId(graph.compilerNodeOutput(ni, 1));
                    int db = -1;
                    if (graph.compilerNodeOutput(ni, 2) != "") db = tensorId(graph.compilerNodeOutput(ni, 2));
                    rt.addBwdDense(dy, x, w, dx, dw, db);
                } else if (code == OpCode.BWD_RELU()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdRelu(dy, x, dx);
                } else if (code == OpCode.BWD_SIGMOID()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int y = tensorId(graph.nodeInAt(ni, 1));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdSigmoid(dy, y, dx);
                } else if (code == OpCode.BWD_RELU6()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdRelu6(dy, x, dx);
                } else if (code == OpCode.BWD_LEAKY_RELU()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdLeakyRelu(dy, x, dx, graph.compilerAttr(ni, NodeField.ALPHA_INT()), graph.compilerAttr(ni, NodeField.HAS_ALPHA()));
                } else if (code == OpCode.BWD_SILU()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdSilu(dy, x, dx);
                } else if (code == OpCode.BWD_HARDSWISH()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdHardSwish(dy, x, dx);
                } else if (code == OpCode.BWD_LOG_SOFTMAX()) {
                    // outer/axisDim/inner 从 x shape + axis 推（同 fwd LOG_SOFTMAX 分支）
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    int axis = graph.compilerAttr(ni, NodeField.AXIS());
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    if (is < 0) return 0;
                    int rank = 4;
                    if (graph.compilerShapeR5(is) == 1) rank = 5;
                    int[] dd = new int[5];
                    dd[0] = graph.compilerShapeDim(is, 0); dd[1] = graph.compilerShapeDim(is, 1); dd[2] = graph.compilerShapeDim(is, 2); dd[3] = graph.compilerShapeDim(is, 3); dd[4] = 1;
                    if (rank == 5) dd[4] = graph.compilerShapeDim(is, 4);
                    if (axis < 0) axis = axis + rank;
                    if (axis < 0) axis = 0;
                    if (axis >= rank) axis = rank - 1;
                    int outer = 1, axisDim = 1, inner = 1;
                    int k = 0;
                    while (k < axis) { outer = outer * dd[k]; k = k + 1; }
                    axisDim = dd[axis];
                    k = axis + 1;
                    while (k < rank) { inner = inner * dd[k]; k = k + 1; }
                    rt.addBwdLogSoftmax(dy, x, dx, outer, axisDim, inner);
                } else if (code == OpCode.BWD_CLIP()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int minT = tensorId(graph.nodeInAt(ni, 2));
                    int maxT = tensorId(graph.nodeInAt(ni, 3));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdClip(dy, x, dx, minT, maxT);
                } else if (code == OpCode.BWD_ADD()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int da = tensorId(graph.compilerNodeOutput(ni, 0));
                    int db = tensorId(graph.compilerNodeOutput(ni, 1));
                    rt.addBwdAdd(dy, da, db);
                } else if (code == OpCode.BWD_SUB() || code == OpCode.BWD_MUL() || code == OpCode.BWD_DIV()) {
                    // A2：Sub/Mul/Div 反向（A=dy,B=x0,C=x1,D=dx0,P0=dx1）
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x0 = tensorId(graph.nodeInAt(ni, 1));
                    int x1 = tensorId(graph.nodeInAt(ni, 2));
                    int dx0 = tensorId(graph.compilerNodeOutput(ni, 0));
                    int dx1 = tensorId(graph.compilerNodeOutput(ni, 1));
                    if (code == OpCode.BWD_SUB()) rt.addBwdSub(dy, x0, x1, dx0, dx1);
                    else if (code == OpCode.BWD_MUL()) rt.addBwdMul(dy, x0, x1, dx0, dx1);
                    else rt.addBwdDiv(dy, x0, x1, dx0, dx1);
                } else if (code == OpCode.BWD_RESHAPE()) {
                    // B：Reshape 反向（dy → dx 连续拷贝；dx 可空 = 图输入 Reshape）
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdReshape(dy, dx);
                } else if (code == OpCode.BWD_TRANSPOSE()) {
                    // B：Transpose 反向（逆排列搬回 x 布局；x dims 从 nodeIn1 shape）
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    int p0 = graph.compilerAttr(ni, NodeField.PERM0()), p1 = graph.compilerAttr(ni, NodeField.PERM1()), p2 = graph.compilerAttr(ni, NodeField.PERM2()), p3 = graph.compilerAttr(ni, NodeField.PERM3());
                    int pc = graph.compilerAttr(ni, NodeField.PERM_N());
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    int id0 = 1, id1 = 1, id2 = 1, id3 = 1;
                    if (is >= 0) { id0 = graph.compilerShapeDim(is, 0); id1 = graph.compilerShapeDim(is, 1); id2 = graph.compilerShapeDim(is, 2); id3 = graph.compilerShapeDim(is, 3); }
                    rt.addBwdTranspose(dy, dx, p0, p1, p2, p3, pc, id0, id1, id2, id3);
                } else if (code == OpCode.BWD_EXPAND() || code == OpCode.BWD_TILE()) {
                    // B2：Expand/Tile 反向（dy → 源坐标 scatter-add 回 dx）。
                    // id = x(nodeIn1) dims；od = dy(nodeIn0=前向输出 grad) shape。
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    int id0 = 1, id1 = 1, id2 = 1, id3 = 1;
                    if (is >= 0) { id0 = graph.compilerShapeDim(is, 0); id1 = graph.compilerShapeDim(is, 1); id2 = graph.compilerShapeDim(is, 2); id3 = graph.compilerShapeDim(is, 3); }
                    int os = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int od0 = id0, od1 = id1, od2 = id2, od3 = id3;
                    if (os >= 0) { od0 = graph.compilerShapeDim(os, 0); od1 = graph.compilerShapeDim(os, 1); od2 = graph.compilerShapeDim(os, 2); od3 = graph.compilerShapeDim(os, 3); }
                    if (code == OpCode.BWD_EXPAND()) rt.addBwdExpand(dy, dx, id0, id1, id2, id3, od0, od1, od2, od3);
                    else rt.addBwdTile(dy, dx, id0, id1, id2, id3, od0, od1, od2, od3);
                } else if (code == OpCode.BWD_REDUCE()) {
                    // B：ReduceSum/Mean 反向（dy 广播回 dx；mode/redType 在 buildReverseGraph 复制）
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    int mode = graph.compilerReduceMode(ni);
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    int N = 1, C = 1, S = 1;
                    if (is >= 0) {
                        N = graph.compilerShapeDim(is, 0); C = graph.compilerShapeDim(is, 1);
                        S = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3);
                        if (graph.compilerShapeR5(is) == 1) S = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3) * graph.compilerShapeDim(is, 4);
                    }
                    int total = N * C * S;
                    rt.addBwdReduce(dy, dx, mode, N, C, S, total, graph.compilerNRedType(ni));
                } else if (code == OpCode.BWD_GATHER()) {
                    // B：Gather 反向（dy scatter-add 回 data 梯度 dx）。
                    // indices = nodeIn2（同 fwd GATHER：readI64Init 建临时 f32 idxT）。
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    int axis = graph.compilerAttr(ni, NodeField.AXIS());
                    if (axis < 0) axis = 0;
                    int lenIdx = graph.compilerReadI64Init(graph.nodeInAt(ni, 2), 64);
                    if (lenIdx <= 0) return 0;
                    int idxT = rt.addTensor(lenIdx, 1);
                    if (idxT < 0) return 0;
                    int k = 0;
                    while (k < lenIdx) { rt.setFlat(idxT, k, double(int(graph.compilerI64Tmp(k)))); k = k + 1; }
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    int dn = 1, dc = 1, dh = 1, dw = 1;
                    if (is >= 0) { dn = graph.compilerShapeDim(is, 0); dc = graph.compilerShapeDim(is, 1); dh = graph.compilerShapeDim(is, 2); dw = graph.compilerShapeDim(is, 3); }
                    rt.addBwdGather(dy, idxT, dx, axis, lenIdx, dn, dc, dh, dw);
                } else if (code == OpCode.BWD_REDUCEMM()) {
                    // B：ReduceMax/Min 反向（argmax 掩码；x=nodeIn1 供重算最值位置）
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    int mode = graph.compilerReduceMode(ni);
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    int N = 1, C = 1, S = 1;
                    if (is >= 0) {
                        N = graph.compilerShapeDim(is, 0); C = graph.compilerShapeDim(is, 1);
                        S = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3);
                        if (graph.compilerShapeR5(is) == 1) S = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3) * graph.compilerShapeDim(is, 4);
                    }
                    int total = N * C * S;
                    rt.addBwdReduceMM(dy, x, dx, mode, N, C, S, total, graph.compilerNRedType(ni));
                } else if (code == OpCode.BWD_PAD()) {
                    // B：Pad(constant) 反向（dx = dy 中心区）；begin/end 存 attr 组 3/4
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdPad(dy, x, dx,
                        graph.compilerAttrIntArray(ni, 3, 0), graph.compilerAttrIntArray(ni, 3, 1),
                        graph.compilerAttrIntArray(ni, 3, 2), graph.compilerAttrIntArray(ni, 3, 3),
                        graph.compilerAttrIntArray(ni, 4, 0), graph.compilerAttrIntArray(ni, 4, 1),
                        graph.compilerAttrIntArray(ni, 4, 2), graph.compilerAttrIntArray(ni, 4, 3));
                } else if (code == OpCode.BWD_AVGPOOL()) {
                    // A：AvgPool2D 反向（dy 窗口均摊回 dx；参数复制自 fwd 节点）
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdAvgPool(dy, x, dx,
                        graph.compilerAttr(ni, NodeField.KH()), graph.compilerAttr(ni, NodeField.KW()),
                        graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()),
                        graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()),
                        graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()),
                        graph.compilerAttr(ni, NodeField.CIP()));
                } else if (code == OpCode.BWD_CONV()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int w = tensorId(graph.nodeInAt(ni, 2));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    int dw = tensorId(graph.compilerNodeOutput(ni, 1));
                    int db = -1;
                    if (graph.compilerNodeOutput(ni, 2) != "") db = tensorId(graph.compilerNodeOutput(ni, 2));
                    rt.addBwdConv(dy, x, w, dx, dw, db,
                                  graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.DH()), graph.compilerAttr(ni, NodeField.DW()), graph.compilerAttr(ni, NodeField.GROUP()));
                } else if (code == OpCode.BWD_MAXPOOL()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdMaxPool(dy, x, dx, graph.compilerAttr(ni, NodeField.KH()), graph.compilerAttr(ni, NodeField.KW()), graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PL()));
                } else if (code == OpCode.BWD_CONV3D()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int w = tensorId(graph.nodeInAt(ni, 2));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    int dw = tensorId(graph.compilerNodeOutput(ni, 1));
                    int db = -1;
                    if (graph.compilerNodeOutput(ni, 2) != "") db = tensorId(graph.compilerNodeOutput(ni, 2));
                    rt.addBwdConv3D(dy, x, w, dx, dw, db,
                                    graph.compilerAttr(ni, NodeField.SD3()), graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()),
                                    graph.compilerAttr(ni, NodeField.PDT()), graph.compilerAttr(ni, NodeField.PDB()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()),
                                    graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()));
                } else if (code == OpCode.BWD_MAXPOOL3D()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdMaxPool3D(dy, x, dx,
                                       graph.compilerAttr(ni, NodeField.KD3()), graph.compilerAttr(ni, NodeField.KH()), graph.compilerAttr(ni, NodeField.KW()),
                                       graph.compilerAttr(ni, NodeField.SD3()), graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()),
                                       graph.compilerAttr(ni, NodeField.PDT()), graph.compilerAttr(ni, NodeField.PDB()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()),
                                       graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()));
                } else if (code == OpCode.BWD_AVGPOOL3D()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdAvgPool3D(dy, x, dx,
                                       graph.compilerAttr(ni, NodeField.KD3()), graph.compilerAttr(ni, NodeField.KH()), graph.compilerAttr(ni, NodeField.KW()),
                                       graph.compilerAttr(ni, NodeField.SD3()), graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()),
                                       graph.compilerAttr(ni, NodeField.PDT()), graph.compilerAttr(ni, NodeField.PDB()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()),
                                       graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()), graph.compilerAttr(ni, NodeField.CIP()));
                } else if (code == OpCode.BWD_CONVTRANSPOSE()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int w = tensorId(graph.nodeInAt(ni, 2));
                    int dx = tensorId(graph.compilerNodeOutput(ni, 0));
                    int dw = tensorId(graph.compilerNodeOutput(ni, 1));
                    int db = -1;
                    if (graph.compilerNodeOutput(ni, 2) != "") db = tensorId(graph.compilerNodeOutput(ni, 2));
                    rt.addBwdConvTranspose(dy, x, w, dx, dw, db,
                                           graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()));
                } else if (code == OpCode.BWD_RESIZE()) {
                    int dOut = tensorId(graph.nodeInAt(ni, 0));
                    int x = tensorId(graph.nodeInAt(ni, 1));
                    int dIn = tensorId(graph.compilerNodeOutput(ni, 0));
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    int os = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    if (os >= 0 && is >= 0 && graph.compilerShapeR5(os) == 1) {
                        int inD = graph.compilerShapeDim(is, 2); int inH = graph.compilerShapeDim(is, 3); int inW = graph.compilerShapeDim(is, 4);
                        int outD = graph.compilerShapeDim(os, 2); int outH = graph.compilerShapeDim(os, 3); int outW = graph.compilerShapeDim(os, 4);
                        rt.addBwdResize3d(dOut, dIn, inD, inH, inW, outD, outH, outW,
                                          graph.compilerAttr(ni, NodeField.MODE()), graph.compilerAttr(ni, NodeField.TRANSFORM()));
                    }
                } else if (code == OpCode.DICE_LOSS()) {
                    int p = tensorId(graph.nodeInAt(ni, 0));
                    int y = tensorId(graph.nodeInAt(ni, 1));
                    int dp = tensorId(graph.compilerNodeOutput(ni, 0));
                    int lo = tensorId(graph.compilerNodeOutput(ni, 1));
                    rt.addDiceLoss(p, y, dp, lo, graph.compilerDiceWMode());
                } else if (code == OpCode.BWD_SOFTMAX()) {
                    int dp = tensorId(graph.nodeInAt(ni, 0));
                    int p = tensorId(graph.nodeInAt(ni, 1));
                    int dl = tensorId(graph.compilerNodeOutput(ni, 0));
                    rt.addBwdSoftmax(dp, p, dl);
                } else if (code == OpCode.SOFTMAX_CE()) {
                    int lg = tensorId(graph.nodeInAt(ni, 0));
                    int lb = tensorId(graph.nodeInAt(ni, 1));
                    int dl = tensorId(graph.compilerNodeOutput(ni, 0));
                    int lo = tensorId(graph.compilerNodeOutput(ni, 1));
                    rt.addSoftmaxCE(lg, lb, dl, lo);
                } else if (code == OpCode.UPDATE()) {
                    int w = tensorId(graph.nodeInAt(ni, 0));
                    int g = tensorId(graph.nodeInAt(ni, 1));
                    rt.addUpdate(w, g);
                    rt.prepOptState(w);
                } else if (code == OpCode.RE_LU6()) {
                    rt.addReLU6(a, out);
                } else if (code == OpCode.LEAKY_RELU()) {
                    rt.addLeakyRelu(a, out, graph.compilerAttr(ni, NodeField.ALPHA_INT()), graph.compilerAttr(ni, NodeField.HAS_ALPHA()));
                } else if (code == OpCode.SILU()) {
                    rt.addSiLU(a, out);
                } else if (code == OpCode.HARD_SWISH()) {
                    rt.addHardSwish(a, out);
                } else if (code == OpCode.CLIP()) {
                    rt.addClip(a, out, tensorId(graph.nodeInAt(ni, 1)), tensorId(graph.nodeInAt(ni, 2)));
                } else if (code == OpCode.CONVTRANSPOSE()) {
                    int w = tensorId(graph.nodeInAt(ni, 1));
                    int b = tensorId(graph.nodeInAt(ni, 2));
                    rt.addConvTranspose(a, w, b, out, graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()),
                                        graph.compilerAttr(ni, NodeField.OPH()), graph.compilerAttr(ni, NodeField.OPW()), graph.compilerAttr(ni, NodeField.GROUP()));
                } else if (code == OpCode.SPLIT()) {
                    int inS = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int d0 = 1, d1 = 1, d2 = 1, d3 = 1;
                    if (inS >= 0) { d0 = graph.compilerShapeDim(inS, 0); d1 = graph.compilerShapeDim(inS, 1); d2 = graph.compilerShapeDim(inS, 2); d3 = graph.compilerShapeDim(inS, 3); }
                    int no = graph.compilerAttrOutputCount(ni); if (no < 1) no = 1;
                    int j = 0;
                    while (j < no && j < 4) {
                        string onm = graph.compilerNodeOutput(ni, j);
                        int o = tensorId(onm);
                        if (o >= 0) {
                            rt.addSplit(a, o, graph.compilerAttr(ni, NodeField.AXIS()), graph.attrIntArr(ni, 6, j), graph.attrIntArr(ni, 7, j),
                                        d0, d1, d2, d3, 1);
                        }
                        j = j + 1;
                    }
                } else if (code == OpCode.CONV()) {
                    int w = tensorId(graph.nodeInAt(ni, 1));
                    int b = tensorId(graph.nodeInAt(ni, 2));
                    if (graph.nodeInAt(ni, 3) != "") {
                        int resid = tensorId(graph.nodeInAt(ni, 3));
                        rt.addConvResidual(a, w, b, out, resid,
                                           graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()),
                                           graph.compilerAttr(ni, NodeField.DH()), graph.compilerAttr(ni, NodeField.DW()), graph.compilerAttr(ni, NodeField.GROUP()), graph.compilerAttrRelu(ni));
                    } else if (graph.compilerAttrNhwc(ni) == 1) {
                        if (graph.compilerAttrRelu(ni) == 1) rt.addConvNHWCRelu(a, w, b, out, graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()), graph.compilerAttr(ni, NodeField.DH()), graph.compilerAttr(ni, NodeField.DW()), graph.compilerAttr(ni, NodeField.GROUP()));
                        else rt.addConvNHWC(a, w, b, out, graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()), graph.compilerAttr(ni, NodeField.DH()), graph.compilerAttr(ni, NodeField.DW()), graph.compilerAttr(ni, NodeField.GROUP()));
                    } else if (graph.compilerAttrRelu(ni) == 1) {
                        // G5：Conv 1x1 专用——kh==kw==1 && stride==1 && 无 padding && dil==1 && group==1
                        int kh = graph.compilerAttr(ni, NodeField.KH()); if (kh <= 0) kh = 1;
                        int kw = graph.compilerAttr(ni, NodeField.KW()); if (kw <= 0) kw = 1;
                        if (kh == 1 && kw == 1 && graph.compilerAttr(ni, NodeField.SH()) == 1 && graph.compilerAttr(ni, NodeField.SW()) == 1 &&
                            graph.compilerAttr(ni, NodeField.PT()) == 0 && graph.compilerAttr(ni, NodeField.PB()) == 0 &&
                            graph.compilerAttr(ni, NodeField.PL()) == 0 && graph.compilerAttr(ni, NodeField.PR()) == 0 &&
                            graph.compilerAttr(ni, NodeField.DH()) == 1 && graph.compilerAttr(ni, NodeField.DW()) == 1 &&
                            graph.compilerAttr(ni, NodeField.GROUP()) == 1) {
                            rt.addConv1x1(a, w, b, out, 1);
                        } else rt.addConvRelu(a, w, b, out, graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()), graph.compilerAttr(ni, NodeField.DH()), graph.compilerAttr(ni, NodeField.DW()), graph.compilerAttr(ni, NodeField.GROUP()));
                    } else {
                        // G5：Conv 1x1 专用（同上，无 ReLU）
                        int kh = graph.compilerAttr(ni, NodeField.KH()); if (kh <= 0) kh = 1;
                        int kw = graph.compilerAttr(ni, NodeField.KW()); if (kw <= 0) kw = 1;
                        if (kh == 1 && kw == 1 && graph.compilerAttr(ni, NodeField.SH()) == 1 && graph.compilerAttr(ni, NodeField.SW()) == 1 &&
                            graph.compilerAttr(ni, NodeField.PT()) == 0 && graph.compilerAttr(ni, NodeField.PB()) == 0 &&
                            graph.compilerAttr(ni, NodeField.PL()) == 0 && graph.compilerAttr(ni, NodeField.PR()) == 0 &&
                            graph.compilerAttr(ni, NodeField.DH()) == 1 && graph.compilerAttr(ni, NodeField.DW()) == 1 &&
                            graph.compilerAttr(ni, NodeField.GROUP()) == 1) {
                            rt.addConv1x1(a, w, b, out, 0);
                        } else rt.addConv(a, w, b, out, graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()), graph.compilerAttr(ni, NodeField.DH()), graph.compilerAttr(ni, NodeField.DW()), graph.compilerAttr(ni, NodeField.GROUP()));
                    }
                } else if (code == OpCode.CONV3D()) {
                    int w = tensorId(graph.nodeInAt(ni, 1));
                    int b = tensorId(graph.nodeInAt(ni, 2));
                    int sd = graph.compilerAttr(ni, NodeField.SD3()); if (sd <= 0) sd = 1;
                    int sh_ = graph.compilerAttr(ni, NodeField.SH()); if (sh_ <= 0) sh_ = 1;
                    int sw_ = graph.compilerAttr(ni, NodeField.SW()); if (sw_ <= 0) sw_ = 1;
                    int dd = graph.compilerAttr(ni, NodeField.DD3()); if (dd <= 0) dd = 1;
                    int dh = graph.compilerAttr(ni, NodeField.DH()); if (dh <= 0) dh = 1;
                    int dw = graph.compilerAttr(ni, NodeField.DW()); if (dw <= 0) dw = 1;
                    rt.addConv3D(a, w, b, out, sd, sh_, sw_,
                        graph.compilerAttr(ni, NodeField.PDT()), graph.compilerAttr(ni, NodeField.PDB()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()),
                        dd, dh, dw, graph.compilerAttr(ni, NodeField.GROUP()));
                } else if (code == OpCode.MAXPOOL3D()) {
                    int sd = graph.compilerAttr(ni, NodeField.SD3()); if (sd <= 0) sd = 1;
                    int sh_ = graph.compilerAttr(ni, NodeField.SH()); if (sh_ <= 0) sh_ = 1;
                    int sw_ = graph.compilerAttr(ni, NodeField.SW()); if (sw_ <= 0) sw_ = 1;
                    int kd = graph.compilerAttr(ni, NodeField.KD3()); if (kd <= 0) kd = 1;
                    int kh = graph.compilerAttr(ni, NodeField.KH()); if (kh <= 0) kh = 1;
                    int kw = graph.compilerAttr(ni, NodeField.KW()); if (kw <= 0) kw = 1;
                    rt.addMaxPool3D(a, out, kd, kh, kw, sd, sh_, sw_,
                        graph.compilerAttr(ni, NodeField.PDT()), graph.compilerAttr(ni, NodeField.PDB()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()));
                } else if (code == OpCode.AVGPOOL3D()) {
                    int sd = graph.compilerAttr(ni, NodeField.SD3()); if (sd <= 0) sd = 1;
                    int sh_ = graph.compilerAttr(ni, NodeField.SH()); if (sh_ <= 0) sh_ = 1;
                    int sw_ = graph.compilerAttr(ni, NodeField.SW()); if (sw_ <= 0) sw_ = 1;
                    int kd = graph.compilerAttr(ni, NodeField.KD3()); if (kd <= 0) kd = 1;
                    int kh = graph.compilerAttr(ni, NodeField.KH()); if (kh <= 0) kh = 1;
                    int kw = graph.compilerAttr(ni, NodeField.KW()); if (kw <= 0) kw = 1;
                    rt.addAvgPool3D(a, out, kd, kh, kw, sd, sh_, sw_,
                        graph.compilerAttr(ni, NodeField.PDT()), graph.compilerAttr(ni, NodeField.PDB()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()), graph.compilerAttr(ni, NodeField.CIP()));
                } else if (code == OpCode.MAXPOOL()) {
                    if (graph.compilerAttrNhwc(ni) == 1) rt.addMaxPoolNHWC(a, out, graph.compilerAttr(ni, NodeField.KH()), graph.compilerAttr(ni, NodeField.KW()), graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()));
                    else rt.addMaxPool(a, out, graph.compilerAttr(ni, NodeField.KH()), graph.compilerAttr(ni, NodeField.KW()), graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()));
                } else if (code == OpCode.AVGPOOL()) {
                    if (graph.compilerAttrNhwc(ni) == 1) rt.addAvgPoolNHWC(a, out, graph.compilerAttr(ni, NodeField.KH()), graph.compilerAttr(ni, NodeField.KW()), graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()), graph.compilerAttr(ni, NodeField.CIP()));
                    else rt.addAvgPool(a, out, graph.compilerAttr(ni, NodeField.KH()), graph.compilerAttr(ni, NodeField.KW()), graph.compilerAttr(ni, NodeField.SH()), graph.compilerAttr(ni, NodeField.SW()), graph.compilerAttr(ni, NodeField.PT()), graph.compilerAttr(ni, NodeField.PB()), graph.compilerAttr(ni, NodeField.PL()), graph.compilerAttr(ni, NodeField.PR()), graph.compilerAttr(ni, NodeField.CIP()));
                } else if (code == OpCode.PAD()) {
                    int is5 = 0;
                    int pin = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    if (pin >= 0 && graph.compilerShapeR5(pin) == 1) is5 = 1;
                    if (is5 == 1) {
                        rt.addPad3D(a, out,
                            graph.compilerAttrIntArray(ni, 5, 0), graph.compilerAttrIntArray(ni, 12, 0), graph.compilerAttrIntArray(ni, 5, 1), graph.compilerAttrIntArray(ni, 12, 1), graph.compilerAttrIntArray(ni, 5, 2),
                            graph.compilerAttrIntArray(ni, 12, 2), graph.compilerAttrIntArray(ni, 5, 3), graph.compilerAttrIntArray(ni, 12, 3), graph.compilerAttrIntArray(ni, 5, 4), graph.compilerAttrIntArray(ni, 12, 4),
                            graph.compilerAttr(ni, NodeField.PADMODE()), graph.compilerPadCval(ni));
                    } else if (graph.compilerAttrNhwc(ni) == 1) rt.addPadNHWC(a, out,
                        graph.compilerAttrIntArray(ni, 3, 0), graph.compilerAttrIntArray(ni, 3, 2), graph.compilerAttrIntArray(ni, 3, 3), graph.compilerAttrIntArray(ni, 3, 1),
                        graph.compilerAttrIntArray(ni, 4, 0), graph.compilerAttrIntArray(ni, 4, 2), graph.compilerAttrIntArray(ni, 4, 3), graph.compilerAttrIntArray(ni, 4, 1),
                        graph.compilerAttr(ni, NodeField.PADMODE()), graph.compilerPadCval(ni));
                    else rt.addPad(a, out,
                        graph.compilerAttrIntArray(ni, 3, 0), graph.compilerAttrIntArray(ni, 3, 1), graph.compilerAttrIntArray(ni, 3, 2), graph.compilerAttrIntArray(ni, 3, 3),
                        graph.compilerAttrIntArray(ni, 4, 0), graph.compilerAttrIntArray(ni, 4, 1), graph.compilerAttrIntArray(ni, 4, 2), graph.compilerAttrIntArray(ni, 4, 3),
                        graph.compilerAttr(ni, NodeField.PADMODE()), graph.compilerPadCval(ni));
                } else if (code == OpCode.GLOBAL_AVG_POOL()) {
                    if (graph.compilerAttrNhwc(ni) == 1) rt.addGAPoolNHWC(a, out);
                    else rt.addGAPool(a, out);
                } else if (code == OpCode.NCHW2NHWC()) {
                    rt.addTransposeNCHW2NHWC(a, out);
                } else if (code == OpCode.FLATTEN()) {
                    rt.addFlatten(a, out);
                } else if (code == OpCode.BATCH_NORM()) {
                    int sT = tensorId(graph.nodeInAt(ni, 1));
                    int bT = tensorId(graph.nodeInAt(ni, 2));
                    int mT = tensorId(graph.nodeInAt(ni, 3));
                    int vT = tensorId(graph.nodeInAt(ni, 4));
                    if (sT < 0 || bT < 0 || mT < 0 || vT < 0) return 0;
                    if (graph.compilerAttrNhwc(ni) == 1) rt.addBatchNormNHWC(a, out, sT, bT, mT, vT, graph.compilerAttr(ni, NodeField.EPS_INT()), graph.compilerAttr(ni, NodeField.HAS_EPS()));
                    else rt.addBatchNorm(a, out, sT, bT, mT, vT, graph.compilerAttr(ni, NodeField.EPS_INT()), graph.compilerAttr(ni, NodeField.HAS_EPS()));
                } else if (code == OpCode.RESHAPE()) {
                    rt.addReshape(a, out);
                } else if (code == OpCode.CONCAT()) {
                    int b = tensorId(graph.nodeInAt(ni, 1));
                    int c = tensorId(graph.nodeInAt(ni, 2));
                    int nIn = 2;
                    if (c >= 0) nIn = 3;
                    int axis = graph.compilerAttr(ni, NodeField.AXIS());
                    if (axis < 0) axis = 0;
                    int os = graph.compilerShapeIdx(graph.compilerEffectiveOut(ni));
                    int is5 = 0;
                    int s0in = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    if (s0in >= 0 && graph.compilerShapeR5(s0in) == 1) is5 = 1;
                    int od0 = graph.compilerShapeDim(os, 0), od1 = graph.compilerShapeDim(os, 1), od2 = graph.compilerShapeDim(os, 2), od3 = graph.compilerShapeDim(os, 3);
                    if (is5 == 1) od3 = graph.compilerShapeDim(os, 3) * graph.compilerShapeDim(os, 4);
                    int ax0 = 0, ax1 = 0, ax2 = 0;
                    int s0 = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    if (s0 >= 0) ax0 = (axis == 0) ? graph.compilerShapeDim(s0, 0) : ((axis == 1) ? graph.compilerShapeDim(s0, 1) : ((axis == 2) ? graph.compilerShapeDim(s0, 2) : graph.compilerShapeDim(s0, 3)));
                    int s1 = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    if (s1 >= 0) ax1 = (axis == 0) ? graph.compilerShapeDim(s1, 0) : ((axis == 1) ? graph.compilerShapeDim(s1, 1) : ((axis == 2) ? graph.compilerShapeDim(s1, 2) : graph.compilerShapeDim(s1, 3)));
                    int s2 = graph.compilerShapeIdx(graph.nodeInAt(ni, 2));
                    if (s2 >= 0) ax2 = (axis == 0) ? graph.compilerShapeDim(s2, 0) : ((axis == 1) ? graph.compilerShapeDim(s2, 1) : ((axis == 2) ? graph.compilerShapeDim(s2, 2) : graph.compilerShapeDim(s2, 3)));
                    rt.addConcat(a, b, c, out, axis, nIn, od0, od1, od2, od3, ax0, ax1, ax2);
                } else if (code == OpCode.BWD_CONCAT()) {
                    int dy = tensorId(graph.nodeInAt(ni, 0));
                    string dxn0 = graph.compilerNodeOutput(ni, 0);
                    if (Str.len(dxn0) >= 5 && Str.substring(dxn0, Str.len(dxn0) - 4, Str.len(dxn0)) == "_own") dxn0 = Str.substring(dxn0, 0, Str.len(dxn0) - 4);
                    int dx0 = tensorId(dxn0);
                    string dxn1 = graph.compilerNodeOutput(ni, 1);
                    if (Str.len(dxn1) >= 5 && Str.substring(dxn1, Str.len(dxn1) - 4, Str.len(dxn1)) == "_own") dxn1 = Str.substring(dxn1, 0, Str.len(dxn1) - 4);
                    int dx1 = tensorId(dxn1);
                    string dxn2 = graph.compilerNodeOutput(ni, 2);
                    if (Str.len(dxn2) >= 5 && Str.substring(dxn2, Str.len(dxn2) - 4, Str.len(dxn2)) == "_own") dxn2 = Str.substring(dxn2, 0, Str.len(dxn2) - 4);
                    int dx2 = tensorId(dxn2);
                    int nIn = 2;
                    if (dx2 >= 0) nIn = 3;
                    int axis = graph.compilerAttr(ni, NodeField.AXIS());
                    if (axis < 0) axis = 0;
                    int os = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int is5 = 0;
                    int od0 = 1, od1 = 1, od2 = 1, od3 = 1;
                    if (os >= 0) {
                        od0 = graph.compilerShapeDim(os, 0); od1 = graph.compilerShapeDim(os, 1); od2 = graph.compilerShapeDim(os, 2); od3 = graph.compilerShapeDim(os, 3);
                        if (graph.compilerShapeR5(os) == 1) od3 = graph.compilerShapeDim(os, 3) * graph.compilerShapeDim(os, 4);
                    }
                    int ax0 = 0, ax1 = 0, ax2 = 0;
                    int s0 = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    if (s0 >= 0) ax0 = (axis == 0) ? graph.compilerShapeDim(s0, 0) : ((axis == 1) ? graph.compilerShapeDim(s0, 1) : ((axis == 2) ? graph.compilerShapeDim(s0, 2) : graph.compilerShapeDim(s0, 3)));
                    int s1 = graph.compilerShapeIdx(graph.nodeInAt(ni, 2));
                    if (s1 >= 0) ax1 = (axis == 0) ? graph.compilerShapeDim(s1, 0) : ((axis == 1) ? graph.compilerShapeDim(s1, 1) : ((axis == 2) ? graph.compilerShapeDim(s1, 2) : graph.compilerShapeDim(s1, 3)));
                    int s2 = graph.compilerShapeIdx(graph.nodeInAt(ni, 3));
                    if (nIn >= 3 && s2 >= 0) ax2 = (axis == 0) ? graph.compilerShapeDim(s2, 0) : ((axis == 1) ? graph.compilerShapeDim(s2, 1) : ((axis == 2) ? graph.compilerShapeDim(s2, 2) : graph.compilerShapeDim(s2, 3)));
                    rt.addBwdConcat(dy, dx0, dx1, dx2, axis, nIn, od0, od1, od2, od3, ax0, ax1, ax2);
                } else if (code == OpCode.GRAD_ACC()) {
                    int g0 = tensorId(graph.nodeInAt(ni, 0));
                    int g1 = tensorId(graph.nodeInAt(ni, 1));
                    int gs = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int an = 1, ac = 1, ah = 1, aw = 1;
                    if (gs >= 0) { an = graph.compilerShapeDim(gs, 0); ac = graph.compilerShapeDim(gs, 1); ah = graph.compilerShapeDim(gs, 2); aw = graph.compilerShapeDim(gs, 3); }
                    rt.addAdd(g0, g1, tensorId(graph.compilerNodeOutput(ni, 0)), 0, an, ac, ah, aw, an, ac, ah, aw);
                } else if (code == OpCode.TRANSPOSE()) {
                    int p0 = graph.compilerAttr(ni, NodeField.PERM0()), p1 = graph.compilerAttr(ni, NodeField.PERM1()), p2 = graph.compilerAttr(ni, NodeField.PERM2()), p3 = graph.compilerAttr(ni, NodeField.PERM3());
                    int pc = graph.compilerAttr(ni, NodeField.PERM_N());
                    if (pc == 0) { p0 = 3; p1 = 2; p2 = 1; p3 = 0; }
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int id0 = graph.compilerShapeDim(is, 0), id1 = graph.compilerShapeDim(is, 1), id2 = graph.compilerShapeDim(is, 2), id3 = graph.compilerShapeDim(is, 3);
                    rt.addTranspose(a, out, p0, p1, p2, p3, pc, id0, id1, id2, id3);
                } else if (code == OpCode.SLICE()) {
                    int cnt = graph.compilerAttrSliceCount(ni);
                    if (cnt < 1) return 0;
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int id0 = graph.compilerShapeDim(is, 0), id1 = graph.compilerShapeDim(is, 1), id2 = graph.compilerShapeDim(is, 2), id3 = graph.compilerShapeDim(is, 3);
                    int os = graph.compilerShapeIdx(graph.compilerEffectiveOut(ni));
                    int od0 = graph.compilerShapeDim(os, 0), od1 = graph.compilerShapeDim(os, 1), od2 = graph.compilerShapeDim(os, 2), od3 = graph.compilerShapeDim(os, 3);
                    int ax0 = graph.attrIntArr(ni, 0, 0), st0 = graph.attrIntArr(ni, 1, 0), sp0 = graph.attrIntArr(ni, 2, 0);
                    int ax1 = graph.attrIntArr(ni, 0, 1), st1 = graph.attrIntArr(ni, 1, 1), sp1 = graph.attrIntArr(ni, 2, 1);
                    int ax2 = graph.attrIntArr(ni, 0, 2), st2 = graph.attrIntArr(ni, 1, 2), sp2 = graph.attrIntArr(ni, 2, 2);
                    int ax3 = graph.attrIntArr(ni, 0, 3), st3 = graph.attrIntArr(ni, 1, 3), sp3 = graph.attrIntArr(ni, 2, 3);
                    rt.addSlice(a, out, cnt, id0, id1, id2, id3, od0, od1, od2, od3,
                                ax0, st0, sp0, ax1, st1, sp1, ax2, st2, sp2, ax3, st3, sp3);
                } else if (code == OpCode.SUB()) {
                    int b = tensorId(graph.nodeInAt(ni, 1));
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int bs = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    int ss = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3);
                    if (graph.compilerShapeR5(is) == 1) ss = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3) * graph.compilerShapeDim(is, 4);
                    int an = graph.compilerShapeDim(is, 0), ac = graph.compilerShapeDim(is, 1), ah = graph.compilerShapeDim(is, 2), aw = graph.compilerShapeDim(is, 3);
                    int bn = 1, bc = 1, bh = 1, bw = 1;
                    if (bs >= 0) { bn = graph.compilerShapeDim(bs, 0); bc = graph.compilerShapeDim(bs, 1); bh = graph.compilerShapeDim(bs, 2); bw = graph.compilerShapeDim(bs, 3); }
                    rt.addSub(a, b, out, graph.compilerShapeDim(is, 1), ss, an, ac, ah, aw, bn, bc, bh, bw);
                } else if (code == OpCode.DIV()) {
                    int b = tensorId(graph.nodeInAt(ni, 1));
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int bs = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    int ss = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3);
                    if (graph.compilerShapeR5(is) == 1) ss = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3) * graph.compilerShapeDim(is, 4);
                    int an = graph.compilerShapeDim(is, 0), ac = graph.compilerShapeDim(is, 1), ah = graph.compilerShapeDim(is, 2), aw = graph.compilerShapeDim(is, 3);
                    int bn = 1, bc = 1, bh = 1, bw = 1;
                    if (bs >= 0) { bn = graph.compilerShapeDim(bs, 0); bc = graph.compilerShapeDim(bs, 1); bh = graph.compilerShapeDim(bs, 2); bw = graph.compilerShapeDim(bs, 3); }
                    rt.addDiv(a, b, out, graph.compilerShapeDim(is, 1), ss, an, ac, ah, aw, bn, bc, bh, bw);
                } else if (code == OpCode.MUL()) {
                    int b = tensorId(graph.nodeInAt(ni, 1));
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int bs = graph.compilerShapeIdx(graph.nodeInAt(ni, 1));
                    int ss = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3);
                    if (graph.compilerShapeR5(is) == 1) ss = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3) * graph.compilerShapeDim(is, 4);
                    int an = graph.compilerShapeDim(is, 0), ac = graph.compilerShapeDim(is, 1), ah = graph.compilerShapeDim(is, 2), aw = graph.compilerShapeDim(is, 3);
                    int bn = 1, bc = 1, bh = 1, bw = 1;
                    if (bs >= 0) { bn = graph.compilerShapeDim(bs, 0); bc = graph.compilerShapeDim(bs, 1); bh = graph.compilerShapeDim(bs, 2); bw = graph.compilerShapeDim(bs, 3); }
                    rt.addMul(a, b, out, graph.compilerShapeDim(is, 1), ss, an, ac, ah, aw, bn, bc, bh, bw);
                } else if (code == OpCode.SQRT()) {
                    rt.addSqrt(a, out);
                } else if (code == OpCode.REDUCE_MEAN() || code == OpCode.REDUCE_SUM() || code == OpCode.REDUCE_MAX() || code == OpCode.REDUCE_MIN()) {
                    int mode = graph.compilerReduceMode(ni);
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int N = graph.compilerShapeDim(is, 0), C = graph.compilerShapeDim(is, 1);
                    int S = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3);
                    if (graph.compilerShapeR5(is) == 1) S = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3) * graph.compilerShapeDim(is, 4);
                    int total = N * C * S;
                    rt.addReduceMean(a, out, mode, N, C, S, total, graph.compilerAttr(ni, NodeField.KEEP()), graph.compilerNRedType(ni));
                } else if (code == OpCode.EXPAND()) {
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int os = graph.compilerShapeIdx(graph.compilerEffectiveOut(ni));
                    if (os < 0) return 0;
                    int id0 = graph.compilerShapeDim(is, 0), id1 = graph.compilerShapeDim(is, 1), id2 = graph.compilerShapeDim(is, 2), id3 = graph.compilerShapeDim(is, 3);
                    int od0 = graph.compilerShapeDim(os, 0), od1 = graph.compilerShapeDim(os, 1), od2 = graph.compilerShapeDim(os, 2), od3 = graph.compilerShapeDim(os, 3);
                    rt.addExpand(a, out, id0, id1, id2, id3, od0, od1, od2, od3);
                } else if (code == OpCode.WHERE()) {
                    int xt = tensorId(graph.nodeInAt(ni, 1));
                    int yt = tensorId(graph.nodeInAt(ni, 2));
                    if (xt < 0 || yt < 0) return 0;
                    rt.addWhere(a, xt, yt, out);
                } else if (code == OpCode.TILE()) {
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int os = graph.compilerShapeIdx(graph.compilerEffectiveOut(ni));
                    if (os < 0) return 0;
                    int id0 = graph.compilerShapeDim(is, 0), id1 = graph.compilerShapeDim(is, 1), id2 = graph.compilerShapeDim(is, 2), id3 = graph.compilerShapeDim(is, 3);
                    int od0 = graph.compilerShapeDim(os, 0), od1 = graph.compilerShapeDim(os, 1), od2 = graph.compilerShapeDim(os, 2), od3 = graph.compilerShapeDim(os, 3);
                    rt.addTile(a, out, id0, id1, id2, id3, od0, od1, od2, od3);
                } else if (code == OpCode.SQUEEZE()) {
                    // G5：去掉 size-1 维。数据不变 → 连续拷贝（同 reshape）。
                    rt.addSqueeze(a, out);
                } else if (code == OpCode.GATHER()) {
                    // G5：沿 axis 按 indices 收集。indices int64 初始器 → readI64Init
                    // 读入临时 f32 张量（int→float，<2^24 精确），kernel 按 gatherRows 模式读。
                    int axis = graph.compilerAttr(ni, NodeField.AXIS());
                    if (axis < 0) axis = 0;
                    int lenIdx = graph.compilerReadI64Init(graph.nodeInAt(ni, 1), 64);
                    if (lenIdx <= 0) return 0;
                    int idxT = rt.addTensor(lenIdx, 1);
                    if (idxT < 0) return 0;
                    int k = 0;
                    while (k < lenIdx) { rt.setFlat(idxT, k, double(int(graph.compilerI64Tmp(k)))); k = k + 1; }
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int os = graph.compilerShapeIdx(graph.compilerEffectiveOut(ni));
                    if (os < 0) return 0;
                    int dn = graph.compilerShapeDim(is, 0), dc = graph.compilerShapeDim(is, 1), dh = graph.compilerShapeDim(is, 2), dw = graph.compilerShapeDim(is, 3);
                    rt.addGather(a, idxT, out, axis, lenIdx, dn, dc, dh, dw);
                } else if (code == OpCode.LOG_SOFTMAX()) {
                    // G5：沿 axis 的稳定 log-softmax。outer/axisDim/inner 由图维度算。
                    int axis = graph.compilerAttr(ni, NodeField.AXIS());
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    if (is < 0) return 0;
                    int rank = 4;
                    if (graph.compilerShapeR5(is) == 1) rank = 5;
                    int[] dd = new int[5];
                    dd[0] = graph.compilerShapeDim(is, 0); dd[1] = graph.compilerShapeDim(is, 1); dd[2] = graph.compilerShapeDim(is, 2); dd[3] = graph.compilerShapeDim(is, 3); dd[4] = 1;
                    if (rank == 5) dd[4] = graph.compilerShapeDim(is, 4);
                    if (axis < 0) axis = axis + rank;
                    if (axis < 0) axis = 0;
                    if (axis >= rank) axis = rank - 1;
                    int outer = 1, axisDim = 1, inner = 1;
                    int k = 0;
                    while (k < axis) { outer = outer * dd[k]; k = k + 1; }
                    axisDim = dd[axis];
                    k = axis + 1;
                    while (k < rank) { inner = inner * dd[k]; k = k + 1; }
                    rt.addLogSoftmax(a, out, axis, outer, axisDim, inner);
                } else if (code == OpCode.EMBEDDING()) {
                    // G5：查表 out[s*D+d] = w[ids[s]*D+d]。ids int64 初始器 → 临时 f32 张量。
                    int lenS = graph.compilerReadI64Init(graph.nodeInAt(ni, 1), 64);
                    if (lenS <= 0) return 0;
                    int idxT = rt.addTensor(lenS, 1);
                    if (idxT < 0) return 0;
                    int k = 0;
                    while (k < lenS) { rt.setFlat(idxT, k, double(int(graph.compilerI64Tmp(k)))); k = k + 1; }
                    int ws = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    if (ws < 0) return 0;
                    int vocab = graph.compilerShapeDim(ws, 0);
                    int D = graph.compilerShapeDim(ws, 1);
                    rt.addEmbedding(a, idxT, out, vocab, D, lenS);
                } else if (code == OpCode.DROPOUT()) {
                    // G5：Dropout。ratio f32 初始器（opset12 输入[1]，推理忽略）；
                    // 训练/推理由 rt.trainMode() 决定（推理恒等，训练随机 mask）。
                    double ratio = 0.5;
                    int rc = graph.compilerReadF32Init(graph.nodeInAt(ni, 1), 1);
                    if (rc > 0) ratio = graph.compilerF32Tmp(0);
                    rt.addDropout(a, out, F32.toBits(ratio));
                } else if (code == OpCode.INSTANCE_NORM()) {
                    int sT = tensorId(graph.nodeInAt(ni, 1));
                    int bT = tensorId(graph.nodeInAt(ni, 2));
                    if (sT < 0 || bT < 0) return 0;
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int N = graph.compilerShapeDim(is, 0), C = graph.compilerShapeDim(is, 1);
                    int S = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3);
                    if (graph.compilerShapeR5(is) == 1) S = graph.compilerShapeDim(is, 2) * graph.compilerShapeDim(is, 3) * graph.compilerShapeDim(is, 4);
                    rt.addInstanceNorm(a, sT, bT, out, N, C, S, graph.compilerAttr(ni, NodeField.EPS_INT()), graph.compilerAttr(ni, NodeField.HAS_EPS()), graph.compilerAttrRelu(ni));
                } else if (code == OpCode.RESIZE() || code == OpCode.UPSAMPLE()) {
                    int is = graph.compilerShapeIdx(graph.nodeInAt(ni, 0));
                    int os = graph.compilerShapeIdx(graph.compilerEffectiveOut(ni));
                    int N = graph.compilerShapeDim(is, 0), C = graph.compilerShapeDim(is, 1), inH = graph.compilerShapeDim(is, 2), inW = graph.compilerShapeDim(is, 3);
                    int outH = graph.compilerShapeDim(os, 2), outW = graph.compilerShapeDim(os, 3);
                    if (graph.compilerShapeR5(is) == 1) {
                        int inD = graph.compilerShapeDim(is, 2), outD = graph.compilerShapeDim(os, 2);
                        int inH3 = graph.compilerShapeDim(is, 3), inW3 = graph.compilerShapeDim(is, 4);
                        int outH3 = graph.compilerShapeDim(os, 3), outW3 = graph.compilerShapeDim(os, 4);
                        rt.addResize3d(a, out, inD, inH3, inW3, outD, outH3, outW3, graph.compilerAttr(ni, NodeField.MODE()), graph.compilerAttr(ni, NodeField.TRANSFORM()));
                    } else {
                        rt.addResize2d(a, out, N, C, inH, inW, outH, outW, graph.compilerAttr(ni, NodeField.MODE()), graph.compilerAttr(ni, NodeField.TRANSFORM()));
                    }
                } else {
                    if (Console.getEnv("MYP_GR_DBG") == "1") {
                        Console.writeString("buildRuntime unsupported node type=" + graph.nodeTypeAt(ni));
                        Console.writeLine("");
                    }
                    return 0;
                }
                oi = oi + 1;
            }
            // 3) 写权重
            int wi = 0;
            while (wi < graph.weightCount()) {
                int tid = tensorId(graph.weightName(wi));
                if (tid < 0) { wi = wi + 1; continue; }
                graph.compilerWriteWeight(rt, wi, tid);
                wi = wi + 1;
            }
            return 1;
        }

    property:
        string[512] tName_;
        int[512] tId_;
        int tCount_;
}
