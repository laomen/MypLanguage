// tensor.myp — Minimal tensor utilities for inference runtime
import env;

class TensorOps {
    static:
        int size(int rows, int cols) { return rows * cols; }

        int flatIndex(int cols, int r, int c) {
            return r * cols + c;
        }

        void zero(double[] buf, int offset, int count) {
            int i = 0;
            while (i < count) {
                buf[offset + i] = 0.0;
                i = i + 1;
            }
        }
}
