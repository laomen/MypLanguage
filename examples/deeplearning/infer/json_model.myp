// json_model.myp — 声明式 JSON 模型 → 直接构建框架 Graph（不经过 ONNX）。
// 用户写层式 JSON 描述网络 → 本 loader 填 Graph（节点/形状/内存权重）→ 复用
// optimize(推理) / optimizeTrain(训练自动补 label+loss+反向)。权重走 GraphWeights
// 内存通道（offset=-2，值存 memVal_，writeWeight 直写 arena）。
//
// JSON schema（层式 DAG；op 名 = 框架 node type，fan-out 靠名字引用、fan-in 用
//   in2/in3/in4 多输入槽）：
//   { "name":"mlp",
//     "inputs":[{"name":"data","dims":[1,784]}],
//     "outputs":["prob"],
//     "layers":[
//       {"op":"Gemm","in":"data","out":"h","transB":1,
//        "W":{"dims":[64,784],"init":"xavier"},"B":{"dims":[64],"init":"zeros"}},
//       {"op":"Relu","in":"h","out":"h"},
//       {"op":"Gemm","in":"h","out":"logits","transB":1,
//        "W":{"dims":[10,64],"init":"xavier"},"B":{"dims":[10],"init":"zeros"}},
//       {"op":"Softmax","in":"logits","out":"prob","axis":1}
//     ]}
//   op 集（多分支/多输入）：单输入 Relu/Sigmoid/Softmax(axis)/GlobalAveragePool/
//     Flatten(axis)；二元 fan-in Add/Sub/Div/Mul/MatMul(in+in2)；多输入 Concat
//     (in+in2/in3+axis)；权重型 Gemm/Conv/ConvTranspose(W+B)/MatMul(可选 W)。
//   Conv/MaxPool/AveragePool 额外参数：kernel/strides/pads/dilations/group。
//   pads 顺序 ONNX 约定 [top,left,bottom,right]。权重 init：
//     xavier(U(-a,a) a=sqrt(6/(fan_in+fan_out)))/zeros/ones/const(v)/gauss(m,s)，
//     或 safetensors:{file,tensor} 权重源。确定性：LCG(seed=42+layer) —— 可复现。
import env;
import io;
import fmt;
import math;
import json;
import "./graph.myp";
import "./runtime.myp";
import "./safetensors.myp";

class JsonModelLoader {
    action:
        @constructor JsonModelLoader() {
            g_ = new Graph();
            phase_ = 0; loadErr_ = 0; compileErr_ = 0; runErr_ = 0;
            seed_ = 42;
        }

        // 构建并编译：train=0 推理（optimize），1 训练（optimizeTrain 自动补 label/loss+反向）
        int loadJson(string path, InferenceRuntime rt, int train) {
            phase_ = 1; loadErr_ = 0; compileErr_ = 0;
            try {
                File f = new File();
                int ok = f.open(path, "rb");
                string content = f.readAll();
                f.close();
                try {
                    Json j = new Json(content);
                    int r = buildGraph(j, rt, train);
                    j.free();
                    if (r == 0) return 0;
                } catch (JsonError e) {
                    loadErr_ = 3;
                    return 0;
                }
            } catch (FileError e) {
                loadErr_ = 1;
                return 0;
            }
            phase_ = 2;
            int okC = 0;
            if (train == 1) okC = g_.optimizeTrain(rt);
            else okC = g_.optimize(rt);
            if (okC == 0) { compileErr_ = 1; return 0; }
            if (rt.opCount() <= 0) { compileErr_ = 2; return 0; }
            phase_ = 3;
            return 1;
        }

        int phase() { return phase_; }
        int loadError() { return loadErr_; }
        int compileError() { return compileErr_; }
        int runError() { return runErr_; }
        Graph graph() { return g_; }
        int tensorId(string name) { return g_.tensorId(name); }
        string tensorName(int tid) { return g_.tensorName(tid); }
        int shapeElementCount(string name) { return g_.shapeElementCount(name); }
        int graphInputCount() { return g_.graphInputCount(); }
        string graphInputName(int i) { return g_.graphInputName(i); }
        int graphOutputCount() { return g_.graphOutputCount(); }
        string graphOutputName(int i) { return g_.graphOutputName(i); }
        int runRuntime(InferenceRuntime rt) {
            phase_ = 3;
            rt.run();
            return 1;
        }
        int runGpuRuntime(InferenceRuntime rt) {
            phase_ = 3;
            rt.runGpu();
            return 1;
        }
        int compileMs() { return 0; }
        int lastRunMs() { return 0; }
        int lastRunOps() { return 0; }

    function:
        // ---- JSON 导航辅助 ----
        int arrLen(Json j, string p) { if (j.type(p) == -1) return 0; return j.arrayLen(p); }
        string gstr(Json j, string p, string dflt) { if (j.type(p) == -1) return dflt; return j.getString(p); }
        int gint(Json j, string p, int dflt) { if (j.type(p) == -1) return dflt; return j.getInt(p); }
        int gdimsCount(Json j, string p) { if (j.type(p) == -1) return 0; return j.arrayLen(p); }
        int gdim(Json j, string p, int i) { return j.getInt(p + "." + Fmt.i(i)); }

        // ---- Graph 构建 ----
        int buildGraph(Json j, InferenceRuntime rt, int train) {
            g_.resetCounts();
            // 1) 输入：addGraphInput + 形状 + GRAPH_IN
            int nin = arrLen(j, "inputs");
            int i = 0;
            while (i < nin) {
                string p = "inputs." + Fmt.i(i);
                string nm = gstr(j, p + ".name", "");
                int nd = gdimsCount(j, p + ".dims");
                if (nm == "" || nd == 0) return 0;
                int[] dims = new int[8];
                int k = 0;
                while (k < nd && k < 8) { dims[k] = gdim(j, p + ".dims", k); k = k + 1; }
                g_.addGraphInput(nm);
                g_.addShapeD(nm, dims, nd);
                g_.setValueRole(nm, TensorRole.GRAPH_IN());
                g_.setValueDType(nm, DType.FLOAT());
                i = i + 1;
            }
            // 2) 预注册所有层权重（先于节点，isWeightName 需已存在；仿 ONNX initializer 先于 node）
            int nly = arrLen(j, "layers");
            int ly = 0;
            while (ly < nly) {
                string lp = "layers." + Fmt.i(ly);
                string op = gstr(j, lp + ".op", "");
                string out = gstr(j, lp + ".out", "");
                if (op == "Gemm" || op == "Conv" || op == "ConvTranspose") {
                    if (registerWeight(j, lp + ".W", out + "_W") == 0) return 0;
                    if (j.type(lp + ".B") != -1) {
                        if (registerWeight(j, lp + ".B", out + "_b") == 0) return 0;
                    }
                } else if (op == "MatMul" && j.type(lp + ".W") != -1) {
                    // MatMul 可选权重作第二输入（dims=[K,N]，wire [K,N] 不转置）
                    if (registerWeight(j, lp + ".W", out + "_W") == 0) return 0;
                } else if (op == "Reshape" && j.type(lp + ".shape") != -1) {
                    // A3：int64 shape 参数（内存 int64 常量，readI64Init 内存分支读）
                    if (regI64Arr(j, lp + ".shape", out + "_shape") == 0) return 0;
                } else if (op == "Expand" && j.type(lp + ".shape") != -1) {
                    // A3 扩展：int64 shape 参数（同 Reshape 模式）
                    if (regI64Arr(j, lp + ".shape", out + "_shape") == 0) return 0;
                } else if (op == "Tile" && j.type(lp + ".repeats") != -1) {
                    // A3 扩展：int64 repeats 参数
                    if (regI64Arr(j, lp + ".repeats", out + "_rep") == 0) return 0;
                } else if (op == "Gather" && j.type(lp + ".indices") != -1) {
                    // A3：int64 indices 参数
                    if (regI64Arr(j, lp + ".indices", out + "_idx") == 0) return 0;
                }
                ly = ly + 1;
            }
            // 3) 层 → 节点（op 分派：输入槽 + 属性；多分支 fan-out 靠名字引用、
            //    fan-in 汇合用 in2/in3/in4 多输入槽）
            ly = 0;
            while (ly < nly) {
                string lp = "layers." + Fmt.i(ly);
                string op = gstr(j, lp + ".op", "");
                string inm = gstr(j, lp + ".in", "");
                string out = gstr(j, lp + ".out", "");
                if (op == "" || inm == "" || out == "") { ly = ly + 1; continue; }
                string in2 = gstr(j, lp + ".in2", "");
                string in3 = gstr(j, lp + ".in3", "");
                string in4 = gstr(j, lp + ".in4", "");
                int ni = g_.beginNode();
                g_.nodeType(ni, op);
                g_.nodeIn(ni, 0, inm);
                if (op == "Gemm") {
                    g_.nodeIn(ni, 1, out + "_W");
                    if (j.type(lp + ".B") != -1) g_.nodeIn(ni, 2, out + "_b");
                    g_.nodeInt(ni, NodeField.TRANSB(), gint(j, lp + ".transB", 1));
                } else if (op == "Conv" || op == "ConvTranspose") {
                    g_.nodeIn(ni, 1, out + "_W");
                    if (j.type(lp + ".B") != -1) g_.nodeIn(ni, 2, out + "_b");
                    setKernelAttrs(j, lp, ni);
                    g_.nodeInt(ni, NodeField.GROUP(), gint(j, lp + ".group", 1));
                } else if (op == "Add" || op == "Sub" || op == "Div" || op == "Mul" || op == "MatMul") {
                    // 二元/广播 fan-in：第二输入 in2（MatMul 也可用可选 W 权重）
                    string b2 = in2;
                    if (op == "MatMul" && b2 == "" && j.type(lp + ".W") != -1) b2 = out + "_W";
                    if (b2 != "") g_.nodeIn(ni, 1, b2);
                } else if (op == "Concat") {
                    // 多输入 fan-in 拼接：in + in2/in3/in4（最多 3 输入，runtime opA/B/C）
                    if (in2 != "") g_.nodeIn(ni, 1, in2);
                    if (in3 != "") g_.nodeIn(ni, 2, in3);
                    if (in4 != "") g_.nodeIn(ni, 3, in4);
                    g_.nodeInt(ni, NodeField.AXIS(), gint(j, lp + ".axis", 1));
                } else if (op == "Softmax" || op == "LogSoftmax") {
                    g_.nodeInt(ni, NodeField.AXIS(), gint(j, lp + ".axis", 1));
                } else if (op == "Flatten") {
                    // axis 属性（框架固定按 axis=1 语义拍平剩余维）
                    g_.nodeInt(ni, NodeField.AXIS(), gint(j, lp + ".axis", 1));
                } else if (op == "Reshape") {
                    // A3：Reshape 到目标 shape（int64 常量；-1 推断，0 复制对应输入维）
                    if (j.type(lp + ".shape") != -1) g_.nodeIn(ni, 1, out + "_shape");
                } else if (op == "Gather") {
                    // A3：沿 axis 收集 indices 行（int64 indices 常量）
                    if (j.type(lp + ".indices") != -1) g_.nodeIn(ni, 1, out + "_idx");
                    g_.nodeInt(ni, NodeField.AXIS(), gint(j, lp + ".axis", 0));
                } else if (op == "MaxPool" || op == "AveragePool") {
                    // 池化：kernel/strides/pads（补 V1 缺口）
                    setKernelAttrs(j, lp, ni);
                } else if (op == "Expand") {
                    // A3 扩展：broadcast 复制到目标 shape（int64 shape 常量，nodeIn1）
                    if (j.type(lp + ".shape") != -1) g_.nodeIn(ni, 1, out + "_shape");
                } else if (op == "Tile") {
                    // A3 扩展：沿各维按倍数复制（int64 repeats 常量，nodeIn1）
                    if (j.type(lp + ".repeats") != -1) g_.nodeIn(ni, 1, out + "_rep");
                } else if (op == "ReduceSum" || op == "ReduceMean" || op == "ReduceMax" || op == "ReduceMin") {
                    // A3 扩展：归约（axes 属性 int 数组 AXES0-3+AXES_N；keepdims 可选）
                    setIntArr(j, lp, "axes", NodeField.AXES0(), NodeField.AXES_N(), ni);
                    if (j.type(lp + ".keepdims") != -1) g_.nodeInt(ni, NodeField.KEEP(), gint(j, lp + ".keepdims", 1));
                } else if (op == "Squeeze") {
                    // A3 扩展：去 size-1 维（axes 属性可选；缺省 → 全 size-1）
                    setIntArr(j, lp, "axes", NodeField.AXES0(), NodeField.AXES_N(), ni);
                } else if (op == "Transpose") {
                    // A3 扩展：perm 属性（缺省 → 反转维度）
                    setIntArr(j, lp, "perm", NodeField.PERM0(), NodeField.PERM_N(), ni);
                }
                // Sigmoid/Relu/GlobalAveragePool 单输入无附加属性
                g_.nodeOut(ni, out);
                g_.endNode();
                ly = ly + 1;
            }
            // 4) 图输出
            int nout = arrLen(j, "outputs");
            int o = 0;
            while (o < nout) {
                string nm = j.getString("outputs." + Fmt.i(o));
                g_.addGraphOutput(nm);
                g_.setValueRole(nm, TensorRole.GRAPH_OUT());
                g_.setValueDType(nm, DType.FLOAT());
                o = o + 1;
            }
            return 1;
        }

        // 设置节点 int 数组属性（AXES0-3/AXES_N、PERM0-3/PERM_N 等连续字段 base+k）
        void setIntArr(Json j, string lp, string key, int base, int cntField, int ni) {
            if (j.type(lp + "." + key) == -1) return;
            int n = j.arrayLen(lp + "." + key);
            if (n > 4) n = 4;
            g_.nodeInt(ni, cntField, n);
            int k = 0;
            while (k < n) { g_.nodeInt(ni, base + k, gdim(j, lp + "." + key, k)); k = k + 1; }
        }

        // Conv/MaxPool/AveragePool kernel/strides/pads 属性（ONNX pads 序 [top,left,bottom,right]）
        void setKernelAttrs(Json j, string lp, int ni) {
            if (j.type(lp + ".kernel") != -1) {
                int kh = gdim(j, lp + ".kernel", 0);
                int kw = gdim(j, lp + ".kernel", 1);
                g_.nodeInt(ni, NodeField.KH(), kh);
                g_.nodeInt(ni, NodeField.KW(), kw);
            }
            if (j.type(lp + ".strides") != -1) {
                g_.nodeInt(ni, NodeField.SH(), gdim(j, lp + ".strides", 0));
                g_.nodeInt(ni, NodeField.SW(), gdim(j, lp + ".strides", 1));
            }
            if (j.type(lp + ".pads") != -1) {
                // ONNX pads [top,left,bottom,right]
                g_.nodeInt(ni, NodeField.PT(), gdim(j, lp + ".pads", 0));
                g_.nodeInt(ni, NodeField.PL(), gdim(j, lp + ".pads", 1));
                g_.nodeInt(ni, NodeField.PB(), gdim(j, lp + ".pads", 2));
                g_.nodeInt(ni, NodeField.PR(), gdim(j, lp + ".pads", 3));
            }
            if (j.type(lp + ".dilations") != -1) {
                g_.nodeInt(ni, NodeField.DH(), gdim(j, lp + ".dilations", 0));
                g_.nodeInt(ni, NodeField.DW(), gdim(j, lp + ".dilations", 1));
            }
        }

        // 注册内存 int64 常量（A3）：读 JSON int64 数组 → GraphWeights 内存 i64 通道
        //（offset=-3；readI64Init 内存分支读）。shape/indices 等参数 role=SHAPE + dtype INT64。
        int regI64Arr(Json j, string p, string nm) {
            int n = arrLen(j, p);
            if (n <= 0 || n > 64) return 0;
            long[] vals = new long[64];
            int k = 0;
            while (k < n) { vals[k] = long(gdim(j, p, k)); k = k + 1; }
            g_.addMemI64Weight(nm, 1, n, vals, n);
            int[] dims = new int[8];
            dims[0] = n;
            g_.addShapeD(nm, dims, 1);
            g_.setValueRole(nm, TensorRole.SHAPE());
            g_.setValueDType(nm, DType.INT64());
            return 1;
        }

        // 注册一个内存权重：解析 {dims, init?, value?} → GraphWeights 内存通道
        int registerWeight(Json j, string p, string nm) {
            int nd = gdimsCount(j, p + ".dims");
            if (nd == 0) return 0;
            int[] dims = new int[8];
            int k = 0;
            while (k < nd && k < 8) { dims[k] = gdim(j, p + ".dims", k); k = k + 1; }
            int total = 1;
            k = 0;
            while (k < nd) { total = total * dims[k]; k = k + 1; }
            if (total <= 0 || total > 4000000) return 0;
            float[] vals = new float[total];
            int filled = 0;
            if (j.type(p + ".safetensors") != -1) {
                // safetensors 权重源：按张量名从 .safetensors 读值（替代手动装配）
                string sf = gstr(j, p + ".safetensors.file", "");
                string stn = gstr(j, p + ".safetensors.tensor", "");
                SafeTensors st = new SafeTensors();
                int sok = st.load(sf);
                if (sok == 0) return 0;
                int got = st.readF32ByName(stn, vals, total);
                if (got < total) return 0;
                filled = 1;
            }
            if (filled == 0) {
            string init = gstr(j, p + ".init", "zeros");
            int fanIn = 1;
            if (nd == 2) fanIn = dims[1];
            else if (nd == 4) fanIn = dims[1] * dims[2] * dims[3];
            else fanIn = 1;
            int fanOut = 1;
            if (nd >= 2) fanOut = dims[0];
            seed_ = seed_ + 1013904223;
            int s = seed_ & 2147483647;
            if (init == "xavier") {
                double a = Math.sqrt(6.0 / double(fanIn + fanOut));
                k = 0;
                while (k < total) {
                    s = (s * 1103515245 + 12345) & 2147483647;
                    double u = double(s) / 2147483647.0;   // [0,1)
                    vals[k] = float((u * 2.0 - 1.0) * a);
                    k = k + 1;
                }
            } else if (init == "gauss") {
                double m = gint(j, p + ".mean", 0);
                double sd = gint(j, p + ".std", 1);
                if (j.type(p + ".mean") != -1) { m = j.getDouble(p + ".mean"); }
                if (j.type(p + ".std") != -1) { sd = j.getDouble(p + ".std"); }
                k = 0;
                while (k < total) {
                    s = (s * 1103515245 + 12345) & 2147483647;
                    double u1 = double(s) / 2147483647.0;
                    s = (s * 1103515245 + 12345) & 2147483647;
                    double u2 = double(s) / 2147483647.0;
                    double z = Math.sqrt(0.0 - 2.0 * Math.log(1.0 - u1)) * Math.cos(2.0 * 3.141592653589793 * u2);
                    vals[k] = float(m + sd * z);
                    k = k + 1;
                }
            } else if (init == "ones") {
                k = 0;
                while (k < total) { vals[k] = float(1.0); k = k + 1; }
            } else if (init == "const") {
                double c = 0.0;
                if (j.type(p + ".value") != -1) c = j.getDouble(p + ".value");
                k = 0;
                while (k < total) { vals[k] = float(c); k = k + 1; }
            } else {   // zeros（默认）
                k = 0;
                while (k < total) { vals[k] = float(0.0); k = k + 1; }
            }
            }   // filled==0（随机/常量 init）end——safetensors 源权重跳过 init
            // rows/cols 视图（对齐 ONNX parseTensor：2D rows=dims0 cols=dims1；≥3D rows=dims0 cols=prod rest）
            int rows = 1; int cols = 1;
            if (nd == 1) { rows = dims[0]; cols = 1; }
            else if (nd == 2) { rows = dims[0]; cols = dims[1]; }
            else {
                rows = dims[0]; cols = 1;
                k = 1;
                while (k < nd) { cols = cols * dims[k]; k = k + 1; }
            }
            g_.addMemWeight(nm, rows, cols, DType.FLOAT(), 1, vals, total);
            g_.addShapeD(nm, dims, nd);
            g_.setValueRole(nm, TensorRole.WEIGHT());
            g_.setValueDType(nm, DType.FLOAT());
            return 1;
        }

    property:
        Graph g_;
        int phase_;
        int loadErr_;
        int compileErr_;
        int runErr_;
        int seed_;
}
