// graph_weights.myp — Weight/initializer metadata for Graph IR.
// This component owns one SoA table. Callers use name/index/get/set rather than
// touching individual arrays, so the storage can move without changing passes.
import "./graph_defs.myp";

class GraphWeights {
    action:
        @constructor GraphWeights() {
            count_ = 0;
            memCap_ = 0; memCount_ = 0;
            memVal_ = new float[1024];
            memI64Cap_ = 0; memI64Count_ = 0;
            memI64Val_ = new long[1024];
        }

        void reset() { count_ = 0; memCount_ = 0; memI64Count_ = 0; }
        int count() { return count_; }
        int idx(string name) {
            int i = 0;
            while (i < count_) {
                if (name_[i] == name) return i;
                i = i + 1;
            }
            return -1;
        }
        string nameAt(int weight) { if (weight < 0 || weight >= count_) return ""; return name_[weight]; }
        int add(string name, int rows, int cols, int dtype, int kind, int offset, int length) {
            if (count_ >= 256) return -1;
            int weight = count_;
            name_[weight] = name;
            rows_[weight] = rows; cols_[weight] = cols; dtype_[weight] = dtype;
            kind_[weight] = kind; offset_[weight] = offset; length_[weight] = length;
            transposed_[weight] = 0; bias_[weight] = 0; role_[weight] = 0;
            nhwc_[weight] = 0; bn_[weight] = 0; bnOnly_[weight] = 0;
            count_ = count_ + 1;
            return weight;
        }
        int get(int weight, int field) {
            if (weight < 0 || weight >= count_) return field == WeightField.OFFSET() ? -1 : 0;
            if (field == WeightField.ROWS()) return rows_[weight];
            if (field == WeightField.COLS()) return cols_[weight];
            if (field == WeightField.DTYPE()) return dtype_[weight];
            if (field == WeightField.KIND()) return kind_[weight];
            if (field == WeightField.OFFSET()) return offset_[weight];
            if (field == WeightField.LENGTH()) return length_[weight];
            if (field == WeightField.TRANSPOSED()) return transposed_[weight];
            if (field == WeightField.BIAS()) return bias_[weight];
            if (field == WeightField.ROLE()) return role_[weight];
            if (field == WeightField.NHWC()) return nhwc_[weight];
            if (field == WeightField.BN()) return bn_[weight];
            if (field == WeightField.BN_NODE()) return bnNode_[weight];
            if (field == WeightField.BN_SCALE()) return bnScale_[weight];
            if (field == WeightField.BN_BIAS()) return bnBias_[weight];
            if (field == WeightField.BN_MEAN()) return bnMean_[weight];
            if (field == WeightField.BN_VAR()) return bnVar_[weight];
            if (field == WeightField.BN_ONLY()) return bnOnly_[weight];
            return 0;
        }
        void set(int weight, int field, int value) {
            if (weight < 0 || weight >= count_) return;
            if (field == WeightField.ROWS()) rows_[weight] = value;
            else if (field == WeightField.COLS()) cols_[weight] = value;
            else if (field == WeightField.DTYPE()) dtype_[weight] = value;
            else if (field == WeightField.KIND()) kind_[weight] = value;
            else if (field == WeightField.OFFSET()) offset_[weight] = value;
            else if (field == WeightField.LENGTH()) length_[weight] = value;
            else if (field == WeightField.TRANSPOSED()) transposed_[weight] = value;
            else if (field == WeightField.BIAS()) bias_[weight] = value;
            else if (field == WeightField.ROLE()) role_[weight] = value;
            else if (field == WeightField.NHWC()) nhwc_[weight] = value;
            else if (field == WeightField.BN()) bn_[weight] = value;
            else if (field == WeightField.BN_NODE()) bnNode_[weight] = value;
            else if (field == WeightField.BN_SCALE()) bnScale_[weight] = value;
            else if (field == WeightField.BN_BIAS()) bnBias_[weight] = value;
            else if (field == WeightField.BN_MEAN()) bnMean_[weight] = value;
            else if (field == WeightField.BN_VAR()) bnVar_[weight] = value;
            else if (field == WeightField.BN_ONLY()) bnOnly_[weight] = value;
        }

        // ---- 内存权重通道（JSON codegen 路径）：值存 memVal_，offset=-2 标记 ----
        void ensureMemCap(int need) {
            if (need <= memCap_) return;
            int newCap = memCap_ * 2;
            if (newCap < need) newCap = need;
            if (newCap < 1024) newCap = 1024;
            float[] na = new float[newCap];
            int i = 0;
            while (i < memCount_) { na[i] = memVal_[i]; i = i + 1; }
            memVal_ = na;
            memCap_ = newCap;
        }
        int addMem(string name, int rows, int cols, int dt, int kind, float[] vals, int n) {
            if (count_ >= 256) return -1;
            ensureMemCap(memCount_ + n);
            int weight = count_;
            name_[weight] = name;
            rows_[weight] = rows; cols_[weight] = cols; dtype_[weight] = dt;
            kind_[weight] = kind; offset_[weight] = -2; length_[weight] = n * 4;
            memOff_[weight] = memCount_;
            int i = 0;
            while (i < n) { memVal_[memCount_ + i] = vals[i]; i = i + 1; }
            memCount_ = memCount_ + n;
            transposed_[weight] = 0; bias_[weight] = 0; role_[weight] = 0;
            nhwc_[weight] = 0; bn_[weight] = 0; bnOnly_[weight] = 0;
            count_ = count_ + 1;
            return weight;
        }
        // 该权重是否为内存权重（offset=-2）；内存值起点（memVal_ 索引）
        int memBase(int weight) { if (weight < 0 || weight >= count_) return -1; return memOff_[weight]; }
        double memValD(int i) { double v = memVal_[i]; return v; }

        // ---- 内存 int64 常量通道（A3：JSON Reshape shape / Gather indices 等 int64
        //      参数，无 file_ 字节，offset=-3 标记；值存 long[] 池）----
        void ensureMemI64Cap(int need) {
            if (need <= memI64Cap_) return;
            int newCap = memI64Cap_ * 2;
            if (newCap < need) newCap = need;
            if (newCap < 1024) newCap = 1024;
            long[] na = new long[newCap];
            int i = 0;
            while (i < memI64Count_) { na[i] = memI64Val_[i]; i = i + 1; }
            memI64Val_ = na;
            memI64Cap_ = newCap;
        }
        int addMemI64(string name, int rows, int cols, long[] vals, int n) {
            if (count_ >= 256) return -1;
            ensureMemI64Cap(memI64Count_ + n);
            int weight = count_;
            name_[weight] = name;
            rows_[weight] = rows; cols_[weight] = cols; dtype_[weight] = 7;   // INT64
            kind_[weight] = 1; offset_[weight] = -3; length_[weight] = n * 8;
            memI64Off_[weight] = memI64Count_;
            int i = 0;
            while (i < n) { memI64Val_[memI64Count_ + i] = vals[i]; i = i + 1; }
            memI64Count_ = memI64Count_ + n;
            transposed_[weight] = 0; bias_[weight] = 0; role_[weight] = 0;
            nhwc_[weight] = 0; bn_[weight] = 0; bnOnly_[weight] = 0;
            count_ = count_ + 1;
            return weight;
        }
        int memI64Base(int weight) { if (weight < 0 || weight >= count_) return -1; return memI64Off_[weight]; }
        long memI64ValAt(int i) { long v = memI64Val_[i]; return v; }

    property:
        string[256] name_;
        int[256] rows_;
        int[256] cols_;
        int[256] dtype_;
        int[256] kind_;
        int[256] offset_;
        int[256] length_;
        int[256] transposed_;
        int[256] bias_;
        int[256] role_;
        int[256] nhwc_;
        int[256] bn_;
        int[256] bnNode_;
        int[256] bnScale_;
        int[256] bnBias_;
        int[256] bnMean_;
        int[256] bnVar_;
        int[256] bnOnly_;
        // 内存权重（JSON codegen）：值缓冲 + 每权重起点
        float[] memVal_;
        int[256] memOff_;
        int memCap_;
        int memCount_;
        // 内存 int64 常量（A3：JSON Reshape shape 等 int64 参数）
        long[] memI64Val_;
        int[256] memI64Off_;
        int memI64Cap_;
        int memI64Count_;
        int count_;
}