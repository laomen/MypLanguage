// graph.myp — 通用图优化器组件（G5 重构）
// 格式无关的图 IR + 图 pass 管线 + 内存规划 + 运行时构建。
// 由 onnx_loader.myp（ONNX 解析器）通过图构建 API（setFile/addWeight/addShapeD/
// beginNode/endNode/nodeXxx/addGraphOutput）填充，然后 optimize(rt) 跑完整管线：
//   foldConstants → inferShapes → classifyShapes → fuseConvBN → fuseConvRelu
//   → fuseGapFlatten → eliminateDeadNodes → layoutNHWC(opt-in) → topoSort
//   → planMemory → buildRuntime
// 常量类（Kind/NodeField/IRAnalysis/IRPassKind/OpCode）已拆至 graph_defs.myp。
import env;
import math;
import fmt;
import "./pb.myp";
import "./runtime.myp";
import "./graph_defs.myp";
import "./graph_shapes.myp";
import "./graph_weights.myp";
import "./graph_nodes.myp";
import "./graph_node_attrs.myp";
import "./graph_analysis.myp";
import "./graph_planner.myp";
import "./graph_compiler.myp";
import "./graph_optimizer.myp";

class Graph {
    interface class IGraphOptimizeHost;
    action:
        @constructor Graph() { pb_ = new PbReader(); shapes_ = new GraphShapes(); weights_ = new GraphWeights(); nodes_ = new GraphNodes(); attrs_ = new GraphNodeAttrs(); analysis_ = new GraphAnalysis(); planner_ = new GraphPlanner(); compiler_ = new GraphCompiler(); optimizer_ = new GraphOptimizer(); }

        int tensorId(string name) { return compiler_.tensorId(name); }

        // ---- 图统计（供验证入口打印；G5 由 Graph 自持）----
        void setLayoutNHWC(int v) { doNHWC_ = v; }
        int doNHWC() { return doNHWC_; }
        // 训练损失模式：0=SoftmaxCE（默认），1=Dice（分割，阶段4d）
        void setLossMode(int v) { lossMode_ = v; }
        int lossMode() { return lossMode_; }
        // 类不平衡 Dice：0=等权（默认），1=逆频率加权（setDiceWMode）
        void setDiceWMode(int v) { diceWMode_ = v; }
        int diceWMode() { return diceWMode_; }
        int fuseCount() { return fuseCount_; }
        int fusedAddCount() { return fusedAddCount_; }
        int gapCount() { return gapCount_; }
        int dceCount() { return dceCount_; }
        int foldCount() { return foldCount_; }
        int bnCount() { return bnCount_; }
        int nodeCount() { return nodes_.count(); }
        // ---- IR-P1 AnalysisManager（轻量）：generation 可断言调用方未使用过期分析。----
        int analysisGeneration() { return analysis_.analysisGeneration(); }
        int analysisValid(int mask) { return (analysis_.analysisValid() & mask) == mask ? 1 : 0; }
        int defUseGeneration() { return analysis_.duGeneration(); }
        int topoGeneration() { return analysis_.topoGeneration(); }
        int livenessGeneration() { return analysis_.livenessGeneration(); }
        // IR-P1b PassResult（MYP 无轻量 record 返回值，故由 Graph 保存最后一次执行结果）。
        int lastPassOk() { return analysis_.lastPassOk(); }
        int lastPassChanged() { return analysis_.lastPassChanged(); }
        int lastPassPreservedAnalyses() { return analysis_.lastPassPreserved(); }
        // P1c：P2 rewrite pass 首次声明 DefUse；legacy pass 直接扫描 SoA，依赖为 0。
        int passRequiredAnalyses(int pass) {
            if (pass == IRPassKind.IDENTITY_FOLD()) return IRAnalysis.DEF_USE();
            if (pass == IRPassKind.FOLD_RELU()) return IRAnalysis.DEF_USE();
            if (pass == IRPassKind.FUSE_BN()) return IRAnalysis.DEF_USE();
            if (pass == IRPassKind.FUSE_CONV_RELU()) return IRAnalysis.DEF_USE();
            if (pass == IRPassKind.FUSE_RELU()) return IRAnalysis.DEF_USE();
            if (pass == IRPassKind.FUSE_GAP_FLATTEN()) return IRAnalysis.DEF_USE();
            if (pass == IRPassKind.DCE()) return IRAnalysis.DEF_USE();
            if (pass == IRPassKind.FUSE_CONV_ADD()) return IRAnalysis.DEF_USE();
            return 0;
        }
        // 分析按需获取。ensureTopo 会先保证 DefUse；两者无 graph mutation，不改变 generation。
        int ensureDefUse() {
            if (analysis_.duValid() == 0 || analysisValid(IRAnalysis.DEF_USE()) == 0 || analysis_.duGeneration() != analysis_.analysisGeneration()) rebuildDefUse();
            return 1;
        }
        int ensureTopo() {
            if (analysisValid(IRAnalysis.TOPO()) == 0 || analysis_.topoGeneration() != analysis_.analysisGeneration()) return topoSort();
            return 1;
        }
        int ensurePassAnalyses(int pass) {
            int required = passRequiredAnalyses(pass);
            if ((required & IRAnalysis.DEF_USE()) != 0) { if (ensureDefUse() == 0) return 0; }
            if ((required & IRAnalysis.TOPO()) != 0) { if (ensureTopo() == 0) return 0; }
            // Liveness 只由 lowering 前 planMemory 显式构建；禁止在优化 pass 中隐式写规划结果。
            if ((required & IRAnalysis.LIVENESS()) != 0 && analysisValid(IRAnalysis.LIVENESS()) == 0) return 0;
            return 1;
        }
        void invalidateAnalyses(int mask) {
            analysis_.setAnalysisValid(analysis_.analysisValid() & (IRAnalysis.ALL() - mask));
            analysis_.incrementAnalysisGeneration();
            if ((mask & IRAnalysis.DEF_USE()) != 0) analysis_.setDuValid(0);
            if ((mask & IRAnalysis.TOPO()) != 0) analysis_.setPlanOrderCount(0);
        }
        // 旧 pass 直接改 SoA；在其后调用此入口统一采取保守失效，避免遗留索引被误用。
        void markIRMutation() { invalidateAnalyses(IRAnalysis.ALL()); }
        // ---- G5：图构建 API（供解析器 OnnxLoader 调用）----
        void setFile(int[] f, int len) { file_ = f; fileLen_ = len; pb_.init(file_, fileLen_); }
        int beginNode() {
            int i = nodes_.begin();
            attrs_.resetNode(i);
            nRedMode_[i] = 0;                                   // F8: ReduceMean
            nPadCval_[i] = 0;                                   // F8: Pad constant_value
            return i;
        }
        void endNode() { nodes_.end(); }
        void nodeType(int i, string v) { nodes_.setType(i, v); }
        string nodeTypeAt(int i) { return nodes_.typeAt(i); }
        void nodeIn(int i, int slot, string v) { nodes_.setInput(i, slot, v); }
        string nodeInAt(int i, int slot) { return nodes_.inputAt(i, slot); }
        // ---- P0 IR 访问器：ValueId = shape table index（名称只在 ONNX 边界保留）----
        // 既有 pass 仍可直接写 SoA；消费 def-use 前调用 rebuildDefUse() 重建索引。
        int valueId(string name) { return shapeIdx(name); }
        string valueName(int value) { if (value < 0 || value >= shapes_.count()) return ""; return shapes_.nameAt(value); }
        int nodeAlive(int node) { if (node < 0 || node >= nodes_.count() || nodes_.typeAt(node) == "") return 0; return 1; }
        int nodeInputValue(int node, int slot) { if (node < 0 || node >= nodes_.count() || slot < 0 || slot >= 5) return -1; return shapeIdx(nodeInAt(node, slot)); }
        // Phase 1 interface freeze：后续 Graph 组件只依赖这些按 ID 的领域 API，
        // 不直接访问 nIn*/nOut*/nType_ 等内部 SoA 数组。
        int nodeOperand(int node, int slot) { return nodeInputValue(node, slot); }
        int nodeResult(int node, int slot) { return nodeOutputValue(node, slot); }
        int nodeIsAlive(int node) { return nodeAlive(node); }
        int nodeOutputValue(int node, int slot) {
            if (node < 0 || node >= nodes_.count() || slot < 0 || slot >= 4) return -1;
            string out = "";
            if (slot == 0) out = effectiveOut(node);
            else if (slot == 1) out = nodes_.outputAt(node, 1);
            else if (slot == 2) out = nodes_.outputAt(node, 2);
            else out = nodes_.outputAt(node, 3);
            return shapeIdx(out);
        }
        // IR-P3a：string→enum 访问器。新 pass 只通过它比较算子类型，不再直接比 nType_ 字符串。
        int nodeOp(int i) {
            if (i < 0 || i >= nodes_.count()) return OpCode.UNKNOWN();
            return OpCode.opCode(nodes_.typeAt(i));
        }
        // IR-P3a/P3d：统一属性访问器（方案 A 访问器层）。attrFloat 取代 F32.toDouble 位型
        // 直读（EPS/ALPHA/Resize scales）；attrIntArr 取代 [node*N+k] 手算偏移。
        double attrFloat(int node, int key) {
            if (node < 0 || node >= nodes_.count()) return 0.0;
            if (key == NodeField.EPS_INT()) return F32.toDouble(attrs_.get(node, key));
            if (key == NodeField.ALPHA_INT()) return F32.toDouble(attrs_.get(node, key));
            if (key == NodeField.UPSH()) return F32.toDouble(attrs_.get(node, key));
            if (key == NodeField.UPSW()) return F32.toDouble(attrs_.get(node, key));
            return 0.0;
        }
        int attrInt(int node, int key) {
            if (node < 0 || node >= nodes_.count()) return 0;
            return attrs_.get(node, key);
        }
        void setAttrInt(int node, int key, int value) { nodeInt(node, key, value); }
        // IR-P3d：统一数组属性访问（取代 buildRuntime 的 [node*N+k] 手算偏移）。
        // key：0=SlAx [node*4+k]，1=SlSt，2=SlSp，3=PadB，4=PadE，5=PadB5 [node*5+k]，
        //     6=SplitSt，7=SplitLn。
        int attrIntArr(int node, int key, int k) {
            if (node < 0 || node >= nodes_.count() || k < 0) return 0;
            return attrs_.intArray(node, key, k);
        }
        void setAttrIntArr(int node, int key, int k, int value) {
            if (node < 0 || node >= nodes_.count() || k < 0) return;
            attrs_.setIntArray(node, key, k, value);
        }
        // 唯一输入改写入口。P0 只失效索引；P1 再演进为增量维护与 analysis manager。
        void replaceNodeInput(int node, int slot, int value) {
            if (node < 0 || node >= nodes_.count() || slot < 0 || slot >= 5 || value < 0 || value >= shapes_.count()) return;
            nodeIn(node, slot, shapes_.nameAt(value));
            analysis_.setDuValid(0);
            analysis_.setAnalysisValid(analysis_.analysisValid() & (IRAnalysis.ALL() - IRAnalysis.DEF_USE()));
        }
        void replaceOperand(int node, int slot, int value) { replaceNodeInput(node, slot, value); }
        // P2 rewrite 原语：把 oldValue 的每条精确 Use（包含重复 operand）改接到 newValue。
        // 图输出是值的隐式消费者：名称指向 oldValue 的 goName_ 一并改接到 newValue，因此
        // replaceAllUses 也覆盖 graph-output rewrite（P2d）。必须先 ensureDefUse；扫描 use
        // 快照期间只改 node 输入，最后一次性失效索引。
        void replaceAllUses(int oldValue, int newValue) {
            if (oldValue < 0 || newValue < 0 || oldValue >= shapes_.count() || newValue >= shapes_.count()) return;
            ensureDefUse();
            int count = valueUseCount(oldValue);
            int use = 0;
            while (use < count) {
                int user = valueUseNode(oldValue, use);
                int slot = valueUseSlot(oldValue, use);
                if (user >= 0 && slot >= 0) nodeIn(user, slot, shapes_.nameAt(newValue));
                use = use + 1;
            }
            string oldName = shapes_.nameAt(oldValue);
            string newName = shapes_.nameAt(newValue);
            int g = 0;
            while (g < goCount_) {
                if (goName_[g] == oldName) goName_[g] = newName;
                g = g + 1;
            }
            analysis_.setDuValid(0);
            analysis_.setAnalysisValid(analysis_.analysisValid() & (IRAnalysis.ALL() - IRAnalysis.DEF_USE()));
        }
        // P3c：改写节点的单个结果槽（name-based；buildReverseGraph 在 DefUse 建立前构图用）。
        // 与 replaceAllUses 一致：改写后失效 DefUse，消费前由 ensureDefUse 重建。
        void replaceResult(int node, int slot, string newName) {
            if (node < 0 || node >= nodes_.count() || slot < 0 || slot >= 4) return;
            if (slot == 0) nodes_.setOutput(node, 0, newName);
            else if (slot == 1) nodes_.setOutput(node, 1, newName);
            else if (slot == 2) nodes_.setOutput(node, 2, newName);
            else nodes_.setOutput(node, 3, newName);
            analysis_.setDuValid(0);
            analysis_.setAnalysisValid(analysis_.analysisValid() & (IRAnalysis.ALL() - IRAnalysis.DEF_USE()));
        }
        void replaceResultValue(int node, int slot, int value) {
            if (value < 0 || value >= shapes_.count()) return;
            replaceResult(node, slot, shapes_.nameAt(value));
        }
        // P3c：canonical 删除原语——tombstone 节点并标死其（融合的）有效输出。
        // 等价于旧的手写 `nodes_.setType(i, ""); markDeadTensor(effectiveOut(i))`，并统一失效 DefUse。
        void eraseNode(int node) {
            if (node < 0 || node >= nodes_.count() || nodes_.typeAt(node) == "") return;
            string eff = effectiveOut(node);
            if (attrs_.fused(node) == 1) markDeadTensor(nodes_.outputAt(node, 0));
            nodes_.setType(node, "");
            if (eff != "") markDeadTensor(eff);
            analysis_.setDuValid(0);
            analysis_.setAnalysisValid(analysis_.analysisValid() & (IRAnalysis.ALL() - IRAnalysis.DEF_USE()));
        }
        int valueProducer(int value) { if (analysis_.duValid() == 0 || value < 0 || value >= shapes_.count()) return -1; return analysis_.duProducer(value); }
        int valueUseCount(int value) { if (analysis_.duValid() == 0 || value < 0 || value >= shapes_.count()) return 0; return analysis_.duUseCount(value); }
        int valueUseNode(int value, int use) {
            if (analysis_.duValid() == 0 || value < 0 || value >= shapes_.count() || use < 0 || use >= analysis_.duUseCount(value)) return -1;
            int edge = analysis_.duFirstUse(value);
            int ordinal = 0;
            while (edge >= 0 && ordinal < use) { edge = analysis_.duNextUse(edge); ordinal = ordinal + 1; }
            if (edge < 0) return -1;
            return analysis_.duUseNode(edge);
        }
        int valueUseSlot(int value, int use) {
            if (analysis_.duValid() == 0 || value < 0 || value >= shapes_.count() || use < 0 || use >= analysis_.duUseCount(value)) return -1;
            int edge = analysis_.duFirstUse(value);
            int ordinal = 0;
            while (edge >= 0 && ordinal < use) { edge = analysis_.duNextUse(edge); ordinal = ordinal + 1; }
            if (edge < 0) return -1;
            return analysis_.duUseSlot(edge);
        }
        // 重建精确 def-use：每条 edge 记录 (consumer node, operand slot)，保留 Mul(x,x) 等重复 use。
        // 全图最多 5*nodes_.count() 条边，以压缩链表保存，避免每个 Value 预留 nodes_.count() 个槽。
        void rebuildDefUse() {
            int v = 0;
            while (v < shapes_.count()) { analysis_.setDuProducer(v, -1); analysis_.setDuUseCount(v, 0); analysis_.setDuFirstUse(v, -1); v = v + 1; }
            analysis_.setDuEdgeCount(0);
            int node = 0;
            while (node < nodes_.count()) {
                if (nodeAlive(node) == 1) {
                    int outSlot = 0;
                    while (outSlot < 4) {
                        int out = nodeOutputValue(node, outSlot);
                        if (out >= 0 && analysis_.duProducer(out) < 0) analysis_.setDuProducer(out, node);
                        outSlot = outSlot + 1;
                    }
                    int inSlot = 0;
                    while (inSlot < 5) {
                        int input = nodeInputValue(node, inSlot);
                        if (input >= 0 && analysis_.duEdgeCount() < 2560) {
                            int edge = analysis_.duEdgeCount();
                            analysis_.setDuUseNode(edge, node);
                            analysis_.setDuUseSlot(edge, inSlot);
                            analysis_.setDuNextUse(edge, analysis_.duFirstUse(input));
                            analysis_.setDuFirstUse(input, edge);
                            analysis_.setDuUseCount(input, analysis_.duUseCount(input) + 1);
                            analysis_.setDuEdgeCount(analysis_.duEdgeCount() + 1);
                        }
                        inSlot = inSlot + 1;
                    }
                }
                node = node + 1;
            }
            analysis_.setDuValid(1);
            analysis_.setAnalysisValid(analysis_.analysisValid() | IRAnalysis.DEF_USE());
            analysis_.setDuGeneration(analysis_.analysisGeneration());
        }
        // P0 验证器：检查精确 use edge、活节点输入形状、单 producer（图输入/常量 producer=-1 合法）。
        int verifyIR() {
            if (analysis_.duValid() == 0) rebuildDefUse();
            int bad = 0;
            int node = 0;
            while (node < nodes_.count()) {
                if (nodeAlive(node) == 1) {
                    int slot = 0;
                    while (slot < 5) {
                        string name = nodeInAt(node, slot);
                        int value = nodeInputValue(node, slot);
                        if (name != "" && value < 0) {
                            if (Console.getEnv("MYP_IR_VERIFY") == "1") { Console.writeString("VERIFY node=" + Fmt.i(node) + " type=" + nodes_.typeAt(node) + " slot=" + Fmt.i(slot) + " in=" + name + " val<0"); Console.writeLine(""); }
                            bad = 1;
                        } else if (value >= 0) {
                            int found = 0;
                            int use = 0;
                            while (use < valueUseCount(value)) {
                                if (valueUseNode(value, use) == node && valueUseSlot(value, use) == slot) found = 1;
                                use = use + 1;
                            }
                            if (found == 0) {
                                if (Console.getEnv("MYP_IR_VERIFY") == "1") { Console.writeString("VERIFY node=" + Fmt.i(node) + " type=" + nodes_.typeAt(node) + " slot=" + Fmt.i(slot) + " in=" + name + " val=" + Fmt.i(value) + " noUse"); Console.writeLine(""); }
                                bad = 1;
                            }
                        }
                        slot = slot + 1;
                    }
                }
                node = node + 1;
            }
            return bad == 0 ? 1 : 0;
        }
        int shapeRank5(string name) { int s = shapeIdx(name); if (s < 0) return 0; return shapes_.r5(s); }
        int valueRank(int value) { if (value < 0 || value >= shapes_.count()) return 0; return shapes_.r5(value) == 1 ? 5 : 4; }
        int valueDim(int value, int axis) {
            if (value < 0 || value >= shapes_.count()) return 0;
            if (axis == 0) return shapes_.d0(value);
            if (axis == 1) return shapes_.d1(value);
            if (axis == 2) return shapes_.d2(value);
            if (axis == 3) return shapes_.d3(value);
            if (axis == 4 && shapes_.r5(value) == 1) return shapes_.d4(value);
            return 0;
        }
        int valueKind(int value) { if (value < 0 || value >= shapes_.count()) return Kind.FC_ACT(); return shapes_.kindAt(value); }
        int valueIsDead(int value) { if (value < 0 || value >= shapes_.count()) return 1; return shapes_.deadAt(value); }
        int valueIsNHWC(int value) { if (value < 0 || value >= shapes_.count()) return 0; return shapes_.nhwcAt(value); }
        void setValueKind(int value, int kind) { if (value >= 0 && value < shapes_.count()) shapes_.setKindAt(value, kind); }
        void markValueDead(int value) { if (value >= 0 && value < shapes_.count()) shapes_.setDeadAt(value, 1); }
        void setValueNHWC(int value, int enabled) { if (value >= 0 && value < shapes_.count()) shapes_.setNhwcAt(value, enabled); }
        // 张量元素总数（按形状表 dims；图输入/输出张量无 runtime 2D 投影，须用此取 size）
        int shapeElementCount(string name) {
            int s = shapeIdx(name);
            if (s < 0) return -1;
            // 动态维度（dim_param）按 1 处理（batch=1 推理惯例）
            int d0 = shapes_.d0(s); if (d0 == 0) d0 = 1;
            int d1 = shapes_.d1(s); if (d1 == 0) d1 = 1;
            int d2 = shapes_.d2(s); if (d2 == 0) d2 = 1;
            int d3 = shapes_.d3(s); if (d3 == 0) d3 = 1;
            int d4 = shapes_.d4(s); if (d4 == 0) d4 = 1;
            int n = d0 * d1 * d2 * d3;
            if (shapes_.r5(s) == 1) n = n * d4;
            return n;
        }
        int valueElementCount(int value) {
            if (value < 0 || value >= shapes_.count()) return -1;
            int d0 = shapes_.d0(value); if (d0 == 0) d0 = 1;
            int d1 = shapes_.d1(value); if (d1 == 0) d1 = 1;
            int d2 = shapes_.d2(value); if (d2 == 0) d2 = 1;
            int d3 = shapes_.d3(value); if (d3 == 0) d3 = 1;
            int d4 = shapes_.d4(value); if (d4 == 0) d4 = 1;
            int n = d0 * d1 * d2 * d3;
            if (shapes_.r5(value) == 1) n = n * d4;
            return n;
        }
        int rawSt(int i, int k) { return attrs_.intArray(i, 8, k); }
        int rawPd(int i, int k) { return attrs_.intArray(i, 9, k); }
        int rawDl(int i, int k) { return attrs_.intArray(i, 10, k); }
        int rawKk(int i, int k) { return attrs_.intArray(i, 11, k); }
        void nodeOut(int i, string v) {
            if (nodes_.outputAt(i, 0) == "") nodes_.setOutput(i, 0, v);
            else if (nodes_.outputAt(i, 1) == "") nodes_.setOutput(i, 1, v);
            else if (nodes_.outputAt(i, 2) == "") nodes_.setOutput(i, 2, v);
            else nodes_.setOutput(i, 3, v);
            attrs_.setOutputCount(i, attrs_.outputCount(i) + 1);   // F8：Split 多输出计数
        }
        void nodeInt(int i, int code, int v) {
            if ((code >= NodeField.TRANSB() && code <= NodeField.PDB()) || code == NodeField.CAST_TO()) attrs_.set(i, code, v);
            else if (code == NodeField.ST0()) attrs_.setIntArray(i, 8, 0, v);
            else if (code == NodeField.ST1()) attrs_.setIntArray(i, 8, 1, v);
            else if (code == NodeField.ST2()) attrs_.setIntArray(i, 8, 2, v);
            else if (code == NodeField.PD0()) attrs_.setIntArray(i, 9, 0, v);
            else if (code == NodeField.PD1()) attrs_.setIntArray(i, 9, 1, v);
            else if (code == NodeField.PD2()) attrs_.setIntArray(i, 9, 2, v);
            else if (code == NodeField.PD3()) attrs_.setIntArray(i, 9, 3, v);
            else if (code == NodeField.PD4()) attrs_.setIntArray(i, 9, 4, v);
            else if (code == NodeField.PD5()) attrs_.setIntArray(i, 9, 5, v);
            else if (code == NodeField.DL0()) attrs_.setIntArray(i, 10, 0, v);
            else if (code == NodeField.DL1()) attrs_.setIntArray(i, 10, 1, v);
            else if (code == NodeField.DL2()) attrs_.setIntArray(i, 10, 2, v);
            else if (code == NodeField.KK0()) attrs_.setIntArray(i, 11, 0, v);
            else if (code == NodeField.KK1()) attrs_.setIntArray(i, 11, 1, v);
            else if (code == NodeField.KK2()) attrs_.setIntArray(i, 11, 2, v);
        }
        void addWeight(string nm, int rows, int cols, int dt, int kind, int off, int len) {
            weights_.add(nm, rows, cols, dt, kind, off, len);
        }
        int weightCount() { return weights_.count(); }
        string weightName(int weight) { return weights_.nameAt(weight); }
        int weightRows(int weight) { return weights_.get(weight, WeightField.ROWS()); }
        int weightCols(int weight) { return weights_.get(weight, WeightField.COLS()); }
        int weightDType(int weight) { return weights_.get(weight, WeightField.DTYPE()); }
        int weightKind(int weight) { return weights_.get(weight, WeightField.KIND()); }
        int weightOffset(int weight) { return weights_.get(weight, WeightField.OFFSET()); }
        int weightLength(int weight) { return weights_.get(weight, WeightField.LENGTH()); }
        int weightRole(int weight) { return weights_.get(weight, WeightField.ROLE()); }
        void setWeightRole(int weight, int role) { weights_.set(weight, WeightField.ROLE(), role); }
        void addGraphOutput(string nm) { if (goCount_ < 64) { goName_[goCount_] = nm; goCount_ = goCount_ + 1; } }
        void addGraphInput(string nm) { if (giCount_ < 64) { giName_[giCount_] = nm; giCount_ = giCount_ + 1; } }
        int graphInputCount() { return giCount_; }
        string graphInputName(int i) { if (i < 0 || i >= giCount_) return ""; return giName_[i]; }
        int graphOutputCount() { return goCount_; }
        string graphOutputName(int i) { if (i < 0 || i >= goCount_) return ""; return goName_[i]; }
        // 名称是否为初始器权重（ONNX graph input 同时含真实输入与 initializer，须排除后者）
        int isWeightName(string nm) {
            return weights_.idx(nm) >= 0 ? 1 : 0;
        }
        // 登记形状（解析器调用）
        void addShapeD(string name, int[] dims, int dimCount) { shapes_.addShapeD(name, dims, dimCount); }
        void addShapeD4(string name, int d0, int d1, int d2, int d3) { shapes_.addShapeD4(name, d0, d1, d2, d3); }
        // 3D：5D 张量（N,C,D,H,W）
        void addShapeD5(string name, int d0, int d1, int d2, int d3, int d4) { shapes_.addShapeD5(name, d0, d1, d2, d3, d4); }
        // 3D：按源张量秩复制输出形状（5D → addShapeD5，否则 addShapeD4）
        void copyShape(string name, int src) { shapes_.copyShape(name, src); }
        void resetCounts() { weights_.reset(); nodes_.reset(); shapes_.reset(); compiler_.reset(); goCount_=0; giCount_=0; fuseCount_=0; gapCount_=0; dceCount_=0; foldCount_=0; bnCount_=0; fusedAddCount_=0; noReuse_=0; doNHWC_=0; trainingMode_=0; analysis_.reset(); planner_.reset(); analysis_.setLastPassPreserved(IRAnalysis.ALL()); }
        // P3：覆盖张量形状（输入形状注入：动态维度模型）
        void setShape(string name, int d0, int d1, int d2, int d3, int d4, int is5) { shapes_.setShape(name, d0, d1, d2, d3, d4, is5); }

        // 调试：load 后 dump 各 Resize 折叠 sizes
        void dumpResizeSizes() {
            int fd = __myp_io_fopen("/tmp/resize_dbg.txt", "wb");
            if (fd < 0) return;
            int i = 0;
            while (i < nodes_.count()) {
                if (nodes_.typeAt(i) == "Resize") {
                    __myp_io_write("Resize out=" + nodes_.outputAt(i, 0));
                    __myp_io_write(" rsz=" + Fmt.i(attrs_.resizeD(i)) + "," + Fmt.i(attrs_.resizeH(i)) + "," + Fmt.i(attrs_.resizeW(i)));
                    __myp_io_write(" in=" + nodes_.inputAt(i, 0) + "\n");
                }
                i = i + 1;
            }
            __myp_io_fclose();
        }
        // IR-P1b：结构/shape/liveness 的稳定指纹。仅覆盖三种 analysis 的依赖；算子数值属性
        // （例如 alpha/epsilon）不影响 DefUse/Topo/Liveness，故不应无谓地失效缓存。
        long hashIRText(long hash, string text) {
            int i = 0;
            int n = Str.len(text);
            while (i < n) { hash = (hash * 131L + long(__myp_charcode(text, i))) % 2147483647L; i = i + 1; }
            return (hash * 131L + long(n)) % 2147483647L;
        }
        long analysisFingerprint() {
            long hash = 17L;
            int node = 0;
            while (node < nodes_.count()) {
                hash = hashIRText(hash, nodes_.typeAt(node));
                hash = hashIRText(hash, nodes_.inputAt(node, 0)); hash = hashIRText(hash, nodes_.inputAt(node, 1));
                hash = hashIRText(hash, nodes_.inputAt(node, 2)); hash = hashIRText(hash, nodes_.inputAt(node, 3)); hash = hashIRText(hash, nodes_.inputAt(node, 4));
                hash = hashIRText(hash, nodes_.outputAt(node, 0)); hash = hashIRText(hash, nodes_.outputAt(node, 1));
                hash = hashIRText(hash, nodes_.outputAt(node, 2)); hash = hashIRText(hash, nodes_.outputAt(node, 3));
                hash = (hash * 131L + long(attrs_.fused(node) + attrs_.nhwc(node))) % 2147483647L;
                node = node + 1;
            }
            // 图输出名影响 planMemory 的 persist（Liveness 依赖），改写时必须计入指纹。
            int g = 0;
            while (g < goCount_) {
                hash = hashIRText(hash, goName_[g]);
                g = g + 1;
            }
            int value = 0;
            while (value < shapes_.count()) {
                hash = hashIRText(hash, shapes_.nameAt(value));
                hash = (hash * 131L + long(shapes_.d0(value))) % 2147483647L;
                hash = (hash * 131L + long(shapes_.d1(value))) % 2147483647L;
                hash = (hash * 131L + long(shapes_.d2(value))) % 2147483647L;
                hash = (hash * 131L + long(shapes_.d3(value))) % 2147483647L;
                hash = (hash * 131L + long(shapes_.d4(value))) % 2147483647L;
                hash = (hash * 131L + long(shapes_.r5(value) + shapes_.deadAt(value) + shapes_.nhwcAt(value))) % 2147483647L;
                value = value + 1;
            }
            return hash;
        }
        // P2/P4：恒等折叠的常量校验——初始化器所有元素都等于 expect。标量、任意形状或
        // broadcast 常量张量均满足；x+0 / x-0 / x*1 / x÷1 对任意 broadcast 形状逐位保持，
        // 数值语义严格。逐元素校验（不落 f32Tmp_，大常量不溢出）。
        int isConstValue(string name, double expect) {
            int wi = initIdx(name);
            if (wi < 0) return 0;
            int n = weights_.get(wi, WeightField.LENGTH()) / 4;
            if (n < 1) return 0;
            int s = shapeIdx(name);
            if (s < 0) return 0;
            if (weights_.get(wi, WeightField.KIND()) == 5) {   // P3 计算常量（Cast int64→float 折叠结果）：值存 cF32_，无 file_ 字节
                int j = 0;
                while (j < n && j < 32) {
                    double v = cF32_[wi * 32 + j];
                    double d = v - expect;
                    if (d < 0.0) d = 0.0 - d;
                    if (d > 1.0e-12) return 0;
                    j = j + 1;
                }
                return 1;
            }
            if (weights_.get(wi, WeightField.OFFSET()) < 0) return 0;                       // 无 file_ 字节（如 int64 计算常量）→ 不折叠
            if (weights_.get(wi, WeightField.OFFSET()) + n * 4 > fileLen_) return 0;        // 越界（防御）→ 不折叠
            int j = 0;
            while (j < n) {
                double v = f32At(weights_.get(wi, WeightField.OFFSET()) + j * 4);
                double d = v - expect;
                if (d < 0.0) d = 0.0 - d;
                if (d > 1.0e-12) return 0;
                j = j + 1;
            }
            return 1;
        }
        int matchSingleUseOp(int value, string op, int slot) {
            if (value < 0 || valueUseCount(value) != 1) return -1;
            int user = valueUseNode(value, 0);
            if (user < 0 || nodes_.typeAt(user) != op || valueUseSlot(value, 0) != slot) return -1;
            return user;
        }
        // P2b rewrite primitive：producer 的有效输出直接改为 Relu 输出，并 tombstone Relu。
        // 保留既有 nFused/nRelu lowering 协议，故后端仍选择 ConvRelu/Conv3d doRelu 内核。
        void fuseSingleUseOutput(int producer, int consumer, int withRelu) {
            string oldOut = effectiveOut(producer);
            attrs_.setFused(producer, 1);
            attrs_.setFusedOut(producer, nodes_.outputAt(consumer, 0));
            attrs_.setFusedBy(consumer, producer);
            if (withRelu == 1) attrs_.setRelu(producer, 1);
            nodes_.setType(consumer, "");
            markDeadTensor(nodes_.outputAt(producer, 0));
            if (oldOut != nodes_.outputAt(producer, 0)) markDeadTensor(oldOut);
        }
        void fuseReluIntoProducer(int producer, int relu) {
            fuseSingleUseOutput(producer, relu, 1);
            fuseCount_ = fuseCount_ + 1;
        }
        // IR-P1b pass dispatcher：PassResult 写入 lastPass*；仅 changed 时失效相关分析。
        int runIRPass(int pass) {
            if (ensurePassAnalyses(pass) == 0) { analysis_.setLastPassOk(0); analysis_.setLastPassChanged(0); analysis_.setLastPassPreserved(0); return 0; }
            long before = analysisFingerprint();
            int ok = 1;
            if (pass == IRPassKind.FOLD_SHAPES()) ok = foldShapeChains();
            else if (pass == IRPassKind.FOLD_CONSTS()) ok = foldConstants();
            else if (pass == IRPassKind.INFER_SHAPES()) ok = inferShapes();
            else if (pass == IRPassKind.CLASSIFY()) { classifyShapes(); ok = 1; }
            else if (pass == IRPassKind.FUSE_BN()) ok = fuseConvBN();
            else if (pass == IRPassKind.FUSE_CONV_RELU()) ok = optimizer_.fuseConvRelu(this);
            else if (pass == IRPassKind.FUSE_RELU()) ok = optimizer_.fuseReluOp(this);
            else if (pass == IRPassKind.FUSE_GAP_FLATTEN()) ok = optimizer_.fuseGapFlatten(this);
            else if (pass == IRPassKind.DCE()) ok = optimizer_.eliminateDeadNodes(this);
            else if (pass == IRPassKind.LAYOUT_NHWC()) ok = layoutNHWC();
            else if (pass == IRPassKind.IDENTITY_FOLD()) { optimizer_.foldIdentityOps(this); ok = 1; }
            else if (pass == IRPassKind.FOLD_RELU()) { optimizer_.foldDoubleRelu(this); ok = 1; }
            else if (pass == IRPassKind.FUSE_CONV_ADD()) ok = fuseConvAdd();
            analysis_.setLastPassOk(ok);
            analysis_.setLastPassChanged(0);
            analysis_.setLastPassPreserved(0);
            if (ok == 1) {
                long after = analysisFingerprint();
                if (before != after) {
                    analysis_.setLastPassChanged(1);
                    markIRMutation();
                } else {
                    analysis_.setLastPassPreserved(IRAnalysis.ALL());
                }
            }
            return ok;
        }
        // P1c：最多 maxIter 轮，直到 pass 报告 changed=0。达到上限仍变化即失败；P2 的
        // 恒等 rewrite 使用此入口，防止错误 rewrite 在图上无限震荡。
        int runIRPassToFixpoint(int pass, int maxIter) {
            int iter = 0;
            while (iter < maxIter) {
                if (runIRPass(pass) == 0) return 0;
                if (analysis_.lastPassChanged() == 0) return 1;
                iter = iter + 1;
            }
            Console.writeLine("DBG pass fixpoint limit=" + Fmt.i(pass));
            return 0;
        }
        int runTopoSort() { return topoSort(); }
        int runPlanMemory() { return planMemory(); }
        int lowerRuntime(InferenceRuntime rt) { return compiler_.lower(this, rt); }
        int buildReverseGraphForOptimizer() {
            int ok = buildReverseGraph();
            if (ok == 1) markIRMutation();
            return ok;
        }
        void setTrainingModeForOptimizer(int mode) { trainingMode_ = mode; }
        void enableNoReuseForOptimizer() { noReuse_ = 1; }
        int shouldFuseConvAddForOptimizer() { return trainingMode_ == 0 ? 1 : 0; }
        int shouldRunNHWCForOptimizer() { return doNHWC_; }
        void dumpResizeSizesForOptimizer() { dumpResizeSizes(); }

        int optimize(InferenceRuntime rt) { return optimizer_.optimize(this, rt); }
        int optimizeTrain(InferenceRuntime rt) { return optimizer_.optimizeTrain(this, rt); }

        // ---- 阶段2：图级反向 pass（reverse-mode AD）----
        // 前向图已跑完 pass + topoSort；本方法反向拓扑遍历，为每个可训算子追加
        // backward 节点 + 梯度张量，末尾为权重追加 Update 节点，最后 Softmax 输出
        // 处接 SoftmaxCE(logits, label) → (dlogits, loss)。
        // 梯度张量命名：X#g（形状 = X）。反向节点消费前向激活 → planMemory 的
        // lastUse 自动延长这些激活的存活（不覆盖），无需显式 persist。
        int buildReverseGraph() {
            // 1) 定位「输出是图输出的 Softmax」节点 → logits = 其输入
            int smNode = -1;
            int i = 0;
            while (i < nodes_.count()) {
                if (nodeOp(i) == OpCode.SOFTMAX() && isGraphOutput(nodes_.outputAt(i, 0)) == 1) { smNode = i; i = nodes_.count(); }
                i = i + 1;
            }
            if (smNode < 0) {
                Console.writeLine("buildReverseGraph: no Softmax graph output");
                return 0;
            }
            string logits = nodes_.inputAt(smNode, 0);
            int ls = shapeIdx(logits);
            if (ls < 0) return 0;

            // 2) label / loss / dlogits 张量（label 由训练循环灌 one-hot）
            // 注意：label 必须与 logits 同秩且同 shape kind——5D 分割 logits
            // [N,C,D,H,W] 走 addShapeD5，否则漏深度维（同 Flatten 5D BUG：4D
            // 注册丢 shD4 → label 越界/覆盖）；shape kind 直接镜像 logits（否则
            // FC_ACT 分支在 buildRuntime 里优先于 5D 分支 → label 被注册成 [C,1]）。
            if (shapes_.r5(ls) == 1)
                addShapeD5("label", shapes_.d0(ls), shapes_.d1(ls), shapes_.d2(ls), shapes_.d3(ls), shapes_.d4(ls));
            else
                addShapeD4("label", shapes_.d0(ls), shapes_.d1(ls), shapes_.d2(ls), shapes_.d3(ls));
            setShapeKind("label", shapes_.kindAt(ls));
            addShapeD4("loss", 1, 1, 1, 1);
            setShapeKind("loss", Kind.FC_ACT());
            ensureGrad(logits);

            // 3) loss 节点：CE（SoftmaxCE(logits,label)→(dlogits,loss)）或
            //    Dice（DiceLoss(prob,label)→(dprob,loss) + BwdSoftmax(dprob,prob)→dlogits）
            if (lossMode_ == 1) {
                // prob = Softmax 输出（图输出）；其梯度 dprob 由 DiceLoss 产出，
                // 经 BwdSoftmax 链式回传到 logits 梯度 dlogits。
                string prob = nodes_.outputAt(smNode, 0);
                ensureGrad(prob);
                int nid = nodes_.count();
                beginNode();
                nodeType(nid, "DiceLoss");
                nodeIn(nid, 0, prob);
                nodeIn(nid, 1, "label");
                nodeOut(nid, gradName(prob));
                nodeOut(nid, "loss");
                endNode();
                int nid2 = nodes_.count();
                beginNode();
                nodeType(nid2, "BwdSoftmax");
                nodeIn(nid2, 0, gradName(prob));
                nodeIn(nid2, 1, prob);
                nodeOut(nid2, gradName(logits));
                endNode();
            } else {
                int nid = nodes_.count();
                beginNode();
                nodeType(nid, "SoftmaxCE");
                nodeIn(nid, 0, logits);
                nodeIn(nid, 1, "label");
                nodeOut(nid, gradName(logits));
                nodeOut(nid, "loss");
                endNode();
            }

            // 4) 反向拓扑遍历（analysis_ order 逆序）：输出梯度已知 → 按算子类型追加 backward
            int oi = analysis_.planOrderCount() - 1;
            while (oi >= 0) {
                int ni = analysis_.planOrder(oi);
                string t = nodes_.typeAt(ni);
                if (t != "") {
                    string y = nodes_.outputAt(ni, 0);
                    if (shapeIdx(gradName(y)) >= 0) {
                        // 确保该节点各输入/输出的梯度张量形状都登记（否则 buildRuntime 注册不到）
                        ensureGrad(nodes_.inputAt(ni, 0));
                        ensureGrad(nodes_.inputAt(ni, 1));
                        ensureGrad(nodes_.inputAt(ni, 2));
                        ensureGrad(nodes_.inputAt(ni, 3));
                        if (t == "Gemm") {
                            // BwdDense(dy, x, w) → (dx, dw, db)
                            int bd = nodes_.count();
                            beginNode();
                            nodeType(bd, "BwdDense");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nodes_.inputAt(ni, 0));
                            nodeIn(bd, 2, nodes_.inputAt(ni, 1));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 0)));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 1)));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 2)));
                            endNode();
                        } else if (t == "MatMul") {
                            // 无偏置：db 输出用 0 占位（runtime 忽略）
                            int bd = nodes_.count();
                            beginNode();
                            nodeType(bd, "BwdDense");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nodes_.inputAt(ni, 0));
                            nodeIn(bd, 2, nodes_.inputAt(ni, 1));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 0)));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 1)));
                            nodeOut(bd, "");
                            endNode();
                        } else if (t == "Relu") {
                            int bd = nodes_.count();
                            beginNode();
                            nodeType(bd, "BwdRelu");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nodes_.inputAt(ni, 0));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 0)));
                            endNode();
                        } else if (t == "Sigmoid") {
                            int bd = nodes_.count();
                            beginNode();
                            nodeType(bd, "BwdSigmoid");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, y);              // 用前向输出 y
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 0)));
                            endNode();
                        } else if (t == "Add") {
                            int bd = nodes_.count();
                            beginNode();
                            nodeType(bd, "BwdAdd");
                            nodeIn(bd, 0, gradName(y));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 0)));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 1)));
                            endNode();
                        } else if (t == "Conv") {
                            // BwdConv(dy, x, w) → (dx, dw, db)；复制卷积参数
                            int bd = nodes_.count();
                            beginNode();
                            nodeType(bd, "BwdConv");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nodes_.inputAt(ni, 0));
                            nodeIn(bd, 2, nodes_.inputAt(ni, 1));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 0)));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 1)));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 2)));   // 无偏置 → "" → runtime db=-1
                            endNode();
                            attrs_.set(bd, NodeField.SH(), attrs_.get(ni, NodeField.SH())); attrs_.set(bd, NodeField.SW(), attrs_.get(ni, NodeField.SW()));
                            attrs_.set(bd, NodeField.PT(), attrs_.get(ni, NodeField.PT())); attrs_.set(bd, NodeField.PL(), attrs_.get(ni, NodeField.PL()));
                            attrs_.set(bd, NodeField.DH(), attrs_.get(ni, NodeField.DH())); attrs_.set(bd, NodeField.DW(), attrs_.get(ni, NodeField.DW())); attrs_.set(bd, NodeField.GROUP(), attrs_.get(ni, NodeField.GROUP()));
                        } else if (t == "MaxPool") {
                            // BwdMaxPool(dy, x) → (dx)；复制池化参数
                            int bd = nodes_.count();
                            beginNode();
                            nodeType(bd, "BwdMaxPool");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nodes_.inputAt(ni, 0));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 0)));
                            endNode();
                            attrs_.set(bd, NodeField.KH(), attrs_.get(ni, NodeField.KH())); attrs_.set(bd, NodeField.KW(), attrs_.get(ni, NodeField.KW()));
                            attrs_.set(bd, NodeField.SH(), attrs_.get(ni, NodeField.SH())); attrs_.set(bd, NodeField.SW(), attrs_.get(ni, NodeField.SW()));
                            attrs_.set(bd, NodeField.PT(), attrs_.get(ni, NodeField.PT())); attrs_.set(bd, NodeField.PL(), attrs_.get(ni, NodeField.PL()));
                        } else if (t == "ConvTranspose") {
                            // 阶段4d：BwdConvTranspose(dy, x, w) → (dx, dw, db)；复制转置卷积参数
                            int bd = nodes_.count();
                            beginNode();
                            nodeType(bd, "BwdConvTranspose");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nodes_.inputAt(ni, 0));
                            nodeIn(bd, 2, nodes_.inputAt(ni, 1));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 0)));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 1)));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 2)));   // 无偏置 → "" → runtime db=-1
                            endNode();
                            attrs_.set(bd, NodeField.SH(), attrs_.get(ni, NodeField.SH())); attrs_.set(bd, NodeField.SW(), attrs_.get(ni, NodeField.SW()));
                            attrs_.set(bd, NodeField.PT(), attrs_.get(ni, NodeField.PT())); attrs_.set(bd, NodeField.PB(), attrs_.get(ni, NodeField.PB()));
                            attrs_.set(bd, NodeField.PL(), attrs_.get(ni, NodeField.PL())); attrs_.set(bd, NodeField.PR(), attrs_.get(ni, NodeField.PR()));
                        } else if (t == "Conv3D") {
                            // 阶段4：BwdConv3D(dy, x, w) → (dx, dw, db)；复制 3D 卷积参数
                            // （kd/kh/kw 与 group 由 w 张量形状给出；dd/dh/dw 假定 1）
                            int bd = nodes_.count();
                            beginNode();
                            nodeType(bd, "BwdConv3D");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nodes_.inputAt(ni, 0));
                            nodeIn(bd, 2, nodes_.inputAt(ni, 1));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 0)));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 1)));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 2)));   // 无偏置 → "" → runtime db=-1
                            endNode();
                            attrs_.set(bd, NodeField.SD3(), attrs_.get(ni, NodeField.SD3())); attrs_.set(bd, NodeField.SH(), attrs_.get(ni, NodeField.SH())); attrs_.set(bd, NodeField.SW(), attrs_.get(ni, NodeField.SW()));
                            attrs_.set(bd, NodeField.PDT(), attrs_.get(ni, NodeField.PDT())); attrs_.set(bd, NodeField.PDB(), attrs_.get(ni, NodeField.PDB()));
                            attrs_.set(bd, NodeField.PT(), attrs_.get(ni, NodeField.PT())); attrs_.set(bd, NodeField.PB(), attrs_.get(ni, NodeField.PB()));
                            attrs_.set(bd, NodeField.PL(), attrs_.get(ni, NodeField.PL())); attrs_.set(bd, NodeField.PR(), attrs_.get(ni, NodeField.PR()));
                        } else if (t == "MaxPool3D") {
                            // 阶段4：BwdMaxPool3D(dy, x) → (dx)；复制 3D 池化参数
                            int bd = nodes_.count();
                            beginNode();
                            nodeType(bd, "BwdMaxPool3D");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nodes_.inputAt(ni, 0));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 0)));
                            endNode();
                            attrs_.set(bd, NodeField.KD3(), attrs_.get(ni, NodeField.KD3())); attrs_.set(bd, NodeField.KH(), attrs_.get(ni, NodeField.KH())); attrs_.set(bd, NodeField.KW(), attrs_.get(ni, NodeField.KW()));
                            attrs_.set(bd, NodeField.SD3(), attrs_.get(ni, NodeField.SD3())); attrs_.set(bd, NodeField.SH(), attrs_.get(ni, NodeField.SH())); attrs_.set(bd, NodeField.SW(), attrs_.get(ni, NodeField.SW()));
                            attrs_.set(bd, NodeField.PDT(), attrs_.get(ni, NodeField.PDT())); attrs_.set(bd, NodeField.PDB(), attrs_.get(ni, NodeField.PDB()));
                            attrs_.set(bd, NodeField.PT(), attrs_.get(ni, NodeField.PT())); attrs_.set(bd, NodeField.PB(), attrs_.get(ni, NodeField.PB()));
                            attrs_.set(bd, NodeField.PL(), attrs_.get(ni, NodeField.PL())); attrs_.set(bd, NodeField.PR(), attrs_.get(ni, NodeField.PR()));
                        } else if (t == "AveragePool3D") {
                            // 阶段4：BwdAvgPool3D(dy, x) → (dx)；复制 3D 池化参数 + cip
                            int bd = nodes_.count();
                            beginNode();
                            nodeType(bd, "BwdAvgPool3D");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nodes_.inputAt(ni, 0));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 0)));
                            endNode();
                            attrs_.set(bd, NodeField.KD3(), attrs_.get(ni, NodeField.KD3())); attrs_.set(bd, NodeField.KH(), attrs_.get(ni, NodeField.KH())); attrs_.set(bd, NodeField.KW(), attrs_.get(ni, NodeField.KW()));
                            attrs_.set(bd, NodeField.SD3(), attrs_.get(ni, NodeField.SD3())); attrs_.set(bd, NodeField.SH(), attrs_.get(ni, NodeField.SH())); attrs_.set(bd, NodeField.SW(), attrs_.get(ni, NodeField.SW()));
                            attrs_.set(bd, NodeField.PDT(), attrs_.get(ni, NodeField.PDT())); attrs_.set(bd, NodeField.PDB(), attrs_.get(ni, NodeField.PDB()));
                            attrs_.set(bd, NodeField.PT(), attrs_.get(ni, NodeField.PT())); attrs_.set(bd, NodeField.PB(), attrs_.get(ni, NodeField.PB()));
                            attrs_.set(bd, NodeField.PL(), attrs_.get(ni, NodeField.PL())); attrs_.set(bd, NodeField.PR(), attrs_.get(ni, NodeField.PR()));
                            attrs_.set(bd, NodeField.CIP(), attrs_.get(ni, NodeField.CIP()));
                        } else if (t == "Resize" || t == "Upsample") {
                            // 阶段4d：Resize3D 反向 → BwdResize(dy, x) → dx；复制 mode/transform。
                            // 仅 3D（U-Net 上采样）；2D 反向未实现 → 跳过（梯度 0）。
                            int osr = shapeIdx(y);
                            if (osr >= 0 && shapes_.r5(osr) == 1) {
                                int bd = nodes_.count();
                                beginNode();
                                nodeType(bd, "BwdResize");
                                nodeIn(bd, 0, gradName(y));
                                nodeIn(bd, 1, nodes_.inputAt(ni, 0));
                                nodeOut(bd, gradName(nodes_.inputAt(ni, 0)));
                                endNode();
                                attrs_.set(bd, NodeField.MODE(), attrs_.get(ni, NodeField.MODE()));
                                attrs_.set(bd, NodeField.TRANSFORM(), attrs_.get(ni, NodeField.TRANSFORM()));
                            }
                        } else if (t == "Concat") {
                            // U-Net 跳跃连接反向：BwdConcat(dy, x0, x1, x2) → (dx0, dx1, dx2)。
                            // nIn1_/nIn2_/nIn3_ = 原输入（buildRuntime 查轴长）；nOut0-2 = 各输入梯度。
                            int bd = nodes_.count();
                            beginNode();
                            nodeType(bd, "BwdConcat");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nodes_.inputAt(ni, 0));
                            nodeIn(bd, 2, nodes_.inputAt(ni, 1));
                            nodeIn(bd, 3, nodes_.inputAt(ni, 2));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 0)));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 1)));
                            nodeOut(bd, gradName(nodes_.inputAt(ni, 2)));
                            endNode();
                            attrs_.set(bd, NodeField.AXIS(), attrs_.get(ni, NodeField.AXIS()));
                        }
                        // Softmax 由 CE 处理；Conv3D/池化等暂不支持（梯度 0，跳过）
                    }
                }
                oi = oi - 1;
            }

            // 5) 权重/偏置追加 Update(W, W#g)（可训参数：FC_W/FC_B/CNN_W/CNN_B）
            // 仅当梯度确实由某个反向算子产出（isNodeOutput）——Resize sizes/scales
            // 等参数初始器虽被 ensureGrad 登记了形状，但没有反向节点产出其梯度，
            // 不应生成 Update（否则 buildRuntime 因该常量非运行时张量而失败）。
            int wi = 0;
            while (wi < weights_.count()) {
                string nm = weights_.nameAt(wi);
                int role = weights_.get(wi, WeightField.ROLE());
                if ((role == 0 || role == 1 || role == 2 || role == 3) && isNodeOutput(gradName(nm)) == 1) {
                    int uid = nodes_.count();
                    // 输出用独立 dummy 标量（不能复用权重名——那会让 producerIdx(权重)=Update，
                    // 权重"被产出"→ 前向消费权重 + Update 依赖梯度 → 环）
                    string dummy = "upd" + Fmt.i(uid);
                    addShapeD4(dummy, 1, 1, 1, 1);
                    setShapeKind(dummy, Kind.FC_ACT());
                    beginNode();
                    nodeType(uid, "Update");
                    nodeIn(uid, 0, nm);
                    nodeIn(uid, 1, gradName(nm));
                    nodeOut(uid, dummy);
                    endNode();
                }
                wi = wi + 1;
            }
            // 5c) 多消费者梯度（U-Net 跳跃连接）：skip 张量（如 r1/r3）同时被编码器
            //     算子与 Concat 消费 → 梯度名被多反向节点产出。BwdConcat 与主 producer
            //     存在依赖环（编码器反向依赖 concat 上游输出 u#g），不能靠执行顺序累加。
            //     改用显式累加：主 producer 输出改 g_a、BwdConcat 输出改 g_b、加
            //     GradAcc(g_a, g_b) → g（纯前向 Add，消费者读 g）。
            int cc = 0;
            while (cc < nodes_.count()) {
                if (nodeOp(cc) == OpCode.BWD_CONCAT()) {
                    int slot = 0;
                    while (slot < 3) {
                        string g;
                        if (slot == 0) g = nodes_.outputAt(cc, 0);
                        else if (slot == 1) g = nodes_.outputAt(cc, 1);
                        else g = nodes_.outputAt(cc, 2);
                        if (g != "" && Str.len(g) >= 2 && Str.substring(g, Str.len(g) - 2, Str.len(g)) == "#g") {
                            int other = -1;
                            int jj = 0;
                            while (jj < nodes_.count()) {
                                if (jj != cc && nodes_.typeAt(jj) != "" && nodes_.typeAt(jj) != "BwdConcat") {
                                    if (nodes_.outputAt(jj, 0) == g || nodes_.outputAt(jj, 1) == g || nodes_.outputAt(jj, 2) == g || nodes_.outputAt(jj, 3) == g) { other = jj; jj = nodes_.count(); }
                                }
                                jj = jj + 1;
                            }
                            if (other >= 0) {
                                string ga = g + "_a";
                                string gb = g + "_b";
                                // P3c：结果槽改写走 canonical mutation API（不再直写 SoA）
                                replaceResult(cc, slot, gb);
                                if (nodes_.outputAt(other, 0) == g) replaceResult(other, 0, ga);
                                else if (nodes_.outputAt(other, 1) == g) replaceResult(other, 1, ga);
                                else if (nodes_.outputAt(other, 2) == g) replaceResult(other, 2, ga);
                                else if (nodes_.outputAt(other, 3) == g) replaceResult(other, 3, ga);
                                // 登记 g_a/g_b 形状（同 g）
                                int gs = shapeIdx(g);
                                if (gs >= 0) {
                                    if (shapes_.r5(gs) == 1) {
                                        addShapeD5(ga, shapes_.d0(gs), shapes_.d1(gs), shapes_.d2(gs), shapes_.d3(gs), shapes_.d4(gs));
                                        addShapeD5(gb, shapes_.d0(gs), shapes_.d1(gs), shapes_.d2(gs), shapes_.d3(gs), shapes_.d4(gs));
                                    } else {
                                        addShapeD4(ga, shapes_.d0(gs), shapes_.d1(gs), shapes_.d2(gs), shapes_.d3(gs));
                                        addShapeD4(gb, shapes_.d0(gs), shapes_.d1(gs), shapes_.d2(gs), shapes_.d3(gs));
                                    }
                                    setShapeKind(ga, shapes_.kindAt(gs));
                                    setShapeKind(gb, shapes_.kindAt(gs));
                                }
                                // GradAcc 纯前向累加节点
                                int an = nodes_.count();
                                beginNode();
                                nodeType(an, "GradAcc");
                                nodeIn(an, 0, ga);
                                nodeIn(an, 1, gb);
                                nodeOut(an, g);
                                endNode();
                            }
                        }
                        slot = slot + 1;
                    }
                }
                cc = cc + 1;
            }
            return 1;
        }
        // 梯度张量名（同形状）
        string gradName(string nm) { return nm + "#g"; }
        // 梯度张量去 #g 后缀还原基底名
        string stripGrad(string nm) {
            int L = Str.len(nm);
            if (L >= 2) return Str.substring(nm, 0, L - 2);
            return nm;
        }
        // 确保前向张量 nm 的梯度张量形状已登记（同形状；权重梯度用 FC_G 镜像基底布局）
        void ensureGrad(string nm) {
            if (nm == "") return;
            string gn = gradName(nm);
            if (shapeIdx(gn) >= 0) return;
            int s = shapeIdx(nm);
            if (s < 0) return;
            if (shapes_.r5(s) == 1) addShapeD5(gn, shapes_.d0(s), shapes_.d1(s), shapes_.d2(s), shapes_.d3(s), shapes_.d4(s));
            else addShapeD4(gn, shapes_.d0(s), shapes_.d1(s), shapes_.d2(s), shapes_.d3(s));
            if (initIdx(nm) >= 0) setShapeKind(gn, Kind.FC_G());   // 权重：镜像基底（含 transB）
            else setShapeKind(gn, shapes_.kindAt(s));                     // 激活：同基底
        }

    function:
        int shapeIdx(string name) { return shapes_.idx(name); }
        int shapeKind(string name) { return shapes_.shapeKind(name); }
        void setShapeKind(string name, int k) { shapes_.setShapeKind(name, k); }
        int classifyShapes() {
            // 1) 权重/偏置：由消费节点决定（初始器）
            int i = 0;
            while (i < nodes_.count()) {
                string t = nodes_.typeAt(i);
                if (t == "Gemm") {
                    markFCWeight(nodes_.inputAt(i, 1), attrs_.get(i, NodeField.TRANSB()));   // transB=1：wire=[N,K]；transB=0：wire=[K,N]
                    markFCBias(nodes_.inputAt(i, 2));
                } else if (t == "MatMul") {
                    markFCWeight(nodes_.inputAt(i, 1), 0);             // MatMul 无 transB，wire=[K,N]
                } else if (t == "Conv") {
                    markCNNWeight(nodes_.inputAt(i, 1));
                    markCNNBias(nodes_.inputAt(i, 2));
                } else if (t == "Conv3D") {
                    // 3D：权重 [Cout,Cin,kd,kh,kw] / 偏置 [Cout]
                    markCNNWeight(nodes_.inputAt(i, 1));
                    markCNNBias(nodes_.inputAt(i, 2));
                } else if (t == "ConvTranspose") {
                    // F8：权重 [Cin,Cout,kh,kw] 直接拷贝（wRole_=2 无需转置）
                    markCNNWeight(nodes_.inputAt(i, 1));
                    markCNNBias(nodes_.inputAt(i, 2));
                } else if (t == "Concat" || t == "Transpose" || t == "Reshape") {
                    // F8：4D 通用常量输入 → CNN 激活登记 + 直接拷贝（Concat 的非常量输入/常量）
                    markGeneric4DConst(nodes_.inputAt(i, 0));
                    if (t == "Concat") { markGeneric4DConst(nodes_.inputAt(i, 1)); markGeneric4DConst(nodes_.inputAt(i, 2)); }
                    if (t == "Reshape") markInt64Param(nodes_.inputAt(i, 1));   // shape 参数（int64）不登记为 f32 张量
                } else if (t == "Slice") {
                    // F8：starts/ends/axes/steps 参数初始器（int64）不登记为 f32 张量
                    markInt64Param(nodes_.inputAt(i, 1));
                    markInt64Param(nodes_.inputAt(i, 2));
                    markInt64Param(nodes_.inputAt(i, 3));
                    markInt64Param(nodes_.inputAt(i, 4));
                } else if (t == "InstanceNormalization") {
                    // F8：scale/bias [C] 常量 → FC_B 登记（addTensorPlanned2(d0,1)）
                    markFCBias(nodes_.inputAt(i, 1));
                    markFCBias(nodes_.inputAt(i, 2));
                } else if (t == "Pad") {
                    // F8：pads（int64）与 constant_value（f32）参数不登记为 f32 激活张量
                    markInt64Param(nodes_.inputAt(i, 1));
                    markParamDead(nodes_.inputAt(i, 2));
                } else if (t == "Split") {
                    // F8：split 尺寸输入（opset13+，int64）不登记为 f32 张量
                    markInt64Param(nodes_.inputAt(i, 1));
                } else if (t == "Resize" || t == "Upsample") {
                    // F8：scales/sizes 参数初始器不登记为激活（读自 file_）
                    markParamDead(nodes_.inputAt(i, 1));
                    markParamDead(nodes_.inputAt(i, 2));
                    markParamDead(nodes_.inputAt(i, 3));
                }
                i = i + 1;
            }
            // 2) 图输入（非初始器、非任何节点输出）：由首个消费者决定 4D/FC
            int si = 0;
            while (si < shapes_.count()) {
                string nm = shapes_.nameAt(si);
                if (initIdx(nm) >= 0) { si = si + 1; continue; }
                if (isNodeOutput(nm) == 1) { si = si + 1; continue; }
                setShapeKind(nm, consumerKind(nm));
                si = si + 1;
            }
            // 3) 激活：按生产者传播（节点按拓扑序；死节点跳过）
            i = 0;
            while (i < nodes_.count()) {
                string t = nodes_.typeAt(i);
                if (t == "") { i = i + 1; continue; }
                int k = Kind.FC_ACT();
                if (t == "Conv" || t == "MaxPool" || t == "AveragePool" || t == "GlobalAveragePool") k = Kind.CNN_ACT();
                else if (t == "Conv3D" || t == "MaxPool3D" || t == "AveragePool3D") k = Kind.CNN_ACT();   // 3D
                else if (t == "Gemm" || t == "MatMul" || t == "Flatten") k = Kind.FC_ACT();
                else {
                    // Relu / Sigmoid / Softmax / Add：沿用主输入 kind
                    k = shapeKind(nodes_.inputAt(i, 0));
                }
                setShapeKind(nodes_.outputAt(i, 0), k);
                if (t == "Split") {   // F8：Split 所有输出沿用主输入 kind
                    setShapeKind(nodes_.outputAt(i, 1), k);
                    setShapeKind(nodes_.outputAt(i, 2), k);
                    setShapeKind(nodes_.outputAt(i, 3), k);
                }
                i = i + 1;
            }
            return 1;
        }
        // F8：把 4D 通用常量（非 Conv 权重/偏置）标记为 CNN 激活（buildRuntime 4D 登记）
        // 并设 wRole_=4（写权重时直接拷贝，不做 FC 转置）
        void markGeneric4DConst(string name) {
            int wi = initIdx(name);
            if (wi < 0) return;
            if (weights_.get(wi, WeightField.ROLE()) == 2 || weights_.get(wi, WeightField.ROLE()) == 3) return;   // Conv 权重/偏置不覆盖
            int s = shapeIdx(name);
            if (s < 0) return;
            if (shapes_.d2(s) <= 1 && shapes_.d3(s) <= 1) return;       // 非 4D 不处理
            weights_.set(wi, WeightField.ROLE(), 4);
            weights_.set(wi, WeightField.TRANSPOSED(), 0);
            setShapeKind(name, Kind.CNN_ACT());
        }
        // F8：int64 参数初始器（Reshape shape / Slice starts 等）标死——
        // 不登记为 f32 运行时张量（readI64Init 直接从 file_ 读，不依赖 runtime 张量）。
        void markInt64Param(string name) {
            int wi = initIdx(name);
            if (wi < 0) return;
            if (weights_.get(wi, WeightField.DTYPE()) != 7) return;   // 仅 int64 参数
            markDeadTensor(name);
        }
        // F8：任意参数初始器标死（Resize scales/sizes 等，读自 file_）
        void markParamDead(string name) {
            int wi = initIdx(name);
            if (wi < 0) return;
            markDeadTensor(name);
        }
        int isNodeOutput(string name) {
            int i = 0;
            while (i < nodes_.count()) {
                if (nodes_.outputAt(i, 0) == name || nodes_.outputAt(i, 1) == name || nodes_.outputAt(i, 2) == name || nodes_.outputAt(i, 3) == name) return 1;
                i = i + 1;
            }
            return 0;
        }
        int consumerKind(string name) {
            int i = 0;
            while (i < nodes_.count()) {
                if (nodes_.inputAt(i, 0) == name || nodes_.inputAt(i, 1) == name || nodes_.inputAt(i, 2) == name) {
                    string t = nodes_.typeAt(i);
                    if (t == "Conv" || t == "MaxPool" || t == "AveragePool" || t == "GlobalAveragePool" || t == "BatchNormalization") return Kind.CNN_ACT();
                    if (t == "Conv3D" || t == "MaxPool3D" || t == "AveragePool3D") return Kind.CNN_ACT();   // 3D
                    // F8：Concat/Transpose/Reshape 等 —— 若张量本身 4D 则按 CNN 激活
                    int s = shapeIdx(name);
                    if (s >= 0 && (shapes_.d2(s) > 1 || shapes_.d3(s) > 1)) return Kind.CNN_ACT();
                    return Kind.FC_ACT();
                }
                i = i + 1;
            }
            return Kind.FC_ACT();
        }
        void markFCWeight(string name, int v) {
            int i = initIdx(name);
            if (i >= 0) { weights_.set(i, WeightField.TRANSPOSED(), v); weights_.set(i, WeightField.ROLE(), 0); setShapeKind(name, Kind.FC_W()); }
        }
        void markFCBias(string name) {
            int i = initIdx(name);
            if (i >= 0) { weights_.set(i, WeightField.BIAS(), 1); weights_.set(i, WeightField.ROLE(), 1); setShapeKind(name, Kind.FC_B()); }
        }
        void markCNNWeight(string name) {
            int i = initIdx(name);
            if (i >= 0) { weights_.set(i, WeightField.ROLE(), 2); setShapeKind(name, Kind.CNN_W()); }
        }
        void markCNNBias(string name) {
            int i = initIdx(name);
            if (i >= 0) { weights_.set(i, WeightField.ROLE(), 3); setShapeKind(name, Kind.CNN_B()); }
        }
        // F8：读 float32 初始器值（Resize scales 等）。
        // 支持 raw_data（wKind_==1，4 字节小端）与 float_data。返回读取个数。
        int readF32Init(string name, int maxn) {
            int wi = initIdx(name);
            if (wi < 0) return 0;
            if (weights_.get(wi, WeightField.OFFSET()) < 0) return 0;   // 计算常量（cF32_ 存储，无 file_ 字节）→ 不读文件
            int cnt = 0;
            int j = 0;
            while (j < weights_.get(wi, WeightField.LENGTH()) / 4 && cnt < maxn) {
                int b0 = file_[weights_.get(wi, WeightField.OFFSET()) + j * 4];
                int b1 = file_[weights_.get(wi, WeightField.OFFSET()) + j * 4 + 1];
                int b2 = file_[weights_.get(wi, WeightField.OFFSET()) + j * 4 + 2];
                int b3 = file_[weights_.get(wi, WeightField.OFFSET()) + j * 4 + 3];
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                f32Tmp_[cnt] = F32.toDouble(bits);
                cnt = cnt + 1;
                j = j + 1;
            }
            return cnt;
        }

        int initIdx(string name) {
            return weights_.idx(name);
        }
        // 3D：按输入秩识别 Conv/MaxPool/AveragePool/ConvTranspose 的 2D/3D。
        // 输入为 5D（NCDHW）→ 改名为 xxx3D 并从通用原始 attr 重映射 3D 字段。
        // 必须在 inferShapes 内（节点拓扑序）调用：此时生产者输出形状已登记，
        // 下游 3D 池化的输入秩已知。
        void normalize3DNode(int i) {
            string t = nodes_.typeAt(i);
            if (t != "Conv" && t != "MaxPool" && t != "AveragePool" && t != "ConvTranspose") return;
            if (shapeRank5(nodes_.inputAt(i, 0)) != 1) return;
            nodes_.setType(i, t + "3D");
            // strides [sd,sh,sw]
            int sd = rawSt(i, 0); if (sd == 0) sd = 1;
            int sh = rawSt(i, 1); if (sh == 0) sh = 1;
            int sw = rawSt(i, 2); if (sw == 0) sw = 1;
            attrs_.set(i, NodeField.SD3(), sd); attrs_.set(i, NodeField.SH(), sh); attrs_.set(i, NodeField.SW(), sw);
            // pads：ONNX 3D 格式 [d_begin, h_begin, w_begin, d_end, h_end, w_end]
            // （此前按 [pdt,pdb,pt,pb,pl,pr] 顺序读取——PyTorch 风格。对称 padding
            // 时各维 top==bottom 看不出；非对称 pads（如 [1,0,0,1,0,0]）会错位，
            // 导致 Conv/AvgPool 输出形状与切片位置错误）
            attrs_.set(i, NodeField.PDT(), rawPd(i, 0)); attrs_.set(i, NodeField.PDB(), rawPd(i, 3));
            attrs_.set(i, NodeField.PT(), rawPd(i, 1)); attrs_.set(i, NodeField.PB(), rawPd(i, 4));
            attrs_.set(i, NodeField.PL(), rawPd(i, 2)); attrs_.set(i, NodeField.PR(), rawPd(i, 5));
            // dilations [dd,dh,dw]
            int dd = rawDl(i, 0); if (dd == 0) dd = 1;
            int dh = rawDl(i, 1); if (dh == 0) dh = 1;
            int dw = rawDl(i, 2); if (dw == 0) dw = 1;
            attrs_.set(i, NodeField.DD3(), dd); attrs_.set(i, NodeField.DH(), dh); attrs_.set(i, NodeField.DW(), dw);
            // kernel_shape [kd,kh,kw]
            attrs_.set(i, NodeField.KD3(), rawKk(i, 0)); attrs_.set(i, NodeField.KH(), rawKk(i, 1)); attrs_.set(i, NodeField.KW(), rawKk(i, 2));
        }
        int inferShapes() {
            int i = 0;
            while (i < nodes_.count()) {
                string t = nodes_.typeAt(i);
                if (t == "") { i = i + 1; continue; }   // 死节点（折叠/融合消掉）跳过
                // P3：形状链节点（Shape/Constant/Cast/ReduceProd/Unsqueeze/Gather）由
                // foldShapeChains 折叠；仍活着则先尝试折叠（形状随 inferShapes 推进逐步已知）
                // Slice/Concat 仅当「数据输入」是 int64 形状链时才按形状链处理（float 数据
                // Slice/Concat 是运行时算子）：Slice 判 nIn0_（数据），不能看 nIn1_（starts
                // 恒为 int64 初始器，会把数据 Slice 误当形状链跳过 → 输出形状不登记 → 下游
                // Concat shapeIdx 失败 "DBG fail inferShapes"）。
                if (t == "Shape" || t == "Constant" || t == "Cast" || t == "ReduceProd" || t == "Unsqueeze" || t == "Gather" ||
                    (t == "Slice" && (i64Count(nodes_.inputAt(i, 0)) > 0 || i64ChainAlive(nodes_.inputAt(i, 0)) == 1)) ||
                    (t == "Concat" && (i64Count(nodes_.inputAt(i, 0)) > 0 || i64Count(nodes_.inputAt(i, 1)) > 0))) {
                    foldShapeChains();
                    if (nodes_.typeAt(i) != "") { i = i + 1; continue; }   // 仍未折叠：跳过
                    t = "";
                }
                if (t == "") { i = i + 1; continue; }
                normalize3DNode(i);
                t = nodes_.typeAt(i);
                if (t == "ConvTranspose") {
                    // F8：转置卷积（group=1；权重 [Cin,Cout,kh,kw]，d1=Cout，d2=kh，d3=kw）
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int w = shapeIdx(nodes_.inputAt(i, 1)); if (w < 0) return 0;
                    int N = shapes_.d0(a); int Cin = shapes_.d1(a); int H = shapes_.d2(a); int W = shapes_.d3(a);
                    int Cout = shapes_.d1(w);
                    int kh = attrs_.get(i, NodeField.KH()); if (kh <= 0) kh = shapes_.d2(w);
                    int kw = attrs_.get(i, NodeField.KW()); if (kw <= 0) kw = shapes_.d3(w);
                    int sh_ = attrs_.get(i, NodeField.SH()); if (sh_ <= 0) sh_ = 1;
                    int sw_ = attrs_.get(i, NodeField.SW()); if (sw_ <= 0) sw_ = 1;
                    int yH = (H - 1) * sh_ - attrs_.get(i, NodeField.PT()) - attrs_.get(i, NodeField.PB()) + kh + attrs_.get(i, NodeField.OPH());
                    int yW = (W - 1) * sw_ - attrs_.get(i, NodeField.PL()) - attrs_.get(i, NodeField.PR()) + kw + attrs_.get(i, NodeField.OPW());
                    addShapeD4(nodes_.outputAt(i, 0), N, Cout, yH, yW);
                } else if (t == "Conv") {
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int w = shapeIdx(nodes_.inputAt(i, 1)); if (w < 0) return 0;
                    int N = shapes_.d0(a); int H = shapes_.d2(a); int W = shapes_.d3(a);
                    int yC = shapes_.d0(w);
                    int kh = shapes_.d2(w); int kw = shapes_.d3(w);
                    if (attrs_.get(i, NodeField.KH()) > 0) kh = attrs_.get(i, NodeField.KH());
                    if (attrs_.get(i, NodeField.KW()) > 0) kw = attrs_.get(i, NodeField.KW());
                    int yH = (H + attrs_.get(i, NodeField.PT()) + attrs_.get(i, NodeField.PB()) - attrs_.get(i, NodeField.DH()) * (kh - 1) - 1) / attrs_.get(i, NodeField.SH()) + 1;
                    int yW = (W + attrs_.get(i, NodeField.PL()) + attrs_.get(i, NodeField.PR()) - attrs_.get(i, NodeField.DW()) * (kw - 1) - 1) / attrs_.get(i, NodeField.SW()) + 1;
                    addShapeD4(nodes_.outputAt(i, 0), N, yC, yH, yW);
                } else if (t == "Conv3D") {
                    // 3D：权重 [Cout,Cin,kd,kh,kw]（5D）；kd/kh/kw = shD2/shD3/shD4
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int w = shapeIdx(nodes_.inputAt(i, 1)); if (w < 0) return 0;
                    int N = shapes_.d0(a); int D = shapes_.d2(a); int H = shapes_.d3(a); int W = shapes_.d4(a);
                    int yC = shapes_.d0(w);
                    int kd = shapes_.d2(w); int kh = shapes_.d3(w); int kw = shapes_.d4(w);
                    if (attrs_.get(i, NodeField.KD3()) > 0) kd = attrs_.get(i, NodeField.KD3());
                    if (attrs_.get(i, NodeField.KH()) > 0) kh = attrs_.get(i, NodeField.KH());
                    if (attrs_.get(i, NodeField.KW()) > 0) kw = attrs_.get(i, NodeField.KW());
                    int sd = attrs_.get(i, NodeField.SD3()); if (sd <= 0) sd = 1;
                    int sh_ = attrs_.get(i, NodeField.SH()); if (sh_ <= 0) sh_ = 1;
                    int sw_ = attrs_.get(i, NodeField.SW()); if (sw_ <= 0) sw_ = 1;
                    int dd = attrs_.get(i, NodeField.DD3()); if (dd <= 0) dd = 1;
                    int dh = attrs_.get(i, NodeField.DH()); if (dh <= 0) dh = 1;
                    int dw = attrs_.get(i, NodeField.DW()); if (dw <= 0) dw = 1;
                    int yD = (D + attrs_.get(i, NodeField.PDT()) + attrs_.get(i, NodeField.PDB()) - dd * (kd - 1) - 1) / sd + 1;
                    int yH = (H + attrs_.get(i, NodeField.PT()) + attrs_.get(i, NodeField.PB()) - dh * (kh - 1) - 1) / sh_ + 1;
                    int yW = (W + attrs_.get(i, NodeField.PL()) + attrs_.get(i, NodeField.PR()) - dw * (kw - 1) - 1) / sw_ + 1;
                    addShapeD5(nodes_.outputAt(i, 0), N, yC, yD, yH, yW);
                } else if (t == "MaxPool3D") {
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int N = shapes_.d0(a); int C = shapes_.d1(a); int D = shapes_.d2(a); int H = shapes_.d3(a); int W = shapes_.d4(a);
                    int kd = attrs_.get(i, NodeField.KD3()); if (kd <= 0) kd = 1;
                    int kh = attrs_.get(i, NodeField.KH()); if (kh <= 0) kh = 1;
                    int kw = attrs_.get(i, NodeField.KW()); if (kw <= 0) kw = 1;
                    int sd = attrs_.get(i, NodeField.SD3()); if (sd <= 0) sd = 1;
                    int sh_ = attrs_.get(i, NodeField.SH()); if (sh_ <= 0) sh_ = 1;
                    int sw_ = attrs_.get(i, NodeField.SW()); if (sw_ <= 0) sw_ = 1;
                    int yD = (D + attrs_.get(i, NodeField.PDT()) + attrs_.get(i, NodeField.PDB()) - kd) / sd + 1;
                    int yH = (H + attrs_.get(i, NodeField.PT()) + attrs_.get(i, NodeField.PB()) - kh) / sh_ + 1;
                    int yW = (W + attrs_.get(i, NodeField.PL()) + attrs_.get(i, NodeField.PR()) - kw) / sw_ + 1;
                    addShapeD5(nodes_.outputAt(i, 0), N, C, yD, yH, yW);
                } else if (t == "AveragePool3D") {
                    // 3D：各向异性核 kd/kh/kw + 6 pads + cip
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int N = shapes_.d0(a); int C = shapes_.d1(a); int D = shapes_.d2(a); int H = shapes_.d3(a); int W = shapes_.d4(a);
                    int kd = attrs_.get(i, NodeField.KD3()); if (kd <= 0) kd = 1;
                    int kh = attrs_.get(i, NodeField.KH()); if (kh <= 0) kh = 1;
                    int kw = attrs_.get(i, NodeField.KW()); if (kw <= 0) kw = 1;
                    int sd = attrs_.get(i, NodeField.SD3()); if (sd <= 0) sd = 1;
                    int sh_ = attrs_.get(i, NodeField.SH()); if (sh_ <= 0) sh_ = 1;
                    int sw_ = attrs_.get(i, NodeField.SW()); if (sw_ <= 0) sw_ = 1;
                    int yD = (D + attrs_.get(i, NodeField.PDT()) + attrs_.get(i, NodeField.PDB()) - kd) / sd + 1;
                    int yH = (H + attrs_.get(i, NodeField.PT()) + attrs_.get(i, NodeField.PB()) - kh) / sh_ + 1;
                    int yW = (W + attrs_.get(i, NodeField.PL()) + attrs_.get(i, NodeField.PR()) - kw) / sw_ + 1;
                    addShapeD5(nodes_.outputAt(i, 0), N, C, yD, yH, yW);
                } else if (t == "MaxPool") {
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int N = shapes_.d0(a); int C = shapes_.d1(a); int H = shapes_.d2(a); int W = shapes_.d3(a);
                    int kh = attrs_.get(i, NodeField.KH()); int kw = attrs_.get(i, NodeField.KW());
                    int yH = (H + attrs_.get(i, NodeField.PT()) + attrs_.get(i, NodeField.PB()) - kh) / attrs_.get(i, NodeField.SH()) + 1;
                    int yW = (W + attrs_.get(i, NodeField.PL()) + attrs_.get(i, NodeField.PR()) - kw) / attrs_.get(i, NodeField.SW()) + 1;
                    addShapeD4(nodes_.outputAt(i, 0), N, C, yH, yW);
                } else if (t == "AveragePool") {
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int N = shapes_.d0(a); int C = shapes_.d1(a); int H = shapes_.d2(a); int W = shapes_.d3(a);
                    int kh = attrs_.get(i, NodeField.KH()); int kw = attrs_.get(i, NodeField.KW());
                    int yH = (H + attrs_.get(i, NodeField.PT()) + attrs_.get(i, NodeField.PB()) - kh) / attrs_.get(i, NodeField.SH()) + 1;
                    int yW = (W + attrs_.get(i, NodeField.PL()) + attrs_.get(i, NodeField.PR()) - kw) / attrs_.get(i, NodeField.SW()) + 1;
                    addShapeD4(nodes_.outputAt(i, 0), N, C, yH, yW);
                } else if (t == "Pad") {
                    // F8：pads = [N,C,(D,)H,W] 各轴 begin/end（int64 初始器输入，opset11+）
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int is5 = shapes_.r5(a);
                    if (is5 == 1) {
                        int pc = i64Count(nodes_.inputAt(i, 1));
                        int fromPool = 0;
                        if (pc >= 10) fromPool = 1;
                        else { pc = readI64Init(nodes_.inputAt(i, 1), 10); }
                        if (pc < 10) return 0;
                        int pnB, pcB, pdB, phB, pwB, pnE, pcE, pdE, phE, pwE;
                        if (fromPool == 1) {
                            pnB = int(i64Get(nodes_.inputAt(i, 1), 0)); pcB = int(i64Get(nodes_.inputAt(i, 1), 1)); pdB = int(i64Get(nodes_.inputAt(i, 1), 2)); phB = int(i64Get(nodes_.inputAt(i, 1), 3)); pwB = int(i64Get(nodes_.inputAt(i, 1), 4));
                            pnE = int(i64Get(nodes_.inputAt(i, 1), 5)); pcE = int(i64Get(nodes_.inputAt(i, 1), 6)); pdE = int(i64Get(nodes_.inputAt(i, 1), 7)); phE = int(i64Get(nodes_.inputAt(i, 1), 8)); pwE = int(i64Get(nodes_.inputAt(i, 1), 9));
                        } else {
                            pnB = int(i64TmpL_[0]); pcB = int(i64TmpL_[1]); pdB = int(i64TmpL_[2]); phB = int(i64TmpL_[3]); pwB = int(i64TmpL_[4]);
                            pnE = int(i64TmpL_[5]); pcE = int(i64TmpL_[6]); pdE = int(i64TmpL_[7]); phE = int(i64TmpL_[8]); pwE = int(i64TmpL_[9]);
                        }
                        attrs_.setIntArray(i, 5, 0, pnB); attrs_.setIntArray(i, 5, 1, pcB); attrs_.setIntArray(i, 5, 2, pdB); attrs_.setIntArray(i, 5, 3, phB); attrs_.setIntArray(i, 5, 4, pwB);
                        attrs_.setIntArray(i, 12, 0, pnE); attrs_.setIntArray(i, 12, 1, pcE); attrs_.setIntArray(i, 12, 2, pdE); attrs_.setIntArray(i, 12, 3, phE); attrs_.setIntArray(i, 12, 4, pwE);
                        double cv = 0.0;
                        if (nodes_.inputAt(i, 2) != "") { int cvc = readF32Init(nodes_.inputAt(i, 2), 1); if (cvc > 0) cv = f32Tmp_[0]; }
                        nPadCval_[i] = F32.toBits(cv);
                        addShapeD5(nodes_.outputAt(i, 0), shapes_.d0(a) + pnB + pnE, shapes_.d1(a) + pcB + pcE,
                                   shapes_.d2(a) + pdB + pdE, shapes_.d3(a) + phB + phE, shapes_.d4(a) + pwB + pwE);
                        // pads/constant_value 已折叠进 nPadB5_/nPadE5_/nPadCval_
                        // （buildRuntime 只读这些折叠数组）→ 清空悬空参数槽，避免
                        // verifyIR 报 val<0（foldShapeChains 折叠 pads 链时生产者
                        // 已 erase、其 shape 未登记）。
                        nodes_.setInput(i, 1, ""); nodes_.setInput(i, 2, "");
                    } else {
                        int pc = i64Count(nodes_.inputAt(i, 1));
                        int fromPool = 0;
                        if (pc >= 8) fromPool = 1;
                        else { pc = readI64Init(nodes_.inputAt(i, 1), 8); }
                        if (pc < 8) return 0;
                        int pnB, pcB, phB, pwB, pnE, pcE, phE, pwE;
                        if (fromPool == 1) {
                            pnB = int(i64Get(nodes_.inputAt(i, 1), 0)); pcB = int(i64Get(nodes_.inputAt(i, 1), 1)); phB = int(i64Get(nodes_.inputAt(i, 1), 2)); pwB = int(i64Get(nodes_.inputAt(i, 1), 3));
                            pnE = int(i64Get(nodes_.inputAt(i, 1), 4)); pcE = int(i64Get(nodes_.inputAt(i, 1), 5)); phE = int(i64Get(nodes_.inputAt(i, 1), 6)); pwE = int(i64Get(nodes_.inputAt(i, 1), 7));
                        } else {
                            pnB = int(i64TmpL_[0]); pcB = int(i64TmpL_[1]); phB = int(i64TmpL_[2]); pwB = int(i64TmpL_[3]);
                            pnE = int(i64TmpL_[4]); pcE = int(i64TmpL_[5]); phE = int(i64TmpL_[6]); pwE = int(i64TmpL_[7]);
                        }
                        attrs_.setIntArray(i, 3, 0, pnB); attrs_.setIntArray(i, 3, 1, pcB); attrs_.setIntArray(i, 3, 2, phB); attrs_.setIntArray(i, 3, 3, pwB);
                        attrs_.setIntArray(i, 4, 0, pnE); attrs_.setIntArray(i, 4, 1, pcE); attrs_.setIntArray(i, 4, 2, phE); attrs_.setIntArray(i, 4, 3, pwE);
                        double cv = 0.0;
                        if (nodes_.inputAt(i, 2) != "") { int cvc = readF32Init(nodes_.inputAt(i, 2), 1); if (cvc > 0) cv = f32Tmp_[0]; }
                        nPadCval_[i] = F32.toBits(cv);
                        addShapeD4(nodes_.outputAt(i, 0), shapes_.d0(a) + pnB + pnE, shapes_.d1(a) + pcB + pcE,
                                   shapes_.d2(a) + phB + phE, shapes_.d3(a) + pwB + pwE);
                        // pads/constant_value 已折叠进 nPadB_/nPadE_/nPadCval_ → 清空参数槽
                        nodes_.setInput(i, 1, ""); nodes_.setInput(i, 2, "");
                    }
                } else if (t == "GlobalAveragePool") {
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    addShapeD4(nodes_.outputAt(i, 0), shapes_.d0(a), shapes_.d1(a), 1, 1);
                } else if (t == "Flatten") {
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    // F8 3D：5D 输入（NCDHW）须连深度维一起拍平（shD1*shD2*shD3*shD4）
                    int f = shapes_.d1(a) * shapes_.d2(a) * shapes_.d3(a);
                    if (shapes_.r5(a) == 1) f = f * shapes_.d4(a);
                    addShapeD4(nodes_.outputAt(i, 0), shapes_.d0(a), f, 1, 1);
                } else if (t == "Gemm") {
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int w = shapeIdx(nodes_.inputAt(i, 1)); if (w < 0) return 0;
                    int m = shapes_.d0(a);                     // [M,K]
                    int n = shapes_.d0(w);                     // transB=1: [N,K] → N=d0
                    if (attrs_.get(i, NodeField.TRANSB()) == 0) n = shapes_.d1(w);   // transB=0: [K,N] → N=d1
                    addShapeD4(nodes_.outputAt(i, 0), m, n, 1, 1);
                } else if (t == "MatMul") {
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int b = shapeIdx(nodes_.inputAt(i, 1)); if (b < 0) return 0;
                    addShapeD4(nodes_.outputAt(i, 0), shapes_.d0(a), shapes_.d1(b), 1, 1);
                } else if (t == "Add" || t == "Relu" || t == "Sigmoid" || t == "Softmax" || t == "BatchNormalization"
                           || t == "ReLU6" || t == "LeakyRelu" || t == "SiLU" || t == "HardSwish" || t == "Clip") {
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    copyShape(nodes_.outputAt(i, 0), a);
                } else if (t == "Reshape") {
                    // F8：shape 来自输入[1]（int64 初始器）；-1 = 由总元素数推断，0 = 复制对应输入维
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int sc = readI64Init(nodes_.inputAt(i, 1), 8);
                    if (sc <= 0) return 0;
                    int total = shapes_.d0(a) * shapes_.d1(a) * shapes_.d2(a) * shapes_.d3(a);
                    int[] outd = new int[8];
                    int inferIdx = -1;
                    int prod = 1;
                    int d = 0;
                    while (d < sc) {
                        int v = int(i64TmpL_[d]);
                        if (v == -1) { inferIdx = d; outd[d] = 1; }
                        else if (v == 0) {
                            if (d < 4) { outd[d] = (d == 0) ? shapes_.d0(a) : ((d == 1) ? shapes_.d1(a) : ((d == 2) ? shapes_.d2(a) : shapes_.d3(a))); }
                            else outd[d] = 1;
                        }
                        else outd[d] = v;
                        prod = prod * outd[d];
                        d = d + 1;
                    }
                    if (inferIdx >= 0 && prod > 0) outd[inferIdx] = total / prod;
                    int od0 = 1, od1 = 1, od2 = 1, od3 = 1;
                    if (sc >= 1) od0 = outd[0];
                    if (sc >= 2) od1 = outd[1];
                    if (sc >= 3) od2 = outd[2];
                    if (sc >= 4) od3 = outd[3];
                    addShapeD4(nodes_.outputAt(i, 0), od0, od1, od2, od3);
                } else if (t == "Concat") {
                    // F8：沿 axis 拼接（2-3 输入），输出 = 各输入沿 axis 之和，其余维同输入0
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int axis = attrs_.get(i, NodeField.AXIS());
                    if (axis < 0) axis = 0;
                    int is5 = shapes_.r5(a);
                    int[] dims = new int[5];
                    dims[0] = shapes_.d0(a); dims[1] = shapes_.d1(a); dims[2] = shapes_.d2(a); dims[3] = shapes_.d3(a); dims[4] = shapes_.d4(a);
                    // 沿 axis 累计（最多 3 输入，与 runtime opA/opB/opC 一致）
                    int axisSum = 0;
                    int slot = 0;
                    while (slot < 3) {
                        string nm;
                        if (slot == 0) nm = nodes_.inputAt(i, 0);
                        else if (slot == 1) nm = nodes_.inputAt(i, 1);
                        else nm = nodes_.inputAt(i, 2);
                        if (nm == "") { slot = 3; break; }
                        int s = shapeIdx(nm); if (s < 0) return 0;
                        int av = (axis == 0) ? shapes_.d0(s) : ((axis == 1) ? shapes_.d1(s) : ((axis == 2) ? shapes_.d2(s) : ((axis == 3) ? shapes_.d3(s) : shapes_.d4(s))));
                        axisSum = axisSum + av;
                        slot = slot + 1;
                    }
                    if (axis == 0) dims[0] = axisSum;
                    else if (axis == 1) dims[1] = axisSum;
                    else if (axis == 2) dims[2] = axisSum;
                    else if (axis == 3) dims[3] = axisSum;
                    else dims[4] = axisSum;
                    if (is5 == 1) addShapeD5(nodes_.outputAt(i, 0), dims[0], dims[1], dims[2], dims[3], dims[4]);
                    else addShapeD4(nodes_.outputAt(i, 0), dims[0], dims[1], dims[2], dims[3]);
                } else if (t == "Transpose") {
                    // F8：perm 属性（缺省 = 反转维度）
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int nd = 4;
                    int p0, p1, p2, p3;
                    if (attrs_.get(i, NodeField.PERM_N()) >= 4) { p0 = attrs_.get(i, NodeField.PERM0()); p1 = attrs_.get(i, NodeField.PERM1()); p2 = attrs_.get(i, NodeField.PERM2()); p3 = attrs_.get(i, NodeField.PERM3()); }
                    else if (attrs_.get(i, NodeField.PERM_N()) == 3) { p0 = attrs_.get(i, NodeField.PERM0()); p1 = attrs_.get(i, NodeField.PERM1()); p2 = attrs_.get(i, NodeField.PERM2()); p3 = 3; }
                    else if (attrs_.get(i, NodeField.PERM_N()) == 2) { p0 = attrs_.get(i, NodeField.PERM0()); p1 = attrs_.get(i, NodeField.PERM1()); p2 = 2; p3 = 3; }
                    else if (attrs_.get(i, NodeField.PERM_N()) == 1) { p0 = attrs_.get(i, NodeField.PERM0()); p1 = 1; p2 = 2; p3 = 3; }
                    else { p0 = 3; p1 = 2; p2 = 1; p3 = 0; }   // 缺省反转
                    int id0 = shapes_.d0(a), id1 = shapes_.d1(a), id2 = shapes_.d2(a), id3 = shapes_.d3(a);
                    int[] od = new int[4];
                    od[0] = (p0 == 0) ? id0 : ((p0 == 1) ? id1 : ((p0 == 2) ? id2 : id3));
                    od[1] = (p1 == 0) ? id0 : ((p1 == 1) ? id1 : ((p1 == 2) ? id2 : id3));
                    od[2] = (p2 == 0) ? id0 : ((p2 == 1) ? id1 : ((p2 == 2) ? id2 : id3));
                    od[3] = (p3 == 0) ? id0 : ((p3 == 1) ? id1 : ((p3 == 2) ? id2 : id3));
                    addShapeD4(nodes_.outputAt(i, 0), od[0], od[1], od[2], od[3]);
                } else if (t == "Slice") {
                    // F8：starts/ends/axes/steps 为 int64 初始器输入（opset 10+）
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int sc = readI64Init(nodes_.inputAt(i, 1), 8);   // starts
                    if (sc <= 0) return 0;
                    int k = 0;
                    while (k < sc) { attrs_.setLongArray(i, 0, k, i64TmpL_[k]); k = k + 1; }
                    int ec = readI64Init(nodes_.inputAt(i, 2), 8);   // ends
                    if (ec <= 0) return 0;
                    k = 0;
                    while (k < ec) { attrs_.setLongArray(i, 1, k, i64TmpL_[k]); k = k + 1; }
                    int ac = readI64Init(nodes_.inputAt(i, 3), 8);   // axes（可缺省 → 0..）
                    k = 0;
                    while (k < ac) { attrs_.setLongArray(i, 2, k, i64TmpL_[k]); k = k + 1; }
                    int pc = readI64Init(nodes_.inputAt(i, 4), 8);   // steps（可缺省 → 全 1）
                    k = 0;
                    while (k < pc) { attrs_.setLongArray(i, 3, k, i64TmpL_[k]); k = k + 1; }
                    int cnt = sc;
                    if (cnt > 4) cnt = 4;
                    attrs_.setSliceCount(i, cnt);
                    int id0 = shapes_.d0(a), id1 = shapes_.d1(a), id2 = shapes_.d2(a), id3 = shapes_.d3(a);
                    int[] odim = new int[4];
                    odim[0] = id0; odim[1] = id1; odim[2] = id2; odim[3] = id3;
                    k = 0;
                    while (k < cnt) {
                        int ax = 0;
                        if (ac > 0) ax = int(attrs_.longArray(i, 2, k));
                        else ax = k;
                        int step = 1;
                        if (pc > 0) step = int(attrs_.longArray(i, 3, k));
                        if (step == 0) return 0;   // 步长不能为 0
                        int D = (ax == 0) ? id0 : ((ax == 1) ? id1 : ((ax == 2) ? id2 : id3));
                        int co = sliceAxis(D, attrs_.longArray(i, 0, k), attrs_.longArray(i, 1, k), step, ax, i, k);
                        if (ax >= 0 && ax < 4) odim[ax] = co;
                        k = k + 1;
                    }
                    addShapeD4(nodes_.outputAt(i, 0), odim[0], odim[1], odim[2], odim[3]);
                } else if (t == "Split") {
                    // F8：沿 axis 分割为 nOutN_ 个输出（split attr 或均分；starts/lens 存 nSplitSt_/nSplitLn_）
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int axis = attrs_.get(i, NodeField.AXIS()); if (axis < 0) axis = 0;
                    int D = (axis == 0) ? shapes_.d0(a) : ((axis == 1) ? shapes_.d1(a) : ((axis == 2) ? shapes_.d2(a) : shapes_.d3(a)));
                    int no = attrs_.outputCount(i); if (no < 1) no = 1;
                    int ns = attrs_.get(i, NodeField.SPLIT_N());
                    int fromInput = 0;
                    if (ns <= 0 && nodes_.inputAt(i, 1) != "") { ns = readI64Init(nodes_.inputAt(i, 1), 4); fromInput = 1; }   // opset13+：split 为输入
                    int acc = 0;
                    int j = 0;
                    while (j < no && j < 4) {
                        int sz;
                        if (ns > j) {
                            if (fromInput == 1) sz = int(i64TmpL_[j]);
                            else sz = (j == 0) ? attrs_.get(i, NodeField.SPLIT0()) : ((j == 1) ? attrs_.get(i, NodeField.SPLIT1()) : ((j == 2) ? attrs_.get(i, NodeField.SPLIT2()) : attrs_.get(i, NodeField.SPLIT3())));
                        } else {
                            sz = D / no;
                        }
                        if (j == no - 1) sz = D - acc;   // 最后一份吸收余数
                        if (sz < 0) sz = 0;
                        attrs_.setIntArray(i, 6, j, acc);
                        attrs_.setIntArray(i, 7, j, sz);
                        acc = acc + sz;
                        int d0 = shapes_.d0(a), d1 = shapes_.d1(a), d2 = shapes_.d2(a), d3 = shapes_.d3(a);
                        if (axis == 0) d0 = sz;
                        else if (axis == 1) d1 = sz;
                        else if (axis == 2) d2 = sz;
                        else d3 = sz;
                        string onm = (j == 0) ? nodes_.outputAt(i, 0) : ((j == 1) ? nodes_.outputAt(i, 1) : ((j == 2) ? nodes_.outputAt(i, 2) : nodes_.outputAt(i, 3)));
                        addShapeD4(onm, d0, d1, d2, d3);
                        j = j + 1;
                    }
                } else if (t == "Sub" || t == "Div" || t == "Mul" || t == "Sqrt") {
                    // F8：秩无关逐元素（输出形状 = 输入 0；标量/同形状广播）
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    copyShape(nodes_.outputAt(i, 0), a);
                } else if (t == "ReduceMean") {
                    // F8：mode 0 = 全规约（标量）；mode 1 = 空间维规约（per-(n,c)，秩无关）
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int nAx = readI64Init(nodes_.inputAt(i, 1), 8);   // axes 输入（opset18+；可缺省）
                    if (nAx <= 0 && attrs_.get(i, NodeField.AXES_N()) > 0) {
                        // 属性形式（opset<=17）
                        nAx = attrs_.get(i, NodeField.AXES_N());
                        i64TmpL_[0] = attrs_.get(i, NodeField.AXES0());
                        i64TmpL_[1] = attrs_.get(i, NodeField.AXES1());
                        i64TmpL_[2] = attrs_.get(i, NodeField.AXES2());
                        i64TmpL_[3] = attrs_.get(i, NodeField.AXES3());
                    }
                    int mode = 0;
                    if (nAx > 0) {
                        int c0 = 0, c1 = 0, c2 = 0, c3 = 0;
                        int k = 0;
                        while (k < nAx) {
                            int ax = int(i64TmpL_[k]);
                            if (ax == 0) c0 = 1;
                            else if (ax == 1) c1 = 1;
                            else if (ax == 2) c2 = 1;
                            else if (ax == 3) c3 = 1;
                            k = k + 1;
                        }
                        if (c0 == 1 || c1 == 1) mode = 0;          // 含 N/C → 全规约
                        else if (c2 == 1 && c3 == 1) mode = 1;     // 空间维
                        else return 0;                              // 单空间维等 → 暂不支持
                    }
                    nRedMode_[i] = mode;
                    int N = shapes_.d0(a); int C = shapes_.d1(a);
                    int S = shapes_.d2(a) * shapes_.d3(a);
                    if (mode == 0) addShapeD4(nodes_.outputAt(i, 0), 1, 1, 1, 1);
                    else addShapeD4(nodes_.outputAt(i, 0), N, C, 1, 1);   // keepdims 0/1 均按 [N,C,1,1]
                } else if (t == "InstanceNormalization") {
                    // F8：per-(n,c) 空间归一化（秩无关；scale/bias 为 [C] 常量）
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int s = shapeIdx(nodes_.inputAt(i, 1)); if (s < 0) return 0;
                    int b = shapeIdx(nodes_.inputAt(i, 2)); if (b < 0) return 0;
                    copyShape(nodes_.outputAt(i, 0), a);
                } else if (t == "Resize" || t == "Upsample") {
                    // F8：2D/3D 上采样（nearest/linear/trilinear）。输出尺寸：sizes 初始器 > scales 初始器 > Upsample scales 属性
                    int a = shapeIdx(nodes_.inputAt(i, 0)); if (a < 0) return 0;
                    int N = shapes_.d0(a), C = shapes_.d1(a);
                    int D = shapes_.d2(a), H = shapes_.d3(a), W = shapes_.d4(a);
                    int is5 = shapes_.r5(a);
                    if (is5 == 0) { D = 1; H = shapes_.d2(a); W = shapes_.d3(a); }   // 2D：D=1,H,W=shD2,shD3
                    int outD = D, outH = H, outW = W;
                    if (t == "Upsample") {
                        double sh = attrFloat(i, NodeField.UPSH());   // P3d：统一属性访问
                        double sw = attrFloat(i, NodeField.UPSW());
                        if (sh == 0.0) sh = 1.0;
                        if (sw == 0.0) sw = 1.0;
                        double hd = float(H);
                        double wd = float(W);
                        outH = int(hd * sh);
                        outW = int(wd * sw);
                    } else {
                        if (is5 == 1) {
                            // 3D：sizes [N,C,outD,outH,outW]。foldShapeChains 可能在
                            // 输入秩确定前跑（shapeRank5 误判 0 → 只填 nRszH/nRszW），
                            // 故 is5=1 须 nRszD/H/W 三者齐备才用折叠值；否则回退 readI64Init。
                            if (attrs_.resizeD(i) > 0 && attrs_.resizeH(i) > 0 && attrs_.resizeW(i) > 0) {
                                outD = attrs_.resizeD(i); outH = attrs_.resizeH(i); outW = attrs_.resizeW(i);
                            } else {
                                int szc = readI64Init(nodes_.inputAt(i, 3), 8);   // sizes [N,C,outD,outH,outW]
                                if (szc >= 5) {
                                    outD = int(i64TmpL_[2]);
                                    outH = int(i64TmpL_[3]);
                                    outW = int(i64TmpL_[4]);
                                } else {
                                    int sc2 = readF32Init(nodes_.inputAt(i, 2), 8);   // scales [1,1,sd,sh,sw]
                                    if (sc2 >= 3) {
                                        double dd = float(D);
                                        double hd = float(H);
                                        double wd = float(W);
                                        outD = int(dd * f32Tmp_[2]);
                                        outH = int(hd * f32Tmp_[3]);
                                        outW = int(wd * f32Tmp_[4]);
                                    }
                                }
                            }
                        } else {
                            if (attrs_.resizeH(i) > 0 && attrs_.resizeW(i) > 0) {
                                outH = attrs_.resizeH(i); outW = attrs_.resizeW(i);
                            } else {
                                int szc = readI64Init(nodes_.inputAt(i, 3), 8);   // sizes [N,C,outH,outW]
                                if (szc >= 4) {
                                    outH = int(i64TmpL_[2]);
                                    outW = int(i64TmpL_[3]);
                                } else {
                                    int sc2 = readF32Init(nodes_.inputAt(i, 2), 8);   // scales [1,1,sh,sw]
                                    if (sc2 >= 3) {
                                        double hd = float(H);
                                        double wd = float(W);
                                        outH = int(hd * f32Tmp_[2]);
                                        outW = int(wd * f32Tmp_[3]);
                                    }
                                }
                            }
                        }
                    }
                    if (outD < 1) outD = 1;
                    if (outH < 1) outH = 1;
                    if (outW < 1) outW = 1;
                    if (is5 == 1) addShapeD5(nodes_.outputAt(i, 0), N, C, outD, outH, outW);
                    else addShapeD4(nodes_.outputAt(i, 0), N, C, outH, outW);
                } else {
                    return 0;   // 不支持的算子
                }
                i = i + 1;
            }
            return 1;
        }
        // F8：计算单轴切片（stIn/enIn 为全 int64 long）；写 nSlAx_/nSlSt_/nSlSp_
        // （nodeIdx 第 k 轴），返回输出长度（count）。支持负 step 反向。
        int sliceAxis(int D, long stIn, long enIn, int step, int ax, int nodeIdx, int k) {
            attrs_.setIntArray(nodeIdx, 0, k, ax);
            attrs_.setIntArray(nodeIdx, 2, k, step);
            int st;
            int cnt = 0;
            if (step > 0) {
                long stL = stIn;
                long enL = enIn;
                if (stL == 9223372036854775807L) stL = long(D);
                if (stL < 0L) stL = stL + long(D);
                if (enL == 9223372036854775807L) enL = long(D);
                if (enL < 0L) enL = enL + long(D);
                if (stL < 0L) stL = 0L;
                if (stL > long(D)) stL = long(D);
                if (enL < 0L) enL = 0L;
                if (enL > long(D)) enL = long(D);
                st = int(stL);
                int en = int(enL);
                if (en > st) cnt = (en - st + step - 1) / step;
            } else {
                long stL = stIn;
                long enL = enIn;
                if (stL == 9223372036854775807L) stL = long(D - 1);
                if (stL < 0L) stL = stL + long(D);
                if (enL == 9223372036854775807L) enL = -1L;
                if (enL < 0L) enL = enL + long(D);
                if (stL < -1L) stL = -1L;
                if (stL > long(D - 1)) stL = long(D - 1);
                if (enL < -1L) enL = -1L;
                if (enL > long(D - 1)) enL = long(D - 1);
                st = int(stL);
                int en = int(enL);
                int nsp = 0 - step;
                if (st > en) cnt = (st - en + nsp - 1) / nsp;
            }
            attrs_.setIntArray(nodeIdx, 1, k, st);
            return cnt;
        }
        int fuseConvBN() {
            int i = 0;
            while (i < nodes_.count()) {
                if (nodeOp(i) != OpCode.CONV()) { i = i + 1; continue; }
                if (attrs_.fused(i) == 1) { i = i + 1; continue; }
                if (isGraphOutput(nodes_.outputAt(i, 0)) == 1) { i = i + 1; continue; }
                // P2b：精确匹配 Conv 输出的唯一 Use = BatchNormalization operand0。
                // 残差分支、重复 operand 或 BN 接在非主输入时均不融合。
                int j = matchSingleUseOp(valueId(nodes_.outputAt(i, 0)), "BatchNormalization", 0);
                if (j < 0) { i = i + 1; continue; }
                // BN 4 参数必须是初始器
                if (initIdx(nodes_.inputAt(j, 1)) < 0 || initIdx(nodes_.inputAt(j, 2)) < 0 || initIdx(nodes_.inputAt(j, 3)) < 0 || initIdx(nodes_.inputAt(j, 4)) < 0) { i = i + 1; continue; }
                // 标记 conv 权重/偏置折叠（记录 BN 参数初始器下标 + BN 节点下标）
                int wi = initIdx(nodes_.inputAt(i, 1));
                int wb = initIdx(nodes_.inputAt(i, 2));
                if (wi >= 0) { weights_.set(wi, WeightField.BN(), 1); weights_.set(wi, WeightField.BN_NODE(), j); weights_.set(wi, WeightField.BN_SCALE(), initIdx(nodes_.inputAt(j, 1))); weights_.set(wi, WeightField.BN_BIAS(), initIdx(nodes_.inputAt(j, 2))); weights_.set(wi, WeightField.BN_MEAN(), initIdx(nodes_.inputAt(j, 3))); weights_.set(wi, WeightField.BN_VAR(), initIdx(nodes_.inputAt(j, 4))); }
                if (wb >= 0) { weights_.set(wb, WeightField.BN(), 1); weights_.set(wb, WeightField.BN_NODE(), j); weights_.set(wb, WeightField.BN_SCALE(), initIdx(nodes_.inputAt(j, 1))); weights_.set(wb, WeightField.BN_BIAS(), initIdx(nodes_.inputAt(j, 2))); weights_.set(wb, WeightField.BN_MEAN(), initIdx(nodes_.inputAt(j, 3))); weights_.set(wb, WeightField.BN_VAR(), initIdx(nodes_.inputAt(j, 4))); }
                else {
                    // G4：无卷积偏置的 Conv（真实模型常见）→ 由 BN 参数合成偏置
                    // b'[oc] = (0 - mean[oc])*invStd[oc] + bnBias[oc]（writeWeight 按 wBNOnly_ 计算）
                    int Cout = weights_.get(wi, WeightField.ROWS());
                    string bname = nodes_.outputAt(i, 0) + "#bnb";
                    int[] bdims = new int[1];
                    bdims[0] = Cout;
                    int bw = weights_.add(bname, Cout, 1, 1, 1, 0, Cout * 4);   // 无源字节，仅用于 count
                    weights_.set(bw, WeightField.ROLE(), 3);
                    weights_.set(bw, WeightField.BN(), 1);
                    weights_.set(bw, WeightField.BN_ONLY(), 1);
                    weights_.set(bw, WeightField.BN_NODE(), j);
                    weights_.set(bw, WeightField.BN_SCALE(), initIdx(nodes_.inputAt(j, 1)));
                    weights_.set(bw, WeightField.BN_BIAS(), initIdx(nodes_.inputAt(j, 2)));
                    weights_.set(bw, WeightField.BN_MEAN(), initIdx(nodes_.inputAt(j, 3)));
                    weights_.set(bw, WeightField.BN_VAR(), initIdx(nodes_.inputAt(j, 4)));
                    addShapeD(bname, bdims, 1);
                    setShapeKind(bname, Kind.CNN_B());
                    nodes_.setInput(i, 2, bname);
                }
                attrs_.setFused(i, 1);
                attrs_.setFusedOut(i, nodes_.outputAt(j, 0));
                nodes_.setType(j, "");
                markDeadTensor(nodes_.outputAt(i, 0));   // conv 中间输出
                // BN 参数不再被消费 → 标死（不分配/不登记/不写权重）
                if (liveConsumers(nodes_.inputAt(j, 1)) == 0) markDeadTensor(nodes_.inputAt(j, 1));
                if (liveConsumers(nodes_.inputAt(j, 2)) == 0) markDeadTensor(nodes_.inputAt(j, 2));
                if (liveConsumers(nodes_.inputAt(j, 3)) == 0) markDeadTensor(nodes_.inputAt(j, 3));
                if (liveConsumers(nodes_.inputAt(j, 4)) == 0) markDeadTensor(nodes_.inputAt(j, 4));
                bnCount_ = bnCount_ + 1;
                i = i + 1;
            }
            return 1;
        }
        double bnInvStd(int wi, int oc) {
            int j = weights_.get(wi, WeightField.BN_NODE());
            int scale = weights_.get(wi, WeightField.BN_SCALE());
            int variance = weights_.get(wi, WeightField.BN_VAR());
            double s = f32At(weights_.get(scale, WeightField.OFFSET()) + oc * 4);
            double v = f32At(weights_.get(variance, WeightField.OFFSET()) + oc * 4);
            double e = 1.0e-5;
            if (attrs_.get(j, NodeField.HAS_EPS()) == 1) e = attrFloat(j, NodeField.EPS_INT());   // P3a：统一属性访问
            return s / Math.sqrt(v + e);
        }
        double bnFoldBias(int wi, int oc, double b) {
            int j = weights_.get(wi, WeightField.BN_NODE());
            int mean = weights_.get(wi, WeightField.BN_MEAN());
            int bias = weights_.get(wi, WeightField.BN_BIAS());
            double m = f32At(weights_.get(mean, WeightField.OFFSET()) + oc * 4);
            double bb = f32At(weights_.get(bias, WeightField.OFFSET()) + oc * 4);
            return (b - m) * bnInvStd(wi, oc) + bb;
        }
        int isGraphOutput(string name) {
            int i = 0;
            while (i < goCount_) {
                if (goName_[i] == name) return 1;
                i = i + 1;
            }
            return 0;
        }
        int fuseConvAdd() {
            int i = 0;
            while (i < nodes_.count()) {
                if (nodeOp(i) != OpCode.CONV()) { i = i + 1; continue; }
                if (attrs_.relu(i) == 1) { i = i + 1; continue; }
                string eff = effectiveOut(i);
                if (eff == "" || isGraphOutput(eff) == 1) { i = i + 1; continue; }
                int j = matchSingleUseOp(valueId(eff), "Add", 0);
                if (j < 0) { i = i + 1; continue; }
                string resid = nodeInAt(j, 1);
                if (resid == "" || isGraphOutput(resid) == 1 || shapeIdx(resid) < 0) { i = i + 1; continue; }
                string addOut = nodes_.outputAt(j, 0);
                attrs_.setFused(i, 1);
                attrs_.setFusedOut(i, addOut);
                nodes_.setInput(i, 3, resid);
                nodes_.setType(j, "");
                markDeadTensor(eff);
                // P4-3：Add 输出唯一消费是 Relu → 折叠（doRelu 后置：conv+residual 再过 relu）
                int r = matchSingleUseOp(valueId(addOut), "Relu", 0);
                if (r >= 0) {
                    attrs_.setRelu(i, 1);
                    attrs_.setFusedOut(i, nodes_.outputAt(r, 0));
                    nodes_.setType(r, "");
                    markDeadTensor(addOut);
                }
                fusedAddCount_ = fusedAddCount_ + 1;
                i = i + 1;
            }
            return 1;
        }
        string effectiveOut(int i) {
            if (attrs_.fused(i) == 1) return attrs_.fusedOut(i);
            return nodes_.outputAt(i, 0);
        }
        int liveConsumers(string name) {
            int cnt = 0;
            int i = 0;
            while (i < nodes_.count()) {
                if (nodes_.typeAt(i) == "") { i = i + 1; continue; }
                if (nodes_.inputAt(i, 0) == name || nodes_.inputAt(i, 1) == name || nodes_.inputAt(i, 2) == name || nodes_.inputAt(i, 3) == name || nodes_.inputAt(i, 4) == name) cnt = cnt + 1;
                i = i + 1;
            }
            return cnt;
        }
        int foldConstants() {
            int i = 0;
            while (i < nodes_.count()) {
                if (nodes_.typeAt(i) == "Constant" && attrs_.get(i, NodeField.CONST_VAL()) == 1) {
                    int off = attrs_.get(i, NodeField.CONST_OFF());
                    int len = attrs_.get(i, NodeField.CONST_LEN());
                    int end = off + len;
                    pb_.seek(off);
                    int[] dims = new int[8];
                    int dimCount = 0;
                    int dt = 0;
                    int payloadKind = 0;
                    int payloadOff = 0;
                    int payloadLen = 0;
                    while (pb_.pos() < end) {
                        int f = pb_.nextTag();
                        if (f == -1) break;
                        if (f == 1) {
                            if (dimCount < 8) { dims[dimCount] = pb_.readVarint(); dimCount = dimCount + 1; }
                            else { long v = pb_.readVarint64(); }
                        } else if (f == 2) {
                            dt = pb_.readVarint();
                        } else if (f == 4 || f == 9) {
                            payloadKind = 1;
                            payloadLen = pb_.readLen();
                            payloadOff = pb_.payloadOff();
                            pb_.skipBytes(payloadLen);
                        } else if (f == 10) {
                            payloadKind = 2;
                            payloadLen = pb_.readLen();
                            payloadOff = pb_.payloadOff();
                            pb_.skipBytes(payloadLen);
                        } else {
                            pb_.skipField();
                        }
                    }
                    if (dt == 1 && payloadKind == 1) {   // FLOAT
                        int rows = 1; int cols = 1;
                        if (dimCount == 0) { rows = 1; cols = 1; }
                        else if (dimCount == 1) { rows = dims[0]; cols = 1; }
                        else if (dimCount == 2) { rows = dims[0]; cols = dims[1]; }
                        else {
                            rows = dims[0];
                            cols = 1;
                            int k = 1;
                            while (k < dimCount) { cols = cols * dims[k]; k = k + 1; }
                        }
                        int weight = weights_.add(nodes_.outputAt(i, 0), rows, cols, dt, payloadKind, payloadOff, payloadLen);
                        weights_.set(weight, WeightField.ROLE(), 4);      // 通用常量：直接拷贝
                        addShapeD(nodes_.outputAt(i, 0), dims, dimCount);
                        setShapeKind(nodes_.outputAt(i, 0), Kind.FC_C());
                        nodes_.setType(i, "");
                        foldCount_ = foldCount_ + 1;
                    }
                }
                i = i + 1;
            }
            return 1;
        }
        // 判断 name 是否由「尚未折叠的 shape 链节点」产出（int64 值后续才可知）。
        // 用于 Concat 折叠的部分折叠保护：避免把不完整的链（缺前缀/后缀）当完整折叠。
        int i64ChainAlive(string name) {
            int i = 0;
            while (i < nodes_.count()) {
                if (nodes_.typeAt(i) == "") { i = i + 1; continue; }
                if (nodes_.outputAt(i, 0) == name) {
                    string tp = nodes_.typeAt(i);
                    if (tp == "Constant" || tp == "Shape" || tp == "ReduceProd" ||
                        tp == "Unsqueeze" || tp == "Gather" || tp == "Slice" ||
                        tp == "Concat" || tp == "Cast") {
                        return 1;
                    }
                    return 0;
                }
                i = i + 1;
            }
            return 0;
        }

        int foldShapeChains() {
            // P3：int64 形状链折叠（Shape/Slice/Concat/Cast/Unsqueeze/Gather/ReduceProd）。
            // 可两次调用（inferShapes 前折叠 Resize sizes 链；后折叠剩余链）。幂等。
            // 先播种所有 int64 初始器常量
            int wi = 0;
            while (wi < weights_.count()) {
                if (weights_.get(wi, WeightField.DTYPE()) == 7) i64RegInit(weights_.nameAt(wi), weights_.nameAt(wi), 64);
                wi = wi + 1;
            }
            int i = 0;
            while (i < nodes_.count()) {
                string t = nodes_.typeAt(i);
                if (t == "") { i = i + 1; continue; }
                if (t == "Constant") {
                    if (attrs_.get(i, NodeField.CONST_VAL()) == 1) {
                        i64RegConstant(nodes_.outputAt(i, 0), attrs_.get(i, NodeField.CONST_OFF()), attrs_.get(i, NodeField.CONST_LEN()));
                        if (i64Count(nodes_.outputAt(i, 0)) > 0) { nodes_.setType(i, ""); foldCount_ = foldCount_ + 1; }
                    }
                } else if (t == "Shape") {
                    int s = shapeIdx(nodes_.inputAt(i, 0));
                    if (s < 0) { i = i + 1; continue; }
                    long[] v = new long[8];
                    int n = 4;
                    v[0] = long(shapes_.d0(s)); v[1] = long(shapes_.d1(s)); v[2] = long(shapes_.d2(s)); v[3] = long(shapes_.d3(s));
                    if (shapes_.r5(s) == 1) { v[4] = long(shapes_.d4(s)); n = 5; }
                    i64Reg(nodes_.outputAt(i, 0), v, n);
                    nodes_.setType(i, "");
                } else if (t == "ReduceProd") {
                    if (i64Count(nodes_.inputAt(i, 0)) > 0) {
                        int c = i64Count(nodes_.inputAt(i, 0));
                        long prod = 1L;
                        int k = 0;
                        while (k < c) { prod = prod * i64Get(nodes_.inputAt(i, 0), k); k = k + 1; }
                        long[] v = new long[1];
                        v[0] = prod;
                        i64Reg(nodes_.outputAt(i, 0), v, 1);
                        nodes_.setType(i, "");
                    }
                } else if (t == "Unsqueeze") {
                    if (i64Count(nodes_.inputAt(i, 0)) > 0) {
                        int c = i64Count(nodes_.inputAt(i, 0));
                        long[] v = new long[32];
                        int k = 0;
                        while (k < c) { v[k] = i64Get(nodes_.inputAt(i, 0), k); k = k + 1; }
                        i64Reg(nodes_.outputAt(i, 0), v, c);   // reshape：值不变
                        nodes_.setType(i, "");
                    }
                } else if (t == "Gather") {
                    if (i64Count(nodes_.inputAt(i, 0)) > 0 && i64Count(nodes_.inputAt(i, 1)) > 0) {
                        int dataN = i64Count(nodes_.inputAt(i, 0));
                        int idxN = i64Count(nodes_.inputAt(i, 1));
                        long[] v = new long[32];
                        int k = 0;
                        while (k < idxN && k < 32) {
                            long ix = i64Get(nodes_.inputAt(i, 1), k);
                            int ii = int(ix);
                            if (ii < 0) ii = ii + dataN;
                            if (ii >= 0 && ii < dataN) v[k] = i64Get(nodes_.inputAt(i, 0), ii);
                            else v[k] = 0L;
                            k = k + 1;
                        }
                        i64Reg(nodes_.outputAt(i, 0), v, idxN);
                        nodes_.setType(i, "");
                    }
                } else if (t == "Slice") {
                    // 仅折叠 int64 数据链（float 数据 Slice 是运行时算子，不动）
                    if (i64Count(nodes_.inputAt(i, 0)) > 0) {
                        int dataN = i64Count(nodes_.inputAt(i, 0));
                        long[] st = new long[8]; int stc = i64Count(nodes_.inputAt(i, 1));
                        int k = 0; while (k < stc && k < 8) { st[k] = i64Get(nodes_.inputAt(i, 1), k); k = k + 1; }
                        if (stc <= 0) { stc = readI64Init(nodes_.inputAt(i, 1), 8); k = 0; while (k < stc && k < 8) { st[k] = i64TmpL_[k]; k = k + 1; } }
                        long[] en = new long[8]; int enc = i64Count(nodes_.inputAt(i, 2));
                        k = 0; while (k < enc && k < 8) { en[k] = i64Get(nodes_.inputAt(i, 2), k); k = k + 1; }
                        if (enc <= 0) { enc = readI64Init(nodes_.inputAt(i, 2), 8); k = 0; while (k < enc && k < 8) { en[k] = i64TmpL_[k]; k = k + 1; } }
                        long[] ax = new long[8]; int axc = i64Count(nodes_.inputAt(i, 3));
                        k = 0; while (k < axc && k < 8) { ax[k] = i64Get(nodes_.inputAt(i, 3), k); k = k + 1; }
                        if (axc <= 0) { axc = readI64Init(nodes_.inputAt(i, 3), 8); k = 0; while (k < axc && k < 8) { ax[k] = i64TmpL_[k]; k = k + 1; } }
                        long[] sp = new long[8]; int spc = i64Count(nodes_.inputAt(i, 4));
                        k = 0; while (k < spc && k < 8) { sp[k] = i64Get(nodes_.inputAt(i, 4), k); k = k + 1; }
                        if (spc <= 0) { spc = readI64Init(nodes_.inputAt(i, 4), 8); k = 0; while (k < spc && k < 8) { sp[k] = i64TmpL_[k]; k = k + 1; } }
                        int cnt = stc; if (cnt > 4) cnt = 4;
                        long[] v = new long[32];
                        int outc = 0;
                        int j = 0;
                        while (j < cnt) {
                            int a = 0;
                            if (axc > 0) a = int(ax[j]); else a = j;
                            int step = 1;
                            if (spc > 0) step = int(sp[j]);
                            if (step == 0) step = 1;
                            int D = dataN;
                            long stL = st[j]; long enL = en[j];
                            if (stL == 9223372036854775807L) stL = long(D);
                            if (stL < 0L) stL = stL + long(D);
                            if (enL == 9223372036854775807L) enL = long(D);
                            if (enL < 0L) enL = enL + long(D);
                            if (stL < 0L) stL = 0L;
                            if (stL > long(D)) stL = long(D);
                            if (enL < 0L) enL = 0L;
                            if (enL > long(D)) enL = long(D);
                            int sti = int(stL);
                            int eni = int(enL);
                            if (step > 0) {
                                int q = sti;
                                while (q < eni && outc < 32) { v[outc] = i64Get(nodes_.inputAt(i, 0), q); outc = outc + 1; q = q + step; }
                            } else {
                                int q = sti;
                                while (q > eni && outc < 32) { v[outc] = i64Get(nodes_.inputAt(i, 0), q); outc = outc + 1; q = q + step; }
                            }
                            j = j + 1;
                        }
                        i64Reg(nodes_.outputAt(i, 0), v, outc);
                        nodes_.setType(i, "");
                    }
                } else if (t == "Concat") {
                    // 仅折叠 int64 链（float Concat 是运行时算子）
                    if (i64Count(nodes_.inputAt(i, 0)) > 0 || i64Count(nodes_.inputAt(i, 1)) > 0) {
                        // 部分折叠保护：若任一输入是「尚未折叠的 shape 链节点」
                        // （其 int64 值后续才可知），本次不折叠，留给 inferShapes
                        // 推进后的内部 foldShapeChains（避免丢掉前缀/后缀）。
                        int wait = 0;
                        int wslot = 0;
                        while (wslot < 3) {
                            string wnm;
                            if (wslot == 0) wnm = nodes_.inputAt(i, 0);
                            else if (wslot == 1) wnm = nodes_.inputAt(i, 1);
                            else wnm = nodes_.inputAt(i, 2);
                            if (wnm == "") { wslot = 3; break; }
                            if (i64ChainAlive(wnm) == 1) { wait = 1; wslot = 3; break; }
                            wslot = wslot + 1;
                        }
                        if (wait == 0) {
                            long[] v = new long[64];
                            int outc = 0;
                            int slot = 0;
                            while (slot < 3) {
                                string nm;
                                if (slot == 0) nm = nodes_.inputAt(i, 0);
                                else if (slot == 1) nm = nodes_.inputAt(i, 1);
                                else nm = nodes_.inputAt(i, 2);
                                if (nm == "") { slot = 3; break; }
                                if (i64Count(nm) > 0) {
                                    int c = i64Count(nm);
                                    int k = 0;
                                    while (k < c && outc < 64) { v[outc] = i64Get(nm, k); outc = outc + 1; k = k + 1; }
                                }
                                slot = slot + 1;
                            }
                            if (outc > 0) { i64Reg(nodes_.outputAt(i, 0), v, outc); nodes_.setType(i, ""); }
                        }
                    }
                } else if (t == "Cast") {
                    int to = attrs_.get(i, NodeField.CAST_TO());
                    if (to == 7 && i64Count(nodes_.inputAt(i, 0)) > 0) {
                        // int64 恒等（float 常量 Cast 折叠由第二次调用处理）
                        int c = i64Count(nodes_.inputAt(i, 0));
                        long[] v = new long[32];
                        int k = 0;
                        while (k < c) { v[k] = i64Get(nodes_.inputAt(i, 0), k); k = k + 1; }
                        i64Reg(nodes_.outputAt(i, 0), v, c);
                        nodes_.setType(i, "");
                    } else if (to == 1 && i64Count(nodes_.inputAt(i, 0)) > 0) {
                        // int64→float：注册为运行时 float 常量
                        int c = i64Count(nodes_.inputAt(i, 0));
                        int src = i64Find(nodes_.inputAt(i, 0));
                        long[] v = new long[32];
                        int k = 0;
                        while (k < c && k < 32) { v[k] = i64Get(nodes_.inputAt(i, 0), k); k = k + 1; }
                        regComputedF32(nodes_.outputAt(i, 0), v, c);
                        nodes_.setType(i, "");
                        foldCount_ = foldCount_ + 1;
                    }
                } else if (t == "Resize" || t == "Upsample") {
                    // 记录折叠出的 sizes（优先于初始器）。用 sizes 元素个数判断 3D/2D
                    // （3D=[N,C,outD,outH,outW] 5 个；2D=[N,C,outH,outW] 4 个）——
                    // 不依赖 shapeRank5（fold 阶段输入秩可能未定）。
                    int c5 = i64Count(nodes_.inputAt(i, 3));
                    if (c5 >= 5) {
                        attrs_.setResizeD(i, int(i64Get(nodes_.inputAt(i, 3), 2)));
                        attrs_.setResizeH(i, int(i64Get(nodes_.inputAt(i, 3), 3)));
                        attrs_.setResizeW(i, int(i64Get(nodes_.inputAt(i, 3), 4)));
                        // sizes 链已折叠（其生产者被 erase、shape 未登记）→ 清空
                        // 悬空输入槽，避免 verifyIR 报 val<0（buildRuntime 不读 nIn3_）。
                        nodes_.setInput(i, 3, "");
                    } else if (c5 >= 4) {
                        attrs_.setResizeH(i, int(i64Get(nodes_.inputAt(i, 3), 2)));
                        attrs_.setResizeW(i, int(i64Get(nodes_.inputAt(i, 3), 3)));
                        nodes_.setInput(i, 3, "");
                    }
                }
                i = i + 1;
            }
            return 1;
        }
        int layoutNHWC() {
            // Phase A：按拓扑序标记节点布局（nNHWC_）
            int i = 0;
            while (i < nodes_.count()) {
                attrs_.setNhwc(i, 0);
                string t = nodes_.typeAt(i);
                if (t == "Conv") attrs_.setNhwc(i, 1);                       // 卷积主干始终 NHWC
                else if (t == "MaxPool" || t == "AveragePool" || t == "Pad" || t == "Add" || t == "Relu" || t == "BatchNormalization") {
                    int p0 = producerNHWC(nodes_.inputAt(i, 0));
                    int p1 = producerNHWC(nodes_.inputAt(i, 1));
                    if (p0 == 1 || p1 == 1) attrs_.setNhwc(i, 1);
                } else if (t == "GlobalAveragePool") {
                    attrs_.setNhwc(i, producerNHWC(nodes_.inputAt(i, 0)));               // 输入侧 NHWC，输出为 NCHW 边界
                }
                i = i + 1;
            }
            // Phase A.5：NHWC 节点的输出张量登记为 NHWC（GAP 输出是边界，除外）
            i = 0;
            while (i < nodes_.count()) {
                if (attrs_.nhwc(i) == 1 && nodes_.typeAt(i) != "GlobalAveragePool") {
                    setShapeNHWC(effectiveOut(i));
                }
                i = i + 1;
            }
            // Phase B：确保 NHWC 节点的激活输入都在 NHWC（必要时插入转置节点）
            i = 0;
            while (i < nodes_.count()) {
                string t = nodes_.typeAt(i);
                if (attrs_.nhwc(i) == 1 && (t == "Conv" || t == "MaxPool" || t == "AveragePool" || t == "Pad" || t == "Add" || t == "Relu" || t == "GlobalAveragePool" || t == "BatchNormalization")) {
                    ensureNHWCInput(i, 0);
                    if (t == "Conv") markWeightNHWC(nodes_.inputAt(i, 1));
                    if (t == "Add") ensureNHWCInput(i, 1);
                }
                i = i + 1;
            }
            return 1;
        }
        int producerNHWC(string name) {
            int i = 0;
            while (i < nodes_.count()) {
                if (nodes_.typeAt(i) == "") { i = i + 1; continue; }
                string eff = nodes_.outputAt(i, 0);
                if (attrs_.fused(i) == 1) eff = attrs_.fusedOut(i);
                if (eff == name) return attrs_.nhwc(i);
                i = i + 1;
            }
            return 0;
        }
        void ensureNHWCInput(int nodeIdx, int slot) {
            string nm;
            if (slot == 0) nm = nodes_.inputAt(nodeIdx, 0);
            else nm = nodes_.inputAt(nodeIdx, 1);
            if (nm == "") return;
            if (producerNHWC(nm) == 1) return;    // 已是 NHWC
            if (initIdx(nm) >= 0) return;         // 初始器（权重单独处理）
            string tname = nm + "#nhwc";
            if (shapeIdx(tname) < 0) {
                int s = shapeIdx(nm);
                if (s < 0) return;
                int N = shapes_.d0(s); int H = shapes_.d1(s); int W = shapes_.d2(s); int C = shapes_.d3(s);
                addShapeD4(tname, N, H, W, C);              // [N,H,W,C] 形状
                setShapeKind(tname, Kind.CNN_ACT());
                setShapeNHWC(tname);
                // 追加 NCHW2NHWC 转置节点
                nodes_.setType(nodes_.count(), "NCHW2NHWC");
                nodes_.setInput(nodes_.count(), 0, nm);
                nodes_.setOutput(nodes_.count(), 0, tname);
                attrs_.set(nodes_.count(), NodeField.CONST_VAL(), 0);
                attrs_.setNhwc(nodes_.count(), 1);
                attrs_.setFused(nodes_.count(), 0);
                attrs_.setFusedBy(nodes_.count(), -1);
                attrs_.setFusedOut(nodes_.count(), "");
                nodes_.end();
            }
            if (slot == 0) nodes_.setInput(nodeIdx, 0, tname);
            else nodes_.setInput(nodeIdx, 1, tname);
        }
        void markWeightNHWC(string name) {
            int wi = initIdx(name);
            if (wi >= 0) {
                weights_.set(wi, WeightField.NHWC(), 1);
                setShapeNHWC(name);
            }
        }
        void markDeadTensor(string name) {
            shapes_.markDeadTensor(name);
        }
        void setShapeNHWC(string name) {
            shapes_.setShapeNHWC(name);
        }
        int topoSort() {
            int[] indeg = new int[512];
            // P0：所有既有 mutation pass 已完成，此处统一重建 def-use，再消费 O(1) producer 索引。
            rebuildDefUse();
            if (Console.getEnv("MYP_IR_VERIFY") == "1" && verifyIR() == 0) {
                Console.writeLine("DBG fail verifyIR");
                return 0;
            }
            int i = 0;
            while (i < nodes_.count()) {
                indeg[i] = 0;
                if (nodes_.typeAt(i) == "") { i = i + 1; continue; }
                if (valueProducer(nodeInputValue(i, 0)) >= 0) indeg[i] = indeg[i] + 1;
                if (valueProducer(nodeInputValue(i, 1)) >= 0) indeg[i] = indeg[i] + 1;
                if (valueProducer(nodeInputValue(i, 2)) >= 0) indeg[i] = indeg[i] + 1;
                if (valueProducer(nodeInputValue(i, 3)) >= 0) indeg[i] = indeg[i] + 1;
                i = i + 1;
            }
            analysis_.setPlanOrderCount(0);
            int remaining = 0;
            i = 0;
            while (i < nodes_.count()) { if (nodes_.typeAt(i) != "") remaining = remaining + 1; i = i + 1; }
            while (analysis_.planOrderCount() < remaining) {
                int picked = -1;
                i = 0;
                while (i < nodes_.count()) {
                    if (nodes_.typeAt(i) != "" && indeg[i] == 0) { picked = i; i = nodes_.count(); }
                    i = i + 1;
                }
                if (picked < 0) {
                    if (Console.getEnv("MYP_GR_DBG") == "1") {
                        Console.writeString("topoSort stuck remaining=" + Fmt.i(remaining) + " indeg[0..]:");
                        Console.writeLine("");
                        int d = 0;
                        while (d < nodes_.count()) {
                            if (nodes_.typeAt(d) != "" && indeg[d] > 0) {
                                Console.writeString("  n" + Fmt.i(d) + " type=" + nodes_.typeAt(d) + " indeg=" + Fmt.i(indeg[d]) + " in0=" + nodes_.inputAt(d, 0) + " in1=" + nodes_.inputAt(d, 1) + " in2=" + nodes_.inputAt(d, 2));
                                Console.writeLine("");
                            }
                            d = d + 1;
                        }
                    }
                    return 0;   // 有环
                }
                analysis_.setPlanOrder(analysis_.planOrderCount(), picked);
                analysis_.setPlanOrderCount(analysis_.planOrderCount() + 1);
                indeg[picked] = -1;
                // 多输出（Split/BwdDense/SoftmaxCE）：递减所有输出（out0..out3）的消费者
                string out = effectiveOut(picked);
                string o1 = nodes_.outputAt(picked, 1);
                string o2 = nodes_.outputAt(picked, 2);
                string o3 = nodes_.outputAt(picked, 3);
                // P0：按精确 (user,slot) use edge 递减，重复 operand（Mul(x,x)）自然处理。
                int[] produced = new int[4];
                produced[0] = valueId(out); produced[1] = valueId(o1); produced[2] = valueId(o2); produced[3] = valueId(o3);
                int ps = 0;
                while (ps < 4) {
                    int pv = produced[ps];
                    if (pv >= 0) {
                        int use = 0;
                        while (use < valueUseCount(pv)) {
                            int user = valueUseNode(pv, use);
                            if (user >= 0 && indeg[user] >= 0) indeg[user] = indeg[user] - 1;
                            use = use + 1;
                        }
                    }
                    ps = ps + 1;
                }
            }
            analysis_.setAnalysisValid(analysis_.analysisValid() | IRAnalysis.TOPO());
            analysis_.setTopoGeneration(analysis_.analysisGeneration());
            return 1;
        }
        int producerIdx(string name) {
            if (name == "") return -1;   // 空输入槽不算入度（nOut1_=="" 会误匹配）
            int i = 0;
            while (i < nodes_.count()) {
                if (nodes_.typeAt(i) == "") { i = i + 1; continue; }
                if (effectiveOut(i) == name) return i;
                if (nodes_.outputAt(i, 1) == name || nodes_.outputAt(i, 2) == name || nodes_.outputAt(i, 3) == name) return i;   // 多输出
                i = i + 1;
            }
            return -1;
        }
        int planMemory() {
            int si = 0;
            while (si < shapes_.count()) { planner_.setPlanProducer(si, -1); planner_.setPlanLastUse(si, -1); planner_.setPlanOff(si, 0); si = si + 1; }
            // producer = 产出该张量的节点在拓扑序中的位置（融合节点以 effectiveOut 计）
            int oi = 0;
            while (oi < analysis_.planOrderCount()) {
                int ni = analysis_.planOrder(oi);
                int s = shapeIdx(effectiveOut(ni));
                if (s >= 0) planner_.setPlanProducer(s, oi);
                oi = oi + 1;
            }
            // lastUse = 消费该张量的最大拓扑位置（活节点）
            oi = 0;
            while (oi < analysis_.planOrderCount()) {
                int ni = analysis_.planOrder(oi);
                int a = shapeIdx(nodes_.inputAt(ni, 0)); if (a >= 0 && oi > planner_.planLastUse(a)) planner_.setPlanLastUse(a, oi);
                int b = shapeIdx(nodes_.inputAt(ni, 1)); if (b >= 0 && oi > planner_.planLastUse(b)) planner_.setPlanLastUse(b, oi);
                int c = shapeIdx(nodes_.inputAt(ni, 2)); if (c >= 0 && oi > planner_.planLastUse(c)) planner_.setPlanLastUse(c, oi);
                // P4-2：残差融合把 Add 的 slot1 登记进 Conv 的 nIn3_——liveness 须覆盖 nIn3_/nIn4_
                int d = shapeIdx(nodes_.inputAt(ni, 3)); if (d >= 0 && oi > planner_.planLastUse(d)) planner_.setPlanLastUse(d, oi);
                int e = shapeIdx(nodes_.inputAt(ni, 4)); if (e >= 0 && oi > planner_.planLastUse(e)) planner_.setPlanLastUse(e, oi);
                oi = oi + 1;
            }
            // first-fit 分配（按形状表顺序 = 拓扑序）
            // persistent：权重 / 图输入 / 图输出（多 pass 需全程存活，区域不可复用）
            int rc = 0;
            int highWater = 0;
            si = 0;
            while (si < shapes_.count()) {
                if (shapes_.deadAt(si) == 1) { planner_.setPlanOff(si, 0); si = si + 1; continue; }   // G2：死张量不分配
                int size = shapes_.d0(si) * shapes_.d1(si) * shapes_.d2(si) * shapes_.d3(si);
                if (shapes_.r5(si) == 1) size = size * shapes_.d4(si);   // 3D：5D 张量乘 D 维
                int producer = planner_.planProducer(si);
                int lastUse = planner_.planLastUse(si);
                int persist = 0;
                if (producer < 0) persist = 1;            // 权重 / 图输入
                if (lastUse < 0) { persist = 1; lastUse = nodes_.count() - 1; }  // 图输出
                if (isGraphOutput(shapes_.nameAt(si)) == 1) persist = 1;   // 图输出：run 后用户仍读，缓冲不可复用
                if (noReuse_ == 1) persist = 1;            // 调试：不复用
                int best = -1;
                if (persist == 0) {
                    int r = 0;
                    while (r < rc) {
                        if (planner_.planRPersist(r) == 0 && planner_.planRLu(r) < producer && planner_.planRSize(r) >= size) { best = r; r = rc; }
                        r = r + 1;
                    }
                }
                int off = 0;
                if (best >= 0) {
                    off = planner_.planROff(best);
                    planner_.setPlanRSize(best, size);
                    planner_.setPlanRLu(best, lastUse);
                } else {
                    off = highWater;
                    highWater = highWater + size;
                    planner_.setPlanROff(rc, off);
                    planner_.setPlanRSize(rc, size);
                    planner_.setPlanRLu(rc, lastUse);
                    planner_.setPlanRPersist(rc, persist);
                    rc = rc + 1;
                }
                planner_.setPlanOff(si, off);
                si = si + 1;
            }
            analysis_.setAnalysisValid(analysis_.analysisValid() | IRAnalysis.LIVENESS());
            analysis_.setLivenessGeneration(analysis_.analysisGeneration());
            return highWater;
        }
        void writeWeight(InferenceRuntime rt, int wi, int tid) {
            int off = weights_.get(wi, WeightField.OFFSET());
            int count = weights_.get(wi, WeightField.LENGTH()) / 4;
            int j = 0;
            if (weights_.get(wi, WeightField.ROLE()) == 3) {
                // CNN 偏置：直接拷贝（G3：BN 折叠则应用偏置公式；G4：无原偏置卷积由 BN 合成）
                j = 0;
                while (j < count) {
                    double b = 0.0;
                    if (weights_.get(wi, WeightField.BN_ONLY()) == 0) b = f32At(off + j * 4);
                    double v = b;
                    if (weights_.get(wi, WeightField.BN()) == 1) v = bnFoldBias(wi, j, b);
                    rt.setFlat(tid, j, v);
                    j = j + 1;
                }
            } else if (weights_.get(wi, WeightField.ROLE()) == 2 && weights_.get(wi, WeightField.NHWC()) == 1) {
                // G2：CNN 权重 NHWC 转置 [Cout,Cin,KH,KW] → [Cout,KH,KW,Cin]
                // G3：BN 折叠按输出通道缩放（与转置可交换）
                int s = shapeIdx(weights_.nameAt(wi));
                int Cout = shapes_.d0(s); int Cin = shapes_.d1(s); int KH = shapes_.d2(s); int KW = shapes_.d3(s);
                int co = 0;
                while (co < Cout) {
                    int ci = 0;
                    while (ci < Cin) {
                        int kh = 0;
                        while (kh < KH) {
                            int kw = 0;
                            while (kw < KW) {
                                int src = ((co * Cin + ci) * KH + kh) * KW + kw;
                                int dst = ((co * KH + kh) * KW + kw) * Cin + ci;
                                double v = f32At(off + src * 4);
                                if (weights_.get(wi, WeightField.BN()) == 1) v = v * bnInvStd(wi, co);
                                rt.setFlat(tid, dst, v);
                                kw = kw + 1;
                            }
                            kh = kh + 1;
                        }
                        ci = ci + 1;
                    }
                    co = co + 1;
                }
            } else if (weights_.get(wi, WeightField.ROLE()) == 2 || weights_.get(wi, WeightField.ROLE()) == 1 || weights_.get(wi, WeightField.ROLE()) == 4) {
                // CNN 权重 NCHW / FC 偏置 / G2 折叠常量：直接拷贝
                // G3：CNN 权重 BN 折叠按输出通道缩放
                j = 0;
                while (j < count) {
                    double v = f32At(off + j * 4);
                    if (weights_.get(wi, WeightField.ROLE()) == 2 && weights_.get(wi, WeightField.BN()) == 1) {
                        int perOc = count / weights_.get(wi, WeightField.ROWS());
                        if (perOc < 1) perOc = 1;
                        v = v * bnInvStd(wi, j / perOc);
                    }
                    rt.setFlat(tid, j, v);
                    j = j + 1;
                }
            } else if (weights_.get(wi, WeightField.ROLE()) == 5) {
                // P3：计算 float 常量（Cast int64→float 折叠结果，值存 cF32_）
                j = 0;
                while (j < count) {
                    rt.setFlat(tid, j, cF32_[wi * 32 + j]);
                    j = j + 1;
                }
            } else if (weights_.get(wi, WeightField.TRANSPOSED()) == 1) {
                // FC 权重 transB=1：wire=[N,K] 直接拷贝
                j = 0;
                while (j < count) { rt.setFlat(tid, j, f32At(off + j * 4)); j = j + 1; }
            } else {
                // FC 权重 transB=0：wire=[K,N] 转置为 [N,K]
                int rows = weights_.get(wi, WeightField.ROWS()); int cols = weights_.get(wi, WeightField.COLS());
                int k = 0;
                while (k < rows) {
                    int n = 0;
                    while (n < cols) {
                        rt.setFlat(tid, n * rows + k, f32At(off + (k * cols + n) * 4));
                        n = n + 1;
                    }
                    k = k + 1;
                }
            }
        }
        double f32At(int byteOff) {
            int b0 = file_[byteOff];
            int b1 = file_[byteOff + 1];
            int b2 = file_[byteOff + 2];
            int b3 = file_[byteOff + 3];
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }

        // F8：读 int64 初始器值（Reshape 的 shape / Slice 的 starts/ends/axes/steps 等）。
        // 支持 raw_data（8 字节小端，wKind_==1 且 wType_==7）与 int64_data
        // （packed varint，wKind_==3）。返回读取个数（<=maxn）；值写入 i64TmpL_（全 int64 long）。
        int readI64Init(string name, int maxn) {
            int wi = initIdx(name);
            if (wi < 0) return 0;
            int cnt = 0;
            if (weights_.get(wi, WeightField.KIND()) == 1) {
                int j = 0;
                while (j < weights_.get(wi, WeightField.LENGTH()) / 8 && cnt < maxn) {
                    long v = 0L;
                    int k = 0;
                    while (k < 8) {
                        int b = file_[weights_.get(wi, WeightField.OFFSET()) + j * 8 + k];
                        v = v | (long(b) << (k * 8));
                        k = k + 1;
                    }
                    i64TmpL_[cnt] = v;
                    cnt = cnt + 1;
                    j = j + 1;
                }
            } else if (weights_.get(wi, WeightField.KIND()) == 3) {
                int end = weights_.get(wi, WeightField.OFFSET()) + weights_.get(wi, WeightField.LENGTH());
                pb_.seek(weights_.get(wi, WeightField.OFFSET()));
                while (pb_.pos() < end && cnt < maxn) {
                    long v = pb_.readVarint64();
                    i64TmpL_[cnt] = v;
                    cnt = cnt + 1;
                }
            }
            return cnt;
        }

        // ---- P3：int64 常量解释器（Shape/Slice/Concat/Cast/Unsqueeze/Gather/ReduceProd 折叠）----
        // 按张量名保存已知 int64 常量值（i64v_ 池）。
        int i64Find(string name) {
            int i = 0;
            while (i < i64Cnt_) {
                if (i64Name_[i] == name) return i;
                i = i + 1;
            }
            return -1;
        }
        int i64Count(string name) {
            int s = i64Find(name);
            if (s < 0) return 0;
            return i64n_[s];
        }
        long i64Get(string name, int k) {
            int s = i64Find(name);
            if (s < 0) return 0L;
            if (k >= i64n_[s]) return 0L;
            return i64v_[i64st_[s] + k];
        }
        // 注册 int64 常量；已存在则更新（幂等）
        void i64Reg(string name, long[] v, int n) {
            if (n < 0) n = 0;
            int s = i64Find(name);
            if (s < 0) {
                if (i64Cnt_ >= 256) return;
                s = i64Cnt_;
                i64Name_[s] = name;
                i64st_[s] = i64stTop_;
                i64Cnt_ = i64Cnt_ + 1;
            }
            i64n_[s] = n;
            int k = 0;
            while (k < n && i64st_[s] + k < 4096) {
                i64v_[i64st_[s] + k] = v[k];
                k = k + 1;
            }
            if (i64st_[s] + n > i64stTop_) i64stTop_ = i64st_[s] + n;
        }
        // 从初始器（int64）注册
        void i64RegInit(string name, string initName, int maxn) {
            int c = readI64Init(initName, maxn);
            if (c > 0) i64Reg(name, i64TmpL_, c);
        }
        // 从 Constant 节点 tensor（dtype int64）读取并注册
        void i64RegConstant(string name, int off, int len) {
            int end = off + len;
            pb_.seek(off);
            int[] dims = new int[8];
            int dimCount = 0;
            int dt = 0;
            int rawKind = 0; int rawOff = 0; int rawLen = 0;
            long[] vals = new long[64];
            int vc = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) { if (dimCount < 8) { dims[dimCount] = pb_.readVarint(); dimCount = dimCount + 1; } }
                else if (f == 2) { dt = pb_.readVarint(); }
                else if (f == 9) { rawKind = 1; rawLen = pb_.readLen(); rawOff = pb_.payloadOff(); pb_.skipBytes(rawLen); }
                else if (f == 7) { if (vc < 64) { vals[vc] = pb_.readVarint64(); vc = vc + 1; } }
                else { pb_.skipField(); }
            }
            if (dt == 7) {
                if (rawKind == 1) {
                    int j = 0;
                    while (j < rawLen / 8 && vc < 64) {
                        long v = 0L;
                        int k = 0;
                        while (k < 8) { v = v | (long(file_[rawOff + j * 8 + k]) << (k * 8)); k = k + 1; }
                        vals[vc] = v; vc = vc + 1;
                        j = j + 1;
                    }
                }
                i64Reg(name, vals, vc);
            }
        }
        // Cast(int64→float) 输出：注册为运行时 float 常量（wRole_=5，值存 cF32_）
        void regComputedF32(string name, long[] v, int n) {
            if (n <= 0) return;
            int wi = initIdx(name);
            if (wi < 0) {
                wi = weights_.add(name, n, 1, 1, 5, -1, n * 4);   // 计算常量（非 file_ 存储）
                if (wi < 0) return;
                weights_.set(wi, WeightField.ROLE(), 5);
            }
            int k = 0;
            while (k < n) {
                cF32_[wi * 32 + k] = double(v[k]);
                k = k + 1;
            }
            // 形状：标量 [1] 或 [n]；作为运行时 float 常量（FC_C）参与后续 float 运算
            addShapeD(name, singleDim(n), 1);
            setShapeKind(name, Kind.FC_C());
        }
        int[] singleDim(int n) { int[] d = new int[1]; d[0] = n; return d; }

    action:
        // ---- GraphCompiler 窄桥接（action 转发私有 function:，供跨类 lowering 调用）----
        int compilerShapeIdx(string name) { return shapeIdx(name); }
        int compilerWeightIdx(string name) { return initIdx(name); }
        int compilerWeightTransposed(int weight) { return weights_.get(weight, WeightField.TRANSPOSED()); }
        string compilerEffectiveOut(int node) { return effectiveOut(node); }
        void compilerWriteWeight(InferenceRuntime rt, int wi, int tid) { writeWeight(rt, wi, tid); }
        // 节点查询
        string compilerNodeOutput(int node, int slot) { return nodes_.outputAt(node, slot); }
        // 形状查询（ValueId 即 shape 表下标）
        int compilerShapeCount() { return shapes_.count(); }
        string compilerShapeName(int value) { return shapes_.nameAt(value); }
        int compilerShapeKind(int value) { return shapes_.kindAt(value); }
        int compilerShapeDead(int value) { return shapes_.deadAt(value); }
        int compilerShapeR5(int value) { return shapes_.r5(value); }
        int compilerShapeNhwc(int value) { return shapes_.nhwcAt(value); }
        int compilerShapeDim(int value, int axis) {
            if (axis == 0) return shapes_.d0(value);
            if (axis == 1) return shapes_.d1(value);
            if (axis == 2) return shapes_.d2(value);
            if (axis == 3) return shapes_.d3(value);
            if (axis == 4) return shapes_.d4(value);
            return 0;
        }
        // 规划/拓扑查询
        int compilerPlanOff(int value) { return planner_.planOff(value); }
        int compilerPlanOrderCount() { return analysis_.planOrderCount(); }
        int compilerPlanOrder(int i) { return analysis_.planOrder(i); }
        // 节点属性查询
        int compilerAttr(int node, int key) { return attrs_.get(node, key); }
        int compilerAttrRelu(int node) { return attrs_.relu(node); }
        int compilerAttrFused(int node) { return attrs_.fused(node); }
        int compilerAttrNhwc(int node) { return attrs_.nhwc(node); }
        int compilerAttrOutputCount(int node) { return attrs_.outputCount(node); }
        int compilerAttrSliceCount(int node) { return attrs_.sliceCount(node); }
        int compilerAttrIntArray(int node, int key, int index) { return attrs_.intArray(node, key, index); }
        // 节点杂项状态
        int compilerPadCval(int node) { if (node < 0 || node >= nodes_.count()) return 0; return nPadCval_[node]; }
        int compilerReduceMode(int node) { if (node < 0 || node >= nodes_.count()) return 0; return nRedMode_[node]; }
        int compilerDiceWMode() { return diceWMode_; }
        // pass 迁移访问器（GraphOptimizer 具体 pass 用）
        int compilerIsGraphOutput(string name) { return isGraphOutput(name); }
        void compilerEraseNode(int node) { eraseNode(node); }
        void compilerMarkDeadTensor(string name) { markDeadTensor(name); }
        int compilerValueUseCount(int value) { return valueUseCount(value); }
        int compilerDceCount() { return dceCount_; }
        void compilerIncDce() { dceCount_ = dceCount_ + 1; }
        void ensureDefUseForOptimizer() { ensureDefUse(); }
        int compilerGapCount() { return gapCount_; }
        void compilerIncGap() { gapCount_ = gapCount_ + 1; }

    property:
        int[] file_;
        int fileLen_;
        PbReader pb_;
        GraphNodes nodes_;
        GraphWeights weights_;
        long[512] i64TmpL_;   // F8：readI64Init 暂存（全 int64 long）
        double[512] f32Tmp_;  // F8：readF32Init 暂存（float 转 double）
        long[4096] i64v_;     // P3：int64 常量池
        string[256] i64Name_; // P3：int64 常量张量名
        int[256] i64n_;       // P3：每个 int64 常量元素数
        int[256] i64st_;      // P3：每个 int64 常量在池中起始
        int i64Cnt_;          // P3：int64 常量个数
        int i64stTop_;        // P3：池顶
        double[8192] cF32_;   // P3：计算 float 常量 [wIdx*32+k]
        GraphNodeAttrs attrs_;
        GraphAnalysis analysis_;
        GraphPlanner planner_;
        GraphCompiler compiler_;
        GraphOptimizer optimizer_;

        int[512] nRedMode_;     // F8：ReduceMean mode（0=全规约,1=空间规约）
        int[512] nPadCval_;     // F8：Pad constant_value（float 位型）
        int fuseCount_;          // G1：Conv+ReLU 融合数
        int gapCount_;           // G2：GAP+Flatten 融合数
        int dceCount_;           // G2：死算子消除数
        int foldCount_;          // G2：常量折叠数
        int bnCount_;            // G3：Conv+BN 融合数
        int fusedAddCount_;      // P4-2：Conv+残差Add 融合数
        int noReuse_;            // 调试：1 = 内存规划不复用区域（MYP_NO_REUSE=1）
        int doNHWC_;             // G2：布局变换开关（setLayoutNHWC）
        int lossMode_;           // 训练损失模式：0=SoftmaxCE，1=Dice（setLossMode）
        int diceWMode_;          // Dice 类权重：0=等权，1=逆频率（setDiceWMode）
        int trainingMode_;       // P4-3：1=训练图（不跑 FUSE_CONV_ADD，convResidual 无 backward）

        string[64] goName_;      // 图输出名（G1 融合安全）
        int goCount_;
        string[64] giName_;      // 图输入名（field 11，含真实输入与 initializer）
        int giCount_;

        GraphShapes shapes_;
}