// graph.myp — 通用图优化器组件（G5 重构）
// 格式无关的图 IR + 图 pass 管线 + 内存规划 + 运行时构建。
// 由 onnx_loader.myp（ONNX 解析器）通过图构建 API（setFile/addWeight/addShapeD/
// beginNode/endNode/nodeXxx/addGraphOutput）填充，然后 optimize(rt) 跑完整管线：
//   foldConstants → inferShapes → classifyShapes → fuseConvBN → fuseConvRelu
//   → fuseGapFlatten → eliminateDeadNodes → layoutNHWC(opt-in) → topoSort
//   → planMemory → buildRuntime
import env;
import math;
import fmt;
import "./pb.myp";
import "./runtime.myp";

class Kind {
    static:
        int FC_ACT() { return 0; }    // FC 激活（转置登记）
        int CNN_ACT() { return 1; }   // CNN 激活（NCHW 行优先）
        int FC_W() { return 2; }      // Gemm 权重
        int FC_B() { return 3; }      // Gemm 偏置
        int CNN_W() { return 4; }     // Conv 权重
        int CNN_B() { return 5; }     // Conv 偏置
        int FC_C() { return 6; }      // G2：折叠常量（直接拷贝，不转置）
        int FC_G() { return 7; }      // 阶段2：权重梯度（布局镜像基底权重，含 transB）
}

class NodeField {
    static:
        int TRANSB() { return 0; }
        int AXIS() { return 1; }
        int GROUP() { return 2; }
        int SH() { return 3; }
        int SW() { return 4; }
        int PT() { return 5; }
        int PL() { return 6; }
        int PB() { return 7; }
        int PR() { return 8; }
        int DH() { return 9; }
        int DW() { return 10; }
        int KH() { return 11; }
        int KW() { return 12; }
        int EPS_INT() { return 13; }
        int HAS_EPS() { return 14; }
        int ALPHA_INT() { return 15; }
        int HAS_ALPHA() { return 16; }
        int CONST_VAL() { return 17; }
        int CONST_OFF() { return 18; }
        int CONST_LEN() { return 19; }
        int PERM0() { return 20; }
        int PERM1() { return 21; }
        int PERM2() { return 22; }
        int PERM3() { return 23; }
        int PERM_N() { return 24; }
        int MODE() { return 25; }        // F8：Resize mode（0=nearest,1=linear）
        int TRANSFORM() { return 26; }   // F8：Resize coord（0=align_corners,1=half_pixel）
        int UPSH() { return 27; }        // F8：Upsample scales 高（floats）
        int UPSW() { return 28; }        // F8：Upsample scales 宽
        int KEEP() { return 29; }        // F8：ReduceMean keepdims
        int AXES0() { return 30; }       // F8：ReduceMean axes[0]（属性，opset<=17）
        int AXES1() { return 31; }
        int AXES2() { return 32; }
        int AXES3() { return 33; }
        int AXES_N() { return 34; }      // F8：axes 元素数
        int CIP() { return 35; }         // F8：AveragePool count_include_pad（0/1）
        int PADMODE() { return 36; }     // F8：Pad mode（0=const,1=reflect,2=edge）
        int OPH() { return 37; }         // F8：ConvTranspose output_padding 高
        int OPW() { return 38; }         // F8：ConvTranspose output_padding 宽
        int SPLIT0() { return 39; }      // F8：Split 输出 0 的尺寸（split attr）
        int SPLIT1() { return 40; }
        int SPLIT2() { return 41; }
        int SPLIT3() { return 42; }
        int SPLIT_N() { return 43; }     // F8：Split 尺寸个数
        int SD3() { return 44; }         // 3D：strides 第 1 个（sd）
        int DD3() { return 45; }         // 3D：dilations 第 1 个（dd）
        int KD3() { return 46; }         // 3D：kernel_shape 第 1 个（kd）
        int PDT() { return 47; }         // 3D：pads D-begin
        int PDB() { return 48; }         // 3D：pads D-end
        int ST0() { return 49; }         // 原始 strides[0..2]（2D/3D 通用捕获）
        int ST1() { return 50; }
        int ST2() { return 51; }
        int PD0() { return 52; }         // 原始 pads[0..5]（2D/3D 通用捕获）
        int PD1() { return 53; }
        int PD2() { return 54; }
        int PD3() { return 55; }
        int PD4() { return 56; }
        int PD5() { return 57; }
        int DL0() { return 58; }         // 原始 dilations[0..2]
        int DL1() { return 59; }
        int DL2() { return 60; }
        int KK0() { return 61; }         // 原始 kernel_shape[0..2]
        int KK1() { return 62; }
        int KK2() { return 63; }
        int CAST_TO() { return 64; }     // P3：Cast 目标 dtype（1=float,7=int64）
}

// IR-P1：分析缓存位。图结构或 shape 改写默认使全部分析失效；仅显式重建后才标记有效。
class IRAnalysis {
    static:
        int DEF_USE() { return 1; }
        int TOPO() { return 2; }
        int LIVENESS() { return 4; }
        int ALL() { return 7; }
}

// IR-P1：既有 pass 的稳定编号。保留固定顺序；P2 才引入 changed 驱动的不动点 rewrite。
class IRPassKind {
    static:
        int FOLD_SHAPES() { return 1; }
        int FOLD_CONSTS() { return 2; }
        int INFER_SHAPES() { return 3; }
        int CLASSIFY() { return 4; }
        int FUSE_BN() { return 5; }
        int FUSE_CONV_RELU() { return 6; }
        int FUSE_RELU() { return 7; }
        int FUSE_GAP_FLATTEN() { return 8; }
        int DCE() { return 9; }
        int LAYOUT_NHWC() { return 10; }
        int IDENTITY_FOLD() { return 11; }  // P2：Add(x,0)/Mul(x,1)，依赖 DefUse
}

class Graph {
    action:
        @constructor Graph() { pb_ = new PbReader(); }

        int tensorId(string name) {
            int i = 0;
            while (i < tCount_) {
                if (tName_[i] == name) return tId_[i];
                i = i + 1;
            }
            return -1;
        }

        // ---- 图统计（供验证入口打印；G5 由 Graph 自持）----
        void setLayoutNHWC(int v) { doNHWC_ = v; }
        int doNHWC() { return doNHWC_; }
        // 训练损失模式：0=SoftmaxCE（默认），1=Dice（分割，阶段4d）
        void setLossMode(int v) { lossMode_ = v; }
        int lossMode() { return lossMode_; }
        // 类不平衡 Dice：0=等权（默认），1=逆频率加权（setDiceWMode）
        void setDiceWMode(int v) { diceWMode_ = v; }
        int diceWMode() { return diceWMode_; }
        int fuseCount() { return fuseCount_; }
        int gapCount() { return gapCount_; }
        int dceCount() { return dceCount_; }
        int foldCount() { return foldCount_; }
        int bnCount() { return bnCount_; }
        int nodeCount() { return nCount_; }
        // ---- IR-P1 AnalysisManager（轻量）：generation 可断言调用方未使用过期分析。----
        int analysisGeneration() { return analysisGeneration_; }
        int analysisValid(int mask) { return (analysisValid_ & mask) == mask ? 1 : 0; }
        int defUseGeneration() { return duGeneration_; }
        int topoGeneration() { return topoGeneration_; }
        int livenessGeneration() { return livenessGeneration_; }
        // IR-P1b PassResult（MYP 无轻量 record 返回值，故由 Graph 保存最后一次执行结果）。
        int lastPassOk() { return lastPassOk_; }
        int lastPassChanged() { return lastPassChanged_; }
        int lastPassPreservedAnalyses() { return lastPassPreserved_; }
        // P1c：P2 rewrite pass 首次声明 DefUse；legacy pass 直接扫描 SoA，依赖为 0。
        int passRequiredAnalyses(int pass) {
            if (pass == IRPassKind.IDENTITY_FOLD()) return IRAnalysis.DEF_USE();
            if (pass == IRPassKind.FUSE_BN()) return IRAnalysis.DEF_USE();
            if (pass == IRPassKind.FUSE_CONV_RELU()) return IRAnalysis.DEF_USE();
            if (pass == IRPassKind.FUSE_RELU()) return IRAnalysis.DEF_USE();
            if (pass == IRPassKind.FUSE_GAP_FLATTEN()) return IRAnalysis.DEF_USE();
            if (pass == IRPassKind.DCE()) return IRAnalysis.DEF_USE();
            return 0;
        }
        // 分析按需获取。ensureTopo 会先保证 DefUse；两者无 graph mutation，不改变 generation。
        int ensureDefUse() {
            if (duValid_ == 0 || analysisValid(IRAnalysis.DEF_USE()) == 0 || duGeneration_ != analysisGeneration_) rebuildDefUse();
            return 1;
        }
        int ensureTopo() {
            if (analysisValid(IRAnalysis.TOPO()) == 0 || topoGeneration_ != analysisGeneration_) return topoSort();
            return 1;
        }
        int ensurePassAnalyses(int pass) {
            int required = passRequiredAnalyses(pass);
            if ((required & IRAnalysis.DEF_USE()) != 0) { if (ensureDefUse() == 0) return 0; }
            if ((required & IRAnalysis.TOPO()) != 0) { if (ensureTopo() == 0) return 0; }
            // Liveness 只由 lowering 前 planMemory 显式构建；禁止在优化 pass 中隐式写规划结果。
            if ((required & IRAnalysis.LIVENESS()) != 0 && analysisValid(IRAnalysis.LIVENESS()) == 0) return 0;
            return 1;
        }
        void invalidateAnalyses(int mask) {
            analysisValid_ = analysisValid_ & (IRAnalysis.ALL() - mask);
            analysisGeneration_ = analysisGeneration_ + 1;
            if ((mask & IRAnalysis.DEF_USE()) != 0) duValid_ = 0;
            if ((mask & IRAnalysis.TOPO()) != 0) planOrderCount_ = 0;
        }
        // 旧 pass 直接改 SoA；在其后调用此入口统一采取保守失效，避免遗留索引被误用。
        void markIRMutation() { invalidateAnalyses(IRAnalysis.ALL()); }
        // ---- G5：图构建 API（供解析器 OnnxLoader 调用）----
        void setFile(int[] f, int len) { file_ = f; fileLen_ = len; pb_.init(file_, fileLen_); }
        int beginNode() {
            int i = nCount_;
            nIn0_[i] = ""; nIn1_[i] = ""; nIn2_[i] = ""; nIn3_[i] = ""; nIn4_[i] = "";
            nOut0_[i] = ""; nType_[i] = "";
            nConstVal_[i] = 0; nEpsInt_[i] = 0; nHasEps_[i] = 0; nAlphaInt_[i] = 0; nHasAlpha_[i] = 0;
            nFused_[i] = 0; nFusedBy_[i] = -1; nFusedOut_[i] = ""; nRelu_[i] = 0; nNHWC_[i] = 0;
            nTransB_[i] = 0; nAxis_[i] = -1;
            nSH_[i] = 1; nSW_[i] = 1; nPT_[i] = 0; nPB_[i] = 0; nPL_[i] = 0; nPR_[i] = 0;
            nDH_[i] = 1; nDW_[i] = 1; nGroup_[i] = 1; nKH_[i] = 0; nKW_[i] = 0;
            nP0_[i] = 0; nP1_[i] = 0; nP2_[i] = 0; nP3_[i] = 0; nPc_[i] = 0;   // F8: Transpose perm
            nMode_[i] = 0; nTransform_[i] = 0; nUpSH_[i] = 0; nUpSW_[i] = 0;   // F8: Resize/Upsample
            nKeep_[i] = 0; nRedMode_[i] = 0;                                   // F8: ReduceMean
            nAx0_[i] = 0; nAx1_[i] = 0; nAx2_[i] = 0; nAx3_[i] = 0; nAxN_[i] = 0;
            nCip_[i] = 0;                                                      // F8: AveragePool count_include_pad
            nPadMode_[i] = 0; nPadCval_[i] = 0;                                // F8: Pad mode / constant_value
            nOutPadH_[i] = 0; nOutPadW_[i] = 0;                                // F8: ConvTranspose output_padding
            nOut1_[i] = ""; nOut2_[i] = ""; nOut3_[i] = ""; nOutN_[i] = 0;   // F8: Split 多输出
            nSplitN_[i] = 0; nSp0_[i] = 0; nSp1_[i] = 0; nSp2_[i] = 0; nSp3_[i] = 0;
            return i;
        }
        void endNode() { nCount_ = nCount_ + 1; }
        void nodeType(int i, string v) { nType_[i] = v; }
        string nodeTypeAt(int i) { return nType_[i]; }
        void nodeIn(int i, int slot, string v) { if (slot==0) nIn0_[i]=v; else if (slot==1) nIn1_[i]=v; else if (slot==2) nIn2_[i]=v; else if (slot==3) nIn3_[i]=v; else nIn4_[i]=v; }
        string nodeInAt(int i, int slot) { if (slot==0) return nIn0_[i]; if (slot==1) return nIn1_[i]; if (slot==2) return nIn2_[i]; if (slot==3) return nIn3_[i]; return nIn4_[i]; }
        // ---- P0 IR 访问器：ValueId = shape table index（名称只在 ONNX 边界保留）----
        // 既有 pass 仍可直接写 SoA；消费 def-use 前调用 rebuildDefUse() 重建索引。
        int valueId(string name) { return shapeIdx(name); }
        string valueName(int value) { if (value < 0 || value >= sCount_) return ""; return shName_[value]; }
        int nodeAlive(int node) { if (node < 0 || node >= nCount_ || nType_[node] == "") return 0; return 1; }
        int nodeInputValue(int node, int slot) { if (node < 0 || node >= nCount_ || slot < 0 || slot >= 5) return -1; return shapeIdx(nodeInAt(node, slot)); }
        int nodeOutputValue(int node, int slot) {
            if (node < 0 || node >= nCount_ || slot < 0 || slot >= 4) return -1;
            string out = "";
            if (slot == 0) out = effectiveOut(node);
            else if (slot == 1) out = nOut1_[node];
            else if (slot == 2) out = nOut2_[node];
            else out = nOut3_[node];
            return shapeIdx(out);
        }
        // 唯一输入改写入口。P0 只失效索引；P1 再演进为增量维护与 analysis manager。
        void replaceNodeInput(int node, int slot, int value) {
            if (node < 0 || node >= nCount_ || slot < 0 || slot >= 5 || value < 0 || value >= sCount_) return;
            nodeIn(node, slot, shName_[value]);
            duValid_ = 0;
            analysisValid_ = analysisValid_ & (IRAnalysis.ALL() - IRAnalysis.DEF_USE());
        }
        // P2 rewrite 原语：把 oldValue 的每条精确 Use（包含重复 operand）改接到 newValue。
        // 必须先 ensureDefUse；扫描 use 快照期间只改 node 输入，最后一次性失效索引。
        void replaceAllUses(int oldValue, int newValue) {
            if (oldValue < 0 || newValue < 0 || oldValue >= sCount_ || newValue >= sCount_) return;
            ensureDefUse();
            int count = valueUseCount(oldValue);
            int use = 0;
            while (use < count) {
                int user = valueUseNode(oldValue, use);
                int slot = valueUseSlot(oldValue, use);
                if (user >= 0 && slot >= 0) nodeIn(user, slot, shName_[newValue]);
                use = use + 1;
            }
            duValid_ = 0;
            analysisValid_ = analysisValid_ & (IRAnalysis.ALL() - IRAnalysis.DEF_USE());
        }
        int valueProducer(int value) { if (duValid_ == 0 || value < 0 || value >= sCount_) return -1; return duProducer_[value]; }
        int valueUseCount(int value) { if (duValid_ == 0 || value < 0 || value >= sCount_) return 0; return duUseCount_[value]; }
        int valueUseNode(int value, int use) {
            if (duValid_ == 0 || value < 0 || value >= sCount_ || use < 0 || use >= duUseCount_[value]) return -1;
            int edge = duFirstUse_[value];
            int ordinal = 0;
            while (edge >= 0 && ordinal < use) { edge = duNextUse_[edge]; ordinal = ordinal + 1; }
            if (edge < 0) return -1;
            return duUseNode_[edge];
        }
        int valueUseSlot(int value, int use) {
            if (duValid_ == 0 || value < 0 || value >= sCount_ || use < 0 || use >= duUseCount_[value]) return -1;
            int edge = duFirstUse_[value];
            int ordinal = 0;
            while (edge >= 0 && ordinal < use) { edge = duNextUse_[edge]; ordinal = ordinal + 1; }
            if (edge < 0) return -1;
            return duUseSlot_[edge];
        }
        // 重建精确 def-use：每条 edge 记录 (consumer node, operand slot)，保留 Mul(x,x) 等重复 use。
        // 全图最多 5*nCount_ 条边，以压缩链表保存，避免每个 Value 预留 nCount_ 个槽。
        void rebuildDefUse() {
            int v = 0;
            while (v < sCount_) { duProducer_[v] = -1; duUseCount_[v] = 0; duFirstUse_[v] = -1; v = v + 1; }
            duEdgeCount_ = 0;
            int node = 0;
            while (node < nCount_) {
                if (nodeAlive(node) == 1) {
                    int outSlot = 0;
                    while (outSlot < 4) {
                        int out = nodeOutputValue(node, outSlot);
                        if (out >= 0 && duProducer_[out] < 0) duProducer_[out] = node;
                        outSlot = outSlot + 1;
                    }
                    int inSlot = 0;
                    while (inSlot < 5) {
                        int input = nodeInputValue(node, inSlot);
                        if (input >= 0 && duEdgeCount_ < 2560) {
                            int edge = duEdgeCount_;
                            duUseNode_[edge] = node;
                            duUseSlot_[edge] = inSlot;
                            duNextUse_[edge] = duFirstUse_[input];
                            duFirstUse_[input] = edge;
                            duUseCount_[input] = duUseCount_[input] + 1;
                            duEdgeCount_ = duEdgeCount_ + 1;
                        }
                        inSlot = inSlot + 1;
                    }
                }
                node = node + 1;
            }
            duValid_ = 1;
            analysisValid_ = analysisValid_ | IRAnalysis.DEF_USE();
            duGeneration_ = analysisGeneration_;
        }
        // P0 验证器：检查精确 use edge、活节点输入形状、单 producer（图输入/常量 producer=-1 合法）。
        int verifyIR() {
            if (duValid_ == 0) rebuildDefUse();
            int node = 0;
            while (node < nCount_) {
                if (nodeAlive(node) == 1) {
                    int slot = 0;
                    while (slot < 5) {
                        string name = nodeInAt(node, slot);
                        int value = nodeInputValue(node, slot);
                        if (name != "" && value < 0) return 0;
                        if (value >= 0) {
                            int found = 0;
                            int use = 0;
                            while (use < valueUseCount(value)) {
                                if (valueUseNode(value, use) == node && valueUseSlot(value, use) == slot) found = 1;
                                use = use + 1;
                            }
                            if (found == 0) return 0;
                        }
                        slot = slot + 1;
                    }
                }
                node = node + 1;
            }
            return 1;
        }
        int shapeRank5(string name) { int s = shapeIdx(name); if (s < 0) return 0; return shR5_[s]; }
        // 张量元素总数（按形状表 dims；图输入/输出张量无 runtime 2D 投影，须用此取 size）
        int shapeElementCount(string name) {
            int s = shapeIdx(name);
            if (s < 0) return -1;
            // 动态维度（dim_param）按 1 处理（batch=1 推理惯例）
            int d0 = shD0_[s]; if (d0 == 0) d0 = 1;
            int d1 = shD1_[s]; if (d1 == 0) d1 = 1;
            int d2 = shD2_[s]; if (d2 == 0) d2 = 1;
            int d3 = shD3_[s]; if (d3 == 0) d3 = 1;
            int d4 = shD4_[s]; if (d4 == 0) d4 = 1;
            int n = d0 * d1 * d2 * d3;
            if (shR5_[s] == 1) n = n * d4;
            return n;
        }
        int rawSt(int i, int k) { return nSt3_[i * 3 + k]; }
        int rawPd(int i, int k) { return nPd3_[i * 6 + k]; }
        int rawDl(int i, int k) { return nDl3_[i * 3 + k]; }
        int rawKk(int i, int k) { return nKk3_[i * 3 + k]; }
        void nodeOut(int i, string v) {
            if (nOut0_[i] == "") nOut0_[i] = v;
            else if (nOut1_[i] == "") nOut1_[i] = v;
            else if (nOut2_[i] == "") nOut2_[i] = v;
            else nOut3_[i] = v;
            nOutN_[i] = nOutN_[i] + 1;   // F8：Split 多输出计数
        }
        void nodeInt(int i, int code, int v) {
            if (code == NodeField.TRANSB()) nTransB_[i] = v;
            else if (code == NodeField.AXIS()) nAxis_[i] = v;
            else if (code == NodeField.GROUP()) nGroup_[i] = v;
            else if (code == NodeField.SH()) nSH_[i] = v;
            else if (code == NodeField.SW()) nSW_[i] = v;
            else if (code == NodeField.PT()) nPT_[i] = v;
            else if (code == NodeField.PL()) nPL_[i] = v;
            else if (code == NodeField.PB()) nPB_[i] = v;
            else if (code == NodeField.PR()) nPR_[i] = v;
            else if (code == NodeField.DH()) nDH_[i] = v;
            else if (code == NodeField.DW()) nDW_[i] = v;
            else if (code == NodeField.KH()) nKH_[i] = v;
            else if (code == NodeField.KW()) nKW_[i] = v;
            else if (code == NodeField.EPS_INT()) nEpsInt_[i] = v;
            else if (code == NodeField.HAS_EPS()) nHasEps_[i] = v;
            else if (code == NodeField.ALPHA_INT()) nAlphaInt_[i] = v;
            else if (code == NodeField.HAS_ALPHA()) nHasAlpha_[i] = v;
            else if (code == NodeField.CONST_VAL()) nConstVal_[i] = v;
            else if (code == NodeField.CONST_OFF()) nConstOff_[i] = v;
            else if (code == NodeField.CONST_LEN()) nConstLen_[i] = v;
            else if (code == NodeField.PERM0()) nP0_[i] = v;
            else if (code == NodeField.PERM1()) nP1_[i] = v;
            else if (code == NodeField.PERM2()) nP2_[i] = v;
            else if (code == NodeField.PERM3()) nP3_[i] = v;
            else if (code == NodeField.PERM_N()) nPc_[i] = v;
            else if (code == NodeField.MODE()) nMode_[i] = v;
            else if (code == NodeField.TRANSFORM()) nTransform_[i] = v;
            else if (code == NodeField.UPSH()) nUpSH_[i] = v;
            else if (code == NodeField.UPSW()) nUpSW_[i] = v;
            else if (code == NodeField.KEEP()) nKeep_[i] = v;
            else if (code == NodeField.AXES0()) nAx0_[i] = v;
            else if (code == NodeField.AXES1()) nAx1_[i] = v;
            else if (code == NodeField.AXES2()) nAx2_[i] = v;
            else if (code == NodeField.AXES3()) nAx3_[i] = v;
            else if (code == NodeField.AXES_N()) nAxN_[i] = v;
            else if (code == NodeField.CIP()) nCip_[i] = v;
            else if (code == NodeField.PADMODE()) nPadMode_[i] = v;
            else if (code == NodeField.OPH()) nOutPadH_[i] = v;
            else if (code == NodeField.OPW()) nOutPadW_[i] = v;
            else if (code == NodeField.SPLIT0()) nSp0_[i] = v;
            else if (code == NodeField.SPLIT1()) nSp1_[i] = v;
            else if (code == NodeField.SPLIT2()) nSp2_[i] = v;
            else if (code == NodeField.SPLIT3()) nSp3_[i] = v;
            else if (code == NodeField.SPLIT_N()) nSplitN_[i] = v;
            else if (code == NodeField.SD3()) nSD3_[i] = v;   // 3D
            else if (code == NodeField.DD3()) nDD3_[i] = v;   // 3D
            else if (code == NodeField.KD3()) nKD3_[i] = v;   // 3D
            else if (code == NodeField.PDT()) nPDT_[i] = v;   // 3D
            else if (code == NodeField.PDB()) nPDB_[i] = v;   // 3D
            else if (code == NodeField.ST0()) nSt3_[i * 3 + 0] = v;
            else if (code == NodeField.ST1()) nSt3_[i * 3 + 1] = v;
            else if (code == NodeField.ST2()) nSt3_[i * 3 + 2] = v;
            else if (code == NodeField.PD0()) nPd3_[i * 6 + 0] = v;
            else if (code == NodeField.PD1()) nPd3_[i * 6 + 1] = v;
            else if (code == NodeField.PD2()) nPd3_[i * 6 + 2] = v;
            else if (code == NodeField.PD3()) nPd3_[i * 6 + 3] = v;
            else if (code == NodeField.PD4()) nPd3_[i * 6 + 4] = v;
            else if (code == NodeField.PD5()) nPd3_[i * 6 + 5] = v;
            else if (code == NodeField.DL0()) nDl3_[i * 3 + 0] = v;
            else if (code == NodeField.DL1()) nDl3_[i * 3 + 1] = v;
            else if (code == NodeField.DL2()) nDl3_[i * 3 + 2] = v;
            else if (code == NodeField.KK0()) nKk3_[i * 3 + 0] = v;
            else if (code == NodeField.KK1()) nKk3_[i * 3 + 1] = v;
            else if (code == NodeField.KK2()) nKk3_[i * 3 + 2] = v;
            else if (code == NodeField.CAST_TO()) nCastTo_[i] = v;   // P3
        }
        void addWeight(string nm, int rows, int cols, int dt, int kind, int off, int len) {
            wName_[wCount_] = nm; wRows_[wCount_] = rows; wCols_[wCount_] = cols;
            wType_[wCount_] = dt; wKind_[wCount_] = kind; wOff_[wCount_] = off; wLen_[wCount_] = len;
            wTrans_[wCount_] = 0; wBias_[wCount_] = 0; wRole_[wCount_] = 0;
            wNHWC_[wCount_] = 0; wBN_[wCount_] = 0; wBNOnly_[wCount_] = 0;
            wCount_ = wCount_ + 1;
        }
        void addGraphOutput(string nm) { if (goCount_ < 64) { goName_[goCount_] = nm; goCount_ = goCount_ + 1; } }
        void addGraphInput(string nm) { if (giCount_ < 64) { giName_[giCount_] = nm; giCount_ = giCount_ + 1; } }
        int graphInputCount() { return giCount_; }
        string graphInputName(int i) { if (i < 0 || i >= giCount_) return ""; return giName_[i]; }
        int graphOutputCount() { return goCount_; }
        string graphOutputName(int i) { if (i < 0 || i >= goCount_) return ""; return goName_[i]; }
        // 名称是否为初始器权重（ONNX graph input 同时含真实输入与 initializer，须排除后者）
        int isWeightName(string nm) {
            int i = 0;
            while (i < wCount_) { if (wName_[i] == nm) return 1; i = i + 1; }
            return 0;
        }
        // 登记形状（解析器调用）；addShapeD4 为内部实现
        void addShapeD(string name, int[] dims, int dimCount) {
            int d0 = 1; int d1 = 1; int d2 = 1; int d3 = 1; int d4 = 1;
            if (dimCount >= 1) d0 = dims[0];
            if (dimCount >= 2) d1 = dims[1];
            if (dimCount >= 3) d2 = dims[2];
            if (dimCount >= 4) d3 = dims[3];
            if (dimCount >= 5) d4 = dims[4];
            if (dimCount >= 5) addShapeD5(name, d0, d1, d2, d3, d4);
            else addShapeD4(name, d0, d1, d2, d3);
        }
        void addShapeD4(string name, int d0, int d1, int d2, int d3) {
            int ex = shapeIdx(name);
            if (ex >= 0) {
                // 已存在但含动态维（0）→ 覆盖（图输出等）
                if (shD0_[ex] == 0 || shD1_[ex] == 0 || shD2_[ex] == 0 || shD3_[ex] == 0) {
                    shD0_[ex] = d0; shD1_[ex] = d1; shD2_[ex] = d2; shD3_[ex] = d3; shR5_[ex] = 0;
                }
                return;
            }
            shName_[sCount_] = name;
            shD0_[sCount_] = d0;
            shD1_[sCount_] = d1;
            shD2_[sCount_] = d2;
            shD3_[sCount_] = d3;
            shKind_[sCount_] = Kind.FC_ACT();
            shDead_[sCount_] = 0;
            shNHWC_[sCount_] = 0;
            shR5_[sCount_] = 0;
            sCount_ = sCount_ + 1;
        }
        // 3D：5D 张量（N,C,D,H,W）
        void addShapeD5(string name, int d0, int d1, int d2, int d3, int d4) {
            int ex = shapeIdx(name);
            if (ex >= 0) {
                if (shD0_[ex] == 0 || shD1_[ex] == 0 || shD2_[ex] == 0 || shD3_[ex] == 0 || shD4_[ex] == 0) {
                    shD0_[ex] = d0; shD1_[ex] = d1; shD2_[ex] = d2; shD3_[ex] = d3; shD4_[ex] = d4; shR5_[ex] = 1;
                }
                return;
            }
            shName_[sCount_] = name;
            shD0_[sCount_] = d0;
            shD1_[sCount_] = d1;
            shD2_[sCount_] = d2;
            shD3_[sCount_] = d3;
            shD4_[sCount_] = d4;
            shKind_[sCount_] = Kind.FC_ACT();
            shDead_[sCount_] = 0;
            shNHWC_[sCount_] = 0;
            shR5_[sCount_] = 1;
            sCount_ = sCount_ + 1;
        }
        // 3D：按源张量秩复制输出形状（5D → addShapeD5，否则 addShapeD4）
        void copyShape(string name, int src) {
            if (shR5_[src] == 1) addShapeD5(name, shD0_[src], shD1_[src], shD2_[src], shD3_[src], shD4_[src]);
            else addShapeD4(name, shD0_[src], shD1_[src], shD2_[src], shD3_[src]);
        }
        void resetCounts() { wCount_=0; nCount_=0; sCount_=0; tCount_=0; goCount_=0; giCount_=0; fuseCount_=0; gapCount_=0; dceCount_=0; foldCount_=0; bnCount_=0; noReuse_=0; doNHWC_=0; analysisValid_=0; analysisGeneration_=0; duValid_=0; planOrderCount_=0; topoGeneration_=-1; livenessGeneration_=-1; lastPassOk_=1; lastPassChanged_=0; lastPassPreserved_=IRAnalysis.ALL(); }
        // P3：覆盖张量形状（输入形状注入：动态维度模型）
        void setShape(string name, int d0, int d1, int d2, int d3, int d4, int is5) {
            int s = shapeIdx(name);
            if (s < 0) { addShapeD5(name, d0, d1, d2, d3, d4); return; }
            shD0_[s] = d0; shD1_[s] = d1; shD2_[s] = d2; shD3_[s] = d3; shD4_[s] = d4; shR5_[s] = is5;
        }

        // 调试：load 后 dump 各 Resize 折叠 sizes
        void dumpResizeSizes() {
            int fd = __myp_io_fopen("/tmp/resize_dbg.txt", "wb");
            if (fd < 0) return;
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] == "Resize") {
                    __myp_io_write("Resize out=" + nOut0_[i]);
                    __myp_io_write(" rsz=" + Fmt.i(nRszD_[i]) + "," + Fmt.i(nRszH_[i]) + "," + Fmt.i(nRszW_[i]));
                    __myp_io_write(" in=" + nIn0_[i] + "\n");
                }
                i = i + 1;
            }
            __myp_io_fclose();
        }
        // IR-P1b：结构/shape/liveness 的稳定指纹。仅覆盖三种 analysis 的依赖；算子数值属性
        // （例如 alpha/epsilon）不影响 DefUse/Topo/Liveness，故不应无谓地失效缓存。
        long hashIRText(long hash, string text) {
            int i = 0;
            int n = Str.len(text);
            while (i < n) { hash = (hash * 131L + long(__myp_charcode(text, i))) % 2147483647L; i = i + 1; }
            return (hash * 131L + long(n)) % 2147483647L;
        }
        long analysisFingerprint() {
            long hash = 17L;
            int node = 0;
            while (node < nCount_) {
                hash = hashIRText(hash, nType_[node]);
                hash = hashIRText(hash, nIn0_[node]); hash = hashIRText(hash, nIn1_[node]);
                hash = hashIRText(hash, nIn2_[node]); hash = hashIRText(hash, nIn3_[node]); hash = hashIRText(hash, nIn4_[node]);
                hash = hashIRText(hash, nOut0_[node]); hash = hashIRText(hash, nOut1_[node]);
                hash = hashIRText(hash, nOut2_[node]); hash = hashIRText(hash, nOut3_[node]);
                hash = (hash * 131L + long(nFused_[node] + nNHWC_[node])) % 2147483647L;
                node = node + 1;
            }
            int value = 0;
            while (value < sCount_) {
                hash = hashIRText(hash, shName_[value]);
                hash = (hash * 131L + long(shD0_[value])) % 2147483647L;
                hash = (hash * 131L + long(shD1_[value])) % 2147483647L;
                hash = (hash * 131L + long(shD2_[value])) % 2147483647L;
                hash = (hash * 131L + long(shD3_[value])) % 2147483647L;
                hash = (hash * 131L + long(shD4_[value])) % 2147483647L;
                hash = (hash * 131L + long(shR5_[value] + shDead_[value] + shNHWC_[value])) % 2147483647L;
                value = value + 1;
            }
            return hash;
        }
        // P2：只处理严格标量初始化器的 Add(x,0) / Mul(x,1)。不折叠图输出，避免在 P2
        // 引入 graph-output rewrite；不处理近似值、动态标量或 broadcast，保持数值语义严格。
        int isScalarInitValue(string name, double expect) {
            int wi = initIdx(name);
            if (wi < 0 || wLen_[wi] != 4) return 0;
            int s = shapeIdx(name);
            if (s < 0 || shapeElementCount(name) != 1) return 0;
            if (readF32Init(name, 1) != 1) return 0;
            double delta = f32Tmp_[0] - expect;
            if (delta < 0.0) delta = 0.0 - delta;
            if (delta > 1.0e-12) return 0;
            return 1;
        }
        int foldIdentityOps() {
            int changed = 0;
            int node = 0;
            while (node < nCount_) {
                string op = nType_[node];
                if (op != "Add" && op != "Mul") { node = node + 1; continue; }
                string output = effectiveOut(node);
                if (output == "" || isGraphOutput(output) == 1) { node = node + 1; continue; }
                double identity = (op == "Add") ? 0.0 : 1.0;
                int in0 = nodeInputValue(node, 0);
                int in1 = nodeInputValue(node, 1);
                int keep = -1;
                if (isScalarInitValue(nIn0_[node], identity) == 1) keep = in1;
                else if (isScalarInitValue(nIn1_[node], identity) == 1) keep = in0;
                int out = nodeOutputValue(node, 0);
                if (keep >= 0 && out >= 0) {
                    replaceAllUses(out, keep);
                    nType_[node] = "";
                    markDeadTensor(output);
                    changed = 1;
                }
                node = node + 1;
            }
            return changed;
        }
        // P2b pattern primitive：value 必须恰有一个 use，且用户 op 与 operand slot 精确匹配。
        // Use edge 是 (user,slot)，因此 Mul(x,x) 等重复 use 不会被误判成单消费者。
        int matchSingleUseOp(int value, string op, int slot) {
            if (value < 0 || valueUseCount(value) != 1) return -1;
            int user = valueUseNode(value, 0);
            if (user < 0 || nType_[user] != op || valueUseSlot(value, 0) != slot) return -1;
            return user;
        }
        // P2b rewrite primitive：producer 的有效输出直接改为 Relu 输出，并 tombstone Relu。
        // 保留既有 nFused/nRelu lowering 协议，故后端仍选择 ConvRelu/Conv3d doRelu 内核。
        void fuseSingleUseOutput(int producer, int consumer, int withRelu) {
            string oldOut = effectiveOut(producer);
            nFused_[producer] = 1;
            nFusedOut_[producer] = nOut0_[consumer];
            nFusedBy_[consumer] = producer;
            if (withRelu == 1) nRelu_[producer] = 1;
            nType_[consumer] = "";
            markDeadTensor(nOut0_[producer]);
            if (oldOut != nOut0_[producer]) markDeadTensor(oldOut);
        }
        void fuseReluIntoProducer(int producer, int relu) {
            fuseSingleUseOutput(producer, relu, 1);
            fuseCount_ = fuseCount_ + 1;
        }
        // IR-P1b pass dispatcher：PassResult 写入 lastPass*；仅 changed 时失效相关分析。
        int runIRPass(int pass) {
            if (ensurePassAnalyses(pass) == 0) { lastPassOk_ = 0; lastPassChanged_ = 0; lastPassPreserved_ = 0; return 0; }
            long before = analysisFingerprint();
            int ok = 1;
            if (pass == IRPassKind.FOLD_SHAPES()) ok = foldShapeChains();
            else if (pass == IRPassKind.FOLD_CONSTS()) ok = foldConstants();
            else if (pass == IRPassKind.INFER_SHAPES()) ok = inferShapes();
            else if (pass == IRPassKind.CLASSIFY()) { classifyShapes(); ok = 1; }
            else if (pass == IRPassKind.FUSE_BN()) ok = fuseConvBN();
            else if (pass == IRPassKind.FUSE_CONV_RELU()) ok = fuseConvRelu();
            else if (pass == IRPassKind.FUSE_RELU()) ok = fuseReluOp();
            else if (pass == IRPassKind.FUSE_GAP_FLATTEN()) ok = fuseGapFlatten();
            else if (pass == IRPassKind.DCE()) ok = eliminateDeadNodes();
            else if (pass == IRPassKind.LAYOUT_NHWC()) ok = layoutNHWC();
            else if (pass == IRPassKind.IDENTITY_FOLD()) { foldIdentityOps(); ok = 1; }
            lastPassOk_ = ok;
            lastPassChanged_ = 0;
            lastPassPreserved_ = 0;
            if (ok == 1) {
                long after = analysisFingerprint();
                if (before != after) {
                    lastPassChanged_ = 1;
                    markIRMutation();
                } else {
                    lastPassPreserved_ = IRAnalysis.ALL();
                }
            }
            return ok;
        }
        // P1c：最多 maxIter 轮，直到 pass 报告 changed=0。达到上限仍变化即失败；P2 的
        // 恒等 rewrite 使用此入口，防止错误 rewrite 在图上无限震荡。
        int runIRPassToFixpoint(int pass, int maxIter) {
            int iter = 0;
            while (iter < maxIter) {
                if (runIRPass(pass) == 0) return 0;
                if (lastPassChanged_ == 0) return 1;
                iter = iter + 1;
            }
            Console.writeLine("DBG pass fixpoint limit=" + Fmt.i(pass));
            return 0;
        }
        // 公共 pass 管线（fold→inferShapes→classify→fusion→DCE→layout→topoSort）。
        // optimize（推理）与 optimizeTrain（训练）共用；返回 1=成功。
        int runPassPipeline() {
            if (Console.getEnv("MYP_NO_REUSE") == "1") noReuse_ = 1;
            runIRPass(IRPassKind.FOLD_SHAPES());  // P3：先折叠输入形状已知的 Resize sizes 链
            runIRPass(IRPassKind.FOLD_CONSTS());
            if (runIRPass(IRPassKind.INFER_SHAPES()) == 0) { Console.writeLine("DBG fail inferShapes"); return 0; }
            runIRPass(IRPassKind.FOLD_SHAPES());  // P3：inferShapes 后折叠剩余链（Shape(中间)→…→Cast）
            runIRPass(IRPassKind.CLASSIFY());
            runIRPass(IRPassKind.FUSE_BN());
            runIRPass(IRPassKind.FUSE_CONV_RELU());
            runIRPass(IRPassKind.FUSE_RELU());
            runIRPass(IRPassKind.FUSE_GAP_FLATTEN());
            if (runIRPassToFixpoint(IRPassKind.IDENTITY_FOLD(), 4) == 0) { Console.writeLine("DBG fail identityFold"); return 0; }
            runIRPass(IRPassKind.DCE());
            if (doNHWC_ == 1) { if (runIRPass(IRPassKind.LAYOUT_NHWC()) == 0) { Console.writeLine("DBG fail layoutNHWC"); return 0; } }
            if (topoSort() == 0) { Console.writeLine("DBG fail topoSort"); return 0; }
            return 1;
        }

        int optimize(InferenceRuntime rt) {
            if (runPassPipeline() == 0) return 0;
            int peak = planMemory();
            if (peak <= 0) { Console.writeLine("DBG fail planMemory"); return 0; }
            rt.resizeArena(peak);
            if (buildRuntime(rt) == 0) { Console.writeLine("DBG fail buildRuntime"); return 0; }
            if (Console.getEnv("MYP_RSZ_DBG") == "1") dumpResizeSizes();
            return 1;
        }

        // 训练版管线：公共 pass → buildReverseGraph（追加反向/更新节点）→ 重排/重规划 → 构建。
        int optimizeTrain(InferenceRuntime rt) {
            if (runPassPipeline() == 0) return 0;
            if (buildReverseGraph() == 0) { Console.writeLine("DBG fail buildReverseGraph"); return 0; }
            markIRMutation();             // buildReverseGraph 直接追加 Bwd*/Update 节点
            if (topoSort() == 0) { Console.writeLine("DBG fail topoSort(reverse)"); return 0; }
            int peak = planMemory();
            if (peak <= 0) { Console.writeLine("DBG fail planMemory"); return 0; }
            rt.resizeArena(peak);
            if (buildRuntime(rt) == 0) { Console.writeLine("DBG fail buildRuntime"); return 0; }
            return 1;
        }

        // ---- 阶段2：图级反向 pass（reverse-mode AD）----
        // 前向图已跑完 pass + topoSort；本方法反向拓扑遍历，为每个可训算子追加
        // backward 节点 + 梯度张量，末尾为权重追加 Update 节点，最后 Softmax 输出
        // 处接 SoftmaxCE(logits, label) → (dlogits, loss)。
        // 梯度张量命名：X#g（形状 = X）。反向节点消费前向激活 → planMemory 的
        // lastUse 自动延长这些激活的存活（不覆盖），无需显式 persist。
        int buildReverseGraph() {
            // 1) 定位「输出是图输出的 Softmax」节点 → logits = 其输入
            int smNode = -1;
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] == "Softmax" && isGraphOutput(nOut0_[i]) == 1) { smNode = i; i = nCount_; }
                i = i + 1;
            }
            if (smNode < 0) {
                Console.writeLine("buildReverseGraph: no Softmax graph output");
                return 0;
            }
            string logits = nIn0_[smNode];
            int ls = shapeIdx(logits);
            if (ls < 0) return 0;

            // 2) label / loss / dlogits 张量（label 由训练循环灌 one-hot）
            // 注意：label 必须与 logits 同秩且同 shape kind——5D 分割 logits
            // [N,C,D,H,W] 走 addShapeD5，否则漏深度维（同 Flatten 5D BUG：4D
            // 注册丢 shD4 → label 越界/覆盖）；shape kind 直接镜像 logits（否则
            // FC_ACT 分支在 buildRuntime 里优先于 5D 分支 → label 被注册成 [C,1]）。
            if (shR5_[ls] == 1)
                addShapeD5("label", shD0_[ls], shD1_[ls], shD2_[ls], shD3_[ls], shD4_[ls]);
            else
                addShapeD4("label", shD0_[ls], shD1_[ls], shD2_[ls], shD3_[ls]);
            setShapeKind("label", shKind_[ls]);
            addShapeD4("loss", 1, 1, 1, 1);
            setShapeKind("loss", Kind.FC_ACT());
            ensureGrad(logits);

            // 3) loss 节点：CE（SoftmaxCE(logits,label)→(dlogits,loss)）或
            //    Dice（DiceLoss(prob,label)→(dprob,loss) + BwdSoftmax(dprob,prob)→dlogits）
            if (lossMode_ == 1) {
                // prob = Softmax 输出（图输出）；其梯度 dprob 由 DiceLoss 产出，
                // 经 BwdSoftmax 链式回传到 logits 梯度 dlogits。
                string prob = nOut0_[smNode];
                ensureGrad(prob);
                int nid = nCount_;
                beginNode();
                nodeType(nid, "DiceLoss");
                nodeIn(nid, 0, prob);
                nodeIn(nid, 1, "label");
                nodeOut(nid, gradName(prob));
                nodeOut(nid, "loss");
                endNode();
                int nid2 = nCount_;
                beginNode();
                nodeType(nid2, "BwdSoftmax");
                nodeIn(nid2, 0, gradName(prob));
                nodeIn(nid2, 1, prob);
                nodeOut(nid2, gradName(logits));
                endNode();
            } else {
                int nid = nCount_;
                beginNode();
                nodeType(nid, "SoftmaxCE");
                nodeIn(nid, 0, logits);
                nodeIn(nid, 1, "label");
                nodeOut(nid, gradName(logits));
                nodeOut(nid, "loss");
                endNode();
            }

            // 4) 反向拓扑遍历（planOrder_ 逆序）：输出梯度已知 → 按算子类型追加 backward
            int oi = planOrderCount_ - 1;
            while (oi >= 0) {
                int ni = planOrder_[oi];
                string t = nType_[ni];
                if (t != "") {
                    string y = nOut0_[ni];
                    if (shapeIdx(gradName(y)) >= 0) {
                        // 确保该节点各输入/输出的梯度张量形状都登记（否则 buildRuntime 注册不到）
                        ensureGrad(nIn0_[ni]);
                        ensureGrad(nIn1_[ni]);
                        ensureGrad(nIn2_[ni]);
                        ensureGrad(nIn3_[ni]);
                        if (t == "Gemm") {
                            // BwdDense(dy, x, w) → (dx, dw, db)
                            int bd = nCount_;
                            beginNode();
                            nodeType(bd, "BwdDense");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nIn0_[ni]);
                            nodeIn(bd, 2, nIn1_[ni]);
                            nodeOut(bd, gradName(nIn0_[ni]));
                            nodeOut(bd, gradName(nIn1_[ni]));
                            nodeOut(bd, gradName(nIn2_[ni]));
                            endNode();
                        } else if (t == "MatMul") {
                            // 无偏置：db 输出用 0 占位（runtime 忽略）
                            int bd = nCount_;
                            beginNode();
                            nodeType(bd, "BwdDense");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nIn0_[ni]);
                            nodeIn(bd, 2, nIn1_[ni]);
                            nodeOut(bd, gradName(nIn0_[ni]));
                            nodeOut(bd, gradName(nIn1_[ni]));
                            nodeOut(bd, "");
                            endNode();
                        } else if (t == "Relu") {
                            int bd = nCount_;
                            beginNode();
                            nodeType(bd, "BwdRelu");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nIn0_[ni]);
                            nodeOut(bd, gradName(nIn0_[ni]));
                            endNode();
                        } else if (t == "Sigmoid") {
                            int bd = nCount_;
                            beginNode();
                            nodeType(bd, "BwdSigmoid");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, y);              // 用前向输出 y
                            nodeOut(bd, gradName(nIn0_[ni]));
                            endNode();
                        } else if (t == "Add") {
                            int bd = nCount_;
                            beginNode();
                            nodeType(bd, "BwdAdd");
                            nodeIn(bd, 0, gradName(y));
                            nodeOut(bd, gradName(nIn0_[ni]));
                            nodeOut(bd, gradName(nIn1_[ni]));
                            endNode();
                        } else if (t == "Conv") {
                            // BwdConv(dy, x, w) → (dx, dw, db)；复制卷积参数
                            int bd = nCount_;
                            beginNode();
                            nodeType(bd, "BwdConv");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nIn0_[ni]);
                            nodeIn(bd, 2, nIn1_[ni]);
                            nodeOut(bd, gradName(nIn0_[ni]));
                            nodeOut(bd, gradName(nIn1_[ni]));
                            nodeOut(bd, gradName(nIn2_[ni]));   // 无偏置 → "" → runtime db=-1
                            endNode();
                            nSH_[bd] = nSH_[ni]; nSW_[bd] = nSW_[ni];
                            nPT_[bd] = nPT_[ni]; nPL_[bd] = nPL_[ni];
                            nDH_[bd] = nDH_[ni]; nDW_[bd] = nDW_[ni]; nGroup_[bd] = nGroup_[ni];
                        } else if (t == "MaxPool") {
                            // BwdMaxPool(dy, x) → (dx)；复制池化参数
                            int bd = nCount_;
                            beginNode();
                            nodeType(bd, "BwdMaxPool");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nIn0_[ni]);
                            nodeOut(bd, gradName(nIn0_[ni]));
                            endNode();
                            nKH_[bd] = nKH_[ni]; nKW_[bd] = nKW_[ni];
                            nSH_[bd] = nSH_[ni]; nSW_[bd] = nSW_[ni];
                            nPT_[bd] = nPT_[ni]; nPL_[bd] = nPL_[ni];
                        } else if (t == "ConvTranspose") {
                            // 阶段4d：BwdConvTranspose(dy, x, w) → (dx, dw, db)；复制转置卷积参数
                            int bd = nCount_;
                            beginNode();
                            nodeType(bd, "BwdConvTranspose");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nIn0_[ni]);
                            nodeIn(bd, 2, nIn1_[ni]);
                            nodeOut(bd, gradName(nIn0_[ni]));
                            nodeOut(bd, gradName(nIn1_[ni]));
                            nodeOut(bd, gradName(nIn2_[ni]));   // 无偏置 → "" → runtime db=-1
                            endNode();
                            nSH_[bd] = nSH_[ni]; nSW_[bd] = nSW_[ni];
                            nPT_[bd] = nPT_[ni]; nPB_[bd] = nPB_[ni];
                            nPL_[bd] = nPL_[ni]; nPR_[bd] = nPR_[ni];
                        } else if (t == "Conv3D") {
                            // 阶段4：BwdConv3D(dy, x, w) → (dx, dw, db)；复制 3D 卷积参数
                            // （kd/kh/kw 与 group 由 w 张量形状给出；dd/dh/dw 假定 1）
                            int bd = nCount_;
                            beginNode();
                            nodeType(bd, "BwdConv3D");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nIn0_[ni]);
                            nodeIn(bd, 2, nIn1_[ni]);
                            nodeOut(bd, gradName(nIn0_[ni]));
                            nodeOut(bd, gradName(nIn1_[ni]));
                            nodeOut(bd, gradName(nIn2_[ni]));   // 无偏置 → "" → runtime db=-1
                            endNode();
                            nSD3_[bd] = nSD3_[ni]; nSH_[bd] = nSH_[ni]; nSW_[bd] = nSW_[ni];
                            nPDT_[bd] = nPDT_[ni]; nPDB_[bd] = nPDB_[ni];
                            nPT_[bd] = nPT_[ni]; nPB_[bd] = nPB_[ni];
                            nPL_[bd] = nPL_[ni]; nPR_[bd] = nPR_[ni];
                        } else if (t == "MaxPool3D") {
                            // 阶段4：BwdMaxPool3D(dy, x) → (dx)；复制 3D 池化参数
                            int bd = nCount_;
                            beginNode();
                            nodeType(bd, "BwdMaxPool3D");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nIn0_[ni]);
                            nodeOut(bd, gradName(nIn0_[ni]));
                            endNode();
                            nKD3_[bd] = nKD3_[ni]; nKH_[bd] = nKH_[ni]; nKW_[bd] = nKW_[ni];
                            nSD3_[bd] = nSD3_[ni]; nSH_[bd] = nSH_[ni]; nSW_[bd] = nSW_[ni];
                            nPDT_[bd] = nPDT_[ni]; nPDB_[bd] = nPDB_[ni];
                            nPT_[bd] = nPT_[ni]; nPB_[bd] = nPB_[ni];
                            nPL_[bd] = nPL_[ni]; nPR_[bd] = nPR_[ni];
                        } else if (t == "AveragePool3D") {
                            // 阶段4：BwdAvgPool3D(dy, x) → (dx)；复制 3D 池化参数 + cip
                            int bd = nCount_;
                            beginNode();
                            nodeType(bd, "BwdAvgPool3D");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nIn0_[ni]);
                            nodeOut(bd, gradName(nIn0_[ni]));
                            endNode();
                            nKD3_[bd] = nKD3_[ni]; nKH_[bd] = nKH_[ni]; nKW_[bd] = nKW_[ni];
                            nSD3_[bd] = nSD3_[ni]; nSH_[bd] = nSH_[ni]; nSW_[bd] = nSW_[ni];
                            nPDT_[bd] = nPDT_[ni]; nPDB_[bd] = nPDB_[ni];
                            nPT_[bd] = nPT_[ni]; nPB_[bd] = nPB_[ni];
                            nPL_[bd] = nPL_[ni]; nPR_[bd] = nPR_[ni];
                            nCip_[bd] = nCip_[ni];
                        } else if (t == "Resize" || t == "Upsample") {
                            // 阶段4d：Resize3D 反向 → BwdResize(dy, x) → dx；复制 mode/transform。
                            // 仅 3D（U-Net 上采样）；2D 反向未实现 → 跳过（梯度 0）。
                            int osr = shapeIdx(y);
                            if (osr >= 0 && shR5_[osr] == 1) {
                                int bd = nCount_;
                                beginNode();
                                nodeType(bd, "BwdResize");
                                nodeIn(bd, 0, gradName(y));
                                nodeIn(bd, 1, nIn0_[ni]);
                                nodeOut(bd, gradName(nIn0_[ni]));
                                endNode();
                                nMode_[bd] = nMode_[ni];
                                nTransform_[bd] = nTransform_[ni];
                            }
                        } else if (t == "Concat") {
                            // U-Net 跳跃连接反向：BwdConcat(dy, x0, x1, x2) → (dx0, dx1, dx2)。
                            // nIn1_/nIn2_/nIn3_ = 原输入（buildRuntime 查轴长）；nOut0-2 = 各输入梯度。
                            int bd = nCount_;
                            beginNode();
                            nodeType(bd, "BwdConcat");
                            nodeIn(bd, 0, gradName(y));
                            nodeIn(bd, 1, nIn0_[ni]);
                            nodeIn(bd, 2, nIn1_[ni]);
                            nodeIn(bd, 3, nIn2_[ni]);
                            nodeOut(bd, gradName(nIn0_[ni]));
                            nodeOut(bd, gradName(nIn1_[ni]));
                            nodeOut(bd, gradName(nIn2_[ni]));
                            endNode();
                            nAxis_[bd] = nAxis_[ni];
                        }
                        // Softmax 由 CE 处理；Conv3D/池化等暂不支持（梯度 0，跳过）
                    }
                }
                oi = oi - 1;
            }

            // 5) 权重/偏置追加 Update(W, W#g)（可训参数：FC_W/FC_B/CNN_W/CNN_B）
            // 仅当梯度确实由某个反向算子产出（isNodeOutput）——Resize sizes/scales
            // 等参数初始器虽被 ensureGrad 登记了形状，但没有反向节点产出其梯度，
            // 不应生成 Update（否则 buildRuntime 因该常量非运行时张量而失败）。
            int wi = 0;
            while (wi < wCount_) {
                string nm = wName_[wi];
                int role = wRole_[wi];
                if ((role == 0 || role == 1 || role == 2 || role == 3) && isNodeOutput(gradName(nm)) == 1) {
                    int uid = nCount_;
                    // 输出用独立 dummy 标量（不能复用权重名——那会让 producerIdx(权重)=Update，
                    // 权重"被产出"→ 前向消费权重 + Update 依赖梯度 → 环）
                    string dummy = "upd" + Fmt.i(uid);
                    addShapeD4(dummy, 1, 1, 1, 1);
                    setShapeKind(dummy, Kind.FC_ACT());
                    beginNode();
                    nodeType(uid, "Update");
                    nodeIn(uid, 0, nm);
                    nodeIn(uid, 1, gradName(nm));
                    nodeOut(uid, dummy);
                    endNode();
                }
                wi = wi + 1;
            }
            // 5c) 多消费者梯度（U-Net 跳跃连接）：skip 张量（如 r1/r3）同时被编码器
            //     算子与 Concat 消费 → 梯度名被多反向节点产出。BwdConcat 与主 producer
            //     存在依赖环（编码器反向依赖 concat 上游输出 u#g），不能靠执行顺序累加。
            //     改用显式累加：主 producer 输出改 g_a、BwdConcat 输出改 g_b、加
            //     GradAcc(g_a, g_b) → g（纯前向 Add，消费者读 g）。
            int cc = 0;
            while (cc < nCount_) {
                if (nType_[cc] == "BwdConcat") {
                    int slot = 0;
                    while (slot < 3) {
                        string g;
                        if (slot == 0) g = nOut0_[cc];
                        else if (slot == 1) g = nOut1_[cc];
                        else g = nOut2_[cc];
                        if (g != "" && Str.len(g) >= 2 && Str.substring(g, Str.len(g) - 2, Str.len(g)) == "#g") {
                            int other = -1;
                            int jj = 0;
                            while (jj < nCount_) {
                                if (jj != cc && nType_[jj] != "" && nType_[jj] != "BwdConcat") {
                                    if (nOut0_[jj] == g || nOut1_[jj] == g || nOut2_[jj] == g || nOut3_[jj] == g) { other = jj; jj = nCount_; }
                                }
                                jj = jj + 1;
                            }
                            if (other >= 0) {
                                string ga = g + "_a";
                                string gb = g + "_b";
                                if (slot == 0) nOut0_[cc] = gb;
                                else if (slot == 1) nOut1_[cc] = gb;
                                else nOut2_[cc] = gb;
                                if (nOut0_[other] == g) nOut0_[other] = ga;
                                else if (nOut1_[other] == g) nOut1_[other] = ga;
                                else if (nOut2_[other] == g) nOut2_[other] = ga;
                                else if (nOut3_[other] == g) nOut3_[other] = ga;
                                // 登记 g_a/g_b 形状（同 g）
                                int gs = shapeIdx(g);
                                if (gs >= 0) {
                                    if (shR5_[gs] == 1) {
                                        addShapeD5(ga, shD0_[gs], shD1_[gs], shD2_[gs], shD3_[gs], shD4_[gs]);
                                        addShapeD5(gb, shD0_[gs], shD1_[gs], shD2_[gs], shD3_[gs], shD4_[gs]);
                                    } else {
                                        addShapeD4(ga, shD0_[gs], shD1_[gs], shD2_[gs], shD3_[gs]);
                                        addShapeD4(gb, shD0_[gs], shD1_[gs], shD2_[gs], shD3_[gs]);
                                    }
                                    setShapeKind(ga, shKind_[gs]);
                                    setShapeKind(gb, shKind_[gs]);
                                }
                                // GradAcc 纯前向累加节点
                                int an = nCount_;
                                beginNode();
                                nodeType(an, "GradAcc");
                                nodeIn(an, 0, ga);
                                nodeIn(an, 1, gb);
                                nodeOut(an, g);
                                endNode();
                            }
                        }
                        slot = slot + 1;
                    }
                }
                cc = cc + 1;
            }
            return 1;
        }
        // 梯度张量名（同形状）
        string gradName(string nm) { return nm + "#g"; }
        // 梯度张量去 #g 后缀还原基底名
        string stripGrad(string nm) {
            int L = Str.len(nm);
            if (L >= 2) return Str.substring(nm, 0, L - 2);
            return nm;
        }
        // 确保前向张量 nm 的梯度张量形状已登记（同形状；权重梯度用 FC_G 镜像基底布局）
        void ensureGrad(string nm) {
            if (nm == "") return;
            string gn = gradName(nm);
            if (shapeIdx(gn) >= 0) return;
            int s = shapeIdx(nm);
            if (s < 0) return;
            if (shR5_[s] == 1) addShapeD5(gn, shD0_[s], shD1_[s], shD2_[s], shD3_[s], shD4_[s]);
            else addShapeD4(gn, shD0_[s], shD1_[s], shD2_[s], shD3_[s]);
            if (initIdx(nm) >= 0) setShapeKind(gn, Kind.FC_G());   // 权重：镜像基底（含 transB）
            else setShapeKind(gn, shKind_[s]);                     // 激活：同基底
        }

    function:
        int shapeIdx(string name) {
            int i = 0;
            while (i < sCount_) {
                if (shName_[i] == name) return i;
                i = i + 1;
            }
            return -1;
        }
        int shapeKind(string name) {
            int i = shapeIdx(name);
            if (i < 0) return Kind.FC_ACT();
            return shKind_[i];
        }
        void setShapeKind(string name, int k) {
            int i = shapeIdx(name);
            if (i >= 0) shKind_[i] = k;
        }
        int classifyShapes() {
            // 1) 权重/偏置：由消费节点决定（初始器）
            int i = 0;
            while (i < nCount_) {
                string t = nType_[i];
                if (t == "Gemm") {
                    markFCWeight(nIn1_[i], nTransB_[i]);   // transB=1：wire=[N,K]；transB=0：wire=[K,N]
                    markFCBias(nIn2_[i]);
                } else if (t == "MatMul") {
                    markFCWeight(nIn1_[i], 0);             // MatMul 无 transB，wire=[K,N]
                } else if (t == "Conv") {
                    markCNNWeight(nIn1_[i]);
                    markCNNBias(nIn2_[i]);
                } else if (t == "Conv3D") {
                    // 3D：权重 [Cout,Cin,kd,kh,kw] / 偏置 [Cout]
                    markCNNWeight(nIn1_[i]);
                    markCNNBias(nIn2_[i]);
                } else if (t == "ConvTranspose") {
                    // F8：权重 [Cin,Cout,kh,kw] 直接拷贝（wRole_=2 无需转置）
                    markCNNWeight(nIn1_[i]);
                    markCNNBias(nIn2_[i]);
                } else if (t == "Concat" || t == "Transpose" || t == "Reshape") {
                    // F8：4D 通用常量输入 → CNN 激活登记 + 直接拷贝（Concat 的非常量输入/常量）
                    markGeneric4DConst(nIn0_[i]);
                    if (t == "Concat") { markGeneric4DConst(nIn1_[i]); markGeneric4DConst(nIn2_[i]); }
                    if (t == "Reshape") markInt64Param(nIn1_[i]);   // shape 参数（int64）不登记为 f32 张量
                } else if (t == "Slice") {
                    // F8：starts/ends/axes/steps 参数初始器（int64）不登记为 f32 张量
                    markInt64Param(nIn1_[i]);
                    markInt64Param(nIn2_[i]);
                    markInt64Param(nIn3_[i]);
                    markInt64Param(nIn4_[i]);
                } else if (t == "InstanceNormalization") {
                    // F8：scale/bias [C] 常量 → FC_B 登记（addTensorPlanned2(d0,1)）
                    markFCBias(nIn1_[i]);
                    markFCBias(nIn2_[i]);
                } else if (t == "Pad") {
                    // F8：pads（int64）与 constant_value（f32）参数不登记为 f32 激活张量
                    markInt64Param(nIn1_[i]);
                    markParamDead(nIn2_[i]);
                } else if (t == "Split") {
                    // F8：split 尺寸输入（opset13+，int64）不登记为 f32 张量
                    markInt64Param(nIn1_[i]);
                } else if (t == "Resize" || t == "Upsample") {
                    // F8：scales/sizes 参数初始器不登记为激活（读自 file_）
                    markParamDead(nIn1_[i]);
                    markParamDead(nIn2_[i]);
                    markParamDead(nIn3_[i]);
                }
                i = i + 1;
            }
            // 2) 图输入（非初始器、非任何节点输出）：由首个消费者决定 4D/FC
            int si = 0;
            while (si < sCount_) {
                string nm = shName_[si];
                if (initIdx(nm) >= 0) { si = si + 1; continue; }
                if (isNodeOutput(nm) == 1) { si = si + 1; continue; }
                setShapeKind(nm, consumerKind(nm));
                si = si + 1;
            }
            // 3) 激活：按生产者传播（节点按拓扑序；死节点跳过）
            i = 0;
            while (i < nCount_) {
                string t = nType_[i];
                if (t == "") { i = i + 1; continue; }
                int k = Kind.FC_ACT();
                if (t == "Conv" || t == "MaxPool" || t == "AveragePool" || t == "GlobalAveragePool") k = Kind.CNN_ACT();
                else if (t == "Conv3D" || t == "MaxPool3D" || t == "AveragePool3D") k = Kind.CNN_ACT();   // 3D
                else if (t == "Gemm" || t == "MatMul" || t == "Flatten") k = Kind.FC_ACT();
                else {
                    // Relu / Sigmoid / Softmax / Add：沿用主输入 kind
                    k = shapeKind(nIn0_[i]);
                }
                setShapeKind(nOut0_[i], k);
                if (t == "Split") {   // F8：Split 所有输出沿用主输入 kind
                    setShapeKind(nOut1_[i], k);
                    setShapeKind(nOut2_[i], k);
                    setShapeKind(nOut3_[i], k);
                }
                i = i + 1;
            }
            return 1;
        }
        // F8：把 4D 通用常量（非 Conv 权重/偏置）标记为 CNN 激活（buildRuntime 4D 登记）
        // 并设 wRole_=4（写权重时直接拷贝，不做 FC 转置）
        void markGeneric4DConst(string name) {
            int wi = initIdx(name);
            if (wi < 0) return;
            if (wRole_[wi] == 2 || wRole_[wi] == 3) return;   // Conv 权重/偏置不覆盖
            int s = shapeIdx(name);
            if (s < 0) return;
            if (shD2_[s] <= 1 && shD3_[s] <= 1) return;       // 非 4D 不处理
            wRole_[wi] = 4;
            wTrans_[wi] = 0;
            setShapeKind(name, Kind.CNN_ACT());
        }
        // F8：int64 参数初始器（Reshape shape / Slice starts 等）标死——
        // 不登记为 f32 运行时张量（readI64Init 直接从 file_ 读，不依赖 runtime 张量）。
        void markInt64Param(string name) {
            int wi = initIdx(name);
            if (wi < 0) return;
            if (wType_[wi] != 7) return;   // 仅 int64 参数
            markDeadTensor(name);
        }
        // F8：任意参数初始器标死（Resize scales/sizes 等，读自 file_）
        void markParamDead(string name) {
            int wi = initIdx(name);
            if (wi < 0) return;
            markDeadTensor(name);
        }
        int isNodeOutput(string name) {
            int i = 0;
            while (i < nCount_) {
                if (nOut0_[i] == name || nOut1_[i] == name || nOut2_[i] == name || nOut3_[i] == name) return 1;
                i = i + 1;
            }
            return 0;
        }
        int consumerKind(string name) {
            int i = 0;
            while (i < nCount_) {
                if (nIn0_[i] == name || nIn1_[i] == name || nIn2_[i] == name) {
                    string t = nType_[i];
                    if (t == "Conv" || t == "MaxPool" || t == "AveragePool" || t == "GlobalAveragePool" || t == "BatchNormalization") return Kind.CNN_ACT();
                    if (t == "Conv3D" || t == "MaxPool3D" || t == "AveragePool3D") return Kind.CNN_ACT();   // 3D
                    // F8：Concat/Transpose/Reshape 等 —— 若张量本身 4D 则按 CNN 激活
                    int s = shapeIdx(name);
                    if (s >= 0 && (shD2_[s] > 1 || shD3_[s] > 1)) return Kind.CNN_ACT();
                    return Kind.FC_ACT();
                }
                i = i + 1;
            }
            return Kind.FC_ACT();
        }
        void markFCWeight(string name, int v) {
            int i = initIdx(name);
            if (i >= 0) { wTrans_[i] = v; wRole_[i] = 0; setShapeKind(name, Kind.FC_W()); }
        }
        void markFCBias(string name) {
            int i = initIdx(name);
            if (i >= 0) { wBias_[i] = 1; wRole_[i] = 1; setShapeKind(name, Kind.FC_B()); }
        }
        void markCNNWeight(string name) {
            int i = initIdx(name);
            if (i >= 0) { wRole_[i] = 2; setShapeKind(name, Kind.CNN_W()); }
        }
        void markCNNBias(string name) {
            int i = initIdx(name);
            if (i >= 0) { wRole_[i] = 3; setShapeKind(name, Kind.CNN_B()); }
        }
        // F8：读 float32 初始器值（Resize scales 等）。
        // 支持 raw_data（wKind_==1，4 字节小端）与 float_data。返回读取个数。
        int readF32Init(string name, int maxn) {
            int wi = initIdx(name);
            if (wi < 0) return 0;
            int cnt = 0;
            int j = 0;
            while (j < wLen_[wi] / 4 && cnt < maxn) {
                int b0 = file_[wOff_[wi] + j * 4];
                int b1 = file_[wOff_[wi] + j * 4 + 1];
                int b2 = file_[wOff_[wi] + j * 4 + 2];
                int b3 = file_[wOff_[wi] + j * 4 + 3];
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                f32Tmp_[cnt] = F32.toDouble(bits);
                cnt = cnt + 1;
                j = j + 1;
            }
            return cnt;
        }

        int initIdx(string name) {
            int i = 0;
            while (i < wCount_) {
                if (wName_[i] == name) return i;
                i = i + 1;
            }
            return -1;
        }
        // 3D：按输入秩识别 Conv/MaxPool/AveragePool/ConvTranspose 的 2D/3D。
        // 输入为 5D（NCDHW）→ 改名为 xxx3D 并从通用原始 attr 重映射 3D 字段。
        // 必须在 inferShapes 内（节点拓扑序）调用：此时生产者输出形状已登记，
        // 下游 3D 池化的输入秩已知。
        void normalize3DNode(int i) {
            string t = nType_[i];
            if (t != "Conv" && t != "MaxPool" && t != "AveragePool" && t != "ConvTranspose") return;
            if (shapeRank5(nIn0_[i]) != 1) return;
            nType_[i] = t + "3D";
            // strides [sd,sh,sw]
            int sd = rawSt(i, 0); if (sd == 0) sd = 1;
            int sh = rawSt(i, 1); if (sh == 0) sh = 1;
            int sw = rawSt(i, 2); if (sw == 0) sw = 1;
            nSD3_[i] = sd; nSH_[i] = sh; nSW_[i] = sw;
            // pads：ONNX 3D 格式 [d_begin, h_begin, w_begin, d_end, h_end, w_end]
            // （此前按 [pdt,pdb,pt,pb,pl,pr] 顺序读取——PyTorch 风格。对称 padding
            // 时各维 top==bottom 看不出；非对称 pads（如 [1,0,0,1,0,0]）会错位，
            // 导致 Conv/AvgPool 输出形状与切片位置错误）
            nPDT_[i] = rawPd(i, 0); nPDB_[i] = rawPd(i, 3);
            nPT_[i] = rawPd(i, 1); nPB_[i] = rawPd(i, 4);
            nPL_[i] = rawPd(i, 2); nPR_[i] = rawPd(i, 5);
            // dilations [dd,dh,dw]
            int dd = rawDl(i, 0); if (dd == 0) dd = 1;
            int dh = rawDl(i, 1); if (dh == 0) dh = 1;
            int dw = rawDl(i, 2); if (dw == 0) dw = 1;
            nDD3_[i] = dd; nDH_[i] = dh; nDW_[i] = dw;
            // kernel_shape [kd,kh,kw]
            nKD3_[i] = rawKk(i, 0); nKH_[i] = rawKk(i, 1); nKW_[i] = rawKk(i, 2);
        }
        int inferShapes() {
            int i = 0;
            while (i < nCount_) {
                string t = nType_[i];
                if (t == "") { i = i + 1; continue; }   // 死节点（折叠/融合消掉）跳过
                // P3：形状链节点（Shape/Constant/Cast/ReduceProd/Unsqueeze/Gather）由
                // foldShapeChains 折叠；仍活着则先尝试折叠（形状随 inferShapes 推进逐步已知）
                // Slice/Concat 仅当「数据输入」是 int64 形状链时才按形状链处理（float 数据
                // Slice/Concat 是运行时算子）：Slice 判 nIn0_（数据），不能看 nIn1_（starts
                // 恒为 int64 初始器，会把数据 Slice 误当形状链跳过 → 输出形状不登记 → 下游
                // Concat shapeIdx 失败 "DBG fail inferShapes"）。
                if (t == "Shape" || t == "Constant" || t == "Cast" || t == "ReduceProd" || t == "Unsqueeze" || t == "Gather" ||
                    (t == "Slice" && (i64Count(nIn0_[i]) > 0 || i64ChainAlive(nIn0_[i]) == 1)) ||
                    (t == "Concat" && (i64Count(nIn0_[i]) > 0 || i64Count(nIn1_[i]) > 0))) {
                    foldShapeChains();
                    if (nType_[i] != "") { i = i + 1; continue; }   // 仍未折叠：跳过
                    t = "";
                }
                if (t == "") { i = i + 1; continue; }
                normalize3DNode(i);
                t = nType_[i];
                if (t == "ConvTranspose") {
                    // F8：转置卷积（group=1；权重 [Cin,Cout,kh,kw]，d1=Cout，d2=kh，d3=kw）
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int w = shapeIdx(nIn1_[i]); if (w < 0) return 0;
                    int N = shD0_[a]; int Cin = shD1_[a]; int H = shD2_[a]; int W = shD3_[a];
                    int Cout = shD1_[w];
                    int kh = nKH_[i]; if (kh <= 0) kh = shD2_[w];
                    int kw = nKW_[i]; if (kw <= 0) kw = shD3_[w];
                    int sh_ = nSH_[i]; if (sh_ <= 0) sh_ = 1;
                    int sw_ = nSW_[i]; if (sw_ <= 0) sw_ = 1;
                    int yH = (H - 1) * sh_ - nPT_[i] - nPB_[i] + kh + nOutPadH_[i];
                    int yW = (W - 1) * sw_ - nPL_[i] - nPR_[i] + kw + nOutPadW_[i];
                    addShapeD4(nOut0_[i], N, Cout, yH, yW);
                } else if (t == "Conv") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int w = shapeIdx(nIn1_[i]); if (w < 0) return 0;
                    int N = shD0_[a]; int H = shD2_[a]; int W = shD3_[a];
                    int yC = shD0_[w];
                    int kh = shD2_[w]; int kw = shD3_[w];
                    if (nKH_[i] > 0) kh = nKH_[i];
                    if (nKW_[i] > 0) kw = nKW_[i];
                    int yH = (H + nPT_[i] + nPB_[i] - nDH_[i] * (kh - 1) - 1) / nSH_[i] + 1;
                    int yW = (W + nPL_[i] + nPR_[i] - nDW_[i] * (kw - 1) - 1) / nSW_[i] + 1;
                    addShapeD4(nOut0_[i], N, yC, yH, yW);
                } else if (t == "Conv3D") {
                    // 3D：权重 [Cout,Cin,kd,kh,kw]（5D）；kd/kh/kw = shD2/shD3/shD4
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int w = shapeIdx(nIn1_[i]); if (w < 0) return 0;
                    int N = shD0_[a]; int D = shD2_[a]; int H = shD3_[a]; int W = shD4_[a];
                    int yC = shD0_[w];
                    int kd = shD2_[w]; int kh = shD3_[w]; int kw = shD4_[w];
                    if (nKD3_[i] > 0) kd = nKD3_[i];
                    if (nKH_[i] > 0) kh = nKH_[i];
                    if (nKW_[i] > 0) kw = nKW_[i];
                    int sd = nSD3_[i]; if (sd <= 0) sd = 1;
                    int sh_ = nSH_[i]; if (sh_ <= 0) sh_ = 1;
                    int sw_ = nSW_[i]; if (sw_ <= 0) sw_ = 1;
                    int dd = nDD3_[i]; if (dd <= 0) dd = 1;
                    int dh = nDH_[i]; if (dh <= 0) dh = 1;
                    int dw = nDW_[i]; if (dw <= 0) dw = 1;
                    int yD = (D + nPDT_[i] + nPDB_[i] - dd * (kd - 1) - 1) / sd + 1;
                    int yH = (H + nPT_[i] + nPB_[i] - dh * (kh - 1) - 1) / sh_ + 1;
                    int yW = (W + nPL_[i] + nPR_[i] - dw * (kw - 1) - 1) / sw_ + 1;
                    addShapeD5(nOut0_[i], N, yC, yD, yH, yW);
                } else if (t == "MaxPool3D") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int N = shD0_[a]; int C = shD1_[a]; int D = shD2_[a]; int H = shD3_[a]; int W = shD4_[a];
                    int kd = nKD3_[i]; if (kd <= 0) kd = 1;
                    int kh = nKH_[i]; if (kh <= 0) kh = 1;
                    int kw = nKW_[i]; if (kw <= 0) kw = 1;
                    int sd = nSD3_[i]; if (sd <= 0) sd = 1;
                    int sh_ = nSH_[i]; if (sh_ <= 0) sh_ = 1;
                    int sw_ = nSW_[i]; if (sw_ <= 0) sw_ = 1;
                    int yD = (D + nPDT_[i] + nPDB_[i] - kd) / sd + 1;
                    int yH = (H + nPT_[i] + nPB_[i] - kh) / sh_ + 1;
                    int yW = (W + nPL_[i] + nPR_[i] - kw) / sw_ + 1;
                    addShapeD5(nOut0_[i], N, C, yD, yH, yW);
                } else if (t == "AveragePool3D") {
                    // 3D：各向异性核 kd/kh/kw + 6 pads + cip
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int N = shD0_[a]; int C = shD1_[a]; int D = shD2_[a]; int H = shD3_[a]; int W = shD4_[a];
                    int kd = nKD3_[i]; if (kd <= 0) kd = 1;
                    int kh = nKH_[i]; if (kh <= 0) kh = 1;
                    int kw = nKW_[i]; if (kw <= 0) kw = 1;
                    int sd = nSD3_[i]; if (sd <= 0) sd = 1;
                    int sh_ = nSH_[i]; if (sh_ <= 0) sh_ = 1;
                    int sw_ = nSW_[i]; if (sw_ <= 0) sw_ = 1;
                    int yD = (D + nPDT_[i] + nPDB_[i] - kd) / sd + 1;
                    int yH = (H + nPT_[i] + nPB_[i] - kh) / sh_ + 1;
                    int yW = (W + nPL_[i] + nPR_[i] - kw) / sw_ + 1;
                    addShapeD5(nOut0_[i], N, C, yD, yH, yW);
                } else if (t == "MaxPool") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int N = shD0_[a]; int C = shD1_[a]; int H = shD2_[a]; int W = shD3_[a];
                    int kh = nKH_[i]; int kw = nKW_[i];
                    int yH = (H + nPT_[i] + nPB_[i] - kh) / nSH_[i] + 1;
                    int yW = (W + nPL_[i] + nPR_[i] - kw) / nSW_[i] + 1;
                    addShapeD4(nOut0_[i], N, C, yH, yW);
                } else if (t == "AveragePool") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int N = shD0_[a]; int C = shD1_[a]; int H = shD2_[a]; int W = shD3_[a];
                    int kh = nKH_[i]; int kw = nKW_[i];
                    int yH = (H + nPT_[i] + nPB_[i] - kh) / nSH_[i] + 1;
                    int yW = (W + nPL_[i] + nPR_[i] - kw) / nSW_[i] + 1;
                    addShapeD4(nOut0_[i], N, C, yH, yW);
                } else if (t == "Pad") {
                    // F8：pads = [N,C,(D,)H,W] 各轴 begin/end（int64 初始器输入，opset11+）
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int is5 = shR5_[a];
                    if (is5 == 1) {
                        int pc = i64Count(nIn1_[i]);
                        int fromPool = 0;
                        if (pc >= 10) fromPool = 1;
                        else { pc = readI64Init(nIn1_[i], 10); }
                        if (pc < 10) return 0;
                        int pnB, pcB, pdB, phB, pwB, pnE, pcE, pdE, phE, pwE;
                        if (fromPool == 1) {
                            pnB = int(i64Get(nIn1_[i], 0)); pcB = int(i64Get(nIn1_[i], 1)); pdB = int(i64Get(nIn1_[i], 2)); phB = int(i64Get(nIn1_[i], 3)); pwB = int(i64Get(nIn1_[i], 4));
                            pnE = int(i64Get(nIn1_[i], 5)); pcE = int(i64Get(nIn1_[i], 6)); pdE = int(i64Get(nIn1_[i], 7)); phE = int(i64Get(nIn1_[i], 8)); pwE = int(i64Get(nIn1_[i], 9));
                        } else {
                            pnB = int(i64TmpL_[0]); pcB = int(i64TmpL_[1]); pdB = int(i64TmpL_[2]); phB = int(i64TmpL_[3]); pwB = int(i64TmpL_[4]);
                            pnE = int(i64TmpL_[5]); pcE = int(i64TmpL_[6]); pdE = int(i64TmpL_[7]); phE = int(i64TmpL_[8]); pwE = int(i64TmpL_[9]);
                        }
                        nPadB5_[i * 5 + 0] = pnB; nPadB5_[i * 5 + 1] = pcB; nPadB5_[i * 5 + 2] = pdB; nPadB5_[i * 5 + 3] = phB; nPadB5_[i * 5 + 4] = pwB;
                        nPadE5_[i * 5 + 0] = pnE; nPadE5_[i * 5 + 1] = pcE; nPadE5_[i * 5 + 2] = pdE; nPadE5_[i * 5 + 3] = phE; nPadE5_[i * 5 + 4] = pwE;
                        double cv = 0.0;
                        if (nIn2_[i] != "") { int cvc = readF32Init(nIn2_[i], 1); if (cvc > 0) cv = f32Tmp_[0]; }
                        nPadCval_[i] = F32.toBits(cv);
                        addShapeD5(nOut0_[i], shD0_[a] + pnB + pnE, shD1_[a] + pcB + pcE,
                                   shD2_[a] + pdB + pdE, shD3_[a] + phB + phE, shD4_[a] + pwB + pwE);
                    } else {
                        int pc = i64Count(nIn1_[i]);
                        int fromPool = 0;
                        if (pc >= 8) fromPool = 1;
                        else { pc = readI64Init(nIn1_[i], 8); }
                        if (pc < 8) return 0;
                        int pnB, pcB, phB, pwB, pnE, pcE, phE, pwE;
                        if (fromPool == 1) {
                            pnB = int(i64Get(nIn1_[i], 0)); pcB = int(i64Get(nIn1_[i], 1)); phB = int(i64Get(nIn1_[i], 2)); pwB = int(i64Get(nIn1_[i], 3));
                            pnE = int(i64Get(nIn1_[i], 4)); pcE = int(i64Get(nIn1_[i], 5)); phE = int(i64Get(nIn1_[i], 6)); pwE = int(i64Get(nIn1_[i], 7));
                        } else {
                            pnB = int(i64TmpL_[0]); pcB = int(i64TmpL_[1]); phB = int(i64TmpL_[2]); pwB = int(i64TmpL_[3]);
                            pnE = int(i64TmpL_[4]); pcE = int(i64TmpL_[5]); phE = int(i64TmpL_[6]); pwE = int(i64TmpL_[7]);
                        }
                        nPadB_[i * 4 + 0] = pnB; nPadB_[i * 4 + 1] = pcB; nPadB_[i * 4 + 2] = phB; nPadB_[i * 4 + 3] = pwB;
                        nPadE_[i * 4 + 0] = pnE; nPadE_[i * 4 + 1] = pcE; nPadE_[i * 4 + 2] = phE; nPadE_[i * 4 + 3] = pwE;
                        double cv = 0.0;
                        if (nIn2_[i] != "") { int cvc = readF32Init(nIn2_[i], 1); if (cvc > 0) cv = f32Tmp_[0]; }
                        nPadCval_[i] = F32.toBits(cv);
                        addShapeD4(nOut0_[i], shD0_[a] + pnB + pnE, shD1_[a] + pcB + pcE,
                                   shD2_[a] + phB + phE, shD3_[a] + pwB + pwE);
                    }
                } else if (t == "GlobalAveragePool") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    addShapeD4(nOut0_[i], shD0_[a], shD1_[a], 1, 1);
                } else if (t == "Flatten") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    // F8 3D：5D 输入（NCDHW）须连深度维一起拍平（shD1*shD2*shD3*shD4）
                    int f = shD1_[a] * shD2_[a] * shD3_[a];
                    if (shR5_[a] == 1) f = f * shD4_[a];
                    addShapeD4(nOut0_[i], shD0_[a], f, 1, 1);
                } else if (t == "Gemm") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int w = shapeIdx(nIn1_[i]); if (w < 0) return 0;
                    int m = shD0_[a];                     // [M,K]
                    int n = shD0_[w];                     // transB=1: [N,K] → N=d0
                    if (nTransB_[i] == 0) n = shD1_[w];   // transB=0: [K,N] → N=d1
                    addShapeD4(nOut0_[i], m, n, 1, 1);
                } else if (t == "MatMul") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int b = shapeIdx(nIn1_[i]); if (b < 0) return 0;
                    addShapeD4(nOut0_[i], shD0_[a], shD1_[b], 1, 1);
                } else if (t == "Add" || t == "Relu" || t == "Sigmoid" || t == "Softmax" || t == "BatchNormalization"
                           || t == "ReLU6" || t == "LeakyRelu" || t == "SiLU" || t == "HardSwish" || t == "Clip") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    copyShape(nOut0_[i], a);
                } else if (t == "Reshape") {
                    // F8：shape 来自输入[1]（int64 初始器）；-1 = 由总元素数推断，0 = 复制对应输入维
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int sc = readI64Init(nIn1_[i], 8);
                    if (sc <= 0) return 0;
                    int total = shD0_[a] * shD1_[a] * shD2_[a] * shD3_[a];
                    int[] outd = new int[8];
                    int inferIdx = -1;
                    int prod = 1;
                    int d = 0;
                    while (d < sc) {
                        int v = int(i64TmpL_[d]);
                        if (v == -1) { inferIdx = d; outd[d] = 1; }
                        else if (v == 0) {
                            if (d < 4) { outd[d] = (d == 0) ? shD0_[a] : ((d == 1) ? shD1_[a] : ((d == 2) ? shD2_[a] : shD3_[a])); }
                            else outd[d] = 1;
                        }
                        else outd[d] = v;
                        prod = prod * outd[d];
                        d = d + 1;
                    }
                    if (inferIdx >= 0 && prod > 0) outd[inferIdx] = total / prod;
                    int od0 = 1, od1 = 1, od2 = 1, od3 = 1;
                    if (sc >= 1) od0 = outd[0];
                    if (sc >= 2) od1 = outd[1];
                    if (sc >= 3) od2 = outd[2];
                    if (sc >= 4) od3 = outd[3];
                    addShapeD4(nOut0_[i], od0, od1, od2, od3);
                } else if (t == "Concat") {
                    // F8：沿 axis 拼接（2-3 输入），输出 = 各输入沿 axis 之和，其余维同输入0
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int axis = nAxis_[i];
                    if (axis < 0) axis = 0;
                    int is5 = shR5_[a];
                    int[] dims = new int[5];
                    dims[0] = shD0_[a]; dims[1] = shD1_[a]; dims[2] = shD2_[a]; dims[3] = shD3_[a]; dims[4] = shD4_[a];
                    // 沿 axis 累计（最多 3 输入，与 runtime opA/opB/opC 一致）
                    int axisSum = 0;
                    int slot = 0;
                    while (slot < 3) {
                        string nm;
                        if (slot == 0) nm = nIn0_[i];
                        else if (slot == 1) nm = nIn1_[i];
                        else nm = nIn2_[i];
                        if (nm == "") { slot = 3; break; }
                        int s = shapeIdx(nm); if (s < 0) return 0;
                        int av = (axis == 0) ? shD0_[s] : ((axis == 1) ? shD1_[s] : ((axis == 2) ? shD2_[s] : ((axis == 3) ? shD3_[s] : shD4_[s])));
                        axisSum = axisSum + av;
                        slot = slot + 1;
                    }
                    if (axis == 0) dims[0] = axisSum;
                    else if (axis == 1) dims[1] = axisSum;
                    else if (axis == 2) dims[2] = axisSum;
                    else if (axis == 3) dims[3] = axisSum;
                    else dims[4] = axisSum;
                    if (is5 == 1) addShapeD5(nOut0_[i], dims[0], dims[1], dims[2], dims[3], dims[4]);
                    else addShapeD4(nOut0_[i], dims[0], dims[1], dims[2], dims[3]);
                } else if (t == "Transpose") {
                    // F8：perm 属性（缺省 = 反转维度）
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int nd = 4;
                    int p0, p1, p2, p3;
                    if (nPc_[i] >= 4) { p0 = nP0_[i]; p1 = nP1_[i]; p2 = nP2_[i]; p3 = nP3_[i]; }
                    else if (nPc_[i] == 3) { p0 = nP0_[i]; p1 = nP1_[i]; p2 = nP2_[i]; p3 = 3; }
                    else if (nPc_[i] == 2) { p0 = nP0_[i]; p1 = nP1_[i]; p2 = 2; p3 = 3; }
                    else if (nPc_[i] == 1) { p0 = nP0_[i]; p1 = 1; p2 = 2; p3 = 3; }
                    else { p0 = 3; p1 = 2; p2 = 1; p3 = 0; }   // 缺省反转
                    int id0 = shD0_[a], id1 = shD1_[a], id2 = shD2_[a], id3 = shD3_[a];
                    int[] od = new int[4];
                    od[0] = (p0 == 0) ? id0 : ((p0 == 1) ? id1 : ((p0 == 2) ? id2 : id3));
                    od[1] = (p1 == 0) ? id0 : ((p1 == 1) ? id1 : ((p1 == 2) ? id2 : id3));
                    od[2] = (p2 == 0) ? id0 : ((p2 == 1) ? id1 : ((p2 == 2) ? id2 : id3));
                    od[3] = (p3 == 0) ? id0 : ((p3 == 1) ? id1 : ((p3 == 2) ? id2 : id3));
                    addShapeD4(nOut0_[i], od[0], od[1], od[2], od[3]);
                } else if (t == "Slice") {
                    // F8：starts/ends/axes/steps 为 int64 初始器输入（opset 10+）
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int sc = readI64Init(nIn1_[i], 8);   // starts
                    if (sc <= 0) return 0;
                    int k = 0;
                    while (k < sc) { slSt_[k] = i64TmpL_[k]; k = k + 1; }
                    int ec = readI64Init(nIn2_[i], 8);   // ends
                    if (ec <= 0) return 0;
                    k = 0;
                    while (k < ec) { slEn_[k] = i64TmpL_[k]; k = k + 1; }
                    int ac = readI64Init(nIn3_[i], 8);   // axes（可缺省 → 0..）
                    k = 0;
                    while (k < ac) { slAx_[k] = i64TmpL_[k]; k = k + 1; }
                    int pc = readI64Init(nIn4_[i], 8);   // steps（可缺省 → 全 1）
                    k = 0;
                    while (k < pc) { slSp_[k] = i64TmpL_[k]; k = k + 1; }
                    int cnt = sc;
                    if (cnt > 4) cnt = 4;
                    nSlN_[i] = cnt;
                    int id0 = shD0_[a], id1 = shD1_[a], id2 = shD2_[a], id3 = shD3_[a];
                    int[] odim = new int[4];
                    odim[0] = id0; odim[1] = id1; odim[2] = id2; odim[3] = id3;
                    k = 0;
                    while (k < cnt) {
                        int ax = 0;
                        if (ac > 0) ax = int(slAx_[k]);
                        else ax = k;
                        int step = 1;
                        if (pc > 0) step = int(slSp_[k]);
                        if (step == 0) return 0;   // 步长不能为 0
                        int D = (ax == 0) ? id0 : ((ax == 1) ? id1 : ((ax == 2) ? id2 : id3));
                        int co = sliceAxis(D, slSt_[k], slEn_[k], step, ax, i, k);
                        if (ax >= 0 && ax < 4) odim[ax] = co;
                        k = k + 1;
                    }
                    addShapeD4(nOut0_[i], odim[0], odim[1], odim[2], odim[3]);
                } else if (t == "Split") {
                    // F8：沿 axis 分割为 nOutN_ 个输出（split attr 或均分；starts/lens 存 nSplitSt_/nSplitLn_）
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int axis = nAxis_[i]; if (axis < 0) axis = 0;
                    int D = (axis == 0) ? shD0_[a] : ((axis == 1) ? shD1_[a] : ((axis == 2) ? shD2_[a] : shD3_[a]));
                    int no = nOutN_[i]; if (no < 1) no = 1;
                    int ns = nSplitN_[i];
                    int fromInput = 0;
                    if (ns <= 0 && nIn1_[i] != "") { ns = readI64Init(nIn1_[i], 4); fromInput = 1; }   // opset13+：split 为输入
                    int acc = 0;
                    int j = 0;
                    while (j < no && j < 4) {
                        int sz;
                        if (ns > j) {
                            if (fromInput == 1) sz = int(i64TmpL_[j]);
                            else sz = (j == 0) ? nSp0_[i] : ((j == 1) ? nSp1_[i] : ((j == 2) ? nSp2_[i] : nSp3_[i]));
                        } else {
                            sz = D / no;
                        }
                        if (j == no - 1) sz = D - acc;   // 最后一份吸收余数
                        if (sz < 0) sz = 0;
                        nSplitSt_[i * 4 + j] = acc;
                        nSplitLn_[i * 4 + j] = sz;
                        acc = acc + sz;
                        int d0 = shD0_[a], d1 = shD1_[a], d2 = shD2_[a], d3 = shD3_[a];
                        if (axis == 0) d0 = sz;
                        else if (axis == 1) d1 = sz;
                        else if (axis == 2) d2 = sz;
                        else d3 = sz;
                        string onm = (j == 0) ? nOut0_[i] : ((j == 1) ? nOut1_[i] : ((j == 2) ? nOut2_[i] : nOut3_[i]));
                        addShapeD4(onm, d0, d1, d2, d3);
                        j = j + 1;
                    }
                } else if (t == "Sub" || t == "Div" || t == "Mul" || t == "Sqrt") {
                    // F8：秩无关逐元素（输出形状 = 输入 0；标量/同形状广播）
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    copyShape(nOut0_[i], a);
                } else if (t == "ReduceMean") {
                    // F8：mode 0 = 全规约（标量）；mode 1 = 空间维规约（per-(n,c)，秩无关）
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int nAx = readI64Init(nIn1_[i], 8);   // axes 输入（opset18+；可缺省）
                    if (nAx <= 0 && nAxN_[i] > 0) {
                        // 属性形式（opset<=17）
                        nAx = nAxN_[i];
                        i64TmpL_[0] = nAx0_[i];
                        i64TmpL_[1] = nAx1_[i];
                        i64TmpL_[2] = nAx2_[i];
                        i64TmpL_[3] = nAx3_[i];
                    }
                    int mode = 0;
                    if (nAx > 0) {
                        int c0 = 0, c1 = 0, c2 = 0, c3 = 0;
                        int k = 0;
                        while (k < nAx) {
                            int ax = int(i64TmpL_[k]);
                            if (ax == 0) c0 = 1;
                            else if (ax == 1) c1 = 1;
                            else if (ax == 2) c2 = 1;
                            else if (ax == 3) c3 = 1;
                            k = k + 1;
                        }
                        if (c0 == 1 || c1 == 1) mode = 0;          // 含 N/C → 全规约
                        else if (c2 == 1 && c3 == 1) mode = 1;     // 空间维
                        else return 0;                              // 单空间维等 → 暂不支持
                    }
                    nRedMode_[i] = mode;
                    int N = shD0_[a]; int C = shD1_[a];
                    int S = shD2_[a] * shD3_[a];
                    if (mode == 0) addShapeD4(nOut0_[i], 1, 1, 1, 1);
                    else addShapeD4(nOut0_[i], N, C, 1, 1);   // keepdims 0/1 均按 [N,C,1,1]
                } else if (t == "InstanceNormalization") {
                    // F8：per-(n,c) 空间归一化（秩无关；scale/bias 为 [C] 常量）
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int s = shapeIdx(nIn1_[i]); if (s < 0) return 0;
                    int b = shapeIdx(nIn2_[i]); if (b < 0) return 0;
                    copyShape(nOut0_[i], a);
                } else if (t == "Resize" || t == "Upsample") {
                    // F8：2D/3D 上采样（nearest/linear/trilinear）。输出尺寸：sizes 初始器 > scales 初始器 > Upsample scales 属性
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int N = shD0_[a], C = shD1_[a];
                    int D = shD2_[a], H = shD3_[a], W = shD4_[a];
                    int is5 = shR5_[a];
                    if (is5 == 0) { D = 1; H = shD2_[a]; W = shD3_[a]; }   // 2D：D=1,H,W=shD2,shD3
                    int outD = D, outH = H, outW = W;
                    if (t == "Upsample") {
                        double sh = F32.toDouble(nUpSH_[i]);
                        double sw = F32.toDouble(nUpSW_[i]);
                        if (sh == 0.0) sh = 1.0;
                        if (sw == 0.0) sw = 1.0;
                        double hd = float(H);
                        double wd = float(W);
                        outH = int(hd * sh);
                        outW = int(wd * sw);
                    } else {
                        if (is5 == 1) {
                            // 3D：sizes [N,C,outD,outH,outW]。foldShapeChains 可能在
                            // 输入秩确定前跑（shapeRank5 误判 0 → 只填 nRszH/nRszW），
                            // 故 is5=1 须 nRszD/H/W 三者齐备才用折叠值；否则回退 readI64Init。
                            if (nRszD_[i] > 0 && nRszH_[i] > 0 && nRszW_[i] > 0) {
                                outD = nRszD_[i]; outH = nRszH_[i]; outW = nRszW_[i];
                            } else {
                                int szc = readI64Init(nIn3_[i], 8);   // sizes [N,C,outD,outH,outW]
                                if (szc >= 5) {
                                    outD = int(i64TmpL_[2]);
                                    outH = int(i64TmpL_[3]);
                                    outW = int(i64TmpL_[4]);
                                } else {
                                    int sc2 = readF32Init(nIn2_[i], 8);   // scales [1,1,sd,sh,sw]
                                    if (sc2 >= 3) {
                                        double dd = float(D);
                                        double hd = float(H);
                                        double wd = float(W);
                                        outD = int(dd * f32Tmp_[2]);
                                        outH = int(hd * f32Tmp_[3]);
                                        outW = int(wd * f32Tmp_[4]);
                                    }
                                }
                            }
                        } else {
                            if (nRszH_[i] > 0 && nRszW_[i] > 0) {
                                outH = nRszH_[i]; outW = nRszW_[i];
                            } else {
                                int szc = readI64Init(nIn3_[i], 8);   // sizes [N,C,outH,outW]
                                if (szc >= 4) {
                                    outH = int(i64TmpL_[2]);
                                    outW = int(i64TmpL_[3]);
                                } else {
                                    int sc2 = readF32Init(nIn2_[i], 8);   // scales [1,1,sh,sw]
                                    if (sc2 >= 3) {
                                        double hd = float(H);
                                        double wd = float(W);
                                        outH = int(hd * f32Tmp_[2]);
                                        outW = int(wd * f32Tmp_[3]);
                                    }
                                }
                            }
                        }
                    }
                    if (outD < 1) outD = 1;
                    if (outH < 1) outH = 1;
                    if (outW < 1) outW = 1;
                    if (is5 == 1) addShapeD5(nOut0_[i], N, C, outD, outH, outW);
                    else addShapeD4(nOut0_[i], N, C, outH, outW);
                } else {
                    return 0;   // 不支持的算子
                }
                i = i + 1;
            }
            return 1;
        }
        // F8：计算单轴切片（stIn/enIn 为全 int64 long）；写 nSlAx_/nSlSt_/nSlSp_
        // （nodeIdx 第 k 轴），返回输出长度（count）。支持负 step 反向。
        int sliceAxis(int D, long stIn, long enIn, int step, int ax, int nodeIdx, int k) {
            nSlAx_[nodeIdx * 4 + k] = ax;
            nSlSp_[nodeIdx * 4 + k] = step;
            int st;
            int cnt = 0;
            if (step > 0) {
                long stL = stIn;
                long enL = enIn;
                if (stL == 9223372036854775807L) stL = long(D);
                if (stL < 0L) stL = stL + long(D);
                if (enL == 9223372036854775807L) enL = long(D);
                if (enL < 0L) enL = enL + long(D);
                if (stL < 0L) stL = 0L;
                if (stL > long(D)) stL = long(D);
                if (enL < 0L) enL = 0L;
                if (enL > long(D)) enL = long(D);
                st = int(stL);
                int en = int(enL);
                if (en > st) cnt = (en - st + step - 1) / step;
            } else {
                long stL = stIn;
                long enL = enIn;
                if (stL == 9223372036854775807L) stL = long(D - 1);
                if (stL < 0L) stL = stL + long(D);
                if (enL == 9223372036854775807L) enL = -1L;
                if (enL < 0L) enL = enL + long(D);
                if (stL < -1L) stL = -1L;
                if (stL > long(D - 1)) stL = long(D - 1);
                if (enL < -1L) enL = -1L;
                if (enL > long(D - 1)) enL = long(D - 1);
                st = int(stL);
                int en = int(enL);
                int nsp = 0 - step;
                if (st > en) cnt = (st - en + nsp - 1) / nsp;
            }
            nSlSt_[nodeIdx * 4 + k] = st;
            return cnt;
        }
        int fuseConvBN() {
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] != "Conv") { i = i + 1; continue; }
                if (nFused_[i] == 1) { i = i + 1; continue; }
                if (isGraphOutput(nOut0_[i]) == 1) { i = i + 1; continue; }
                // P2b：精确匹配 Conv 输出的唯一 Use = BatchNormalization operand0。
                // 残差分支、重复 operand 或 BN 接在非主输入时均不融合。
                int j = matchSingleUseOp(valueId(nOut0_[i]), "BatchNormalization", 0);
                if (j < 0) { i = i + 1; continue; }
                // BN 4 参数必须是初始器
                if (initIdx(nIn1_[j]) < 0 || initIdx(nIn2_[j]) < 0 || initIdx(nIn3_[j]) < 0 || initIdx(nIn4_[j]) < 0) { i = i + 1; continue; }
                // 标记 conv 权重/偏置折叠（记录 BN 参数初始器下标 + BN 节点下标）
                int wi = initIdx(nIn1_[i]);
                int wb = initIdx(nIn2_[i]);
                if (wi >= 0) { wBN_[wi] = 1; wBNNode_[wi] = j; wBNScale_[wi] = initIdx(nIn1_[j]); wBNBias_[wi] = initIdx(nIn2_[j]); wBNMean_[wi] = initIdx(nIn3_[j]); wBNVar_[wi] = initIdx(nIn4_[j]); }
                if (wb >= 0) { wBN_[wb] = 1; wBNNode_[wb] = j; wBNScale_[wb] = initIdx(nIn1_[j]); wBNBias_[wb] = initIdx(nIn2_[j]); wBNMean_[wb] = initIdx(nIn3_[j]); wBNVar_[wb] = initIdx(nIn4_[j]); }
                else {
                    // G4：无卷积偏置的 Conv（真实模型常见）→ 由 BN 参数合成偏置
                    // b'[oc] = (0 - mean[oc])*invStd[oc] + bnBias[oc]（writeWeight 按 wBNOnly_ 计算）
                    int Cout = wRows_[wi];
                    string bname = nOut0_[i] + "#bnb";
                    int[] bdims = new int[1];
                    bdims[0] = Cout;
                    wName_[wCount_] = bname;
                    wRows_[wCount_] = Cout;
                    wCols_[wCount_] = 1;
                    wType_[wCount_] = 1;
                    wKind_[wCount_] = 1;
                    wOff_[wCount_] = 0;
                    wLen_[wCount_] = Cout * 4;   // 无源字节，仅用于 count
                    wTrans_[wCount_] = 0;
                    wBias_[wCount_] = 0;
                    wRole_[wCount_] = 3;
                    wBN_[wCount_] = 1;
                    wBNOnly_[wCount_] = 1;
                    wBNNode_[wCount_] = j;
                    wBNScale_[wCount_] = initIdx(nIn1_[j]);
                    wBNBias_[wCount_] = initIdx(nIn2_[j]);
                    wBNMean_[wCount_] = initIdx(nIn3_[j]);
                    wBNVar_[wCount_] = initIdx(nIn4_[j]);
                    wCount_ = wCount_ + 1;
                    addShapeD(bname, bdims, 1);
                    setShapeKind(bname, Kind.CNN_B());
                    nIn2_[i] = bname;
                }
                nFused_[i] = 1;
                nFusedOut_[i] = nOut0_[j];
                nType_[j] = "";
                markDeadTensor(nOut0_[i]);   // conv 中间输出
                // BN 参数不再被消费 → 标死（不分配/不登记/不写权重）
                if (liveConsumers(nIn1_[j]) == 0) markDeadTensor(nIn1_[j]);
                if (liveConsumers(nIn2_[j]) == 0) markDeadTensor(nIn2_[j]);
                if (liveConsumers(nIn3_[j]) == 0) markDeadTensor(nIn3_[j]);
                if (liveConsumers(nIn4_[j]) == 0) markDeadTensor(nIn4_[j]);
                bnCount_ = bnCount_ + 1;
                i = i + 1;
            }
            return 1;
        }
        double bnInvStd(int wi, int oc) {
            int j = wBNNode_[wi];
            double s = f32At(wOff_[wBNScale_[wi]] + oc * 4);
            double v = f32At(wOff_[wBNVar_[wi]] + oc * 4);
            double e = 1.0e-5;
            if (nHasEps_[j] == 1) e = F32.toDouble(nEpsInt_[j]);
            return s / Math.sqrt(v + e);
        }
        double bnFoldBias(int wi, int oc, double b) {
            int j = wBNNode_[wi];
            double m = f32At(wOff_[wBNMean_[wi]] + oc * 4);
            double bb = f32At(wOff_[wBNBias_[wi]] + oc * 4);
            return (b - m) * bnInvStd(wi, oc) + bb;
        }
        int fuseConvRelu() {
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] != "Conv") { i = i + 1; continue; }
                string eff = effectiveOut(i);
                if (isGraphOutput(eff) == 1) { i = i + 1; continue; }   // 中间张量不能是图输出
                int j = matchSingleUseOp(valueId(eff), "Relu", 0);
                if (j < 0) { i = i + 1; continue; }
                fuseReluIntoProducer(i, j);
                i = i + 1;
            }
            return 1;
        }
        int fuseReluOp() {
            // G6：InstanceNormalization→Relu 融合（IN 输出直接过 ReLU，省一次 arena 往返）。
            // 注：Add→Relu 融合实测因 arena 布局变化反回退（relu 中间张量不分配→conv 缓存命中变差），不启用。
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] != "InstanceNormalization") { i = i + 1; continue; }
                string eff = effectiveOut(i);
                if (isGraphOutput(eff) == 1) { i = i + 1; continue; }
                int j = matchSingleUseOp(valueId(eff), "Relu", 0);
                if (j < 0) { i = i + 1; continue; }
                fuseReluIntoProducer(i, j);
                i = i + 1;
            }
            return 1;
        }
        int isGraphOutput(string name) {
            int i = 0;
            while (i < goCount_) {
                if (goName_[i] == name) return 1;
                i = i + 1;
            }
            return 0;
        }
        int fuseGapFlatten() {
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] != "GlobalAveragePool") { i = i + 1; continue; }
                if (isGraphOutput(nOut0_[i]) == 1) { i = i + 1; continue; }
                int s = shapeIdx(nOut0_[i]);
                if (s >= 0 && shD0_[s] != 1) { i = i + 1; continue; }   // batch!=1 跳过
                int j = matchSingleUseOp(valueId(nOut0_[i]), "Flatten", 0);
                if (j < 0) { i = i + 1; continue; }
                fuseSingleUseOutput(i, j, 0);
                gapCount_ = gapCount_ + 1;
                i = i + 1;
            }
            return 1;
        }
        int eliminateDeadNodes() {
            int changed = 1;
            while (changed == 1) {
                changed = 0;
                // P2c：本轮删节点前重建精确 use 表；删除会使表失效，下一轮再重建。
                // 这保留原有固定点 DCE 语义，并避免对每个节点扫描全图 consumers。
                rebuildDefUse();
                int i = 0;
                while (i < nCount_) {
                    if (nType_[i] == "") { i = i + 1; continue; }
                    string eff = effectiveOut(i);
                    if (eff == "") { i = i + 1; continue; }
                    if (isGraphOutput(eff) == 1) { i = i + 1; continue; }
                    if (valueUseCount(valueId(eff)) == 0) {
                        if (nFused_[i] == 1) markDeadTensor(nOut0_[i]);
                        nType_[i] = "";
                        markDeadTensor(eff);
                        dceCount_ = dceCount_ + 1;
                        changed = 1;
                    }
                    i = i + 1;
                }
            }
            return 1;
        }
        string effectiveOut(int i) {
            if (nFused_[i] == 1) return nFusedOut_[i];
            return nOut0_[i];
        }
        int liveConsumers(string name) {
            int cnt = 0;
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] == "") { i = i + 1; continue; }
                if (nIn0_[i] == name || nIn1_[i] == name || nIn2_[i] == name || nIn3_[i] == name || nIn4_[i] == name) cnt = cnt + 1;
                i = i + 1;
            }
            return cnt;
        }
        int foldConstants() {
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] == "Constant" && nConstVal_[i] == 1) {
                    int off = nConstOff_[i];
                    int len = nConstLen_[i];
                    int end = off + len;
                    pb_.seek(off);
                    int[] dims = new int[8];
                    int dimCount = 0;
                    int dt = 0;
                    int payloadKind = 0;
                    int payloadOff = 0;
                    int payloadLen = 0;
                    while (pb_.pos() < end) {
                        int f = pb_.nextTag();
                        if (f == -1) break;
                        if (f == 1) {
                            if (dimCount < 8) { dims[dimCount] = pb_.readVarint(); dimCount = dimCount + 1; }
                            else { long v = pb_.readVarint64(); }
                        } else if (f == 2) {
                            dt = pb_.readVarint();
                        } else if (f == 4 || f == 9) {
                            payloadKind = 1;
                            payloadLen = pb_.readLen();
                            payloadOff = pb_.payloadOff();
                            pb_.skipBytes(payloadLen);
                        } else if (f == 10) {
                            payloadKind = 2;
                            payloadLen = pb_.readLen();
                            payloadOff = pb_.payloadOff();
                            pb_.skipBytes(payloadLen);
                        } else {
                            pb_.skipField();
                        }
                    }
                    if (dt == 1 && payloadKind == 1) {   // FLOAT
                        int rows = 1; int cols = 1;
                        if (dimCount == 0) { rows = 1; cols = 1; }
                        else if (dimCount == 1) { rows = dims[0]; cols = 1; }
                        else if (dimCount == 2) { rows = dims[0]; cols = dims[1]; }
                        else {
                            rows = dims[0];
                            cols = 1;
                            int k = 1;
                            while (k < dimCount) { cols = cols * dims[k]; k = k + 1; }
                        }
                        wName_[wCount_] = nOut0_[i];
                        wRows_[wCount_] = rows;
                        wCols_[wCount_] = cols;
                        wType_[wCount_] = dt;
                        wKind_[wCount_] = payloadKind;
                        wOff_[wCount_] = payloadOff;
                        wLen_[wCount_] = payloadLen;
                        wTrans_[wCount_] = 0;
                        wBias_[wCount_] = 0;
                        wRole_[wCount_] = 4;      // 通用常量：直接拷贝
                        wNHWC_[wCount_] = 0;
                        wBN_[wCount_] = 0;          // G3：常量不折叠 BN
                        wBNOnly_[wCount_] = 0;
                        wCount_ = wCount_ + 1;
                        addShapeD(nOut0_[i], dims, dimCount);
                        setShapeKind(nOut0_[i], Kind.FC_C());
                        nType_[i] = "";
                        foldCount_ = foldCount_ + 1;
                    }
                }
                i = i + 1;
            }
            return 1;
        }
        // 判断 name 是否由「尚未折叠的 shape 链节点」产出（int64 值后续才可知）。
        // 用于 Concat 折叠的部分折叠保护：避免把不完整的链（缺前缀/后缀）当完整折叠。
        int i64ChainAlive(string name) {
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] == "") { i = i + 1; continue; }
                if (nOut0_[i] == name) {
                    string tp = nType_[i];
                    if (tp == "Constant" || tp == "Shape" || tp == "ReduceProd" ||
                        tp == "Unsqueeze" || tp == "Gather" || tp == "Slice" ||
                        tp == "Concat" || tp == "Cast") {
                        return 1;
                    }
                    return 0;
                }
                i = i + 1;
            }
            return 0;
        }

        int foldShapeChains() {
            // P3：int64 形状链折叠（Shape/Slice/Concat/Cast/Unsqueeze/Gather/ReduceProd）。
            // 可两次调用（inferShapes 前折叠 Resize sizes 链；后折叠剩余链）。幂等。
            // 先播种所有 int64 初始器常量
            int wi = 0;
            while (wi < wCount_) {
                if (wType_[wi] == 7) i64RegInit(wName_[wi], wName_[wi], 64);
                wi = wi + 1;
            }
            int i = 0;
            while (i < nCount_) {
                string t = nType_[i];
                if (t == "") { i = i + 1; continue; }
                if (t == "Constant") {
                    if (nConstVal_[i] == 1) {
                        i64RegConstant(nOut0_[i], nConstOff_[i], nConstLen_[i]);
                        if (i64Count(nOut0_[i]) > 0) { nType_[i] = ""; foldCount_ = foldCount_ + 1; }
                    }
                } else if (t == "Shape") {
                    int s = shapeIdx(nIn0_[i]);
                    if (s < 0) { i = i + 1; continue; }
                    long[] v = new long[8];
                    int n = 4;
                    v[0] = long(shD0_[s]); v[1] = long(shD1_[s]); v[2] = long(shD2_[s]); v[3] = long(shD3_[s]);
                    if (shR5_[s] == 1) { v[4] = long(shD4_[s]); n = 5; }
                    i64Reg(nOut0_[i], v, n);
                    nType_[i] = "";
                } else if (t == "ReduceProd") {
                    if (i64Count(nIn0_[i]) > 0) {
                        int c = i64Count(nIn0_[i]);
                        long prod = 1L;
                        int k = 0;
                        while (k < c) { prod = prod * i64Get(nIn0_[i], k); k = k + 1; }
                        long[] v = new long[1];
                        v[0] = prod;
                        i64Reg(nOut0_[i], v, 1);
                        nType_[i] = "";
                    }
                } else if (t == "Unsqueeze") {
                    if (i64Count(nIn0_[i]) > 0) {
                        int c = i64Count(nIn0_[i]);
                        long[] v = new long[32];
                        int k = 0;
                        while (k < c) { v[k] = i64Get(nIn0_[i], k); k = k + 1; }
                        i64Reg(nOut0_[i], v, c);   // reshape：值不变
                        nType_[i] = "";
                    }
                } else if (t == "Gather") {
                    if (i64Count(nIn0_[i]) > 0 && i64Count(nIn1_[i]) > 0) {
                        int dataN = i64Count(nIn0_[i]);
                        int idxN = i64Count(nIn1_[i]);
                        long[] v = new long[32];
                        int k = 0;
                        while (k < idxN && k < 32) {
                            long ix = i64Get(nIn1_[i], k);
                            int ii = int(ix);
                            if (ii < 0) ii = ii + dataN;
                            if (ii >= 0 && ii < dataN) v[k] = i64Get(nIn0_[i], ii);
                            else v[k] = 0L;
                            k = k + 1;
                        }
                        i64Reg(nOut0_[i], v, idxN);
                        nType_[i] = "";
                    }
                } else if (t == "Slice") {
                    // 仅折叠 int64 数据链（float 数据 Slice 是运行时算子，不动）
                    if (i64Count(nIn0_[i]) > 0) {
                        int dataN = i64Count(nIn0_[i]);
                        long[] st = new long[8]; int stc = i64Count(nIn1_[i]);
                        int k = 0; while (k < stc && k < 8) { st[k] = i64Get(nIn1_[i], k); k = k + 1; }
                        if (stc <= 0) { stc = readI64Init(nIn1_[i], 8); k = 0; while (k < stc && k < 8) { st[k] = i64TmpL_[k]; k = k + 1; } }
                        long[] en = new long[8]; int enc = i64Count(nIn2_[i]);
                        k = 0; while (k < enc && k < 8) { en[k] = i64Get(nIn2_[i], k); k = k + 1; }
                        if (enc <= 0) { enc = readI64Init(nIn2_[i], 8); k = 0; while (k < enc && k < 8) { en[k] = i64TmpL_[k]; k = k + 1; } }
                        long[] ax = new long[8]; int axc = i64Count(nIn3_[i]);
                        k = 0; while (k < axc && k < 8) { ax[k] = i64Get(nIn3_[i], k); k = k + 1; }
                        if (axc <= 0) { axc = readI64Init(nIn3_[i], 8); k = 0; while (k < axc && k < 8) { ax[k] = i64TmpL_[k]; k = k + 1; } }
                        long[] sp = new long[8]; int spc = i64Count(nIn4_[i]);
                        k = 0; while (k < spc && k < 8) { sp[k] = i64Get(nIn4_[i], k); k = k + 1; }
                        if (spc <= 0) { spc = readI64Init(nIn4_[i], 8); k = 0; while (k < spc && k < 8) { sp[k] = i64TmpL_[k]; k = k + 1; } }
                        int cnt = stc; if (cnt > 4) cnt = 4;
                        long[] v = new long[32];
                        int outc = 0;
                        int j = 0;
                        while (j < cnt) {
                            int a = 0;
                            if (axc > 0) a = int(ax[j]); else a = j;
                            int step = 1;
                            if (spc > 0) step = int(sp[j]);
                            if (step == 0) step = 1;
                            int D = dataN;
                            long stL = st[j]; long enL = en[j];
                            if (stL == 9223372036854775807L) stL = long(D);
                            if (stL < 0L) stL = stL + long(D);
                            if (enL == 9223372036854775807L) enL = long(D);
                            if (enL < 0L) enL = enL + long(D);
                            if (stL < 0L) stL = 0L;
                            if (stL > long(D)) stL = long(D);
                            if (enL < 0L) enL = 0L;
                            if (enL > long(D)) enL = long(D);
                            int sti = int(stL);
                            int eni = int(enL);
                            if (step > 0) {
                                int q = sti;
                                while (q < eni && outc < 32) { v[outc] = i64Get(nIn0_[i], q); outc = outc + 1; q = q + step; }
                            } else {
                                int q = sti;
                                while (q > eni && outc < 32) { v[outc] = i64Get(nIn0_[i], q); outc = outc + 1; q = q + step; }
                            }
                            j = j + 1;
                        }
                        i64Reg(nOut0_[i], v, outc);
                        nType_[i] = "";
                    }
                } else if (t == "Concat") {
                    // 仅折叠 int64 链（float Concat 是运行时算子）
                    if (i64Count(nIn0_[i]) > 0 || i64Count(nIn1_[i]) > 0) {
                        // 部分折叠保护：若任一输入是「尚未折叠的 shape 链节点」
                        // （其 int64 值后续才可知），本次不折叠，留给 inferShapes
                        // 推进后的内部 foldShapeChains（避免丢掉前缀/后缀）。
                        int wait = 0;
                        int wslot = 0;
                        while (wslot < 3) {
                            string wnm;
                            if (wslot == 0) wnm = nIn0_[i];
                            else if (wslot == 1) wnm = nIn1_[i];
                            else wnm = nIn2_[i];
                            if (wnm == "") { wslot = 3; break; }
                            if (i64ChainAlive(wnm) == 1) { wait = 1; wslot = 3; break; }
                            wslot = wslot + 1;
                        }
                        if (wait == 0) {
                            long[] v = new long[64];
                            int outc = 0;
                            int slot = 0;
                            while (slot < 3) {
                                string nm;
                                if (slot == 0) nm = nIn0_[i];
                                else if (slot == 1) nm = nIn1_[i];
                                else nm = nIn2_[i];
                                if (nm == "") { slot = 3; break; }
                                if (i64Count(nm) > 0) {
                                    int c = i64Count(nm);
                                    int k = 0;
                                    while (k < c && outc < 64) { v[outc] = i64Get(nm, k); outc = outc + 1; k = k + 1; }
                                }
                                slot = slot + 1;
                            }
                            if (outc > 0) { i64Reg(nOut0_[i], v, outc); nType_[i] = ""; }
                        }
                    }
                } else if (t == "Cast") {
                    int to = nCastTo_[i];
                    if (to == 7 && i64Count(nIn0_[i]) > 0) {
                        // int64 恒等（float 常量 Cast 折叠由第二次调用处理）
                        int c = i64Count(nIn0_[i]);
                        long[] v = new long[32];
                        int k = 0;
                        while (k < c) { v[k] = i64Get(nIn0_[i], k); k = k + 1; }
                        i64Reg(nOut0_[i], v, c);
                        nType_[i] = "";
                    } else if (to == 1 && i64Count(nIn0_[i]) > 0) {
                        // int64→float：注册为运行时 float 常量
                        int c = i64Count(nIn0_[i]);
                        int src = i64Find(nIn0_[i]);
                        long[] v = new long[32];
                        int k = 0;
                        while (k < c && k < 32) { v[k] = i64Get(nIn0_[i], k); k = k + 1; }
                        regComputedF32(nOut0_[i], v, c);
                        nType_[i] = "";
                        foldCount_ = foldCount_ + 1;
                    }
                } else if (t == "Resize" || t == "Upsample") {
                    // 记录折叠出的 sizes（优先于初始器）。用 sizes 元素个数判断 3D/2D
                    // （3D=[N,C,outD,outH,outW] 5 个；2D=[N,C,outH,outW] 4 个）——
                    // 不依赖 shapeRank5（fold 阶段输入秩可能未定）。
                    int c5 = i64Count(nIn3_[i]);
                    if (c5 >= 5) {
                        nRszD_[i] = int(i64Get(nIn3_[i], 2));
                        nRszH_[i] = int(i64Get(nIn3_[i], 3));
                        nRszW_[i] = int(i64Get(nIn3_[i], 4));
                    } else if (c5 >= 4) {
                        nRszH_[i] = int(i64Get(nIn3_[i], 2));
                        nRszW_[i] = int(i64Get(nIn3_[i], 3));
                    }
                }
                i = i + 1;
            }
            return 1;
        }
        int layoutNHWC() {
            // Phase A：按拓扑序标记节点布局（nNHWC_）
            int i = 0;
            while (i < nCount_) {
                nNHWC_[i] = 0;
                string t = nType_[i];
                if (t == "Conv") nNHWC_[i] = 1;                       // 卷积主干始终 NHWC
                else if (t == "MaxPool" || t == "AveragePool" || t == "Pad" || t == "Add" || t == "Relu" || t == "BatchNormalization") {
                    int p0 = producerNHWC(nIn0_[i]);
                    int p1 = producerNHWC(nIn1_[i]);
                    if (p0 == 1 || p1 == 1) nNHWC_[i] = 1;
                } else if (t == "GlobalAveragePool") {
                    nNHWC_[i] = producerNHWC(nIn0_[i]);               // 输入侧 NHWC，输出为 NCHW 边界
                }
                i = i + 1;
            }
            // Phase A.5：NHWC 节点的输出张量登记为 NHWC（GAP 输出是边界，除外）
            i = 0;
            while (i < nCount_) {
                if (nNHWC_[i] == 1 && nType_[i] != "GlobalAveragePool") {
                    setShapeNHWC(effectiveOut(i));
                }
                i = i + 1;
            }
            // Phase B：确保 NHWC 节点的激活输入都在 NHWC（必要时插入转置节点）
            i = 0;
            while (i < nCount_) {
                string t = nType_[i];
                if (nNHWC_[i] == 1 && (t == "Conv" || t == "MaxPool" || t == "AveragePool" || t == "Pad" || t == "Add" || t == "Relu" || t == "GlobalAveragePool" || t == "BatchNormalization")) {
                    ensureNHWCInput(i, 0);
                    if (t == "Conv") markWeightNHWC(nIn1_[i]);
                    if (t == "Add") ensureNHWCInput(i, 1);
                }
                i = i + 1;
            }
            return 1;
        }
        int producerNHWC(string name) {
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] == "") { i = i + 1; continue; }
                string eff = nOut0_[i];
                if (nFused_[i] == 1) eff = nFusedOut_[i];
                if (eff == name) return nNHWC_[i];
                i = i + 1;
            }
            return 0;
        }
        void ensureNHWCInput(int nodeIdx, int slot) {
            string nm;
            if (slot == 0) nm = nIn0_[nodeIdx];
            else nm = nIn1_[nodeIdx];
            if (nm == "") return;
            if (producerNHWC(nm) == 1) return;    // 已是 NHWC
            if (initIdx(nm) >= 0) return;         // 初始器（权重单独处理）
            string tname = nm + "#nhwc";
            if (shapeIdx(tname) < 0) {
                int s = shapeIdx(nm);
                if (s < 0) return;
                int N = shD0_[s]; int H = shD1_[s]; int W = shD2_[s]; int C = shD3_[s];
                addShapeD4(tname, N, H, W, C);              // [N,H,W,C] 形状
                setShapeKind(tname, Kind.CNN_ACT());
                shNHWC_[shapeIdx(tname)] = 1;
                // 追加 NCHW2NHWC 转置节点
                nType_[nCount_] = "NCHW2NHWC";
                nIn0_[nCount_] = nm;
                nOut0_[nCount_] = tname;
                nConstVal_[nCount_] = 0;
                nNHWC_[nCount_] = 1;
                nFused_[nCount_] = 0;
                nFusedBy_[nCount_] = -1;
                nFusedOut_[nCount_] = "";
                nCount_ = nCount_ + 1;
            }
            if (slot == 0) nIn0_[nodeIdx] = tname;
            else nIn1_[nodeIdx] = tname;
        }
        void markWeightNHWC(string name) {
            int wi = initIdx(name);
            if (wi >= 0) {
                wNHWC_[wi] = 1;
                setShapeNHWC(name);
            }
        }
        void markDeadTensor(string name) {
            int s = shapeIdx(name);
            if (s >= 0) shDead_[s] = 1;
        }
        void setShapeNHWC(string name) {
            int s = shapeIdx(name);
            if (s >= 0) shNHWC_[s] = 1;
        }
        int topoSort() {
            int[] indeg = new int[512];
            // P0：所有既有 mutation pass 已完成，此处统一重建 def-use，再消费 O(1) producer 索引。
            rebuildDefUse();
            if (Console.getEnv("MYP_IR_VERIFY") == "1" && verifyIR() == 0) {
                Console.writeLine("DBG fail verifyIR");
                return 0;
            }
            int i = 0;
            while (i < nCount_) {
                indeg[i] = 0;
                if (nType_[i] == "") { i = i + 1; continue; }
                if (valueProducer(nodeInputValue(i, 0)) >= 0) indeg[i] = indeg[i] + 1;
                if (valueProducer(nodeInputValue(i, 1)) >= 0) indeg[i] = indeg[i] + 1;
                if (valueProducer(nodeInputValue(i, 2)) >= 0) indeg[i] = indeg[i] + 1;
                if (valueProducer(nodeInputValue(i, 3)) >= 0) indeg[i] = indeg[i] + 1;
                i = i + 1;
            }
            planOrderCount_ = 0;
            int remaining = 0;
            i = 0;
            while (i < nCount_) { if (nType_[i] != "") remaining = remaining + 1; i = i + 1; }
            while (planOrderCount_ < remaining) {
                int picked = -1;
                i = 0;
                while (i < nCount_) {
                    if (nType_[i] != "" && indeg[i] == 0) { picked = i; i = nCount_; }
                    i = i + 1;
                }
                if (picked < 0) {
                    if (Console.getEnv("MYP_GR_DBG") == "1") {
                        Console.writeString("topoSort stuck remaining=" + Fmt.i(remaining) + " indeg[0..]:");
                        Console.writeLine("");
                        int d = 0;
                        while (d < nCount_) {
                            if (nType_[d] != "" && indeg[d] > 0) {
                                Console.writeString("  n" + Fmt.i(d) + " type=" + nType_[d] + " indeg=" + Fmt.i(indeg[d]) + " in0=" + nIn0_[d] + " in1=" + nIn1_[d] + " in2=" + nIn2_[d]);
                                Console.writeLine("");
                            }
                            d = d + 1;
                        }
                    }
                    return 0;   // 有环
                }
                planOrder_[planOrderCount_] = picked;
                planOrderCount_ = planOrderCount_ + 1;
                indeg[picked] = -1;
                // 多输出（Split/BwdDense/SoftmaxCE）：递减所有输出（out0..out3）的消费者
                string out = effectiveOut(picked);
                string o1 = nOut1_[picked];
                string o2 = nOut2_[picked];
                string o3 = nOut3_[picked];
                // P0：按精确 (user,slot) use edge 递减，重复 operand（Mul(x,x)）自然处理。
                int[] produced = new int[4];
                produced[0] = valueId(out); produced[1] = valueId(o1); produced[2] = valueId(o2); produced[3] = valueId(o3);
                int ps = 0;
                while (ps < 4) {
                    int pv = produced[ps];
                    if (pv >= 0) {
                        int use = 0;
                        while (use < valueUseCount(pv)) {
                            int user = valueUseNode(pv, use);
                            if (user >= 0 && indeg[user] >= 0) indeg[user] = indeg[user] - 1;
                            use = use + 1;
                        }
                    }
                    ps = ps + 1;
                }
            }
            analysisValid_ = analysisValid_ | IRAnalysis.TOPO();
            topoGeneration_ = analysisGeneration_;
            return 1;
        }
        int producerIdx(string name) {
            if (name == "") return -1;   // 空输入槽不算入度（nOut1_=="" 会误匹配）
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] == "") { i = i + 1; continue; }
                if (effectiveOut(i) == name) return i;
                if (nOut1_[i] == name || nOut2_[i] == name || nOut3_[i] == name) return i;   // 多输出
                i = i + 1;
            }
            return -1;
        }
        int planMemory() {
            int si = 0;
            while (si < sCount_) { planProducer_[si] = -1; planLastUse_[si] = -1; planOff_[si] = 0; si = si + 1; }
            // producer = 产出该张量的节点在拓扑序中的位置（融合节点以 effectiveOut 计）
            int oi = 0;
            while (oi < planOrderCount_) {
                int ni = planOrder_[oi];
                int s = shapeIdx(effectiveOut(ni));
                if (s >= 0) planProducer_[s] = oi;
                oi = oi + 1;
            }
            // lastUse = 消费该张量的最大拓扑位置（活节点）
            oi = 0;
            while (oi < planOrderCount_) {
                int ni = planOrder_[oi];
                int a = shapeIdx(nIn0_[ni]); if (a >= 0 && oi > planLastUse_[a]) planLastUse_[a] = oi;
                int b = shapeIdx(nIn1_[ni]); if (b >= 0 && oi > planLastUse_[b]) planLastUse_[b] = oi;
                int c = shapeIdx(nIn2_[ni]); if (c >= 0 && oi > planLastUse_[c]) planLastUse_[c] = oi;
                oi = oi + 1;
            }
            // first-fit 分配（按形状表顺序 = 拓扑序）
            // persistent：权重 / 图输入 / 图输出（多 pass 需全程存活，区域不可复用）
            int rc = 0;
            int highWater = 0;
            si = 0;
            while (si < sCount_) {
                if (shDead_[si] == 1) { planOff_[si] = 0; si = si + 1; continue; }   // G2：死张量不分配
                int size = shD0_[si] * shD1_[si] * shD2_[si] * shD3_[si];
                if (shR5_[si] == 1) size = size * shD4_[si];   // 3D：5D 张量乘 D 维
                int producer = planProducer_[si];
                int lastUse = planLastUse_[si];
                int persist = 0;
                if (producer < 0) persist = 1;            // 权重 / 图输入
                if (lastUse < 0) { persist = 1; lastUse = nCount_ - 1; }  // 图输出
                if (isGraphOutput(shName_[si]) == 1) persist = 1;   // 图输出：run 后用户仍读，缓冲不可复用
                if (noReuse_ == 1) persist = 1;            // 调试：不复用
                int best = -1;
                if (persist == 0) {
                    int r = 0;
                    while (r < rc) {
                        if (planRPersist_[r] == 0 && planRLu_[r] < producer && planRSize_[r] >= size) { best = r; r = rc; }
                        r = r + 1;
                    }
                }
                int off = 0;
                if (best >= 0) {
                    off = planROff_[best];
                    planRSize_[best] = size;
                    planRLu_[best] = lastUse;
                } else {
                    off = highWater;
                    highWater = highWater + size;
                    planROff_[rc] = off;
                    planRSize_[rc] = size;
                    planRLu_[rc] = lastUse;
                    planRPersist_[rc] = persist;
                    rc = rc + 1;
                }
                planOff_[si] = off;
                si = si + 1;
            }
            analysisValid_ = analysisValid_ | IRAnalysis.LIVENESS();
            livenessGeneration_ = analysisGeneration_;
            return highWater;
        }
        int buildRuntime(InferenceRuntime rt) {
            // 1) 登记张量（按形状表顺序，用规划偏移；死张量跳过）
            int si = 0;
            while (si < sCount_) {
                if (shDead_[si] == 1) { si = si + 1; continue; }
                string nm = shName_[si];
                int kind = shKind_[si];
                int d0 = shD0_[si]; int d1 = shD1_[si]; int d2 = shD2_[si]; int d3 = shD3_[si];
                int off = planOff_[si];
                int tid = -1;
                if (kind == Kind.FC_ACT()) {
                    tid = rt.addTensorPlanned2(d1, d0, off);            // ONNX [M,N] → 运行时 [N,M]
                } else if (kind == Kind.FC_W()) {
                    int ii = initIdx(nm);
                    if (ii >= 0 && wTrans_[ii] == 1) tid = rt.addTensorPlanned2(d0, d1, off);   // [N,K]
                    else tid = rt.addTensorPlanned2(d1, d0, off);       // [K,N] → [N,K]
                } else if (kind == Kind.FC_B()) {
                    tid = rt.addTensorPlanned2(d0, 1, off);             // [N] → [N,1]
                } else if (kind == Kind.CNN_B()) {
                    tid = rt.addTensorPlanned2(d0, 1, off);             // [Cout] → [Cout,1]
                } else if (kind == Kind.FC_C()) {
                    tid = rt.addTensorPlanned2(d0, d1, off);            // G2：折叠常量，直接拷贝 [d0,d1]
                } else if (kind == Kind.FC_G()) {
                    // 阶段2：权重梯度——布局镜像基底权重（含 transB，保证 Update 对齐）
                    string base = stripGrad(nm);
                    int ii = initIdx(base);
                    if (ii >= 0 && wTrans_[ii] == 1) tid = rt.addTensorPlanned2(d0, d1, off);
                    else tid = rt.addTensorPlanned2(d1, d0, off);
                } else if (shR5_[si] == 1) {
                    tid = rt.addTensorPlanned5(d0, d1, d2, d3, shD4_[si], off);  // 3D：CNN 权重/激活 NCDHW
                } else if (shNHWC_[si] == 1) {
                    tid = rt.addTensorPlanned4(d0, d2, d3, d1, off);    // G2：NHWC 激活 [N,H,W,C] / 权重 [Cout,KH,KW,Cin]
                } else {
                    tid = rt.addTensorPlanned4(d0, d1, d2, d3, off);    // CNN 权重/激活 NCHW
                }
                if (tid < 0) return 0;
                tName_[tCount_] = nm;
                tId_[tCount_] = tid;
                tCount_ = tCount_ + 1;
                if (Console.getEnv("MYP_DUMP_TENSORS") == "1") {
                    int fd = __myp_io_fopen("/tmp/fine_tensors.txt", "ab");
                    if (fd >= 0) {
                        __myp_io_write("t" + Fmt.i(tid) + " name=" + nm +
                                       " d0=" + Fmt.i(d0) + " d1=" + Fmt.i(d1) + " d2=" + Fmt.i(d2) + " d3=" + Fmt.i(d3) +
                                       " d4=" + Fmt.i((shR5_[si] == 1) ? shD4_[si] : 1) + " r5=" + Fmt.i(shR5_[si]) + " off=" + Fmt.i(off) + "\n");
                        __myp_io_fclose();
                    }
                }
                si = si + 1;
            }
            // 2) 接线算子（按拓扑序：G2 转置节点先于消费者执行）
            int oi = 0;
            while (oi < planOrderCount_) {
                int ni = planOrder_[oi];
                string t = nType_[ni];
                if (t == "") { oi = oi + 1; continue; }   // 死节点跳过
                int a = tensorId(nIn0_[ni]);
                int out = tensorId(effectiveOut(ni));     // G2：融合节点用有效输出（nFusedOut_）
                if (a < 0 || out < 0) {
                    if (Console.getEnv("MYP_GR_DBG") == "1") {
                        Console.writeString("buildRuntime wire fail type=" + t + " in0=" + nIn0_[ni] + "(" + Fmt.i(a) + ") out=" + effectiveOut(ni) + "(" + Fmt.i(out) + ")");
                        Console.writeLine("");
                    }
                    return 0;
                }
                if (t == "Gemm") {
                    int w = tensorId(nIn1_[ni]);
                    int b = tensorId(nIn2_[ni]);
                    rt.addDense(a, w, b, out);
                } else if (t == "MatMul") {
                    int w = tensorId(nIn1_[ni]);
                    rt.addMatmul(a, w, out);
                } else if (t == "Add") {
                    int b = tensorId(nIn1_[ni]);
                    rt.addAdd(a, b, out, nRelu_[ni]);
                } else if (t == "Relu") {
                    rt.addRelu(a, out);
                } else if (t == "Sigmoid") {
                    rt.addSigmoid(a, out);
                } else if (t == "Softmax") {
                    rt.addSoftmax(a, out);
                } else if (t == "BwdDense") {
                    // 阶段2：dense 反向。dy=in0, x=in1, w=in2; out0=dx, out1=dw, out2=db
                    int dy = tensorId(nIn0_[ni]);
                    int x = tensorId(nIn1_[ni]);
                    int w = tensorId(nIn2_[ni]);
                    int dx = tensorId(nOut0_[ni]);
                    int dw = tensorId(nOut1_[ni]);
                    int db = -1;
                    if (nOut2_[ni] != "") db = tensorId(nOut2_[ni]);
                    rt.addBwdDense(dy, x, w, dx, dw, db);
                } else if (t == "BwdRelu") {
                    int dy = tensorId(nIn0_[ni]);
                    int x = tensorId(nIn1_[ni]);
                    int dx = tensorId(nOut0_[ni]);
                    rt.addBwdRelu(dy, x, dx);
                } else if (t == "BwdSigmoid") {
                    int dy = tensorId(nIn0_[ni]);
                    int y = tensorId(nIn1_[ni]);
                    int dx = tensorId(nOut0_[ni]);
                    rt.addBwdSigmoid(dy, y, dx);
                } else if (t == "BwdAdd") {
                    int dy = tensorId(nIn0_[ni]);
                    int da = tensorId(nOut0_[ni]);
                    int db = tensorId(nOut1_[ni]);
                    rt.addBwdAdd(dy, da, db);
                } else if (t == "BwdConv") {
                    // 阶段3：conv 反向。dy=in0, x=in1, w=in2; out0=dx, out1=dw, out2=db
                    int dy = tensorId(nIn0_[ni]);
                    int x = tensorId(nIn1_[ni]);
                    int w = tensorId(nIn2_[ni]);
                    int dx = tensorId(nOut0_[ni]);
                    int dw = tensorId(nOut1_[ni]);
                    int db = -1;
                    if (nOut2_[ni] != "") db = tensorId(nOut2_[ni]);
                    rt.addBwdConv(dy, x, w, dx, dw, db,
                                  nSH_[ni], nSW_[ni], nPT_[ni], nPL_[ni], nDH_[ni], nDW_[ni], nGroup_[ni]);
                } else if (t == "BwdMaxPool") {
                    // 阶段3：maxpool 反向。dy=in0, x=in1; out0=dx
                    int dy = tensorId(nIn0_[ni]);
                    int x = tensorId(nIn1_[ni]);
                    int dx = tensorId(nOut0_[ni]);
                    rt.addBwdMaxPool(dy, x, dx, nKH_[ni], nKW_[ni], nSH_[ni], nSW_[ni], nPT_[ni], nPL_[ni]);
                } else if (t == "BwdConv3D") {
                    // 阶段4：Conv3D 反向。dy=in0, x=in1, w=in2; out0=dx, out1=dw, out2=db
                    int dy = tensorId(nIn0_[ni]);
                    int x = tensorId(nIn1_[ni]);
                    int w = tensorId(nIn2_[ni]);
                    int dx = tensorId(nOut0_[ni]);
                    int dw = tensorId(nOut1_[ni]);
                    int db = -1;
                    if (nOut2_[ni] != "") db = tensorId(nOut2_[ni]);
                    rt.addBwdConv3D(dy, x, w, dx, dw, db,
                                    nSD3_[ni], nSH_[ni], nSW_[ni],
                                    nPDT_[ni], nPDB_[ni], nPT_[ni], nPB_[ni],
                                    nPL_[ni], nPR_[ni]);
                } else if (t == "BwdMaxPool3D") {
                    // 阶段4：MaxPool3D 反向。dy=in0, x=in1; out0=dx
                    int dy = tensorId(nIn0_[ni]);
                    int x = tensorId(nIn1_[ni]);
                    int dx = tensorId(nOut0_[ni]);
                    rt.addBwdMaxPool3D(dy, x, dx,
                                       nKD3_[ni], nKH_[ni], nKW_[ni],
                                       nSD3_[ni], nSH_[ni], nSW_[ni],
                                       nPDT_[ni], nPDB_[ni], nPT_[ni], nPB_[ni],
                                       nPL_[ni], nPR_[ni]);
                } else if (t == "BwdAvgPool3D") {
                    // 阶段4：AveragePool3D 反向。dy=in0, x=in1; out0=dx
                    int dy = tensorId(nIn0_[ni]);
                    int x = tensorId(nIn1_[ni]);
                    int dx = tensorId(nOut0_[ni]);
                    rt.addBwdAvgPool3D(dy, x, dx,
                                       nKD3_[ni], nKH_[ni], nKW_[ni],
                                       nSD3_[ni], nSH_[ni], nSW_[ni],
                                       nPDT_[ni], nPDB_[ni], nPT_[ni], nPB_[ni],
                                       nPL_[ni], nPR_[ni], nCip_[ni]);
                } else if (t == "BwdConvTranspose") {
                    // 阶段4d：ConvTranspose 反向。dy=in0, x=in1, w=in2; out0=dx, out1=dw, out2=db
                    int dy = tensorId(nIn0_[ni]);
                    int x = tensorId(nIn1_[ni]);
                    int w = tensorId(nIn2_[ni]);
                    int dx = tensorId(nOut0_[ni]);
                    int dw = tensorId(nOut1_[ni]);
                    int db = -1;
                    if (nOut2_[ni] != "") db = tensorId(nOut2_[ni]);
                    rt.addBwdConvTranspose(dy, x, w, dx, dw, db,
                                           nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni]);
                } else if (t == "BwdResize") {
                    // 阶段4d：Resize3D 反向。in0=dOut（输出梯度，形状=输出形状），
                    // in1=x（输入形状），out0=dIn；inD/inH/inW/outD/outH/outW 从形状推出。
                    int dOut = tensorId(nIn0_[ni]);
                    int x = tensorId(nIn1_[ni]);
                    int dIn = tensorId(nOut0_[ni]);
                    int is = shapeIdx(nIn1_[ni]);
                    int os = shapeIdx(nIn0_[ni]);
                    if (os >= 0 && is >= 0 && shR5_[os] == 1) {
                        int inD = shD2_[is]; int inH = shD3_[is]; int inW = shD4_[is];
                        int outD = shD2_[os]; int outH = shD3_[os]; int outW = shD4_[os];
                        rt.addBwdResize3d(dOut, dIn, inD, inH, inW, outD, outH, outW,
                                          nMode_[ni], nTransform_[ni]);
                    }
                } else if (t == "DiceLoss") {
                    // 阶段4d：Dice loss。in0=prob, in1=label; out0=dprob, out1=loss
                    // wMode：0=等权，1=逆频率加权（类不平衡，如真实肝脏前景 ~5%）
                    int p = tensorId(nIn0_[ni]);
                    int y = tensorId(nIn1_[ni]);
                    int dp = tensorId(nOut0_[ni]);
                    int lo = tensorId(nOut1_[ni]);
                    rt.addDiceLoss(p, y, dp, lo, diceWMode_);
                } else if (t == "BwdSoftmax") {
                    // 阶段4d：Softmax 反向。in0=dprob, in1=prob; out0=dlogit
                    int dp = tensorId(nIn0_[ni]);
                    int p = tensorId(nIn1_[ni]);
                    int dl = tensorId(nOut0_[ni]);
                    rt.addBwdSoftmax(dp, p, dl);
                } else if (t == "SoftmaxCE") {
                    // 阶段2：Softmax+CE。in0=logits, in1=label; out0=dlogits, out1=loss
                    int lg = tensorId(nIn0_[ni]);
                    int lb = tensorId(nIn1_[ni]);
                    int dl = tensorId(nOut0_[ni]);
                    int lo = tensorId(nOut1_[ni]);
                    rt.addSoftmaxCE(lg, lb, dl, lo);
                } else if (t == "Update") {
                    // 阶段2：参数更新。in0=权重, in1=梯度；输出=权重本身（原地）
                    int w = tensorId(nIn0_[ni]);
                    int g = tensorId(nIn1_[ni]);
                    rt.addUpdate(w, g);
                    rt.prepOptState(w);   // 阶段5e：优化器状态区（动量/Adam 的 m/v）预留于 arena 尾部
                } else if (t == "ReLU6") {
                    rt.addReLU6(a, out);
                } else if (t == "LeakyRelu") {
                    rt.addLeakyRelu(a, out, nAlphaInt_[ni], nHasAlpha_[ni]);
                } else if (t == "SiLU") {
                    rt.addSiLU(a, out);
                } else if (t == "HardSwish") {
                    rt.addHardSwish(a, out);
                } else if (t == "Clip") {
                    // G4：Clip（ReLU6=Clip(x,0,6)）；min/max 为标量输入（opset 11+）
                    rt.addClip(a, out, tensorId(nIn1_[ni]), tensorId(nIn2_[ni]));
                } else if (t == "ConvTranspose") {
                    // F8：ConvTranspose（group=1；kh/kw 由权重张量 tH_[w]/tW_[w] 给出）
                    int w = tensorId(nIn1_[ni]);
                    int b = tensorId(nIn2_[ni]);
                    rt.addConvTranspose(a, w, b, out, nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni],
                                        nOutPadH_[ni], nOutPadW_[ni], nGroup_[ni]);
                } else if (t == "Split") {
                    // F8：沿 axis 复制 [start, start+len) 到每个输出（一个输出一个 op）
                    int inS = shapeIdx(nIn0_[ni]);
                    int d0 = 1, d1 = 1, d2 = 1, d3 = 1;
                    if (inS >= 0) { d0 = shD0_[inS]; d1 = shD1_[inS]; d2 = shD2_[inS]; d3 = shD3_[inS]; }
                    int no = nOutN_[ni]; if (no < 1) no = 1;
                    int j = 0;
                    while (j < no && j < 4) {
                        string onm = (j == 0) ? nOut0_[ni] : ((j == 1) ? nOut1_[ni] : ((j == 2) ? nOut2_[ni] : nOut3_[ni]));
                        int o = tensorId(onm);
                        if (o >= 0) {
                            rt.addSplit(a, o, nAxis_[ni], nSplitSt_[ni * 4 + j], nSplitLn_[ni * 4 + j],
                                        d0, d1, d2, d3, 1);
                        }
                        j = j + 1;
                    }
                } else if (t == "Conv") {
                    int w = tensorId(nIn1_[ni]);
                    int b = tensorId(nIn2_[ni]);
                    if (nNHWC_[ni] == 1) {
                        // G2：NHWC 卷积（权重已在装载时转置 [Cout,KH,KW,Cin]）
                        if (nRelu_[ni] == 1) rt.addConvNHWCRelu(a, w, b, out, nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni], nDH_[ni], nDW_[ni], nGroup_[ni]);
                        else rt.addConvNHWC(a, w, b, out, nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni], nDH_[ni], nDW_[ni], nGroup_[ni]);
                    } else if (nRelu_[ni] == 1) {
                        // G1：融合 Conv+ReLU → 写 relu 输出（中间张量不写回）
                        rt.addConvRelu(a, w, b, out, nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni], nDH_[ni], nDW_[ni], nGroup_[ni]);
                    } else {
                        // G3：BN 折叠的普通卷积（可能无 relu，勿套 relu）
                        rt.addConv(a, w, b, out, nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni], nDH_[ni], nDW_[ni], nGroup_[ni]);
                    }
                } else if (t == "Conv3D") {
                    // 3D：kd/kh/kw 由权重张量 tD_[w]/tH_[w]/tW_[w] 给出
                    int w = tensorId(nIn1_[ni]);
                    int b = tensorId(nIn2_[ni]);
                    int sd = nSD3_[ni]; if (sd <= 0) sd = 1;
                    int sh_ = nSH_[ni]; if (sh_ <= 0) sh_ = 1;
                    int sw_ = nSW_[ni]; if (sw_ <= 0) sw_ = 1;
                    int dd = nDD3_[ni]; if (dd <= 0) dd = 1;
                    int dh = nDH_[ni]; if (dh <= 0) dh = 1;
                    int dw = nDW_[ni]; if (dw <= 0) dw = 1;
                    rt.addConv3D(a, w, b, out, sd, sh_, sw_,
                        nPDT_[ni], nPDB_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni],
                        dd, dh, dw, nGroup_[ni]);
                } else if (t == "MaxPool3D") {
                    int sd = nSD3_[ni]; if (sd <= 0) sd = 1;
                    int sh_ = nSH_[ni]; if (sh_ <= 0) sh_ = 1;
                    int sw_ = nSW_[ni]; if (sw_ <= 0) sw_ = 1;
                    int kd = nKD3_[ni]; if (kd <= 0) kd = 1;
                    int kh = nKH_[ni]; if (kh <= 0) kh = 1;
                    int kw = nKW_[ni]; if (kw <= 0) kw = 1;
                    rt.addMaxPool3D(a, out, kd, kh, kw, sd, sh_, sw_,
                        nPDT_[ni], nPDB_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni]);
                } else if (t == "AveragePool3D") {
                    int sd = nSD3_[ni]; if (sd <= 0) sd = 1;
                    int sh_ = nSH_[ni]; if (sh_ <= 0) sh_ = 1;
                    int sw_ = nSW_[ni]; if (sw_ <= 0) sw_ = 1;
                    int kd = nKD3_[ni]; if (kd <= 0) kd = 1;
                    int kh = nKH_[ni]; if (kh <= 0) kh = 1;
                    int kw = nKW_[ni]; if (kw <= 0) kw = 1;
                    rt.addAvgPool3D(a, out, kd, kh, kw, sd, sh_, sw_,
                        nPDT_[ni], nPDB_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni], nCip_[ni]);
                } else if (t == "MaxPool") {
                    if (nNHWC_[ni] == 1) rt.addMaxPoolNHWC(a, out, nKH_[ni], nKW_[ni], nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni]);
                    else rt.addMaxPool(a, out, nKH_[ni], nKW_[ni], nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni]);
                } else if (t == "AveragePool") {
                    // F8：AveragePool（cip = count_include_pad）
                    if (nNHWC_[ni] == 1) rt.addAvgPoolNHWC(a, out, nKH_[ni], nKW_[ni], nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni], nCip_[ni]);
                    else rt.addAvgPool(a, out, nKH_[ni], nKW_[ni], nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni], nCip_[ni]);
                } else if (t == "Pad") {
                    // F8：Pad（NHWC 时 pads 从逻辑 [N,C,H,W] 重排为 [N,H,W,C]）
                    int is5 = 0;
                    int pin = shapeIdx(nIn0_[ni]);
                    if (pin >= 0 && shR5_[pin] == 1) is5 = 1;
                    if (is5 == 1) {
                        // 3D：10 个 pad（N,C,D,H,W 各 begin/end）
                        rt.addPad3D(a, out,
                            nPadB5_[ni * 5 + 0], nPadE5_[ni * 5 + 0], nPadB5_[ni * 5 + 1], nPadE5_[ni * 5 + 1], nPadB5_[ni * 5 + 2],
                            nPadE5_[ni * 5 + 2], nPadB5_[ni * 5 + 3], nPadE5_[ni * 5 + 3], nPadB5_[ni * 5 + 4], nPadE5_[ni * 5 + 4],
                            nPadMode_[ni], nPadCval_[ni]);
                    } else if (nNHWC_[ni] == 1) rt.addPadNHWC(a, out,
                        nPadB_[ni * 4 + 0], nPadB_[ni * 4 + 2], nPadB_[ni * 4 + 3], nPadB_[ni * 4 + 1],
                        nPadE_[ni * 4 + 0], nPadE_[ni * 4 + 2], nPadE_[ni * 4 + 3], nPadE_[ni * 4 + 1],
                        nPadMode_[ni], nPadCval_[ni]);
                    else rt.addPad(a, out,
                        nPadB_[ni * 4 + 0], nPadB_[ni * 4 + 1], nPadB_[ni * 4 + 2], nPadB_[ni * 4 + 3],
                        nPadE_[ni * 4 + 0], nPadE_[ni * 4 + 1], nPadE_[ni * 4 + 2], nPadE_[ni * 4 + 3],
                        nPadMode_[ni], nPadCval_[ni]);
                } else if (t == "GlobalAveragePool") {
                    // G2：out 已是融合后的 flatten 输出（fuseGapFlatten 改写）；GAP 布局无关
                    if (nNHWC_[ni] == 1) rt.addGAPoolNHWC(a, out);
                    else rt.addGAPool(a, out);
                } else if (t == "NCHW2NHWC") {
                    rt.addTransposeNCHW2NHWC(a, out);   // G2：布局变换转置节点
                } else if (t == "Flatten") {
                    rt.addFlatten(a, out);
                } else if (t == "BatchNormalization") {
                    // G3：独立 BN（未与 Conv 融合）；eps 位型传给 runtime 在分发时解析
                    int sT = tensorId(nIn1_[ni]);
                    int bT = tensorId(nIn2_[ni]);
                    int mT = tensorId(nIn3_[ni]);
                    int vT = tensorId(nIn4_[ni]);
                    if (sT < 0 || bT < 0 || mT < 0 || vT < 0) return 0;
                    if (nNHWC_[ni] == 1) rt.addBatchNormNHWC(a, out, sT, bT, mT, vT, nEpsInt_[ni], nHasEps_[ni]);
                    else rt.addBatchNorm(a, out, sT, bT, mT, vT, nEpsInt_[ni], nHasEps_[ni]);
                } else if (t == "Reshape") {
                    // F8：连续拷贝（输出形状已由 inferShapes 按 shape 初始器登记）
                    rt.addReshape(a, out);
                } else if (t == "Concat") {
                    // F8：2-3 输入沿 axis 拼接（维度 = 输出形状表；轴长 = 各输入沿 axis）
                    int b = tensorId(nIn1_[ni]);
                    int c = tensorId(nIn2_[ni]);
                    int nIn = 2;
                    if (c >= 0) nIn = 3;
                    int axis = nAxis_[ni];
                    if (axis < 0) axis = 0;
                    int os = shapeIdx(effectiveOut(ni));
                    int is5 = 0;
                    int s0in = shapeIdx(nIn0_[ni]);
                    if (s0in >= 0 && shR5_[s0in] == 1) is5 = 1;
                    int od0 = shD0_[os], od1 = shD1_[os], od2 = shD2_[os], od3 = shD3_[os];
                    if (is5 == 1) od3 = shD3_[os] * shD4_[os];   // 4D 视图 [N,C,D,HW]：od3 折叠 H*W
                    int ax0 = 0, ax1 = 0, ax2 = 0;
                    int s0 = shapeIdx(nIn0_[ni]);
                    if (s0 >= 0) ax0 = (axis == 0) ? shD0_[s0] : ((axis == 1) ? shD1_[s0] : ((axis == 2) ? shD2_[s0] : shD3_[s0]));
                    int s1 = shapeIdx(nIn1_[ni]);
                    if (s1 >= 0) ax1 = (axis == 0) ? shD0_[s1] : ((axis == 1) ? shD1_[s1] : ((axis == 2) ? shD2_[s1] : shD3_[s1]));
                    int s2 = shapeIdx(nIn2_[ni]);
                    if (s2 >= 0) ax2 = (axis == 0) ? shD0_[s2] : ((axis == 1) ? shD1_[s2] : ((axis == 2) ? shD2_[s2] : shD3_[s2]));
                    rt.addConcat(a, b, c, out, axis, nIn, od0, od1, od2, od3, ax0, ax1, ax2);
                } else if (t == "BwdConcat") {
                    // Concat 反向（U-Net 跳跃连接）。dy=in0, x0/x1/x2=in1/2/3（查轴长）;
                    // out0/1/2 = 各输入梯度。多消费者冲突路输出带 "_own" 后缀 →
                    // strip 后累加进主梯度（bwdConcat 内核为累加语义，且 BwdConcat
                    // 已依赖主 producer → 主先清零写、本算子后累加）。
                    int dy = tensorId(nIn0_[ni]);
                    string dxn0 = nOut0_[ni];
                    if (Str.len(dxn0) >= 5 && Str.substring(dxn0, Str.len(dxn0) - 4, Str.len(dxn0)) == "_own") dxn0 = Str.substring(dxn0, 0, Str.len(dxn0) - 4);
                    int dx0 = tensorId(dxn0);
                    string dxn1 = nOut1_[ni];
                    if (Str.len(dxn1) >= 5 && Str.substring(dxn1, Str.len(dxn1) - 4, Str.len(dxn1)) == "_own") dxn1 = Str.substring(dxn1, 0, Str.len(dxn1) - 4);
                    int dx1 = tensorId(dxn1);
                    string dxn2 = nOut2_[ni];
                    if (Str.len(dxn2) >= 5 && Str.substring(dxn2, Str.len(dxn2) - 4, Str.len(dxn2)) == "_own") dxn2 = Str.substring(dxn2, 0, Str.len(dxn2) - 4);
                    int dx2 = tensorId(dxn2);
                    int nIn = 2;
                    if (dx2 >= 0) nIn = 3;
                    int axis = nAxis_[ni];
                    if (axis < 0) axis = 0;
                    int os = shapeIdx(nIn0_[ni]);   // dy 形状 = 原 Concat 输出
                    int is5 = 0;
                    int od0 = 1, od1 = 1, od2 = 1, od3 = 1;
                    if (os >= 0) {
                        od0 = shD0_[os]; od1 = shD1_[os]; od2 = shD2_[os]; od3 = shD3_[os];
                        if (shR5_[os] == 1) od3 = shD3_[os] * shD4_[os];
                    }
                    int ax0 = 0, ax1 = 0, ax2 = 0;
                    int s0 = shapeIdx(nIn1_[ni]);
                    if (s0 >= 0) ax0 = (axis == 0) ? shD0_[s0] : ((axis == 1) ? shD1_[s0] : ((axis == 2) ? shD2_[s0] : shD3_[s0]));
                    int s1 = shapeIdx(nIn2_[ni]);
                    if (s1 >= 0) ax1 = (axis == 0) ? shD0_[s1] : ((axis == 1) ? shD1_[s1] : ((axis == 2) ? shD2_[s1] : shD3_[s1]));
                    int s2 = shapeIdx(nIn3_[ni]);
                    if (nIn >= 3 && s2 >= 0) ax2 = (axis == 0) ? shD0_[s2] : ((axis == 1) ? shD1_[s2] : ((axis == 2) ? shD2_[s2] : shD3_[s2]));
                    rt.addBwdConcat(dy, dx0, dx1, dx2, axis, nIn, od0, od1, od2, od3, ax0, ax1, ax2);
                } else if (t == "GradAcc") {
                    // 多消费者梯度累加：g = g_a + g_b（纯前向 Add，输出 g）
                    rt.addAdd(tensorId(nIn0_[ni]), tensorId(nIn1_[ni]), tensorId(nOut0_[ni]), 0);
                } else if (t == "Transpose") {
                    // F8：perm 转置（输入维度 = 输入形状表）
                    int p0 = nP0_[ni], p1 = nP1_[ni], p2 = nP2_[ni], p3 = nP3_[ni];
                    int pc = nPc_[ni];
                    if (pc == 0) { p0 = 3; p1 = 2; p2 = 1; p3 = 0; }
                    int is = shapeIdx(nIn0_[ni]);
                    int id0 = shD0_[is], id1 = shD1_[is], id2 = shD2_[is], id3 = shD3_[is];
                    rt.addTranspose(a, out, p0, p1, p2, p3, pc, id0, id1, id2, id3);
                } else if (t == "Slice") {
                    // F8：切片（调整后 start/step/axis 存 nSl*_；维度 = 形状表）
                    int cnt = nSlN_[ni];
                    if (cnt < 1) return 0;
                    int is = shapeIdx(nIn0_[ni]);
                    int id0 = shD0_[is], id1 = shD1_[is], id2 = shD2_[is], id3 = shD3_[is];
                    int os = shapeIdx(effectiveOut(ni));
                    int od0 = shD0_[os], od1 = shD1_[os], od2 = shD2_[os], od3 = shD3_[os];
                    int ax0 = nSlAx_[ni * 4 + 0], st0 = nSlSt_[ni * 4 + 0], sp0 = nSlSp_[ni * 4 + 0];
                    int ax1 = nSlAx_[ni * 4 + 1], st1 = nSlSt_[ni * 4 + 1], sp1 = nSlSp_[ni * 4 + 1];
                    int ax2 = nSlAx_[ni * 4 + 2], st2 = nSlSt_[ni * 4 + 2], sp2 = nSlSp_[ni * 4 + 2];
                    int ax3 = nSlAx_[ni * 4 + 3], st3 = nSlSt_[ni * 4 + 3], sp3 = nSlSp_[ni * 4 + 3];
                    rt.addSlice(a, out, cnt, id0, id1, id2, id3, od0, od1, od2, od3,
                                ax0, st0, sp0, ax1, st1, sp1, ax2, st2, sp2, ax3, st3, sp3);
                } else if (t == "Sub") {
                    int b = tensorId(nIn1_[ni]);
                    int is = shapeIdx(nIn0_[ni]);
                    int ss = shD2_[is] * shD3_[is];
                    if (shR5_[is] == 1) ss = shD2_[is] * shD3_[is] * shD4_[is];   // 3D：D*H*W
                    rt.addSub(a, b, out, shD1_[is], ss);
                } else if (t == "Div") {
                    int b = tensorId(nIn1_[ni]);
                    int is = shapeIdx(nIn0_[ni]);
                    int ss = shD2_[is] * shD3_[is];
                    if (shR5_[is] == 1) ss = shD2_[is] * shD3_[is] * shD4_[is];
                    rt.addDiv(a, b, out, shD1_[is], ss);
                } else if (t == "Mul") {
                    int b = tensorId(nIn1_[ni]);
                    int is = shapeIdx(nIn0_[ni]);
                    int ss = shD2_[is] * shD3_[is];
                    if (shR5_[is] == 1) ss = shD2_[is] * shD3_[is] * shD4_[is];
                    rt.addMul(a, b, out, shD1_[is], ss);
                } else if (t == "Sqrt") {
                    rt.addSqrt(a, out);
                } else if (t == "ReduceMean") {
                    int mode = nRedMode_[ni];
                    int is = shapeIdx(nIn0_[ni]);
                    int N = shD0_[is], C = shD1_[is];
                    int S = shD2_[is] * shD3_[is];
                    if (shR5_[is] == 1) S = shD2_[is] * shD3_[is] * shD4_[is];   // 3D：D*H*W
                    int total = N * C * S;
                    rt.addReduceMean(a, out, mode, N, C, S, total, nKeep_[ni]);
                } else if (t == "InstanceNormalization") {
                    int sT = tensorId(nIn1_[ni]);
                    int bT = tensorId(nIn2_[ni]);
                    if (sT < 0 || bT < 0) return 0;
                    int is = shapeIdx(nIn0_[ni]);
                    int N = shD0_[is], C = shD1_[is];
                    int S = shD2_[is] * shD3_[is];
                    if (shR5_[is] == 1) S = shD2_[is] * shD3_[is] * shD4_[is];   // 3D：D*H*W
                    rt.addInstanceNorm(a, sT, bT, out, N, C, S, nEpsInt_[ni], nHasEps_[ni], nRelu_[ni]);
                } else if (t == "Resize" || t == "Upsample") {
                    int is = shapeIdx(nIn0_[ni]);
                    int os = shapeIdx(effectiveOut(ni));
                    int N = shD0_[is], C = shD1_[is], inH = shD2_[is], inW = shD3_[is];
                    int outH = shD2_[os], outW = shD3_[os];
                    if (shR5_[is] == 1) {
                        // 3D：Resize3D（trilinear/nearest）——5D NCDHW，
                        // D=shD2, H=shD3, W=shD4（此前误用 4D 的 shD2/shD3，
                        // 立方体张量各维相等才未暴露；非立方输入（如 1×2×11）
                        // 会读错尺寸导致输出全错）
                        int inD = shD2_[is], outD = shD2_[os];
                        int inH3 = shD3_[is], inW3 = shD4_[is];
                        int outH3 = shD3_[os], outW3 = shD4_[os];
                        rt.addResize3d(a, out, inD, inH3, inW3, outD, outH3, outW3, nMode_[ni], nTransform_[ni]);
                    } else {
                        rt.addResize2d(a, out, N, C, inH, inW, outH, outW, nMode_[ni], nTransform_[ni]);
                    }
                } else {
                    if (Console.getEnv("MYP_GR_DBG") == "1") {
                        Console.writeString("buildRuntime unsupported node type=" + t);
                        Console.writeLine("");
                    }
                    return 0;
                }
                oi = oi + 1;
            }
            // 3) 写权重
            int wi = 0;
            while (wi < wCount_) {
                int tid = tensorId(wName_[wi]);
                if (tid < 0) { wi = wi + 1; continue; }
                writeWeight(rt, wi, tid);
                wi = wi + 1;
            }
            return 1;
        }
        void writeWeight(InferenceRuntime rt, int wi, int tid) {
            int off = wOff_[wi];
            int count = wLen_[wi] / 4;
            int j = 0;
            if (wRole_[wi] == 3) {
                // CNN 偏置：直接拷贝（G3：BN 折叠则应用偏置公式；G4：无原偏置卷积由 BN 合成）
                j = 0;
                while (j < count) {
                    double b = 0.0;
                    if (wBNOnly_[wi] == 0) b = f32At(off + j * 4);
                    double v = b;
                    if (wBN_[wi] == 1) v = bnFoldBias(wi, j, b);
                    rt.setFlat(tid, j, v);
                    j = j + 1;
                }
            } else if (wRole_[wi] == 2 && wNHWC_[wi] == 1) {
                // G2：CNN 权重 NHWC 转置 [Cout,Cin,KH,KW] → [Cout,KH,KW,Cin]
                // G3：BN 折叠按输出通道缩放（与转置可交换）
                int s = shapeIdx(wName_[wi]);
                int Cout = shD0_[s]; int Cin = shD1_[s]; int KH = shD2_[s]; int KW = shD3_[s];
                int co = 0;
                while (co < Cout) {
                    int ci = 0;
                    while (ci < Cin) {
                        int kh = 0;
                        while (kh < KH) {
                            int kw = 0;
                            while (kw < KW) {
                                int src = ((co * Cin + ci) * KH + kh) * KW + kw;
                                int dst = ((co * KH + kh) * KW + kw) * Cin + ci;
                                double v = f32At(off + src * 4);
                                if (wBN_[wi] == 1) v = v * bnInvStd(wi, co);
                                rt.setFlat(tid, dst, v);
                                kw = kw + 1;
                            }
                            kh = kh + 1;
                        }
                        ci = ci + 1;
                    }
                    co = co + 1;
                }
            } else if (wRole_[wi] == 2 || wRole_[wi] == 1 || wRole_[wi] == 4) {
                // CNN 权重 NCHW / FC 偏置 / G2 折叠常量：直接拷贝
                // G3：CNN 权重 BN 折叠按输出通道缩放
                j = 0;
                while (j < count) {
                    double v = f32At(off + j * 4);
                    if (wRole_[wi] == 2 && wBN_[wi] == 1) {
                        int perOc = count / wRows_[wi];
                        if (perOc < 1) perOc = 1;
                        v = v * bnInvStd(wi, j / perOc);
                    }
                    rt.setFlat(tid, j, v);
                    j = j + 1;
                }
            } else if (wRole_[wi] == 5) {
                // P3：计算 float 常量（Cast int64→float 折叠结果，值存 cF32_）
                j = 0;
                while (j < count) {
                    rt.setFlat(tid, j, cF32_[wi * 32 + j]);
                    j = j + 1;
                }
            } else if (wTrans_[wi] == 1) {
                // FC 权重 transB=1：wire=[N,K] 直接拷贝
                j = 0;
                while (j < count) { rt.setFlat(tid, j, f32At(off + j * 4)); j = j + 1; }
            } else {
                // FC 权重 transB=0：wire=[K,N] 转置为 [N,K]
                int rows = wRows_[wi]; int cols = wCols_[wi];
                int k = 0;
                while (k < rows) {
                    int n = 0;
                    while (n < cols) {
                        rt.setFlat(tid, n * rows + k, f32At(off + (k * cols + n) * 4));
                        n = n + 1;
                    }
                    k = k + 1;
                }
            }
        }
        double f32At(int byteOff) {
            int b0 = file_[byteOff];
            int b1 = file_[byteOff + 1];
            int b2 = file_[byteOff + 2];
            int b3 = file_[byteOff + 3];
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }

        // F8：读 int64 初始器值（Reshape 的 shape / Slice 的 starts/ends/axes/steps 等）。
        // 支持 raw_data（8 字节小端，wKind_==1 且 wType_==7）与 int64_data
        // （packed varint，wKind_==3）。返回读取个数（<=maxn）；值写入 i64TmpL_（全 int64 long）。
        int readI64Init(string name, int maxn) {
            int wi = initIdx(name);
            if (wi < 0) return 0;
            int cnt = 0;
            if (wKind_[wi] == 1) {
                int j = 0;
                while (j < wLen_[wi] / 8 && cnt < maxn) {
                    long v = 0L;
                    int k = 0;
                    while (k < 8) {
                        int b = file_[wOff_[wi] + j * 8 + k];
                        v = v | (long(b) << (k * 8));
                        k = k + 1;
                    }
                    i64TmpL_[cnt] = v;
                    cnt = cnt + 1;
                    j = j + 1;
                }
            } else if (wKind_[wi] == 3) {
                int end = wOff_[wi] + wLen_[wi];
                pb_.seek(wOff_[wi]);
                while (pb_.pos() < end && cnt < maxn) {
                    long v = pb_.readVarint64();
                    i64TmpL_[cnt] = v;
                    cnt = cnt + 1;
                }
            }
            return cnt;
        }

        // ---- P3：int64 常量解释器（Shape/Slice/Concat/Cast/Unsqueeze/Gather/ReduceProd 折叠）----
        // 按张量名保存已知 int64 常量值（i64v_ 池）。
        int i64Find(string name) {
            int i = 0;
            while (i < i64Cnt_) {
                if (i64Name_[i] == name) return i;
                i = i + 1;
            }
            return -1;
        }
        int i64Count(string name) {
            int s = i64Find(name);
            if (s < 0) return 0;
            return i64n_[s];
        }
        long i64Get(string name, int k) {
            int s = i64Find(name);
            if (s < 0) return 0L;
            if (k >= i64n_[s]) return 0L;
            return i64v_[i64st_[s] + k];
        }
        // 注册 int64 常量；已存在则更新（幂等）
        void i64Reg(string name, long[] v, int n) {
            if (n < 0) n = 0;
            int s = i64Find(name);
            if (s < 0) {
                if (i64Cnt_ >= 256) return;
                s = i64Cnt_;
                i64Name_[s] = name;
                i64st_[s] = i64stTop_;
                i64Cnt_ = i64Cnt_ + 1;
            }
            i64n_[s] = n;
            int k = 0;
            while (k < n && i64st_[s] + k < 4096) {
                i64v_[i64st_[s] + k] = v[k];
                k = k + 1;
            }
            if (i64st_[s] + n > i64stTop_) i64stTop_ = i64st_[s] + n;
        }
        // 从初始器（int64）注册
        void i64RegInit(string name, string initName, int maxn) {
            int c = readI64Init(initName, maxn);
            if (c > 0) i64Reg(name, i64TmpL_, c);
        }
        // 从 Constant 节点 tensor（dtype int64）读取并注册
        void i64RegConstant(string name, int off, int len) {
            int end = off + len;
            pb_.seek(off);
            int[] dims = new int[8];
            int dimCount = 0;
            int dt = 0;
            int rawKind = 0; int rawOff = 0; int rawLen = 0;
            long[] vals = new long[64];
            int vc = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) { if (dimCount < 8) { dims[dimCount] = pb_.readVarint(); dimCount = dimCount + 1; } }
                else if (f == 2) { dt = pb_.readVarint(); }
                else if (f == 9) { rawKind = 1; rawLen = pb_.readLen(); rawOff = pb_.payloadOff(); pb_.skipBytes(rawLen); }
                else if (f == 7) { if (vc < 64) { vals[vc] = pb_.readVarint64(); vc = vc + 1; } }
                else { pb_.skipField(); }
            }
            if (dt == 7) {
                if (rawKind == 1) {
                    int j = 0;
                    while (j < rawLen / 8 && vc < 64) {
                        long v = 0L;
                        int k = 0;
                        while (k < 8) { v = v | (long(file_[rawOff + j * 8 + k]) << (k * 8)); k = k + 1; }
                        vals[vc] = v; vc = vc + 1;
                        j = j + 1;
                    }
                }
                i64Reg(name, vals, vc);
            }
        }
        // Cast(int64→float) 输出：注册为运行时 float 常量（wRole_=5，值存 cF32_）
        void regComputedF32(string name, long[] v, int n) {
            if (n <= 0) return;
            int wi = initIdx(name);
            if (wi < 0) {
                if (wCount_ >= 256) return;
                wi = wCount_;
                wName_[wi] = name;
                wRows_[wi] = n;
                wCols_[wi] = 1;
                wType_[wi] = 1;
                wKind_[wi] = 5;      // 计算常量（非 file_ 存储）
                wOff_[wi] = -1;
                wLen_[wi] = n * 4;
                wTrans_[wi] = 0;
                wBias_[wi] = 0;
                wRole_[wi] = 5;
                wNHWC_[wi] = 0;
                wBN_[wi] = 0;
                wBNOnly_[wi] = 0;
                wCount_ = wCount_ + 1;
            }
            int k = 0;
            while (k < n) {
                cF32_[wi * 32 + k] = double(v[k]);
                k = k + 1;
            }
            // 形状：标量 [1] 或 [n]；作为运行时 float 常量（FC_C）参与后续 float 运算
            addShapeD(name, singleDim(n), 1);
            setShapeKind(name, Kind.FC_C());
        }
        int[] singleDim(int n) { int[] d = new int[1]; d[0] = n; return d; }

    property:
        int[] file_;
        int fileLen_;
        PbReader pb_;
        long[512] i64TmpL_;   // F8：readI64Init 暂存（全 int64 long）
        double[512] f32Tmp_;  // F8：readF32Init 暂存（float 转 double）
        long[4096] i64v_;     // P3：int64 常量池
        string[256] i64Name_; // P3：int64 常量张量名
        int[256] i64n_;       // P3：每个 int64 常量元素数
        int[256] i64st_;      // P3：每个 int64 常量在池中起始
        int i64Cnt_;          // P3：int64 常量个数
        int i64stTop_;        // P3：池顶
        double[8192] cF32_;   // P3：计算 float 常量 [wIdx*32+k]
        int[512] nRszD_;      // P3：Resize3D 折叠出 outD（sizes 常量链）
        int[512] nRszH_;      // P3：outH
        int[512] nRszW_;      // P3：outW
        long[512] slSt_;      // F8：Slice starts（long，临时）
        long[512] slEn_;      // F8：Slice ends
        long[512] slAx_;      // F8：Slice axes（可缺省）
        long[512] slSp_;      // F8：Slice steps（可缺省）
        int[512] nSlN_;       // F8：Slice 每节点切片轴数
        int[2048] nSlAx_;     // F8：Slice 每节点每轴索引 [node*4+k]
        int[2048] nSlSt_;     // F8：Slice 调整后 start
        int[2048] nSlSp_;     // F8：Slice step

        string[256] wName_;
        int[256] wRows_;
        int[256] wCols_;
        int[256] wType_;
        int[256] wKind_;
        int[256] wOff_;
        int[256] wLen_;
        int[256] wTrans_;
        int[256] wBias_;
        int[256] wRole_;
        int[256] wNHWC_;         // G2：1 = CNN 权重按 NHWC 转置装载
        int[256] wBN_;           // G3：1 = 该权重需 BN 折叠
        int[256] wBNNode_;       // G3：BN 节点下标（取 eps）
        int[256] wBNScale_;      // G3：BN scale 初始器下标
        int[256] wBNBias_;       // G3：BN bias 初始器下标
        int[256] wBNMean_;       // G3：BN mean 初始器下标
        int[256] wBNVar_;        // G3：BN var 初始器下标
        int[256] wBNOnly_;       // G4：1 = 由 BN 合成偏置（无原卷积偏置）
        int wCount_;

        string[512] nType_;
        string[512] nIn0_;
        string[512] nIn1_;
        string[512] nIn2_;
        string[512] nIn3_;   // G3：BatchNormalization 第 3 输入（mean）
        string[512] nIn4_;   // G3：BatchNormalization 第 4 输入（var）
        string[512] nOut0_;
        int[512] nTransB_;
        int[512] nAxis_;
        int[512] nSH_;
        int[512] nSW_;
        int[512] nPT_;
        int[512] nPB_;
        int[512] nPL_;
        int[512] nPR_;
        int[512] nDH_;
        int[512] nDW_;
        int[512] nGroup_;
        int[512] nKH_;
        int[512] nKW_;
        int[512] nP0_;          // F8：Transpose perm[0]
        int[512] nP1_;          // F8：Transpose perm[1]
        int[512] nP2_;          // F8：Transpose perm[2]
        int[512] nP3_;          // F8：Transpose perm[3]
        int[512] nPc_;          // F8：perm 元素个数
        int[512] nMode_;        // F8：Resize mode（0=nearest,1=linear）
        int[512] nTransform_;   // F8：Resize coord（0=align_corners,1=half_pixel）
        int[512] nUpSH_;        // F8：Upsample scales 高（floats 位型 → 需 F32 解码）
        int[512] nUpSW_;        // F8：Upsample scales 宽
        int[512] nKeep_;        // F8：ReduceMean keepdims（0/1）
        int[512] nRedMode_;     // F8：ReduceMean mode（0=全规约,1=空间规约）
        int[512] nAx0_;         // F8：ReduceMean axes[0]（属性形式）
        int[512] nAx1_;
        int[512] nAx2_;
        int[512] nAx3_;
        int[512] nAxN_;         // F8：axes 元素数
        int[512] nCip_;         // F8：AveragePool count_include_pad
        int[2048] nPadB_;       // F8：Pad 各轴 begin [node*4+k]（逻辑 [N,C,H,W]）
        int[2048] nPadE_;       // F8：Pad 各轴 end
        int[2560] nPadB5_;      // 3D：Pad 各轴 begin [node*5+k]（逻辑 [N,C,D,H,W]）
        int[2560] nPadE5_;      // 3D：Pad 各轴 end
        int[512] nPadMode_;     // F8：Pad mode（0=const,1=reflect,2=edge）
        int[512] nPadCval_;     // F8：Pad constant_value（float 位型）
        int[512] nOutPadH_;     // F8：ConvTranspose output_padding 高
        int[512] nOutPadW_;     // F8：ConvTranspose output_padding 宽
        string[512] nOut1_;     // F8：Split 第 2/3/4 输出
        string[512] nOut2_;
        string[512] nOut3_;
        int[512] nOutN_;        // F8：Split 输出个数
        int[512] nSplitN_;      // F8：Split split attr 尺寸个数
        int[512] nSp0_;         // F8：Split 各输出尺寸
        int[512] nSp1_;
        int[512] nSp2_;
        int[512] nSp3_;
        int[2048] nSplitSt_;    // F8：Split 各输出沿 axis 的 start [node*4+j]
        int[2048] nSplitLn_;    // F8：Split 各输出沿 axis 的 len
        int[512] nSD3_;         // 3D：Conv3D/MaxPool3D 等 strides[0]（sd）
        int[512] nDD3_;         // 3D：dilations[0]（dd）
        int[512] nKD3_;         // 3D：kernel_shape[0]（kd）
        int[512] nPDT_;         // 3D：pads D-begin
        int[512] nPDB_;         // 3D：pads D-end
        int[1536] nSt3_;        // 原始 strides[node*3+k]（2D/3D 通用捕获）
        int[3072] nPd3_;        // 原始 pads[node*6+k]
        int[1536] nDl3_;        // 原始 dilations[node*3+k]
        int[1536] nKk3_;        // 原始 kernel_shape[node*3+k]
        int[512] nCastTo_;      // P3：Cast 目标 dtype（1=float,7=int64）
        int[512] nEpsInt_;       // G3：BN epsilon 属性位型
        int[512] nHasEps_;       // G3：1 = 有 epsilon 属性
        int[512] nAlphaInt_;     // G4：LeakyRelu alpha 属性位型
        int[512] nHasAlpha_;     // G4：1 = 有 alpha 属性
        int[512] nFused_;        // G1：1 = Conv 已与 Relu 融合
        int[512] nFusedBy_;      // G1：被消掉的 Relu 记录取代它的 Conv 下标
        string[512] nFusedOut_;  // G1：fused Conv 的目标输出名（Relu 的输出）
        int[512] nRelu_;         // G4：1 = Conv 与 Relu 融合（G1 设置；与 BN 融合区分）
        int[512] nNHWC_;         // G2：1 = 节点在 NHWC 布局执行
        int[512] nConstVal_;     // G2：1 = Constant 节点有 value 属性
        int[512] nConstOff_;     // G2：Constant value TensorProto 偏移
        int[512] nConstLen_;     // G2：Constant value TensorProto 长度
        int nCount_;
        int fuseCount_;          // G1：Conv+ReLU 融合数
        int gapCount_;           // G2：GAP+Flatten 融合数
        int dceCount_;           // G2：死算子消除数
        int foldCount_;          // G2：常量折叠数
        int bnCount_;            // G3：Conv+BN 融合数
        int noReuse_;            // 调试：1 = 内存规划不复用区域（MYP_NO_REUSE=1）
        int doNHWC_;             // G2：布局变换开关（setLayoutNHWC）
        int lossMode_;           // 训练损失模式：0=SoftmaxCE，1=Dice（setLossMode）
        int diceWMode_;          // Dice 类权重：0=等权，1=逆频率（setDiceWMode）

        string[64] goName_;      // 图输出名（G1 融合安全）
        int goCount_;
        string[64] giName_;      // 图输入名（field 11，含真实输入与 initializer）
        int giCount_;

        string[512] shName_;
        int[512] shD0_;
        int[512] shD1_;
        int[512] shD2_;
        int[512] shD3_;
        int[512] shD4_;       // 3D：5D 张量的 D 维
        int[512] shR5_;       // 3D：1 = 5D 张量（N,C,D,H,W）
        int[512] shKind_;
        int[512] shNHWC_;        // G2：1 = 张量以 NHWC (N,H,W,C) 登记
        int[512] shDead_;        // G2：1 = 死张量（不分配/不登记）
        int sCount_;

        int[512] planOff_;
        int[512] planProducer_;
        int[512] planLastUse_;
        int[512] planOrder_;        // G2：拓扑排序后的活节点下标（buildRuntime/planMemory 用）
        int planOrderCount_;
        int[512] planROff_;
        int[512] planRSize_;
        int[512] planRLu_;
        int[512] planRPersist_;

        // P0 DefUseAnalysis：ValueId=shape table index；use 用紧凑链表（总边上限=5*512）。
        int[512] duProducer_;
        int[512] duUseCount_;
        int[512] duFirstUse_;
        int[2560] duUseNode_;
        int[2560] duUseSlot_;
        int[2560] duNextUse_;
        int duEdgeCount_;
        int duValid_;

        // IR-P1 AnalysisManager 状态；generation 随所有 graph mutation 递增。
        int analysisValid_;
        int analysisGeneration_;
        int duGeneration_;
        int topoGeneration_;
        int livenessGeneration_;
        int lastPassOk_;
        int lastPassChanged_;
        int lastPassPreserved_;

        string[512] tName_;
        int[512] tId_;
        int tCount_;
}
