// onnx_loader.myp — 纯 MYP ONNX 读取器（Path B）—— G5 重构后为「薄解析器」
// 运行时直接解析真实 .onnx（protobuf wire 格式），填充通用图优化器 Graph（graph.myp），
// 再由 graph.optimize(rt) 跑完整 pass 管线并构建到 InferenceRuntime。
// 图 IR / 图 pass / 内存规划 / buildRuntime 已移至 graph.myp（格式无关通用组件）。
//
// 支持算子：Gemm / MatMul / Add / Relu / Sigmoid / Softmax（全连接）+
//          Conv / MaxPool / GlobalAveragePool / Flatten / BatchNormalization / 激活。
import env;
import math;
import "./pb.myp";
import "./runtime.myp";
import "./graph.myp";

class OnnxLoader {
    action:
        @constructor OnnxLoader() { pb_ = new PbReader(); }

        // 从 .onnx 加载到运行时。成功返回 1，失败返回 0。
        int load(string path, InferenceRuntime rt) {
            if (readFile(path) == 0) return 0;
            if (fileLen_ <= 0) return 0;
            g_ = new Graph();
            g_.setFile(file_, fileLen_);
            g_.resetCounts();
            if (doNHWC_ == 1) g_.setLayoutNHWC(1);
            pb_.init(file_, fileLen_);
            if (parseModel() == 0) return 0;
            int k = 0;
            while (k < inpCnt_) {   // P3：输入形状注入（动态维度）
                g_.setShape(inpName_[k], inpD0_[k], inpD1_[k], inpD2_[k], inpD3_[k], inpD4_[k], inpR5_[k]);
                k = k + 1;
            }
            return g_.optimize(rt);
        }
        // P3：加载前声明输入形状（动态维度模型；rank5=1 表示 5D NCDHW）
        void setInputShape(string name, int d0, int d1, int d2, int d3, int d4, int rank5) {
            if (inpCnt_ >= 8) return;
            inpName_[inpCnt_] = name;
            inpD0_[inpCnt_] = d0; inpD1_[inpCnt_] = d1; inpD2_[inpCnt_] = d2;
            inpD3_[inpCnt_] = d3; inpD4_[inpCnt_] = d4; inpR5_[inpCnt_] = rank5;
            inpCnt_ = inpCnt_ + 1;
        }

        // 名称 → 张量 id（找不到返回 -1）—— 委托 Graph
        int tensorId(string name) { return g_.tensorId(name); }
        void setLayoutNHWC(int v) { doNHWC_ = v; }
        int doNHWC() { return doNHWC_; }
        int fuseCount() { return g_.fuseCount(); }
        int gapCount() { return g_.gapCount(); }
        int dceCount() { return g_.dceCount(); }
        int foldCount() { return g_.foldCount(); }
        int bnCount() { return g_.bnCount(); }
        int nodeCount() { return g_.nodeCount(); }

    function:
        // 读文件字节到 file_（增长型缓冲，返回 1=成功）
        int readFile(string path) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return 0;
            int cap = 65536;
            file_ = new int[cap];
            fileLen_ = 0;
            while (true) {
                int b = __myp_io_read_byte();
                if (b < 0) break;
                if (fileLen_ >= cap) {
                    int ncap = cap * 2;
                    int[] nb = new int[ncap];
                    int i = 0;
                    while (i < fileLen_) { nb[i] = file_[i]; i = i + 1; }
                    file_ = nb;
                    cap = ncap;
                }
                file_[fileLen_] = b;
                fileLen_ = fileLen_ + 1;
            }
            __myp_io_fclose();
            return 1;
        }

        // ---- 顶层 ModelProto：只取 graph（field 7）----
        int parseModel() {
            while (pb_.pos() < fileLen_) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 7) {
                    int l = pb_.readLen();
                    int po = pb_.payloadOff();
                    parseGraph(po, l);
                } else {
                    pb_.skipField();
                }
            }
            return 1;
        }

        int parseGraph(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    parseNode(po, l);
                } else if (f == 5) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    parseTensor(po, l);
                } else if (f == 11 || f == 12) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    string nm = parseValueInfo(po, l);
                    // 记录图输出名（G1 融合安全：被 fused 的中间张量不能是图输出）
                    if (f == 12) g_.addGraphOutput(nm);
                } else {
                    pb_.skipField();
                }
            }
            return 1;
        }

        // ---- NodeProto：用 Graph 构建 API 填充 ----
        int parseNode(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            int ni = g_.beginNode();
            int inIdx = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {           // input (string, repeated)
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    string s = pb_.readString(l);
                    if (inIdx < 5) g_.nodeIn(ni, inIdx, s);
                    inIdx = inIdx + 1;
                } else if (f == 2) {    // output
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    g_.nodeOut(ni, pb_.readString(l));
                } else if (f == 3) {    // name
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    pb_.skipBytes(l);
                } else if (f == 4) {    // op_type
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    g_.nodeType(ni, pb_.readString(l));
                } else if (f == 5) {    // attribute
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    parseAttr(po, l, ni);
                } else {
                    pb_.skipField();
                }
            }
            g_.endNode();
            return 1;
        }

        // ---- AttributeProto：name(1) / f(2) / int(3) / ints(8) / t(5) ----
        // 映射到 Graph.NodeField（格式无关字段码）
        int parseAttr(int off, int len, int ni) {
            int end = off + len;
            pb_.seek(off);
            string aname = "";
            int idx = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    aname = pb_.readString(l);
                } else if (f == 2) {    // f（float32 单值，如 BN epsilon / LeakyRelu alpha）
                    int bits = pb_.readU32();
                    if (aname == "epsilon") { g_.nodeInt(ni, NodeField.EPS_INT(), bits); g_.nodeInt(ni, NodeField.HAS_EPS(), 1); }
                    if (aname == "alpha") { g_.nodeInt(ni, NodeField.ALPHA_INT(), bits); g_.nodeInt(ni, NodeField.HAS_ALPHA(), 1); }
                } else if (f == 3) {    // int64 单值（transB / axis / group / to）
                    int v = pb_.readVarint();
                    if (aname == "transB") g_.nodeInt(ni, NodeField.TRANSB(), v);
                    if (aname == "axis") g_.nodeInt(ni, NodeField.AXIS(), v);
                    if (aname == "group") g_.nodeInt(ni, NodeField.GROUP(), v);
                    if (aname == "keepdims") g_.nodeInt(ni, NodeField.KEEP(), v);
                    if (aname == "count_include_pad") g_.nodeInt(ni, NodeField.CIP(), v);
                    if (aname == "to") g_.nodeInt(ni, NodeField.CAST_TO(), v);   // P3：Cast dtype
                } else if (f == 4) {    // string 单值（Resize mode / coord）
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    string sv = pb_.readString(l);
                    if (aname == "mode") {
                        if (sv == "linear" || sv == "bilinear") g_.nodeInt(ni, NodeField.MODE(), 1);
                        else g_.nodeInt(ni, NodeField.MODE(), 0);   // nearest
                        // F8：Pad mode（与 Resize 共用 "mode" 属性名；Resize 忽略 PADMODE，Pad 忽略 MODE）
                        if (sv == "constant") g_.nodeInt(ni, NodeField.PADMODE(), 0);
                        else if (sv == "reflect") g_.nodeInt(ni, NodeField.PADMODE(), 1);
                        else if (sv == "edge") g_.nodeInt(ni, NodeField.PADMODE(), 2);
                        else if (sv == "wrap") g_.nodeInt(ni, NodeField.PADMODE(), 3);
                    }
                    if (aname == "coordinate_transformation_mode") {
                        if (sv == "align_corners") g_.nodeInt(ni, NodeField.TRANSFORM(), 0);
                        else if (sv == "asymmetric") g_.nodeInt(ni, NodeField.TRANSFORM(), 2);
                        else g_.nodeInt(ni, NodeField.TRANSFORM(), 1);   // half_pixel 等
                    }
                } else if (f == 7) {    // floats（Upsample scales，packed 4-byte fixed32）
                    int l = pb_.readLen();
                    int fi = 0;
                    if (aname == "scales") {
                        while (fi < l / 4 && fi < 4) {
                            int bits = pb_.readU32();
                            if (fi == 0) g_.nodeInt(ni, NodeField.UPSH(), bits);
                            else if (fi == 1) g_.nodeInt(ni, NodeField.UPSW(), bits);
                            fi = fi + 1;
                        }
                    }
                    int rem = l - fi * 4;
                    if (rem > 0) pb_.skipBytes(rem);
                } else if (f == 8) {    // ints：非打包，每个 varint 一个字段
                    int v = pb_.readVarint();
                    string nt = g_.nodeTypeAt(ni);
                    int is3d = 0;
                    if (nt == "Conv3D" || nt == "MaxPool3D" || nt == "AveragePool3D" || nt == "ConvTranspose3D") is3d = 1;
                    if (aname == "strides") {
                        // 通用捕获原始 strides（normalize3D 按秩映射 2D/3D）
                        if (idx == 0) g_.nodeInt(ni, NodeField.ST0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.ST1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.ST2(), v);
                        if (is3d == 1) { if (idx == 0) g_.nodeInt(ni, NodeField.SD3(), v); else if (idx == 1) g_.nodeInt(ni, NodeField.SH(), v); else g_.nodeInt(ni, NodeField.SW(), v); }
                        else { if (idx == 0) g_.nodeInt(ni, NodeField.SH(), v); else g_.nodeInt(ni, NodeField.SW(), v); }
                    }
                    else if (aname == "pads") {
                        // 通用捕获原始 pads
                        if (idx == 0) g_.nodeInt(ni, NodeField.PD0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.PD1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.PD2(), v);
                        else if (idx == 3) g_.nodeInt(ni, NodeField.PD3(), v);
                        else if (idx == 4) g_.nodeInt(ni, NodeField.PD4(), v);
                        else if (idx == 5) g_.nodeInt(ni, NodeField.PD5(), v);
                        if (is3d == 1) {
                            // pads = [pdt,pdb,pt,pb,pl,pr]（3D）
                            if (idx == 0) g_.nodeInt(ni, NodeField.PDT(), v);
                            else if (idx == 1) g_.nodeInt(ni, NodeField.PDB(), v);
                            else if (idx == 2) g_.nodeInt(ni, NodeField.PT(), v);
                            else if (idx == 3) g_.nodeInt(ni, NodeField.PB(), v);
                            else if (idx == 4) g_.nodeInt(ni, NodeField.PL(), v);
                            else g_.nodeInt(ni, NodeField.PR(), v);
                        } else {
                            // pads = [top, left, bottom, right]（2D）
                            if (idx == 0) g_.nodeInt(ni, NodeField.PT(), v);
                            else if (idx == 1) g_.nodeInt(ni, NodeField.PL(), v);
                            else if (idx == 2) g_.nodeInt(ni, NodeField.PB(), v);
                            else g_.nodeInt(ni, NodeField.PR(), v);
                        }
                    }
                    else if (aname == "dilations") {
                        if (idx == 0) g_.nodeInt(ni, NodeField.DL0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.DL1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.DL2(), v);
                        if (is3d == 1) { if (idx == 0) g_.nodeInt(ni, NodeField.DD3(), v); else if (idx == 1) g_.nodeInt(ni, NodeField.DH(), v); else g_.nodeInt(ni, NodeField.DW(), v); } else { if (idx == 0) g_.nodeInt(ni, NodeField.DH(), v); else g_.nodeInt(ni, NodeField.DW(), v); }
                    }
                    else if (aname == "output_padding") { if (idx == 0) g_.nodeInt(ni, NodeField.OPH(), v); else g_.nodeInt(ni, NodeField.OPW(), v); }   // F8：ConvTranspose
                    else if (aname == "kernel_shape") {
                        if (idx == 0) g_.nodeInt(ni, NodeField.KK0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.KK1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.KK2(), v);
                        if (is3d == 1) { if (idx == 0) g_.nodeInt(ni, NodeField.KD3(), v); else if (idx == 1) g_.nodeInt(ni, NodeField.KH(), v); else g_.nodeInt(ni, NodeField.KW(), v); } else { if (idx == 0) g_.nodeInt(ni, NodeField.KH(), v); else g_.nodeInt(ni, NodeField.KW(), v); }
                    }
                    else if (aname == "perm") {   // F8：Transpose perm（ints 非打包）
                        if (idx == 0) g_.nodeInt(ni, NodeField.PERM0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.PERM1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.PERM2(), v);
                        else g_.nodeInt(ni, NodeField.PERM3(), v);
                        g_.nodeInt(ni, NodeField.PERM_N(), idx + 1);
                    }
                    else if (aname == "axes") {   // F8：ReduceMean axes（属性，opset<=17）
                        if (idx == 0) g_.nodeInt(ni, NodeField.AXES0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.AXES1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.AXES2(), v);
                        else g_.nodeInt(ni, NodeField.AXES3(), v);
                        g_.nodeInt(ni, NodeField.AXES_N(), idx + 1);
                    }
                    else if (aname == "split") {   // F8：Split 各输出尺寸（缺省 → 均分）
                        if (idx == 0) g_.nodeInt(ni, NodeField.SPLIT0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.SPLIT1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.SPLIT2(), v);
                        else g_.nodeInt(ni, NodeField.SPLIT3(), v);
                        g_.nodeInt(ni, NodeField.SPLIT_N(), idx + 1);
                    }
                    idx = idx + 1;
                } else if (f == 5) {    // t（Constant 节点的 value：TensorProto）记录字节，稍后折叠
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    g_.nodeInt(ni, NodeField.CONST_VAL(), 1);
                    g_.nodeInt(ni, NodeField.CONST_OFF(), po);
                    g_.nodeInt(ni, NodeField.CONST_LEN(), l);
                    pb_.skipBytes(l);
                } else {
                    pb_.skipField();
                }
            }
            return 1;
        }

        // ---- TensorProto（initializer）----
        int parseTensor(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            int[] dims = new int[8];
            int dimCount = 0;
            int dt = 0;
            int payloadKind = 0;
            int payloadOff = 0;
            int payloadLen = 0;
            string nm = "";
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {           // dims：非打包，每个维度一个 varint 字段
                    if (dimCount < 8) { dims[dimCount] = pb_.readVarint(); dimCount = dimCount + 1; }
                    else { long v = pb_.readVarint64(); }
                } else if (f == 2) {    // data_type
                    dt = pb_.readVarint();
                } else if (f == 4 || f == 9) {  // float_data(4) / raw_data(9)：packed f32 字节
                    payloadKind = 1;
                    payloadLen = pb_.readLen();
                    payloadOff = pb_.payloadOff();
                    pb_.skipBytes(payloadLen);  // 前进游标，跳过 payload（仅记录偏移，稍后从 file_ 读取）
                } else if (f == 7) {   // int64_data(7)：packed varint（F8：Reshape shape / Slice 参数）
                    payloadKind = 3;
                    payloadLen = pb_.readLen();
                    payloadOff = pb_.payloadOff();
                    pb_.skipBytes(payloadLen);
                } else if (f == 10) {   // double_data(10)：packed f64
                    payloadKind = 2;
                    payloadLen = pb_.readLen();
                    payloadOff = pb_.payloadOff();
                    pb_.skipBytes(payloadLen);
                } else if (f == 8) {    // name
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    nm = pb_.readString(l);
                } else {
                    pb_.skipField();
                }
            }
            // 登记 initializer（4D 维度；wRows/cols 保留为 [d0, prod(rest)] 视图）
            int rows = 1; int cols = 1;
            if (dimCount == 0) { rows = 1; cols = 1; }
            else if (dimCount == 1) { rows = dims[0]; cols = 1; }
            else if (dimCount == 2) { rows = dims[0]; cols = dims[1]; }
            else {
                rows = dims[0];
                cols = 1;
                int k = 1;
                while (k < dimCount) { cols = cols * dims[k]; k = k + 1; }
            }
            g_.addWeight(nm, rows, cols, dt, payloadKind, payloadOff, payloadLen);
            g_.addShapeD(nm, dims, dimCount);
            return 1;
        }

        // ---- ValueInfoProto（graph input/output）：取 name + 形状，返回名字 ----
        string parseValueInfo(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            string nm = "";
            int[] dims = new int[8];
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    nm = pb_.readString(l);
                } else if (f == 2) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    dimCount = parseTypeShape(po, l, dims);
                } else {
                    pb_.skipField();
                }
            }
            g_.addShapeD(nm, dims, dimCount);
            return nm;
        }

        // TypeProto → tensor_type → shape → dims（dim_param 视为 1）
        int parseTypeShape(int off, int len, int[] dims) {
            int end = off + len;
            pb_.seek(off);
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {   // tensor_type
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    dimCount = parseTensorType(po, l, dims);
                } else {
                    pb_.skipField();
                }
            }
            return dimCount;
        }

        int parseTensorType(int off, int len, int[] dims) {
            int end = off + len;
            pb_.seek(off);
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 2) {   // shape
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    dimCount = parseShape(po, l, dims);
                } else {
                    pb_.skipField();
                }
            }
            return dimCount;
        }

        int parseShape(int off, int len, int[] dims) {
            int end = off + len;
            pb_.seek(off);
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {   // dim
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    int v = parseDim(po, l);
                    if (dimCount < 8) { dims[dimCount] = v; dimCount = dimCount + 1; }
                } else {
                    pb_.skipField();
                }
            }
            return dimCount;
        }

        int parseDim(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            int v = 1;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) { v = pb_.readVarint(); }
                else if (f == 2) { int l = pb_.readLen(); int po = pb_.payloadOff(); pb_.skipBytes(l); v = 0; }   // dim_param：动态维 → 0
                else { pb_.skipField(); }
            }
            return v;   // 动态维（dim_param 或 dim_value=0）返回 0，供 inferShapes 覆盖
        }

    property:
        int[] file_;
        int fileLen_;
        PbReader pb_;
        Graph g_;
        int doNHWC_;
        string[8] inpName_;     // P3：输入形状注入表
        int[8] inpD0_;
        int[8] inpD1_;
        int[8] inpD2_;
        int[8] inpD3_;
        int[8] inpD4_;
        int[8] inpR5_;
        int inpCnt_;
}
