// onnx_loader.myp — 纯 MYP ONNX 读取器（Path B）—— G5 重构后为「薄解析器」
// 运行时直接解析真实 .onnx（protobuf wire 格式），填充通用图优化器 Graph（graph.myp），
// 再由 graph.optimize(rt) 跑完整 pass 管线并构建到 InferenceRuntime。
// 图 IR / 图 pass / 内存规划 / buildRuntime 已移至 graph.myp（格式无关通用组件）。
//
// 支持算子：Gemm / MatMul / Add / Relu / Sigmoid / Softmax（全连接）+
//          Conv / MaxPool / GlobalAveragePool / Flatten / BatchNormalization / 激活。
import env;
import math;
import fmt;
import fs;
import mmap;
import "./pb.myp";
import "./runtime.myp";
import "./graph.myp";
import "./graph_defs.myp";

class OnnxLoader {
    action:
        @constructor OnnxLoader() { pb_ = new PbReader(); }

        // 从 .onnx 加载到运行时。成功返回 1，失败返回 0。
        int load(string path, InferenceRuntime rt) {
            return loadCommon(path, rt, 0);
        }
        // 阶段2：从 .onnx 加载并构建「训练运行时」（前向+反向+更新节点）。
        int loadTrain(string path, InferenceRuntime rt) {
            return loadCommon(path, rt, 1);
        }
        // 阶段七：mmap 零拷贝加载（主模型文件 mmap；external data 追加区走 file_）。
        // 大模型（如 ResNet50 98MB）避免 readFile 的 int[] 全量拷贝（4x 内存膨胀）。
        int loadMmap(string path, InferenceRuntime rt) {
            return loadCommon(path, rt, 0);
        }
        int loadTrainMmap(string path, InferenceRuntime rt) {
            return loadCommon(path, rt, 1);
        }
        // 从 .onnx 加载到运行时。成功返回 1，失败返回 0。
        int loadCommon(string path, InferenceRuntime rt, int train) {
            if (mmapMode_ == 1) {
                if (openMmap(path) == 0) return 0;
            } else {
                if (readFile(path) == 0) return 0;
            }
            if (fileLen_ <= 0) return 0;
            g_ = new Graph();
            if (mmapMode_ == 1) g_.setFileMmap(mm_);
            else g_.setFile(file_, fileLen_);
            g_.resetCounts();
            badOp_ = 0;
            modelDir_ = "";
            Path p = new Path(path);
            string d = p.dirname();
            if (d != "" && d != ".") modelDir_ = d + "/";
            if (doNHWC_ == 1) g_.setLayoutNHWC(1);
            if (lossMode_ == 1) g_.setLossMode(1);
            if (diceWMode_ == 1) g_.setDiceWMode(1);
            if (mmapMode_ == 1) pb_.initMmap(mm_);
            else pb_.init(file_, fileLen_);
            if (parseModel() == 0) return 0;
            if (badOp_ == 1) { Console.writeLine("load aborted: unsupported op present"); return 0; }
            int k = 0;
            while (k < inpCnt_) {   // P3：输入形状注入（动态维度）
                g_.setShape(inpName_[k], inpD0_[k], inpD1_[k], inpD2_[k], inpD3_[k], inpD4_[k], inpR5_[k]);
                k = k + 1;
            }
            if (train == 1) return g_.optimizeTrain(rt);
            return g_.optimize(rt);
        }
        // P3：加载前声明输入形状（动态维度模型；rank5=1 表示 5D NCDHW）
        void setInputShape(string name, int d0, int d1, int d2, int d3, int d4, int rank5) {
            if (inpCnt_ >= 8) return;
            inpName_[inpCnt_] = name;
            inpD0_[inpCnt_] = d0; inpD1_[inpCnt_] = d1; inpD2_[inpCnt_] = d2;
            inpD3_[inpCnt_] = d3; inpD4_[inpCnt_] = d4; inpR5_[inpCnt_] = rank5;
            inpCnt_ = inpCnt_ + 1;
        }

        // 名称 → 张量 id（找不到返回 -1）—— 委托 Graph
        int tensorId(string name) { return g_.tensorId(name); }
        // G2：暴露 Graph 组合根（调试/探针）
        Graph graph() { return g_; }
        void setLayoutNHWC(int v) { doNHWC_ = v; }
        int doNHWC() { return doNHWC_; }
        // 训练损失模式：0=SoftmaxCE（默认），1=Dice（分割）
        void setLossMode(int v) { lossMode_ = v; }
        int lossMode() { return lossMode_; }
        // Dice 类权重：0=等权（默认），1=逆频率加权（类不平衡分割）
        void setDiceWMode(int v) { diceWMode_ = v; }
        int diceWMode() { return diceWMode_; }
        int fuseCount() { return g_.fuseCount(); }
        int fusedAddCount() { return g_.fusedAddCount(); }
        int gapCount() { return g_.gapCount(); }
        int dceCount() { return g_.dceCount(); }
        int foldCount() { return g_.foldCount(); }
        int bnCount() { return g_.bnCount(); }
        int nodeCount() { return g_.nodeCount(); }
        int graphInputCount() { return g_.graphInputCount(); }
        string graphInputName(int i) { return g_.graphInputName(i); }
        int graphOutputCount() { return g_.graphOutputCount(); }
        string graphOutputName(int i) { return g_.graphOutputName(i); }
        int isWeightName(string nm) { return g_.isWeightName(nm); }
        int shapeElementCount(string nm) { return g_.shapeElementCount(nm); }
        // 阶段七：ONNX opset/version 检查——模型 ir_version / 标准 opset 版本 / 域。
        int irVersion() { return irVersion_; }
        int opsetVersion() { return opsetVersion_; }
        string opsetDomain() { return opsetDomain_; }
        // 兼容性检查：opset 在支持范围 [9, 22] 内返回 1（提示性；解析本身不设上限）。
        int opsetSupported() {
            if (opsetVersion_ < 0) return 0;
            if (opsetVersion_ < 9) return 0;
            if (opsetVersion_ > 22) return 0;
            return 1;
        }

    function:
        // 阶段七：mmap 主模型文件（零拷贝）。file_ 预留为 external data 追加区。
        // 返回 1=成功（mmapMode_==1 生效，fileLen_=主文件字节数）。
        int openMmap(string path) {
            mm_ = new MmapFile();
            if (mm_.open(path) == 0) return 0;
            mmapMode_ = 1;
            mmapLen_ = int(mm_.size());
            fileLen_ = mmapLen_;
            cap_ = 65536;
            file_ = new int[cap_];
            return 1;
        }

        // 读文件字节到 file_（增长型缓冲，返回 1=成功）
        int readFile(string path) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return 0;
            cap_ = 65536;
            file_ = new int[cap_];
            fileLen_ = 0;
            while (true) {
                int b = __myp_io_read_byte();
                if (b < 0) break;
                if (fileLen_ >= cap_) {
                    int ncap = cap_ * 2;
                    int[] nb = new int[ncap];
                    int i = 0;
                    while (i < fileLen_) { nb[i] = file_[i]; i = i + 1; }
                    file_ = nb;
                    cap_ = ncap;
                }
                file_[fileLen_] = b;
                fileLen_ = fileLen_ + 1;
            }
            __myp_io_fclose();
            return 1;
        }

        // ---- 顶层 ModelProto：取 ir_version（field 1）、opset_import（field 8）、
        // graph（field 7）。阶段七：opset/version 检查——记录模型 opset 与 IR 版本，
        // 供加载方诊断/兼容性判断（getter：opsetVersion/irVersion/opsetDomain）。
        int parseModel() {
            irVersion_ = -1;
            opsetVersion_ = -1;
            opsetDomain_ = "";
            while (pb_.pos() < fileLen_) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    irVersion_ = int(pb_.readVarint64());   // ModelProto.ir_version (int64)
                } else if (f == 8) {
                    int l = pb_.readLen();
                    int po = pb_.payloadOff();
                    parseOpsetId(po, l);                    // OperatorSetIdProto：domain=1, version=2
                } else if (f == 7) {
                    int l = pb_.readLen();
                    int po = pb_.payloadOff();
                    parseGraph(po, l);
                } else {
                    pb_.skipField();
                }
            }
            return 1;
        }

        // OperatorSetIdProto：domain（field 1，string）/ version（field 2，int64）。
        // 标准 opset（domain=""）优先记录；仅当无标准 opset 时才记自定义 domain 的版本。
        int parseOpsetId(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            string dom = "";
            int ver = -1;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    dom = pb_.readString(l);
                } else if (f == 2) {
                    ver = int(pb_.readVarint64());
                } else {
                    pb_.skipField();
                }
            }
            if (ver <= 0) return 1;
            if (dom == "" && opsetVersion_ < 0) { opsetVersion_ = ver; opsetDomain_ = ""; }
            else if (dom != "" && opsetVersion_ < 0 && opsetDomain_ == "") { opsetVersion_ = ver; opsetDomain_ = dom; }
            return 1;
        }

        int parseGraph(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    parseNode(po, l);
                } else if (f == 5) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    parseTensor(po, l);
                } else if (f == 11 || f == 12) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    lastElemType_ = DType.UNKNOWN();
                    string nm = parseValueInfo(po, l);
                    // G2：登记图输入/输出的 dtype + role（初始器输入是 WEIGHT，非 GRAPH_IN）
                    if (nm != "") {
                        if (f == 11) {
                            if (g_.isWeightName(nm) == 1) { g_.setValueRole(nm, TensorRole.WEIGHT()); if (lastElemType_ != DType.UNKNOWN()) g_.setValueDType(nm, lastElemType_); }
                            else { g_.setValueRole(nm, TensorRole.GRAPH_IN()); if (lastElemType_ != DType.UNKNOWN()) g_.setValueDType(nm, lastElemType_); }
                            g_.addGraphInput(nm);
                        }
                        if (f == 12) { g_.setValueRole(nm, TensorRole.GRAPH_OUT()); if (lastElemType_ != DType.UNKNOWN()) g_.setValueDType(nm, lastElemType_); g_.addGraphOutput(nm); }
                    }
                } else {
                    pb_.skipField();
                }
            }
            return 1;
        }

        // ---- NodeProto：用 Graph 构建 API 填充 ----
        int parseNode(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            int ni = g_.beginNode();
            int inIdx = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {           // input (string, repeated)
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    string s = pb_.readString(l);
                    if (inIdx < 5) g_.nodeIn(ni, inIdx, s);
                    inIdx = inIdx + 1;
                } else if (f == 2) {    // output
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    g_.nodeOut(ni, pb_.readString(l));
                } else if (f == 3) {    // name
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    pb_.skipBytes(l);
                } else if (f == 4) {    // op_type
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    g_.nodeType(ni, pb_.readString(l));
                } else if (f == 5) {    // attribute
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    parseAttr(po, l, ni);
                } else {
                    pb_.skipField();
                }
            }
            // 阶段7：Unsupported operator 诊断——未知 op 立即报具体信息（节点名/op/输入/输出/原因）
            string ot = g_.nodeTypeAt(ni);
            if (ot != "" && OpCode.opCode(ot) == OpCode.UNKNOWN()) {
                Console.writeString("Unsupported ONNX op: '" + ot + "' node=" + ni);
                Console.writeLine("");
                // 原因分类：控制流子图算子（If/Loop/Scan）→ 明确声明不支持；
                // 否则 → 普通未实现算子（后续扩展）。
                if (ot == "If" || ot == "Loop" || ot == "Scan") {
                    Console.writeString("  reason: control-flow subgraph op (If/Loop/Scan) not supported");
                    Console.writeLine("");
                } else {
                    Console.writeString("  reason: operator not implemented");
                    Console.writeLine("");
                }
                int si = 0;
                while (si < 5) {
                    string in = g_.nodeInAt(ni, si);
                    if (in == "") break;
                    Console.writeString("  in[" + Fmt.i(si) + "]=" + in);
                    Console.writeLine("");
                    si = si + 1;
                }
                int so = 0;
                while (so < 4) {
                    string ou = g_.compilerNodeOutput(ni, so);
                    if (ou == "") break;
                    Console.writeString("  out[" + Fmt.i(so) + "]=" + ou);
                    Console.writeLine("");
                    so = so + 1;
                }
                badOp_ = 1;
            }
            g_.endNode();
            return 1;
        }

        // ---- AttributeProto：name(1) / f(2) / int(3) / ints(8) / t(5) ----
        // 映射到 Graph.NodeField（格式无关字段码）
        int parseAttr(int off, int len, int ni) {
            int end = off + len;
            pb_.seek(off);
            string aname = "";
            int idx = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    aname = pb_.readString(l);
                } else if (f == 2) {    // f（float32 单值，如 BN epsilon / LeakyRelu alpha）
                    int bits = pb_.readU32();
                    if (aname == "epsilon") { g_.nodeInt(ni, NodeField.EPS_INT(), bits); g_.nodeInt(ni, NodeField.HAS_EPS(), 1); }
                    if (aname == "alpha") { g_.nodeInt(ni, NodeField.ALPHA_INT(), bits); g_.nodeInt(ni, NodeField.HAS_ALPHA(), 1); }
                } else if (f == 3) {    // int64 单值（transB / axis / group / to）
                    int v = pb_.readVarint();
                    if (aname == "transB") g_.nodeInt(ni, NodeField.TRANSB(), v);
                    if (aname == "axis") g_.nodeInt(ni, NodeField.AXIS(), v);
                    if (aname == "group") g_.nodeInt(ni, NodeField.GROUP(), v);
                    if (aname == "keepdims") g_.nodeInt(ni, NodeField.KEEP(), v);
                    if (aname == "count_include_pad") g_.nodeInt(ni, NodeField.CIP(), v);
                    if (aname == "to") g_.nodeInt(ni, NodeField.CAST_TO(), v);   // P3：Cast dtype
                } else if (f == 4) {    // string 单值（Resize mode / coord）
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    string sv = pb_.readString(l);
                    if (aname == "mode") {
                        if (sv == "linear" || sv == "bilinear") g_.nodeInt(ni, NodeField.MODE(), 1);
                        else g_.nodeInt(ni, NodeField.MODE(), 0);   // nearest
                        // F8：Pad mode（与 Resize 共用 "mode" 属性名；Resize 忽略 PADMODE，Pad 忽略 MODE）
                        if (sv == "constant") g_.nodeInt(ni, NodeField.PADMODE(), 0);
                        else if (sv == "reflect") g_.nodeInt(ni, NodeField.PADMODE(), 1);
                        else if (sv == "edge") g_.nodeInt(ni, NodeField.PADMODE(), 2);
                        else if (sv == "wrap") g_.nodeInt(ni, NodeField.PADMODE(), 3);
                    }
                    if (aname == "coordinate_transformation_mode") {
                        if (sv == "align_corners") g_.nodeInt(ni, NodeField.TRANSFORM(), 0);
                        else if (sv == "asymmetric") g_.nodeInt(ni, NodeField.TRANSFORM(), 2);
                        else g_.nodeInt(ni, NodeField.TRANSFORM(), 1);   // half_pixel 等
                    }
                } else if (f == 7) {    // floats（Upsample scales，packed 4-byte fixed32）
                    int l = pb_.readLen();
                    int fi = 0;
                    if (aname == "scales") {
                        while (fi < l / 4 && fi < 4) {
                            int bits = pb_.readU32();
                            if (fi == 0) g_.nodeInt(ni, NodeField.UPSH(), bits);
                            else if (fi == 1) g_.nodeInt(ni, NodeField.UPSW(), bits);
                            fi = fi + 1;
                        }
                    }
                    int rem = l - fi * 4;
                    if (rem > 0) pb_.skipBytes(rem);
                } else if (f == 8) {    // ints：非打包，每个 varint 一个字段
                    int v = pb_.readVarint();
                    string nt = g_.nodeTypeAt(ni);
                    int is3d = 0;
                    if (nt == "Conv3D" || nt == "MaxPool3D" || nt == "AveragePool3D" || nt == "ConvTranspose3D") is3d = 1;
                    if (aname == "strides") {
                        // 通用捕获原始 strides（normalize3D 按秩映射 2D/3D）
                        if (idx == 0) g_.nodeInt(ni, NodeField.ST0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.ST1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.ST2(), v);
                        if (is3d == 1) { if (idx == 0) g_.nodeInt(ni, NodeField.SD3(), v); else if (idx == 1) g_.nodeInt(ni, NodeField.SH(), v); else g_.nodeInt(ni, NodeField.SW(), v); }
                        else { if (idx == 0) g_.nodeInt(ni, NodeField.SH(), v); else g_.nodeInt(ni, NodeField.SW(), v); }
                    }
                    else if (aname == "pads") {
                        // 通用捕获原始 pads
                        if (idx == 0) g_.nodeInt(ni, NodeField.PD0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.PD1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.PD2(), v);
                        else if (idx == 3) g_.nodeInt(ni, NodeField.PD3(), v);
                        else if (idx == 4) g_.nodeInt(ni, NodeField.PD4(), v);
                        else if (idx == 5) g_.nodeInt(ni, NodeField.PD5(), v);
                        if (is3d == 1) {
                            // pads = [pdt,pdb,pt,pb,pl,pr]（3D）
                            if (idx == 0) g_.nodeInt(ni, NodeField.PDT(), v);
                            else if (idx == 1) g_.nodeInt(ni, NodeField.PDB(), v);
                            else if (idx == 2) g_.nodeInt(ni, NodeField.PT(), v);
                            else if (idx == 3) g_.nodeInt(ni, NodeField.PB(), v);
                            else if (idx == 4) g_.nodeInt(ni, NodeField.PL(), v);
                            else g_.nodeInt(ni, NodeField.PR(), v);
                        } else {
                            // pads = [top, left, bottom, right]（2D）
                            if (idx == 0) g_.nodeInt(ni, NodeField.PT(), v);
                            else if (idx == 1) g_.nodeInt(ni, NodeField.PL(), v);
                            else if (idx == 2) g_.nodeInt(ni, NodeField.PB(), v);
                            else g_.nodeInt(ni, NodeField.PR(), v);
                        }
                    }
                    else if (aname == "dilations") {
                        if (idx == 0) g_.nodeInt(ni, NodeField.DL0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.DL1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.DL2(), v);
                        if (is3d == 1) { if (idx == 0) g_.nodeInt(ni, NodeField.DD3(), v); else if (idx == 1) g_.nodeInt(ni, NodeField.DH(), v); else g_.nodeInt(ni, NodeField.DW(), v); } else { if (idx == 0) g_.nodeInt(ni, NodeField.DH(), v); else g_.nodeInt(ni, NodeField.DW(), v); }
                    }
                    else if (aname == "output_padding") { if (idx == 0) g_.nodeInt(ni, NodeField.OPH(), v); else g_.nodeInt(ni, NodeField.OPW(), v); }   // F8：ConvTranspose
                    else if (aname == "kernel_shape") {
                        if (idx == 0) g_.nodeInt(ni, NodeField.KK0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.KK1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.KK2(), v);
                        if (is3d == 1) { if (idx == 0) g_.nodeInt(ni, NodeField.KD3(), v); else if (idx == 1) g_.nodeInt(ni, NodeField.KH(), v); else g_.nodeInt(ni, NodeField.KW(), v); } else { if (idx == 0) g_.nodeInt(ni, NodeField.KH(), v); else g_.nodeInt(ni, NodeField.KW(), v); }
                    }
                    else if (aname == "perm") {   // F8：Transpose perm（ints 非打包）
                        if (idx == 0) g_.nodeInt(ni, NodeField.PERM0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.PERM1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.PERM2(), v);
                        else g_.nodeInt(ni, NodeField.PERM3(), v);
                        g_.nodeInt(ni, NodeField.PERM_N(), idx + 1);
                    }
                    else if (aname == "axes") {   // F8：ReduceMean axes（属性，opset<=17）
                        if (idx == 0) g_.nodeInt(ni, NodeField.AXES0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.AXES1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.AXES2(), v);
                        else g_.nodeInt(ni, NodeField.AXES3(), v);
                        g_.nodeInt(ni, NodeField.AXES_N(), idx + 1);
                    }
                    else if (aname == "split") {   // F8：Split 各输出尺寸（缺省 → 均分）
                        if (idx == 0) g_.nodeInt(ni, NodeField.SPLIT0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.SPLIT1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.SPLIT2(), v);
                        else g_.nodeInt(ni, NodeField.SPLIT3(), v);
                        g_.nodeInt(ni, NodeField.SPLIT_N(), idx + 1);
                    }
                    idx = idx + 1;
                } else if (f == 5) {    // t（Constant 节点的 value：TensorProto）记录字节，稍后折叠
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    g_.nodeInt(ni, NodeField.CONST_VAL(), 1);
                    g_.nodeInt(ni, NodeField.CONST_OFF(), po);
                    g_.nodeInt(ni, NodeField.CONST_LEN(), l);
                    pb_.skipBytes(l);
                } else {
                    pb_.skipField();
                }
            }
            return 1;
        }

        // ---- TensorProto（initializer）----
        int parseTensor(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            int[] dims = new int[8];
            int dimCount = 0;
            int dt = 0;
            int payloadKind = 0;
            int payloadOff = 0;
            int payloadLen = 0;
            string nm = "";
            string extLoc = "";   // 阶段七：external data（data_location=EXTERNAL）相对模型目录的文件
            int extData = 0;
            extDataOff_ = 0;      // 阶段七：external_data offset/length（StringStringEntryProto）
            extDataLen_ = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {           // dims：非打包，每个维度一个 varint 字段
                    if (dimCount < 8) { dims[dimCount] = pb_.readVarint(); dimCount = dimCount + 1; }
                    else { long v = pb_.readVarint64(); }
                } else if (f == 2) {    // data_type
                    dt = pb_.readVarint();
                } else if (f == 4 || f == 9) {  // float_data(4) / raw_data(9)：packed f32 字节
                    payloadKind = 1;
                    payloadLen = pb_.readLen();
                    payloadOff = pb_.payloadOff();
                    pb_.skipBytes(payloadLen);  // 前进游标，跳过 payload（仅记录偏移，稍后从 file_ 读取）
                } else if (f == 6) {   // float16_data(6)：packed 2 字节/元素（阶段三 FP16 权重）
                    payloadKind = 4;
                    payloadLen = pb_.readLen();
                    payloadOff = pb_.payloadOff();
                    pb_.skipBytes(payloadLen);
                } else if (f == 16) {   // bfloat16_data(16)：packed 2 字节/元素（阶段三 BF16 权重）
                    payloadKind = 5;
                    payloadLen = pb_.readLen();
                    payloadOff = pb_.payloadOff();
                    pb_.skipBytes(payloadLen);
                } else if (f == 7) {   // int64_data(7)：packed varint（F8：Reshape shape / Slice 参数）
                    payloadKind = 3;
                    payloadLen = pb_.readLen();
                    payloadOff = pb_.payloadOff();
                    pb_.skipBytes(payloadLen);
                } else if (f == 10) {   // double_data(10)：packed f64
                    payloadKind = 2;
                    payloadLen = pb_.readLen();
                    payloadOff = pb_.payloadOff();
                    pb_.skipBytes(payloadLen);
                } else if (f == 8) {    // name
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    nm = pb_.readString(l);
                } else if (f == 13) {   // external_data（StringStringEntryProto：key=1, value=2）
                    // 注意：location/offset/length 是 3 条独立的 repeated field 13，
                    // 每次进入都会解析一条；location 只取首次（避免被空串覆盖）。
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    string thisLoc = parseExternalData(po, l);
                    if (extLoc == "" && thisLoc != "") extLoc = thisLoc;
                } else if (f == 14) {   // data_location（1 = EXTERNAL）
                    extData = pb_.readVarint();
                } else {
                    pb_.skipField();
                }
            }
            // 阶段七：external data——读外部文件全部字节追加到 file_ 扩展区，
            // payloadOff 指向追加区+external offset、payloadLen = external length
            // （缺省则 = 追加区剩余字节）。writeWeight 现有从 file_[offset..offset+len]
            // 读取的逻辑无需改动（Graph.byteAt 统一 mmap/int[] 字节源）。
            if (extData == 1 && extLoc != "") {
                int extOff = appendExternalBytes(modelDir_ + extLoc);
                if (extOff >= 0) {
                    payloadKind = 1;
                    payloadOff = extOff + extDataOff_;
                    if (extDataLen_ > 0 && extDataLen_ <= (fileLen_ - payloadOff)) {
                        payloadLen = extDataLen_;
                    } else {
                        payloadLen = fileLen_ - payloadOff;
                    }
                    // 数组可能已重分配，刷新 Graph 字节源引用（appendExternalBytes 已做，
                    // 此处不再重复，避免 mmap 模式下破坏主文件 mmap 引用）
                }
            }
            // 登记 initializer（4D 维度；wRows/cols 保留为 [d0, prod(rest)] 视图）
            int rows = 1; int cols = 1;
            if (dimCount == 0) { rows = 1; cols = 1; }
            else if (dimCount == 1) { rows = dims[0]; cols = 1; }
            else if (dimCount == 2) { rows = dims[0]; cols = dims[1]; }
            else {
                rows = dims[0];
                cols = 1;
                int k = 1;
                while (k < dimCount) { cols = cols * dims[k]; k = k + 1; }
            }
            g_.addWeight(nm, rows, cols, dt, payloadKind, payloadOff, payloadLen);
            g_.addShapeD(nm, dims, dimCount);
            // G2：initializer 登记 dtype + WEIGHT role
            if (nm != "") {
                g_.setValueRole(nm, TensorRole.WEIGHT());
                if (dt != 0) g_.setValueDType(nm, dt);
            }
            return 1;
        }

        // ---- StringStringEntryProto（external_data）：key=1（string）/ value=2（string）。
        // 解析 location（相对模型目录的文件路径）+ offset/length（字节区间）。
        // 注意：每条 field 13 只含一个键值对（location / offset / length 各自独立），
        // 故以属性当前值为初值累加，避免互相覆盖。返回本条的 location（可能为空）。
        string parseExternalData(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            string loc = "";
            int o = extDataOff_;
            int l = extDataLen_;
            string key = "";   // 跨迭代保留（key=1 与 value=2 是独立字段，分次读到）
            string val = "";
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int ll = pb_.readLen(); int po = pb_.payloadOff();
                    key = pb_.readString(ll);
                } else if (f == 2) {
                    int ll = pb_.readLen(); int po = pb_.payloadOff();
                    val = pb_.readString(ll);
                    // 读完整条（key+value）后按 key 归类
                    if (key == "location") loc = val;
                    else if (key == "offset") o = atoi10(val);
                    else if (key == "length") l = atoi10(val);
                    key = "";
                    val = "";
                } else {
                    pb_.skipField();
                }
            }
            extDataOff_ = o;
            extDataLen_ = l;
            return loc;
        }

        // 简单十进制字符串→int（external_data 的 offset/length 均为 ASCII 十进制）
        int atoi10(string s) {
            int r = 0;
            int i = 0;
            int n = Str.len(s);
            int neg = 0;
            if (n > 0 && Str.substring(s, 0, 1) == "-") { neg = 1; i = 1; }
            while (i < n) {
                int c = __myp_charcode(s, i);
                if (c >= 48 && c <= 57) r = r * 10 + (c - 48);
                i = i + 1;
            }
            if (neg == 1) return 0 - r;
            return r;
        }

        // 读外部文件全部字节追加到 file_ 尾部（增长缓冲）。返回追加区起始逻辑偏移
        // （mmap 模式 = mmapLen_+本地索引；readFile 模式 = 本地索引）；失败返回 -1。
        int appendExternalBytes(string fullPath) {
            int fd = __myp_io_fopen(fullPath, "rb");
            if (fd < 0) { Console.writeString("external data file not found: " + fullPath); Console.writeLine(""); return -1; }
            int start = fileLen_;          // 逻辑起始（mmap: mmapLen_+本地；readFile: 本地）
            while (true) {
                int b = __myp_io_read_byte();
                if (b < 0) break;
                int local = fileLen_ - mmapLen_;   // file_ 本地索引（mmap 模式基 = mmapLen_）
                if (local >= cap_) {
                    int ncap = cap_ * 2;
                    int[] nb = new int[ncap];
                    int i = 0;
                    while (i < local) { nb[i] = file_[i]; i = i + 1; }
                    file_ = nb;
                    cap_ = ncap;
                }
                file_[local] = b;
                fileLen_ = fileLen_ + 1;
            }
            __myp_io_fclose();
            // 刷新 Graph 字节源引用（数组可能重分配；mmap 模式仅追加区）
            if (mmapMode_ == 1) g_.setFileAppend(file_, fileLen_ - mmapLen_);
            else g_.setFile(file_, fileLen_);
            return start;
        }

        // ---- ValueInfoProto（graph input/output）：取 name + 形状，返回名字 ----
        string parseValueInfo(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            string nm = "";
            int[] dims = new int[8];
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    nm = pb_.readString(l);
                } else if (f == 2) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    dimCount = parseTypeShape(po, l, dims);
                } else {
                    pb_.skipField();
                }
            }
            g_.addShapeD(nm, dims, dimCount);
            return nm;
        }

        // TypeProto → tensor_type → shape → dims（dim_param 视为 1）
        int parseTypeShape(int off, int len, int[] dims) {
            int end = off + len;
            pb_.seek(off);
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {   // tensor_type
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    dimCount = parseTensorType(po, l, dims);
                } else {
                    pb_.skipField();
                }
            }
            return dimCount;
        }

        int parseTensorType(int off, int len, int[] dims) {
            int end = off + len;
            pb_.seek(off);
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {   // elem_type（G2：dtype 建模）
                    lastElemType_ = pb_.readVarint();
                } else if (f == 2) {   // shape
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    dimCount = parseShape(po, l, dims);
                } else {
                    pb_.skipField();
                }
            }
            return dimCount;
        }

        int parseShape(int off, int len, int[] dims) {
            int end = off + len;
            pb_.seek(off);
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {   // dim
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    int v = parseDim(po, l);
                    if (dimCount < 8) { dims[dimCount] = v; dimCount = dimCount + 1; }
                } else {
                    pb_.skipField();
                }
            }
            return dimCount;
        }

        int parseDim(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            int v = 0;   // 默认 0 = 动态维；有 dim_value（f==1）覆盖为真实值
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) { v = pb_.readVarint(); }
                else if (f == 2) { int l = pb_.readLen(); int po = pb_.payloadOff(); pb_.skipBytes(l); v = 0; }   // dim_param：动态维 → 0
                else { pb_.skipField(); }
            }
            return v;   // 动态维（空 dim / dim_param / dim_value=0）返回 0，供 setInputShape/inferShapes 覆盖
        }

    property:
        int[] file_;
        int fileLen_;
        int cap_;               // 阶段七：file_ 缓冲容量（readFile/appendExternalBytes 共享）
        string modelDir_;       // 阶段七：模型所在目录（external data 相对路径基）
        int extDataOff_;        // 阶段七：external_data offset（字节偏移，缺省 0）
        int extDataLen_;        // 阶段七：external_data length（字节数，缺省 0）
        MmapFile mm_;           // 阶段七：mmap 主文件字节源（mmapMode_==1）
        int mmapMode_;          // 1=mmap 加载（file_ 为追加区），0=readFile 全量缓冲
        int mmapLen_;           // mmap 主文件字节数（追加区逻辑偏移基）
        PbReader pb_;
        Graph g_;
        int doNHWC_;
        int lossMode_;          // 训练损失模式：0=SoftmaxCE，1=Dice
        int diceWMode_;         // Dice 类权重：0=等权，1=逆频率加权
        int lastElemType_;      // G2：最近解析 ValueInfo 的 elem_type（dtype 建模）
        int badOp_;             // 阶段7：检测到 unsupported ONNX op（诊断标记）
        int irVersion_;         // 阶段七：ModelProto.ir_version（-1=未解析）
        int opsetVersion_;      // 阶段七：标准 opset 版本（-1=未解析）
        string opsetDomain_;    // 阶段七：opset domain（""=标准算子集）
        string[8] inpName_;     // P3：输入形状注入表
        int[8] inpD0_;
        int[8] inpD1_;
        int[8] inpD2_;
        int[8] inpD3_;
        int[8] inpD4_;
        int[8] inpR5_;
        int inpCnt_;
}
