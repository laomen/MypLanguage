// dice_weighted_grad_check.myp — 阶段4g：类不平衡 Dice loss（wMode=1 逆频率加权）数值对拍
//
// 验证：wMode=1 时 diceLoss 的解析梯度 dp 与中心差分一致（CPU），且 GPU 与 CPU 逐位一致。
// 数据模拟真实肝脏：C=2 类、前景仅占 5%（类不平衡）。
//
// 运行（须在 examples/ 下）：
//   ./build/mypc examples/deeplearning/train/dice_weighted_grad_check.myp -o /tmp/dwgc --stdlib stdlib && /tmp/dwgc

import env;
import math;
import fmt;
import cuda;
import gpu;
import "../infer/ops.myp";
import "../infer/gpu_ops.myp";

class DiceWGC {
    action:
        @constructor DiceWGC() {
            seed_ = 77.0;
            int C = 2; int S = 400;      // 前景 5%（20/400）
            int pOff = 0;                // [2,400]=800
            int yOff = 800;              // 800
            int dpOff = 1600;            // 800
            int lossOff = 2400;          // 1
            int scratch = 2401;          // fd 临时 dp（800）
            int CAP = 3600;
            int stOffG = 3500;           // GPU stats 区（arena 内，需 3*C+1=7 槽）
            float[] arena = new float[CAP];
            int i = 0;
            while (i < C * S) { arena[pOff + i] = float(rnd() * 0.9 + 0.05); i = i + 1; }
            i = 0;
            while (i < C * S) { arena[yOff + i] = 0.0f; i = i + 1; }
            // one-hot：前景类（类1）占 5%
            int fg = S / 20;   // 20 个前景位置
            int s = 0;
            while (s < S) {
                int cls = 0;
                if (s < fg) cls = 1;
                arena[yOff + cls * S + s] = 1.0f;
                s = s + 1;
            }

            double epsD = 1.0e-7;
            // 加权 loss + 梯度
            InferOps.diceLoss(arena, pOff, yOff, dpOff, lossOff, C, S, 1);
            Console.writeString("wMode=1 loss=");
            Console.writeFloat(arena[lossOff]);
            Console.writeLine("");

            int fails = 0;
            // 中心差分验证 dp（加权）
            int[] idx = new int[8]; idx[0] = 0; idx[1] = 1; idx[2] = 25; idx[3] = 200;
            idx[4] = 400; idx[5] = 401; idx[6] = 780; idx[7] = 799;
            int k = 0;
            while (k < 8) {
                int j = idx[k];
                double a = arena[dpOff + j];
                double num = fd(arena, pOff, yOff, lossOff, scratch, C, S, j, 0.001);
                Console.writeString("dp[" + Fmt.i(j) + "] analytic=" + Fmt.f(a, 6) + " numeric=" + Fmt.f(num, 6));
                Console.writeLine("");
                if (Math.abs(a - num) > 1.0e-2 * (1.0 + Math.abs(a) + Math.abs(num))) fails = fails + 1;
                k = k + 1;
            }

            // GPU vs CPU（wMode=1）
            if (Cuda.available() == 1) {
                float[] gpuA = new float[CAP];
                i = 0; while (i < CAP) { gpuA[i] = arena[i]; i = i + 1; }
                GpuBufferF buf = new GpuBufferF(gpuA, CAP);
                long dev = buf.devicePtr();
                buf.copyFromHost(gpuA, 0, 0, CAP);
                GpuInferOps.diceLoss(gpuA, dev, 3500, pOff, yOff, dpOff, lossOff, C, S, 1);
                buf.copyToHost(gpuA, 0, 0, CAP);
                int bad = 0; double md = 0.0;
                i = 0;
                while (i < C * S) {
                    double d = double(arena[dpOff + i]) - double(gpuA[dpOff + i]);
                    if (d < 0.0) d = 0.0 - d;
                    if (d > md) md = d;
                    if (Math.abs(d) > 1.0e-4) bad = bad + 1;
                    i = i + 1;
                }
                double dl = double(arena[lossOff]) - double(gpuA[lossOff]);
                if (dl < 0.0) dl = 0.0 - dl;
                Console.writeString("gpu dp maxDiff=" + Fmt.f(md, 6) + " bad=" + Fmt.i(bad) + " lossDiff=" + Fmt.f(dl, 6));
                Console.writeLine("");
                if (bad > 0 || dl > 1.0e-4) fails = fails + 1;
            } else {
                Console.writeLine("GPU SKIP (no device)");
            }

            // 回归：wMode=0 应等于旧版等权（与加权 loss 不同值，仅验证模式切换不崩溃）
            InferOps.diceLoss(arena, pOff, yOff, dpOff, lossOff, C, S, 0);
            Console.writeString("wMode=0 loss=");
            Console.writeFloat(arena[lossOff]);
            Console.writeLine("");

            if (fails == 0) Console.writeLine("DICE WEIGHTED GRAD CHECK OK");
            else Console.writeLine("DICE WEIGHTED GRAD CHECK FAIL (" + Fmt.i(fails) + ")");
        }

        double fd(float[] arena, int pOff, int yOff, int lossOff, int scratch, int C, int S, int j, double eps) {
            double pp = arena[pOff + j];
            arena[pOff + j] = float(pp + eps);
            InferOps.diceLoss(arena, pOff, yOff, scratch, lossOff, C, S, 1);
            double Lp = arena[lossOff];
            arena[pOff + j] = float(pp - eps);
            InferOps.diceLoss(arena, pOff, yOff, scratch, lossOff, C, S, 1);
            double Lm = arena[lossOff];
            arena[pOff + j] = float(pp);
            return (Lp - Lm) / (2.0 * eps);
        }

        double rnd() {
            seed_ = (seed_ * 1103515245.0 + 12345.0) % 2147483648.0;
            return float(seed_ % 1000000) / 1000000.0;
        }

    property:
        double seed_;
}

int main() {
    DiceWGC t = new DiceWGC();
    return 0;
}
