// gpu_leak_test.myp — 验证 GPU kernel 模块不再泄漏显存（阶段3d 显存暴涨修复）
//
// 背景：旧版 myp_gpu_destroy_kernel 只 free 宿主结构，从不 cuModuleUnload，
// 每次 launch 的 cuModuleLoadData 都新增一块设备模块内存且永不释放 →
// 训练（每样本 ~13 个 kernel × 数十万样本）显存持续暴涨直至 OOM。
// 修复后按 (PTX,name) 缓存 kernel 模块：首次加载一次，之后复用。
//
// 运行（监控显存，应见首 3 次 launch 后显存平台化，不再逐次上涨）：
//   ./build/mypc examples/deeplearning/train/gpu_leak_test.myp -o /tmp/gpu_leak --stdlib stdlib
//   watch -n0.5 nvidia-smi   # 另开终端
//   MYP_GPU=1 /tmp/gpu_leak
import env;
import time;
import gpu;

class LeakTest {
    action:
        @constructor LeakTest() {
            Console.writeLine("backend=" + Gpu.backend() + "  devices=" + Gpu.deviceCount());
            if (Gpu.available() != 1) { Console.writeLine("GPU 不可用，跳过"); return; }

            // 一个小设备缓冲（一次分配），循环里只反复 launch resident kernel
            int n = 4096;
            float[] host = new float[n];
            for (int i = 0; i < n; i = i + 1) host[i] = 1.0f;
            GpuBufferF buf = new GpuBufferF(host, n);
            long da = buf.devicePtr();
            if (buf.valid() != 1) { Console.writeLine("alloc 失败"); return; }

            double[] a = new double[1];   // resident 绑定用的哑宿主数组
            double[] b = new double[1];
            double[] o = new double[1];

            int iters = 3000;
            long t0 = Time.nowMs();
            int k = 0;
            while (k < iters) {
                @gpu for (long p = 0L; p < long(n); p = p + 1L) resident(a = da) {
                    a[p] = a[p] * 1.0 + 1e-30;
                }
                @gpu for (long p = 0L; p < long(n); p = p + 1L) resident(a = da, b = da) {
                    a[p] = a[p] * 2.0;
                }
                @gpu for (long p = 0L; p < long(n); p = p + 1L) resident(a = da, b = da, o = da) {
                    a[p] = b[p] * 0.5;
                }
                k = k + 1;
            }
            long t1 = Time.nowMs();
            buf.free();
            Console.writeLine("leak test done: " + iters + " iters x 3 kernels in " + (t1 - t0) + "ms");
        }
}

int main() {
    LeakTest t = new LeakTest();
    return 0;
}
