// 3d_liver_train.myp — 阶段4g：类不平衡 3D 分割训练（肝脏形态合成数据）
// 验证：真实肝脏前景仅 ~5% 体素（类不平衡）时，逆频率加权 Dice（wMode=1）能否学会
// 小前景；对比等权 Dice（wMode=0）——后者易塌缩到全背景（前景 DSC≈0）。
//
// 模型：deeplearning/data/onnx/3d_liver.onnx（16³ 带跳跃连接 U-Net，2 类）
// 数据：合成 16³ 体素，前景 = 带模糊边界的椭球（~5% 体积），模拟肝脏；含噪声。
// 训练：batch=1 纯 SGD；MYP_DICE_WMODE 选 0（等权）/1（逆频率加权，默认）。
// 指标：前景 DSC（Dice Similarity Coefficient，argmax 预测 vs label）。
//
// 运行（须在 examples/ 下）：
//   deeplearning/infer/tools/onnxvenv/bin/python deeplearning/infer/tools/make_3d_liver_onnx.py
//   ./build/mypc examples/deeplearning/train/3d_liver_train.myp -o /tmp/3d_liver --stdlib stdlib
//   cd examples && MYP_GPU=0 MYP_DICE_WMODE=0 /tmp/3d_liver   # 等权
//   cd examples && MYP_GPU=0 MYP_DICE_WMODE=1 /tmp/3d_liver   # 逆频率加权

import env;
import fmt;
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class Liver3DTrain {
    action:
        @constructor Liver3DTrain() {
            seed_ = 20260901.0;
            int wm = 1;
            if (Console.getEnv("MYP_DICE_WMODE") == "0") wm = 0;
            int D = 16; int H = 16; int W = 16;
            int NIN = D * H * W;        // 4096 体素
            int NLAB = 2 * NIN;
            int NTRAIN = 120;
            int NTEST = 30;
            int EPOCHS = 70;
            if (Console.getEnv("MYP_LIVER_SMALL") == "1") { NTRAIN = 40; NTEST = 10; EPOCHS = 20; }
            float[] x = new float[NTRAIN * NIN];
            float[] lab = new float[NTRAIN * NLAB];
            genData(x, lab, NTRAIN, NIN, 1);
            float[] xt = new float[NTEST * NIN];
            float[] labt = new float[NTEST * NLAB];
            genData(xt, labt, NTEST, NIN, 2);

            InferenceRuntime rt = new InferenceRuntime();
            rt.init(8000000);
            // 优化器：MYP_OPT_MODE 0=SGD(默认) 1=动量 2=AdamW
            int om = 0;
            if (Console.getEnv("MYP_OPT_MODE") == "1") om = 1;
            if (Console.getEnv("MYP_OPT_MODE") == "2") om = 2;
            rt.setOptMode(om);
            OnnxLoader loader = new OnnxLoader();
            loader.setLossMode(1);      // Dice loss
            if (wm == 1) loader.setDiceWMode(1);   // 逆频率加权（类不平衡）
            int ok = loader.loadTrain("./deeplearning/data/onnx/3d_liver.onnx", rt);
            if (ok == 0) { Console.writeLine("loadTrain failed"); return; }
            int dataTid = loader.tensorId("data");
            int labelTid = loader.tensorId("label");
            int lossTid = loader.tensorId("loss");
            int probTid = loader.tensorId("prob");
            if (dataTid < 0 || labelTid < 0 || lossTid < 0 || probTid < 0) {
                Console.writeLine("tensor not found");
                return;
            }

            if (rt.gpuPersistentStart() == 1) {
                rt.markGpuSync(lossTid);
                rt.markGpuSync(probTid);
            }

            Console.writeString("LIVER 3D wmode=");
            Console.write(wm);
            Console.writeLine("");

            double preDsc = testDSC(rt, probTid, dataTid, xt, labt, NIN, NTEST);
            Console.writeString("PRE-TRAIN fg-DSC=");
            Console.writeFloat(preDsc);
            Console.writeLine("");

            double lr = 0.05;
            double bestDsc = 0.0;
            int epoch = 0;
            while (epoch < EPOCHS) {
                if (epoch == 30) lr = 0.02;
                if (epoch == 55) lr = 0.005;
                rt.setLr(lr);
                rt.setTrain(1);
                double lossSum = 0.0;
                int s = 0;
                while (s < NTRAIN) {
                    int j = 0;
                    while (j < NIN) { rt.setFlat(dataTid, j, double(x[s * NIN + j])); j = j + 1; }
                    j = 0;
                    while (j < NLAB) { rt.setFlat(labelTid, j, double(lab[s * NLAB + j])); j = j + 1; }
                    step(rt);
                    lossSum = lossSum + rt.getFlat(lossTid, 0);
                    s = s + 1;
                }
                double dsc = testDSC(rt, probTid, dataTid, xt, labt, NIN, NTEST);
                if (dsc > bestDsc) bestDsc = dsc;
                Console.writeString("epoch ");
                Console.write(epoch);
                Console.writeString(" loss=");
                Console.writeFloat(lossSum / NTRAIN);
                Console.writeString(" fgDSC=");
                Console.writeFloat(dsc);
                Console.writeLine("");
                epoch = epoch + 1;
            }

            Console.writeString("LIVER-3D wmode=");
            Console.write(wm);
            Console.writeString(" best fg-DSC=");
            Console.writeFloat(bestDsc);
            Console.writeLine("");
            if (bestDsc >= 0.85) Console.writeLine("LIVER 3D TRAIN OK");
            else Console.writeLine("LIVER 3D TRAIN FAIL (fg-DSC<0.85)");
            rt.gpuPersistentEnd();
        }

        // 前景 DSC：Dice = 2|P∩Y|/(|P|+|Y|) on argmax==1 预测 vs label 类1
        double testDSC(InferenceRuntime rt, int probTid, int dataTid, float[] xt, float[] labt, int NIN, int n) {
            rt.setTrain(0);
            double tp = 0.0; double fp = 0.0; double fn = 0.0;
            int s = 0;
            while (s < n) {
                int j = 0;
                while (j < NIN) { rt.setFlat(dataTid, j, double(xt[s * NIN + j])); j = j + 1; }
                step(rt);
                int v = 0;
                while (v < NIN) {
                    double pfg = rt.getFlat(probTid, 1 * NIN + v);   // 类1 = 前景
                    double pbg = rt.getFlat(probTid, 0 * NIN + v);
                    int pred = (pfg > pbg) ? 1 : 0;
                    int gt = (labt[s * 2 * NIN + 1 * NIN + v] > 0.5f) ? 1 : 0;
                    if (pred == 1 && gt == 1) tp = tp + 1.0;
                    else if (pred == 1 && gt == 0) fp = fp + 1.0;
                    else if (pred == 0 && gt == 1) fn = fn + 1.0;
                    v = v + 1;
                }
                s = s + 1;
            }
            if (tp + fp + fn <= 0.0) return 0.0;
            return 2.0 * tp / (2.0 * tp + fp + fn);
        }

        // 合成肝脏形态体积：前景 = 模糊边界椭球（~5% 体积），背景低值 + 噪声
        void genData(float[] out, float[] lab, int n, int NIN, int seedTag) {
            int D = 16; int H = 16; int W = 16;
            int s = 0;
            while (s < n) {
                int base = s * NIN;
                int lbase = s * 2 * NIN;
                // 每样本随机椭球参数（中心 ±1.5，半径 ~5% 体积）
                double cx = 7.5 + (rnd() - 0.5) * 3.0;
                double cy = 7.5 + (rnd() - 0.5) * 3.0;
                double cz = 7.5 + (rnd() - 0.5) * 3.0;
                double a = 4.2 + rnd() * 0.8;   // a·b·c ≈ 48.9 → ~5% 体积
                double bb = 3.4 + rnd() * 0.6;
                double c = 3.0 + rnd() * 0.6;
                int fixedE = 0;
                if (Console.getEnv("MYP_LIVER_FIXED") == "1") { cx = 7.5; cy = 7.5; cz = 7.5; a = 4.2; bb = 3.4; c = 3.0; fixedE = 1; }
                int d = 0;
                while (d < D) {
                    int h = 0;
                    while (h < H) {
                        int w = 0;
                        while (w < W) {
                            int v = d * H * W + h * W + w;
                            double dd = double((double(d) - cx) * (double(d) - cx)) / (a * a)
                                      + double((double(h) - cy) * (double(h) - cy)) / (bb * bb)
                                      + double((double(w) - cz) * (double(w) - cz)) / (c * c);
                            int fg = 0;
                            if (fixedE == 1) {
                                if (dd < 1.0) fg = 1;
                            } else {
                                if (dd < 0.8) fg = 1;
                                else if (dd <= 1.2) {
                                    // 模糊边界：概率随距离衰减
                                    double p = (1.2 - dd) / 0.4;
                                    if (rnd() < p) fg = 1;
                                }
                            }
                            float val = 0.05f;
                            if (fg == 1) val = 1.0f;
                            val = val + float(rnd() * 0.05);
                            out[base + v] = val;
                            lab[lbase + 0 * NIN + v] = (fg == 1) ? 0.0f : 1.0f;
                            lab[lbase + 1 * NIN + v] = (fg == 1) ? 1.0f : 0.0f;
                            w = w + 1;
                        }
                        h = h + 1;
                    }
                    d = d + 1;
                }
                s = s + 1;
            }
        }

        void step(InferenceRuntime rt) {
            if (Console.getEnv("MYP_GPU") == "1") rt.runGpu();
            else rt.run();
        }

        double rnd() {
            seed_ = (seed_ * 1103515245.0 + 12345.0) % 2147483648.0;
            return float(seed_ % 1000000) / 1000000.0;
        }

    property:
        double seed_;
}

int main() {
    Liver3DTrain t = new Liver3DTrain();
    return 0;
}
