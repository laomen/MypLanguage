// conv_grad_check.myp — 阶段3：bwdConv 数值梯度对拍（独立内核测试，不经图）
//
// 小卷积 N=1,C=1,H=4,W=4 → yC=2, kh=kw=3, s1, p1，L = Σ y（dY = 全 1）。
// 中心差分 (L(W±eps)-L(W∓eps))/2eps vs bwdConv 解析梯度 dw/dx/db。
//
// 运行（须在 examples/ 下）：
//   ./build/mypc examples/deeplearning/train/conv_grad_check.myp -o /tmp/conv_gc --stdlib stdlib && /tmp/conv_gc

import env;
import math;
import fmt;
import "../infer/ops.myp";

class ConvGradCheck {
    action:
        @constructor ConvGradCheck() {
            int CAP = 200;
            float[] arena = new float[CAP];
            int xOff = 0;    // [1,1,4,4]=16
            int wOff = 16;   // [2,1,3,3]=18
            int bOff = 34;   // [2]
            int yOff = 36;   // [1,2,3,3]=18
            int dyOff = 54;  // 18（L=Σy → dY=全1）
            int dxOff = 72;  // 16
            int dwOff = 88;  // 18
            int dbOff = 106; // 2
            int xN = 1; int xC = 1; int xH = 4; int xW = 4;
            int yC = 2; int kh = 3; int kw = 3;
            int sh = 1; int sw = 1; int pt = 1; int pb = 1; int pl = 1; int pr = 1;
            int dh = 1; int dw = 1; int group = 1;
            int yH = 3; int yW = 3;

            // 随机初始化
            int i = 0;
            while (i < 16) { arena[xOff + i] = float(rnd() * 0.5); i = i + 1; }
            i = 0; while (i < 18) { arena[wOff + i] = float((rnd() * 2.0 - 1.0) * 0.5); i = i + 1; }
            i = 0; while (i < 2) { arena[bOff + i] = float((rnd() * 2.0 - 1.0) * 0.1); i = i + 1; }

            // 前向 + L=Σy
            InferOps.conv(arena, xOff, xN, xC, xH, xW, wOff, bOff, yOff, yC, yH, yW,
                          kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group);
            // dY = 全 1（L=Σy 的梯度）
            int dyOff2 = dyOff;
            int di = 0;
            while (di < xN * yC * yH * yW) { arena[dyOff2 + di] = 1.0f; di = di + 1; }
            InferOps.bwdConv(arena, dyOff2, xOff, xN, xC, xH, xW, wOff,
                             dxOff, dwOff, dbOff, yC, yH, yW,
                             kh, kw, sh, sw, pt, pl, dh, dw, group);

            // 有限差分对拍
            double eps = 1.0e-3;
            int fails = 0;
            int[] dwIdx = new int[4]; dwIdx[0] = 0; dwIdx[1] = 1; dwIdx[2] = 9; dwIdx[3] = 17;
            int k = 0;
            while (k < 4) {
                int j = dwIdx[k];
                double a = arena[dwOff + j];
                double num = fdW(arena, xOff, wOff, bOff, yOff, xN, xC, xH, xW, yC, yH, yW,
                                 kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group, j, eps);
                Console.writeString("dw[" + Fmt.i(j) + "] analytic=");
                Console.writeFloat(a);
                Console.writeString(" numeric=");
                Console.writeFloat(num);
                Console.writeLine("");
                if (Math.abs(a - num) > 1.0e-2 * (1.0 + Math.abs(a) + Math.abs(num))) fails = fails + 1;
                k = k + 1;
            }
            int[] dxIdx = new int[4]; dxIdx[0] = 0; dxIdx[1] = 1; dxIdx[2] = 5; dxIdx[3] = 15;
            k = 0;
            while (k < 4) {
                int j = dxIdx[k];
                double a = arena[dxOff + j];
                double num = fdX(arena, xOff, wOff, bOff, yOff, xN, xC, xH, xW, yC, yH, yW,
                                 kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group, j, eps);
                Console.writeString("dx[" + Fmt.i(j) + "] analytic=");
                Console.writeFloat(a);
                Console.writeString(" numeric=");
                Console.writeFloat(num);
                Console.writeLine("");
                if (Math.abs(a - num) > 1.0e-2 * (1.0 + Math.abs(a) + Math.abs(num))) fails = fails + 1;
                k = k + 1;
            }
            // db 直接对拍（db = Σ dY = 元素数，因 dY=1）
            Console.writeString("db[0] analytic=");
            Console.writeFloat(arena[dbOff + 0]);
            Console.writeString(" db[1] analytic=");
            Console.writeFloat(arena[dbOff + 1]);
            Console.writeLine("");

            if (fails == 0) Console.writeLine("CONV GRAD CHECK OK");
            else Console.writeLine("CONV GRAD CHECK FAIL");
        }

        // L(w) = Σ y，对 w[j] 中心差分
        double fdW(float[] arena, int xOff, int wOff, int bOff, int yOff,
                   int xN, int xC, int xH, int xW, int yC, int yH, int yW,
                   int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr,
                   int dh, int dw, int group, int j, double eps) {
            double wp = arena[wOff + j];
            double wm = arena[wOff + j];
            arena[wOff + j] = float(wp + eps);
            InferOps.conv(arena, xOff, xN, xC, xH, xW, wOff, bOff, yOff, yC, yH, yW, kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group);
            double Lp = sumY(arena, yOff, xN, yC, yH, yW);
            arena[wOff + j] = float(wm - eps);
            InferOps.conv(arena, xOff, xN, xC, xH, xW, wOff, bOff, yOff, yC, yH, yW, kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group);
            double Lm = sumY(arena, yOff, xN, yC, yH, yW);
            arena[wOff + j] = float(wp);
            InferOps.conv(arena, xOff, xN, xC, xH, xW, wOff, bOff, yOff, yC, yH, yW, kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group);
            return (Lp - Lm) / (2.0 * eps);
        }

        // L(x) = Σ y，对 x[j] 中心差分
        double fdX(float[] arena, int xOff, int wOff, int bOff, int yOff,
                   int xN, int xC, int xH, int xW, int yC, int yH, int yW,
                   int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr,
                   int dh, int dw, int group, int j, double eps) {
            double xp = arena[xOff + j];
            double xm = arena[xOff + j];
            arena[xOff + j] = float(xp + eps);
            InferOps.conv(arena, xOff, xN, xC, xH, xW, wOff, bOff, yOff, yC, yH, yW, kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group);
            double Lp = sumY(arena, yOff, xN, yC, yH, yW);
            arena[xOff + j] = float(xm - eps);
            InferOps.conv(arena, xOff, xN, xC, xH, xW, wOff, bOff, yOff, yC, yH, yW, kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group);
            double Lm = sumY(arena, yOff, xN, yC, yH, yW);
            arena[xOff + j] = float(xp);
            InferOps.conv(arena, xOff, xN, xC, xH, xW, wOff, bOff, yOff, yC, yH, yW, kh, kw, sh, sw, pt, pb, pl, pr, dh, dw, group);
            return (Lp - Lm) / (2.0 * eps);
        }

        double sumY(float[] arena, int yOff, int xN, int yC, int yH, int yW) {
            double s = 0.0;
            int i = 0;
            int n = xN * yC * yH * yW;
            while (i < n) { s = s + arena[yOff + i]; i = i + 1; }
            return s;
        }

        double rnd() {
            seed_ = (seed_ * 1103515245L + 12345L) % 2147483648L;
            return float(seed_ % 1000000) / 1000000.0;
        }

    property:
        long seed_ = 20260820;
}

int main() {
    ConvGradCheck g = new ConvGradCheck();
    return 0;
}
