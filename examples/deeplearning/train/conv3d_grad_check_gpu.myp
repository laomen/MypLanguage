// conv3d_grad_check_gpu.myp — 阶段4b：GPU 3D 反向内核与 CPU 参考逐元素对拍
// （bwdConv3D / bwdMaxPool3D / bwdAvgPool3D，独立内核不经图；镜像 conv3d_grad_check）
//
// 运行（须在 examples/ 下；MYP_GPU=1 且设备可用才跑 GPU，否则 SKIP）：
//   ./build/mypc examples/deeplearning/train/conv3d_grad_check_gpu.myp -o /tmp/conv3d_gc_gpu --stdlib stdlib
//   cd examples && MYP_GPU=1 /tmp/conv3d_gc_gpu

import env;
import math;
import fmt;
import cuda;
import gpu;
import "../infer/ops.myp";
import "../infer/gpu_ops.myp";

class Conv3DGradCheckGpu {
    action:
        @constructor Conv3DGradCheckGpu() {
            if (Cuda.available() != 1) {
                Console.writeLine("CONV3D GRAD CHECK GPU SKIP (no device)");
                return;
            }
            int fails = 0;
            seed_ = 881726454.0;   // 固定种子（可复现）

            // ============ 1) bwdConv3D：CPU vs GPU 逐元素对拍（非对称 padding） ============
            int CAP = 1100;
            float[] host = new float[CAP];
            int xOff = 0;     // [1,1,5,5,5]=125
            int wOff = 125;   // [2,1,3,3,3]=54
            int bOff = 179;   // [2]
            int dyOff = 235;  // 54
            int dxOff = 289;  // 125
            int dwOff = 414;  // 54
            int dbOff = 468;  // 2
            int xN = 1; int xC = 1; int xD = 5; int xH = 5; int xW = 5;
            int yC = 2;
            int kd = 3; int kh = 3; int kw = 3;
            int sd = 1; int sh = 1; int sw = 1;
            int pdt = 1; int pdb = 0; int pt = 0; int pb = 1; int pl = 1; int pr = 0;   // 非对称 padding
            int dd = 1; int dh = 1; int dw = 1; int group = 1;
            int yD = 3; int yH = 3; int yW = 3;

            int i = 0;
            while (i < 125) { host[xOff + i] = float(rnd() * 0.5); i = i + 1; }
            i = 0; while (i < 54) { host[wOff + i] = float((rnd() * 2.0 - 1.0) * 0.5); i = i + 1; }
            i = 0; while (i < 2) { host[bOff + i] = float((rnd() * 2.0 - 1.0) * 0.1); i = i + 1; }
            i = 0; while (i < xN * yC * yD * yH * yW) { host[dyOff + i] = float(rnd()); i = i + 1; }

            // CPU 参考
            float[] cpu = new float[CAP];
            i = 0; while (i < CAP) { cpu[i] = host[i]; i = i + 1; }
            InferOps.bwdConv3D(cpu, dyOff, xOff, xN, xC, xD, xH, xW, wOff,
                               dxOff, dwOff, dbOff, yC, yD, yH, yW,
                               kd, kh, kw, sd, sh, sw, pdt, pdb, pt, pb, pl, pr, dd, dh, dw, group);

            // GPU
            float[] gpuA = new float[CAP];
            i = 0; while (i < CAP) { gpuA[i] = host[i]; i = i + 1; }
            GpuBufferF buf = new GpuBufferF(gpuA, CAP);
            long dev = buf.devicePtr();
            buf.copyFromHost(gpuA, 0, 0, CAP);
            GpuInferOps.bwdConv3D(gpuA, dev, dyOff, xOff, xN, xC, xD, xH, xW, wOff,
                                  dxOff, dwOff, dbOff, yC, yD, yH, yW,
                                  kd, kh, kw, sd, sh, sw, pdt, pdb, pt, pb, pl, pr, dd, dh, dw, group);
            buf.copyToHost(gpuA, 0, 0, CAP);

            fails = fails + cmpRange("bwdConv3D dx", cpu, gpuA, dxOff, xN * xC * xD * xH * xW);
            fails = fails + cmpRange("bwdConv3D dw", cpu, gpuA, dwOff, yC * (xC / group) * kd * kh * kw);
            fails = fails + cmpRange("bwdConv3D db", cpu, gpuA, dbOff, yC);

            // ============ 2) bwdMaxPool3D：CPU vs GPU（k=s=2 无重叠，dY=全1） ============
            int xMOff = 470;    // x[1,1,5,5,5]=125
            int yMOff = 595;    // y[1,1,2,2,2]=8
            int dyMOff = 603;   // 8
            int dxMOff = 611;   // 125
            i = 0;
            while (i < 125) { host[xMOff + i] = float(rnd()); i = i + 1; }
            i = 0; while (i < 8) { host[dyMOff + i] = 1.0f; i = i + 1; }
            // CPU
            i = 0; while (i < CAP) { cpu[i] = host[i]; i = i + 1; }
            InferOps.bwdMaxPool3D(cpu, dyMOff, xMOff, 1, 1, 5, 5, 5, dxMOff, 2, 2, 2,
                                  2, 2, 2, 2, 2, 2, 0, 0, 0, 0, 0, 0);
            // GPU
            i = 0; while (i < CAP) { gpuA[i] = host[i]; i = i + 1; }
            buf.copyFromHost(gpuA, 0, 0, CAP);
            GpuInferOps.bwdMaxPool3D(gpuA, dev, dyMOff, xMOff, 1, 1, 5, 5, 5, dxMOff, 2, 2, 2,
                                     2, 2, 2, 2, 2, 2, 0, 0, 0, 0, 0, 0);
            buf.copyToHost(gpuA, 0, 0, CAP);
            fails = fails + cmpRange("bwdMaxPool3D dx", cpu, gpuA, dxMOff, 125);

            // ============ 3) bwdAvgPool3D：CPU vs GPU（cip=0 带 padding） ============
            int xAOff = 736;    // 125
            int yAOff = 861;    // [1,1,3,3,3]=27
            int dyAOff = 888;   // 27
            int dxAOff = 915;   // 125
            i = 0;
            while (i < 125) { host[xAOff + i] = float(rnd() * 0.8); i = i + 1; }
            i = 0; while (i < 27) { host[dyAOff + i] = float(rnd()); i = i + 1; }
            // CPU
            i = 0; while (i < CAP) { cpu[i] = host[i]; i = i + 1; }
            InferOps.bwdAvgPool3D(cpu, dyAOff, xAOff, 1, 1, 5, 5, 5, dxAOff, 3, 3, 3,
                                  2, 2, 2, 2, 2, 2, 1, 0, 1, 0, 1, 0, 0);
            // GPU
            i = 0; while (i < CAP) { gpuA[i] = host[i]; i = i + 1; }
            buf.copyFromHost(gpuA, 0, 0, CAP);
            GpuInferOps.bwdAvgPool3D(gpuA, dev, dyAOff, xAOff, 1, 1, 5, 5, 5, dxAOff, 3, 3, 3,
                                     2, 2, 2, 2, 2, 2, 1, 0, 1, 0, 1, 0, 0);
            buf.copyToHost(gpuA, 0, 0, CAP);
            fails = fails + cmpRange("bwdAvgPool3D dx", cpu, gpuA, dxAOff, 125);

            if (fails == 0) Console.writeLine("CONV3D GRAD CHECK GPU OK");
            else Console.writeLine("CONV3D GRAD CHECK GPU FAIL (" + Fmt.i(fails) + ")");
        }

        // 逐元素对拍：返回不一致元素数（容差 1e-3 相对）
        int cmpRange(string tag, float[] cpu, float[] gpu, int off, int n) {
            double maxDiff = 0.0;
            int bad = 0;
            int i = 0;
            while (i < n) {
                double a = double(cpu[off + i]);
                double b = double(gpu[off + i]);
                double d = a - b;
                if (d < 0.0) d = 0.0 - d;
                if (d > maxDiff) maxDiff = d;
                if (d > 1.0e-3 * (1.0 + Math.abs(a) + Math.abs(b))) bad = bad + 1;
                i = i + 1;
            }
            Console.writeString(tag + " n=" + Fmt.i(n) + " maxDiff=" + Fmt.f(maxDiff, 6) + " bad=" + Fmt.i(bad));
            Console.writeLine("");
            return bad;
        }

        double rnd() {
            seed_ = (seed_ * 1103515245.0 + 12345.0) % 2147483648.0;
            return float(seed_ % 1000000) / 1000000.0;
        }

    property:
        double seed_;
}

int main() {
    Conv3DGradCheckGpu t = new Conv3DGradCheckGpu();
    return 0;
}
