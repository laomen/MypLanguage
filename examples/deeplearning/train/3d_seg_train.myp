// 3d_seg_train.myp — 阶段4d：3D 分割 CNN + Dice loss 端到端训练
// （验证 Dice loss 图集成：setLossMode(1) → DiceLoss+BwdSoftmax 反向链）
//
// 模型：deeplearning/data/onnx/3d_seg.onnx
//   Conv3D(1→4,k3,p1) → ReLU → Conv3D(4→2,k3,p1) → Softmax(prob)
// 数据：合成 8³ 体素，2 类分割——中心 4³ 块=前景、其余=背景（含噪声）。
// 训练：batch=1 纯 SGD + Dice loss；MYP_GPU=1 走 runGpu，否则 CPU run()。
//
// 运行（须在 examples/ 下）：
//   deeplearning/infer/tools/onnxvenv/bin/python deeplearning/infer/tools/make_3d_seg_onnx.py
//   ./build/mypc examples/deeplearning/train/3d_seg_train.myp -o /tmp/3d_seg_train --stdlib stdlib && /tmp/3d_seg_train

import env;
import fmt;
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class Seg3DTrain {
    action:
        @constructor Seg3DTrain() {
            seed_ = 20260831.0;
            int D = 8; int H = 8; int W = 8;
            int NIN = D * H * W;        // 512 体素
            int NLAB = 2 * NIN;         // one-hot [2,512]
            int NTRAIN = 400;
            int NTEST = 100;
            int EPOCHS = 30;
            float[] x = new float[NTRAIN * NIN];
            float[] lab = new float[NTRAIN * NLAB];
            genData(x, lab, NTRAIN, NIN, 1);
            float[] xt = new float[NTEST * NIN];
            float[] labt = new float[NTEST * NLAB];
            genData(xt, labt, NTEST, NIN, 2);

            InferenceRuntime rt = new InferenceRuntime();
            rt.init(4000000);
            OnnxLoader loader = new OnnxLoader();
            loader.setLossMode(1);   // Dice loss（阶段4d）
            int ok = loader.loadTrain("./deeplearning/data/onnx/3d_seg.onnx", rt);
            if (ok == 0) { Console.writeLine("loadTrain failed"); return; }
            int dataTid = loader.tensorId("data");
            int labelTid = loader.tensorId("label");
            int lossTid = loader.tensorId("loss");
            int probTid = loader.tensorId("prob");
            if (dataTid < 0 || labelTid < 0 || lossTid < 0 || probTid < 0) {
                Console.writeLine("tensor not found");
                return;
            }

            if (rt.gpuPersistentStart() == 1) {
                rt.markGpuSync(lossTid);
                rt.markGpuSync(probTid);
            }

            int preAcc = testIoU(rt, probTid, dataTid, xt, labt, NIN, NTEST);
            Console.writeString("PRE-TRAIN acc=");
            Console.write(preAcc);
            Console.writeString("%");
            Console.writeLine("");

            double lr = 20.0;
            int bestAcc = 0;
            int epoch = 0;
            while (epoch < EPOCHS) {
                if (epoch == 15) lr = 5.0;
                rt.setLr(lr);
                rt.setTrain(1);
                double lossSum = 0.0;
                int s = 0;
                while (s < NTRAIN) {
                    int j = 0;
                    while (j < NIN) { rt.setFlat(dataTid, j, double(x[s * NIN + j])); j = j + 1; }
                    j = 0;
                    while (j < NLAB) { rt.setFlat(labelTid, j, double(lab[s * NLAB + j])); j = j + 1; }
                    step(rt);
                    lossSum = lossSum + rt.getFlat(lossTid, 0);
                    s = s + 1;
                }
                int acc = testIoU(rt, probTid, dataTid, xt, labt, NIN, NTEST);
                if (acc > bestAcc) bestAcc = acc;
                Console.writeString("epoch ");
                Console.write(epoch);
                Console.writeString(" dice=");
                Console.writeFloat(lossSum / NTRAIN);
                Console.writeString(" acc=");
                Console.write(acc);
                Console.writeString("%");
                Console.writeLine("");
                epoch = epoch + 1;
            }

            Console.writeString("3D-SEG best acc=");
            Console.write(bestAcc);
            Console.writeString("%");
            Console.writeLine("");
            if (bestAcc >= 90) Console.writeLine("3D SEG TRAIN OK");
            else Console.writeLine("3D SEG TRAIN FAIL");
            rt.gpuPersistentEnd();
        }

        // 合成 3D 分割数据：上半体（d<4）前景(类0)、下半体背景(类1)，50/50 平衡；one-hot [2,NIN]
        void genData(float[] out, float[] lab, int n, int NIN, int seedTag) {
            int D = 8; int H = 8; int W = 8;
            int s = 0;
            while (s < n) {
                int base = s * NIN;
                int lbase = s * 2 * NIN;
                int d = 0;
                while (d < D) {
                    int h = 0;
                    while (h < H) {
                        int w = 0;
                        while (w < W) {
                            int v = d * H * W + h * W + w;
                            int fg = 0;
                            if (d < 4) fg = 1;
                            float val = 0.05f;
                            if (fg == 1) val = 1.0f;
                            val = val + float(rnd() * 0.05);
                            out[base + v] = val;
                            lab[lbase + 0 * NIN + v] = (fg == 1) ? 1.0f : 0.0f;
                            lab[lbase + 1 * NIN + v] = (fg == 1) ? 0.0f : 1.0f;
                            w = w + 1;
                        }
                        h = h + 1;
                    }
                    d = d + 1;
                }
                s = s + 1;
            }
        }

        // 像素准确率：argmax(prob) per 体素 vs label
        int testIoU(InferenceRuntime rt, int probTid, int dataTid, float[] xt, float[] labt, int NIN, int n) {
            rt.setTrain(0);
            int correct = 0;
            int s = 0;
            while (s < n) {
                int j = 0;
                while (j < NIN) { rt.setFlat(dataTid, j, double(xt[s * NIN + j])); j = j + 1; }
                step(rt);
                int v = 0;
                while (v < NIN) {
                    // prob 布局 [2, NIN]：foreground prob = prob[0*NIN+v]
                    double pfg = rt.getFlat(probTid, 0 * NIN + v);
                    double pbg = rt.getFlat(probTid, 1 * NIN + v);
                    int pred = (pfg >= pbg) ? 0 : 1;
                    int gt = (labt[s * 2 * NIN + 0 * NIN + v] > 0.5f) ? 0 : 1;
                    if (pred == gt) correct = correct + 1;
                    v = v + 1;
                }
                s = s + 1;
            }
            return correct * 100 / (n * NIN);
        }

        void step(InferenceRuntime rt) {
            if (Console.getEnv("MYP_GPU") == "1") rt.runGpu();
            else rt.run();
        }

        double rnd() {
            seed_ = (seed_ * 1103515245.0 + 12345.0) % 2147483648.0;
            return float(seed_ % 1000000) / 1000000.0;
        }

    property:
        double seed_;
}

int main() {
    Seg3DTrain t = new Seg3DTrain();
    return 0;
}
