// 3d_unet_skip_grad_check.myp — 阶段4f：带跳跃连接 3D U-Net 全图反向梯度数值对拍
// （验证 bwdConcat 图集成 + GradAcc 多消费者梯度累加）
// 对 e1_w/e4_w/d1_w/d3_w 各取若干元素：解析 dL/dw（运行时反向，含 concat 路径）
// vs 中心差分（扰动权重 → 前向 → Dice loss）。
//   e1_w 梯度 = conv(e1→…) 路径 + r1→cat2(skip) concat 路径 + r1→e2→e3→r3→cat1 concat 路径
//   e4_w 梯度含 r3→cat1 concat 路径。二者正确 → bwdConcat + GradAcc 图集成正确。
//
// 运行（须在 examples/ 下）：
//   deeplearning/infer/tools/onnxvenv/bin/python deeplearning/infer/tools/make_3d_unet_skip_onnx.py
//   ./build/mypc examples/deeplearning/train/3d_unet_skip_grad_check.myp -o /tmp/u_sgc --stdlib stdlib
//   cd examples && /tmp/u_sgc

import env;
import fmt;
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class UnetSkipGradCheck {
    action:
        @constructor UnetSkipGradCheck() {
            seed_ = 20260901.0;
            int D = 8; int H = 8; int W = 8;
            int NIN = D * H * W;
            float[] x = new float[NIN];
            int d = 0;
            while (d < D) {
                int h = 0;
                while (h < H) {
                    int w = 0;
                    while (w < W) {
                        int v = d * H * W + h * W + w;
                        x[v] = 0.05f;
                        if (d < 4) x[v] = 1.0f;
                        w = w + 1;
                    }
                    h = h + 1;
                }
                d = d + 1;
            }

            InferenceRuntime rt = new InferenceRuntime();
            rt.init(8000000);
            OnnxLoader loader = new OnnxLoader();
            loader.setLossMode(1);
            int ok = loader.loadTrain("./deeplearning/data/onnx/3d_unet_skip.onnx", rt);
            if (ok == 0) { Console.writeLine("loadTrain failed"); return; }
            int dataTid = loader.tensorId("data");
            int labelTid = loader.tensorId("label");
            int lossTid = loader.tensorId("loss");
            if (dataTid < 0 || labelTid < 0 || lossTid < 0) { Console.writeLine("tensor missing"); return; }

            // 灌数据 + one-hot label（d<4 前景）
            int j = 0;
            while (j < NIN) { rt.setFlat(dataTid, j, double(x[j])); j = j + 1; }
            j = 0;
            while (j < NIN) {
                int fg = (j < 4 * 64) ? 1 : 0;
                rt.setFlat(labelTid, j, double((fg == 1) ? 1.0 : 0.0));
                rt.setFlat(labelTid, NIN + j, double((fg == 1) ? 0.0 : 1.0));
                j = j + 1;
            }

            int fails = 0;
            string[] wnames = new string[4];
            wnames[0] = "e1_w"; wnames[1] = "e4_w"; wnames[2] = "d1_w"; wnames[3] = "d3_w";
            double eps = 1.0e-3;
            rt.setLr(0.0);   // Update 无副作用：train 模式前向算 loss、反向算梯度
            int wi = 0;
            while (wi < 4) {
                int wTid = loader.tensorId(wnames[wi]);
                int gTid = loader.tensorId(wnames[wi] + "#g");
                if (wTid < 0 || gTid < 0) { Console.writeLine("w missing " + wnames[wi]); wi = wi + 1; continue; }
                int wsz = rt.tensorSizeDebug(wTid);
                // 采样 4 个元素（跨索引）
                int[] idx = new int[4];
                idx[0] = 0; idx[1] = wsz / 8; idx[2] = wsz / 3; idx[3] = wsz - 1;
                int k = 0;
                while (k < 4) {
                    int e = idx[k];
                    // 解析梯度
                    rt.setTrain(1);
                    rt.run();
                    double analytic = rt.getFlat(gTid, e);
                    // 数值：扰动前向
                    double base = rt.getFlat(wTid, e);
                    rt.setFlat(wTid, e, base + eps);
                    rt.run();
                    double Lp = rt.getFlat(lossTid, 0);
                    rt.setFlat(wTid, e, base - eps);
                    rt.run();
                    double Lm = rt.getFlat(lossTid, 0);
                    rt.setFlat(wTid, e, base);
                    double numeric = (Lp - Lm) / (2.0 * eps);
                    Console.writeString(wnames[wi] + "[" + Fmt.i(e) + "] analytic=" + Fmt.f(analytic, 5) + " numeric=" + Fmt.f(numeric, 5));
                    Console.writeLine("");
                    if (Math.abs(analytic - numeric) > 5.0e-2 * (1.0 + Math.abs(analytic) + Math.abs(numeric))) fails = fails + 1;
                    k = k + 1;
                }
                wi = wi + 1;
            }

            if (fails == 0) Console.writeLine("3D UNET SKIP GRAD CHECK OK");
            else Console.writeLine("3D UNET SKIP GRAD CHECK FAIL (" + Fmt.i(fails) + ")");
        }

    property:
        double seed_;
}

int main() {
    UnetSkipGradCheck t = new UnetSkipGradCheck();
    return 0;
}
