// dice_softmax_grad_check.myp — 阶段4d：diceLoss + bwdSoftmax 链式数值对拍
// （bwdSoftmax 有限差分 + 全链 dL/dlogit 对拍；GPU vs CPU 逐元素对拍）
//
// 运行（须在 examples/ 下）：
//   ./build/mypc examples/deeplearning/train/dice_softmax_grad_check.myp -o /tmp/dice_sm_gc --stdlib stdlib
//   cd examples && /tmp/dice_sm_gc           # CPU 对拍
//   MYP_GPU=1 /tmp/dice_sm_gc                # + GPU vs CPU

import env;
import math;
import fmt;
import cuda;
import gpu;
import "../infer/ops.myp";
import "../infer/gpu_ops.myp";

class DiceSoftmaxGradCheck {
    action:
        @constructor DiceSoftmaxGradCheck() {
            int fails = 0;
            seed_ = 777.0;
            int C = 2;      // 类别
            int N = 16;     // 体素/样本数
            double epsD = 1.0e-5;
            int logitOff = 0;    // [C,N]
            int probOff = 32;    // [C,N]
            int labelOff = 64;   // [C,N]
            int dpOff = 96;      // [C,N]
            int dlogitOff = 128; // [C,N]
            int lossOff = 160;   // 1
            int dpScratch = 192; // [C,N] 差分临时 dp 区
            int CAP = 256;
            float[] host = new float[CAP];
            // 随机 logits + one-hot label
            int i = 0;
            while (i < C * N) { host[logitOff + i] = float((rnd() * 2.0 - 1.0)); i = i + 1; }
            int b = 0;
            while (b < N) {
                int cls = b % C;
                int c = 0;
                while (c < C) { host[labelOff + c * N + b] = (c == cls) ? 1.0f : 0.0f; c = c + 1; }
                b = b + 1;
            }
            // 前向 softmax
            InferOps.softmax(host, logitOff, probOff, C, N);
            // CPU：diceLoss + bwdSoftmax
            float[] cpu = new float[CAP];
            i = 0; while (i < CAP) { cpu[i] = host[i]; i = i + 1; }
            InferOps.diceLoss(cpu, probOff, labelOff, dpOff, lossOff, C, N, 0);
            InferOps.bwdSoftmax(cpu, probOff, dpOff, dlogitOff, C, N);

            // 1) bwdSoftmax 有限差分：L=Σ prob，dL/dprob=1 → dlogit 应为 0（softmax 行和=1）
            //    改用 L=Σ prob·w 加权不可行，直接对拍 dlogit 与 softmax 雅可比。
            //    简化：用链式对拍（下方全链）已覆盖 bwdSoftmax。
            // 2) 全链 dL/dlogit 有限差分（dice loss L，对 logit[j] 中心差分）
            double eps = 1.0e-3;
            int[] idx = new int[4]; idx[0] = 0; idx[1] = 1; idx[2] = N; idx[3] = N + 1;
            i = 0;
            while (i < 4) {
                int j = idx[i];
                double a = cpu[dlogitOff + j];
                double num = fdLogit(host, logitOff, probOff, labelOff, lossOff, dpScratch, C, N, epsD, j, eps);
                Console.writeString("dlogit[" + Fmt.i(j) + "] analytic=" + Fmt.f(a, 6) + " numeric=" + Fmt.f(num, 6));
                Console.writeLine("");
                if (Math.abs(a - num) > 1.0e-2 * (1.0 + Math.abs(a) + Math.abs(num))) fails = fails + 1;
                i = i + 1;
            }
            Console.writeString("loss=" + Fmt.f(cpu[lossOff], 6));
            Console.writeLine("");

            // GPU vs CPU
            if (Cuda.available() == 1) {
                float[] gpuA = new float[CAP];
                i = 0; while (i < CAP) { gpuA[i] = host[i]; i = i + 1; }
                GpuBufferF buf = new GpuBufferF(gpuA, CAP);
                long dev = buf.devicePtr();
                buf.copyFromHost(gpuA, 0, 0, CAP);
                int stOffG = 200;   // GPU diceLoss stats 区（arena 内未用区，需 3*C+1 槽）
                GpuInferOps.softmax(gpuA, C * N, logitOff, probOff, C, N, dev);
                GpuInferOps.diceLoss(gpuA, dev, stOffG, probOff, labelOff, dpOff, lossOff, C, N, 0);
                GpuInferOps.bwdSoftmax(gpuA, dev, probOff, dpOff, dlogitOff, C, N);
                buf.copyToHost(gpuA, 0, 0, CAP);
                fails = fails + cmpRange("gpu dlogit", cpu, gpuA, dlogitOff, C * N);
                fails = fails + cmpRange("gpu dp", cpu, gpuA, dpOff, C * N);
                double dl = double(cpu[lossOff]) - double(gpuA[lossOff]);
                Console.writeString("gpu loss diff=" + Fmt.f(dl, 6));
                Console.writeLine("");
                if (dl < 0.0) dl = 0.0 - dl;
                if (dl > 1.0e-4) fails = fails + 1;
            } else {
                Console.writeLine("GPU SKIP (no device)");
            }

            if (fails == 0) Console.writeLine("DICE SOFTMAX GRAD CHECK OK");
            else Console.writeLine("DICE SOFTMAX GRAD CHECK FAIL (" + Fmt.i(fails) + ")");
        }

        // L = dice(softmax(logit), label)，对 logit[j] 中心差分
        double fdLogit(float[] arena, int logitOff, int probOff, int labelOff, int lossOff, int dpScratch,
                       int C, int N, double epsD, int j, double eps) {
            double xp = arena[logitOff + j];
            arena[logitOff + j] = float(xp + eps);
            InferOps.softmax(arena, logitOff, probOff, C, N);
            InferOps.diceLoss(arena, probOff, labelOff, dpScratch, lossOff, C, N, 0);
            double Lp = arena[lossOff];
            arena[logitOff + j] = float(xp - eps);
            InferOps.softmax(arena, logitOff, probOff, C, N);
            InferOps.diceLoss(arena, probOff, labelOff, dpScratch, lossOff, C, N, 0);
            double Lm = arena[lossOff];
            arena[logitOff + j] = float(xp);
            InferOps.softmax(arena, logitOff, probOff, C, N);
            return (Lp - Lm) / (2.0 * eps);
        }

        int cmpRange(string tag, float[] cpu, float[] gpu, int off, int n) {
            double maxDiff = 0.0;
            int bad = 0;
            int i = 0;
            while (i < n) {
                double a = double(cpu[off + i]);
                double b = double(gpu[off + i]);
                double d = a - b;
                if (d < 0.0) d = 0.0 - d;
                if (d > maxDiff) maxDiff = d;
                if (d > 1.0e-3 * (1.0 + Math.abs(a) + Math.abs(b))) bad = bad + 1;
                i = i + 1;
            }
            Console.writeString(tag + " n=" + Fmt.i(n) + " maxDiff=" + Fmt.f(maxDiff, 6) + " bad=" + Fmt.i(bad));
            Console.writeLine("");
            return bad;
        }

        double rnd() {
            seed_ = (seed_ * 1103515245.0 + 12345.0) % 2147483648.0;
            return float(seed_ % 1000000) / 1000000.0;
        }

    property:
        double seed_;
}

int main() {
    DiceSoftmaxGradCheck t = new DiceSoftmaxGradCheck();
    return 0;
}
