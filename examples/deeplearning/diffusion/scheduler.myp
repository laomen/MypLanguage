// scheduler.myp — D1 扩散调度器（DDIM，η=0）纯 MYP 验证
//
// 验证 MYP 调度器数学 vs numpy float64 参考（diffusers DDIMScheduler 公式）：
//   x_prev = sqrt(α_prev)·x0 + sqrt(1-α_prev)·ε
//   x0     = (x_t - sqrt(1-α_t)·ε) / sqrt(α_t)
// 输入（verify_scheduler.py 生成，fp32 与参考同源）：
//   ./deeplearning/data/diffusion/sched/sched_alphas.bin  fp32×1000  alphas_cumprod
//   ./deeplearning/data/diffusion/sched/sched_tsteps.bin  i32×N     时间步（降序）
//   ./deeplearning/data/diffusion/sched/sched_x.bin       fp32×L    初始 latent
// 输出：
//   ./deeplearning/data/diffusion/sched/sched_out.bin     fp32×L    最终 latent
// 哑模型 ε = 0.5·x（确定性，只验证调度器簿记，不涉 UNet）。
//
// 运行（须在 examples/ 下；verify_scheduler.py 会自动编译+运行+对拍）：
//   cd examples && /tmp/sched
import env;
import math;
import "../infer/pb.myp";   // F32.toDouble / F32.toBits

class SchedMain {
    property:
        double[] alpha_;   // alphas_cumprod（F32.toDouble 精确读入）
        int[] tsteps_;
        double[] x_;
        double[] out_;

    action:
        @constructor SchedMain() {
            int L = 16384;         // 64×64×4 latent
            int NMAX = 200;        // 时间步上限
            alpha_ = new double[1000];
            tsteps_ = new int[NMAX];
            x_ = new double[L];
            out_ = new double[L];

            // ---- 读 alphas_cumprod（fp32 → double 精确）----
            int fd = __myp_io_fopen("./deeplearning/data/diffusion/sched/sched_alphas.bin", "rb");
            if (fd < 0) { Console.writeLine("sched_alphas.bin missing — 先跑 verify_scheduler.py"); return; }
            int i = 0;
            while (i < 1000) { alpha_[i] = readF32(); i = i + 1; }
            __myp_io_fclose();

            // ---- 读时间步（i32）----
            int fd2 = __myp_io_fopen("./deeplearning/data/diffusion/sched/sched_tsteps.bin", "rb");
            if (fd2 < 0) { Console.writeLine("sched_tsteps.bin missing"); return; }
            int n = readI32();
            int k = 0;
            while (k < n) { tsteps_[k] = readI32(); k = k + 1; }
            __myp_io_fclose();

            // ---- 读初始 latent（fp32 → double）----
            int fd3 = __myp_io_fopen("./deeplearning/data/diffusion/sched/sched_x.bin", "rb");
            if (fd3 < 0) { Console.writeLine("sched_x.bin missing"); return; }
            int p = 0;
            while (p < L) { x_[p] = readF32(); p = p + 1; }
            __myp_io_fclose();

            // ---- DDIM 循环（double 精度；Math.sqrt = llvm.sqrt.f64 IEEE 正确舍入）----
            int step = 0;
            while (step < n) {
                int t = tsteps_[step];
                int prev_t = (step + 1 < n) ? tsteps_[step + 1] : -1;
                double at = alpha_[t];
                double aPrev = (prev_t >= 0) ? alpha_[prev_t] : 1.0;
                double bt = 1.0 - at;
                double bPrev = 1.0 - aPrev;
                double rAt = Math.sqrt(at);
                double rBt = Math.sqrt(bt);
                double rBp = Math.sqrt(bPrev);
                double rAp = Math.sqrt(aPrev);
                int q = 0;
                while (q < L) {
                    double x = x_[q];
                    double eps = 0.5 * x;                  // 哑模型（确定性）
                    double x0 = (x - rBt * eps) / rAt;
                    out_[q] = rAp * x0 + rBp * eps;
                    q = q + 1;
                }
                int c = 0;
                while (c < L) { x_[c] = out_[c]; c = c + 1; }
                step = step + 1;
            }

            // ---- 写输出（fp32 LE）----
            int fd4 = __myp_io_fopen("./deeplearning/data/diffusion/sched/sched_out.bin", "wb");
            if (fd4 >= 0) {
                int j = 0;
                while (j < L) {
                    int bits = F32.toBits(out_[j]);
                    __myp_io_write_byte(bits & 255);
                    __myp_io_write_byte((bits >> 8) & 255);
                    __myp_io_write_byte((bits >> 16) & 255);
                    __myp_io_write_byte((bits >> 24) & 255);
                    j = j + 1;
                }
                __myp_io_fclose();
                Console.writeLine("sched_out.bin written");
            }
            Console.writeString("DDIM steps="); Console.write(n); Console.writeLine("");
        }

        double readF32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) return 0.0;
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }

        int readI32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0) b0 = 0;
            if (b1 < 0) b1 = 0;
            if (b2 < 0) b2 = 0;
            if (b3 < 0) b3 = 0;
            return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
        }
}
int main() { SchedMain m = new SchedMain(); return 0; }
