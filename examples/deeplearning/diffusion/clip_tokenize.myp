// clip_tokenize.myp — D2b：CLIP 分词器（GPT-2 ByteLevel BPE）文本 → 77 ids + mask，对拍 CLIPTokenizer
//
// 复用 llm/bpe.myp 的 Bpe（GPT-2 ByteLevel BPE 三阶段：字节编码 → 预分词 → BPE 合并），
// 表为 CLIP 词表（data/diffusion/clip/bpe_*，make_clip_bpe_tables.py 生成）。
// CLIP 特殊 token：<|startoftext|>=49406，<|endoftext|>=49407。
// 流程：读 d2b_prompt.txt（UTF-8 字节）→ bpe.encode 得 token ids → [sot]+ids+[eot] → 补 49407 到 77
//   → mask（有效位置含 eot 为 1，padding 为 0）→ 对拍 d2b_ref_ids/mask → CLIP TOKENIZE OK/FAIL
//   → 写 prompt_ids.bin + prompt_mask.bin（供 clip_encoder.myp 前向）。
// 运行（须在 examples/ 下）：../../build/mypc -O3 deeplearning/diffusion/clip_tokenize.myp -o /tmp/cliptok --stdlib ../stdlib
import env;
import fmt;
import math;
import "../llm/bpe.myp";

class ClipTok {
    action:
        @constructor ClipTok() {
            int MAX = 77;
            int SOT = 49406;
            int EOT = 49407;
            int[] text = new int[4096];
            int[] ids = new int[512];
            int[] prompt = new int[MAX];
            int[] mask = new int[MAX];
            int[] refIds = new int[MAX];
            int[] refMask = new int[MAX];

            // ---- 读 prompt 文本（UTF-8 字节）----
            int nText = 0;
            int fd = __myp_io_fopen("./deeplearning/data/diffusion/clip/d2b_prompt.txt", "rb");
            if (fd < 0) { Console.writeLine("d2b_prompt.txt missing"); return; }
            int ch = __myp_io_read_byte();
            while (ch >= 0 && nText < 4096) { text[nText] = ch; nText = nText + 1; ch = __myp_io_read_byte(); }
            __myp_io_fclose();

            // ---- BPE 编码（CLIP 表；encodeClip = CLIP 式 </w> 词尾）----
            Bpe bpe = new Bpe();
            int lrc = bpe.load("./deeplearning/data/diffusion/clip/");
            if (lrc != 0) { Console.writeLine("CLIP bpe tables missing"); return; }
            int nTok = bpe.encodeClip(text, 0, nText, ids);
            Console.writeString("MYP BPE: " + Fmt.i(nText) + " bytes -> " + Fmt.i(nTok) + " tokens");
            Console.writeLine("");

            // ---- [sot] + ids + [eot]，补到 77 ----
            int nValid = nTok + 2;
            int p = 0;
            while (p < MAX) {
                if (p == 0) prompt[p] = SOT;
                else if (p <= nTok) prompt[p] = ids[p - 1];
                else if (p == nTok + 1) prompt[p] = EOT;
                else prompt[p] = EOT;
                if (p < nValid) mask[p] = 1;
                else mask[p] = 0;
                p = p + 1;
            }

            // ---- 对拍 CLIPTokenizer 参考 ----
            int fd2 = __myp_io_fopen("./deeplearning/data/diffusion/clip/d2b_ref_ids.bin", "rb");
            if (fd2 < 0) { Console.writeLine("d2b_ref_ids.bin missing"); return; }
            int i = 0;
            while (i < MAX) { refIds[i] = readI32(); i = i + 1; }
            __myp_io_fclose();
            int fd3 = __myp_io_fopen("./deeplearning/data/diffusion/clip/d2b_ref_mask.bin", "rb");
            if (fd3 < 0) { Console.writeLine("d2b_ref_mask.bin missing"); return; }
            i = 0;
            while (i < MAX) { refMask[i] = readI32(); i = i + 1; }
            __myp_io_fclose();
            int bad = 0;
            i = 0;
            while (i < MAX) {
                if (prompt[i] != refIds[i]) bad = bad + 1;
                if (mask[i] != refMask[i]) bad = bad + 1;
                i = i + 1;
            }
            Console.writeString("MYP ids[:12]=");
            i = 0; while (i < 12) { Console.write(prompt[i]); Console.writeString(" "); i = i + 1; }
            Console.writeLine("");
            Console.writeString("MYP nValid="); Console.write(nValid); Console.writeLine("");
            if (bad == 0) Console.writeLine("CLIP TOKENIZE OK");
            else { Console.writeString("CLIP TOKENIZE FAIL bad="); Console.write(bad); Console.writeLine(""); }

            // ---- 写 prompt_ids.bin + prompt_mask.bin（供 clip_encoder.myp）----
            int fo = __myp_io_fopen("./deeplearning/data/diffusion/clip/prompt_ids.bin", "wb");
            if (fo >= 0) {
                i = 0;
                while (i < MAX) {
                    __myp_io_write_byte(prompt[i] & 255);
                    __myp_io_write_byte((prompt[i] >> 8) & 255);
                    __myp_io_write_byte((prompt[i] >> 16) & 255);
                    __myp_io_write_byte((prompt[i] >> 24) & 255);
                    i = i + 1;
                }
                __myp_io_fclose();
            }
            int fo2 = __myp_io_fopen("./deeplearning/data/diffusion/clip/prompt_mask.bin", "wb");
            if (fo2 >= 0) {
                i = 0;
                while (i < MAX) {
                    __myp_io_write_byte(mask[i] & 255);
                    __myp_io_write_byte((mask[i] >> 8) & 255);
                    __myp_io_write_byte((mask[i] >> 16) & 255);
                    __myp_io_write_byte((mask[i] >> 24) & 255);
                    i = i + 1;
                }
                __myp_io_fclose();
                Console.writeLine("prompt_ids.bin + prompt_mask.bin written");
            }
        }

        int readI32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0) b0 = 0;
            if (b1 < 0) b1 = 0;
            if (b2 < 0) b2 = 0;
            if (b3 < 0) b3 = 0;
            return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
        }
}
int main() { ClipTok c = new ClipTok(); return 0; }
