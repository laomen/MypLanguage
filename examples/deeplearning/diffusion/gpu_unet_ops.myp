// gpu_unet_ops.myp — D6：SD1.5 UNet/VAE 专属算子 GPU 版（@gpu for resident，与 CPU 语义一致）
//
// 复用 GpuInferOps：conv（NCHW）、dense/matmul、silu、gelu、layernorm（见 infer/gpu_ops.myp）。
// 本文件补 UNet/VAE 专属 4 个 GPU 算子 + 3 个辅助（与 unet_ops.myp CPU 语义一致）：
//   groupNorm（组并行）、attention2（跨 kvS 非因果，per-head scOff = heads*S*kvS）、
//   geglu（gelu erf 内联）、nearestUpsample2x、addFlat、addChan、concatCC。
// 约定：@gpu for 内 long 索引 + long() 显式转（GPU codegen 要求）；Math.sqrt/exp 映射 libdevice。
// 使用：MYP_GPU=1 且有 CUDA 时卸载；否则 @gpu for 自动回退 CPU（结果一致）。
import env;
import math;
import atomic;
import gpu;
import gpu.stream;
import "../infer/ops.myp";
import "../infer/gpu_ops.myp";

class GpuUnetOps {
    static:
        // GroupNorm（SD1.5 norm_num_groups=32）：y[c,h,w]=(x[c,h,w]-mean_g)/sqrt(var_g+eps)*gamma[c]+beta[c]
        // 每线程一个组 g（计算该组 mean/var/apply，cpg*H*W 元素）。
        void groupNorm(float[] a, int xOff, int gOff, int bOff, int yOff,
                       int C, int H, int W, int groups, double eps, long dev) {
            int cpg = C / groups;
            int hw = H * W;
            @gpu for (long gg = 0L; gg < long(groups); gg = gg + 1L) resident(a = dev) {
                if (gg < long(groups)) {
                    int g = int(gg);
                    int nch = cpg * hw;
                    double mean = 0.0;
                    int c = 0;
                    while (c < cpg) {
                        int p = 0;
                        while (p < hw) { mean = mean + double(a[xOff + (g * cpg + c) * hw + p]); p = p + 1; }
                        c = c + 1;
                    }
                    mean = mean / double(nch);
                    double vsum = 0.0;
                    c = 0;
                    while (c < cpg) {
                        int p = 0;
                        while (p < hw) {
                            double v = double(a[xOff + (g * cpg + c) * hw + p]) - mean;
                            vsum = vsum + v * v;
                            p = p + 1;
                        }
                        c = c + 1;
                    }
                    double rstd = 1.0 / Math.sqrt(vsum / double(nch) + eps);
                    c = 0;
                    while (c < cpg) {
                        int cc = g * cpg + c;
                        int p = 0;
                        while (p < hw) {
                            double v = (double(a[xOff + cc * hw + p]) - mean) * rstd;
                            a[yOff + cc * hw + p] = float(v * double(a[gOff + cc]) + double(a[bOff + cc]));
                            p = p + 1;
                        }
                        c = c + 1;
                    }
                }
            }
        }

        // 通用非因果注意力（同 unet_ops.attention2）：q:[D,S] k/v:[D,kvS]。
        //   score[b,i,j]=Σ_dh q·k/√dh（i∈S,j∈kvS）；softmax(j)；out[b,dh,i]=Σ_j p·v。
        //   **顺序头 + 3 核分相**（2026-08 加速）：外层 while(b<heads)，每头三核：
        //   (1) score 每线程一个 (i,j)（dh MAC 全并行）；(2) softmax 行串行归约；
        //   (3) output 每线程一个 (i,d)（kvS MAC）。scOff 只需 **S*kvS**（逐头复用，
        //   自注意力 S=4096 也只 ~16.7M 暂存，避免超 4GB arena）。
        void attention2(float[] a, int qOff, int kOff, int vOff, int outOff, int scOff,
                        int D, int S, int kvS, int heads, long dev) {
            int dh = D / heads;
            double scale = 1.0 / Math.sqrt(double(dh));
            int b = 0;
            while (b < heads) {
                int bob = b * dh;
                @gpu for (long p = 0L; p < long(S) * long(kvS); p = p + 1L) resident(a = dev) {
                    if (p < long(S) * long(kvS)) {
                        int i = int(p / long(kvS));
                        int j = int(p % long(kvS));
                        double sum = 0.0;
                        int d = 0;
                        while (d < dh) {
                            sum = sum + double(a[qOff + (bob + d) * S + i]) * double(a[kOff + (bob + d) * kvS + j]);
                            d = d + 1;
                        }
                        a[scOff + int(p)] = float(sum * scale);
                    }
                }
                @gpu for (long i = 0L; i < long(S); i = i + 1L) resident(a = dev) {
                    if (i < long(S)) {
                        int ii = int(i);
                        int sb = ii * kvS;
                        float maxv = a[scOff + sb + 0];
                        int j = 1;
                        while (j < kvS) { if (a[scOff + sb + j] > maxv) maxv = a[scOff + sb + j]; j = j + 1; }
                        double sumE = 0.0;
                        j = 0;
                        while (j < kvS) {
                            double e = Math.exp(double(a[scOff + sb + j]) - double(maxv));
                            a[scOff + sb + j] = float(e);
                            sumE = sumE + e;
                            j = j + 1;
                        }
                        j = 0;
                        while (j < kvS) { a[scOff + sb + j] = float(double(a[scOff + sb + j]) / sumE); j = j + 1; }
                    }
                }
                @gpu for (long p = 0L; p < long(S) * long(dh); p = p + 1L) resident(a = dev) {
                    if (p < long(S) * long(dh)) {
                        int i = int(p / long(dh));
                        int d = int(p % long(dh));
                        int sb = i * kvS;
                        double sum = 0.0;
                        int j = 0;
                        while (j < kvS) {
                            sum = sum + double(a[scOff + sb + j]) * double(a[vOff + (bob + d) * kvS + j]);
                            j = j + 1;
                        }
                        a[outOff + (bob + d) * S + i] = float(sum);
                    }
                }
                b = b + 1;
            }
        }

        // GEGLU（SD Transformer FFN）：out[i] = a[i]·gelu(b[i])，a=前 n，b=后 n。
        // gelu 内联 erf（Abramowitz-Stegun，与 InferOps.gelu 一致，无需 gscr）。
        void geglu(float[] a, int inOff, int outOff, int n, long dev) {
            @gpu for (long i = 0L; i < long(n); i = i + 1L) resident(a = dev) {
                if (i < long(n)) {
                    int ii = int(i);
                    double x = double(a[inOff + n + ii]);
                    double z = x / 1.4142135623730951;
                    double ax = Math.abs(z);
                    double t = 1.0 / (1.0 + 0.3275911 * ax);
                    double y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(0.0 - ax * ax);
                    double erf = y;
                    if (z < 0.0) erf = 0.0 - y;
                    a[outOff + ii] = float(double(a[inOff + ii]) * (0.5 * x * (1.0 + erf)));
                }
            }
        }

        // nearest 2x 上采样：y[c,2h+dy,2w+dx] = x[c,h,w]（并行于 C*H*W 输入元素）
        void nearestUpsample2x(float[] a, int xOff, int yOff, int C, int H, int W, long dev) {
            @gpu for (long q = 0L; q < long(C) * long(H) * long(W); q = q + 1L) resident(a = dev) {
                if (q < long(C) * long(H) * long(W)) {
                    int c = int(q / (long(H) * long(W)));
                    int h = int((q % (long(H) * long(W))) / long(W));
                    int w = int(q % long(W));
                    float v = a[xOff + c * H * W + h * W + w];
                    a[yOff + c * (2 * H) * (2 * W) + (2 * h) * (2 * W) + (2 * w)] = v;
                    a[yOff + c * (2 * H) * (2 * W) + (2 * h) * (2 * W) + (2 * w + 1)] = v;
                    a[yOff + c * (2 * H) * (2 * W) + (2 * h + 1) * (2 * W) + (2 * w)] = v;
                    a[yOff + c * (2 * H) * (2 * W) + (2 * h + 1) * (2 * W) + (2 * w + 1)] = v;
                }
            }
        }

        // y[i] += x[i]
        void addFlat(float[] a, int y, int x, int n, long dev) {
            @gpu for (long i = 0L; i < long(n); i = i + 1L) resident(a = dev) {
                if (i < long(n)) { a[y + int(i)] = a[y + int(i)] + a[x + int(i)]; }
            }
        }

        // y[i] = x[i]（设备-设备拷贝；ResBlock 原地 x==y 时先拷到 xc 保留原值做残差）
        void copyFlat(float[] a, int y, int x, int n, long dev) {
            @gpu for (long i = 0L; i < long(n); i = i + 1L) resident(a = dev) {
                if (i < long(n)) { a[y + int(i)] = a[x + int(i)]; }
            }
        }

        // y[c,hw] += tp[c]（resnet time_emb 加通道）
        void addChan(float[] a, int y, int tp, int C, int hw, long dev) {
            @gpu for (long q = 0L; q < long(C) * long(hw); q = q + 1L) resident(a = dev) {
                if (q < long(C) * long(hw)) {
                    int c = int(q / long(hw));
                    int p = int(q % long(hw));
                    a[y + c * hw + p] = a[y + c * hw + p] + a[tp + c];
                }
            }
        }

        // out[(c1+c2),H,W] = [x[c1], z[c2]]（通道拼接）
        void concatCC(float[] a, int x, int z, int out, int c1, int c2, int H, int W, long dev) {
            int hw = H * W;
            @gpu for (long q = 0L; q < long(c1 + c2) * long(hw); q = q + 1L) resident(a = dev) {
                if (q < long(c1 + c2) * long(hw)) {
                    int c = int(q / long(hw));
                    int p = int(q % long(hw));
                    if (c < c1) a[out + c * hw + p] = a[x + c * hw + p];
                    else a[out + c * hw + p] = a[z + (c - c1) * hw + p];
                }
            }
        }
}
