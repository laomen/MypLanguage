{ "name":"unet3d",
  "inputs":[{"name":"data","dims":[1,1,8,32,32]}],
  "outputs":["prob"],
  "layers":[
    {"op":"Conv3D","in":"data","out":"e0","kernel":[3,3,3],"strides":[1,1,1],"pads":[1,1,1,1,1,1],
     "W":{"dims":[8,1,3,3,3],"init":"xavier"},"B":{"dims":[8],"init":"zeros"}},
    {"op":"Relu","in":"e0","out":"a0"},
    {"op":"Conv3D","in":"a0","out":"e1","kernel":[3,3,3],"strides":[1,1,1],"pads":[1,1,1,1,1,1],
     "W":{"dims":[8,8,3,3,3],"init":"xavier"},"B":{"dims":[8],"init":"zeros"}},
    {"op":"Relu","in":"e1","out":"a1"},

    {"op":"MaxPool3D","in":"a1","out":"p1","kernel":[2,2,2],"strides":[2,2,2]},
    {"op":"Conv3D","in":"p1","out":"e2","kernel":[3,3,3],"strides":[1,1,1],"pads":[1,1,1,1,1,1],
     "W":{"dims":[16,8,3,3,3],"init":"xavier"},"B":{"dims":[16],"init":"zeros"}},
    {"op":"Relu","in":"e2","out":"a2"},
    {"op":"Conv3D","in":"a2","out":"e3","kernel":[3,3,3],"strides":[1,1,1],"pads":[1,1,1,1,1,1],
     "W":{"dims":[16,16,3,3,3],"init":"xavier"},"B":{"dims":[16],"init":"zeros"}},
    {"op":"Relu","in":"e3","out":"a3"},

    {"op":"MaxPool3D","in":"a3","out":"p2","kernel":[2,2,2],"strides":[2,2,2]},
    {"op":"Conv3D","in":"p2","out":"b0","kernel":[3,3,3],"strides":[1,1,1],"pads":[1,1,1,1,1,1],
     "W":{"dims":[32,16,3,3,3],"init":"xavier"},"B":{"dims":[32],"init":"zeros"}},
    {"op":"Relu","in":"b0","out":"b1"},
    {"op":"Conv3D","in":"b1","out":"b2","kernel":[3,3,3],"strides":[1,1,1],"pads":[1,1,1,1,1,1],
     "W":{"dims":[32,32,3,3,3],"init":"xavier"},"B":{"dims":[32],"init":"zeros"}},
    {"op":"Relu","in":"b2","out":"b3"},

    {"op":"Resize","in":"b3","out":"u0","sizes":[1,32,4,16,16],"mode":"nearest"},
    {"op":"Concat","in":"u0","out":"c0","in2":"a3","axis":1},
    {"op":"Conv3D","in":"c0","out":"d0","kernel":[3,3,3],"strides":[1,1,1],"pads":[1,1,1,1,1,1],
     "W":{"dims":[16,48,3,3,3],"init":"xavier"},"B":{"dims":[16],"init":"zeros"}},
    {"op":"Relu","in":"d0","out":"d1"},

    {"op":"Resize","in":"d1","out":"u1","sizes":[1,16,8,32,32],"mode":"nearest"},
    {"op":"Concat","in":"u1","out":"c1","in2":"a1","axis":1},
    {"op":"Conv3D","in":"c1","out":"d2","kernel":[3,3,3],"strides":[1,1,1],"pads":[1,1,1,1,1,1],
     "W":{"dims":[8,24,3,3,3],"init":"xavier"},"B":{"dims":[8],"init":"zeros"}},
    {"op":"Relu","in":"d2","out":"d3"},
    {"op":"Conv3D","in":"d3","out":"logits","kernel":[1,1,1],"strides":[1,1,1],
     "W":{"dims":[1,8,1,1,1],"init":"xavier"},"B":{"dims":[1],"init":"zeros"}},
    {"op":"Sigmoid","in":"logits","out":"prob"}
  ]
}
