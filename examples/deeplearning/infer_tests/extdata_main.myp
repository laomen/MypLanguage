// extdata_main.myp — 阶段七：ONNX external data（外置权重）测试
// extdata_test.onnx：Conv(w[1,1,3,3], b[1])，权重存 extdata_test.bin。
// 验证：loader 识别 external data、读外部文件追加、输出 vs ORT 一致（CPU+GPU）。
import env;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class ExtDataTestApp {
    action:
        @constructor ExtDataTestApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/extdata_test.onnx", rt);
            if (ok == 0) { Console.writeLine("load failed"); return; }
            Console.writeString("graph: ops=");
            Console.writeLong(rt.opCount());
            Console.writeLine("");

            int inT = loader.tensorId("x");
            int outT = loader.tensorId("y");
            if (inT < 0 || outT < 0) { Console.writeLine("tensor not found"); return; }
            int nIn = rt.tensorSize(inT);
            double[] buf = new double[64];
            readF32("./deeplearning/data/onnx/extdata_in.f32", buf, nIn);
            int i = 0;
            while (i < nIn) { rt.setFlat(inT, i, buf[i]); i = i + 1; }
            int useGpu = 0;
            if (Console.getEnv("MYP_GPU") == "1") useGpu = 1;
            if (useGpu == 1) rt.runGpu(); else rt.run();
            int m = rt.tensorSize(outT);
            Console.writeString("out size=");
            Console.writeLong(m);
            Console.writeLine("  (expect 9)");
            int okC = checkOut(rt, outT, "./deeplearning/data/onnx/extdata_test_ort.bin", m);

            if (okC == 1 && m == 9) Console.writeLine("EXTDATA ALL OK");
            else Console.writeLine("EXTDATA MISMATCH");
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path, int n) {
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int bad = 0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                if (dv > 1.0e-4) bad = bad + 1;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("max diff vs ORT: ");
            Console.writeFloat(maxD);
            Console.writeString("  bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (maxD <= 1.0e-4) return 1;
            return 0;
        }
}

int main() { ExtDataTestApp app = new ExtDataTestApp(); return 0; }
