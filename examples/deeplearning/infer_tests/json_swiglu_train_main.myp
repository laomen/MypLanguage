// json_swiglu_train_main.myp — JSON SwiGLU 端到端训练（含 BwdSilu + BwdMul）。
// swiglu.json：x[1,4] → Gemm gate[1,6] → SiLU → gact；x → Gemm up[1,6]；
//   Mul(gact×up) → m[1,6] → Gemm logits[1,3] → Softmax。
// x 被 gate/up 双 Gemm fan-out（图输入 → 各自 dx 槽 guard 清空，无冲突）。
// 200 步 SGD：loss 显著降 → 图级 BwdSilu/BwdMul/BwdDense 全链工作。
import env;
import fmt;
import dl;

class JsonSwigluTrainApp {
    action:
        void feedOne(Session t, int labT, int cl) {
            double[] bx = new double[4];
            int i = 0;
            while (i < 4) { bx[i] = 0.05; i = i + 1; }
            bx[cl] = 2.0;   // class 特征尖峰（线性可分）
            t.setInput("x", bx, 4);
            i = 0;
            while (i < 3) { t.setFlat(labT, i, 0.0); i = i + 1; }
            t.setFlat(labT, cl, 1.0);
        }
        @constructor JsonSwigluTrainApp() {
            Session t = new Session();
            int tok = t.loadJsonTrain("./deeplearning/infer_tests/swiglu.json");
            Console.writeString("load="); Console.writeLong(tok); Console.writeLine("");
            if (tok == 0) { Console.writeLine("JSON SWIGLU TRAIN SKIP"); return; }
            t.setLr(0.05); t.setTrainMode(1);
            int labT = t.tensorId("label");
            double l0 = 0.0, l200 = 0.0;
            int step = 0;
            while (step < 200) {
                int cl = (step * 37) % 3;   // 轮转 3 类
                feedOne(t, labT, cl);
                t.runTrain();
                if (step == 0) l0 = t.loss();
                if (step == 199) l200 = t.loss();
                step = step + 1;
            }
            Console.writeString("loss@0="); Console.writeFloat(l0);
            Console.writeString(" loss@200="); Console.writeFloat(l200);
            Console.writeLine("");
            // 权重确实在更新（gate_W 移动）+ loss 下降
            int gw = t.tensorId("gate_W");
            int sw = t.tensorId("logits_W");
            double lr0 = l0 - l200;
            Console.writeString("gate_W tid=" + Fmt.i(gw) + " logits_W tid=" + Fmt.i(sw));
            Console.writeLine("");
            if (tok == 1 && lr0 > 0.2) Console.writeLine("JSON SWIGLU TRAIN OK");
            else Console.writeLine("JSON SWIGLU TRAIN MISMATCH");
        }
}

int main() { JsonSwigluTrainApp app = new JsonSwigluTrainApp(); return 0; }
