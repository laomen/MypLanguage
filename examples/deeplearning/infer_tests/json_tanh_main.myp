// json_tanh_main.myp — C：JSON Tanh 单输入激活（图算子 P2）。x[1,4]=[0,1,-1,2]
// → Tanh → out=[0,0.761594,-0.761594,0.964028]（手算）。CPU+GPU JSON TANH OK。
import env;
import fmt;
import dl;
class JsonTanhApp {
    action:
        @constructor JsonTanhApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/tanh.json");
            if (ok == 0) { Console.writeLine("JSON TANH SKIP (no load)"); return; }
            double[] x = new double[4];
            x[0]=0.0; x[1]=1.0; x[2]=-1.0; x[3]=2.0;
            s.setInput("x", x, 4);
            int rk = s.runAuto();
            double[] o = s.getOutput("out");
            int n = s.tensorSize("out");
            int bad = 0;
            double[] exp = new double[4];
            exp[0]=0.0; exp[1]=0.761594; exp[2]=-0.761594; exp[3]=0.964028;
            int i = 0;
            while (i < 4) { double d = o[i]-exp[i]; if (d<0.0) d=0.0-d; if (d>1.0e-4) bad=bad+1; i = i + 1; }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeLine("");
            if (ok==1 && rk==1 && n==4 && bad==0) Console.writeLine("JSON TANH OK");
            else Console.writeLine("JSON TANH FAIL");
        }
}
int main() { JsonTanhApp a = new JsonTanhApp(); return 0; }
