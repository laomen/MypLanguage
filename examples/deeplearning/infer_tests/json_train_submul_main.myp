// json_train_submul_main.myp — A2：Sub/Mul 训练反向（optimizeTrain 全链路）。
// 两个 Session（均不含 Add 汇合——Add 训练反向为框架既有未验证 bug，另记待办）：
//   (1) train_sub.json：x[1,4] → GemmC/GemmD(+Relu) → Sub(c2,d2) → Softmax(4 类)
//   (2) train_mul.json：x[1,4] → GemmA/GemmB(+Relu) → Mul(a2,b2) → Softmax(4 类)
// 各 SGD 200 步 label one-hot[4]：loss 显著下降（BwdSub/BwdMul 梯度经 BwdRelu/
// BwdDense 回传更新 Gemm 权重）。Div 反向由 bwd_rt_main.myp 数值对拍覆盖。
// CPU+GPU JSON TRAIN SUBMUL OK。
import env;
import fmt;
import dl;

class JsonTrainSubmulApp {
    action:
        @constructor JsonTrainSubmulApp() {
            int ok1 = runOne("./deeplearning/infer_tests/train_sub.json", "sub");
            int ok2 = runOne("./deeplearning/infer_tests/train_mul.json", "mul");
            if (ok1 == 1 && ok2 == 1) Console.writeLine("JSON TRAIN SUBMUL OK");
            else Console.writeLine("JSON TRAIN SUBMUL MISMATCH");
        }

        int runOne(string path, string tag) {
            Session t = new Session();
            int tok = t.loadJsonTrain(path);
            Console.writeString("load("); Console.writeString(tag); Console.writeString(")="); Console.writeLong(tok);
            Console.writeString(" ops="); Console.writeLong(t.opCount());
            Console.writeLine("");
            if (tok == 0) { Console.writeString(tag); Console.writeLine(" SKIP (no load)"); return 0; }
            t.setLr(0.02); t.setTrainMode(1);
            int labT = t.tensorId("label");
            double l0 = 0.0; double l200 = 0.0;
            int step = 0;
            while (step < 200) {
                int cl = (step * 7) % 4;
                double[] bx = new double[4];
                int i = 0;
                while (i < 4) { bx[i] = (i == cl) ? 1.0 : 0.0; i = i + 1; }
                t.setInput("x", bx, 4);
                i = 0;
                while (i < 4) { t.setFlat(labT, i, 0.0); i = i + 1; }
                t.setFlat(labT, cl, 1.0);
                t.runTrain();
                if (step == 0) l0 = t.loss();
                if (step == 199) l200 = t.loss();
                step = step + 1;
            }
            Console.writeString(tag); Console.writeString(" loss@0="); Console.writeFloat(l0);
            Console.writeString(" loss@200="); Console.writeFloat(l200);
            Console.writeLine("");
            if (tok == 1 && l0 > 0.5 && l200 < l0) return 1;
            return 0;
        }
}

int main() { JsonTrainSubmulApp app = new JsonTrainSubmulApp(); return 0; }
