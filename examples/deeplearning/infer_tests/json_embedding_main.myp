// json_embedding_main.myp — JSON Embedding（W 权重 values 手写 + ids int64）。
// W[vocab=3,D=2] values row-major [10,11,20,21,30,31]（w0=[10,11] w1=[20,21] w2=[30,31]）
// ids=[2,0,1] → out[S=3,D=2] = [[30,31],[10,11],[20,21]] flat [30,31,10,11,20,21]。
// 无图输入（W+ids 全层内声明）。CPU+GPU JSON EMBEDDING OK。
import env;
import fmt;
import dl;
class JsonEmbeddingApp {
    action:
        @constructor JsonEmbeddingApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/embedding.json");
            if (ok == 0) { Console.writeLine("JSON EMBEDDING SKIP (no load)"); return; }
            int rk = s.runAuto();
            double[] o = s.getOutput("out");
            int n = s.tensorSize("out");
            int bad = 0;
            double[] exp = new double[6];
            exp[0] = 30.0; exp[1] = 31.0; exp[2] = 10.0; exp[3] = 11.0; exp[4] = 20.0; exp[5] = 21.0;
            int i = 0;
            while (i < 6) {
                double d = o[i] - exp[i];
                if (d < 0.0) d = 0.0 - d;
                if (d > 1.0e-3) bad = bad + 1;
                i = i + 1;
            }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeLine("");
            if (ok==1 && rk==1 && n==6 && bad==0) Console.writeLine("JSON EMBEDDING OK");
            else Console.writeLine("JSON EMBEDDING MISMATCH");
        }
}
int main() { JsonEmbeddingApp a = new JsonEmbeddingApp(); return 0; }
