// json_pad_main.myp — JSON Pad（pads int64 内存常量，ONNX opset11 8 值）。
// x[1,1,3,3] 值 1..9。pads=[0,0,1,1,0,0,1,1]（[N,C,H,W] begin=[0,0,1,1] end=[0,0,1,1]
//   → H/W 上下左右各 pad 1，constant 0）→ out[1,1,5,5]：
//   row0=[0,0,0,0,0] row1=[0,1,2,3,0] row2=[0,4,5,6,0] row3=[0,7,8,9,0] row4=[0,0,0,0,0]
//   flat 25 值。CPU+GPU JSON PAD OK。
import env;
import fmt;
import dl;
class JsonPadApp {
    action:
        @constructor JsonPadApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/pad.json");
            if (ok == 0) { Console.writeLine("JSON PAD SKIP (no load)"); return; }
            double[] x = new double[9];
            int i = 0;
            while (i < 9) { x[i] = double(i + 1); i = i + 1; }
            s.setInput("x", x, 9);
            int rk = s.runAuto();
            double[] o = s.getOutput("y");
            int n = s.tensorSize("y");
            int bad = 0;
            double[] exp = new double[25];
            // row0 全 0；row1=[0,1,2,3,0]；row2=[0,4,5,6,0]；row3=[0,7,8,9,0]；row4 全 0
            i = 0;
            while (i < 25) {
                int r = i / 5;
                int c = i % 5;
                double e = 0.0;
                if (r >= 1 && r <= 3 && c >= 1 && c <= 3) {
                    e = double((r - 1) * 3 + c);   // data 1..9 放中心
                }
                exp[i] = e;
                i = i + 1;
            }
            i = 0;
            while (i < 25) {
                double d = o[i] - exp[i];
                if (d < 0.0) d = 0.0 - d;
                if (d > 1.0e-3) bad = bad + 1;
                i = i + 1;
            }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeLine("");
            if (ok==1 && rk==1 && n==25 && bad==0) Console.writeLine("JSON PAD OK");
            else Console.writeLine("JSON PAD MISMATCH");
        }
}
int main() { JsonPadApp a = new JsonPadApp(); return 0; }
