// json_gather_main.myp — A3：JSON Gather（int64 indices 内存常量，4D 数据）。
// data[1,3,2,2]：c0=0.1*4, c1=0.2*4, c2=0.3*4（NCHW flat）。Gather axis=1
// indices=[0,2] → out[1,2,2,2] = [c0, c2] = [0.1*4, 0.3*4]。
import env;
import fmt;
import dl;
class JsonGatherApp {
    action:
        @constructor JsonGatherApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/gather.json");
            Console.writeString("load ok="); Console.writeLong(ok); Console.writeLine("");
            if (ok == 0) { Console.writeLine("JSON GATHER SKIP (no load)"); return; }
            double[] x = new double[12];
            int i = 0;
            while (i < 12) {
                if (i < 4) x[i] = 0.1;
                else if (i < 8) x[i] = 0.2;
                else x[i] = 0.3;
                i = i + 1;
            }
            s.setInput("data", x, 12);
            int rk = s.runAuto();
            double[] o = s.getOutput("out");
            int n = s.tensorSize("out");
            double[] exp = new double[8];
            i = 0;
            while (i < 8) { if (i < 4) exp[i] = 0.1; else exp[i] = 0.3; i = i + 1; }
            int bad = 0;
            i = 0;
            while (i < 8) { double d = o[i]-exp[i]; if (d<0.0) d=0.0-d; if (d>1.0e-4) bad=bad+1; i=i+1; }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n);
            Console.writeString(" bad="); Console.writeLong(bad); Console.writeLine("");
            if (ok==1 && rk==1 && n==8 && bad==0) Console.writeLine("JSON GATHER OK");
            else Console.writeLine("JSON GATHER MISMATCH");
        }
}
int main() { JsonGatherApp a = new JsonGatherApp(); return 0; }
