// bwd_batch_matmul_main.myp — P9：BwdBatchMatmul（4D/batch MatMul 反向）数值对拍。
//   组1（无广播）：A[1,1,2,2]=[[1,2],[3,4]]、B[1,1,2,1]=[[5],[6]] → out=[17,39]；
//     dy=[1,2] → dA=[[5,6],[10,12]]、dB=[7,10]。
//   组2（A 沿 b0 广播，ob0=2）：A[1,1,1,2]=[2,3]、B[2,1,2,1]=[5,6,7,8]（b0=0:[5,6] b0=1:[7,8]）
//     → out=[28,38]；dy=[1,2] → dA（累加两 b0）=[19,22]、dB=[2,3,4,6]。
// 全 PASS → BWD BATCH_MATMUL OK（CPU-only 直连 runtime）。
import env;
import fmt;
import "../infer/runtime.myp";

class BwdBatchMatmulApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        @constructor BwdBatchMatmulApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            rt.setTrain(1);
            // 组1 无广播
            int a1 = rt.addTensor4(1, 1, 2, 2);
            int b1 = rt.addTensor4(1, 1, 2, 1);
            int o1 = rt.addTensor4(1, 1, 2, 1);
            int d1 = rt.addTensor4(1, 1, 2, 1);
            int da1 = rt.addTensor4(1, 1, 2, 2);
            int db1 = rt.addTensor4(1, 1, 2, 1);
            rt.setFlat(a1, 0, 1.0); rt.setFlat(a1, 1, 2.0); rt.setFlat(a1, 2, 3.0); rt.setFlat(a1, 3, 4.0);
            rt.setFlat(b1, 0, 5.0); rt.setFlat(b1, 1, 6.0);
            rt.setFlat(d1, 0, 1.0); rt.setFlat(d1, 1, 2.0);
            rt.addBwdBatchMatmul(d1, a1, b1, da1, db1, 2, 2, 1, 1, 1, 1, 1, 1, 1);
            // 组2 A 广播（ob0=2）
            int a2 = rt.addTensor4(1, 1, 1, 2);
            int b2 = rt.addTensor4(2, 1, 2, 1);
            int o2 = rt.addTensor4(2, 1, 1, 1);
            int d2 = rt.addTensor4(2, 1, 1, 1);
            int da2 = rt.addTensor4(1, 1, 1, 2);
            int db2 = rt.addTensor4(2, 1, 2, 1);
            rt.setFlat(a2, 0, 2.0); rt.setFlat(a2, 1, 3.0);
            rt.setFlat(b2, 0, 5.0); rt.setFlat(b2, 1, 6.0); rt.setFlat(b2, 2, 7.0); rt.setFlat(b2, 3, 8.0);
            rt.setFlat(d2, 0, 1.0); rt.setFlat(d2, 1, 2.0);
            rt.addBwdBatchMatmul(d2, a2, b2, da2, db2, 1, 2, 1, 1, 1, 2, 1, 2, 1);
            rt.run();
            int bad = 0;
            double[] eda1 = new double[4];
            eda1[0]=5.0; eda1[1]=6.0; eda1[2]=10.0; eda1[3]=12.0;
            int i = 0;
            while (i < 4) { if (absd(rt.getFlat(da1, i) - eda1[i]) > 1.0e-3) bad = bad + 1; i = i + 1; }
            if (absd(rt.getFlat(db1, 0) - 7.0) > 1.0e-3) bad = bad + 1;
            if (absd(rt.getFlat(db1, 1) - 10.0) > 1.0e-3) bad = bad + 1;
            if (absd(rt.getFlat(da2, 0) - 19.0) > 1.0e-3) bad = bad + 1;   // 广播累加两 b0
            if (absd(rt.getFlat(da2, 1) - 22.0) > 1.0e-3) bad = bad + 1;
            double[] edb2 = new double[4];
            edb2[0]=2.0; edb2[1]=3.0; edb2[2]=4.0; edb2[3]=6.0;
            i = 0;
            while (i < 4) { if (absd(rt.getFlat(db2, i) - edb2[i]) > 1.0e-3) bad = bad + 1; i = i + 1; }
            Console.writeString("bwd batch_matmul bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (bad == 0) Console.writeLine("BWD BATCH_MATMUL OK");
            else Console.writeLine("BWD BATCH_MATMUL MISMATCH");
        }
}
int main() { BwdBatchMatmulApp app = new BwdBatchMatmulApp(); return 0; }
