// json_convt3d_train_main.myp — C：JSON ConvTranspose3D 训练反向（BwdConvTranspose3D）。
// convt3d_tr.json：x[1,1,2,1,1]→ConvTranspose3D(Cin1→Cout2, kd2)→u[1,2,3,1,1]→Flatten→
// hf[6]→Gemm→logits[2]→Softmax。训练须经 BwdConvTranspose3D 回传 ConvT 权重才更新
// （dW[ci,co,kz,ky,kx] 由 dy·x 路由累加；dX 反向）。判据：2 模式轮换 400 步后每类 loss
// < 0.5（梯度须穿过 BwdConvTranspose3D→ConvT 权重；错则 loss 不降）。
import env;
import fmt;
import dl;

class JsonConvt3dTrainApp {
    action:
        void feedOne(Session t, int labT, int cl) {
            double[] bx = new double[2];
            if (cl == 0) { bx[0]=1.0; bx[1]=3.0; }
            else { bx[0]=5.0; bx[1]=2.0; }
            t.setInput("x", bx, 2);
            int i = 0;
            while (i < 2) { t.setFlat(labT, i, 0.0); i = i + 1; }
            t.setFlat(labT, cl, 1.0);
        }
        @constructor JsonConvt3dTrainApp() {
            Session t = new Session();
            int tok = t.loadJsonTrain("./deeplearning/infer_tests/convt3d_tr.json");
            Console.writeString("load="); Console.writeLong(tok); Console.writeLine("");
            if (tok == 0) { Console.writeLine("JSON CONVT3D TRAIN SKIP (no load)"); return; }
            t.setLr(0.1); t.setTrainMode(1);
            int labT = t.tensorId("label");
            int step = 0;
            while (step < 400) {
                int cl = (step * 41) % 2;
                feedOne(t, labT, cl);
                t.runTrain();
                step = step + 1;
            }
            int bad = 0;
            int cl = 0;
            while (cl < 2) {
                feedOne(t, labT, cl);
                t.runTrain();
                double l = t.loss();
                Console.writeString("cl" + Fmt.i(cl) + " loss="); Console.writeFloat(l);
                Console.writeLine("");
                if (l > 0.5) bad = bad + 1;
                cl = cl + 1;
            }
            if (tok == 1 && bad == 0) Console.writeLine("JSON CONVT3D TRAIN OK");
            else Console.writeLine("JSON CONVT3D TRAIN FAIL");
        }
}

int main() { JsonConvt3dTrainApp app = new JsonConvt3dTrainApp(); return 0; }
