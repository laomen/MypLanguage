// planr18_main.myp — 阶段七：计划缓存真实多 op 图验证（ResNet18 47MB）
// 流程：
//   1) 正常加载 resnet18_v1_7.onnx → run → 记录输出 sum A
//   2) dumpPlan 到 /tmp/plan_r18.bin
//   3) 新 InferenceRuntime loadPlan 恢复 → run → 输出 sum B
//   4) 断言 A==B 且 op/tensor 表一致
// 验证：真实 69-node CNN 图计划缓存跳过解析+优化+buildRuntime，输出一致。
import env;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class PlanR18App {
    action:
        @constructor PlanR18App() {
            // ---- 1. 正常加载 ----
            InferenceRuntime rt1 = new InferenceRuntime();
            rt1.init(1024);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/resnet18_v1_7.onnx", rt1);
            if (ok == 0) { Console.writeLine("load failed"); return; }
            int inT1 = loader.tensorId("data");
            int outT1 = loader.tensorId("resnetv15_dense0_fwd");
            if (inT1 < 0 || outT1 < 0) { Console.writeLine("tensor not found"); return; }
            int nIn = 3 * 224 * 224;
            double[] buf = new double[200000];
            readF32("./deeplearning/data/onnx/resnet_input.f32", buf, nIn);
            int i = 0;
            while (i < nIn) { rt1.setFlat(inT1, i, buf[i]); i = i + 1; }
            int useGpu = 0;
            if (Console.getEnv("MYP_GPU") == "1") useGpu = 1;
            if (useGpu == 1) rt1.runGpu(); else rt1.run();
            int nOut = rt1.tensorSize(outT1);
            double sumA = 0.0;
            i = 0;
            while (i < nOut) { sumA = sumA + rt1.getFlat(outT1, i); i = i + 1; }
            int ops1 = rt1.opCount();
            int tens1 = rt1.tensorCountDebug();
            Console.writeString("normal: ops="); Console.writeLong(ops1);
            Console.writeString(" tens="); Console.writeLong(tens1);
            Console.writeString(" sum="); Console.writeFloat(sumA); Console.writeLine("");

            // ---- 2. dump 计划 ----
            int dk = rt1.dumpPlan("/tmp/plan_r18.bin");
            Console.writeString("dumpPlan="); Console.writeLong(dk); Console.writeLine("  (expect 1)");

            // ---- 3. loadPlan 恢复 ----
            InferenceRuntime rt2 = new InferenceRuntime();
            rt2.init(1024);
            int lk = rt2.loadPlan("/tmp/plan_r18.bin");
            if (lk == 0) { Console.writeLine("loadPlan failed"); return; }
            int ops2 = rt2.opCount();
            int tens2 = rt2.tensorCountDebug();
            Console.writeString("plan: ops="); Console.writeLong(ops2);
            Console.writeString(" tens="); Console.writeLong(tens2); Console.writeLine("");
            // tensor id 布局一致 → in/out tid 相同
            int inT2 = inT1;
            int outT2 = outT1;
            i = 0;
            while (i < nIn) { rt2.setFlat(inT2, i, buf[i]); i = i + 1; }
            if (useGpu == 1) rt2.runGpu(); else rt2.run();
            double sumB = 0.0;
            i = 0;
            while (i < nOut) { sumB = sumB + rt2.getFlat(outT2, i); i = i + 1; }
            Console.writeString("plan sum="); Console.writeFloat(sumB); Console.writeLine("");

            double d = sumA - sumB;
            if (d < 0.0) d = 0.0 - d;
            Console.writeString("sum diff: "); Console.writeFloat(d); Console.writeLine("");
            if (dk == 1 && lk == 1 && ops1 == ops2 && tens1 == tens2 && d <= 1.0e-2) {
                Console.writeLine("PLANR18 ALL OK");
            } else {
                Console.writeLine("PLANR18 MISMATCH");
            }
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }
}

int main() { PlanR18App app = new PlanR18App(); return 0; }
