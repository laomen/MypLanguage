// json_unet3d_main.myp — JSON 3D U-Net 推理（3D 全 op：Conv3D/MaxPool3D/Resize/
// Concat(5D)/Sigmoid——声明式表达分割 U-Net 结构）。
// unet3d.json：data[1,1,8,32,32] → 编码 Conv3D(pad1 保尺寸)+MaxPool3D×2 → 瓶颈 32ch
//   [1,32,2,8,8] → Resize(sizes 2x 上采样) + Concat 跳跃(a3/a1) → 解码 Conv3D →
//   Conv1x1 → Sigmoid prob[1,1,8,32,32]。
// 断言：load/run OK；输出元素 = 8*32*32=8192；值 ∈ [0,1] 且有区分（输入内容块影响输出
//   —— 深链随机权重输出非恒等）；CPU+GPU 一致。
import env;
import fmt;
import dl;

class JsonUnet3dApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        void feedIn(Session t, int mode) {
            double[] bx = new double[8 * 32 * 32];
            int i = 0;
            while (i < 8 * 32 * 32) {
                int d = i / (32 * 32); int r = (i / 32) % 32; int c = i % 32;
                double v = 0.05;
                if (d >= 2 && d < 6 && r >= 8 && r < 24 && c >= 8 && c < 24) v = 1.0;
                if (mode == 1) v = 1.0 - v;   // 反相（边缘亮）
                bx[i] = v;
                i = i + 1;
            }
            t.setInput("data", bx, 8 * 32 * 32);
        }
        double runProbe(Session t, int mode, double[] smn, double[] smx) {
            feedIn(t, mode);
            int rk = t.runAuto();
            double[] o = t.getOutput("prob");
            int n = t.tensorSize("prob");
            double mn = 9.0, mx = -9.0;
            int i = 0;
            while (i < n) {
                double v = o[i];
                if (v < mn) mn = v;
                if (v > mx) mx = v;
                i = i + 1;
            }
            smn[0] = mn; smx[0] = mx;
            return double(rk);
        }
        @constructor JsonUnet3dApp() {
            Session t = new Session();
            int tok = t.loadJson("./deeplearning/infer_tests/unet3d.json");
            Console.writeString("load="); Console.writeLong(tok); Console.writeLine("");
            if (tok == 0) { Console.writeLine("JSON UNET3D SKIP (no load)"); return; }
            int n = t.tensorSize("prob");
            double[] mnA = new double[1]; double[] mxA = new double[1];
            double[] mnB = new double[1]; double[] mxB = new double[1];
            double rkA = runProbe(t, 0, mnA, mxA);
            double rkB = runProbe(t, 1, mnB, mxB);
            Console.writeString("out n=" + Fmt.i(n) + " mode0 min="); Console.writeFloat(mnA[0]);
            Console.writeString(" max="); Console.writeFloat(mxA[0]);
            Console.writeString(" mode1 min="); Console.writeFloat(mnB[0]);
            Console.writeString(" max="); Console.writeFloat(mxB[0]);
            Console.writeLine("");
            int bad = 0;
            if (tok != 1 || rkA == 0.0 || rkB == 0.0) bad = bad + 1;
            if (n != 8 * 32 * 32) bad = bad + 1;
            if (mnA[0] < 0.0 || mxA[0] > 1.0) bad = bad + 1;   // sigmoid 输出界
            if (mnB[0] < 0.0 || mxB[0] > 1.0) bad = bad + 1;
            // 输出非恒等且两输入有区分（有前向信息流通）
            double span = absd(mxA[0] - mnA[0]) + absd(mxB[0] - mnB[0]);
            if (span < 0.05) bad = bad + 1;
            if (bad == 0) Console.writeLine("JSON UNET3D OK");
            else Console.writeLine("JSON UNET3D MISMATCH");
        }
}

int main() { JsonUnet3dApp app = new JsonUnet3dApp(); return 0; }
