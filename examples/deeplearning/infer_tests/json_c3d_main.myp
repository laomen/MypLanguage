// json_c3d_main.myp — JSON 3D CNN 推理（Conv3D/MaxPool3D JSON 分派 5D 全链）。
// c3d.json：data[1,1,4,8,8] → Conv3D(2ch 3x3x3 pad1)→Relu→MaxPool3D(2x2x2)→
//   Flatten[1,64]→Gemm→logits[1,3]→Softmax。
// 断言：load/run OK；prob 3 元素在 (0,1) 且和≈1；三种「中心定位内容块」（值 1/2/3）
//   输入输出有区分（网络对内容敏感）——3D 推理全链（5D shape/权重/接线）正确。
// 注：3D 训练反向（BwdConv3D/BwdMaxPool3D）端到端不稳（独立待修，勿 loadJsonTrain）。
import env;
import fmt;
import dl;

class JsonC3dApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        void feedIn(Session t, int cl) {
            double[] bx = new double[4 * 8 * 8];
            int i = 0;
            while (i < 4 * 8 * 8) {
                int d = i / (8 * 8); int r = (i / 8) % 8; int c = i % 8;
                double v = 0.0;
                if (d >= 1 && d < 3 && r >= 2 && r < 6 && c >= 2 && c < 6) v = 1.0 + double(cl);
                bx[i] = v;
                i = i + 1;
            }
            t.setInput("data", bx, 4 * 8 * 8);
        }
        int feedProbe(Session t, int cl, double[] pout) {
            feedIn(t, cl);
            int rk = t.runAuto();
            double[] p = t.getOutput("prob");
            pout[0] = p[0]; pout[1] = p[1]; pout[2] = p[2];
            return rk;
        }
        @constructor JsonC3dApp() {
            Session t = new Session();
            int tok = t.loadJson("./deeplearning/infer_tests/c3d.json");
            Console.writeString("load="); Console.writeLong(tok); Console.writeLine("");
            if (tok == 0) { Console.writeLine("JSON C3D SKIP (no load)"); return; }
            double[] p0 = new double[3]; double[] p1 = new double[3]; double[] p2 = new double[3];
            int bad = 0;
            if (feedProbe(t, 0, p0) == 0) bad = bad + 1;
            if (feedProbe(t, 1, p1) == 0) bad = bad + 1;
            if (feedProbe(t, 2, p2) == 0) bad = bad + 1;
            // prob ∈ (0,1) 且每样本 sum≈1
            int cl = 0;
            while (cl < 3) {
                double s = 0.0;
                int k = 0;
                while (k < 3) {
                    double v = (cl == 0) ? p0[k] : ((cl == 1) ? p1[k] : p2[k]);
                    if (v <= 0.0 || v >= 1.0) bad = bad + 1;
                    s = s + v;
                    k = k + 1;
                }
                if (absd(s - 1.0) > 1.0e-2) bad = bad + 1;
                cl = cl + 1;
            }
            Console.writeString("cl0 prob="); Console.writeFloat(p0[0]); Console.writeString(" "); Console.writeFloat(p0[1]); Console.writeString(" "); Console.writeFloat(p0[2]); Console.writeLine("");
            Console.writeString("cl2 prob="); Console.writeFloat(p2[0]); Console.writeString(" "); Console.writeFloat(p2[1]); Console.writeString(" "); Console.writeFloat(p2[2]); Console.writeLine("");
            // 三种内容块输入输出应不同（网络对内容/块敏感，非恒等输出）
            double d01 = absd(p0[0] - p1[0]) + absd(p0[1] - p1[1]) + absd(p0[2] - p1[2]);
            double d02 = absd(p0[0] - p2[0]) + absd(p0[1] - p2[1]) + absd(p0[2] - p2[2]);
            if (d01 < 1.0e-3 && d02 < 1.0e-3) bad = bad + 1;
            if (bad == 0) Console.writeLine("JSON C3D OK");
            else Console.writeLine("JSON C3D MISMATCH");
        }
}

int main() { JsonC3dApp app = new JsonC3dApp(); return 0; }
