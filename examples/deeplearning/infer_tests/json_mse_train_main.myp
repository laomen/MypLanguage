// json_mse_train_main.myp — JSON MSE 回归训练（图算子 P3，lossMode 2）。
// mse_reg.json：x[1,3]→Gemm→h[4]→Relu→Gemm→out[2]（无 Softmax 分类头）。
// label 同 out 形状（2 实数目标，非 one-hot）；MSE loss = mean(out-t)²，
// dp=2(out-t)/N → BwdRelu/BwdDense 链 → 权重更新。判据：3 模式轮换 500 步后
// 每模式 loss < 0.02（且读 out 近目标值），验证 MSE 核 + 逐元素损失图路径。
import env;
import fmt;
import dl;

class JsonMseTrainApp {
    action:
        void feedOne(Session t, int labT, int cl) {
            double[] bx = new double[3];
            int i = 0;
            while (i < 3) { bx[i] = 0.0; i = i + 1; }
            bx[cl] = 1.0;
            t.setInput("x", bx, 3);
            // 目标向量（3 模式 × 2 输出）
            double v0, v1;
            if (cl == 0) { v0 = 2.0; v1 = -1.0; }
            else if (cl == 1) { v0 = -1.0; v1 = 3.0; }
            else { v0 = 0.5; v1 = 0.5; }
            t.setFlat(labT, 0, v0);
            t.setFlat(labT, 1, v1);
        }
        @constructor JsonMseTrainApp() {
            Session t = new Session();
            t.setLossMode(2);   // MSE
            int tok = t.loadJsonTrain("./deeplearning/infer_tests/mse_reg.json");
            Console.writeString("load="); Console.writeLong(tok); Console.writeLine("");
            if (tok == 0) { Console.writeLine("JSON MSE TRAIN SKIP (no load)"); return; }
            t.setLr(0.1); t.setTrainMode(1);
            int labT = t.tensorId("label");
            int step = 0;
            while (step < 500) {
                int cl = (step * 31) % 3;
                feedOne(t, labT, cl);
                t.runTrainAuto();
                step = step + 1;
            }
            int bad = 0;
            int cl = 0;
            while (cl < 3) {
                feedOne(t, labT, cl);
                t.runTrainAuto();
                double l = t.loss();
                Console.writeString("cl" + Fmt.i(cl) + " loss="); Console.writeFloat(l);
                Console.writeLine("");
                if (l > 0.02) bad = bad + 1;
                cl = cl + 1;
            }
            if (tok == 1 && bad == 0) Console.writeLine("JSON MSE TRAIN OK");
            else Console.writeLine("JSON MSE TRAIN FAIL");
        }
}

int main() { JsonMseTrainApp app = new JsonMseTrainApp(); return 0; }
