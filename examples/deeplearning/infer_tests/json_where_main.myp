// json_where_main.myp — C：JSON Where（三输入选择 cond?x:y）。
// cond[1,1,2,2]=[1,0,1,0]、x=[10,20,30,40]、y=[100,200,300,400] → out = cond>0?x:y
//   = [10,200,30,400]。CPU+GPU JSON WHERE OK。
import env;
import fmt;
import dl;
class JsonWhereApp {
    action:
        @constructor JsonWhereApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/where.json");
            if (ok == 0) { Console.writeLine("JSON WHERE SKIP (no load)"); return; }
            double[] cond = new double[4];
            double[] x = new double[4];
            double[] y = new double[4];
            cond[0]=1.0; cond[1]=0.0; cond[2]=1.0; cond[3]=0.0;
            x[0]=10.0; x[1]=20.0; x[2]=30.0; x[3]=40.0;
            y[0]=100.0; y[1]=200.0; y[2]=300.0; y[3]=400.0;
            s.setInput("cond", cond, 4);
            s.setInput("x", x, 4);
            s.setInput("y", y, 4);
            int rk = s.runAuto();
            double[] o = s.getOutput("out");
            int n = s.tensorSize("out");
            int bad = 0;
            double[] exp = new double[4];
            exp[0]=10.0; exp[1]=200.0; exp[2]=30.0; exp[3]=400.0;
            int i = 0;
            while (i < 4) { double d = o[i]-exp[i]; if (d<0.0) d=0.0-d; if (d>1.0e-3) bad=bad+1; i = i + 1; }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeLine("");
            if (ok==1 && rk==1 && n==4 && bad==0) Console.writeLine("JSON WHERE OK");
            else Console.writeLine("JSON WHERE MISMATCH");
        }
}
int main() { JsonWhereApp a = new JsonWhereApp(); return 0; }
