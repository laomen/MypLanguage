// json_gather_elements_main.myp — C：JSON GatherElements（P8 数据高级索引，逐元素 gather）。
// x[1,2,1,4] NCHW：c0=[10,11,12,13]、c1=[20,21,22,23]。
//  op1 axis=3（W 轴）：ix[n,c,0,w] 选 data[n,c,0,ix]；
//    ix c0=[0,3,1,2] → y c0=[10,13,11,12]；ix c1=[2,1,0,3] → y c1=[22,21,20,23]。
//  op2 axis=1（C 轴）：ic[n,cc,0,w] 选 data[n,ic,0,w]；ic 展平=[0,1,0,1, 1,0,1,0]
//    → z=[10,21,12,23, 20,11,22,13]。
// CPU+GPU JSON GATHER_ELEMENTS OK。
import env;
import fmt;
import dl;
class JsonGatherElementsApp {
    action:
        @constructor JsonGatherElementsApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/gather_elements.json");
            if (ok == 0) { Console.writeLine("JSON GATHER_ELEMENTS SKIP (no load)"); return; }
            double[] x = new double[8];
            x[0]=10.0; x[1]=11.0; x[2]=12.0; x[3]=13.0;
            x[4]=20.0; x[5]=21.0; x[6]=22.0; x[7]=23.0;
            s.setInput("x", x, 8);
            double[] ix = new double[8];
            ix[0]=0.0; ix[1]=3.0; ix[2]=1.0; ix[3]=2.0;
            ix[4]=2.0; ix[5]=1.0; ix[6]=0.0; ix[7]=3.0;
            s.setInput("ix", ix, 8);
            double[] ic = new double[8];
            ic[0]=0.0; ic[1]=1.0; ic[2]=0.0; ic[3]=1.0;
            ic[4]=1.0; ic[5]=0.0; ic[6]=1.0; ic[7]=0.0;
            s.setInput("ic", ic, 8);
            int rk = s.runAuto();
            double[] y = s.getOutput("y");
            double[] z = s.getOutput("z");
            int n1 = s.tensorSize("y");
            int n2 = s.tensorSize("z");
            double[] ey = new double[8];
            ey[0]=10.0; ey[1]=13.0; ey[2]=11.0; ey[3]=12.0;   // c0（沿 W gather）
            ey[4]=22.0; ey[5]=21.0; ey[6]=20.0; ey[7]=23.0;   // c1
            double[] ez = new double[8];
            ez[0]=10.0; ez[1]=21.0; ez[2]=12.0; ez[3]=23.0;   // 沿 C gather
            ez[4]=20.0; ez[5]=11.0; ez[6]=22.0; ez[7]=13.0;
            int bad = 0;
            int i = 0;
            while (i < 8) {
                double d1 = y[i]-ey[i]; if (d1<0.0) d1=0.0-d1; if (d1>1.0e-4) bad=bad+1;
                double d2 = z[i]-ez[i]; if (d2<0.0) d2=0.0-d2; if (d2>1.0e-4) bad=bad+1;
                i = i + 1;
            }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n1);
            Console.writeString(","); Console.writeLong(n2);
            Console.writeString(" y0="); Console.writeFloat(y[0]);
            Console.writeString(" y7="); Console.writeFloat(y[7]);
            Console.writeString(" z0="); Console.writeFloat(z[0]);
            Console.writeString(" z7="); Console.writeFloat(z[7]);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeLine("");
            if (ok==1 && rk==1 && n1==8 && n2==8 && bad==0) Console.writeLine("JSON GATHER_ELEMENTS OK");
            else Console.writeLine("JSON GATHER_ELEMENTS FAIL");
        }
}
int main() { JsonGatherElementsApp a = new JsonGatherElementsApp(); return 0; }
