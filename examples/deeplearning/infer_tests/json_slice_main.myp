// json_slice_main.myp — JSON Slice（starts/ends/axes/steps int64 内存常量，省略 steps）。
// x[1,2,3,4] 值 1..24（NCHW：ch0 idx0-11 = H0[1,2,3,4] H1[5,6,7,8] H2[9,10,11,12]，
//   ch1 idx12-23 = H0[13,14,15,16] H1[17,18,19,20] H2[21,22,23,24]）。
// Slice starts=[1,0] ends=[3,4] axes=[2,3]（H 取 1..2、W 全取，ends 开区间）→
//   out[1,2,2,4] = ch0[H1,H2] + ch1[H1,H2] = [5,6,7,8,9,10,11,12,17,18,19,20,21,22,23,24]。
// CPU+GPU JSON SLICE OK。
import env;
import fmt;
import dl;
class JsonSliceApp {
    action:
        @constructor JsonSliceApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/slice.json");
            if (ok == 0) { Console.writeLine("JSON SLICE SKIP (no load)"); return; }
            double[] x = new double[24];
            int i = 0;
            while (i < 24) { x[i] = double(i + 1); i = i + 1; }
            s.setInput("x", x, 24);
            int rk = s.runAuto();
            double[] o = s.getOutput("y");
            int n = s.tensorSize("y");
            int bad = 0;
            double[] exp = new double[16];
            exp[0]=5.0; exp[1]=6.0; exp[2]=7.0; exp[3]=8.0;
            exp[4]=9.0; exp[5]=10.0; exp[6]=11.0; exp[7]=12.0;
            exp[8]=17.0; exp[9]=18.0; exp[10]=19.0; exp[11]=20.0;
            exp[12]=21.0; exp[13]=22.0; exp[14]=23.0; exp[15]=24.0;
            i = 0;
            while (i < 16) {
                double d = o[i] - exp[i];
                if (d < 0.0) d = 0.0 - d;
                if (d > 1.0e-3) bad = bad + 1;
                i = i + 1;
            }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeLine("");
            if (ok==1 && rk==1 && n==16 && bad==0) Console.writeLine("JSON SLICE OK");
            else Console.writeLine("JSON SLICE MISMATCH");
        }
}
int main() { JsonSliceApp a = new JsonSliceApp(); return 0; }
