{ "name":"gradcnn",
  "inputs":[{"name":"x","dims":[1,1,8,8]}],
  "outputs":["prob"],
  "layers":[
    { "op":"Conv","in":"x","out":"c",
      "W":{"dims":[2,1,3,3],"init":"xavier"},"B":{"dims":[2],"init":"zeros"},
      "kernel":[3,3] },
    { "op":"Flatten","in":"c","out":"h","axis":1},
    { "op":"Gemm","in":"h","out":"logits","transB":1,
      "W":{"dims":[3,72],"init":"xavier"},"B":{"dims":[3],"init":"zeros"}},
    { "op":"Softmax","in":"logits","out":"prob","axis":1}
  ]
}
