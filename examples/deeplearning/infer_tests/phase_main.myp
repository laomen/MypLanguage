// phase_main.myp — 阶段七：三阶段错误码与统计信息分离测试
// 验证：
//   1) 加载不存在的文件 → loadError()==1（加载阶段：文件读失败），phase==1
//   2) 加载含 unsupported op 的模型 → loadError()==4（加载阶段：unsupported op）
//   3) 加载 known-good 模型 → phase==3，loadError/compileError==0
//   4) runRuntime 后统计（lastRunOps/runError）正确
import env;
import fmt;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class PhaseTestApp {
    action:
        @constructor PhaseTestApp() {
            // ---- 1. 不存在文件 → 加载阶段错误 1 ----
            InferenceRuntime rt0 = new InferenceRuntime();
            rt0.init(2048);
            OnnxLoader l0 = new OnnxLoader();
            int ok0 = l0.load("./deeplearning/data/onnx/does_not_exist.onnx", rt0);
            Console.writeString("missing: ok="); Console.writeLong(ok0);
            Console.writeString(" phase="); Console.writeLong(l0.phase());
            Console.writeString(" loadErr="); Console.writeLong(l0.loadError());
            Console.writeLine("  (expect ok=0 phase=1 loadErr=1)");

            // ---- 2. unsupported op 模型 → 加载阶段错误 4 ----
            InferenceRuntime rt1 = new InferenceRuntime();
            rt1.init(2048);
            OnnxLoader l1 = new OnnxLoader();
            int ok1 = l1.load("./deeplearning/data/onnx/unsup_unknown.onnx", rt1);
            Console.writeString("unsup: ok="); Console.writeLong(ok1);
            Console.writeString(" phase="); Console.writeLong(l1.phase());
            Console.writeString(" loadErr="); Console.writeLong(l1.loadError());
            Console.writeLine("  (expect ok=0 phase=1 loadErr=4)");

            // ---- 3. known-good 模型 → phase==3，无错误 ----
            InferenceRuntime rt2 = new InferenceRuntime();
            rt2.init(2048);
            OnnxLoader l2 = new OnnxLoader();
            int ok2 = l2.load("./deeplearning/data/onnx/deadweight_test.onnx", rt2);
            Console.writeString("good: ok="); Console.writeLong(ok2);
            Console.writeString(" phase="); Console.writeLong(l2.phase());
            Console.writeString(" loadErr="); Console.writeLong(l2.loadError());
            Console.writeString(" compileErr="); Console.writeLong(l2.compileError());
            Console.writeString(" compileMs="); Console.writeLong(l2.compileMs());
            Console.writeLine("  (expect ok=1 phase=3 loadErr=0 compileErr=0)");

            // ---- 4. runRuntime 统计 ----
            int inT = l2.tensorId("x");
            int outT = l2.tensorId("y");
            int nIn = rt2.tensorSize(inT);
            double[] buf = new double[64];
            readF32("./deeplearning/data/onnx/deadweight_in.f32", buf, nIn);
            int i = 0;
            while (i < nIn) { rt2.setFlat(inT, i, buf[i]); i = i + 1; }
            int useGpu = 0;
            if (Console.getEnv("MYP_GPU") == "1") useGpu = 1;
            int rk = 0;
            if (useGpu == 1) rk = l2.runGpuRuntime(rt2);
            else rk = l2.runRuntime(rt2);
            Console.writeString("run: ok="); Console.writeLong(rk);
            Console.writeString(" ops="); Console.writeLong(l2.lastRunOps());
            Console.writeString(" runErr="); Console.writeLong(l2.runError());
            Console.writeString(" runMs="); Console.writeLong(l2.lastRunMs());
            Console.writeLine("");
            int nOut = rt2.tensorSize(outT);
            int okC = checkOut(rt2, outT, "./deeplearning/data/onnx/deadweight_test_ort.bin", nOut);

            if (ok0 == 0 && l0.loadError() == 1 && ok1 == 0 && l1.loadError() == 4 &&
                ok2 == 1 && l2.phase() == 3 && l2.loadError() == 0 && l2.compileError() == 0 &&
                rk == 1 && l2.runError() == 0 && l2.lastRunOps() == 1 && okC == 1) {
                Console.writeLine("PHASE ALL OK");
            } else {
                Console.writeLine("PHASE MISMATCH");
            }
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path, int n) {
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("run vs ORT max diff: "); Console.writeFloat(maxD); Console.writeLine("");
            if (maxD <= 1.0e-4) return 1;
            return 0;
        }
}

int main() { PhaseTestApp app = new PhaseTestApp(); return 0; }
