// plan_main.myp — 阶段七：计划缓存（dumpPlan/loadPlan）测试
// 流程：
//   1) 正常加载 Conv 模型（deadweight_test.onnx）→ 记录输出 A
//   2) dumpPlan 到 /tmp/plan_test.bin
//   3) 新建 InferenceRuntime loadPlan 恢复 → 填输入 → run → 输出 B
//   4) 断言 A==B（CPU+GPU）且计划恢复后 tensor/op 表一致
// 验证：计划缓存跳过 ONNX 解析+优化+buildRuntime，输出与正常加载完全一致。
import env;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class PlanTestApp {
    action:
        @constructor PlanTestApp() {
            // ---- 1. 正常加载 + dump 计划 ----
            InferenceRuntime rt1 = new InferenceRuntime();
            rt1.init(2048);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/deadweight_test.onnx", rt1);
            if (ok == 0) { Console.writeLine("load failed"); return; }
            int inT1 = loader.tensorId("x");
            int outT1 = loader.tensorId("y");
            int nIn = rt1.tensorSize(inT1);
            double[] buf = new double[64];
            readF32("./deeplearning/data/onnx/deadweight_in.f32", buf, nIn);
            int i = 0;
            while (i < nIn) { rt1.setFlat(inT1, i, buf[i]); i = i + 1; }
            int useGpu = 0;
            if (Console.getEnv("MYP_GPU") == "1") useGpu = 1;
            if (useGpu == 1) rt1.runGpu(); else rt1.run();
            int nOut = rt1.tensorSize(outT1);
            double[] refA = new double[64];
            i = 0;
            while (i < nOut) { refA[i] = rt1.getFlat(outT1, i); i = i + 1; }
            int ops1 = rt1.opCount();
            int tens1 = rt1.tensorCountDebug();
            Console.writeString("normal: ops="); Console.writeLong(ops1);
            Console.writeString(" tens="); Console.writeLong(tens1); Console.writeLine("");

            // ---- 2. dump 计划 ----
            int dk = rt1.dumpPlan("/tmp/plan_test.bin");
            Console.writeString("dumpPlan="); Console.writeLong(dk); Console.writeLine("  (expect 1)");

            // ---- 3. loadPlan 恢复（跳过 ONNX 解析+优化）----
            InferenceRuntime rt2 = new InferenceRuntime();
            rt2.init(2048);
            int lk = rt2.loadPlan("/tmp/plan_test.bin");
            if (lk == 0) { Console.writeLine("loadPlan failed"); return; }
            int ops2 = rt2.opCount();
            int tens2 = rt2.tensorCountDebug();
            Console.writeString("plan: ops="); Console.writeLong(ops2);
            Console.writeString(" tens="); Console.writeLong(tens2); Console.writeLine("");
            // tensor id 布局保持一致 → in/out tid 相同
            int inT2 = inT1;
            int outT2 = outT1;
            i = 0;
            while (i < nIn) { rt2.setFlat(inT2, i, buf[i]); i = i + 1; }
            if (useGpu == 1) rt2.runGpu(); else rt2.run();
            double[] refB = new double[64];
            i = 0;
            while (i < nOut) { refB[i] = rt2.getFlat(outT2, i); i = i + 1; }

            // ---- 4. 对比 ----
            double maxD = 0.0;
            i = 0;
            while (i < nOut) {
                double d = refA[i] - refB[i];
                if (d < 0.0) d = 0.0 - d;
                if (d > maxD) maxD = d;
                i = i + 1;
            }
            Console.writeString("plan vs normal max diff: "); Console.writeFloat(maxD); Console.writeLine("");
            // 也对比 ORT 参考
            int okC = checkOut(rt2, outT2, "./deeplearning/data/onnx/deadweight_test_ort.bin", nOut);

            if (dk == 1 && lk == 1 && ops1 == ops2 && tens1 == tens2 && maxD <= 1.0e-6 && okC == 1) {
                Console.writeLine("PLAN CACHE ALL OK");
            } else {
                Console.writeLine("PLAN CACHE MISMATCH");
            }
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path, int n) {
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int bad = 0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                if (dv > 1.0e-4) bad = bad + 1;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("  plan vs ORT max diff: "); Console.writeFloat(maxD);
            Console.writeString("  bad="); Console.writeLong(bad); Console.writeLine("");
            if (maxD <= 1.0e-4) return 1;
            return 0;
        }
}

int main() { PlanTestApp app = new PlanTestApp(); return 0; }
