// json_bce_train_main.myp — JSON BCE 二值训练（图算子 P3，lossMode 3）。
// bce_clf.json：x[1,2]→Gemm→z[2]→Sigmoid→p[2]（无 Softmax）。label 同 p 形状
// （2 个 0-1 概率目标）；BCE loss = -mean[t·ln p̂+(1-t)ln(1-p̂)]，经 BwdSigmoid 链。
// 判据：2 模式轮换 600 步后每模式 loss 显著降（l0-lf>0.15、lf<0.45，floor≈0.325
// 因目标 0.1/0.9）+ 读 p 方向正确（A:p0<0.5<p1；B:p0>0.5>p1）。
import env;
import fmt;
import dl;

class JsonBceTrainApp {
    action:
        void feedOne(Session t, int labT, int cl) {
            double[] bx = new double[2];
            bx[0] = 1.0; bx[1] = 0.0;
            if (cl == 1) { bx[0] = 0.0; bx[1] = 1.0; }
            t.setInput("x", bx, 2);
            if (cl == 0) { t.setFlat(labT, 0, 0.1); t.setFlat(labT, 1, 0.9); }
            else { t.setFlat(labT, 0, 0.9); t.setFlat(labT, 1, 0.1); }
        }
        @constructor JsonBceTrainApp() {
            Session t = new Session();
            t.setLossMode(3);   // BCE
            int tok = t.loadJsonTrain("./deeplearning/infer_tests/bce_clf.json");
            Console.writeString("load="); Console.writeLong(tok); Console.writeLine("");
            if (tok == 0) { Console.writeLine("JSON BCE TRAIN SKIP (no load)"); return; }
            t.setLr(1.0); t.setTrainMode(1);
            int labT = t.tensorId("label");
            int step = 0;
            double l0 = 0.0;
            while (step < 600) {
                int cl = (step * 41) % 2;
                feedOne(t, labT, cl);
                t.runTrainAuto();
                if (step == 0) l0 = t.loss();
                step = step + 1;
            }
            int bad = 0;
            int cl = 0;
            while (cl < 2) {
                feedOne(t, labT, cl);
                t.runTrainAuto();
                double l = t.loss();
                double[] p = t.getOutput("p");
                int dir = 0;
                if (cl == 0 && p[0] < 0.5 && p[1] > 0.5) dir = 1;
                if (cl == 1 && p[0] > 0.5 && p[1] < 0.5) dir = 1;
                Console.writeString("cl" + Fmt.i(cl) + " loss="); Console.writeFloat(l);
                Console.writeString(" p0="); Console.writeFloat(p[0]);
                Console.writeString(" p1="); Console.writeFloat(p[1]);
                Console.writeLine("");
                if (l > 0.45 || dir == 0) bad = bad + 1;
                cl = cl + 1;
            }
            Console.writeString("l0="); Console.writeFloat(l0);
            Console.writeLine("");
            if (tok == 1 && (l0 - t.loss()) > 0.15 && bad == 0) Console.writeLine("JSON BCE TRAIN OK");
            else Console.writeLine("JSON BCE TRAIN FAIL");
        }
}

int main() { JsonBceTrainApp app = new JsonBceTrainApp(); return 0; }
