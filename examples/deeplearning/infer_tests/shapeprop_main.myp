// shapeprop_main.myp — 阶段五：形状值传播（int64 四则 Mul 折叠）测试
// shapeprop_test.onnx：x[1,1,4,4] → Conv → y[1,1,2,2]；Resize sizes 链
//   Shape→Slice→Mul(dim,2)→Concat = [1,1,8,8]（int64 形状链四则折叠）。
// 验证：1) 输出 vs ORT 正确（Resize 输出 [1,1,8,8]）；2) sizes 链被折叠
//   （Conv 之后的 Shape/Slice/Mul/Concat 节点应被 erase，无对应 runtime op）。
import env;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class ShapePropTestApp {
    action:
        @constructor ShapePropTestApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/shapeprop_test.onnx", rt);
            if (ok == 0) { Console.writeLine("load failed"); return; }
            Console.writeString("graph: ops=");
            Console.writeLong(rt.opCount());
            Console.writeLine("");

            Graph g = loader.graph();
            // 形状链折叠：Shape/Slice/Mul/Concat 全部 erase → 只剩 Conv + Resize（2 op）
            // Resize sizes 从 attrResizeH/W 取（已折叠），不注册 sizes 张量。
            Console.writeString("fold count=");
            Console.writeLong(g.compilerFoldCount());
            Console.writeLine("");

            int inT = loader.tensorId("x");
            int outT = loader.tensorId("y2");
            if (inT < 0 || outT < 0) { Console.writeLine("tensor not found"); return; }
            int nIn = rt.tensorSize(inT);
            double[] buf = new double[64];
            readF32("./deeplearning/data/onnx/shapeprop_in.f32", buf, nIn);
            int i = 0;
            while (i < nIn) { rt.setFlat(inT, i, buf[i]); i = i + 1; }
            rt.run();
            int m = rt.tensorSize(outT);
            Console.writeString("out size=");
            Console.writeLong(m);
            Console.writeLine("  (expect 64=8*8)");
            int okC = checkOut(rt, outT, "./deeplearning/data/onnx/shapeprop_test_ort.bin", m);

            if (okC == 1 && m == 64) Console.writeLine("SHAPEPROP ALL OK");
            else Console.writeLine("SHAPEPROP MISMATCH");
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path, int n) {
            if (tid < 0) return 0;
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int bad = 0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                if (dv > 1.0e-4) bad = bad + 1;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("max diff vs ORT: ");
            Console.writeFloat(maxD);
            Console.writeString("  bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (maxD <= 1.0e-4) return 1;
            return 0;
        }
}

int main() { ShapePropTestApp app = new ShapePropTestApp(); return 0; }
