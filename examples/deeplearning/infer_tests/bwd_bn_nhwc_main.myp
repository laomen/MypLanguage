// bwd_bn_nhwc_main.myp — P9c：BwdBatchNormNHWC（NHWC 布局 opKind 18 反向）数值对拍。
// x NHWC [N=1,H=2,W=2,C=2]（flat = sp*C+c）：c0 通道 = 值 0..3（sp0..3）、c1 = 4..7。
// scale=[1,3]、bias=[0.5,-1]、mean=[0,0]、var=[1,4]、eps≈0 → rstd0=1/rstd1=0.5。
// dy flat（同 NHWC 序）=[1..8]。
//   dx = dy·scale·rstd：c0（flat 偶数位）[1,3,5,7]、c1（奇数位）→[3,6,9,12]
//   → dx flat=[1,3, 3,6, 5,9, 7,12]；
//   dscale0=1·0+3·1+5·2+7·3=34、dscale1=(2·4+4·5+6·6+8·7)·0.5=60；dbias=[16,20]。
// 全 PASS → BWD BN NHWC OK（CPU 直连）。
import env;
import fmt;
import "../infer/runtime.myp";

class BwdBnNhwcApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        @constructor BwdBnNhwcApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            rt.setTrain(1);
            int xT = rt.addTensor(8, 1);
            int dyT = rt.addTensor(8, 1);
            int dxT = rt.addTensor(8, 1);
            int sT = rt.addTensor(2, 1);
            int bT = rt.addTensor(2, 1);
            int mT = rt.addTensor(2, 1);
            int vT = rt.addTensor(2, 1);
            int dsT = rt.addTensor(2, 1);
            int dbT = rt.addTensor(2, 1);
            // x NHWC flat = sp*C+c：sp0..3 c0=0..3, c1=4..7
            double[] xv = new double[8];
            xv[0]=0.0; xv[1]=4.0; xv[2]=1.0; xv[3]=5.0; xv[4]=2.0; xv[5]=6.0; xv[6]=3.0; xv[7]=7.0;
            int i = 0;
            while (i < 8) { rt.setFlat(xT, i, xv[i]); rt.setFlat(dyT, i, double(i + 1)); i = i + 1; }
            rt.setFlat(sT, 0, 1.0); rt.setFlat(sT, 1, 3.0);
            rt.setFlat(bT, 0, 0.5); rt.setFlat(bT, 1, -1.0);
            rt.setFlat(mT, 0, 0.0); rt.setFlat(mT, 1, 0.0);
            rt.setFlat(vT, 0, 1.0); rt.setFlat(vT, 1, 4.0);
            rt.addBwdBatchNormNHWC(dyT, xT, dxT, sT, bT, mT, vT, dsT, dbT, 1, 2, 4, 0, 0);
            rt.run();
            int bad = 0;
            double[] edx = new double[8];
            edx[0]=1.0; edx[1]=3.0; edx[2]=3.0; edx[3]=6.0; edx[4]=5.0; edx[5]=9.0; edx[6]=7.0; edx[7]=12.0;
            i = 0;
            while (i < 8) { if (absd(rt.getFlat(dxT, i) - edx[i]) > 1.0e-3) bad = bad + 1; i = i + 1; }
            if (absd(rt.getFlat(dsT, 0) - 34.0) > 1.0e-3) bad = bad + 1;
            if (absd(rt.getFlat(dsT, 1) - 60.0) > 1.0e-3) bad = bad + 1;
            if (absd(rt.getFlat(dbT, 0) - 16.0) > 1.0e-3) bad = bad + 1;
            if (absd(rt.getFlat(dbT, 1) - 20.0) > 1.0e-3) bad = bad + 1;
            Console.writeString("bwd bn nhwc bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (bad == 0) Console.writeLine("BWD BN NHWC OK");
            else Console.writeLine("BWD BN NHWC MISMATCH");
        }
}
int main() { BwdBnNhwcApp app = new BwdBnNhwcApp(); return 0; }
