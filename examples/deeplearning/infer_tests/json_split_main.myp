// json_split_main.myp — JSON Split 多输出分派（outs 数组 + axis；均分）。
// split.json：x[1,9]=1..9 Split axis1 outs[a,b,c]（均分 3/3/3，最后一份吸收余数）
//   → a=[1,2,3] b=[4,5,6] c=[7,8,9]（三个独立图输出）
import env;
import fmt;
import dl;

class JsonSplitApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        int chk(Session t, string nm, double e0, double e1, double e2) {
            double[] o = t.getOutput(nm);
            int bad = 0;
            if (o[0] == 0.0 && o[1] == 0.0 && o[2] == 0.0) bad = bad + 1;   // 输出非空
            if (absd(o[0] - e0) > 1.0e-4) bad = bad + 1;
            if (absd(o[1] - e1) > 1.0e-4) bad = bad + 1;
            if (absd(o[2] - e2) > 1.0e-4) bad = bad + 1;
            return bad;
        }
        @constructor JsonSplitApp() {
            Session t = new Session();
            int tok = t.loadJson("./deeplearning/infer_tests/split.json");
            Console.writeString("load="); Console.writeLong(tok); Console.writeLine("");
            if (tok == 0) { Console.writeLine("JSON SPLIT SKIP (no load)"); return; }
            double[] bx = new double[9];
            int i = 0;
            while (i < 9) { bx[i] = double(i + 1); i = i + 1; }
            t.setInput("x", bx, 9);
            int rk = t.runAuto();
            int bad = 0;
            if (rk == 0) bad = bad + 1;
            bad = bad + chk(t, "a", 1.0, 2.0, 3.0);
            bad = bad + chk(t, "b", 4.0, 5.0, 6.0);
            bad = bad + chk(t, "c", 7.0, 8.0, 9.0);
            double[] a = t.getOutput("a"); double[] c = t.getOutput("c");
            Console.writeString("a0="); Console.writeFloat(a[0]);
            Console.writeString(" c2="); Console.writeFloat(c[2]);
            Console.writeLine("");
            if (bad == 0) Console.writeLine("JSON SPLIT OK");
            else Console.writeLine("JSON SPLIT MISMATCH");
        }
}

int main() { JsonSplitApp app = new JsonSplitApp(); return 0; }
