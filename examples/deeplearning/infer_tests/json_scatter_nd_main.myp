// json_scatter_nd_main.myp — C：JSON ScatterND（P8 数据高级索引，data 副本 + 前缀 scatter）。
// d[1,3,2,2] NCHW：c0=[1,2,3,4]、c1=[5,6,7,8]、c2=[9,10,11,12]。
//  op1：idx=[[0,1]]（q=1,k=2 → 前缀 (n,c) 定址整块 H*W=4），upd=[50,51,52,53]
//    → o 通道1 整块替换：[1,2,3,4, 50,51,52,53, 9,10,11,12]。
//  op2：idx2=[[0,0,1,1],[0,2,0,0]]（q=2,k=4 全秩 → 单元素 scatter），upd2=[60,70]
//    → pos3(原4)→60、pos8(原9)→70：o2=[1,2,3,60, 5,6,7,8, 70,10,11,12]。
// CPU+GPU JSON SCATTER_ND OK。
import env;
import fmt;
import dl;
class JsonScatterNdApp {
    action:
        @constructor JsonScatterNdApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/scatter_nd.json");
            if (ok == 0) { Console.writeLine("JSON SCATTER_ND SKIP (no load)"); return; }
            double[] d = new double[12];
            int i = 0;
            while (i < 12) { d[i] = double(i + 1); i = i + 1; }   // 1..12（通道行优先）
            s.setInput("d", d, 12);
            double[] idx = new double[2];
            idx[0]=0.0; idx[1]=1.0;
            s.setInput("idx", idx, 2);
            double[] upd = new double[4];
            i = 0;
            while (i < 4) { upd[i] = double(50 + i); i = i + 1; }  // 50..53
            s.setInput("upd", upd, 4);
            double[] idx2 = new double[8];
            idx2[0]=0.0; idx2[1]=0.0; idx2[2]=1.0; idx2[3]=1.0;
            idx2[4]=0.0; idx2[5]=2.0; idx2[6]=0.0; idx2[7]=0.0;
            s.setInput("idx2", idx2, 8);
            double[] upd2 = new double[2];
            upd2[0]=60.0; upd2[1]=70.0;
            s.setInput("upd2", upd2, 2);
            int rk = s.runAuto();
            double[] o = s.getOutput("o");
            double[] o2 = s.getOutput("o2");
            int n1 = s.tensorSize("o");
            int n2 = s.tensorSize("o2");
            double[] eo = new double[12];
            eo[0]=1.0; eo[1]=2.0; eo[2]=3.0; eo[3]=4.0;      // c0 原样
            eo[4]=50.0; eo[5]=51.0; eo[6]=52.0; eo[7]=53.0;  // c1 被整块替换
            eo[8]=9.0; eo[9]=10.0; eo[10]=11.0; eo[11]=12.0; // c2 原样
            double[] eo2 = new double[12];
            eo2[0]=1.0; eo2[1]=2.0; eo2[2]=3.0; eo2[3]=60.0;   // pos3→60
            eo2[4]=5.0; eo2[5]=6.0; eo2[6]=7.0; eo2[7]=8.0;
            eo2[8]=70.0; eo2[9]=10.0; eo2[10]=11.0; eo2[11]=12.0;  // pos8→70
            int bad = 0;
            i = 0;
            while (i < 12) {
                double d1 = o[i]-eo[i]; if (d1<0.0) d1=0.0-d1; if (d1>1.0e-4) bad=bad+1;
                double d2 = o2[i]-eo2[i]; if (d2<0.0) d2=0.0-d2; if (d2>1.0e-4) bad=bad+1;
                i = i + 1;
            }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n1);
            Console.writeString(","); Console.writeLong(n2);
            Console.writeString(" o0="); Console.writeFloat(o[0]);
            Console.writeString(" o4="); Console.writeFloat(o[4]);
            Console.writeString(" o2[3]="); Console.writeFloat(o2[3]);
            Console.writeString(" o2[8]="); Console.writeFloat(o2[8]);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeLine("");
            if (ok==1 && rk==1 && n1==12 && n2==12 && bad==0) Console.writeLine("JSON SCATTER_ND OK");
            else Console.writeLine("JSON SCATTER_ND FAIL");
        }
}
int main() { JsonScatterNdApp a = new JsonScatterNdApp(); return 0; }
