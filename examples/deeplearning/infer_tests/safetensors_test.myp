// safetensors_test.myp — safetensors 读取器验证（qwen2-0.5b 真机权重）
// 验证：header 解析（张量数/名/dtype/shape/偏移）+ BF16→F32 与既有 .bin 提取对拍。
import env;
import math;
import "../infer/safetensors.myp";

class STTest {
    action:
        @constructor STTest() {
            SafeTensors st = new SafeTensors();
            string path = "./deeplearning/data/llm/qwen2-0.5b-instruct/model.safetensors";
            int ok = st.load(path);
            if (ok == 0) {
                Console.writeLine("load failed");
                return;
            }
            Console.writeString("tensor count: ");
            Console.writeLong(st.tensorCount());
            Console.writeLine("");
            // 打印前 3 个张量元数据
            int i = 0;
            while (i < 3 && i < st.tensorCount()) {
                Console.writeString(st.tensorName(i));
                Console.writeString(" dtype=");
                Console.writeString(st.tensorDtype(i));
                Console.writeString(" shape=[");
                int d = 0;
                while (d < st.tensorRank(i)) {
                    if (d > 0) Console.writeString(",");
                    Console.writeLong(st.tensorDim(i, d));
                    d = d + 1;
                }
                Console.writeString("] off=");
                Console.writeLong(st.tensorByteOff(i));
                Console.writeString(" len=");
                Console.writeLong(st.tensorByteLen(i));
                Console.writeLine("");
                i = i + 1;
            }

            // 整张量读取：model.embed_tokens.weight（151936×896 = 136,134,656 元素）
            int wte = st.findTensor("model.embed_tokens.weight");
            if (wte < 0) {
                Console.writeLine("FAIL: embed_tokens.weight not found");
                return;
            }
            int n = st.tensorElemCount(wte);
            Console.writeString("embed_tokens.weight 元素数: ");
            Console.writeLong(n);
            Console.writeLine("");
            if (n != 136134656) {
                Console.writeLine("FAIL: 元素数异常");
                return;
            }
            // readF32All 一次性读完整张量（BF16→F32）
            float[] full = st.readF32All(wte);
            // 与 .bin（fp32，wte 在文件最前）采样对拍：首 4096 + 末 4096 + 均匀 16 点
            int fd = __myp_io_fopen("./deeplearning/data/llm/qwen2_weights.bin", "rb");
            if (fd < 0) {
                Console.writeLine("FAIL: no qwen2_weights.bin");
                return;
            }
            maxDiff_ = 0.0;
            checked_ = 0;
            int k = 0;
            while (k < 4096 && k < n) { cmpAt(fd, full, k); k = k + 1; }
            k = n - 4096;
            while (k < n) { cmpAt(fd, full, k); k = k + 1; }
            long step = long(n) / 16;
            long pos = step;
            while (pos < long(n) - 4096) { cmpAt(fd, full, int(pos)); pos = pos + step; }
            __myp_io_fclose();
            Console.writeString("full read: 抽查 ");
            Console.writeLong(checked_);
            Console.writeString(" 点 / ");
            Console.writeLong(n);
            Console.writeString(" 元素，maxAbsDiff: ");
            Console.writeFloat(maxDiff_);
            Console.writeLine("");
            if (maxDiff_ == 0.0) Console.writeLine("SAFETENSORS FULL OK (bit-exact)");
            else if (maxDiff_ < 1.0e-6) Console.writeLine("SAFETENSORS FULL OK (within fp32 tol)");
            else Console.writeLine("SAFETENSORS FULL MISMATCH");
        }

        // 抽查单点：.bin 元素 idx（fp32，offset=idx*4）与 full[idx] 对拍
        void cmpAt(int fd, float[] got, int idx) {
            __myp_io_seek(idx * 4, 0);
            int b0 = __myp_io_read_byte(); int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte(); int b3 = __myp_io_read_byte();
            if (b3 < 0) return;
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            double refv = F32.toDouble(bits);
            double diff = refv - got[idx];
            if (diff < 0.0) diff = 0.0 - diff;
            if (diff > maxDiff_) maxDiff_ = diff;
            checked_ = checked_ + 1;
        }

    property:
        double maxDiff_;
        long checked_;
}

int main() {
    STTest t = new STTest();
    return 0;
}
