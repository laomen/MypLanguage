// sli_acc_main.myp — 阶段四/九：梯度累积（Session.setGradAccumEvery）验证。
// mnist_mlp 训练（SGD）。验证三方面：
//   A) K=1 与不累积（K=0）跑同一确定性序列 loss 逐位一致（退化正确性：K=1 即每
//      micro 应用 gAcc/1 → 原 SGD）
//   B) K=4 更新节奏：micro-step 1..3 后 W1 权重不变（只累积），第 4 步（累积满 K）
//      才应用一次 → 权重变化
//   C) K=4 收敛：100 个 micro（25 次应用）后 loss 显著下降（累积梯度确实驱动学习）
// CPU（runTrain 走 CPU）。回归框架判定 PASS 无 FAIL 字样。
import env;
import fmt;
import dl;

class SliAccApp {
    action:
        @constructor SliAccApp() {
            // ---- A) K=1 == K=0（逐位一致）----
            Session s0 = new Session();
            int ok0 = s0.loadTrain("./deeplearning/data/onnx/mnist_mlp.onnx");
            s0.setLr(0.01); s0.setTrainMode(1);
            Session s1 = new Session();
            int ok1 = s1.loadTrain("./deeplearning/data/onnx/mnist_mlp.onnx");
            s1.setLr(0.01); s1.setTrainMode(1);
            s1.setGradAccumEvery(1);
            int inT0 = s0.tensorId("data");
            int labT0 = s0.tensorId("label");
            int lossT0 = s0.tensorId("loss");
            int inT1 = s1.tensorId("data");
            int labT1 = s1.tensorId("label");
            int lossT1 = s1.tensorId("loss");
            double maxD = 0.0;
            int step = 0;
            while (step < 20) {
                feedStep(s0, inT0, labT0, step);
                feedStep(s1, inT1, labT1, step);
                s0.runTrain();
                s1.runTrain();
                double L0 = s0.getFlat(lossT0, 0);
                double L1 = s1.getFlat(lossT1, 0);
                double d = L0 - L1;
                if (d < 0.0) d = 0.0 - d;
                if (d > maxD) maxD = d;
                step = step + 1;
            }
            Console.writeString("A K1-vs-K0 maxdiff="); Console.writeFloat(maxD); Console.writeLine("");

            // ---- B) K=4 更新节奏：1..3 micro 权重不变，第 4 步才应用 ----
            Session sb = new Session();
            int okb = sb.loadTrain("./deeplearning/data/onnx/mnist_mlp.onnx");
            sb.setLr(0.05); sb.setTrainMode(1);
            sb.setGradAccumEvery(4);
            int inTb = sb.tensorId("data");
            int labTb = sb.tensorId("label");
            int lossTb = sb.tensorId("loss");
            int wTb = sb.tensorId("W1");
            int nW = sb.tensorSize("W1");
            // 初始 W1 快照（供每 micro 后对比：前 3 micro 应不变，第 4 micro 才应用）
            wBase_ = new double[nW];
            int wi = 0;
            while (wi < nW) { wBase_[wi] = sb.getFlat(wTb, wi); wi = wi + 1; }
            int bOk = 1;
            step = 0;
            while (step < 4) {
                feedStep(sb, inTb, labTb, step);
                sb.runTrain();
                // step 0/1/2（gradAccStep 1/2/3）后 W1 应仍 == 初始；step 3（第 4 micro）后变化
                double d0 = wDiffSince(sb, wTb, nW);
                Console.writeString("B step"); Console.writeLong(step);
                Console.writeString(" gradAccStep="); Console.writeLong(sb.gradAccumStep());
                Console.writeString(" W1chg="); Console.writeFloat(d0); Console.writeLine("");
                if (step < 3 && d0 != 0.0) bOk = 0;   // 前 3 micro 未更新
                if (step == 3 && d0 == 0.0) bOk = 0;  // 第 4 micro 应已应用
                step = step + 1;
            }

            // ---- C) K=4 收敛：100 micro（25 应用）loss 显著下降 ----
            step = 4;
            double Linit = sb.getFlat(lossTb, 0);
            while (step < 100) {
                feedStep(sb, inTb, labTb, step);
                sb.runTrain();
                step = step + 1;
            }
            double Lend = sb.getFlat(lossTb, 0);
            Console.writeString("C K4 loss@4="); Console.writeFloat(Linit);
            Console.writeString(" loss@100="); Console.writeFloat(Lend); Console.writeLine("");

            if (ok0 == 1 && ok1 == 1 && okb == 1 && maxD < 1.0e-6 &&
                bOk == 1 && Lend < Linit / 2.0) {
                Console.writeLine("SLI ACC OK");
            } else {
                Console.writeLine("SLI ACC MISMATCH");
            }
        }

        // 权重相对初始快照 wBase_ 的最大绝对变化
        double wDiffSince(Session s, int wT, int n) {
            double maxD = 0.0;
            int i = 0;
            while (i < n) {
                double v = s.getFlat(wT, i);
                double base = wBase_[i];
                double d = v - base;
                if (d < 0.0) d = 0.0 - d;
                if (d > maxD) maxD = d;
                i = i + 1;
            }
            return maxD;
        }
        property:
            // W1 初始快照（测试 B：对比每 micro 后权重是否变化）
            double[] wBase_ = new double[1];

        action:
        // 确定性喂第 step 步：class=(step*7)%10；data=特征位+噪声；label one-hot[c]
        void feedStep(Session s, int inT, int labTid, int step) {
            int c = (step * 7) % 10;
            int i = 0;
            while (i < 784) {
                double v = 0.0;
                if (i % 10 == c) {
                    v = 1.0;
                } else {
                    int nn = (i * 131 + step * 17) % 1000;
                    v = double(nn) / 100000.0;
                }
                s.setFlat(inT, i, v);
                i = i + 1;
            }
            i = 0;
            while (i < 10) { s.setFlat(labTid, i, 0.0); i = i + 1; }
            s.setFlat(labTid, c, 1.0);
        }
}

int main() { SliAccApp a = new SliAccApp(); return 0; }
