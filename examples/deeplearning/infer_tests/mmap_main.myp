// mmap_main.myp — 阶段七：mmap 零拷贝加载测试
// 用 loadMmap 加载已有 Conv 模型（deadweight_test.onnx：x[1,1,5,5]→Conv→y[1,1,3,3]），
// 验证：mmap 字节源解析 + 权重从 mmap 读取，输出 vs ORT 一致（CPU+GPU）。
// 另加载 extdata_test.onnx（外置权重）+ mmap 主文件 → 追加区路径。
import env;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class MmapTestApp {
    action:
        @constructor MmapTestApp() {
            int ok1 = runOne("./deeplearning/data/onnx/deadweight_test.onnx",
                            "./deeplearning/data/onnx/deadweight_in.f32",
                            "./deeplearning/data/onnx/deadweight_test_ort.bin",
                            "x", "y", 25, 9);
            int ok2 = runOne("./deeplearning/data/onnx/extdata_test.onnx",
                            "./deeplearning/data/onnx/extdata_in.f32",
                            "./deeplearning/data/onnx/extdata_test_ort.bin",
                            "x", "y", 25, 9);
            Console.writeString("mmap1="); Console.writeLong(ok1);
            Console.writeString(" mmap2="); Console.writeLong(ok2);
            Console.writeLine("");
            if (ok1 == 1 && ok2 == 1) Console.writeLine("MMAP ALL OK");
            else Console.writeLine("MMAP MISMATCH");
        }

        int runOne(string model, string inF, string ortF, string inN, string outN, int nIn, int nOut) {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.loadMmap(model, rt);   // 阶段七：mmap 零拷贝加载
            if (ok == 0) { Console.writeLine("loadMmap failed: " + model); return 0; }
            int inT = loader.tensorId(inN);
            int outT = loader.tensorId(outN);
            if (inT < 0 || outT < 0) { Console.writeLine("tensor not found"); return 0; }
            double[] buf = new double[64];
            readF32(inF, buf, nIn);
            int i = 0;
            while (i < nIn) { rt.setFlat(inT, i, buf[i]); i = i + 1; }
            int useGpu = 0;
            if (Console.getEnv("MYP_GPU") == "1") useGpu = 1;
            if (useGpu == 1) rt.runGpu(); else rt.run();
            int m = rt.tensorSize(outT);
            return checkOut(rt, outT, ortF, m);
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path, int n) {
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int bad = 0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                if (dv > 1.0e-4) bad = bad + 1;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("  max diff vs ORT: ");
            Console.writeFloat(maxD);
            Console.writeString("  bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (maxD <= 1.0e-4) return 1;
            return 0;
        }
}

int main() { MmapTestApp app = new MmapTestApp(); return 0; }
