// json_rope_main.myp — JSON RoPE 图算子（LLM 位置编码，opKind 113，复用 rope kernel）。
// x dims [S,D]=[3,2]（FC 布局 → 运行时 rows=D=2 特征行、cols=S=3 位置列，row-major d*S+s）。
// heads=1 → dh=2、half=1；旋转行 0/1（逐 dim-pair × 位置）：
//   x=[1,10,100, 2,20,200]（row0=[1,10,100] row1=[2,20,200]）；cos=[0,1,-1]、sin=[1,0,0]
//   （a=0 行 × s：s0 旋转90°、s1 恒等、s2 反相）：
//   s0: y0=1·0-2·1=-2；y3=1·1+2·0=1
//   s1: y1=10；y4=20（恒等）
//   s2: y2=-100；y5=-200
//   → y flat=[-2,10,-100, 1,20,-200]（x 不被破坏：out 独立张量）。
// CPU+GPU JSON ROPE OK。
import env;
import fmt;
import dl;

class JsonRopeApp {
    action:
        @constructor JsonRopeApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/rope.json");
            if (ok == 0) { Console.writeLine("JSON ROPE SKIP (no load)"); return; }
            double[] x = new double[6];
            x[0]=1.0; x[1]=10.0; x[2]=100.0;   // row0（特征 d=0）s0..s2
            x[3]=2.0; x[4]=20.0; x[5]=200.0;   // row1（特征 d=1）
            s.setInput("x", x, 6);
            double[] c = new double[3];
            c[0]=0.0; c[1]=1.0; c[2]=-1.0;
            s.setInput("cos", c, 3);
            double[] sn = new double[3];
            sn[0]=1.0; sn[1]=0.0; sn[2]=0.0;
            s.setInput("sin", sn, 3);
            int rk = s.runAuto();
            double[] y = s.getOutput("y");
            int n = s.tensorSize("y");
            double[] e = new double[6];
            e[0]=-2.0; e[1]=10.0; e[2]=-100.0;
            e[3]=1.0;  e[4]=20.0; e[5]=-200.0;
            int bad = 0;
            int i = 0;
            while (i < 6) {
                double d = y[i]-e[i]; if (d<0.0) d=0.0-d; if (d>1.0e-3) bad=bad+1;
                i = i + 1;
            }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n);
            Console.writeString(" y0="); Console.writeFloat(y[0]);
            Console.writeString(" y2="); Console.writeFloat(y[2]);
            Console.writeString(" y5="); Console.writeFloat(y[5]);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeLine("");
            if (ok==1 && rk==1 && n==6 && bad==0) Console.writeLine("JSON ROPE OK");
            else Console.writeLine("JSON ROPE FAIL");
        }
}
int main() { JsonRopeApp a = new JsonRopeApp(); return 0; }
