{ "name":"activchain",
  "inputs":[{"name":"x","dims":[1,4]}],
  "outputs":["prob"],
  "layers":[
    { "op":"Gemm","in":"x","out":"h1","transB":1,
      "W":{"dims":[8,4],"init":"xavier"},"B":{"dims":[8],"init":"zeros"}},
    { "op":"LeakyRelu","in":"h1","out":"a1"},
    { "op":"Gemm","in":"a1","out":"h2","transB":1,
      "W":{"dims":[8,8],"init":"xavier"},"B":{"dims":[8],"init":"zeros"}},
    { "op":"Relu6","in":"h2","out":"a2"},
    { "op":"Gemm","in":"a2","out":"h3","transB":1,
      "W":{"dims":[8,8],"init":"xavier"},"B":{"dims":[8],"init":"zeros"}},
    { "op":"HardSwish","in":"h3","out":"a3"},
    { "op":"Gemm","in":"a3","out":"logits","transB":1,
      "W":{"dims":[3,8],"init":"xavier"},"B":{"dims":[3],"init":"zeros"}},
    { "op":"Softmax","in":"logits","out":"prob","axis":1}
  ]
}
