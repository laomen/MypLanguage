// sli_opt_main.myp — 阶段九 SLI：优化器（SGD/动量/AdamW + weight decay）收敛测试。
// mnist_mlp 训练模式，同一确定性 class 特征数据序列分别用三种优化器各跑 250 步：
//   三者 loss 都应单调显著下降（优化器状态区 prepOptState/动量·Adam 更新生效）；
//   weight decay>0 时权重范数受约束（选 AdamW 对比验证 wd 生效）。
// 说明：Session.setOptimizer 0=SGD（默认）/1=动量/2=AdamW；setWeightDecay 设 wd；
// 每步 runTrain 重建输入（arena 复用覆盖）；label one-hot[10]。runTrain 走 CPU。
import env;
import fmt;
import dl;

class SliOptApp {
    action:
        @constructor SliOptApp() {
            // ---- 三种优化器各训 250 步（同一数据序列），记录首末 loss ----
            int m = 0;
            int okAll = 1;
            int[] lEnd = new int[3];
            double[] l0a = new double[3];
            while (m < 3) {
                Session s = new Session();
                int ok = s.loadTrain("./deeplearning/data/onnx/mnist_mlp.onnx");
                if (ok == 0) { Console.writeLine("SLI OPT SKIP (no model)"); return; }
                s.setLr(0.01);
                s.setOptimizer(m);
                s.setTrainMode(1);
                int inT = s.tensorId("data");
                int labTid = s.tensorId("label");
                int lossTid = s.tensorId("loss");
                if (inT < 0 || labTid < 0 || lossTid < 0) { okAll = 0; m = m + 1; continue; }

                // 首步 loss（训练前，作为基线）
                feedStep(s, inT, labTid, 0);
                s.runTrain();
                double L0 = s.getFlat(lossTid, 0);
                l0a[m] = L0;

                // 继续训到 250 步
                int step = 1;
                while (step < 250) {
                    feedStep(s, inT, labTid, step);
                    s.runTrain();
                    step = step + 1;
                }
                double L = s.getFlat(lossTid, 0);
                lEnd[m] = int(L * 1000.0);

                Console.writeString("opt"); Console.writeLong(m);
                Console.writeString(" loss0="); Console.writeFloat(L0);
                Console.writeString(" loss250="); Console.writeFloat(L);
                Console.writeLine("");
                m = m + 1;
            }

            // ---- AdamW + weight decay：权重范数受约束 ----
            double[] lEndW = new double[2];
            Session a = new Session();
            int okA = a.loadTrain("./deeplearning/data/onnx/mnist_mlp.onnx");
            a.setLr(0.01); a.setOptimizer(2); a.setTrainMode(1);
            Session b = new Session();
            int okB = b.loadTrain("./deeplearning/data/onnx/mnist_mlp.onnx");
            b.setLr(0.01); b.setOptimizer(2); b.setWeightDecay(0.01); b.setTrainMode(1);
            int inT = a.tensorId("data");
            int labTid = a.tensorId("label");
            int step = 0;
            while (step < 250) {
                feedStep(a, inT, labTid, step);
                feedStep(b, inT, labTid, step);
                a.runTrain();
                b.runTrain();
                step = step + 1;
            }
            // 训练后取 W1 权重范数（wd 版本应更小：解耦权重衰减把 w 拉向 0）
            double na = wNorm(a, "W1");
            double nb = wNorm(b, "W1");
            Console.writeString("AdamW noWd norm="); Console.writeFloat(na);
            Console.writeString(" wd norm="); Console.writeFloat(nb);
            Console.writeLine("");

            // ---- 判定：三优化器都显著收敛（250 步 loss 降到 <0.5，可能近 0）+ wd 使权重范数更小 ----
            if (okA == 1 && okB == 1 && okAll == 1 &&
                lEnd[0] < 500 && lEnd[1] < 500 && lEnd[2] < 500 &&
                nb < na) {
                Console.writeLine("SLI OPT OK");
            } else {
                Console.writeLine("SLI OPT MISMATCH");
            }
        }

        // 权重范数（平方和，粗；按名取 tensor 长度）
        double wNorm(Session s, string name) {
            int wT = s.tensorId(name);
            int n = s.tensorSize(name);
            double acc = 0.0;
            int i = 0;
            while (i < n) {
                double v = s.getFlat(wT, i);
                acc = acc + v * v;
                i = i + 1;
            }
            return acc;
        }

        // 确定性喂第 step 步：class=(step*7)%10；data=特征位+噪声；label one-hot[c]
        void feedStep(Session s, int inT, int labTid, int step) {
            int c = (step * 7) % 10;
            int i = 0;
            while (i < 784) {
                double v = 0.0;
                if (i % 10 == c) {
                    v = 1.0;
                } else {
                    int nn = (i * 131 + step * 17) % 1000;
                    v = double(nn) / 100000.0;
                }
                s.setFlat(inT, i, v);
                i = i + 1;
            }
            i = 0;
            while (i < 10) { s.setFlat(labTid, i, 0.0); i = i + 1; }
            s.setFlat(labTid, c, 1.0);
        }
}

int main() { SliOptApp a = new SliOptApp(); return 0; }
