// json_gather_elem_train_main.myp — P8b：JSON GatherElements 训练（MSE）端到端固化。
// gather_elem_train.json：x[1,1,4,4]→Conv(1x1, 2ch)→f[1,2,4,4]（可训 W[2,1,1,1]）→
//   GatherElements(axis=1, ix 交换通道)→out[1,2,4,4]。MSE 对 label（同形）。
//  Conv 1x1：f_c(p)=w_c·x(p)+b_c。ix[cc] 选 data ch(1-cc) → out0=f1、out1=f0。
//  目标 out0=2·x、out1=0.5·x → 可精确拟合（w1=2、w0=0.5、b=0）。若 GatherElements
//  反向把 out 梯度路由错通道（不交换），loss 不降 → 本测试抓路由。
// CPU JSON GATHER_ELEM TRAIN OK（lr=0.005 × 1500 步；l0≈183 → lf≈1e-4，fitbad=0）。
import env;
import fmt;
import dl;

class JsonGatherElemTrainApp {
    action:
        @constructor JsonGatherElemTrainApp() {
            Session t = new Session();
            t.setLossMode(2);   // MSE
            int tok = t.loadJsonTrain("./deeplearning/infer_tests/gather_elem_train.json");
            if (tok == 0) { Console.writeLine("JSON GATHER_ELEM TRAIN SKIP (no load)"); return; }
            t.setLr(0.005); t.setTrainMode(1);
            // x = 1..16（4x4 行优先）
            double[] bx = new double[16];
            int i = 0;
            while (i < 16) { bx[i] = double(i + 1); i = i + 1; }
            t.setInput("x", bx, 16);
            // ix：交换通道（out cc ← data ch 1-cc）
            double[] ix = new double[32];
            i = 0;
            while (i < 32) {
                int cc = i / 16;
                ix[i] = double(1 - cc);
                i = i + 1;
            }
            t.setInput("ix", ix, 32);
            int labT = t.tensorId("label");
            // label：out0=2x、out1=0.5x（16 空间位置，x=p+1）
            int p = 0;
            while (p < 16) {
                t.setFlat(labT, p, 2.0 * double(p + 1));         // c0
                t.setFlat(labT, 16 + p, 0.5 * double(p + 1));    // c1
                p = p + 1;
            }
            double l0 = 0.0; double lf = 0.0;
            int step = 0;
            while (step < 1500) {
                t.runTrain();
                if (step == 0) l0 = t.loss();
                if (step == 1499) lf = t.loss();
                step = step + 1;
            }
            // 读最终 out 拟合误差
            double[] o = t.getOutput("out");
            int bad = 0;
            p = 0;
            while (p < 16) {
                double e0 = o[p] - 2.0 * double(p + 1); if (e0 < 0.0) e0 = 0.0 - e0; if (e0 > 0.3) bad = bad + 1;
                double e1 = o[16 + p] - 0.5 * double(p + 1); if (e1 < 0.0) e1 = 0.0 - e1; if (e1 > 0.3) bad = bad + 1;
                p = p + 1;
            }
            Console.writeString("l0="); Console.writeFloat(l0);
            Console.writeString(" lf="); Console.writeFloat(lf);
            Console.writeString(" fitbad="); Console.writeLong(bad);
            Console.writeLine("");
            if (tok == 1 && l0 > 0.5 && lf < 0.05 * l0 && bad == 0) Console.writeLine("JSON GATHER_ELEM TRAIN OK");
            else Console.writeLine("JSON GATHER_ELEM TRAIN FAIL");
        }
}
int main() { JsonGatherElemTrainApp app = new JsonGatherElemTrainApp(); return 0; }
