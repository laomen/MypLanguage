// json_in_main.myp — JSON InstanceNormalization 分派（[C] scale/bias + eps；运行时
// 通道统计）。in.json：x[1,1,2,2]=[1,2,3,4] IN（每 (n,c) 整图总体方差）：
//   μ=2.5 σ=sqrt(1.25) scale=2 bias=1 → y=(x-2.5)/1.1180*2+1
//   = [-1.68328, -0.105573, 1.89443, 3.68328]（y0..y3）
import env;
import fmt;
import dl;

class JsonInApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        @constructor JsonInApp() {
            Session t = new Session();
            int tok = t.loadJson("./deeplearning/infer_tests/in.json");
            Console.writeString("load="); Console.writeLong(tok); Console.writeLine("");
            if (tok == 0) { Console.writeLine("JSON IN SKIP (no load)"); return; }
            double[] bx = new double[4]; bx[0] = 1.0; bx[1] = 2.0; bx[2] = 3.0; bx[3] = 4.0;
            t.setInput("x", bx, 4);
            int rk = t.runAuto();
            double[] y = t.getOutput("y");
            int bad = 0;
            if (rk == 0) bad = bad + 1;
            double[] e = new double[4]; e[0] = -1.68328; e[1] = 0.105573; e[2] = 1.89443; e[3] = 3.68328;
            int i = 0;
            while (i < 4) {
                if (absd(y[i] - e[i]) > 3.0e-3) bad = bad + 1;
                i = i + 1;
            }
            Console.writeString("y0="); Console.writeFloat(y[0]);
            Console.writeString(" y3="); Console.writeFloat(y[3]);
            Console.writeLine("");
            if (bad == 0) Console.writeLine("JSON IN OK");
            else Console.writeLine("JSON IN MISMATCH");
        }
}

int main() { JsonInApp app = new JsonInApp(); return 0; }
