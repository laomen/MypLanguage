// run_onnx.myp — F7：通用 ONNX 运行器（零样板：自动探测输入/输出张量）
// 任意 ONNX 模型 + 输入 .f32 文件 → 推理 → 打印输出 / top-k。消除每个模型的样板 main。
//
// 用法（仓库根）：
//   ./build/mypc deeplearning/infer_tests/run_onnx.myp -o /tmp/run_onnx --stdlib stdlib
//   /tmp/run_onnx <model.onnx> <input.f32> [--in name] [--out name] [--topk N] [-o out.bin]
//   MYP_GPU=1 /tmp/run_onnx ...    # GPU 卸载（无 GPU 自动回退 CPU）
//
// 输入/输出张量名省略时自动探测：图输入中第一个非 initializer = 模型输入；
// 图输出 = 模型输出（多输入/多输出模型用 --in/--out 指定）。
//
// 输入：input.f32 = float32 小端，元素数须等于输入张量元素数（形状表推断，动态维=1）。
// 输出：--topk N → 打印 top-N 索引+值（分类模型）；否则打印 output sum + 前 10 个值；
//       -o out.bin → 把输出张量写为 float32 小端二进制（供 ORT 交叉校验等）。
import env;
import cuda;
import args;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class RunOnnxApp {
    action:
        @constructor RunOnnxApp() {
            if (Args.count() < 3) {
                Console.writeLine("用法: run_onnx <model.onnx> <input.f32> [--in name] [--out name] [--topk N] [-o out.bin]");
                Console.writeLine("输入/输出张量名省略时自动探测（图输入去 initializer = 模型输入；图输出 = 模型输出）。");
                return;
            }
            string modelPath = Args.get(1);
            string inputFile = "";
            string inName = "";    // 空 = 自动探测
            string outName = "";   // 空 = 自动探测
            int topk = 0;
            string outPath = "";
            int i = 2;
            while (i < Args.count()) {
                string a = Args.get(i);
                if (a == "--in" && i + 1 < Args.count()) {
                    inName = Args.get(i + 1); i = i + 2;
                } else if (a == "--out" && i + 1 < Args.count()) {
                    outName = Args.get(i + 1); i = i + 2;
                } else if (a == "--topk" && i + 1 < Args.count()) {
                    topk = parseInt(Args.get(i + 1)); i = i + 2;
                } else if (a == "-o" && i + 1 < Args.count()) {
                    outPath = Args.get(i + 1); i = i + 2;
                } else {
                    // 第一个非标志位置参数 = 输入 .f32
                    if (Str.len(inputFile) == 0) inputFile = a;
                    i = i + 1;
                }
            }
            if (Str.len(inputFile) == 0) {
                Console.writeLine("missing input .f32 file");
                return;
            }

            InferenceRuntime rt = new InferenceRuntime();
            rt.init(1024);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load(modelPath, rt);
            if (ok == 0) {
                Console.writeLine("onnx load failed: " + modelPath);
                return;
            }
            int inTid = -1;
            int outTid = -1;
            if (Str.len(inName) > 0) inTid = loader.tensorId(inName);
            if (Str.len(outName) > 0) outTid = loader.tensorId(outName);
            // 自动探测输入：图输入中第一个非 initializer（真实模型输入）
            if (inTid < 0) {
                int gi = 0;
                while (gi < loader.graphInputCount()) {
                    string nm = loader.graphInputName(gi);
                    if (loader.isWeightName(nm) == 0) {
                        int t = loader.tensorId(nm);
                        if (t >= 0) { inTid = t; inName = nm; break; }
                    }
                    gi = gi + 1;
                }
            }
            // 自动探测输出：图输出（分类模型通常 1 个；多输出请用 --out）
            if (outTid < 0 && loader.graphOutputCount() > 0) {
                string nm = loader.graphOutputName(0);
                int t = loader.tensorId(nm);
                if (t >= 0) { outTid = t; outName = nm; }
            }
            if (inTid < 0 || outTid < 0) {
                Console.writeString("tensor not found (in=");
                Console.writeString(inName);
                Console.writeString(" out=");
                Console.writeString(outName);
                Console.writeLine(") — 多输入/多输出模型请用 --in/--out 指定");
                return;
            }
            Console.writeString("input tensor: ");
            Console.writeString(inName);
            Console.writeString("  output tensor: ");
            Console.writeString(outName);
            Console.writeLine("");

            // 读输入 .f32（float32 小端，n = 输入张量元素数）
            int n = loader.shapeElementCount(inName);
            if (n <= 0) {
                Console.writeLine("cannot determine input tensor size (动态维度? 需 setInputShape)");
                return;
            }
            int fd = __myp_io_fopen(inputFile, "rb");
            if (fd < 0) {
                Console.writeLine("no input file: " + inputFile);
                return;
            }
            int j = 0;
            while (j < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                rt.setFlat(inTid, j, F32.toDouble(bits));
                j = j + 1;
            }
            __myp_io_fclose();
            if (j < n) {
                Console.writeString("input short (");
                Console.writeLong(j);
                Console.writeString("/");
                Console.writeLong(n);
                Console.writeLine(")");
                return;
            }

            // 设备 + 推理
            int useGpu = Cuda.available();
            Console.writeString("device: ");
            if (useGpu == 1) {
                Console.writeString(Cuda.name());
                Console.writeString(" (GPU)");
            } else {
                Console.writeString("CPU");
            }
            Console.writeLine("");
            Console.writeString("graph: nodes=");
            Console.writeLong(loader.nodeCount());
            Console.writeString(" ops=");
            Console.writeLong(rt.opCount());
            Console.writeString(" bn_fused=");
            Console.writeLong(loader.bnCount());
            Console.writeString(" convRelu_fused=");
            Console.writeLong(loader.fuseCount());
            Console.writeLine("");

            long t0 = __myp_now_ms();
            if (useGpu == 1) rt.runGpu();
            else rt.run();
            long t1 = __myp_now_ms();
            Console.writeString("inference: ");
            Console.writeLong(t1 - t0);
            Console.writeLine(" ms");

            // 先写二进制输出（再打印 top-k——打印会改输出张量找 top，故必须先写）
            int m = loader.shapeElementCount(outName);
            if (m <= 0) m = rt.tensorSize(outTid);
            if (Str.len(outPath) > 0) {
                int ofd = __myp_io_fopen(outPath, "wb");
                if (ofd < 0) {
                    Console.writeLine("cannot write: " + outPath);
                    return;
                }
                int t = 0;
                while (t < m) {
                    int bits = F32.toBits(rt.getFlat(outTid, t));
                    __myp_io_write_byte(bits & 255);
                    __myp_io_write_byte((bits >> 8) & 255);
                    __myp_io_write_byte((bits >> 16) & 255);
                    __myp_io_write_byte((bits >> 24) & 255);
                    t = t + 1;
                }
                __myp_io_fclose();
                Console.writeString("wrote ");
                Console.writeString(outPath);
                Console.writeString(" (输出");
                Console.writeLong(m);
                Console.writeString(" float32)");
                Console.writeLine("");
            }

            // 输出
            if (topk > 0) {
                printTopK(rt, outTid, m, topk);
            } else {
                double ssum = 0.0;
                int t = 0;
                while (t < m) { ssum = ssum + rt.getFlat(outTid, t); t = t + 1; }
                Console.writeString("output sum: ");
                Console.writeFloat(ssum);
                Console.writeLine("");
                int show = m;
                if (show > 10) show = 10;
                Console.writeString("first ");
                Console.writeLong(show);
                Console.writeLine(":");
                t = 0;
                while (t < show) {
                    Console.writeFloat(rt.getFlat(outTid, t));
                    Console.writeString(" ");
                    t = t + 1;
                }
                Console.writeLine("");
            }
        }

        void printTopK(InferenceRuntime rt, int tid, int n, int k) {
            Console.writeString("top-");
            Console.writeLong(k);
            Console.writeLine(":");
            int c = 0;
            while (c < k) {
                int bi = -1;
                double bv = 0.0 - 1.0e30;
                int t = 0;
                while (t < n) {
                    double v = rt.getFlat(tid, t);
                    if (v > bv) { bv = v; bi = t; }
                    t = t + 1;
                }
                if (bi < 0) break;
                Console.writeString("  #");
                Console.writeLong(c + 1);
                Console.writeString(" [");
                Console.writeLong(bi);
                Console.writeString("] ");
                Console.writeFloat(bv);
                Console.writeLine("");
                rt.setFlat(tid, bi, 0.0 - 1.0e30);
                c = c + 1;
            }
        }

        int parseInt(string s) {
            int r = 0;
            int i = 0;
            int n = Str.len(s);
            while (i < n) {
                int c = Str.ord(Str.substring(s, i, i + 1));
                if (c >= 48 && c <= 57) r = r * 10 + (c - 48);
                i = i + 1;
            }
            return r;
        }
}

int main() {
    RunOnnxApp app = new RunOnnxApp();
    return 0;
}
