// json_convt3d_main.myp — C：JSON ConvTranspose3D（图算子 P7，3D 转置卷积 fwd，CPU+GPU）。
// 两 Session 覆盖 stride1 与 stride2（U-Net 解码 2x 上采样几何）：
//   s1: x[1,1,2,1,1]=[1,3] W=[2,5] stride1 → yD=3 → [2,11,15]（1D 转置卷积手算）
//   s2: x[1,1,2,1,1]=[1,3] W=[2,5] stride2 → yD=(2-1)*2+2=4 → [2,5,6,15]
// CPU+GPU JSON CONVT3D OK。
import env;
import fmt;
import dl;
class JsonConvt3dApp {
    action:
        int runCase(string jsonPath, double[] x, int nx, double[] exp, int ne) {
            Session s = new Session();
            int ok = s.loadJson(jsonPath);
            if (ok == 0) { Console.writeLine("JSON CONVT3D SKIP (no load " + jsonPath + ")"); return 1; }
            s.setInput("x", x, nx);
            int rk = s.runAuto();
            double[] o = s.getOutput("y");
            int n = s.tensorSize("y");
            int bad = 0;
            if (n != ne) bad = bad + 1;
            int i = 0;
            while (i < ne) {
                if (i < n) { double d = o[i]-exp[i]; if (d<0.0) d=0.0-d; if (d>1.0e-3) bad=bad+1; }
                i = i + 1;
            }
            Console.writeString(jsonPath + " run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeString(" y1="); Console.writeFloat((n > 1) ? o[1] : 0.0);
            Console.writeLine("");
            return (ok == 1 && rk == 1 && bad == 0) ? 0 : 1;
        }
        @constructor JsonConvt3dApp() {
            double[] x = new double[2];
            x[0]=1.0; x[1]=3.0;
            double[] e1 = new double[3]; e1[0]=2.0; e1[1]=11.0; e1[2]=15.0;
            double[] e2 = new double[4]; e2[0]=2.0; e2[1]=5.0; e2[2]=6.0; e2[3]=15.0;
            int bad = runCase("./deeplearning/infer_tests/convt3d.json", x, 2, e1, 3);
            bad = bad + runCase("./deeplearning/infer_tests/convt3d_s2.json", x, 2, e2, 4);
            if (bad == 0) Console.writeLine("JSON CONVT3D OK");
            else Console.writeLine("JSON CONVT3D FAIL");
        }
}
int main() { JsonConvt3dApp a = new JsonConvt3dApp(); return 0; }
