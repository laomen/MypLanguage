// json_convt3d_main.myp — C：JSON ConvTranspose3D（图算子 P7，3D 转置卷积 fwd，CPU）。
// x[1,1,2,1,1]=[1,3]（Cin=1,xD=2），W[1,1,2,1,1]=[2,5]（Cin,Cout,kd），stride=1 no-pad
// → yD=(2-1)*1-0-0+2=3；y[o]=Σ_i x[i]·w[o-i]（1D 转置卷积）：
//   y0 = x0·w0 = 1·2 = 2；y1 = x0·w1 + x1·w0 = 5+6 = 11；y2 = x1·w1 = 15
// 判据 [2,11,15]（CPU run；GPU kernel 后续）。JSON CONVT3D OK。
import env;
import fmt;
import dl;
class JsonConvt3dApp {
    action:
        @constructor JsonConvt3dApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/convt3d.json");
            if (ok == 0) { Console.writeLine("JSON CONVT3D SKIP (no load)"); return; }
            double[] x = new double[2];
            x[0]=1.0; x[1]=3.0;
            s.setInput("x", x, 2);
            int rk = s.run();   // ConvTranspose3D 现 CPU fwd
            double[] o = s.getOutput("y");
            int n = s.tensorSize("y");
            double[] exp = new double[3];
            exp[0]=2.0; exp[1]=11.0; exp[2]=15.0;
            int bad = 0;
            int i = 0;
            while (i < 3) { double d = o[i]-exp[i]; if (d<0.0) d=0.0-d; if (d>1.0e-3) bad=bad+1; i = i + 1; }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeString(" y1="); Console.writeFloat(o[1]);
            Console.writeLine("");
            if (ok==1 && rk==1 && n==3 && bad==0) Console.writeLine("JSON CONVT3D OK");
            else Console.writeLine("JSON CONVT3D FAIL");
        }
}
int main() { JsonConvt3dApp a = new JsonConvt3dApp(); return 0; }
