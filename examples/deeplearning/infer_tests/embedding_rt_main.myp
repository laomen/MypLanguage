// embedding_rt_main.myp — G5：Embedding 查表（直接 runtime API 单测）
// ONNX 无标准 Embedding op（Embedding 用 Gather(axis=0) 表达）——本 op 作为
// 框架层 row-major 查表算子，直接构建 runtime 验证 CPU+GPU 一致。
// w[vocab=5, D=4]（线性 0..19），ids=[1,3,0]（S=3）→ out[3,4]。
// 验证 out[s*D+d] == w[ids[s]*D+d]。
import env;
import "../infer/runtime.myp";

class EmbeddingRtApp {
    action:
        @constructor EmbeddingRtApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(1024);
            int wT = rt.addTensor(5, 4);
            int idT = rt.addTensor(3, 1);
            int outT = rt.addTensor(3, 4);
            int i = 0;
            while (i < 20) { rt.setFlat(wT, i, double(i)); i = i + 1; }
            rt.setFlat(idT, 0, 1.0);
            rt.setFlat(idT, 1, 3.0);
            rt.setFlat(idT, 2, 0.0);
            rt.addEmbedding(wT, idT, outT, 5, 4, 3);
            rt.run();
            double maxD = 0.0;
            int bad = 0;
            int s = 0;
            while (s < 3) {
                int d = 0;
                while (d < 4) {
                    int expect = int(rt.getFlat(idT, s)) * 4 + d;
                    double got = rt.getFlat(outT, s * 4 + d);
                    double dv = got - double(expect);
                    if (dv < 0.0) dv = 0.0 - dv;
                    if (dv > maxD) maxD = dv;
                    if (dv > 1.0e-4) bad = bad + 1;
                    d = d + 1;
                }
                s = s + 1;
            }
            Console.writeString("max diff: ");
            Console.writeFloat(maxD);
            Console.writeString("  bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (bad == 0 && maxD <= 1.0e-4) Console.writeLine("EMBEDDING ALL OK");
            else Console.writeLine("EMBEDDING MISMATCH");
        }
}

int main() { EmbeddingRtApp app = new EmbeddingRtApp(); return 0; }
