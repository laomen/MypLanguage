{ "name":"swiglu",
  "inputs":[{"name":"x","dims":[1,4]}],
  "outputs":["prob"],
  "layers":[
    { "op":"Gemm","in":"x","out":"gate","transB":1,
      "W":{"dims":[6,4],"init":"xavier"},"B":{"dims":[6],"init":"zeros"}},
    { "op":"Gemm","in":"x","out":"up","transB":1,
      "W":{"dims":[6,4],"init":"xavier"},"B":{"dims":[6],"init":"zeros"}},
    { "op":"SiLU","in":"gate","out":"gact"},
    { "op":"Mul","in":"gact","out":"m","in2":"up"},
    { "op":"Gemm","in":"m","out":"logits","transB":1,
      "W":{"dims":[3,6],"init":"xavier"},"B":{"dims":[3],"init":"zeros"}},
    { "op":"Softmax","in":"logits","out":"prob","axis":1}
  ]
}
