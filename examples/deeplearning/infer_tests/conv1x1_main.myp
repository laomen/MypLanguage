// conv1x1_main.myp — 阶段五：Conv 1x1 专用 lowering（opKind 83）测试
// conv1x1_test.onnx：x[1,3,8,8] → Conv(1x1)→y1[5,8,8]；Conv(1x1)→Relu→y2r[4,8,8]；
//   Conv(3x3)→y3[2,6,6]；Concat→y[1,11,8,8]。y1/y2 走 opKind 83，y3 走 opKind 7。
// 验证：1) 输出 vs ORT 正确；2) runtime op 表出现 opKind 83（1x1 lowering 生效）。
import env;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class Conv1x1TestApp {
    action:
        @constructor Conv1x1TestApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/conv1x1_test.onnx", rt);
            if (ok == 0) { Console.writeLine("load failed"); return; }
            Console.writeString("graph: ops=");
            Console.writeLong(rt.opCount());
            Console.writeLine("");

            // 检查 op 表中是否有 opKind 83
            int has83 = 0;
            int oi = 0;
            while (oi < rt.opCount()) {
                if (rt.opKindDebug(oi) == 83) has83 = 1;
                oi = oi + 1;
            }
            Console.writeString("has opKind 83 (conv1x1)=");
            Console.writeLong(has83);
            Console.writeLine("");

            int inT = loader.tensorId("x");
            int outT = loader.tensorId("y");
            if (inT < 0 || outT < 0) { Console.writeLine("tensor not found"); return; }
            int nIn = rt.tensorSize(inT);
            double[] buf = new double[256];
            readF32("./deeplearning/data/onnx/conv1x1_in.f32", buf, nIn);
            int i = 0;
            while (i < nIn) { rt.setFlat(inT, i, buf[i]); i = i + 1; }
            rt.run();
            int m = rt.tensorSize(outT);
            Console.writeString("out size=");
            Console.writeLong(m);
            Console.writeLine("  (expect 704=11*64)");
            int okC = checkOut(rt, outT, "./deeplearning/data/onnx/conv1x1_test_ort.bin", m);

            if (okC == 1 && has83 == 1 && m == 704) Console.writeLine("CONV1X1 ALL OK");
            else Console.writeLine("CONV1X1 MISMATCH");
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path, int n) {
            if (tid < 0) return 0;
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int bad = 0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                if (dv > 1.0e-4) bad = bad + 1;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("max diff vs ORT: ");
            Console.writeFloat(maxD);
            Console.writeString("  bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (maxD <= 1.0e-4) return 1;
            return 0;
        }
}

int main() { Conv1x1TestApp app = new Conv1x1TestApp(); return 0; }
