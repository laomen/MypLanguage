// bwd_bn_main.myp — P8c：BwdBatchNorm（固定 mean/var 的 BN 反向）数值对拍。
// x[1,2,2,2]（NCHW 自然）：c0=[0,1,2,3]、c1=[4,5,6,7]。scale=[1,3]、bias=[0.5,-1]、
// mean=[0,0]、var=[1,4]、eps≈0。rstd0=1、rstd1=0.5 → inv0=1、inv1=1.5。dy=[1..8]。
//   dx = dy·inv → [1,2,3,4, 7.5,9,10.5,12]
//   dscale0=Σdy·x·1=20、dscale1=Σdy·x·0.5=74；dbias=[10,26]。
// 全 PASS → BWD BN OK（CPU-only 直连 runtime）。
import env;
import fmt;
import "../infer/runtime.myp";

class BwdBnApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        @constructor BwdBnApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            rt.setTrain(1);
            int xT = rt.addTensor4(1, 2, 2, 2);
            int dyT = rt.addTensor4(1, 2, 2, 2);
            int dxT = rt.addTensor4(1, 2, 2, 2);
            int sT = rt.addTensor(2, 1);
            int bT = rt.addTensor(2, 1);
            int mT = rt.addTensor(2, 1);
            int vT = rt.addTensor(2, 1);
            int dsT = rt.addTensor(2, 1);
            int dbT = rt.addTensor(2, 1);
            int i = 0;
            while (i < 8) { rt.setFlat(xT, i, double(i)); rt.setFlat(dyT, i, double(i + 1)); i = i + 1; }
            rt.setFlat(sT, 0, 1.0); rt.setFlat(sT, 1, 3.0);
            rt.setFlat(bT, 0, 0.5); rt.setFlat(bT, 1, -1.0);
            rt.setFlat(mT, 0, 0.0); rt.setFlat(mT, 1, 0.0);
            rt.setFlat(vT, 0, 1.0); rt.setFlat(vT, 1, 4.0);
            rt.addBwdBatchNorm(dyT, xT, dxT, sT, bT, mT, vT, dsT, dbT, 1, 2, 4, 0, 0);
            rt.run();
            int bad = 0;
            double[] edx = new double[8];
            edx[0]=1.0; edx[1]=2.0; edx[2]=3.0; edx[3]=4.0;
            edx[4]=7.5; edx[5]=9.0; edx[6]=10.5; edx[7]=12.0;
            i = 0;
            while (i < 8) { if (absd(rt.getFlat(dxT, i) - edx[i]) > 1.0e-3) bad = bad + 1; i = i + 1; }
            if (absd(rt.getFlat(dsT, 0) - 20.0) > 1.0e-3) bad = bad + 1;
            if (absd(rt.getFlat(dsT, 1) - 74.0) > 1.0e-3) bad = bad + 1;
            if (absd(rt.getFlat(dbT, 0) - 10.0) > 1.0e-3) bad = bad + 1;
            if (absd(rt.getFlat(dbT, 1) - 26.0) > 1.0e-3) bad = bad + 1;
            Console.writeString("bwd bn bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (bad == 0) Console.writeLine("BWD BN OK");
            else Console.writeLine("BWD BN MISMATCH");
        }
}
int main() { BwdBnApp app = new BwdBnApp(); return 0; }
