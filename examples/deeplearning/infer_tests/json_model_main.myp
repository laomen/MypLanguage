// json_model_main.myp — 声明式 JSON 模型（不经过 ONNX）端到端测试。
// infer_tests/mlp.json（层式 MLP：Gemm/Relu/Softmax + xavier 内存权重）经
// Session.loadJson / loadJsonTrain 直接构建框架 Graph + optimize/optimizeTrain
// （训练自动补 label/loss + 反向）。验证：
//   1) 推理：loadJson → setInput → runAuto → prob softmax 归一（sum≈1）
//   2) 训练：loadJsonTrain → 确定性 class 特征数据 200 步 SGD → loss 显著下降
//      （label one-hot[10]；每步重建输入；自动补的 label/loss 张量可用）
// CPU（无 MYP_GPU）与 GPU（MYP_GPU=1，推理走 GPU）都应 JSON MODEL OK。
import env;
import fmt;
import dl;

class JsonModelApp {
    action:
        @constructor JsonModelApp() {
            // ---- 1. JSON 推理 ----
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/mlp.json");
            Console.writeString("json load ok="); Console.writeLong(ok);
            Console.writeString(" phase="); Console.writeLong(s.phase());
            Console.writeString(" ops="); Console.writeLong(s.opCount());
            Console.writeLine("");
            if (ok == 0) { Console.writeLine("JSON MODEL SKIP (no load)"); return; }

            double[] x = new double[784];
            int i = 0;
            while (i < 784) { x[i] = double((i * 37) % 100) / 100.0; i = i + 1; }
            s.setInput("data", x, 784);
            int rk = s.runAuto();
            double[] prob = s.getOutput("prob");
            int nOut = s.tensorSize("prob");
            double sum = 0.0;
            i = 0;
            while (i < nOut) { sum = sum + prob[i]; i = i + 1; }
            Console.writeString("infer run="); Console.writeLong(rk);
            Console.writeString(" probN="); Console.writeLong(nOut);
            Console.writeString(" sum="); Console.writeFloat(sum);
            Console.writeLine("");

            // ---- 2. JSON 训练（optimizeTrain 自动补 label/loss + 反向）----
            Session t = new Session();
            int tok = t.loadJsonTrain("./deeplearning/infer_tests/mlp.json");
            t.setLr(0.01); t.setTrainMode(1);
            int labT = t.tensorId("label");
            double l1 = 0.0; double l200 = 0.0;
            int step = 0;
            while (step < 200) {
                int c = (step * 7) % 10;
                double[] bx = new double[784];
                i = 0;
                while (i < 784) {
                    double v = 0.0;
                    if (i % 10 == c) v = 1.0;
                    bx[i] = v;
                    i = i + 1;
                }
                t.setInput("data", bx, 784);
                i = 0;
                while (i < 10) { t.setFlat(labT, i, 0.0); i = i + 1; }
                t.setFlat(labT, c, 1.0);
                t.runTrain();
                if (step == 0) l1 = t.loss();
                if (step == 199) l200 = t.loss();
                step = step + 1;
            }
            Console.writeString("train loss@0="); Console.writeFloat(l1);
            Console.writeString(" loss@200="); Console.writeFloat(l200);
            Console.writeLine("");

            if (ok == 1 && rk == 1 && nOut == 10 && sum > 0.999 && sum < 1.001 &&
                tok == 1 && l1 > 0.5 && l200 < l1 / 2.0) {
                Console.writeLine("JSON MODEL OK");
            } else {
                Console.writeLine("JSON MODEL MISMATCH");
            }
        }
}

int main() { JsonModelApp a = new JsonModelApp(); return 0; }
