// dense_tr_main.myp — 通用 dense 转置布局版（gpu_ops.myp 新增 denseTr）验证
//
// 固化 LLM 验证的「访存合并」规律：权重转置 [xRows,outDim] + 线程=输出行 → warp 连续读
// （batch=1 GEMV 场景非合并布局可慢 7.5x，LLM lm_head 实测）。
// 本测试：同一数学权重 W 生成两种布局（非转置 wFlat[outDim,xRows] 给 dense、
// 转置 wTr[xRows,outDim] 给 denseTr），GPU 各算一遍 y，比较两者逐元素一致。
// 测 batch=1 与 batch=4（多形状回归；重填 x 后须重新 H2D）。
//
// 运行：./build/mypc examples/deeplearning/infer_tests/dense_tr_main.myp -o /tmp/dtr --stdlib stdlib
//       cd examples && MYP_GPU=1 /tmp/dtr

import env;
import cuda;
import gpu;
import "../infer/gpu_ops.myp";

class DenseTrTest {
    action:
        @constructor DenseTrTest() {
            int D = 896;
            int outDim = 64;
            int N = 4;
            int xOff = 0;
            int bOff = xOff + D * N;
            int wFlatOff = bOff + outDim;
            int wTrOff = wFlatOff + outDim * D;
            int yDenseOff = wTrOff + D * outDim;
            int yTrOff = yDenseOff + outDim * N;
            int CAP = yTrOff + outDim * N + 16;
            float[] a = new float[CAP];
            fillInputs(a, xOff, bOff, wFlatOff, wTrOff, D, outDim, N);

            // ---- GPU：dense（非转置） vs denseTr（转置）----
            if (Cuda.available() == 1) {
                GpuBufferF buf = new GpuBufferF(a, CAP);
                long dev = buf.devicePtr();
                if (dev == 0L) { Console.writeLine("DENSE_TR GPU SKIP (alloc fail)"); return; }
                int work = outDim * N;
                GpuInferOps.dense(a, work, xOff, D, wFlatOff, outDim, N, bOff, yDenseOff, dev);
                GpuInferOps.denseTr(a, work, xOff, D, wTrOff, outDim, N, bOff, yTrOff, dev);
                buf.copyToHost(a, yDenseOff, yDenseOff, work);
                buf.copyToHost(a, yTrOff, yTrOff, work);
                check(a, yDenseOff, yTrOff, work, "N=4");

                // ---- N=1 形状回归（重填 x 须重新 H2D）----
                int j = 0;
                while (j < D) {
                    a[xOff + j] = float(Math.sin(double(j) * 0.021)) * float((j % 3) + 1);
                    j = j + 1;
                }
                buf.copyFromHost(a, xOff, xOff, D);
                int work1 = outDim;
                GpuInferOps.dense(a, work1, xOff, D, wFlatOff, outDim, 1, bOff, yDenseOff, dev);
                GpuInferOps.denseTr(a, work1, xOff, D, wTrOff, outDim, 1, bOff, yTrOff, dev);
                buf.copyToHost(a, yDenseOff, yDenseOff, work1);
                buf.copyToHost(a, yTrOff, yTrOff, work1);
                check(a, yDenseOff, yTrOff, work1, "N=1");
                buf.free();
            } else {
                Console.writeLine("DENSE_TR GPU SKIP (no CUDA)");
            }
        }

        void fillInputs(float[] a, int xOff, int bOff, int wFlatOff, int wTrOff, int D, int outDim, int N) {
            int j = 0;
            while (j < D * N) {
                a[xOff + j] = float(Math.sin(double(j) * 0.013)) * float((j % 5) + 1);
                j = j + 1;
            }
            int o = 0;
            while (o < outDim) {
                a[bOff + o] = float(Math.cos(double(o) * 0.05));
                o = o + 1;
            }
            o = 0;
            while (o < outDim) {
                int d = 0;
                while (d < D) {
                    double wv = Math.sin(double(o) * 0.017 + double(d) * 0.007);
                    a[wFlatOff + o * D + d] = float(wv);
                    a[wTrOff + d * outDim + o] = float(wv);
                    d = d + 1;
                }
                o = o + 1;
            }
        }

        void check(float[] a, int off0, int off1, int n, string tag) {
            double mx = 0.0;
            int i = 0;
            while (i < n) {
                double dd = double(a[off0 + i]) - double(a[off1 + i]);
                if (dd < 0.0) dd = 0.0 - dd;
                if (dd > mx) mx = dd;
                i = i + 1;
            }
            if (mx < 0.001) {
                Console.writeString("DENSE_TR GPU " + tag + " OK (maxDiff=");
            } else {
                Console.writeString("DENSE_TR GPU " + tag + " MISMATCH (maxDiff=");
            }
            Console.writeFloat(mx);
            Console.writeLine(")");
        }
}

int main() {
    DenseTrTest t = new DenseTrTest();
    return 0;
}
