// coarse_main.myp — P4：真实 coarse_model 端到端（3D U-Net）
// 输入 input_coarse[1,1,16,16,16]（注入形状），输出 output_coarse[1,6,160,160,160]。
// 写 myp 输出到 coarse_myp.bin，由 tools/check_coarse.py 与 ORT 参考比较。
import env;
import cuda;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class CoarseApp {
    action:
        @constructor CoarseApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(4096);
            OnnxLoader loader = new OnnxLoader();
            loader.setInputShape("input_coarse", 1, 1, 16, 16, 16, 1);
            int ok = loader.load("./deeplearning/data/onnx/coarse_model.onnx", rt);
            if (ok == 0) { Console.writeLine("load failed"); return; }
            Console.writeString("graph: nodes=");
            Console.writeLong(loader.nodeCount());
            Console.writeString("  ops=");
            Console.writeLong(rt.opCount());
            Console.writeString("  fold=");
            Console.writeLong(loader.foldCount());
            Console.writeLine("");

            int inT = loader.tensorId("input_coarse");
            int outT = loader.tensorId("output_coarse");
            if (inT < 0 || outT < 0) { Console.writeLine("tensor not found"); return; }
            int nIn = rt.tensorSize(inT);
            Console.writeString("input size="); Console.writeLong(nIn); Console.writeLine("");
            double[] buf = new double[nIn + 16];
            readF32("./deeplearning/data/onnx/coarse_in.f32", buf, nIn);
            int i = 0;
            while (i < nIn) { rt.setFlat(inT, i, buf[i]); i = i + 1; }

            int useGpu = 0;
            if (Console.getEnv("MYP_GPU") == "1") useGpu = 1;
            Console.writeString("device: ");
            if (useGpu == 1) { Console.writeString(Cuda.name()); Console.writeString(" (GPU)"); }
            else { Console.writeString("CPU"); }
            Console.writeLine("");
            long t0 = __myp_now_ms();
            if (useGpu == 1) rt.runGpu();
            else rt.run();
            long t1 = __myp_now_ms();
            int m = rt.tensorSize(outT);
            Console.writeString("out size="); Console.writeLong(m); Console.writeLine("");
            Console.writeString("coarse infer: ");
            Console.writeLong(t1 - t0);
            Console.writeLine(" ms");
            // 写输出
            int fd = __myp_io_fopen("./deeplearning/data/onnx/coarse_myp.bin", "wb");
            if (fd >= 0) {
                int j = 0;
                while (j < m) {
                    int bits = F32.toBits(rt.getFlat(outT, j));
                    __myp_io_write_byte(bits & 255);
                    __myp_io_write_byte((bits >> 8) & 255);
                    __myp_io_write_byte((bits >> 16) & 255);
                    __myp_io_write_byte((bits >> 24) & 255);
                    j = j + 1;
                }
                __myp_io_fclose();
                Console.writeLine("wrote coarse_myp.bin");
            }
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                out[i] = F32.toDouble(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24));
                i = i + 1;
            }
            __myp_io_fclose();
        }
}

int main() {
    CoarseApp app = new CoarseApp();
    return 0;
}
