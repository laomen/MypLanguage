// json_avgpool_cnn_train_main.myp — AvgPool2D 反向（窗口梯度均摊）端到端验证。
// avgpool_cnn.json：data[1,1,8,8] → Conv(2ch 3x3)→Relu→AveragePool(2x2/2)→
//   Flatten[1,18]→Gemm→logits[1,3]→Softmax。AveragePool 保留部分空间 → class 块
//   位置可学（全 1 块，同 cnn_train）。反向经 BwdAvgPool（dy/有效窗口数 均摊回 dx）
//   → BwdConv 更新。200 步 SGD + one-hot[3] loss 应显著降。
// CPU+GPU JSON AVGPOOL TRAIN OK。
import env;
import fmt;
import dl;

class JsonAvgpoolCnnTrainApp {
    action:
        @constructor JsonAvgpoolCnnTrainApp() {
            Session t = new Session();
            int tok = t.loadJsonTrain("./deeplearning/infer_tests/avgpool_cnn.json");
            Console.writeString("load="); Console.writeLong(tok);
            Console.writeString(" ops="); Console.writeLong(t.opCount());
            Console.writeLine("");
            if (tok == 0) { Console.writeLine("JSON AVGPOOL TRAIN SKIP (no load)"); return; }
            t.setLr(0.05); t.setTrainMode(1);
            int labT = t.tensorId("label");
            double l0 = 0.0; double l200 = 0.0;
            int step = 0;
            while (step < 200) {
                int cl = (step * 5) % 3;
                double[] bx = new double[64];
                int i = 0;
                while (i < 64) {
                    bx[i] = 0.0;
                    if (i >= cl * 16 && i < cl * 16 + 16) bx[i] = 1.0;
                    i = i + 1;
                }
                t.setInput("x", bx, 64);
                i = 0;
                while (i < 3) { t.setFlat(labT, i, 0.0); i = i + 1; }
                t.setFlat(labT, cl, 1.0);
                t.runTrain();
                if (step == 0) l0 = t.loss();
                if (step == 199) l200 = t.loss();
                step = step + 1;
            }
            Console.writeString("loss@0="); Console.writeFloat(l0);
            Console.writeString(" loss@200="); Console.writeFloat(l200);
            Console.writeLine("");
            if (tok == 1 && l0 > 0.5 && l200 < l0) Console.writeLine("JSON AVGPOOL TRAIN OK");
            else Console.writeLine("JSON AVGPOOL TRAIN MISMATCH");
        }
}

int main() { JsonAvgpoolCnnTrainApp app = new JsonAvgpoolCnnTrainApp(); return 0; }
