// json_clip_main.myp — JSON Clip 分派（内联 min/max → f32 标量常量边界）。
// clip.json：x=[-1,0.5,3,2] clip(min 0, max 1) → [0, 0.5, 1, 1]
import env;
import fmt;
import dl;

class JsonClipApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        @constructor JsonClipApp() {
            Session t = new Session();
            int tok = t.loadJson("./deeplearning/infer_tests/clip.json");
            Console.writeString("load="); Console.writeLong(tok); Console.writeLine("");
            if (tok == 0) { Console.writeLine("JSON CLIP SKIP (no load)"); return; }
            double[] bx = new double[4]; bx[0] = -1.0; bx[1] = 0.5; bx[2] = 3.0; bx[3] = 2.0;
            t.setInput("x", bx, 4);
            int rk = t.runAuto();
            double[] y = t.getOutput("y");
            int bad = 0;
            double[] e = new double[4]; e[0] = 0.0; e[1] = 0.5; e[2] = 1.0; e[3] = 1.0;
            int i = 0;
            while (i < 4) {
                if (absd(y[i] - e[i]) > 2.0e-4) bad = bad + 1;
                i = i + 1;
            }
            Console.writeString("y0="); Console.writeFloat(y[0]);
            Console.writeString(" y2="); Console.writeFloat(y[2]);
            Console.writeLine("");
            if (rk == 0 || bad == 0) { }
            if (rk == 0) bad = bad + 1;
            if (bad == 0) Console.writeLine("JSON CLIP OK");
            else Console.writeLine("JSON CLIP MISMATCH");
        }
}

int main() { JsonClipApp app = new JsonClipApp(); return 0; }
