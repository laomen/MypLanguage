// json_scatter_nd_train_main.myp — P8b：JSON ScatterND 训练（MSE）端到端固化。
// scatter_nd_train.json：x[1,1,4,4]→Conv(1x1, 3ch)→f[1,3,4,4]→ScatterND(k=2,
//   idx=[[0,1]] 写通道1 整块)→out[1,3,4,4]。upd=-1（图输入常量）→ out ch1 恒=-1。
//  MSE 目标：ch0=2x、ch1=-1（与 scatter 固定值一致→ 0 损失/0 梯度）、ch2=0.5x。
//  ScatterND 反向把写位置（ch1）梯度清零 → 梯度只回流 Conv 的 ch0/ch2（w0→2、w2→0.5）；
//  w1 无梯度保持初始（out ch1 不依赖 f1）。若 BwdScatterND 未把写位置 dx 清零或
//  du/路由错误，loss 不收敛 → 本测试抓路由。
// CPU JSON SCATTER_ND TRAIN OK（lr=0.005 × 1500 步）。
import env;
import fmt;
import dl;

class JsonScatterNdTrainApp {
    action:
        @constructor JsonScatterNdTrainApp() {
            Session t = new Session();
            t.setLossMode(2);   // MSE
            int tok = t.loadJsonTrain("./deeplearning/infer_tests/scatter_nd_train.json");
            if (tok == 0) { Console.writeLine("JSON SCATTER_ND TRAIN SKIP (no load)"); return; }
            t.setLr(0.005); t.setTrainMode(1);
            double[] bx = new double[16];
            int i = 0;
            while (i < 16) { bx[i] = double(i + 1); i = i + 1; }
            t.setInput("x", bx, 16);
            double[] idx = new double[2];
            idx[0]=0.0; idx[1]=1.0;
            t.setInput("idx", idx, 2);
            double[] upd = new double[16];
            i = 0;
            while (i < 16) { upd[i] = -1.0; i = i + 1; }
            t.setInput("upd", upd, 16);
            int labT = t.tensorId("label");
            int p = 0;
            while (p < 16) {
                t.setFlat(labT, p, 2.0 * double(p + 1));          // ch0 → 2x
                t.setFlat(labT, 16 + p, -1.0);                    // ch1 = scatter 固定值
                t.setFlat(labT, 32 + p, 0.5 * double(p + 1));     // ch2 → 0.5x
                p = p + 1;
            }
            double l0 = 0.0; double lf = 0.0;
            int step = 0;
            while (step < 1500) {
                t.runTrain();
                if (step == 0) l0 = t.loss();
                if (step == 1499) lf = t.loss();
                step = step + 1;
            }
            double[] o = t.getOutput("out");
            int bad = 0;
            p = 0;
            while (p < 16) {
                double e0 = o[p] - 2.0 * double(p + 1); if (e0 < 0.0) e0 = 0.0 - e0; if (e0 > 0.3) bad = bad + 1;
                double e1 = o[16 + p] - (-1.0); if (e1 < 0.0) e1 = 0.0 - e1; if (e1 > 1.0e-3) bad = bad + 1;   // ch1 恒 = upd
                double e2 = o[32 + p] - 0.5 * double(p + 1); if (e2 < 0.0) e2 = 0.0 - e2; if (e2 > 0.3) bad = bad + 1;
                p = p + 1;
            }
            Console.writeString("l0="); Console.writeFloat(l0);
            Console.writeString(" lf="); Console.writeFloat(lf);
            Console.writeString(" fitbad="); Console.writeLong(bad);
            Console.writeLine("");
            if (tok == 1 && l0 > 0.5 && lf < 0.05 * l0 && bad == 0) Console.writeLine("JSON SCATTER_ND TRAIN OK");
            else Console.writeLine("JSON SCATTER_ND TRAIN FAIL");
        }
}
int main() { JsonScatterNdTrainApp app = new JsonScatterNdTrainApp(); return 0; }
