{ "name":"unet2d",
  "inputs":[{"name":"data","dims":[1,1,64,64]}],
  "outputs":["prob"],
  "layers":[
    {"op":"Conv","in":"data","out":"e0","kernel":[3,3],"pads":[1,1,1,1],
     "W":{"dims":[16,1,3,3],"init":"xavier"},"B":{"dims":[16],"init":"zeros"}},
    {"op":"Relu","in":"e0","out":"a0"},
    {"op":"Conv","in":"a0","out":"e1","kernel":[3,3],"pads":[1,1,1,1],
     "W":{"dims":[16,16,3,3],"init":"xavier"},"B":{"dims":[16],"init":"zeros"}},
    {"op":"Relu","in":"e1","out":"a1"},

    {"op":"MaxPool","in":"a1","out":"p1","kernel":[2,2],"strides":[2,2]},
    {"op":"Conv","in":"p1","out":"e2","kernel":[3,3],"pads":[1,1,1,1],
     "W":{"dims":[32,16,3,3],"init":"xavier"},"B":{"dims":[32],"init":"zeros"}},
    {"op":"Relu","in":"e2","out":"a2"},
    {"op":"Conv","in":"a2","out":"e3","kernel":[3,3],"pads":[1,1,1,1],
     "W":{"dims":[32,32,3,3],"init":"xavier"},"B":{"dims":[32],"init":"zeros"}},
    {"op":"Relu","in":"e3","out":"a3"},

    {"op":"MaxPool","in":"a3","out":"p2","kernel":[2,2],"strides":[2,2]},
    {"op":"Conv","in":"p2","out":"b0","kernel":[3,3],"pads":[1,1,1,1],
     "W":{"dims":[64,32,3,3],"init":"xavier"},"B":{"dims":[64],"init":"zeros"}},
    {"op":"Relu","in":"b0","out":"b1"},
    {"op":"Conv","in":"b1","out":"b2","kernel":[3,3],"pads":[1,1,1,1],
     "W":{"dims":[64,64,3,3],"init":"xavier"},"B":{"dims":[64],"init":"zeros"}},
    {"op":"Relu","in":"b2","out":"b3"},

    {"op":"ConvTranspose","in":"b3","out":"u0","kernel":[2,2],"strides":[2,2],
     "W":{"dims":[64,32,2,2],"init":"xavier"},"B":{"dims":[32],"init":"zeros"}},
    {"op":"Concat","in":"u0","out":"c0","in2":"a3","axis":1},
    {"op":"Conv","in":"c0","out":"d0","kernel":[3,3],"pads":[1,1,1,1],
     "W":{"dims":[32,64,3,3],"init":"xavier"},"B":{"dims":[32],"init":"zeros"}},
    {"op":"Relu","in":"d0","out":"d1"},
    {"op":"Conv","in":"d1","out":"d2","kernel":[3,3],"pads":[1,1,1,1],
     "W":{"dims":[32,32,3,3],"init":"xavier"},"B":{"dims":[32],"init":"zeros"}},
    {"op":"Relu","in":"d2","out":"d3"},

    {"op":"ConvTranspose","in":"d3","out":"u1","kernel":[2,2],"strides":[2,2],
     "W":{"dims":[32,16,2,2],"init":"xavier"},"B":{"dims":[16],"init":"zeros"}},
    {"op":"Concat","in":"u1","out":"c1","in2":"a1","axis":1},
    {"op":"Conv","in":"c1","out":"d4","kernel":[3,3],"pads":[1,1,1,1],
     "W":{"dims":[16,32,3,3],"init":"xavier"},"B":{"dims":[16],"init":"zeros"}},
    {"op":"Relu","in":"d4","out":"d5"},
    {"op":"Conv","in":"d5","out":"d6","kernel":[3,3],"pads":[1,1,1,1],
     "W":{"dims":[16,16,3,3],"init":"xavier"},"B":{"dims":[16],"init":"zeros"}},
    {"op":"Relu","in":"d6","out":"d7"},

    {"op":"Conv","in":"d7","out":"logits","kernel":[1,1],
     "W":{"dims":[1,16,1,1],"init":"xavier"},"B":{"dims":[1],"init":"zeros"}},
    {"op":"Sigmoid","in":"logits","out":"prob"}
  ]
}
