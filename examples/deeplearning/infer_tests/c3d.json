{ "name":"c3d",
  "inputs":[{"name":"data","dims":[1,1,4,8,8]}],
  "outputs":["prob"],
  "layers":[
    { "op":"Conv3D","in":"data","out":"c","kernel":[3,3,3],"strides":[1,1,1],"pads":[1,1,1,1,1,1],
      "W":{"dims":[2,1,3,3,3],"init":"xavier"},"B":{"dims":[2],"init":"zeros"}},
    { "op":"Relu","in":"c","out":"c2"},
    { "op":"MaxPool3D","in":"c2","out":"p","kernel":[2,2,2],"strides":[2,2,2]},
    { "op":"Flatten","in":"p","out":"h","axis":1},
    { "op":"Gemm","in":"h","out":"logits","transB":1,
      "W":{"dims":[3,64],"init":"xavier"},"B":{"dims":[3],"init":"zeros"}},
    { "op":"Softmax","in":"logits","out":"prob","axis":1}
  ]
}
