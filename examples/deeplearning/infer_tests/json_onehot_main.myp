// json_onehot_main.myp — C：JSON OneHot（图算子 P6，逐元素索引 → 行优先 one-hot）。
// x[1,3]=[0,1,2]（float 索引，batch=1 三标签），depth=3 → out 9 元素
// = 单位阵展平 [1,0,0, 0,1,0, 0,0,1]。CPU+GPU JSON ONEHOT OK。
import env;
import fmt;
import dl;
class JsonOneHotApp {
    action:
        @constructor JsonOneHotApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/onehot.json");
            if (ok == 0) { Console.writeLine("JSON ONEHOT SKIP (no load)"); return; }
            double[] x = new double[3];
            x[0]=0.0; x[1]=1.0; x[2]=2.0;
            s.setInput("x", x, 3);
            int rk = s.runAuto();
            double[] o = s.getOutput("oh");
            int n = s.tensorSize("oh");
            int bad = 0;
            int i = 0;
            while (i < 9) {
                double ev = 0.0;
                if (i % 4 == 0) ev = 1.0;   // 单位阵行主：0,4,8 处为 1（行=3）
                double d = o[i]-ev; if (d<0.0) d=0.0-d; if (d>1.0e-4) bad=bad+1;
                i = i + 1;
            }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeLine("");
            if (ok==1 && rk==1 && n==9 && bad==0) Console.writeLine("JSON ONEHOT OK");
            else Console.writeLine("JSON ONEHOT FAIL");
        }
}
int main() { JsonOneHotApp a = new JsonOneHotApp(); return 0; }
