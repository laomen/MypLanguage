// json_value_main.myp — registerWeight 显式 `values`（row-major 手写权重）验证。
// x[1,2]=[1,2] → Gemm W[dims 3,2, values 3,4,5,6,7,8 = [[3,4],[5,6],[7,8]]]（transB=1
// wire=[N=3,K=2]）+ B values [1,2,3] → y[1,3] = W·x+b = [3*1+4*2+1, 5*1+6*2+2,
// 7*1+8*2+3] = [12,19,26]。手写权重值精确（非 LCG/随机），CPU+GPU JSON VALUE OK。
import env;
import fmt;
import dl;
class JsonValueApp {
    action:
        @constructor JsonValueApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/value_gemm.json");
            if (ok == 0) { Console.writeLine("JSON VALUE SKIP (no load)"); return; }
            double[] x = new double[2];
            x[0] = 1.0; x[1] = 2.0;
            s.setInput("x", x, 2);
            int rk = s.runAuto();
            double[] y = s.getOutput("y");
            int n = s.tensorSize("y");
            int bad = 0;
            double[] exp = new double[3];
            exp[0] = 12.0; exp[1] = 19.0; exp[2] = 26.0;
            int i = 0;
            while (i < 3) {
                double d = y[i] - exp[i];
                if (d < 0.0) d = 0.0 - d;
                if (d > 1.0e-3) bad = bad + 1;
                i = i + 1;
            }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeLine("");
            if (ok==1 && rk==1 && n==3 && bad==0) Console.writeLine("JSON VALUE OK");
            else Console.writeLine("JSON VALUE MISMATCH");
        }
}
int main() { JsonValueApp a = new JsonValueApp(); return 0; }
