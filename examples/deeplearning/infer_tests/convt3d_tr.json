{ "name":"jct3tr",
  "inputs":[{"name":"x","dims":[1,1,2,1,1]}],
  "outputs":["prob"],
  "layers":[
    { "op":"ConvTranspose3D","in":"x","out":"u","strides":[1,1,1],"pads":[0,0,0,0,0,0],
      "W":{"dims":[1,2,2,1,1],"init":"xavier"},
      "B":{"dims":[2],"init":"zeros"}},
    { "op":"Flatten","in":"u","out":"hf","axis":1},
    { "op":"Gemm","in":"hf","out":"logits","transB":1,
      "W":{"dims":[2,6],"init":"xavier"},"B":{"dims":[2],"init":"zeros"}},
    { "op":"Softmax","in":"logits","out":"prob","axis":1}
  ]}
