// json_pad_val_main.myp — C：JSON Pad 非 0 常量值（graph_compiler nPadCval 接线 +
// readF32Init 内存 f32 标量分支）。x[1,1,1,3]=[7,8,9]，W 两侧各 pad 1 且 value=5
// → out[1,1,1,5]=[5,7,8,9,5]。CPU+GPU JSON PAD VAL OK。
import env;
import fmt;
import dl;
class JsonPadValApp {
    action:
        @constructor JsonPadValApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/pad_val.json");
            if (ok == 0) { Console.writeLine("JSON PAD VAL SKIP (no load)"); return; }
            double[] x = new double[3];
            x[0]=7.0; x[1]=8.0; x[2]=9.0;
            s.setInput("x", x, 3);
            int rk = s.runAuto();
            double[] o = s.getOutput("y");
            int n = s.tensorSize("y");
            double[] exp = new double[5];
            exp[0]=5.0; exp[1]=7.0; exp[2]=8.0; exp[3]=9.0; exp[4]=5.0;
            int bad = 0;
            int i = 0;
            while (i < 5) { double d = o[i]-exp[i]; if (d<0.0) d=0.0-d; if (d>1.0e-4) bad=bad+1; i = i + 1; }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeString(" y0="); Console.writeFloat(o[0]);
            Console.writeLine("");
            if (ok==1 && rk==1 && n==5 && bad==0) Console.writeLine("JSON PAD VAL OK");
            else Console.writeLine("JSON PAD VAL FAIL");
        }
}
int main() { JsonPadValApp a = new JsonPadValApp(); return 0; }
