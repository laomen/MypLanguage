// bf16_main.myp — 阶段三：BF16 权重 dtype 转换端到端测试
// bf16_test.onnx（opset13）：x[1,1,5,5] → Conv(W/B BFLOAT16) → y[1,1,3,3]
// 输入/参考由 make_bf16 脚本生成（ORT CPU 不支持 BF16，参考用 numpy 手算）。
// MYP 读 raw_data（dtype 16，2 字节）→ bits<<16 → float32。
import env;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class Bf16TestApp {
    action:
        @constructor Bf16TestApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/bf16_test.onnx", rt);
            if (ok == 0) { Console.writeLine("load failed"); return; }
            Console.writeString("graph: ops=");
            Console.writeLong(rt.opCount());
            Console.writeLine("");

            int inT = loader.tensorId("x");
            int outT = loader.tensorId("y");
            if (inT < 0 || outT < 0) { Console.writeLine("tensor not found"); return; }
            int nIn = rt.tensorSize(inT);
            double[] buf = new double[64];
            readF32("./deeplearning/data/onnx/bf16_in.f32", buf, nIn);
            int i = 0;
            while (i < nIn) { rt.setFlat(inT, i, buf[i]); i = i + 1; }
            rt.run();
            int m = rt.tensorSize(outT);
            Console.writeString("out size=");
            Console.writeLong(m);
            Console.writeLine("");
            int okC = checkOut(rt, outT, "./deeplearning/data/onnx/bf16_test_ort.bin", m);
            if (okC == 1) Console.writeLine("BF16 ALL OK");
            else Console.writeLine("BF16 MISMATCH");
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path, int n) {
            if (tid < 0) return 0;
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int bad = 0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                if (dv > 2.0e-4) bad = bad + 1;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("max diff vs numpy ref: ");
            Console.writeFloat(maxD);
            Console.writeString("  bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (maxD <= 2.0e-4) return 1;
            return 0;
        }
}

int main() { Bf16TestApp app = new Bf16TestApp(); return 0; }
