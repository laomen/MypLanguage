// json_cnn_train_main.myp — A：JSON 声明式 CNN 分类训练端到端固化。
// cnn_train.json：data[1,1,8,8] → Conv(2ch 3x3)→Relu→MaxPool(2x2)→Flatten[1,18]
//   →Gemm→logits[1,3]→Softmax。SGD 200 步，输入 8x8 class 特征块（class c →
//   flat 64 的 [c*16, c*16+16) 置 1），label one-hot[3]。loss 应显著下降（梯度经
//   BwdConv/BwdMaxPool2D/BwdRelu/BwdFlatten/BwdDense 全链回传更新 Conv+Gemm 权重）。
// CPU+GPU JSON CNN TRAIN OK。
import env;
import fmt;
import dl;

class JsonCnnTrainApp {
    action:
        @constructor JsonCnnTrainApp() {
            Session t = new Session();
            int tok = t.loadJsonTrain("./deeplearning/infer_tests/cnn_train.json");
            Console.writeString("load="); Console.writeLong(tok);
            Console.writeString(" ops="); Console.writeLong(t.opCount());
            Console.writeLine("");
            if (tok == 0) { Console.writeLine("JSON CNN TRAIN SKIP (no load)"); return; }
            t.setLr(0.05); t.setTrainMode(1);
            int labT = t.tensorId("label");
            double l0 = 0.0; double l200 = 0.0;
            int step = 0;
            while (step < 200) {
                int cl = (step * 5) % 3;
                double[] bx = new double[64];
                int i = 0;
                while (i < 64) {
                    bx[i] = 0.0;
                    if (i >= cl * 16 && i < cl * 16 + 16) bx[i] = 1.0;
                    i = i + 1;
                }
                t.setInput("x", bx, 64);
                i = 0;
                while (i < 3) { t.setFlat(labT, i, 0.0); i = i + 1; }
                t.setFlat(labT, cl, 1.0);
                t.runTrain();
                if (step == 0) l0 = t.loss();
                if (step == 199) l200 = t.loss();
                step = step + 1;
            }
            Console.writeString("loss@0="); Console.writeFloat(l0);
            Console.writeString(" loss@200="); Console.writeFloat(l200);
            Console.writeLine("");
            if (tok == 1 && l0 > 0.5 && l200 < l0) Console.writeLine("JSON CNN TRAIN OK");
            else Console.writeLine("JSON CNN TRAIN MISMATCH");
        }
}

int main() { JsonCnnTrainApp app = new JsonCnnTrainApp(); return 0; }
