// residual_add_main.myp — IR-P4.2/4.3：Conv+残差Add(+Relu) 融合回归。
// residual_add.onnx（tools/make_residual_add_onnx.py）：data[1,4,8,8] → Conv(w,b,s1 p1)
//   → Add(residual) → Relu → prob[1,4,8,8]。优化后 fuseConvAdd 应把整链融成 1 个 op
//   （opKind 73 doRelu，fusedAddCount==1）；CPU+GPU 输出与 numpy 参考逐位一致。
// 运行：./build/mypc deeplearning/infer_tests/residual_add_main.myp -o /tmp/ra --stdlib stdlib
import env;
import cuda;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class ResidualAddTestApp {
    action:
        @constructor ResidualAddTestApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(4096);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/residual_add.onnx", rt);
            if (ok == 0) { Console.writeLine("RESIDUAL ADD LOAD FAIL"); return; }
            if (loader.fusedAddCount() != 1) {
                Console.writeString("RESIDUAL ADD FUSE FAIL count=");
                Console.writeLong(loader.fusedAddCount());
                Console.writeLine("");
                return;
            }
            int dataT = loader.tensorId("data");
            int residT = loader.tensorId("residual");
            int outT = loader.tensorId("prob");
            if (dataT < 0 || residT < 0 || outT < 0) { Console.writeLine("RESIDUAL ADD TENSOR FAIL"); return; }
            int n = rt.tensorSize(dataT);
            int m = rt.tensorSize(outT);
            double[] buf = new double[2048];
            // CPU
            readF32("./deeplearning/data/onnx/residual_data.f32", buf, n);
            int i = 0;
            while (i < n) { rt.setFlat(dataT, i, buf[i]); i = i + 1; }
            readF32("./deeplearning/data/onnx/residual_resid.f32", buf, n);
            i = 0;
            while (i < n) { rt.setFlat(residT, i, buf[i]); i = i + 1; }
            rt.run();
            int okC = checkOut(rt, outT, "./deeplearning/data/onnx/residual_ref.f32", m);
            if (okC == 1) Console.writeLine("RESIDUAL ADD CPU OK");
            else Console.writeLine("RESIDUAL ADD CPU MISMATCH");
            // GPU
            if (Cuda.available() == 1) {
                readF32("./deeplearning/data/onnx/residual_data.f32", buf, n);
                i = 0;
                while (i < n) { rt.setFlat(dataT, i, buf[i]); i = i + 1; }
                readF32("./deeplearning/data/onnx/residual_resid.f32", buf, n);
                i = 0;
                while (i < n) { rt.setFlat(residT, i, buf[i]); i = i + 1; }
                rt.runGpu();
                int okG = checkOut(rt, outT, "./deeplearning/data/onnx/residual_ref.f32", m);
                if (okG == 1) Console.writeLine("RESIDUAL ADD GPU OK");
                else Console.writeLine("RESIDUAL ADD GPU MISMATCH");
            } else {
                Console.writeLine("RESIDUAL ADD GPU SKIP (no device)");
            }
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path, int n) {
            if (tid < 0) return 0;
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("max diff vs numpy: ");
            Console.writeFloat(maxD);
            if (maxD < 1.0e-4) { Console.writeLine("  OK"); return 1; }
            Console.writeLine("  MISMATCH");
            return 0;
        }
}

int main() {
    ResidualAddTestApp app = new ResidualAddTestApp();
    return 0;
}
