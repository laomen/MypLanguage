// json_sqrt_main.myp — C：JSON Sqrt（单输入无属性，默认分派走通验证）。
// x[1,4]=[1,4,9,16] → Sqrt → out=[1,2,3,4]。CPU+GPU JSON SQRT OK。
import env;
import fmt;
import dl;
class JsonSqrtApp {
    action:
        @constructor JsonSqrtApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/sqrt.json");
            if (ok == 0) { Console.writeLine("JSON SQRT SKIP (no load)"); return; }
            double[] x = new double[4];
            x[0]=1.0; x[1]=4.0; x[2]=9.0; x[3]=16.0;
            s.setInput("x", x, 4);
            int rk = s.runAuto();
            double[] o = s.getOutput("out");
            int n = s.tensorSize("out");
            int bad = 0;
            double[] exp = new double[4];
            exp[0]=1.0; exp[1]=2.0; exp[2]=3.0; exp[3]=4.0;
            int i = 0;
            while (i < 4) { double d = o[i]-exp[i]; if (d<0.0) d=0.0-d; if (d>1.0e-3) bad=bad+1; i = i + 1; }
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" n="); Console.writeLong(n);
            Console.writeString(" bad="); Console.writeLong(bad);
            Console.writeLine("");
            if (ok==1 && rk==1 && n==4 && bad==0) Console.writeLine("JSON SQRT OK");
            else Console.writeLine("JSON SQRT MISMATCH");
        }
}
int main() { JsonSqrtApp a = new JsonSqrtApp(); return 0; }
