// deadweight_main.myp — 阶段五：死权重裁剪（DCE 后移除未引用初始器）测试
// deadweight_test.onnx：x[1,1,5,5] → Conv → y[1,1,3,3] + 未引用初始器 junk[3,3]。
// 验证：1) 输出 vs ORT 正确；2) junk 被裁剪（shape 标 dead，不登记 runtime 张量）。
import env;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class DeadWeightTestApp {
    action:
        @constructor DeadWeightTestApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/deadweight_test.onnx", rt);
            if (ok == 0) { Console.writeLine("load failed"); return; }
            Console.writeString("graph: ops=");
            Console.writeLong(rt.opCount());
            Console.writeLine("");

            int inT = loader.tensorId("x");
            int outT = loader.tensorId("y");
            if (inT < 0 || outT < 0) { Console.writeLine("tensor not found"); return; }
            int nIn = rt.tensorSize(inT);
            double[] buf = new double[64];
            readF32("./deeplearning/data/onnx/deadweight_in.f32", buf, nIn);
            int i = 0;
            while (i < nIn) { rt.setFlat(inT, i, buf[i]); i = i + 1; }
            rt.run();
            int m = rt.tensorSize(outT);
            int okC = checkOut(rt, outT, "./deeplearning/data/onnx/deadweight_test_ort.bin", m);

            // 验证 junk 被裁剪：遍历 weights，junk 的 shape 应标 dead
            Graph g = loader.graph();
            int junkDead = -1;
            int wi = 0;
            while (wi < g.compilerWeightCount()) {
                string nm = g.compilerWeightNameAt(wi);
                if (nm == "junk") {
                    int si = g.compilerShapeIdx(nm);
                    if (si >= 0) junkDead = g.compilerShapeDead(si);
                    else junkDead = 2;   // shape 条目不存在（更彻底裁剪）
                }
                wi = wi + 1;
            }
            Console.writeString("junk dead flag=");
            Console.writeLong(junkDead);
            Console.writeLine("  (expect 1=dead)");
            if (okC == 1 && junkDead == 1) Console.writeLine("DEADWEIGHT ALL OK");
            else Console.writeLine("DEADWEIGHT MISMATCH");
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path, int n) {
            if (tid < 0) return 0;
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int bad = 0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                if (dv > 1.0e-4) bad = bad + 1;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("max diff vs ORT: ");
            Console.writeFloat(maxD);
            Console.writeString("  bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (maxD <= 1.0e-4) return 1;
            return 0;
        }
}

int main() { DeadWeightTestApp app = new DeadWeightTestApp(); return 0; }
