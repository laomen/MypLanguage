// r18_main.myp — G4：真实带 BN 模型端到端验证
// 加载 ONNX Model Zoo 的 resnet18_v1_7.onnx（69 节点：20 Conv + 20 BatchNormalization
// + 17 Relu + 8 Add + MaxPool + GAP + Flatten + Gemm），用与 ResNet50 相同的 ImageNet
// 预处理输入（resnet_input.f32）。验证 G3 的 fuseConvBN（20 个 BN 折进卷积权重）在真实
// 模型上工作，top-5 与 onnxruntime 一致。
import env;
import cuda;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class R18InferApp {
    action:
        @constructor R18InferApp() {
            loadLabels();
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(1024);

            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/resnet18_v1_7.onnx", rt);
            if (ok == 0) {
                Console.writeLine("onnx load failed");
                return;
            }

            int inputTid = loader.tensorId("data");
            int outTid = loader.tensorId("resnetv15_dense0_fwd");
            if (inputTid < 0 || outTid < 0) {
                Console.writeLine("tensor not found");
                return;
            }

            Console.writeString("graph: nodes=");
            Console.writeLong(loader.nodeCount());
            Console.writeString("  ops=");
            Console.writeLong(rt.opCount());
            Console.writeString("  bn_fused=");
            Console.writeLong(loader.bnCount());
            Console.writeString("  convRelu_fused=");
            Console.writeLong(loader.fuseCount());
            Console.writeString("  gapFlatten_fused=");
            Console.writeLong(loader.gapCount());
            Console.writeLine("");

            // 读输入：1*3*224*224 float32（与 ResNet50 同图）
            int n = 3 * 224 * 224;
            int fd = __myp_io_fopen("./deeplearning/data/onnx/resnet_input.f32", "rb");
            if (fd < 0) { Console.writeLine("no input file"); return; }
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) { Console.writeLine("input short"); __myp_io_fclose(); return; }
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                rt.setFlat(inputTid, i, F32.toDouble(bits));
                i = i + 1;
            }
            __myp_io_fclose();

            int useGpu = Cuda.available();
            Console.writeString("device: ");
            if (useGpu == 1) { Console.writeString(Cuda.name()); Console.writeString(" (GPU)"); }
            else { Console.writeString("CPU"); }
            Console.writeLine("");
            // P5b：推理持久化（MYP_GPU_PERSIST=1）——权重一次性驻留，仅 D2H 输出，测稳态吞吐。
            int persist = 0;
            if (Console.getEnv("MYP_GPU_PERSIST") == "1" && useGpu == 1) {
                if (rt.gpuInferStart(outTid) == 1) persist = 1;
            }
            int reps = 1;
            if (persist == 1) reps = 20;
            if (persist == 1) rt.runGpu();   // warmup
            long t0 = __myp_now_ms();
            int r = 0;
            while (r < reps) {
                if (useGpu == 1) rt.runGpu();
                else rt.run();
                r = r + 1;
            }
            long t1 = __myp_now_ms();
            if (persist == 1) rt.gpuInferEnd();
            Console.writeString("ResNet18 inference");
            if (persist == 1) Console.writeString(" (persist avg " + Fmt.i(reps) + ")");
            Console.writeString(": ");
            Console.writeLong((t1 - t0) / reps);
            Console.writeLine(" ms");

            // 输出 checksum（onnxruntime 参考 0.101261）
            double ssum = 0.0;
            int st = 0;
            while (st < 1000) { ssum = ssum + rt.getFlat(outTid, st); st = st + 1; }
            Console.writeString("output sum: ");
            Console.writeFloat(ssum);
            Console.writeLine("");

            Console.writeLine("top-5:");
            int k = 0;
            while (k < 5) {
                int bi = -1;
                double bv = 0.0 - 1.0e30;
                int t = 0;
                while (t < 1000) {
                    double v = rt.getFlat(outTid, t);
                    if (v > bv) { bv = v; bi = t; }
                    t = t + 1;
                }
                if (bi < 0) break;
                Console.writeString("  #");
                Console.writeLong(k + 1);
                Console.writeString("  [");
                Console.writeLong(bi);
                Console.writeString("] ");
                Console.writeString(label(bi));
                Console.writeString("  (");
                Console.writeFloat(bv);
                Console.writeLine(")");
                rt.setFlat(outTid, bi, 0.0 - 1.0e30);
                k = k + 1;
            }
        }

        void loadLabels() {            
            int fd = __myp_io_fopen("./deeplearning/data/imagenet/classes.txt", "r");
            if (fd < 0) { labelCount_ = 0; return; }
            labelCount_ = 0;
            while (labelCount_ < 1000) {
                string line = __myp_io_read_line();
                if (Str.len(line) == 0) break;
                labels_[labelCount_] = line;
                labelCount_ = labelCount_ + 1;
            }
            __myp_io_fclose();
        }

        string label(int c) {
            if (c >= 0 && c < labelCount_) return labels_[c];
            return "?";
        }

    property:
        string[1000] labels_;
        int labelCount_;
}

int main() {
    R18InferApp app = new R18InferApp();
    return 0;
}
