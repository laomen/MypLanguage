// bwd_pad_main.myp — B：Pad(constant) 反向（去边取中心）数值对拍。
// x[1,1,2,2]=[1,2,3,4] → pads b=[0,0,1,1] e=[0,0,1,1]（H/W 各上下/左右 1）→
//   y[1,1,4,4]。dy(对 y 4x4) 填 0..15（row-major：r0=0,1,2,3 r1=4,5,6,7
//   r2=8,9,10,11 r3=12,13,14,15）。dx = y 中心 2x2（x 在 y 中位置）= 每元素
//   唯一对应 y[b1+..] → dx 期望 [5,6,9,10]（y r1c1,r1c2,r2c1,r2c2）。
// 全部 PASS → BWD PAD OK。
import env;
import fmt;
import "../infer/runtime.myp";

class BwdPadApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        @constructor BwdPadApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(1024);
            rt.setTrain(1);
            int x = rt.addTensor4(1, 1, 2, 2);
            int dy = rt.addTensor4(1, 1, 4, 4);
            int dx = rt.addTensor4(1, 1, 2, 2);
            int i = 0;
            while (i < 16) { rt.setFlat(dy, i, double(i)); i = i + 1; }
            rt.addBwdPad(dy, x, dx, 0, 0, 1, 1, 0, 0, 1, 1);
            rt.run();
            int bad = 0;
            double[] exp = new double[4];
            exp[0] = 5.0; exp[1] = 6.0; exp[2] = 9.0; exp[3] = 10.0;
            i = 0;
            while (i < 4) { if (absd(rt.getFlat(dx, i) - exp[i]) > 1.0e-3) bad = bad + 1; i = i + 1; }
            Console.writeString("bwd pad bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (bad == 0) Console.writeLine("BWD PAD OK");
            else Console.writeLine("BWD PAD MISMATCH");
        }
}

int main() { BwdPadApp app = new BwdPadApp(); return 0; }
