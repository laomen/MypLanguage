// G2 dtype/role 建模验证（真实 ResNet50 加载级回归）
// 断言：权重张量登记 WEIGHT role + FLOAT dtype；图输入/输出登记 GRAPH_IN/OUT。
import env;
import fmt;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";
import "../infer/graph.myp";
import "../infer/graph_defs.myp";

class Probe {
    action:
        @constructor Probe() {
            InferenceRuntime rt = new InferenceRuntime();
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/gluon_resnet50_v1b_Opset16.onnx", rt);
            Console.writeLine("load ok=" + Fmt.i(ok));
            if (ok == 0) return;
            Graph g = loader.graph();
            int n = g.compilerShapeCount();
            int[16] roleCnt;
            int[20] dtypeCnt;
            int i = 0;
            while (i < n) {
                string nm = g.compilerShapeName(i);
                int r = g.valueRole(nm);
                int d = g.valueDType(nm);
                if (r >= 0 && r < 16) roleCnt[r] = roleCnt[r] + 1;
                if (d >= 0 && d < 20) dtypeCnt[d] = dtypeCnt[d] + 1;
                i = i + 1;
            }
            Console.writeLine("shapes=" + Fmt.i(n));
            Console.writeLine("roles: UNKNOWN=" + Fmt.i(roleCnt[0]) + " DATA=" + Fmt.i(roleCnt[1]) + " SHAPE=" + Fmt.i(roleCnt[2]) + " WEIGHT=" + Fmt.i(roleCnt[3]) + " PARAM=" + Fmt.i(roleCnt[4]) + " GRAPH_IN=" + Fmt.i(roleCnt[5]) + " GRAPH_OUT=" + Fmt.i(roleCnt[6]));
            Console.writeLine("dtypes: UNKNOWN=" + Fmt.i(dtypeCnt[0]) + " FLOAT=" + Fmt.i(dtypeCnt[1]) + " INT64=" + Fmt.i(dtypeCnt[7]) + " DOUBLE=" + Fmt.i(dtypeCnt[11]));
            // 断言（G2 建模生效）：权重已分类 + 图输入/输出各 1 + 存在 FLOAT dtype
            int fail = 0;
            if (roleCnt[3] < 50) { Console.writeLine("FAIL: expected many WEIGHT roles, got " + Fmt.i(roleCnt[3])); fail = 1; }
            if (roleCnt[5] != 1) { Console.writeLine("FAIL: expected 1 GRAPH_IN, got " + Fmt.i(roleCnt[5])); fail = 1; }
            if (roleCnt[6] != 1) { Console.writeLine("FAIL: expected 1 GRAPH_OUT, got " + Fmt.i(roleCnt[6])); fail = 1; }
            if (dtypeCnt[1] < 50) { Console.writeLine("FAIL: expected many FLOAT dtypes, got " + Fmt.i(dtypeCnt[1])); fail = 1; }
            if (fail == 0) Console.writeLine("G2 DTYPE ROLE OK");
            else Console.writeLine("G2 DTYPE ROLE FAIL");
        }
}

int main() {
    Probe p = new Probe();
    return 0;
}
