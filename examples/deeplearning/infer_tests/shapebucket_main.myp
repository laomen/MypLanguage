// shapebucket_main.myp — 阶段七：shape specialization 多个 shape bucket 验证
// 同一模型（dynbatch_test.onnx，batch 动态）按不同注入 batch（2/4/8）各 build
// 一个 InferenceRuntime（编译期 specialization），输出各自 vs ORT 参考。
// 验证：shape specialization 对多个 bucket 都正确（batch 维广播到注入值，
// Resize sizes / arena 规划等 shape 依赖折叠按 bucket 独立）。
import env;
import fmt;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class ShapeBucketApp {
    action:
        @constructor ShapeBucketApp() {
            int ok2 = runBucket(2);
            int ok4 = runBucket(4);
            int ok8 = runBucket(8);
            Console.writeString("bucket2="); Console.writeLong(ok2);
            Console.writeString(" bucket4="); Console.writeLong(ok4);
            Console.writeString(" bucket8="); Console.writeLong(ok8);
            Console.writeLine("");
            if (ok2 == 1 && ok4 == 1 && ok8 == 1) Console.writeLine("SHAPEBUCKET ALL OK");
            else Console.writeLine("SHAPEBUCKET MISMATCH");
        }

        int runBucket(int batch) {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            OnnxLoader loader = new OnnxLoader();
            loader.setInputShape("x", batch, 1, 5, 5, 1, 0);   // 注入 batch（4D NCHW）
            int ok = loader.load("./deeplearning/data/onnx/dynbatch_test.onnx", rt);
            if (ok == 0) { Console.writeLine("load failed (batch=" + Fmt.i(batch) + ")"); return 0; }
            int inT = loader.tensorId("x");
            int outT = loader.tensorId("y");
            if (inT < 0 || outT < 0) { Console.writeLine("tensor not found"); return 0; }
            int nIn = rt.tensorSize(inT);
            int expectIn = batch * 25;
            if (nIn != expectIn) {
                Console.writeString("  bucket="); Console.writeLong(batch);
                Console.writeString(" in size="); Console.writeLong(nIn);
                Console.writeString(" (expect "); Console.writeLong(expectIn); Console.writeString(")"); Console.writeLine("");
                return 0;
            }
            double[] buf = new double[256];
            readF32("./deeplearning/data/onnx/dynbucket_in_" + Fmt.i(batch) + ".f32", buf, nIn);
            int i = 0;
            while (i < nIn) { rt.setFlat(inT, i, buf[i]); i = i + 1; }
            int useGpu = 0;
            if (Console.getEnv("MYP_GPU") == "1") useGpu = 1;
            if (useGpu == 1) rt.runGpu(); else rt.run();
            int m = rt.tensorSize(outT);
            int expectOut = batch * 9;
            if (m != expectOut) {
                Console.writeString("  bucket="); Console.writeLong(batch);
                Console.writeString(" out size="); Console.writeLong(m);
                Console.writeString(" (expect "); Console.writeLong(expectOut); Console.writeString(")"); Console.writeLine("");
                return 0;
            }
            return checkOut(rt, outT, "./deeplearning/data/onnx/dynbucket_ort_" + Fmt.i(batch) + ".bin", m);
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path, int n) {
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int bad = 0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                if (dv > 1.0e-4) bad = bad + 1;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("  bucket max diff: "); Console.writeFloat(maxD);
            Console.writeString("  bad="); Console.writeLong(bad); Console.writeLine("");
            if (maxD <= 1.0e-4) return 1;
            return 0;
        }
}

int main() { ShapeBucketApp app = new ShapeBucketApp(); return 0; }
