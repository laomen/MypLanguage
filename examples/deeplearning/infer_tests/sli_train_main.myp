// sli_train_main.myp — 阶段九 SLI 训练接口回归测试。
// 用 Session.loadTrain（mnist_mlp.onnx 训练模式）验证统一训练控制：
// setLr/setTrainMode/runTrain/loss()/gradId()。runTrain 走 CPU runRuntime
// （不依赖 MYP_GPU），在 MYP_IR_VERIFY=1 下同样通过（训练反向图 wiring 校验）。
import env;
import fmt;
import "../infer/framework.myp";

class SliTrainApp {
    action:
        @constructor SliTrainApp() {
            Session s = new Session();
            int ok = s.loadTrain("./deeplearning/data/onnx/mnist_mlp.onnx");
            Console.writeString("loadTrain ok="); Console.writeLong(ok);
            Console.writeString(" phase="); Console.writeLong(s.phase());
            Console.writeString(" ops="); Console.writeLong(s.opCount());
            Console.writeString(" lr="); Console.writeFloat(s.lr());
            Console.writeLine("");
            if (ok == 0) { Console.writeLine("SLI TRAIN SKIP (no model)"); return; }

            // 确定性伪随机输入 data[784] + label=3
            int nIn = 784;
            double[] buf = new double[nIn];
            int i = 0;
            while (i < nIn) { buf[i] = double((i * 37) % 100) / 100.0; i = i + 1; }
            s.setInput("data", buf, nIn);
            int labelTid = s.tensorId("label");
            if (labelTid >= 0) s.setFlat(labelTid, 0, 3.0);

            // lr=0：loss/梯度照常，权重不变（对拍模式）
            s.setLr(0.0);
            s.setTrainMode(1);
            int rk = s.runTrain();
            double L0 = s.loss();
            int w1g = s.gradId("W1");
            int w2g = s.gradId("W2");
            Console.writeString("run ok="); Console.writeLong(rk);
            Console.writeString(" trainMode="); Console.writeLong(s.trainMode());
            Console.writeString(" loss="); Console.writeFloat(L0);
            Console.writeString(" gradIds="); Console.writeLong(w1g); Console.writeString("/"); Console.writeLong(w2g);
            Console.writeLine("");

            if (ok == 1 && rk == 1 && s.runError() == 0 && s.phase() == 3 &&
                L0 > 0.0 && L0 < 100.0 && w1g >= 0 && w2g >= 0) {
                Console.writeLine("SLI TRAIN OK");
            } else {
                Console.writeLine("SLI TRAIN MISMATCH");
            }
        }
}

int main() { SliTrainApp a = new SliTrainApp(); return 0; }
