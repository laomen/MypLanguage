{ "name":"tanhtr",
  "inputs":[{"name":"x","dims":[1,4]}],
  "outputs":["prob"],
  "layers":[
    { "op":"Gemm","in":"x","out":"h","transB":1,
      "W":{"dims":[4,4],"init":"xavier"},"B":{"dims":[4],"init":"zeros"}},
    { "op":"Tanh","in":"h","out":"ht"},
    { "op":"Gemm","in":"ht","out":"logits","transB":1,
      "W":{"dims":[3,4],"init":"xavier"},"B":{"dims":[3],"init":"zeros"}},
    { "op":"Softmax","in":"logits","out":"prob","axis":1}
  ]}
