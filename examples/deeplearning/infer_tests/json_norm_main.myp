// json_norm_main.myp — JSON LayerNorm/RmsNorm/GELU 图算子（复用 LLM kernel + 运行时
// 自省 D/S）。框架 tensor [D 特征行, S 样本列]（row-major d*S+s）；归一按特征行 per 列。
//   LayerNorm x[3,2]=[1,4,2,5,3,6]（col0=[1,2,3] col1=[4,5,6]）γ=[1,2,3] β=0 eps=0
//     → y flat=[-1.2247,-1.2247, 0,0, 3.6742,3.6742]
//   RmsNorm 同 x γ=1 → [0.4629,0.7895, 0.9258,0.9869, 1.3887,1.1843]
//   GELU x=[-2,-1,0,1,2] → [-0.0455,-0.1587, 0, 0.8413,1.9545]
import env;
import fmt;
import dl;

class JsonNormApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        int testOne(Session t, string path, double[] bx, int n, double[] e, string tag) {
            int tok = t.loadJson(path);
            if (tok == 0) { Console.writeLine(tag + " NO LOAD"); return 1; }
            t.setInput("x", bx, n);
            int rk = t.runAuto();
            double[] y = t.getOutput("y");
            int bad = 0;
            if (rk == 0) bad = bad + 1;
            int i = 0;
            while (i < n) {
                if (absd(y[i] - e[i]) > 2.0e-3) bad = bad + 1;
                i = i + 1;
            }
            Console.writeString(tag + " y0="); Console.writeFloat(y[0]);
            Console.writeString(" y" + Fmt.i(n - 1) + "="); Console.writeFloat(y[n - 1]);
            Console.writeLine("");
            if (bad == 0) Console.writeLine(tag + " OK");
            else Console.writeLine(tag + " MISMATCH bad=" + Fmt.i(bad));
            return bad;
        }
        @constructor JsonNormApp() {
            int bad = 0;
            // LayerNorm / RmsNorm：x[1,3] 单样本 3 特征（布局无歧义）归一特征行
            Session t1 = new Session();
            double[] bx = new double[3]; bx[0] = 1; bx[1] = 2; bx[2] = 3;
            double[] el = new double[3]; el[0] = -1.2247; el[1] = 0.0; el[2] = 3.6742;
            bad = bad + testOne(t1, "./deeplearning/infer_tests/lnorm.json", bx, 3, el, "LayerNorm");
            // RmsNorm
            Session t2 = new Session();
            double[] er = new double[3]; er[0] = 0.4629; er[1] = 0.9258; er[2] = 1.3887;
            bad = bad + testOne(t2, "./deeplearning/infer_tests/rnorm.json", bx, 3, er, "RmsNorm");
            // GELU
            Session t3 = new Session();
            double[] gx = new double[5]; gx[0] = -2.0; gx[1] = -1.0; gx[2] = 0.0; gx[3] = 1.0; gx[4] = 2.0;
            double[] eg = new double[5]; eg[0] = -0.0455; eg[1] = -0.1587; eg[2] = 0.0; eg[3] = 0.8413; eg[4] = 1.9545;
            bad = bad + testOne(t3, "./deeplearning/infer_tests/gelu.json", gx, 5, eg, "GELU");
            if (bad == 0) Console.writeLine("JSON NORM OK");
            else Console.writeLine("JSON NORM MISMATCH");
        }
}

int main() { JsonNormApp app = new JsonNormApp(); return 0; }
