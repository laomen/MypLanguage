// json_batch_matmul_train_main.myp — P9：JSON 4D/batch MatMul 训练（MSE）端到端固化。
// batch_matmul_train.json：x[1,1,4,2]→Conv(1x1,1ch)→f[1,1,4,2]（可训 W[1,1,1,1]）→
//   MatMul(in=f, in2=bb[1,1,2,3])（4D → batch matmul 路径 opKind 82）→ o[1,1,4,3]。
//   f[m,k]=w0·x[m,k]+b0；o[m,n]=Σ_k f[m,k]·bb[k,n]。label = x@bb（main 算）→ 收敛 w0≈1、b0≈0。
//   反向须经 BwdBatchMatmul 把梯度路由回 f（→BwdConv→dw/db）。若路由错（断链/仍走 BwdDense
//   2D 语义）→ Conv 权重不动、loss 不降 → 本测试抓 4D/batch MatMul 反向。
// CPU JSON BATCH_MATMUL TRAIN OK（lr=0.05 × 800 步）。
import env;
import fmt;
import dl;

class JsonBatchMatmulTrainApp {
    action:
        @constructor JsonBatchMatmulTrainApp() {
            Session t = new Session();
            t.setLossMode(2);   // MSE
            int tok = t.loadJsonTrain("./deeplearning/infer_tests/batch_matmul_train.json");
            if (tok == 0) { Console.writeLine("JSON BATCH_MATMUL TRAIN SKIP (no load)"); return; }
            t.setLr(0.05); t.setTrainMode(1);
            // x[1,1,4,2]（m,k 行主 = m*2+k）
            double[] bx = new double[8];
            bx[0]=0.5; bx[1]=1.5; bx[2]=1.0; bx[3]=0.25;
            bx[4]=2.0; bx[5]=1.0; bx[6]=0.75; bx[7]=1.25;
            t.setInput("x", bx, 8);
            // bb[1,1,2,3]（k,n 行主 = k*3+n）
            double[] bb = new double[6];
            bb[0]=1.0; bb[1]=2.0; bb[2]=0.5; bb[3]=0.5; bb[4]=1.0; bb[5]=2.0;
            t.setInput("bb", bb, 6);
            // label = x@bb（4x3）
            int labT = t.tensorId("label");
            int m = 0;
            while (m < 4) {
                int n = 0;
                while (n < 3) {
                    double s = 0.0;
                    int k = 0;
                    while (k < 2) { s = s + bx[m * 2 + k] * bb[k * 3 + n]; k = k + 1; }
                    t.setFlat(labT, m * 3 + n, s);
                    n = n + 1;
                }
                m = m + 1;
            }
            double l0 = 0.0; double lf = 0.0;
            int step = 0;
            while (step < 800) {
                t.runTrainAuto();
                if (step == 0) l0 = t.loss();
                if (step == 799) lf = t.loss();
                step = step + 1;
            }
            double[] o = t.getOutput("o");
            int bad = 0;
            m = 0;
            while (m < 4) {
                int n = 0;
                while (n < 3) {
                    double s = 0.0;
                    int k = 0;
                    while (k < 2) { s = s + bx[m * 2 + k] * bb[k * 3 + n]; k = k + 1; }
                    double e0 = o[m * 3 + n] - s; if (e0 < 0.0) e0 = 0.0 - e0; if (e0 > 0.05) bad = bad + 1;
                    n = n + 1;
                }
                m = m + 1;
            }
            Console.writeString("l0="); Console.writeFloat(l0);
            Console.writeString(" lf="); Console.writeFloat(lf);
            Console.writeString(" fitbad="); Console.writeLong(bad);
            Console.writeLine("");
            if (tok == 1 && l0 > 0.05 && lf < 0.02 * l0 && bad == 0) Console.writeLine("JSON BATCH_MATMUL TRAIN OK");
            else Console.writeLine("JSON BATCH_MATMUL TRAIN FAIL");
        }
}
int main() { JsonBatchMatmulTrainApp app = new JsonBatchMatmulTrainApp(); return 0; }
