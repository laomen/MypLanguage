// opselect_main.myp — 阶段五：算子选择（BatchMatMul batch 维全 1 → 降级 2D matmul）测试
// opselect_test.onnx：A[1,1,16,24]@B[1,1,24,8]→Y1 + C[1,1,8,8]@D[1,1,8,8]→Y2，
//   Concat→Y[1,1,16,16]。batch 维全 1 → kernel 内降级到普通 matmul（CPU @parallel /
//   GPU denseTiled）。验证输出 vs ORT。
import env;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class OpSelectTestApp {
    action:
        @constructor OpSelectTestApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/opselect_test.onnx", rt);
            if (ok == 0) { Console.writeLine("load failed"); return; }
            Console.writeString("graph: ops=");
            Console.writeLong(rt.opCount());
            Console.writeLine("");

            // 检查 op 表中两个 MatMul 都是 opKind 82（addBatchMatmul）
            int n82 = 0;
            int oi = 0;
            while (oi < rt.opCount()) {
                if (rt.opKindDebug(oi) == 82) n82 = n82 + 1;
                oi = oi + 1;
            }
            Console.writeString("opKind 82 (batchmatmul) count=");
            Console.writeLong(n82);
            Console.writeLine("  (expect 2)");

            int inA = loader.tensorId("a");
            int inB = loader.tensorId("b");
            int inC = loader.tensorId("c");
            int inD = loader.tensorId("d");
            int out1 = loader.tensorId("y1");
            int out2 = loader.tensorId("y2");
            if (inA < 0 || out1 < 0 || out2 < 0) { Console.writeLine("tensor not found"); return; }
            double[] buf = new double[1024];
            readF32("./deeplearning/data/onnx/opselect_in.f32", buf, 1024);
            int off = 0;
            int i = 0;
            int n = rt.tensorSize(inA); while (i < n) { rt.setFlat(inA, i, buf[off + i]); i = i + 1; } off = off + n;
            i = 0; n = rt.tensorSize(inB); while (i < n) { rt.setFlat(inB, i, buf[off + i]); i = i + 1; } off = off + n;
            i = 0; n = rt.tensorSize(inC); while (i < n) { rt.setFlat(inC, i, buf[off + i]); i = i + 1; } off = off + n;
            i = 0; n = rt.tensorSize(inD); while (i < n) { rt.setFlat(inD, i, buf[off + i]); i = i + 1; } off = off + n;
            rt.run();
            int m1 = rt.tensorSize(out1);
            int m2 = rt.tensorSize(out2);
            Console.writeString("out sizes=");
            Console.writeLong(m1);
            Console.writeString(",");
            Console.writeLong(m2);
            Console.writeLine("  (expect 128,64)");
            // ORT 参考按 y1.ravel()+y2.ravel() 拼接；测试先读 y1 段再读 y2 段
            int okC = checkOut(rt, out1, "./deeplearning/data/onnx/opselect_test_ort.bin", m1, 0);
            if (okC == 1) okC = checkOut(rt, out2, "./deeplearning/data/onnx/opselect_test_ort.bin", m2, m1);

            if (okC == 1 && n82 == 2 && m1 == 128 && m2 == 64) Console.writeLine("OPSELECT ALL OK");
            else Console.writeLine("OPSELECT MISMATCH");
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path, int n, int skip) {
            if (tid < 0) return 0;
            int fd = __myp_io_fopen(path, "rb");
            int sk = 0;
            while (sk < skip * 4) { __myp_io_read_byte(); sk = sk + 1; }
            double maxD = 0.0;
            int bad = 0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                if (dv > 1.0e-4) bad = bad + 1;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("max diff vs ORT: ");
            Console.writeFloat(maxD);
            Console.writeString("  bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (maxD <= 1.0e-4) return 1;
            return 0;
        }
}

int main() { OpSelectTestApp app = new OpSelectTestApp(); return 0; }
