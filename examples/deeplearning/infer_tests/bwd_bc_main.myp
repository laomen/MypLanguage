// bwd_bc_main.myp — B2：Expand/Tile 反向（广播 scatter-add）数值对拍（runtime API）。
// Expand：x[1,2,1,3] → y[1,2,2,3]（ch0/ch1 各 H 复制 2）。dy(对 y) 填 0..11（按
//   od=[1,2,2,3] row-major）→ dx(对 x) 期望 [3,5,7,15,17,19]（每源元素累加对应两处）。
// Tile：x[1,1,2,3] → y[1,1,4,3]（H 复制 2 份）。dy 填 0..11（od=[1,1,4,3]）→
//   dx 期望 [6,8,10,12,14,16]（row0 = h0+h2 = [0,1,2]+[6,7,8]；row1 = h1+h3）。
// kernel 先清零 dx 再累加。全部 PASS → BWD BC OK。
import env;
import fmt;
import "../infer/runtime.myp";

class BwdBcApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        @constructor BwdBcApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(1024);
            rt.setTrain(1);
            // ---- Expand ----
            int dxE = rt.addTensor(2, 3);
            int dyE = rt.addTensor(6, 2);
            int i = 0;
            while (i < 12) { rt.setFlat(dyE, i, double(i)); i = i + 1; }
            rt.addBwdExpand(dyE, dxE, 1, 2, 1, 3, 1, 2, 2, 3);
            // ---- Tile ----
            int dxT = rt.addTensor(2, 3);
            int dyT = rt.addTensor(12, 1);
            i = 0;
            while (i < 12) { rt.setFlat(dyT, i, double(i)); i = i + 1; }
            rt.addBwdTile(dyT, dxT, 1, 1, 2, 3, 1, 1, 4, 3);
            rt.run();
            int bad = 0;
            // Expand：dx = [3,5,7,15,17,19]
            double[] expE = new double[6];
            expE[0] = 3.0; expE[1] = 5.0; expE[2] = 7.0; expE[3] = 15.0; expE[4] = 17.0; expE[5] = 19.0;
            i = 0;
            while (i < 6) { if (absd(rt.getFlat(dxE, i) - expE[i]) > 1.0e-3) bad = bad + 1; i = i + 1; }
            // Tile：dx = [6,8,10,12,14,16]
            double[] expT = new double[6];
            expT[0] = 6.0; expT[1] = 8.0; expT[2] = 10.0; expT[3] = 12.0; expT[4] = 14.0; expT[5] = 16.0;
            i = 0;
            while (i < 6) { if (absd(rt.getFlat(dxT, i) - expT[i]) > 1.0e-3) bad = bad + 1; i = i + 1; }
            Console.writeString("bwd expand/tile bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (bad == 0) Console.writeLine("BWD BC OK");
            else Console.writeLine("BWD BC MISMATCH");
        }
}

int main() { BwdBcApp app = new BwdBcApp(); return 0; }
