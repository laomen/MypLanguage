// json_bn_main.myp — JSON BatchNormalization 分派（[C] scale/bias/mean/var + eps）。
// bn.json：x[1,2,1,1] 两通道 BN：y_c = (x_c-mean_c)/sqrt(var_c+eps)*scale_c+bias_c
//   scale=[2,3] bias=[1,-1] mean=[0.5,0.25] var=[1,4] eps=0
//   x=[1.0,3.0] → y=[(0.5)*2+1, (2.75/2)*3-1] = [2.0, 3.125]
import env;
import fmt;
import dl;

class JsonBnApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        @constructor JsonBnApp() {
            Session t = new Session();
            int tok = t.loadJson("./deeplearning/infer_tests/bn.json");
            Console.writeString("load="); Console.writeLong(tok); Console.writeLine("");
            if (tok == 0) { Console.writeLine("JSON BN SKIP (no load)"); return; }
            double[] bx = new double[2]; bx[0] = 1.0; bx[1] = 3.0;
            t.setInput("x", bx, 2);
            int rk = t.runAuto();
            double[] y = t.getOutput("y");
            int bad = 0;
            if (rk == 0) bad = bad + 1;
            if (absd(y[0] - 2.0) > 2.0e-4) bad = bad + 1;
            if (absd(y[1] - 3.125) > 2.0e-4) bad = bad + 1;
            Console.writeString("y0="); Console.writeFloat(y[0]);
            Console.writeString(" y1="); Console.writeFloat(y[1]);
            Console.writeLine("");
            if (bad == 0) Console.writeLine("JSON BN OK");
            else Console.writeLine("JSON BN MISMATCH");
        }
}

int main() { JsonBnApp app = new JsonBnApp(); return 0; }
