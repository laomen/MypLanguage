// bwd_in_main.myp — P8c：BwdInstanceNorm（per-(n,c) 归一化反向）有限差分梯度对拍。
// x[1,2,2,2]（c0=[0,2,4,6]、c1=[1,3,5,7]）、scale=[1.2,0.7]、bias=[0.3,-0.4]、eps=1e-5。
// 标量损失 L = Σ out·dy（dy 固定"上游梯度"，线性于 out）→ kernel dx/ds/db = ∂L/∂x/∂scale/∂bias。
// 主程序用 double 重算 forward（逐 (n,c) 段 mean/var）做中心差分 (L(p+h)-L(p-h))/2h 对照。
// 全 PASS → BWD IN OK（CPU-only 直连 runtime）。
import env;
import fmt;
import math;
import "../infer/runtime.myp";

class BwdInApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        double inFwd(double[] x, int xOff, double s, double b, double eps) {
            // 段 mean/var（4 元素），返回 L 贡献 Σ out·dy（dy 在 x[4..8) 中索引由调用方传）
            double sum = 0.0; double sumSq = 0.0;
            int i = 0;
            while (i < 4) { double xv = x[xOff + i]; sum = sum + xv; sumSq = sumSq + xv * xv; i = i + 1; }
            double mean = sum / 4.0;
            double variance = sumSq / 4.0 - mean * mean;
            double inv = s / Math.sqrt(variance + eps);
            double acc = 0.0;
            i = 0;
            while (i < 4) {
                double out = (x[xOff + i] - mean) * inv + b;
                acc = acc + out * x[8 + xOff + i];   // dy 放同一数组 [8..16)
                i = i + 1;
            }
            return acc;
        }
        @constructor BwdInApp() {
            double[] xv = new double[16];
            // x[0..7] + dy[8..15]
            double[] xx = new double[8];
            xx[0]=0.0; xx[1]=2.0; xx[2]=4.0; xx[3]=6.0;
            xx[4]=1.0; xx[5]=3.0; xx[6]=5.0; xx[7]=7.0;
            double[] dyy = new double[8];
            dyy[0]=0.5; dyy[1]=-1.0; dyy[2]=2.0; dyy[3]=0.25;
            dyy[4]=-3.0; dyy[5]=1.5; dyy[6]=-0.5; dyy[7]=2.0;
            double[] sc = new double[2];
            sc[0]=1.2; sc[1]=0.7;
            double[] bi = new double[2];
            bi[0]=0.3; bi[1]=-0.4;
            double eps = 1.0e-5;
            int i = 0;
            while (i < 8) { xv[i] = xx[i]; xv[8 + i] = dyy[i]; i = i + 1; }
            // runtime kernel
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            rt.setTrain(1);
            int xT = rt.addTensor4(1, 2, 2, 2);
            int dyT = rt.addTensor4(1, 2, 2, 2);
            int dxT = rt.addTensor4(1, 2, 2, 2);
            int sT = rt.addTensor(2, 1);
            int bT = rt.addTensor(2, 1);
            int dsT = rt.addTensor(2, 1);
            int dbT = rt.addTensor(2, 1);
            i = 0;
            while (i < 8) { rt.setFlat(xT, i, xx[i]); rt.setFlat(dyT, i, dyy[i]); i = i + 1; }
            rt.setFlat(sT, 0, sc[0]); rt.setFlat(sT, 1, sc[1]);
            rt.setFlat(bT, 0, bi[0]); rt.setFlat(bT, 1, bi[1]);
            rt.addBwdInstanceNorm(dyT, xT, dxT, sT, bT, dsT, dbT, 1, 2, 4, 0, 0);
            rt.run();
            int bad = 0;
            double h = 1.0e-3;
            // dx vs ∂L/∂x 中心差分
            i = 0;
            while (i < 8) {
                double xp = xv[i]; xv[i] = xp + h;
                double lp = inFwd(xv, 0, sc[0], bi[0], eps) + inFwd(xv, 4, sc[1], bi[1], eps);
                xv[i] = xp - h;
                double lm = inFwd(xv, 0, sc[0], bi[0], eps) + inFwd(xv, 4, sc[1], bi[1], eps);
                xv[i] = xp;
                double g = (lp - lm) / (2.0 * h);
                if (absd(rt.getFlat(dxT, i) - g) > 2.0e-2) bad = bad + 1;
                i = i + 1;
            }
            // ds vs ∂L/∂scale、db vs ∂L/∂bias
            int c = 0;
            while (c < 2) {
                double sp = sc[c]; sc[c] = sp + h;
                double lp = inFwd(xv, 0, sc[0], bi[0], eps) + inFwd(xv, 4, sc[1], bi[1], eps);
                sc[c] = sp - h;
                double lm = inFwd(xv, 0, sc[0], bi[0], eps) + inFwd(xv, 4, sc[1], bi[1], eps);
                sc[c] = sp;
                double gs = (lp - lm) / (2.0 * h);
                if (absd(rt.getFlat(dsT, c) - gs) > 2.0e-2) bad = bad + 1;
                double bp = bi[c]; bi[c] = bp + h;
                lp = inFwd(xv, 0, sc[0], bi[0], eps) + inFwd(xv, 4, sc[1], bi[1], eps);
                bi[c] = bp - h;
                lm = inFwd(xv, 0, sc[0], bi[0], eps) + inFwd(xv, 4, sc[1], bi[1], eps);
                bi[c] = bp;
                double gb = (lp - lm) / (2.0 * h);
                if (absd(rt.getFlat(dbT, c) - gb) > 2.0e-2) bad = bad + 1;
                c = c + 1;
            }
            Console.writeString("bwd in bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (bad == 0) Console.writeLine("BWD IN OK");
            else Console.writeLine("BWD IN MISMATCH");
        }
}
int main() { BwdInApp app = new BwdInApp(); return 0; }
