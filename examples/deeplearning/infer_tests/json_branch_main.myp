// json_branch_main.myp — JSON 多分支/多算子 demo（branch.json）。
// 双分支分叉（fan-out：x → 两个 Gemm 权重 const 2/3）→ fan-in 多元汇合
// （Add/Sub/Mul/Div + Concat axis=1 + MatMul 权重）+ 4D 图算子
// （GlobalAveragePool/Sigmoid/Flatten）。权重用 const 便于手算断言（零外部数据）。
//
// 数值（x=[0.5,1,1.5,2]，S=5）：
//   a2 = 2·S = [10]*4；b2 = 3·S = [15]*4
//   d_sub=a2-b2=[-5]*4  d_mul=a2*b2=[150]*4  d_div=a2/b2=10/15≈0.66667
//   d_add=a2+b2=[25]*4  e=concat(a2,b2,axis1)=[10*4,15*4]（[1,8]）
//   img=[1,2,3,4,2,4,6,8]（[1,2,2,2] NCHW：c0=[[1,2],[3,4]] c1=[[2,4],[6,8]]）
//     gap=GAP(img)=[2.5,5]  sg=sigmoid(gap)≈[0.924142,0.993307]
//     flat=flatten(img)=[1,2,3,4,2,4,6,8]（[1,8]）
// 注：2D MatMul 未含（框架 MatMul 走 4D batch 路径）；JSON MatMul 支持保留，
//     用户须以 4D batch 形状声明（见 json_model 注释）。
// CPU+GPU JSON BRANCH OK。
import env;
import fmt;
import dl;

class JsonBranchApp {
    action:
        @constructor JsonBranchApp() {
            Session s = new Session();
            int ok = s.loadJson("./deeplearning/infer_tests/branch.json");
            Console.writeString("load ok="); Console.writeLong(ok);
            Console.writeString(" ops="); Console.writeLong(s.opCount());
            Console.writeLine("");
            if (ok == 0) { Console.writeLine("JSON BRANCH SKIP (no load)"); return; }

            double[] x = new double[4];
            x[0] = 0.5; x[1] = 1.0; x[2] = 1.5; x[3] = 2.0;
            s.setInput("x", x, 4);
            double[] img = new double[8];
            int i = 0;
            while (i < 8) {
                if (i < 4) img[i] = double(i + 1);        // c0 = 1,2,3,4
                else img[i] = 2.0 * double(i - 4) + 2.0;  // c1 = 2,4,6,8
                i = i + 1;
            }
            s.setInput("img", img, 8);
            int rk = s.runAuto();

            int nf = 0;
            nf = nf + chk(s, "a2", 4, 10.0, 0.0);
            nf = nf + chk(s, "b2", 4, 15.0, 0.0);
            nf = nf + chk(s, "d_sub", 4, -5.0, 0.0);
            nf = nf + chk(s, "d_mul", 4, 150.0, 0.0);
            nf = nf + chk(s, "d_div", 4, 10.0 / 15.0, 1.0e-4);
            nf = nf + chk(s, "d_add", 4, 25.0, 0.0);
            nf = nf + chk(s, "e", 4, 10.0, 1.0e-4);      // 前 4 = 10（concat 有 float 尾差）
            nf = nf + chkOff(s, "e", 4, 4, 15.0, 1.0e-4); // 后 4 = 15
            nf = nf + chk2(s, "gap", 2, 2.5, 5.0, 1.0e-5);
            nf = nf + chk2(s, "sg", 2, 0.92414182, 0.99330715, 1.0e-4);
            nf = nf + chkFlat(s, "flat", 8);
            Console.writeString("run="); Console.writeLong(rk);
            Console.writeString(" fail="); Console.writeLong(nf);
            Console.writeLine("");

            if (ok == 1 && rk == 1 && nf == 0) {
                Console.writeLine("JSON BRANCH OK");
            } else {
                Console.writeLine("JSON BRANCH MISMATCH");
            }
        }

        // 断言 name 输出 n 个元素全等于 v（容差 tol）
        int chk(Session s, string nm, int n, double v, double tol) {
            double[] o = s.getOutput(nm);
            int sz = s.tensorSize(nm);
            int k = 0;
            int bad = 0;
            while (k < n) {
                double d = o[k] - v;
                if (d < 0.0) d = 0.0 - d;
                if (d > tol) bad = bad + 1;
                k = k + 1;
            }
            if (bad > 0 || sz < n) {
                Console.writeString("FAIL "); Console.writeString(nm);
                Console.writeString(" sz="); Console.writeLong(sz);
                Console.writeString(" bad="); Console.writeLong(bad);
                Console.writeString(" v0..="); Console.writeFloat(o[0]);
                Console.writeString(","); Console.writeFloat(o[1]);
                Console.writeString(","); Console.writeFloat(o[2]);
                Console.writeString(","); Console.writeFloat(o[3]);
                Console.writeLine("");
                return 1;
            }
            return 0;
        }

        // 断言 name 输出 [from,from+n) 全等于 v
        int chkOff(Session s, string nm, int from, int n, double v, double tol) {
            double[] o = s.getOutput(nm);
            int k = 0;
            int bad = 0;
            while (k < n) {
                double d = o[from + k] - v;
                if (d < 0.0) d = 0.0 - d;
                if (d > tol) bad = bad + 1;
                k = k + 1;
            }
            if (bad > 0) {
                Console.writeString("FAIL "); Console.writeString(nm);
                Console.writeString(" off bad="); Console.writeLong(bad);
                Console.writeLine("");
                return 1;
            }
            return 0;
        }

        // 断言 name 输出 2 元素 = v0, v1
        int chk2(Session s, string nm, int n, double v0, double v1, double tol) {
            double[] o = s.getOutput(nm);
            int bad = 0;
            double d0 = o[0] - v0; if (d0 < 0.0) d0 = 0.0 - d0; if (d0 > tol) bad = bad + 1;
            double d1 = o[1] - v1; if (d1 < 0.0) d1 = 0.0 - d1; if (d1 > tol) bad = bad + 1;
            if (bad > 0) {
                Console.writeString("FAIL "); Console.writeString(nm);
                Console.writeString(" v="); Console.writeFloat(o[0]);
                Console.writeString(","); Console.writeFloat(o[1]);
                Console.writeString(" bad="); Console.writeLong(bad);
                Console.writeLine("");
                return 1;
            }
            return 0;
        }

        // 断言 name 输出 = [1,2,3,4,2,4,6,8]（img 展平序）
        int chkFlat(Session s, string nm, int n) {
            double[] o = s.getOutput(nm);
            int[] exp = new int[8];
            int k = 0;
            while (k < 8) { if (k < 4) exp[k] = k + 1; else exp[k] = 2 * (k - 4) + 2; k = k + 1; }
            int bad = 0;
            k = 0;
            while (k < n && k < 8) {
                double d = o[k] - double(exp[k]);
                if (d < 0.0) d = 0.0 - d;
                if (d > 1.0e-5) bad = bad + 1;
                k = k + 1;
            }
            if (bad > 0) {
                Console.writeString("FAIL "); Console.writeString(nm);
                Console.writeString(" bad="); Console.writeLong(bad);
                Console.writeLine("");
                return 1;
            }
            return 0;
        }
}

int main() { JsonBranchApp a = new JsonBranchApp(); return 0; }
