// json_bn_train_main.myp — P8c：JSON BatchNormalization scale·bias 训练（MSE）端到端。
// bn_train.json：x[1,2,4,4]（图输入）→ BatchNormalization（mean=0/var=1/scale=bias=初值）→ out。
//   out_c = scale_c·x_c/sqrt(1+eps)+bias_c ≈ scale_c·x_c+bias_c。目标 out0=2·x0、out1=0.3·x1
//   → BN 须学 scale0≈2、scale1≈0.3（bias→0）。若 BwdBatchNorm 不给 dscale/dbias（或符号错），
//   scale/bias 不动 → loss 不降 → 本测试抓 scale·bias 梯度 + Update 路径。
// CPU JSON BN TRAIN OK（lr=0.005 × 1500 步）。
import env;
import fmt;
import dl;

class JsonBnTrainApp {
    action:
        @constructor JsonBnTrainApp() {
            Session t = new Session();
            t.setLossMode(2);   // MSE
            int tok = t.loadJsonTrain("./deeplearning/infer_tests/bn_train.json");
            if (tok == 0) { Console.writeLine("JSON BN TRAIN SKIP (no load)"); return; }
            t.setLr(0.005); t.setTrainMode(1);
            double[] bx = new double[32];
            int p = 0;
            while (p < 16) {
                bx[p] = double(p + 1);            // c0 = 1..16
                bx[16 + p] = double(p + 1) * 0.5 + 3.0;   // c1 = 3.5..11
                p = p + 1;
            }
            t.setInput("x", bx, 32);
            int labT = t.tensorId("label");
            p = 0;
            while (p < 16) {
                t.setFlat(labT, p, 2.0 * bx[p]);                 // out0 → 2·x0
                t.setFlat(labT, 16 + p, 0.3 * bx[16 + p]);       // out1 → 0.3·x1
                p = p + 1;
            }
            double l0 = 0.0; double lf = 0.0;
            int step = 0;
            while (step < 1500) {
                t.runTrainAuto();
                if (step == 0) l0 = t.loss();
                if (step == 1499) lf = t.loss();
                step = step + 1;
            }
            double[] o = t.getOutput("out");
            int bad = 0;
            p = 0;
            while (p < 16) {
                double e0 = o[p] - 2.0 * bx[p]; if (e0 < 0.0) e0 = 0.0 - e0; if (e0 > 0.1) bad = bad + 1;
                double e1 = o[16 + p] - 0.3 * bx[16 + p]; if (e1 < 0.0) e1 = 0.0 - e1; if (e1 > 0.1) bad = bad + 1;
                p = p + 1;
            }
            Console.writeString("l0="); Console.writeFloat(l0);
            Console.writeString(" lf="); Console.writeFloat(lf);
            Console.writeString(" fitbad="); Console.writeLong(bad);
            Console.writeString(" gpu="); Console.writeLong(t.gpuTrainOn());
            Console.writeLine("");
            if (tok == 1 && l0 > 0.5 && lf < 0.02 * l0 && bad == 0) Console.writeLine("JSON BN TRAIN OK");
            else Console.writeLine("JSON BN TRAIN FAIL");
        }
}
int main() { JsonBnTrainApp app = new JsonBnTrainApp(); return 0; }
