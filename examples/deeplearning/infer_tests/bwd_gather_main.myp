// bwd_gather_main.myp — B：Gather 反向（scatter-add 回 data）数值对拍。
// data[1,3,1,1]（dn=1,dc=3,dh=1,dw=1；3 元素 c0/c1/c2）。Gather axis=1。
//   组1 indices=[0,2] → out[1,2,1,1]=[c0,c2]；dy=[5,7] → dx=[5,0,7]
//   组2 indices=[0,0]（重复 idx）→ out=[c0,c0]；dy=[3,4] → dx=[7,0,0]（累加）
// out(dy) 用 addTensor4(1,2,1,1)；dx addTensor4(1,3,1,1)。全部 PASS → BWD GATHER OK。
import env;
import fmt;
import "../infer/runtime.myp";

class BwdGatherApp {
    action:
        double absd(double v) { if (v < 0.0) return 0.0 - v; return v; }
        @constructor BwdGatherApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(1024);
            rt.setTrain(1);
            // 组1
            int dx1 = rt.addTensor4(1, 3, 1, 1);
            int dy1 = rt.addTensor4(1, 2, 1, 1);
            int i1 = rt.addTensor(2, 1);
            rt.setFlat(dy1, 0, 5.0); rt.setFlat(dy1, 1, 7.0);
            rt.setFlat(i1, 0, 0.0); rt.setFlat(i1, 1, 2.0);
            rt.addBwdGather(dy1, i1, dx1, 1, 2, 1, 3, 1, 1);
            // 组2（重复 idx）
            int dx2 = rt.addTensor4(1, 3, 1, 1);
            int dy2 = rt.addTensor4(1, 2, 1, 1);
            int i2 = rt.addTensor(2, 1);
            rt.setFlat(dy2, 0, 3.0); rt.setFlat(dy2, 1, 4.0);
            rt.setFlat(i2, 0, 0.0); rt.setFlat(i2, 1, 0.0);
            rt.addBwdGather(dy2, i2, dx2, 1, 2, 1, 3, 1, 1);
            rt.run();
            int bad = 0;
            // 组1：dx=[5,0,7]
            double[] e1 = new double[3];
            e1[0] = 5.0; e1[1] = 0.0; e1[2] = 7.0;
            int i = 0;
            while (i < 3) { if (absd(rt.getFlat(dx1, i) - e1[i]) > 1.0e-3) bad = bad + 1; i = i + 1; }
            // 组2：dx=[7,0,0]
            double[] e2 = new double[3];
            e2[0] = 7.0; e2[1] = 0.0; e2[2] = 0.0;
            i = 0;
            while (i < 3) { if (absd(rt.getFlat(dx2, i) - e2[i]) > 1.0e-3) bad = bad + 1; i = i + 1; }
            Console.writeString("bwd gather bad=");
            Console.writeLong(bad);
            Console.writeLine("");
            if (bad == 0) Console.writeLine("BWD GATHER OK");
            else Console.writeLine("BWD GATHER MISMATCH");
        }
}

int main() { BwdGatherApp app = new BwdGatherApp(); return 0; }
