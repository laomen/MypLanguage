// gpu_bw_test.myp — RTX 2070 SUPER 实测内存带宽微基准（读 / 写 / 读+写）
// 1GiB 缓冲 × 20 次累计计时（__myp_now_ms 只有 ms 精度，累计可消除舍入噪声）。
// GB/s = MB × 1.048576 / 总ms。单数组 resident（@gpu for 多数组 resident 不可靠）。
//   ./build/mypc examples/deeplearning/llm/gpu_bw_test.myp -o /tmp/gbw --stdlib stdlib
//   cd examples && MYP_GPU=1 /tmp/gbw
import env;
import fmt;
import math;
import gpu;
import cuda;

class BwTest {
    action:
        @constructor BwTest() {
            if (Cuda.available() != 1) { Console.writeLine("no gpu"); return; }
            int MB = 1024;                       // 1 GiB
            int n = MB * 262144;                 // MB * 2^18 = 1GiB floats
            float[] a = new float[n];
            int i = 0;
            while (i < n) { a[i] = float(i % 1000) + 0.5f; i = i + 1; }
            GpuBufferF bufA = new GpuBufferF(a, n);
            long da = bufA.devicePtr();
            Console.writeLine("H2D 1GiB done");
            int rep = 20;

            // ---- 读带宽：guard 防优化（a[p]>1e30 恒假但强制读 a[p]）----
            @gpu for (long p = 0L; p < long(1024); p = p + 1L) resident(a = da) {
                if (a[p] > 1.0e30) a[0] = a[p];
            }
            bufA.copyToHost(a, 0, 0, 1);
            long ts = __myp_now_ms();
            int r = 0;
            while (r < rep) {
                @gpu for (long p = 0L; p < long(n); p = p + 1L) resident(a = da) {
                    if (a[p] > 1.0e30) a[0] = a[p];
                }
                bufA.copyToHost(a, 0, 0, 1);     // 同步
                r = r + 1;
            }
            long te = __myp_now_ms();
            double msR = double(te - ts);
            Console.writeString("READ  1GiB x" + Fmt.i(rep) + " = " + Fmt.i(int(msR)) + "ms -> " + Fmt.i(int(double(MB) * 1.048576 / msR)) + " GB/s");
            Console.writeLine("");

            // ---- 写带宽：a[p] = const ----
            ts = __myp_now_ms();
            r = 0;
            while (r < rep) {
                @gpu for (long p = 0L; p < long(n); p = p + 1L) resident(a = da) {
                    a[p] = float(3.14159);
                }
                bufA.copyToHost(a, 0, 0, 1);     // 同步
                r = r + 1;
            }
            te = __myp_now_ms();
            double msW = double(te - ts);
            Console.writeString("WRITE 1GiB x" + Fmt.i(rep) + " = " + Fmt.i(int(msW)) + "ms -> " + Fmt.i(int(double(MB) * 1.048576 / msW)) + " GB/s");
            Console.writeLine("");

            // ---- 读+写：a[p] = a[p] * 2（双向流量 2GiB/次）----
            ts = __myp_now_ms();
            r = 0;
            while (r < rep) {
                @gpu for (long p = 0L; p < long(n); p = p + 1L) resident(a = da) {
                    a[p] = a[p] * float(2.0);
                }
                bufA.copyToHost(a, 0, 0, 1);     // 同步
                r = r + 1;
            }
            te = __myp_now_ms();
            double msC = double(te - ts);
            Console.writeString("COPY  1GiB x" + Fmt.i(rep) + " = " + Fmt.i(int(msC)) + "ms -> " + Fmt.i(int(double(MB) * 2.0 * 1.048576 / msC)) + " GB/s (双向)");
            Console.writeLine("");

            bufA.free();
        }
}

int main() {
    BwTest t = new BwTest();
    return 0;
}
