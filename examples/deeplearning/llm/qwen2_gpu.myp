// qwen2_gpu.myp — Qwen2-0.5B-Instruct GPU 端到端（resident 设备驻留，一次 H2D 整块 arena）
//
// 与 qwen2_chat.myp 同流程（文本 → MYP 分词 → 生成 → 解码），但 24 层 + lm_head 全在
// GPU 上跑：
//   1) 加载权重（CPU 1.98GB float[]）→ GpuBufferF 整块一次 H2D（~0.2s）；
//   2) 每 step：gatherRows(tok 标量) → 24 层（GpuLLMOps.rmsNorm/rope/attentionCached/
//      mul/cachePut + GpuInferOps.dense/matmul/add/silu，全 resident(a=dev)）→ lm_head
//      matmul → 只 D2H logits 区（607KB）→ CPU argmax 采样；
//   3) 与 transformers 贪心参考对拍 + 解码输出文本。
//
// 需 GPU（RTX 2070 SUPER 8GB 足够；MYP_GPU=1）：
//   ./build/mypc examples/deeplearning/llm/qwen2_gpu.myp -o /tmp/q2gpu --stdlib stdlib
//   cd examples && MYP_GPU=1 /tmp/q2gpu

import env;
import fmt;
import text;
import math;
import gpu;
import gpu.stream;
import gpu.graph;
import cuda;
import "../infer/ops.myp";
import "../infer/pb.myp";
import "gpu_llm_ops.myp";
import "qwen2_tokenizer.myp";

class Qwen2Gpu {
    action:
        @constructor Qwen2Gpu() {
            int V = 151936; int H = 896; int L = 24; int QH = 14; int KVH = 2; int HD = 64;
            int FFN = 4864; int POS = 32768; int W = 2048; int groups = QH / KVH;
            int kvD = KVH * HD;
            int MAXGEN = 200;
            double EPS = 0.000001;
            int H2 = H * H;
            int KV = KVH * HD * H;
            int KB = KVH * HD;
            int F = FFN * H;
            int per = H + H2 + H + KV + KB + KV + KB + H2 + H + 3 * F;   // 14912384
            int half = HD / 2;

            int wteOff = 0;
            int base0 = V * H;
            int weightsEnd = base0 + L * per + H;
            int lnfOff = weightsEnd - H;
            int tokOff = weightsEnd;
            int xOff = tokOff + 1;
            int xnOff = xOff + H;
            int qOff = xnOff + H;
            int kOff = qOff + H;
            int vOff = kOff + KV;
            int ctxOff = vOff + KV;
            int gOff = ctxOff + H;
            int uOff = gOff + FFN;
            int hOff = uOff + FFN;
            int scOff = hOff + H;              // [QH*W]（GPU attention 每头独立分数）
            int logOff = scOff + QH * W;       // [V]
            int fullCosOff = logOff + V;       // [half, POS]
            int fullSinOff = fullCosOff + half * POS;
            int kcBase = fullSinOff + half * POS;
            int lmOff = kcBase + L * 2 * kvD * W;      // 转置 wte [H,V]（lm_head 用，GEMV 合并访存）
            int partOff = lmOff + V * H;               // K 分块 GEMM 的 partial[work,chunks] 区
            int paramTokOff = partOff + 2 * FFN * 8;   // 设备参数槽：tok（float 位）
            int paramPosOff = paramTokOff + 1;         // 设备参数槽：pos=cacheLen（float 位）
            int CAP = paramPosOff + 8;
            float[] arena = new float[CAP];

            // ---- 加载权重 + RoPE 表 + 分词器 + 解码表 ----
            int fd = __myp_io_fopen("./deeplearning/data/llm/qwen2_weights.bin", "rb");
            if (fd < 0) { Console.writeLine("weights file missing"); return; }
            loadBlock(arena, fd, wteOff, weightsEnd);
            __myp_io_fclose();
            // 转置全部权重矩阵为 [xRows, outDim]（GEMV 合并访存；原布局 [outDim,xRows] 非合并 → ~30x 慢）
            float[] tmpW = new float[FFN * H];
            int lti = 0;
            while (lti < L) {
                int base = base0 + lti * per;
                int bq = base + H;
                int bk = base + H + H2 + H;
                int bv = bk + KV + KB;
                int bo = bv + KV + KB;
                int bln2 = bo + H2;
                int bgate = bln2 + H;
                int bup = bgate + F;
                int bdown = bup + F;
                transposeW(arena, tmpW, bq, bq, H, H);
                transposeW(arena, tmpW, bk, bk, KB, H);
                transposeW(arena, tmpW, bv, bv, KB, H);
                transposeW(arena, tmpW, bo, bo, H, H);
                transposeW(arena, tmpW, bgate, bgate, FFN, H);
                transposeW(arena, tmpW, bup, bup, FFN, H);
                transposeW(arena, tmpW, bdown, bdown, H, FFN);
                lti = lti + 1;
            }
            // lm_head 转置权重 [H,V]：lm[r*V + c] = wte[c*H + r]（embed 仍用原 [V,H]）
            int lmR = 0;
            while (lmR < H) {
                int lmC = 0;
                while (lmC < V) { arena[lmOff + lmR * V + lmC] = arena[wteOff + lmC * H + lmR]; lmC = lmC + 1; }
                lmR = lmR + 1;
            }
            int fd0 = __myp_io_fopen("./deeplearning/data/llm/qwen2_cossin.bin", "rb");
            if (fd0 < 0) { Console.writeLine("cossin file missing"); return; }
            loadBlock(arena, fd0, fullCosOff, half * POS);
            loadBlock(arena, fd0, fullSinOff, half * POS);
            __myp_io_fclose();
            Qwen2Tokenizer tk = new Qwen2Tokenizer();
            if (tk.load() < 0) { Console.writeLine("tokenizer load failed"); return; }
            int[] decOff = new int[151647];
            fd = __myp_io_fopen("./deeplearning/data/llm/qwen2_dec_offs.bin", "rb");
            if (fd < 0) { Console.writeLine("dec offs missing"); return; }
            int vi = 0;
            while (vi <= 151646) { decOff[vi] = readI32(); vi = vi + 1; }
            __myp_io_fclose();
            int[] decData = new int[1000000];
            int decLen = 0;
            fd = __myp_io_fopen("./deeplearning/data/llm/qwen2_dec_data.bin", "rb");
            if (fd < 0) { Console.writeLine("dec data missing"); return; }
            int vb = __myp_io_read_byte();
            while (vb >= 0) { decData[decLen] = vb; decLen = decLen + 1; vb = __myp_io_read_byte(); }
            __myp_io_fclose();

            // ---- 读用户输入 + 组装 chat 模板 + MYP 分词 ----
            int[] text = new int[4096];
            int nText = 0;
            fd = __myp_io_fopen("./deeplearning/data/llm/qwen2_prompt.txt", "rb");
            if (fd < 0) { Console.writeLine("qwen2_prompt.txt missing"); return; }
            int ch = __myp_io_read_byte();
            while (ch >= 0 && nText < 4096) { text[nText] = ch; nText = nText + 1; ch = __myp_io_read_byte(); }
            __myp_io_fclose();
            int[] chat = new int[8192];
            int nChat = 0;
            appendStr(chat, nChat, "<|im_start|>system\nYou are a helpful assistant.<|im_end|>\n");
            nChat = nChat + 58;
            appendStr(chat, nChat, "<|im_start|>user\n");
            nChat = nChat + 17;
            int uj = 0;
            while (uj < nText) { chat[nChat + uj] = text[uj]; uj = uj + 1; }
            nChat = nChat + nText;
            appendStr(chat, nChat, "<|im_end|>\n");
            nChat = nChat + 11;
            appendStr(chat, nChat, "<|im_start|>assistant\n");
            nChat = nChat + 22;
            int[] prompt = new int[4096];
            int nPrompt = tk.encode(chat, 0, nChat, prompt);
            Console.writeString("MYP tokenize: " + Fmt.i(nChat) + " bytes -> " + Fmt.i(nPrompt) + " tokens");
            Console.writeLine("");

            // ---- GPU 初始化：整块 arena 一次 H2D ----
            long t0 = __myp_now_ms();
            if (Cuda.available() != 1) {
                Console.writeLine("GPU unavailable (Cuda.available()!=1)");
                return;
            }
            GpuBufferF arenaBuf = new GpuBufferF(arena, CAP);
            long dev = arenaBuf.devicePtr();
            if (dev == 0L) { Console.writeLine("GPU buffer alloc failed"); return; }
            GpuStream gs = new GpuStream();
            long t1 = __myp_now_ms();
            Console.writeString("GPU arena H2D in " + Fmt.i(t1 - t0) + "ms");
            Console.writeLine("");

            // ---- 参考对拍（可选）----
            int[] refIds = new int[512];
            int nRef = 0;
            fd = __myp_io_fopen("./deeplearning/data/llm/qwen2_ref_gen_ids.bin", "rb");
            if (fd >= 0) {
                nRef = readI32();
                int ri = 0;
                while (ri < nRef) { refIds[ri] = readI32(); ri = ri + 1; }
                __myp_io_fclose();
            }

            // ---- GPU 生成循环（CUDA Graph：step 0 捕获整段前向，后续一次 launch 重放）----
            // 逐 step 变化的标量（tok/pos）写入设备参数槽 paramTokOff/paramPosOff，重放前
            // 一次小 H2D；graph 内 kernel 结构固定（grid 由 H/KV/FFN/heads 决定，与 cacheLen 无关）。
            int[] winHist = new int[512];
            int cacheLen = 0;
            int step = 0;
            int total = 0;
            int eos = 151645;
            int done = 0;
            int dbg = 0;
            if (Console.getEnv("MYP_Q2G_DBG") == "1" && Console.getEnv("MYP_Q2G_GRAPH") != "1") dbg = 1;
            GpuGraph gg = new GpuGraph();
            GpuGraphExec gexec = null;
            int useGraph = 0;
            int capPending = 0;
            int wantGraph = 1;                    // 默认 CUDA Graph（融合后 11ms/step 快于 per-kernel 13ms）
            if (Console.getEnv("MYP_Q2G_GRAPH") == "0") wantGraph = 0;
            long tGen0 = __myp_now_ms();
            while (done == 0) {
                int tok = 0;
                if (step < nPrompt) tok = prompt[step];
                else {
                    // 上一轮 logits 已 D2H，从 host arena 读 argmax
                    tok = argmax(arena, logOff, V);
                }
                winHist[step] = tok;
                // 写设备参数槽（tok/pos）→ H2D（每次执行前更新）
                arena[paramTokOff] = float(tok);
                arena[paramPosOff] = float(cacheLen);
                arenaBuf.copyFromHostAsync(arena, paramTokOff, paramTokOff, 2, gs);
                if (step == 0 && wantGraph == 1) {
                    gs.sync();                       // flush 参量 H2D（捕获前流须干净）
                    gg.captureBegin(gs);
                    capPending = 1;
                }
                if (useGraph == 1) {
                    // 图重放：一次 launch 执行整段前向（内核读设备参量槽）
                    gexec.launch(gs);
                } else {
                    // 非图 / 捕获步：逐 kernel
                    GpuLLMOps.gatherRows(arena, wteOff, paramTokOff, xOff, V, H, dev, gs);
                    if (dbg == 1 && step == 0) {
                        gs.sync();
                        arenaBuf.copyToHost(arena, xOff, xOff, H);
                        Console.writeString("  emb x[0..5]=");
                        int dq = 0; while (dq < 6) { Console.writeFloat(arena[xOff + dq]); Console.writeString(" "); dq = dq + 1; }
                        Console.writeLine("");
                    }
                    int li = 0;
                    while (li < L) {
                        int base = base0 + li * per;
                        layerDecode(arena, dev, gs, base, paramPosOff, xOff, xnOff, qOff, kOff, vOff, ctxOff, gOff, uOff, hOff, scOff,
                                    fullCosOff, fullSinOff, kcBase + li * 2 * kvD * W, partOff, W, H, QH, KVH, HD, FFN, groups, kvD, EPS);
                        if (dbg == 1 && li == 0 && step == 0) {
                            gs.sync();
                            arenaBuf.copyToHost(arena, xOff, xOff, H);
                            arenaBuf.copyToHost(arena, qOff, qOff, H);
                            Console.writeString("  GPU q[0]=");
                            Console.writeFloat(arena[qOff + 0]);
                            Console.writeString(" q[632]=");
                            Console.writeFloat(arena[qOff + 632]);
                            Console.writeLine("");
                            // CPU 参考：xn_cpu = rmsNorm(x), q_cpu = Wq@xn + bq（用 host 权重）
                            int ln1 = base;
                            int qw = base + H;
                            int qb = base + H + H * H;
                            double sum = 0.0;
                            int dd = 0;
                            while (dd < H) { double v = double(arena[xOff + dd]); sum = sum + v * v; dd = dd + 1; }
                            double rstd = 1.0 / Math.sqrt(sum / double(H) + EPS);
                            double qc0 = double(arena[qb + 0]);
                            double qc632 = double(arena[qb + 632]);
                            dd = 0;
                            while (dd < H) {
                                double xnd = double(arena[xOff + dd]) * rstd * double(arena[ln1 + dd]);
                                qc0 = qc0 + double(arena[qw + dd * H + 0]) * xnd;
                                qc632 = qc632 + double(arena[qw + dd * H + 632]) * xnd;
                                dd = dd + 1;
                            }
                            Console.writeString("  CPU q[0]=");
                            Console.writeFloat(qc0);
                            Console.writeString(" q[632]=");
                            Console.writeFloat(qc632);
                            Console.writeLine("");
                        }
                        li = li + 1;
                    }
                    // final_norm + lm_head
                    GpuLLMOps.rmsNorm(arena, xOff, lnfOff, xOff, H, 1, EPS, dev, gs);
                    GpuLLMOps.matmul(arena, V, xOff, H, lmOff, V, 1, logOff, dev, gs);
                }
                if (capPending == 1) {
                    int ce = gg.captureEnd(gs);
                    gexec = gg.instantiate();
                    useGraph = (ce == 1 && gexec.valid() == 1) ? 1 : 0;
                    capPending = 0;
                    if (useGraph == 0) {
                        Console.writeString("WARN: graph capture failed (ce=" + Fmt.i(ce) + ") — per-kernel mode");
                        Console.writeLine("");
                    }
                }
                // D2H logits 区（供 CPU 采样）——异步排队到流，sync 后取回
                arenaBuf.copyToHostAsync(arena, logOff, logOff, V, gs);
                gs.sync();
                if (dbg == 1 && step >= nPrompt && step <= nPrompt + 1) {
                    Console.writeString("step " + Fmt.i(step) + " tok=" + Fmt.i(tok) + " argmax=" + Fmt.i(argmax(arena, logOff, V)));
                    Console.writeString("  lg[785]=");
                    Console.writeFloat(arena[logOff + 785]);
                    Console.writeString("  lg[13]=");
                    Console.writeFloat(arena[logOff + 13]);
                    Console.writeString("  lg[151644]=");
                    Console.writeFloat(arena[logOff + 151644]);
                    Console.writeLine("");
                }
                cacheLen = cacheLen + 1;
                step = step + 1;
                total = step;
                if (step >= nPrompt && tok == eos) done = 1;
                if (step >= nPrompt && step >= nPrompt + MAXGEN) done = 1;
            }
            long tGen1 = __myp_now_ms();
            Console.writeString("GPU generate " + Fmt.i(total - nPrompt) + " tokens in " + Fmt.i(tGen1 - tGen0) + "ms (" + Fmt.i((tGen1 - tGen0) / total) + "ms/step)");
            Console.writeLine("");

            // ---- 对拍 ----
            if (nRef > 0) {
                int bad = 0;
                int ck = 0;
                while (ck < nRef) {
                    if (winHist[ck] != refIds[ck]) bad = bad + 1;
                    ck = ck + 1;
                }
                Console.writeString("GENERATE vs transformers: mismatch=" + Fmt.i(bad));
                Console.writeLine("");
                if (bad == 0) Console.writeLine("QWEN2 GPU OK");
                else Console.writeLine("QWEN2 GPU FAIL");
            } else {
                Console.writeLine("QWEN2 GPU DONE (no reference)");
            }

            // ---- 解码输出 ----
            Console.writeString("==== chat output ====");
            Console.writeLine("");
            int totBytes = 0;
            int t2 = 0;
            while (t2 < total) {
                int id = winHist[t2];
                if (id >= 0 && id <= 151645) totBytes = totBytes + (decOff[id + 1] - decOff[id]);
                t2 = t2 + 1;
            }
            ubyte[] outBytes = new ubyte[totBytes];
            int oi = 0;
            t2 = 0;
            while (t2 < total) {
                int id = winHist[t2];
                if (id >= 0 && id <= 151645) {
                    int j = decOff[id];
                    while (j < decOff[id + 1]) { outBytes[oi] = ubyte(decData[j]); oi = oi + 1; j = j + 1; }
                }
                t2 = t2 + 1;
            }
            Console.writeString(str(outBytes));
            Console.writeLine("");
            if (gexec != null) gexec.destroy();
            gg.destroy();
            if (gs != null) gs.destroy();
            if (arenaBuf != null) arenaBuf.free();
        }

        // Qwen2 单层 GPU decode：全 resident(a=dev)，同流异步排队
        // cacheLen/pos 由各内核从设备参数槽 paramPosOff 读（CUDA Graph 重放用）
        void layerDecode(float[] arena, long dev, GpuStream s, int base, int paramPosOff,
                         int xOff, int xnOff, int qOff, int kOff, int vOff, int ctxOff, int gOff, int uOff, int hOff, int scOff,
                         int fullCosOff, int fullSinOff, int kcOff, int partOff, int W, int H, int QH, int KVH, int HD, int FFN,
                         int groups, int kvD, double eps) {
            int ln1 = base;
            int q = base + H;
            int qb = base + H + H * H;
            int k = base + H + H * H + H;
            int kb = base + H + H * H + H + KVH * HD * H;
            int v = kb + KVH * HD;
            int vb = v + KVH * HD * H;
            int o = vb + KVH * HD;
            int ln2 = o + H * H;
            int gate = ln2 + H;
            int up = gate + FFN * H;
            int down = up + FFN * H;
            int ch = 8;

            GpuLLMOps.qkvC(arena, xOff, ln1, eps, q, qb, k, kb, v, vb, qOff, kOff, vOff, H, KVH * HD, dev, s, ch, partOff, kcOff, paramPosOff, kvD, W);
            GpuLLMOps.ropeFused(arena, qOff, kOff, fullCosOff, fullSinOff, H, KVH * HD, QH, KVH, 32768, dev, s, kcOff, paramPosOff, kvD, W);
            GpuLLMOps.attentionCached(arena, qOff, kcOff, kcOff + kvD * W, ctxOff, scOff,
                                      H, W, paramPosOff, QH, groups, dev, s);
            GpuLLMOps.matmulCAdd(arena, H, ctxOff, H, o, H, 1, hOff, dev, s, ch, partOff, xOff);
            GpuLLMOps.gateupC(arena, xOff, ln2, eps, gate, up, gOff, uOff, FFN, H, dev, s, ch, partOff);
            GpuLLMOps.matmulCAdd(arena, H, gOff, FFN, down, H, 1, hOff, dev, s, ch, partOff, xOff);
        }

        void appendStr(int[] buf, int off, string s) {
            ubyte[] b = bytes(s);
            int n = Str.len(s);
            int i = 0;
            while (i < n) { buf[off + i] = int(b[i]); i = i + 1; }
        }

        int argmax(float[] arena, int off, int n) {
            int bi = 0;
            double bv = arena[off + 0];
            int i = 1;
            while (i < n) {
                double v = arena[off + i];
                if (v > bv) { bv = v; bi = i; }
                i = i + 1;
            }
            return bi;
        }

        void loadBlock(float[] arena, int fd, int off, int n) {
            int i = 0;
            while (i < n) { arena[off + i] = float(readF32()); i = i + 1; }
        }

        // 权重矩阵转置：[rows, cols]@srcOff → [cols, rows]@dstOff（用 tmp 缓冲；
        // 同区域就地转置时 srcOff==dstOff）。GEMV 线程=输出、warp 连续读需要 [K,outDim]。
        void transposeW(float[] a, float[] tmp, int srcOff, int dstOff, int rows, int cols) {
            int r = 0;
            while (r < rows) {
                int c = 0;
                while (c < cols) { tmp[c * rows + r] = a[srcOff + r * cols + c]; c = c + 1; }
                r = r + 1;
            }
            int n = rows * cols;
            int i = 0;
            while (i < n) { a[dstOff + i] = tmp[i]; i = i + 1; }
        }

        double readF32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) return 0.0;
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }

        int readI32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0) b0 = 0;
            if (b1 < 0) b1 = 0;
            if (b2 < 0) b2 = 0;
            if (b3 < 0) b3 = 0;
            return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
        }
}

int main() {
    Qwen2Gpu g = new Qwen2Gpu();
    return 0;
}
