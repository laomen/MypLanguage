// llm_ops_check.myp — 阶段5：LayerNorm/GELU/RoPE/GQA-attention 与 numpy 参考对拍
//
// 读 data/llm_ops_ref.bin（make_llm_ops_ref.py 导出），逐算子运行 InferOps，
// 与参考块逐元素比对（相对容差 1e-3）。
//
// 运行（须在 examples/ 下）：
//   deeplearning/infer/tools/onnxvenv/bin/python deeplearning/llm/make_llm_ops_ref.py
//   ./build/mypc examples/deeplearning/llm/llm_ops_check.myp -o /tmp/llm_ops --stdlib stdlib && /tmp/llm_ops

import env;
import fmt;
import text;
import math;
import "../infer/ops.myp";
import "../infer/pb.myp";

class LlmOpsCheck {
    action:
        @constructor LlmOpsCheck() {
            int D = 64; int S = 16; int H = 4; int DH = D / H; int groups = 2; int kvD = 2 * DH;

            // 参考文件块偏移（float 数）
            int r0 = 0;                 // x [64,16]
            int r1 = r0 + D * S;        // gamma [64]
            int r2 = r1 + D;            // beta [64]
            int r3 = r2 + D;            // ln_out [64,16]
            int r4 = r3 + D * S;        // xg [256]
            int r5 = r4 + 256;          // gelu_out [256]
            int r6 = r5 + 256;          // xr [64,16]
            int r7 = r6 + D * S;        // cosT [dh/2,16] = [8,16]
            int r8 = r7 + (DH / 2) * S; // sinT [8,16]
            int r9 = r8 + (DH / 2) * S; // rope_out [64,16]
            int r10 = r9 + D * S;       // q [64,16]
            int r11 = r10 + D * S;      // k [32,16]
            int r12 = r11 + kvD * S;    // v [32,16]
            int r13 = r12 + kvD * S;    // gqa_out [64,16]
            int REFN = r13 + D * S;
            float[] refData = new float[REFN];
            int fd = __myp_io_fopen("./deeplearning/data/llm_ops_ref.bin", "rb");
            if (fd < 0) { Console.writeLine("ref file missing"); return; }
            load(arena0(refData, 0), fd, REFN);
            __myp_io_fclose();

            // arena
            int xOff = 0;            // 1024
            int gOff = xOff + D * S; // 64
            int bOff = gOff + D;     // 64
            int lnOff = bOff + D;    // 1024
            int xgOff = lnOff + D * S;   // 256
            int gelOff = xgOff + 256;    // 256
            int xrOff = gelOff + 256;    // 1024
            int cosOff = xrOff + D * S;  // dh/2*S = 128
            int sinOff = cosOff + (DH / 2) * S;   // 128
            int roOff = sinOff + (DH / 2) * S;    // 1024
            int qOff = roOff + D * S;    // 1024
            int kOff = qOff + D * S;     // 512
            int vOff = kOff + kvD * S;   // 512
            int scOff = vOff + kvD * S;  // 256
            int aOff = scOff + S * S;    // 1024
            int CAP = aOff + D * S;
            float[] arena = new float[CAP];

            int fails = 0;

            // ---- 1) LayerNorm ----
            copy(arena, xOff, refData, r0, D * S);
            copy(arena, gOff, refData, r1, D);
            copy(arena, bOff, refData, r2, D);
            InferOps.layerNorm(arena, xOff, gOff, bOff, lnOff, D, S, 1.0e-5);
            fails = fails + cmp(arena, lnOff, refData, r3, D * S, "LayerNorm", 1.0e-3);

            // ---- 2) GELU ----
            copy(arena, xgOff, refData, r4, 256);
            InferOps.gelu(arena, xgOff, gelOff, 256);
            fails = fails + cmp(arena, gelOff, refData, r5, 256, "GELU", 1.0e-3);

            // ---- 3) RoPE（原地）----
            copy(arena, xrOff, refData, r6, D * S);
            copy(arena, cosOff, refData, r7, (DH / 2) * S);
            copy(arena, sinOff, refData, r8, (DH / 2) * S);
            InferOps.rope(arena, xrOff, cosOff, sinOff, D, S, H);
            fails = fails + cmp(arena, xrOff, refData, r9, D * S, "RoPE", 1.0e-3);

            // ---- 4) GQA attention（groups=2）----
            copy(arena, qOff, refData, r10, D * S);
            copy(arena, kOff, refData, r11, kvD * S);
            copy(arena, vOff, refData, r12, kvD * S);
            InferOps.attention(arena, qOff, kOff, vOff, aOff, scOff, D, S, H, 1, groups);
            fails = fails + cmp(arena, aOff, refData, r13, D * S, "GQA-attn", 1.0e-3);

            if (fails == 0) Console.writeLine("LLM OPS CHECK OK");
            else Console.writeLine("LLM OPS CHECK FAIL (" + Fmt.i(fails) + ")");
        }

        int cmp(float[] a, int aOff, float[] b, int bOff, int n, string name, double tol) {
            double maxD = 0.0;
            int i = 0;
            while (i < n) {
                double d = Math.abs(double(a[aOff + i]) - double(b[bOff + i]));
                if (d > maxD) maxD = d;
                i = i + 1;
            }
            Console.writeString(name + " maxDiff=");
            Console.writeFloat(maxD);
            Console.writeLine("");
            if (maxD < tol) return 0;
            return 1;
        }

        void copy(float[] a, int aOff, float[] b, int bOff, int n) {
            int i = 0;
            while (i < n) { a[aOff + i] = b[bOff + i]; i = i + 1; }
        }

        float[] arena0(float[] a, int off) { return a; }

        void load(float[] arena, int fd, int n) {
            int i = 0;
            while (i < n) { arena[i] = float(readF32()); i = i + 1; }
        }

        double readF32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) return 0.0;
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }
}

int main() {
    LlmOpsCheck c = new LlmOpsCheck();
    return 0;
}
