// gpu_llm_ops_batch.myp — Qwen2 GPU 批量内核（N 路并发对话，同步 batch：共享 pos）
//
// 与 gpu_llm_ops.myp 单序列版同语义，但激活/输出按 [D, N] 布局（特征×batch 列优先：
// y[o*N + s]），权重仍转置 [xRows,outDim]（batch 共享）。KV cache 按 [N, 2*kvD, stride]
// （每序列独立缓存，pos 共享）。matmulC/matmulCAdd 已在 gpu_llm_ops 里支持 batch 参数。
//
// 关键优化（实测 batch=4）：
//   · rstdBatch：rstd 单独小核（grid=N）预计算 → qkvC/gateupC 只读 rstdOff[si]，不再每
//     chunk 线程冗余 896 次 sum2（同 seq 有 ~9728 线程重算同一 rstd，是 batch4 主瓶颈）。
//     实测 gateup 0.416→0.170ms/layer（2.4x），全步 23→18ms。
//   · 线程映射 seq 最内层（r = o*N+ss）：同 output 的 N 个 seq 线程相邻。
//   · 探索后否决：seq 展开进线程的「摊销版」（4 标量累加器）——线程数 ÷4 → 并行度损失
//     抵消带宽节省，实测 2x 更慢（gateup 0.845 vs 0.416）。此 GPU（2070S）batch GEMM 受
//     访存延迟/占用率制约而非纯 DRAM 带宽。
//
// 布局约定：
//   · 激活 x/q/k/v/ctx/g/u/h：feature-major，x[j*N + s]
//   · 输出 y[o*N + s]；权重 W'[j*outDim + o]（转置）
//   · KV cache（每层）：kcOff + s*2*kvD*stride + r*stride + pos（K: r<kvD, V: r∈[kvD,2kvD)）
//   · scOff：scOff + s*QH*stride + bh*stride + i
//   · partial[work, chunks]，work = outDim*N
//   · rstdOff[si]：每序列 rstd（rstdBatch 写，qkvC/gateupC 读）
//   · paramTokOff[s]：每序列 tok；paramPosOff：共享 pos（同步 batch）
//   · 参数槽用 float 位存 int（<2^24 精确）

import gpu;
import gpu.stream;
import math;

class GpuLLMOpsBatch {
    static:
        // embedding 查表（batch）：x[d*N+s] = wte[tok[s]*D + d]；tok 从 paramTokOff[s] 读
        void gatherRows(float[] a, int eOff, int paramTokOff, int xOff, int vocab, int D, int N, long dev, GpuStream s) {
            @gpu for (long p = 0L; p < long(D) * long(N); p = p + 1L) resident(a = dev) stream(s) {
                if (p < long(D) * long(N)) {
                    long d = p % long(D);
                    long ss = p / long(D);
                    int si = int(ss);
                    int id = int(a[paramTokOff + si]);
                    if (id < 0) id = 0;
                    if (id >= vocab) id = vocab - 1;
                    a[xOff + d * long(N) + si] = a[eOff + id * D + int(d)];
                }
            }
        }

        // 每序列 rstd（batch）：grid=N，每线程算自己序列的 rms 倒数存 rstdOff[si]。
        // 与 qkvC/gateupC 内联算相比：避免每 chunk 线程冗余 896 次 sum2 重算（batch4 下
        // 同 seq 有 9728 个线程重算同一个 rstd）。单核 4 线程，开销可忽略。
        void rstdBatch(float[] a, int xOff, int gammaOff, double eps, int H, int N, int rstdOff, long dev, GpuStream s) {
            @gpu for (long si = 0L; si < long(N); si = si + 1L) resident(a = dev) stream(s) {
                if (si < long(N)) {
                    int st = int(si);
                    float sum2 = 0.0f;
                    int dd = 0;
                    while (dd < H) { float xv = a[xOff + dd * N + st]; sum2 = sum2 + xv * xv; dd = dd + 1; }
                    double sd = double(sum2) / double(H) + eps;
                    a[rstdOff + st] = float(1.0) / float(Math.sqrt(sd));
                }
            }
        }

        // qkv 三投影分块版（batch）：rstd 从 rstdOff[si] 读（rstdBatch 预计算），
        // reduce 顺带 cachePut V。输出 q/k/v [outDim, N]。
        // 线程映射 seq 最内层（r = o*N+ss）：同 output 的 N 个 seq 线程相邻 → L1/L2 吸收
        // 同地址权重重复读（保持线程数前提下有效 ~1x 权重 DRAM 流量）。
        void qkvC(float[] a, int xOff, int gammaOff, double eps, int qw, int qb, int kw, int kb, int vw, int vb,
                  int qOff, int kOff, int vOff, int H, int KV, int N, long dev, GpuStream s, int chunks, int partOff,
                  int kcOff, int paramPosOff, int kvD, int stride, int rstdOff) {
            int nOut = H + 2 * KV;
            long tot = long(nOut) * long(N);
            @gpu for (long p = 0L; p < tot * long(chunks); p = p + 1L) resident(a = dev) stream(s) {
                if (p < tot * long(chunks)) {
                    long c = p / tot;
                    long r = p % tot;
                    long o = r / long(N);
                    long ss = r % long(N);
                    int si = int(ss);
                    float rstd = a[rstdOff + si];
                    long xr = long(H);
                    long j0 = (c * xr) / long(chunks);
                    long j1 = ((c + 1L) * xr) / long(chunks);
                    float sum = 0.0f;
                    long j = j0;
                    int oi = int(o);
                    if (oi < H) {
                        while (j < j1) { sum = sum + a[qw + j * long(H) + oi] * (a[xOff + j * long(N) + si] * rstd * a[gammaOff + j]); j = j + 1; }
                    } else if (oi < H + KV) {
                        int idx = oi - H;
                        while (j < j1) { sum = sum + a[kw + j * long(KV) + idx] * (a[xOff + j * long(N) + si] * rstd * a[gammaOff + j]); j = j + 1; }
                    } else {
                        int idx = oi - H - KV;
                        while (j < j1) { sum = sum + a[vw + j * long(KV) + idx] * (a[xOff + j * long(N) + si] * rstd * a[gammaOff + j]); j = j + 1; }
                    }
                    a[partOff + (o * long(N) + ss) * long(chunks) + c] = sum;
                }
            }
            @gpu for (long q = 0L; q < tot; q = q + 1L) resident(a = dev) stream(s) {
                if (q < tot) {
                    long o = q / long(N);
                    long ss = q % long(N);
                    int oi = int(o);
                    int si = int(ss);
                    float sum = 0.0f;
                    long c = 0L;
                    while (c < long(chunks)) { sum = sum + a[partOff + q * long(chunks) + c]; c = c + 1L; }
                    if (oi < H) { sum = sum + a[qb + oi]; a[qOff + oi * N + si] = sum; }
                    else if (oi < H + KV) {
                        int idx = oi - H;
                        sum = sum + a[kb + idx];
                        a[kOff + idx * N + si] = sum;
                    } else {
                        int idx = oi - H - KV;
                        int pos = int(a[paramPosOff]);
                        sum = sum + a[vb + idx];
                        a[vOff + idx * N + si] = sum;
                        a[kcOff + si * 2 * kvD * stride + kvD * stride + idx * stride + pos] = sum;  // V cache
                    }
                }
            }
        }

        // gate/up 两投影分块版（batch）：rstd 从 rstdOff[si] 读，reduce 同线程归约
        // gate[o,s]+up[o,s] → 内联 swiglu。线程映射 seq 最内层（r = o*N+ss）。
        void gateupC(float[] a, int xOff, int gammaOff, double eps, int gw, int uw, int gOff, int uOff, int FFN, int H, int N, long dev, GpuStream s, int chunks, int partOff, int rstdOff) {
            int nOut = 2 * FFN;
            long tot = long(nOut) * long(N);
            @gpu for (long p = 0L; p < tot * long(chunks); p = p + 1L) resident(a = dev) stream(s) {
                if (p < tot * long(chunks)) {
                    long c = p / tot;
                    long r = p % tot;
                    long o = r / long(N);
                    long ss = r % long(N);
                    int si = int(ss);
                    float rstd = a[rstdOff + si];
                    long xr = long(H);
                    long j0 = (c * xr) / long(chunks);
                    long j1 = ((c + 1L) * xr) / long(chunks);
                    float sum = 0.0f;
                    long j = j0;
                    int oi = int(o);
                    if (oi < FFN) {
                        while (j < j1) { sum = sum + a[gw + j * long(FFN) + oi] * (a[xOff + j * long(N) + si] * rstd * a[gammaOff + j]); j = j + 1; }
                    } else {
                        int idx = oi - FFN;
                        while (j < j1) { sum = sum + a[uw + j * long(FFN) + idx] * (a[xOff + j * long(N) + si] * rstd * a[gammaOff + j]); j = j + 1; }
                    }
                    a[partOff + (o * long(N) + ss) * long(chunks) + c] = sum;
                }
            }
            @gpu for (long q = 0L; q < long(FFN) * long(N); q = q + 1L) resident(a = dev) stream(s) {
                if (q < long(FFN) * long(N)) {
                    long o = q / long(N);
                    long ss = q % long(N);
                    int oi = int(o);
                    int si = int(ss);
                    float gs = 0.0f;
                    float us = 0.0f;
                    long c = 0L;
                    while (c < long(chunks)) {
                        gs = gs + a[partOff + (o * long(N) + ss) * long(chunks) + c];
                        us = us + a[partOff + ((long(FFN) + o) * long(N) + ss) * long(chunks) + c];
                        c = c + 1L;
                    }
                    double gd = double(gs);
                    float act = float(gd / (1.0 + Math.exp(0.0 - gd)));
                    a[gOff + oi * N + si] = act * us;
                }
            }
        }

        // q/k rope 合一核（batch）：q/k [D, N]，每 (pair, seq) 一线程；k 分支写 K cache
        void ropeFused(float[] a, int qOff, int kOff, int fullCosOff, int fullSinOff,
                       int H, int KV, int QH, int KVH, int POS, int N, long dev, GpuStream s,
                       int kcOff, int paramPosOff, int kvD, int W) {
            int dhq = H / QH;
            int dhk = KV / KVH;
            int halfq = dhq / 2;
            int halfk = dhk / 2;
            int hq = H / 2;
            int hk = KV / 2;
            int totalPairs = hq + hk;
            @gpu for (long p = 0L; p < long(totalPairs) * long(N); p = p + 1L) resident(a = dev) stream(s) {
                if (p < long(totalPairs) * long(N)) {
                    long r = p % long(totalPairs);
                    long ss = p / long(totalPairs);
                    int si = int(ss);
                    int pos = int(a[paramPosOff]);
                    if (r < long(hq)) {
                        int pi = int(r);
                        int h = pi / halfq;
                        int a2 = pi % halfq;
                        int i0 = h * dhq + a2;
                        int i1 = h * dhq + halfq + a2;
                        double x0 = double(a[qOff + i0 * N + si]);
                        double x1 = double(a[qOff + i1 * N + si]);
                        double c = double(a[fullCosOff + a2 * POS + pos]);
                        double sn = double(a[fullSinOff + a2 * POS + pos]);
                        a[qOff + i0 * N + si] = float(x0 * c - x1 * sn);
                        a[qOff + i1 * N + si] = float(x0 * sn + x1 * c);
                    } else {
                        int kp = int(r) - hq;
                        int h = kp / halfk;
                        int a2 = kp % halfk;
                        int i0 = h * dhk + a2;
                        int i1 = h * dhk + halfk + a2;
                        double x0 = double(a[kOff + i0 * N + si]);
                        double x1 = double(a[kOff + i1 * N + si]);
                        double c = double(a[fullCosOff + a2 * POS + pos]);
                        double sn = double(a[fullSinOff + a2 * POS + pos]);
                        float r0 = float(x0 * c - x1 * sn);
                        float r1 = float(x0 * sn + x1 * c);
                        a[kOff + i0 * N + si] = r0;
                        a[kOff + i1 * N + si] = r1;
                        a[kcOff + si * 2 * kvD * W + i0 * W + pos] = r0;   // K cache
                        a[kcOff + si * 2 * kvD * W + i1 * W + pos] = r1;
                    }
                }
            }
        }

        // KV cache 增量注意力（batch）：每 (head, seq) 一线程，seq 各自 attend 自己的 cache
        // cache 每层 [N, 2*kvD, stride]（seq 步长 2*kvD*stride）；vcOff = kcOff + kvD*stride。
        void attentionCached(float[] a, int qOff, int kcOff, int vcOff, int outOff, int scOff,
                             int D, int stride, int paramPosOff, int heads, int groups, int kvD, int N, long dev, GpuStream s) {
            int dh = D / heads;
            double scale = 1.0 / Math.sqrt(double(dh));
            @gpu for (long p = 0L; p < long(heads) * long(N); p = p + 1L) resident(a = dev) stream(s) {
                if (p < long(heads) * long(N)) {
                    long bhL = p % long(heads);
                    long ss = p / long(heads);
                    int bh = int(bhL);
                    int si = int(ss);
                    int kvh = bh / groups;
                    int pos = int(a[paramPosOff]);
                    int len = pos + 1;
                    int i = 0;
                    while (i < len) {
                        double sum = 0.0;
                        int d = 0;
                        while (d < dh) {
                            sum = sum + double(a[qOff + (bh * dh + d) * N + si]) *
                                          double(a[kcOff + si * 2 * kvD * stride + (kvh * dh + d) * stride + i]);
                            d = d + 1;
                        }
                        a[scOff + si * heads * stride + bh * stride + i] = float(sum * scale);
                        i = i + 1;
                    }
                    int sb = si * heads * stride + bh * stride;
                    float maxv = a[scOff + sb + 0];
                    i = 1;
                    while (i < len) {
                        if (a[scOff + sb + i] > maxv) maxv = a[scOff + sb + i];
                        i = i + 1;
                    }
                    double sumE = 0.0;
                    i = 0;
                    while (i < len) {
                        double e = Math.exp(double(a[scOff + sb + i]) - double(maxv));
                        a[scOff + sb + i] = float(e);
                        sumE = sumE + e;
                        i = i + 1;
                    }
                    i = 0;
                    while (i < len) {
                        a[scOff + sb + i] = float(double(a[scOff + sb + i]) / sumE);
                        i = i + 1;
                    }
                    int d = 0;
                    while (d < dh) {
                        double sum = 0.0;
                        int i2 = 0;
                        while (i2 < len) {
                            sum = sum + double(a[scOff + sb + i2]) *
                                          double(a[vcOff + si * 2 * kvD * stride + (kvh * dh + d) * stride + i2]);
                            i2 = i2 + 1;
                        }
                        a[outOff + (bh * dh + d) * N + si] = float(sum);
                        d = d + 1;
                    }
                }
            }
        }
}

