// distilgpt2_talk.myp — 交互式多轮对话（全链路 MYP，温度+top-k 采样）
//
// 流程：加载权重 + BPE 表 + 解码表（一次性）→ 交互循环：
//   You: <输入一行>
//   把 "User: <输入>\nAssistant:" 追加到对话历史 → MYP BPE 编码 → KV-cache 生成
//   （温度 0.8 + top-k 50 采样，遇 EOS=50256 停，跳过换行）→ 解码打印回复 →
//   回复文本追加回历史 → 下一轮。输入 "exit"/"quit"/"q" 退出。
//
// 采样避免 base 模型贪心输出复读/空行；对话历史以字节缓冲累积，每轮全量编码
// （demo 短对话够用；历史超 W=128 token 时 KV cache 滑窗丢弃最早）。
//
// 编译+运行（须在 examples/ 下；权重 328MB 加载 ~3s）：
//   ./build/mypc examples/deeplearning/llm/distilgpt2_talk.myp -o /tmp/dgpt_talk --stdlib stdlib
//   echo -e "Hi there\nWhat is your name?\nquit" | /tmp/dgpt_talk   # 管道喂入多轮

import env;
import fmt;
import text;
import math;
import random;
import "../infer/ops.myp";
import "../infer/pb.myp";
import "bpe.myp";

class Distilgpt2Talk {
    action:
        @constructor Distilgpt2Talk() {
            int V = 50257; int D = 768; int L = 6; int H = 12; int POS = 1024;
            int W = 128; int groups = 1; int kvD = D / groups;
            int GENERATE = 40;
            int perLayer = 7087872;

            // ---- arena：权重 + 单 token 暂存 + 每层 KV cache ----
            int wteOff = 0;
            int wpeOff = wteOff + V * D;
            int base0 = wpeOff + POS * D;
            int weightsEnd = base0 + L * perLayer + 1536;   // 81,912,576
            int lnfw = weightsEnd - 1536;
            int lnfb = lnfw + 768;
            int tokOff = weightsEnd;
            int xOff = tokOff + 1;
            int xnOff = xOff + D;
            int qkvOff = xnOff + D;
            int attOff = qkvOff + 3 * D;
            int h1Off = attOff + D;
            int h2Off = h1Off + 4 * D;
            int scOff = h2Off + D;
            int logOff = scOff + W;
            int kcBase = logOff + V;
            int CAP = kcBase + L * 2 * kvD * W;
            float[] arena = new float[CAP];

            // ---- 加载权重 ----
            int fd = __myp_io_fopen("./deeplearning/data/llm/distilgpt2_weights.bin", "rb");
            if (fd < 0) { Console.writeLine("weights file missing"); return; }
            loadBlock(arena, fd, wteOff, weightsEnd);
            __myp_io_fclose();

            // ---- 生成配置 ----
            int fdCfg = __myp_io_fopen("./deeplearning/data/llm/distilgpt2_gen_cfg.bin", "rb");
            if (fdCfg >= 0) { GENERATE = readI32(); __myp_io_fclose(); }

            // ---- 采样参数（温度 + top-k + 重复惩罚）----
            double temp = 1.0;
            int topK = 50;
            double penRep = 1.2;   // >1 抑制已生成 token 复读
            long sd = __myp_now_ms() & 2147483647L;
            Random.init(int(sd));

            // ---- BPE 编码器 + 解码 vocab 表 ----
            Bpe bpe = new Bpe();
            int lrc = 0;
            lrc = bpe.load();
            int[] vocabOff = new int[V + 1];
            int[] vocabData = new int[400000];
            int vocabLen = 0;
            fd = __myp_io_fopen("./deeplearning/data/llm/distilgpt2_vocab_offs.bin", "rb");
            if (fd < 0) { Console.writeLine("vocab offs missing"); return; }
            int vi = 0;
            while (vi <= V) { vocabOff[vi] = readI32(); vi = vi + 1; }
            __myp_io_fclose();
            fd = __myp_io_fopen("./deeplearning/data/llm/distilgpt2_vocab_data.bin", "rb");
            if (fd < 0) { Console.writeLine("vocab data missing"); return; }
            int vb = __myp_io_read_byte();
            while (vb >= 0) { vocabData[vocabLen] = vb; vocabLen = vocabLen + 1; vb = __myp_io_read_byte(); }
            __myp_io_fclose();

            // ---- 对话历史字节缓冲 ----
            int[] histText = new int[8192];
            int nHist = 0;
            int[] promptIds = new int[4096];
            int[] winHist = new int[GENERATE + 128];
            int[] replyText = new int[4096];
            int nReply = 0;

            Console.writeLine("=== distilgpt2 talk (MYP, all-in) — type 'exit' to quit ===");
            while (1 == 1) {
                Console.writeString("You: ");
                string input = Console.readString();
                if (input == "exit" || input == "quit" || input == "q") break;
                if (input == "") break;

                // 追加 "User: <input>\nAssistant:" 到历史
                appendStr(histText, nHist, "User: ");
                nHist = nHist + 6;
                appendStr(histText, nHist, input);
                nHist = nHist + Str.len(input);
                appendStr(histText, nHist, "\nAssistant:");
                nHist = nHist + 11;

                // MYP BPE 编码整个历史
                int nPrompt = bpe.encode(histText, 0, nHist, promptIds);
                Console.writeString("  [ctx " + Fmt.i(nHist) + " bytes -> " + Fmt.i(nPrompt) + " tokens]");
                Console.writeLine("");

                // KV-cache 生成回复（遇 EOS 50256 停止）
                nReply = 0;
                int[] reply = new int[GENERATE + 64];
                int nGen = generate(arena, promptIds, nPrompt, reply, GENERATE, temp, topK, penRep,
                                   wteOff, wpeOff, base0, perLayer, lnfw, lnfb, tokOff,
                                   xOff, xnOff, qkvOff, attOff, h1Off, h2Off, scOff, logOff,
                                   kcBase, W, D, H, groups, kvD, V, L, POS);
                // 打印 Assistant: + 解码回复文本 + 追加回历史
                Console.writeString("Assistant: ");
                int[] outBytes = new int[2048];
                int nOutBytes = 0;
                int gi = 0;
                while (gi < nGen) {
                    int tid = reply[gi];
                    int a = vocabOff[tid];
                    int b = vocabOff[tid + 1];
                    int j = a;
                    while (j < b) {
                        int byt = vocabData[j];
                        if (byt < 0) byt = byt + 256;
                        // 打印 + 记入回复文本
                        outBytes[nOutBytes] = byt;
                        nOutBytes = nOutBytes + 1;
                        replyText[nReply] = byt;
                        nReply = nReply + 1;
                        j = j + 1;
                    }
                    gi = gi + 1;
                }
                ubyte[] ob = new ubyte[nOutBytes];
                int oi = 0;
                while (oi < nOutBytes) { ob[oi] = ubyte(outBytes[oi]); oi = oi + 1; }
                Console.writeString(str(ob));
                Console.writeLine("");

                // 回复文本追加回历史（+"\n"）
                int ri = 0;
                while (ri < nReply) { histText[nHist + ri] = replyText[ri]; ri = ri + 1; }
                nHist = nHist + nReply;
                histText[nHist] = 10;
                nHist = nHist + 1;
            }
            Console.writeLine("bye");
        }

        // 追加字符串字节到缓冲
        void appendStr(int[] buf, int off, string s) {
            ubyte[] b = bytes(s);
            int n = Str.len(s);
            int i = 0;
            while (i < n) { buf[off + i] = int(b[i]); i = i + 1; }
        }

        // KV-cache 生成：promptIds（nPrompt 个）→ 采样生成至多 nGen 个（EOS 停）；返回生成数
        int generate(float[] arena, int[] promptIds, int nPrompt, int[] out, int nGen,
                     double temp, int topK, double penRep,
                     int wteOff, int wpeOff, int base0, int perLayer, int lnfw, int lnfb, int tokOff,
                     int xOff, int xnOff, int qkvOff, int attOff, int h1Off, int h2Off, int scOff, int logOff,
                     int kcBase, int W, int D, int H, int groups, int kvD, int V, int L, int POS) {
            int cacheLen = 0;
            int nGenOut = 0;
            int total = nPrompt + nGen;
            int step = 0;
            int[] seen = new int[160];
            int nSeen = 0;
            while (step < total) {
                int tok = 0;
                if (step < nPrompt) tok = promptIds[step];
                else {
                    tok = sampleToken(arena, logOff, V, temp, topK, seen, nSeen, penRep);
                    if (tok == 50256) break;              // EOS 停止
                    if (tok != 198) {                     // 跳过换行 token（仍喂入 cache 保上下文）
                        out[nGenOut] = tok;
                        nGenOut = nGenOut + 1;
                        if (nSeen < 160) { seen[nSeen] = tok; nSeen = nSeen + 1; }
                    }
                }
                if (cacheLen >= W) {
                    shiftCache(arena, kcBase, kvD, W, L);
                    cacheLen = W - 1;
                }
                arena[tokOff] = float(tok);
                InferOps.gatherRows(arena, wteOff, tokOff, xOff, V, D, 1);
                int d0 = 0;
                while (d0 < D) {
                    arena[xOff + d0] = arena[xOff + d0] + arena[wpeOff + cacheLen * D + d0];
                    d0 = d0 + 1;
                }
                int li = 0;
                while (li < L) {
                    int base = base0 + li * perLayer;
                    layerDecode(arena, base, cacheLen, xOff, xnOff, qkvOff, attOff, h1Off, h2Off, scOff,
                                kcBase + li * 2 * kvD * W, W, D, H, groups, kvD, 1.0e-5);
                    li = li + 1;
                }
                InferOps.layerNorm(arena, xOff, lnfw, lnfb, xOff, D, 1, 1.0e-5);
                InferOps.matmul(arena, xOff, D, 1, wteOff, V, logOff);
                cacheLen = cacheLen + 1;
                step = step + 1;
            }
            return nGenOut;
        }

        void layerDecode(float[] arena, int base, int cacheLen,
                         int xOff, int xnOff, int qkvOff, int attOff, int h1Off, int h2Off, int scOff,
                         int kcOff, int W, int D, int H, int groups, int kvD, double eps) {
            int ln1w = base; int ln1b = base + 768;
            int cattn_w = base + 1536; int cattn_b = base + 1771008;
            int cproj_w = base + 1773312; int cproj_b = base + 2363136;
            int ln2w = base + 2363904; int ln2b = base + 2364672;
            int cfc_w = base + 2365440; int cfc_b = base + 4724736;
            int mcproj_w = base + 4727808; int mcproj_b = base + 7087104;

            InferOps.layerNorm(arena, xOff, ln1w, ln1b, xnOff, D, 1, eps);
            InferOps.dense(arena, xnOff, D, 1, cattn_w, 3 * D, cattn_b, qkvOff);
            int r = 0;
            while (r < kvD) {
                arena[kcOff + r * W + cacheLen] = arena[qkvOff + D + r];
                arena[kcOff + kvD * W + r * W + cacheLen] = arena[qkvOff + 2 * D + r];
                r = r + 1;
            }
            InferOps.attentionCached(arena, qkvOff, kcOff, kcOff + kvD * W, attOff, scOff,
                                     D, W, cacheLen + 1, H, groups);
            InferOps.dense(arena, attOff, D, 1, cproj_w, D, cproj_b, h2Off);
            InferOps.add(arena, xOff, h2Off, xOff, D, 0);
            InferOps.layerNorm(arena, xOff, ln2w, ln2b, xnOff, D, 1, eps);
            InferOps.dense(arena, xnOff, D, 1, cfc_w, 4 * D, cfc_b, h1Off);
            InferOps.gelu(arena, h1Off, h1Off, 4 * D);
            InferOps.dense(arena, h1Off, 4 * D, 1, mcproj_w, D, mcproj_b, h2Off);
            InferOps.add(arena, xOff, h2Off, xOff, D, 0);
        }

        void shiftCache(float[] arena, int kcBase, int kvD, int W, int L) {
            int li = 0;
            while (li < L) {
                int kc = kcBase + li * 2 * kvD * W;
                int r = 0;
                while (r < 2 * kvD) {
                    int c = 0;
                    while (c < W - 1) {
                        arena[kc + r * W + c] = arena[kc + r * W + c + 1];
                        c = c + 1;
                    }
                    arena[kc + r * W + (W - 1)] = 0.0f;
                    r = r + 1;
                }
                li = li + 1;
            }
        }

        int argmax(float[] arena, int off, int n) {
            int bi = 0;
            double bv = arena[off + 0];
            int i = 1;
            while (i < n) {
                double v = arena[off + i];
                if (v > bv) { bv = v; bi = i; }
                i = i + 1;
            }
            return bi;
        }

        // 温度 + top-k 采样 + 重复惩罚：对 logits 前 topK 个做 softmax（温度缩放）后按概率采样
        // 已出现在 seen 中的 token 其 logits 除以 penRep（>1 压低 → 抑制复读）
        int sampleToken(float[] arena, int logOff, int V, double temp, int topK,
                        int[] seen, int nSeen, double penRep) {
            double[] kv = new double[64];
            int[] ki = new int[64];
            int k = topK;
            if (k > 64) k = 64;
            if (k < 1) k = 1;
            int j = 0;
            while (j < 64) { kv[j] = -1.0e30; ki[j] = 0; j = j + 1; }
            int i = 0;
            while (i < V) {
                double x = double(arena[logOff + i]);
                if (penRep != 1.0 && seenContains(seen, nSeen, i) == 1) x = x / penRep;
                if (x > kv[k - 1]) {
                    int p = k - 2;
                    while (p >= 0 && kv[p] < x) {
                        kv[p + 1] = kv[p];
                        ki[p + 1] = ki[p];
                        p = p - 1;
                    }
                    kv[p + 1] = x;
                    ki[p + 1] = i;
                }
                i = i + 1;
            }
            double[] e = new double[64];
            double sum = 0.0;
            j = 0;
            while (j < k) {
                double v = Math.exp((kv[j] - kv[0]) / temp);
                e[j] = v;
                sum = sum + v;
                j = j + 1;
            }
            double u = Random.uniform() * sum;
            double cum = 0.0;
            j = 0;
            while (j < k) {
                cum = cum + e[j];
                if (cum >= u) return ki[j];
                j = j + 1;
            }
            return ki[0];
        }

        int seenContains(int[] seen, int n, int v) {
            int i = 0;
            while (i < n) {
                if (seen[i] == v) return 1;
                i = i + 1;
            }
            return 0;
        }

        void loadBlock(float[] arena, int fd, int off, int n) {
            int i = 0;
            while (i < n) { arena[off + i] = float(readF32()); i = i + 1; }
        }

        double readF32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) return 0.0;
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }

        int readI32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0) b0 = 0;
            if (b1 < 0) b1 = 0;
            if (b2 < 0) b2 = 0;
            if (b3 < 0) b3 = 0;
            return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
        }
}

int main() {
    Distilgpt2Talk t = new Distilgpt2Talk();
    return 0;
}
