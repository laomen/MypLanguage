// qwen2_forward.myp — 阶段5c5：Qwen2-0.5B-Instruct 真实权重前向装配 + 对拍 transformers
//
// 从 data/llm/qwen2_weights.bin（extract_qwen2.py 导出，1.98GB fp32）装配 24 层
// Qwen2 前向（RMSNorm → q/k/v 投影（带 bias）→ RoPE → GQA attention(14Q/2KV, groups=7)
// → o_proj → 残差 → RMSNorm → SwiGLU MLP(silu(gate·x)·(up·x)→down) → 残差）×24
// + final_norm + lm_head(wte tied)，与 transformers 最后 token logits
// （qwen2_ref_logits.bin）对拍。参考来自 bf16 模型，diff 为量化噪声（argmax 一致即可）。
//
// 运行（须在 examples/ 下；权重 1.98GB 首次加载 ~18s）：
//   deeplearning/infer/tools/onnxvenv/bin/python deeplearning/llm/extract_qwen2.py
//   ./build/mypc examples/deeplearning/llm/qwen2_forward.myp -o /tmp/q2fwd --stdlib stdlib && /tmp/q2fwd

import env;
import fmt;
import text;
import math;
import "../infer/ops.myp";
import "../infer/pb.myp";

class Qwen2Forward {
    action:
        @constructor Qwen2Forward() {
            int V = 151936; int H = 896; int L = 24; int QH = 14; int KVH = 2; int HD = 64;
            int FFN = 4864; int S = 26; int POS = 32768;
            double THETA = 1000000.0; double EPS = 0.000001;
            int H2 = H * H;
            int KV = KVH * HD * H;      // 114688
            int KB = KVH * HD;          // 128
            int F = FFN * H;            // 4358144
            // 布局: ln1,q,qb,k,kb,v,vb,o,ln2,gate,up,down
            int per = H + H2 + H + KV + KB + KV + KB + H2 + H + 3 * F;   // 14912384
            int half = HD / 2;

            int wteOff = 0;
            int base0 = V * H;
            int weightsEnd = base0 + L * per + H;   // + final_norm
            int lnfOff = weightsEnd - H;
            int xOff = weightsEnd;
            int xnOff = xOff + H * S;
            int qOff = xnOff + H * S;
            int kOff = qOff + H * S;
            int vOff = kOff + KV * S;
            int ctxOff = vOff + KV * S;
            int gOff = ctxOff + H * S;
            int uOff = gOff + FFN * S;
            int hOff = uOff + FFN * S;
            int scOff = hOff + H * S;
            int cosOff = scOff + S * S;          // [half, S] 工作表（rope op 用，步长 S）
            int sinOff = cosOff + half * S;
            int fullCosOff = sinOff + half * S;   // 加载的完整表 [half, 4096]
            int fullSinOff = fullCosOff + half * POS;
            int xLastOff = fullSinOff + half * POS;
            int logOff = xLastOff + H;
            int refOff = logOff + V;
            int idOff = refOff + V;
            int CAP = idOff + S;
            float[] arena = new float[CAP];

            // ---- 加载权重（1.98GB）----
            long t0 = __myp_now_ms();
            int fd = __myp_io_fopen("./deeplearning/data/llm/qwen2_weights.bin", "rb");
            if (fd < 0) { Console.writeLine("weights file missing"); return; }
            loadBlock(arena, fd, wteOff, weightsEnd);
            __myp_io_fclose();
            long t1 = __myp_now_ms();
            Console.writeString("weights loaded in ");
            Console.write(t1 - t0);
            Console.writeString("ms");
            Console.writeLine("");

            // ---- 参考 logits + prompt ids ----
            int fd2 = __myp_io_fopen("./deeplearning/data/llm/qwen2_ref_logits.bin", "rb");
            if (fd2 < 0) { Console.writeLine("ref file missing"); return; }
            loadBlock(arena, fd2, refOff, V);
            __myp_io_fclose();
            int[] ids = new int[64];
            int nIds = 0;
            int fd3 = __myp_io_fopen("./deeplearning/data/llm/qwen2_prompt_ids.bin", "rb");
            if (fd3 >= 0) {
                nIds = readI32();
                int p = 0;
                while (p < nIds) { ids[p] = readI32(); p = p + 1; }
                __myp_io_fclose();
            }
            if (nIds != S) { Console.writeString("prompt n=" + Fmt.i(nIds) + " (expect " + Fmt.i(S) + ")"); Console.writeLine(""); return; }

            // ---- RoPE cos/sin 表：从 qwen2_cossin.bin 加载完整表，拷出 [half, S] 工作表 ----
            int fd0 = __myp_io_fopen("./deeplearning/data/llm/qwen2_cossin.bin", "rb");
            if (fd0 < 0) { Console.writeLine("cossin file missing"); return; }
            loadBlock(arena, fd0, fullCosOff, half * POS);
            loadBlock(arena, fd0, fullSinOff, half * POS);
            __myp_io_fclose();
            int a = 0;
            while (a < half) {
                int s = 0;
                while (s < S) {
                    arena[cosOff + a * S + s] = arena[fullCosOff + a * POS + s];
                    arena[sinOff + a * S + s] = arena[fullSinOff + a * POS + s];
                    s = s + 1;
                }
                a = a + 1;
            }

            // ---- prompt token ids → x ----
            int p = 0;
            while (p < S) { arena[idOff + p] = float(ids[p]); p = p + 1; }
            InferOps.gatherRows(arena, wteOff, idOff, xOff, V, H, S);

            // ---- 24 层 ----
            int li = 0;
            while (li < L) {
                int base = base0 + li * per;
                layerForward(arena, base, xOff, xnOff, qOff, kOff, vOff, ctxOff, gOff, uOff, hOff, scOff,
                             cosOff, sinOff, S, H, QH, KVH, HD, FFN, EPS);
                li = li + 1;
            }
            // final_norm + lm_head（最后 token）
            int c = 0;
            while (c < H) { arena[xLastOff + c] = arena[xOff + c * S + (S - 1)]; c = c + 1; }
            InferOps.rmsNorm(arena, xLastOff, lnfOff, xLastOff, H, 1, EPS);
            InferOps.matmul(arena, xLastOff, H, 1, wteOff, V, logOff);

            // ---- 对拍 ----
            double maxAbs = 0.0;
            double maxRel = 0.0;
            int argmaxA = 0; int argmaxB = 0;
            double bv = arena[logOff + 0]; double rv = arena[refOff + 0];
            int i = 1;
            while (i < V) {
                double av = arena[logOff + i]; double r = arena[refOff + i];
                if (av > bv) { bv = av; argmaxA = i; }
                if (r > rv) { rv = r; argmaxB = i; }
                double ad = Math.abs(av - r);
                if (ad > maxAbs) maxAbs = ad;
                double rd = ad / (1.0 + Math.abs(r));
                if (rd > maxRel) maxRel = rd;
                i = i + 1;
            }
            Console.writeString("logits maxAbsDiff=");
            Console.writeFloat(maxAbs);
            Console.writeString("  maxRelDiff=");
            Console.writeFloat(maxRel);
            Console.writeLine("");
            Console.writeString("argmax MYP=");
            Console.write(argmaxA);
            Console.writeString("  ref=");
            Console.write(argmaxB);
            Console.writeLine("");
            // 参考来自 bf16 模型，fp32 前向有量化噪声（maxAbs≈0.26）；argmax 一致即 OK
            if (argmaxA == argmaxB && maxAbs < 1.0) Console.writeLine("QWEN2 FORWARD OK");
            else Console.writeLine("QWEN2 FORWARD FAIL");
        }

        // 一层 Qwen2：RMSNorm → q/k/v(带bias) → RoPE → GQA attention → o_proj → 残差 →
        // RMSNorm → SwiGLU MLP → 残差
        void layerForward(float[] arena, int base, int xOff, int xnOff, int qOff, int kOff, int vOff,
                          int ctxOff, int gOff, int uOff, int hOff, int scOff, int cosOff, int sinOff,
                          int S, int H, int QH, int KVH, int HD, int FFN, double eps) {
            int ln1 = base;
            int q = base + H;
            int qb = base + H + H * H;
            int k = base + H + H * H + H;
            int kb = base + H + H * H + H + KVH * HD * H;
            int v = kb + KVH * HD;
            int vb = v + KVH * HD * H;
            int o = vb + KVH * HD;
            int ln2 = o + H * H;
            int gate = ln2 + H;
            int up = gate + FFN * H;
            int down = up + FFN * H;

            InferOps.rmsNorm(arena, xOff, ln1, xnOff, H, S, eps);
            InferOps.dense(arena, xnOff, H, S, q, H, qb, qOff);
            InferOps.dense(arena, xnOff, H, S, k, KVH * HD, kb, kOff);
            InferOps.dense(arena, xnOff, H, S, v, KVH * HD, vb, vOff);
            // RoPE：q 按 14 头、k 按 2 头逐头旋转
            InferOps.rope(arena, qOff, cosOff, sinOff, H, S, QH);
            InferOps.rope(arena, kOff, cosOff, sinOff, KVH * HD, S, KVH);
            // GQA attention（groups = QH/KVH = 7），因果
            InferOps.attention(arena, qOff, kOff, vOff, ctxOff, scOff, H, S, QH, 1, QH / KVH);
            InferOps.matmul(arena, ctxOff, H, S, o, H, hOff);
            InferOps.add(arena, xOff, hOff, xOff, H * S, 0);
            InferOps.rmsNorm(arena, xOff, ln2, xnOff, H, S, eps);
            // SwiGLU：g=gate·xn, u=up·xn, h=down(silu(g)·u)
            InferOps.matmul(arena, xnOff, H, S, gate, FFN, gOff);
            InferOps.matmul(arena, xnOff, H, S, up, FFN, uOff);
            silu(arena, gOff, gOff, FFN * S);
            mulOp(arena, gOff, uOff, gOff, FFN * S);
            InferOps.matmul(arena, gOff, FFN, S, down, H, hOff);
            InferOps.add(arena, xOff, hOff, xOff, H * S, 0);
        }

        // SiLU(x) = x·sigmoid(x)（SwiGLU gate；本类私有，避免改 ops.myp 触发编译器 bug）
        void silu(float[] arena, int inOff, int outOff, int n) {
            int i = 0;
            while (i < n) {
                double x = double(arena[inOff + i]);
                double e = Math.exp(0.0 - x);
                arena[outOff + i] = float(x / (1.0 + e));
                i = i + 1;
            }
        }

        // 逐元素乘（SwiGLU gate·up）
        void mulOp(float[] arena, int aOff, int bOff, int outOff, int n) {
            int i = 0;
            while (i < n) {
                arena[outOff + i] = arena[aOff + i] * arena[bOff + i];
                i = i + 1;
            }
        }

        void loadBlock(float[] arena, int fd, int off, int n) {
            int i = 0;
            while (i < n) { arena[off + i] = float(readF32()); i = i + 1; }
        }

        double readF32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) return 0.0;
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }

        int readI32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0) b0 = 0;
            if (b1 < 0) b1 = 0;
            if (b2 < 0) b2 = 0;
            if (b3 < 0) b3 = 0;
            return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
        }
}

int main() {
    Qwen2Forward f = new Qwen2Forward();
    return 0;
}
