// gpt_generate.myp — 阶段5b：KV cache 增量 decode（滑动窗口生成） + 正确性对拍
//
// 用与 transformer_smoke 相同的 2 层小 GPT（V=32,D=64,H=4,W=16,ffn=128）演示：
//   1) 逐 token 增量前向（每层 QKV → 追加 K/V 到缓存 → attentionCached → 残差 → FFN）；
//   2) 缓存满 W 时左移（滑动窗口）；argmax 采样继续生成；
//   3) 每一步把「增量 logits」与「整窗重算 forwardFull logits」比对 → 验证 KV cache 正确性。
//
// 正确性判据：增量 decode（用缓存）必须与整窗重算（全序列 attention）逐元素一致。
// 运行（须在 examples/ 下）：
//   ./build/mypc examples/deeplearning/llm/gpt_generate.myp -o /tmp/gpt_gen --stdlib stdlib && /tmp/gpt_gen

import env;
import fmt;
import text;
import math;
import "../infer/ops.myp";
import "../infer/pb.myp";

class GptGenerate {
    action:
        @constructor GptGenerate() {
            int V = 32; int D = 64; int H = 4; int W = 16; int ffn = 128; int L = 2;
            int nPrompt = 6;
            int MAXSTEPS = 18;   // 6 prompt + 12 generated（超 W 触发滑动窗口）
            int groups = 1;      // MHA
            int kvD = D / groups;

            // ---- arena 布局：权重（同 transformer_smoke）+ 单 token 暂存 + 缓存 + 整窗暂存 ----
            int eOff = 0;
            int l0g1 = eOff + V * D;
            int l0qkvw = l0g1 + D;
            int l0qkvb = l0qkvw + 3 * D * D;
            int l0g2 = l0qkvb + 3 * D;
            int l0w1 = l0g2 + D;
            int l0b1 = l0w1 + ffn * D;
            int l0w2 = l0b1 + ffn;
            int l0b2 = l0w2 + D * ffn;
            int l1g1 = l0b2 + D;
            int l1qkvw = l1g1 + D;
            int l1qkvb = l1qkvw + 3 * D * D;
            int l1g2 = l1qkvb + 3 * D;
            int l1w1 = l1g2 + D;
            int l1b1 = l1w1 + ffn * D;
            int l1w2 = l1b1 + ffn;
            int l1b2 = l1w2 + D * ffn;
            int wout = l1b2 + D;
            int bout = wout + V * D;
            int xOff = bout + V;          // [D,1]
            int xnOff = xOff + D;
            int qkvOff = xnOff + D;       // [3D,1]
            int attOff = qkvOff + 3 * D;  // [D,1]
            int h1Off = attOff + D;       // [ffn,1]
            int h2Off = h1Off + ffn;      // [D,1]
            int logOff = h2Off + D;       // [V]
            int scOff = logOff + V;       // [W]
            int kc0Off = scOff + W;       // [kvD,W]
            int vc0Off = kc0Off + kvD * W;
            int kc1Off = vc0Off + kvD * W;
            int vc1Off = kc1Off + kvD * W;
            int fxOff = vc1Off + kvD * W;      // 整窗 x [D,W]
            int fxnOff = fxOff + D * W;
            int fqkvOff = fxnOff + D * W;      // [3D,W]
            int fattOff = fqkvOff + 3 * D * W;
            int fscOff = fattOff + D * W;      // [W,W]
            int fh1Off = fscOff + W * W;       // [ffn,W]
            int fh2Off = fh1Off + ffn * W;     // [D,W]
            int flogOff = fh2Off + D * W;      // [V,W]
            int winOff = flogOff + V * W;      // 当前 token id（1 float）
            int winFOff = winOff + 1;          // 整窗 ids [W]
            int CAP = winFOff + W;
            float[] arena = new float[CAP];

            // ---- 读权重 ----
            int fd = __myp_io_fopen("./deeplearning/data/gpt_smoke_weights.bin", "rb");
            if (fd < 0) { Console.writeLine("weight file missing"); return; }
            loadBlock(arena, fd, eOff, V * D);
            loadBlock(arena, fd, l0g1, D);
            loadBlock(arena, fd, l0qkvw, 3 * D * D);
            loadBlock(arena, fd, l0qkvb, 3 * D);
            loadBlock(arena, fd, l0g2, D);
            loadBlock(arena, fd, l0w1, ffn * D);
            loadBlock(arena, fd, l0b1, ffn);
            loadBlock(arena, fd, l0w2, D * ffn);
            loadBlock(arena, fd, l0b2, D);
            loadBlock(arena, fd, l1g1, D);
            loadBlock(arena, fd, l1qkvw, 3 * D * D);
            loadBlock(arena, fd, l1qkvb, 3 * D);
            loadBlock(arena, fd, l1g2, D);
            loadBlock(arena, fd, l1w1, ffn * D);
            loadBlock(arena, fd, l1b1, ffn);
            loadBlock(arena, fd, l1w2, D * ffn);
            loadBlock(arena, fd, l1b2, D);
            loadBlock(arena, fd, wout, V * D);
            loadBlock(arena, fd, bout, V);
            __myp_io_fclose();

            int[] prompt = new int[6];
            prompt[0] = 1; prompt[1] = 3; prompt[2] = 5; prompt[3] = 7; prompt[4] = 2; prompt[5] = 4;
            float[] winHist = new float[MAXSTEPS];

            // ---- 隔离测试：attentionCached(W=1) vs attention(S=1) 同一份 q/k/v ----
            if (Console.getEnv("MYP_GEN_DBG") == "1") {
                int tq = 62800; int tk = 62900; int tv = 63000; int to1 = 64000; int to2 = 65000; int ts = 66000;
                int t = 0;
                while (t < D) { arena[tq + t] = float(0.3 + 0.01 * t); arena[tk + t] = float(0.2 + 0.02 * t); arena[tv + t] = float(0.1 + 0.03 * t); t = t + 1; }
                InferOps.attention(arena, tq, tk, tv, to1, ts, D, 1, H, 1, 1);
                InferOps.attentionCached(arena, tq, tk, tv, to2, ts, D, 1, 1, H, 1);
                double id = 0.0;
                int it = 0;
                while (it < D) {
                    double iv = Math.abs(double(arena[to1 + it]) - double(arena[to2 + it]));
                    if (iv > id) id = iv;
                    it = it + 1;
                }
                Console.writeString("  isolation attn vs attnCached(W=1) maxd=");
                Console.writeFloat(id);
                Console.writeLine("");
            }

            // ---- 生成主循环（增量 decode + 每步对拍整窗重算）----
            int cacheLen = 0;
            double maxAllDiff = 0.0;
            int worstStep = -1;
            int step = 0;
            int fails = 0;
            while (step < MAXSTEPS) {
                int tok = 0;
                if (step < nPrompt) tok = prompt[step];
                else tok = argmax(arena, logOff, V);   // 采样（argmax）
                winHist[step] = float(tok);

                // 滑动窗口：缓存满 W → 左移丢最旧
                if (cacheLen >= W) {
                    shiftCache(arena, kc0Off, vc0Off, kvD, W);
                    shiftCache(arena, kc1Off, vc1Off, kvD, W);
                    cacheLen = W - 1;
                }

                // 增量 decode 这一步（cacheLen = 追加前长度）
                arena[winOff] = float(tok);
                InferOps.gatherRows(arena, eOff, winOff, xOff, V, D, 1);
                layerDecode(arena, l0g1, l0qkvw, l0qkvb, l0g2, l0w1, l0b1, l0w2, l0b2, kc0Off, vc0Off,
                            cacheLen, xOff, xnOff, qkvOff, attOff, h1Off, h2Off, scOff, D, H, groups, ffn, W, kvD);
                layerDecode(arena, l1g1, l1qkvw, l1qkvb, l1g2, l1w1, l1b1, l1w2, l1b2, kc1Off, vc1Off,
                            cacheLen, xOff, xnOff, qkvOff, attOff, h1Off, h2Off, scOff, D, H, groups, ffn, W, kvD);
                InferOps.dense(arena, xOff, D, 1, wout, V, bout, logOff);
                cacheLen = cacheLen + 1;

                // 对拍：整窗重算（最后 min(step+1, W) 个 token）→ flogOff[V, wN]
                int wStart = step + 1 - W;
                if (wStart < 0) wStart = 0;
                int wN = step + 1 - wStart;
                int c = 0;
                while (c < wN) { arena[winFOff + c] = winHist[wStart + c]; c = c + 1; }
                forwardFull(arena, winFOff, wN, eOff, l0g1, l0qkvw, l0qkvb, l0g2, l0w1, l0b1, l0w2, l0b2,
                            l1g1, l1qkvw, l1qkvb, l1g2, l1w1, l1b1, l1w2, l1b2, wout, bout,
                            fxOff, fxnOff, fqkvOff, fattOff, fscOff, fh1Off, fh2Off, flogOff,
                            V, D, H, ffn, W);

                double d = 0.0;
                int oc = 0;
                while (oc < V) {
                    double v = Math.abs(double(arena[logOff + oc]) - double(arena[flogOff + oc * wN + (wN - 1)]));
                    if (v > d) d = v;
                    oc = oc + 1;
                }
                if (Console.getEnv("MYP_GEN_DBG") == "1" && (step == 0 || step == 1 || step == 2 || step == 15 || step == 16 || step == 17)) {
                    Console.writeString("step " + Fmt.i(step) + " wN=" + Fmt.i(wN) + " maxd=");
                    Console.writeFloat(d);
                    Console.writeLine("");
                    // 比较最终隐藏态 x（增量 xOff vs 整窗 fxOff 末列）
                    double hd = 0.0;
                    int hh = 0;
                    while (hh < D) {
                        double hv = Math.abs(double(arena[xOff + hh]) - double(arena[fxOff + hh * wN + (wN - 1)]));
                        if (hv > hd) hd = hv;
                        hh = hh + 1;
                    }
                    Console.writeString("  hidden x maxd=");
                    Console.writeFloat(hd);
                    Console.writeLine("");
                    Console.writeString("  inc[0..3]=");
                    Console.writeFloat(arena[logOff + 0]);
                    Console.writeString(",");
                    Console.writeFloat(arena[logOff + 1]);
                    Console.writeString(",");
                    Console.writeFloat(arena[logOff + 2]);
                    Console.writeString(",");
                    Console.writeFloat(arena[logOff + 3]);
                    Console.writeLine("");
                    Console.writeString("  full[0..3]=");
                    Console.writeFloat(arena[flogOff + 0 * wN + (wN - 1)]);
                    Console.writeString(",");
                    Console.writeFloat(arena[flogOff + 1 * wN + (wN - 1)]);
                    Console.writeString(",");
                    Console.writeFloat(arena[flogOff + 2 * wN + (wN - 1)]);
                    Console.writeString(",");
                    Console.writeFloat(arena[flogOff + 3 * wN + (wN - 1)]);
                    Console.writeLine("");
                }
                if (d > maxAllDiff) { maxAllDiff = d; worstStep = step; }
                // 缓存填充阶段（step<W）要求增量与整窗重算**精确一致**（maxd≈0，证明 KV cache 正确）；
                // 滑窗阶段（step≥W）是标准滑动窗口近似（丢弃最旧 token 会改变余下 token 的上下文，
                // 属 Mistral 同款设计取舍），只统计、不判失败。
                if (d > 1.0e-3 && step < W) fails = fails + 1;
                // 滑动窗口诊断（step 16）：增量 vs [0..15]窗口 与 [1..16]窗口
                if (Console.getEnv("MYP_GEN_DBG") == "1" && step == 16) {
                    int c0 = 0;
                    while (c0 < W) { arena[winFOff + c0] = winHist[c0]; c0 = c0 + 1; }
                    forwardFull(arena, winFOff, W, eOff, l0g1, l0qkvw, l0qkvb, l0g2, l0w1, l0b1, l0w2, l0b2,
                                l1g1, l1qkvw, l1qkvb, l1g2, l1w1, l1b1, l1w2, l1b2, wout, bout,
                                fxOff, fxnOff, fqkvOff, fattOff, fscOff, fh1Off, fh2Off, flogOff,
                                V, D, H, ffn, W);
                    double dA = 0.0;
                    int oc2 = 0;
                    while (oc2 < V) {
                        double vv = Math.abs(double(arena[logOff + oc2]) - double(arena[flogOff + oc2 * W + (W - 1)]));
                        if (vv > dA) dA = vv;
                        oc2 = oc2 + 1;
                    }
                    int c1 = 0;
                    while (c1 < W) { arena[winFOff + c1] = winHist[c1 + 1]; c1 = c1 + 1; }
                    forwardFull(arena, winFOff, W, eOff, l0g1, l0qkvw, l0qkvb, l0g2, l0w1, l0b1, l0w2, l0b2,
                                l1g1, l1qkvw, l1qkvb, l1g2, l1w1, l1b1, l1w2, l1b2, wout, bout,
                                fxOff, fxnOff, fqkvOff, fattOff, fscOff, fh1Off, fh2Off, flogOff,
                                V, D, H, ffn, W);
                    double dB = 0.0;
                    oc2 = 0;
                    while (oc2 < V) {
                        double vv = Math.abs(double(arena[logOff + oc2]) - double(arena[flogOff + oc2 * W + (W - 1)]));
                        if (vv > dB) dB = vv;
                        oc2 = oc2 + 1;
                    }
                    Console.writeString("  step16: vs[0..15]=");
                    Console.writeFloat(dA);
                    Console.writeString(" vs[1..16]=");
                    Console.writeFloat(dB);
                    Console.writeLine("");
                }
                step = step + 1;
            }

            Console.writeString("max logits diff (incremental vs full-seq) = ");
            Console.writeFloat(maxAllDiff);
            Console.writeString(" at step ");
            Console.write(worstStep);
            Console.writeLine("");
            Console.writeString("generated tokens: ");
            int g = 0;
            while (g < MAXSTEPS) {
                Console.write(int(winHist[g]));
                Console.writeString(" ");
                g = g + 1;
            }
            Console.writeLine("");
            if (fails == 0) Console.writeLine("GPT GENERATE OK");
            else Console.writeLine("GPT GENERATE FAIL (" + Fmt.i(fails) + " steps)");
        }

        // 单层增量 decode：xOff 为当前 token 的隐藏态 [D,1]（就地更新）；缓存列 cacheLen 追加 k/v
        void layerDecode(float[] arena, int g1, int qkvw, int qkvb, int g2, int w1, int b1, int w2, int b2,
                         int kcOff, int vcOff, int cacheLen,
                         int xOff, int xnOff, int qkvOff, int attOff, int h1Off, int h2Off, int scOff,
                         int D, int H, int groups, int ffn, int W, int kvD) {
            InferOps.rmsNorm(arena, xOff, g1, xnOff, D, 1, 1.0e-6);
            InferOps.dense(arena, xnOff, D, 1, qkvw, 3 * D, qkvb, qkvOff);
            // 追加 k/v（k 在 qkv 行 [D,2D)，v 在 [2D,3D)）到缓存列 cacheLen
            int r = 0;
            while (r < kvD) { arena[kcOff + r * W + cacheLen] = arena[qkvOff + D + r]; r = r + 1; }
            r = 0;
            while (r < kvD) { arena[vcOff + r * W + cacheLen] = arena[qkvOff + 2 * D + r]; r = r + 1; }
            InferOps.attentionCached(arena, qkvOff, kcOff, vcOff, attOff, scOff, D, W, cacheLen + 1, H, groups);
            InferOps.add(arena, xOff, attOff, xOff, D, 0);
            InferOps.rmsNorm(arena, xOff, g2, xnOff, D, 1, 1.0e-6);
            InferOps.dense(arena, xnOff, D, 1, w1, ffn, b1, h1Off);
            InferOps.silu(arena, h1Off, h1Off, ffn);
            InferOps.dense(arena, h1Off, ffn, 1, w2, D, b2, h2Off);
            InferOps.add(arena, xOff, h2Off, xOff, D, 0);
        }

        // 缓存左移（滑动窗口）：列 1..W-1 → 0..W-2（丢最旧），末列清 0
        void shiftCache(float[] arena, int kcOff, int vcOff, int kvD, int W) {
            int r = 0;
            while (r < kvD) {
                int c = 0;
                while (c < W - 1) {
                    arena[kcOff + r * W + c] = arena[kcOff + r * W + c + 1];
                    arena[vcOff + r * W + c] = arena[vcOff + r * W + c + 1];
                    c = c + 1;
                }
                arena[kcOff + r * W + (W - 1)] = 0.0f;
                arena[vcOff + r * W + (W - 1)] = 0.0f;
                r = r + 1;
            }
        }

        // 整窗重算（全序列 attention，因果）：winFOff 存 wN 个 token id → flogOff [V, wN]
        void forwardFull(float[] arena, int winFOff, int wN,
                         int eOff, int l0g1, int l0qkvw, int l0qkvb, int l0g2, int l0w1, int l0b1, int l0w2, int l0b2,
                         int l1g1, int l1qkvw, int l1qkvb, int l1g2, int l1w1, int l1b1, int l1w2, int l1b2,
                         int wout, int bout, int fxOff, int fxnOff, int fqkvOff, int fattOff, int fscOff,
                         int fh1Off, int fh2Off, int flogOff, int V, int D, int H, int ffn, int W) {
            InferOps.gatherRows(arena, eOff, winFOff, fxOff, V, D, wN);
            layerFull(arena, l0g1, l0qkvw, l0qkvb, l0g2, l0w1, l0b1, l0w2, l0b2,
                      fxOff, fxnOff, fqkvOff, fattOff, fscOff, fh1Off, fh2Off, D, wN, H, ffn);
            layerFull(arena, l1g1, l1qkvw, l1qkvb, l1g2, l1w1, l1b1, l1w2, l1b2,
                      fxOff, fxnOff, fqkvOff, fattOff, fscOff, fh1Off, fh2Off, D, wN, H, ffn);
            InferOps.dense(arena, fxOff, D, wN, wout, V, bout, flogOff);
        }

        void layerFull(float[] arena, int g1, int qkvw, int qkvb, int g2, int w1, int b1, int w2, int b2,
                       int xOff, int xnOff, int qkvOff, int attOff, int scOff, int h1Off, int h2Off,
                       int D, int S, int H, int ffn) {
            InferOps.rmsNorm(arena, xOff, g1, xnOff, D, S, 1.0e-6);
            InferOps.dense(arena, xnOff, D, S, qkvw, 3 * D, qkvb, qkvOff);
            InferOps.attention(arena, qkvOff, qkvOff + D * S, qkvOff + 2 * D * S, attOff, scOff, D, S, H, 1, 1);
            InferOps.add(arena, xOff, attOff, xOff, D * S, 0);
            InferOps.rmsNorm(arena, xOff, g2, xnOff, D, S, 1.0e-6);
            InferOps.dense(arena, xnOff, D, S, w1, ffn, b1, h1Off);
            InferOps.silu(arena, h1Off, h1Off, ffn * S);
            InferOps.dense(arena, h1Off, ffn, S, w2, D, b2, h2Off);
            InferOps.add(arena, xOff, h2Off, xOff, D * S, 0);
        }

        int argmax(float[] arena, int off, int n) {
            int bi = 0;
            double bv = arena[off + 0];
            int i = 1;
            while (i < n) {
                double v = arena[off + i];
                if (v > bv) { bv = v; bi = i; }
                i = i + 1;
            }
            return bi;
        }

        void loadBlock(float[] arena, int fd, int off, int n) {
            int i = 0;
            while (i < n) { arena[off + i] = float(readF32()); i = i + 1; }
        }

        double readF32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) return 0.0;
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }
}

int main() {
    GptGenerate g = new GptGenerate();
    return 0;
}
