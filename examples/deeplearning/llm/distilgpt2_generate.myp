// distilgpt2_generate.myp — 阶段5c：distilgpt2 真实文本生成（KV cache 增量 decode + BPE 解码）
//
// 流程：
//   1) 读 data/llm/distilgpt2_weights.bin（328MB，含 ln_f，extract_distilgpt2.py 导出）；
//   2) 读 prompt ids（data/llm/distilgpt2_prompt_ids.bin，prep_distilgpt2_gen.py 用
//      GPT2Tokenizer 编码）；
//   3) KV cache 增量 decode（GPT-2：LayerNorm+GELU，wte+wpe，最终 ln_f，MHA 12 头，
//      argmax 采样）生成 GENERATE 个 token；
//   4) 与 transformers 贪心参考（distilgpt2_ref_gen_ids.bin）对拍；
//   5) 用 vocab 查表（distilgpt2_vocab_offs.bin + vocab_data.bin，字节级解码）把
//      prompt+生成 完整文本写到 stdout。
//
// 运行（须在 examples/ 下；权重 328MB 加载 ~3s）：
//   deeplearning/infer/tools/onnxvenv/bin/python deeplearning/llm/prep_distilgpt2_gen.py
//   ./build/mypc examples/deeplearning/llm/distilgpt2_generate.myp -o /tmp/dgpt_gen --stdlib stdlib && /tmp/dgpt_gen

import env;
import fmt;
import text;
import math;
import "../infer/ops.myp";
import "../infer/pb.myp";

class Distilgpt2Generate {
    action:
        @constructor Distilgpt2Generate() {
            int V = 50257; int D = 768; int L = 6; int H = 12; int POS = 1024;
            int W = 128; int groups = 1; int kvD = D / groups;
            int GENERATE = 32;
            int perLayer = 7087872;

            // ---- arena：权重 + 单 token 暂存 + 每层 KV cache ----
            int wteOff = 0;
            int wpeOff = wteOff + V * D;
            int base0 = wpeOff + POS * D;
            int weightsEnd = base0 + L * perLayer + 1536;   // 81,912,576
            int lnfw = weightsEnd - 1536;
            int lnfb = lnfw + 768;
            int tokOff = weightsEnd;          // 1 float：当前 token id（gatherRows 输入）
            int xOff = tokOff + 1;            // [D,1]
            int xnOff = xOff + D;
            int qkvOff = xnOff + D;           // [3D,1]
            int attOff = qkvOff + 3 * D;      // [D,1]
            int h1Off = attOff + D;           // [4D,1]
            int h2Off = h1Off + 4 * D;        // [D,1]
            int scOff = h2Off + D;            // [W] attention 分数
            int logOff = scOff + W;           // [V]
            int kcBase = logOff + V;          // 每层 [kvD,W] K + [kvD,W] V
            int CAP = kcBase + L * 2 * kvD * W;
            float[] arena = new float[CAP];

            // ---- 加载权重（全部，含 ln_f）----
            int fd = __myp_io_fopen("./deeplearning/data/llm/distilgpt2_weights.bin", "rb");
            if (fd < 0) { Console.writeLine("weights file missing"); return; }
            loadBlock(arena, fd, wteOff, weightsEnd);
            __myp_io_fclose();

            // ---- 生成配置（int32：生成 token 数；缺省 32）----
            int fdCfg = __myp_io_fopen("./deeplearning/data/llm/distilgpt2_gen_cfg.bin", "rb");
            if (fdCfg >= 0) { GENERATE = readI32(); __myp_io_fclose(); }

            // ---- prompt ids（int32 count + ids）----
            int[] prompt = new int[64];
            int nPrompt = 0;
            int fd2 = __myp_io_fopen("./deeplearning/data/llm/distilgpt2_prompt_ids.bin", "rb");
            if (fd2 < 0) { Console.writeLine("prompt file missing"); return; }
            nPrompt = readI32();
            int pi = 0;
            while (pi < nPrompt) { prompt[pi] = readI32(); pi = pi + 1; }
            __myp_io_fclose();

            // ---- vocab 查表：offs（V+1 个 int32）+ 字节数据 ----
            int[] vocabOff = new int[V + 1];
            int fd3 = __myp_io_fopen("./deeplearning/data/llm/distilgpt2_vocab_offs.bin", "rb");
            if (fd3 < 0) { Console.writeLine("vocab offs missing"); return; }
            int vi = 0;
            while (vi <= V) { vocabOff[vi] = readI32(); vi = vi + 1; }
            __myp_io_fclose();
            int[] vocabData = new int[400000];
            int vocabLen = 0;
            int fd4 = __myp_io_fopen("./deeplearning/data/llm/distilgpt2_vocab_data.bin", "rb");
            if (fd4 < 0) { Console.writeLine("vocab data missing"); return; }
            int vb = __myp_io_read_byte();
            while (vb >= 0) { vocabData[vocabLen] = vb; vocabLen = vocabLen + 1; vb = __myp_io_read_byte(); }
            __myp_io_fclose();
            if (Console.getEnv("MYP_DG2_DBG") == "1") {
                Console.writeString("  vocabLen=");
                Console.write(vocabLen);
                Console.writeString("  offs[0]=" + Fmt.i(vocabOff[0]) + " offs[1]=" + Fmt.i(vocabOff[1]));
                Console.writeString("  offs[7454]=" + Fmt.i(vocabOff[7454]) + " offs[7455]=" + Fmt.i(vocabOff[7455]));
                Console.writeLine("");
            }

            // ---- transformers 贪心参考 ids（可选；缺文件则跳过对拍）----
            int[] refIds = new int[GENERATE + 64];
            int nRef = 0;
            int fd5 = __myp_io_fopen("./deeplearning/data/llm/distilgpt2_ref_gen_ids.bin", "rb");
            if (fd5 >= 0) {
                nRef = readI32();
                int ri = 0;
                while (ri < nRef) { refIds[ri] = readI32(); ri = ri + 1; }
                __myp_io_fclose();
            }

            // ---- 生成循环 ----
            int[] winHist = new int[GENERATE + 64];
            int cacheLen = 0;
            int total = nPrompt + GENERATE;
            int step = 0;
            while (step < total) {
                int tok = 0;
                if (step < nPrompt) tok = prompt[step];
                else tok = argmax(arena, logOff, V);
                winHist[step] = tok;

                // 滑窗（本 demo total=36 << W=128，不会触发；保留通用性）
                if (cacheLen >= W) {
                    shiftCache(arena, kcBase, kvD, W, L);
                    cacheLen = W - 1;
                }

                // embed：x = wte[tok] + wpe[cacheLen]（cacheLen = 窗口内位置）
                arena[tokOff] = float(tok);
                InferOps.gatherRows(arena, wteOff, tokOff, xOff, V, D, 1);
                int d0 = 0;
                while (d0 < D) {
                    arena[xOff + d0] = arena[xOff + d0] + arena[wpeOff + cacheLen * D + d0];
                    d0 = d0 + 1;
                }
                if (Console.getEnv("MYP_DG2_DBG") == "1" && step == 0) {
                    Console.writeString("  emb x[0..5]=");
                    int de = 0;
                    while (de < 6) { Console.writeFloat(arena[xOff + de]); de = de + 1; }
                    Console.writeLine("");
                    Console.writeString("  emb x[760..767]=");
                    de = 760;
                    while (de < 768) { Console.writeFloat(arena[xOff + de]); de = de + 1; }
                    Console.writeLine("");
                }

                // 6 层
                int li = 0;
                while (li < L) {
                    int base = base0 + li * perLayer;
                    layerDecode(arena, base, cacheLen, xOff, xnOff, qkvOff, attOff, h1Off, h2Off, scOff,
                                kcBase + li * 2 * kvD * W, W, D, H, groups, kvD, 1.0e-5);
                    if (Console.getEnv("MYP_DG2_DBG") == "1" && step == 0) {
                        Console.writeString("  after layer " + Fmt.i(li) + " x[0..5]=");
                        int da = 0;
                        while (da < 6) { Console.writeFloat(arena[xOff + da]); da = da + 1; }
                        Console.writeLine("");
                    }
                    li = li + 1;
                }

                // 最终 ln_f + lm_head（wte tied）
                InferOps.layerNorm(arena, xOff, lnfw, lnfb, xOff, D, 1, 1.0e-5);
                InferOps.matmul(arena, xOff, D, 1, wteOff, V, logOff);
                cacheLen = cacheLen + 1;

                if (Console.getEnv("MYP_DG2_DBG") == "1") {
                    Console.writeString("step " + Fmt.i(step) + " tok=" + Fmt.i(tok) + " argmax=" + Fmt.i(argmax(arena, logOff, V)));
                    Console.writeString("  lg[0..5]=");
                    int dk = 0;
                    while (dk < 6) { Console.writeFloat(arena[logOff + dk]); Console.writeString(" "); dk = dk + 1; }
                    Console.writeLine("");
                }

                step = step + 1;
            }

            // ---- 对拍 transformers（有参考时）----
            if (nRef > 0) {
                int bad = 0;
                int ck = 0;
                while (ck < nRef) {
                    if (winHist[ck] != refIds[ck]) bad = bad + 1;
                    ck = ck + 1;
                }
                Console.writeString("token mismatch vs transformers: ");
                Console.write(bad);
                Console.writeLine("");
                if (bad == 0) Console.writeLine("DISTILGPT2 GENERATE OK");
                else Console.writeLine("DISTILGPT2 GENERATE FAIL");
            } else {
                Console.writeLine("DISTILGPT2 GENERATE DONE (no reference)");
            }
            if (Console.getEnv("MYP_DG2_DBG") == "1") {
                Console.writeString("prompt ids:");
                int p2 = 0;
                while (p2 < nPrompt) { Console.writeString(" " + Fmt.i(prompt[p2])); p2 = p2 + 1; }
                Console.writeLine("");
                Console.writeString("generated ids:");
                int g2 = nPrompt;
                while (g2 < total) { Console.writeString(" " + Fmt.i(winHist[g2])); g2 = g2 + 1; }
                Console.writeLine("");
            }

            // ---- 解码输出完整文本（prompt + 生成）：先算总字节，再 ubyte[] → str() ----
            Console.writeString("==== generated text ====");
            Console.writeLine("");
            int totBytes = 0;
            int t2 = 0;
            while (t2 < total) {
                totBytes = totBytes + (vocabOff[winHist[t2] + 1] - vocabOff[winHist[t2]]);
                t2 = t2 + 1;
            }
            ubyte[] outBytes = new ubyte[totBytes];
            int oi = 0;
            t2 = 0;
            while (t2 < total) {
                int a = vocabOff[winHist[t2]];
                int b = vocabOff[winHist[t2] + 1];
                int j = a;
                while (j < b) {
                    outBytes[oi] = ubyte(vocabData[j]);
                    oi = oi + 1;
                    j = j + 1;
                }
                t2 = t2 + 1;
            }
            Console.writeString(str(outBytes));
            Console.writeLine("");
        }

        // GPT-2 单层增量 decode：xOff=[D,1] 就地更新；把 qkv 的 k/v 追加到缓存列 cacheLen
        void layerDecode(float[] arena, int base, int cacheLen,
                         int xOff, int xnOff, int qkvOff, int attOff, int h1Off, int h2Off, int scOff,
                         int kcOff, int W, int D, int H, int groups, int kvD, double eps) {
            int ln1w = base; int ln1b = base + 768;
            int cattn_w = base + 1536; int cattn_b = base + 1771008;
            int cproj_w = base + 1773312; int cproj_b = base + 2363136;
            int ln2w = base + 2363904; int ln2b = base + 2364672;
            int cfc_w = base + 2365440; int cfc_b = base + 4724736;
            int mcproj_w = base + 4727808; int mcproj_b = base + 7087104;

            InferOps.layerNorm(arena, xOff, ln1w, ln1b, xnOff, D, 1, eps);
            InferOps.dense(arena, xnOff, D, 1, cattn_w, 3 * D, cattn_b, qkvOff);
            int r = 0;
            while (r < kvD) {
                arena[kcOff + r * W + cacheLen] = arena[qkvOff + D + r];       // K 块
                arena[kcOff + kvD * W + r * W + cacheLen] = arena[qkvOff + 2 * D + r];  // V 块
                r = r + 1;
            }
            InferOps.attentionCached(arena, qkvOff, kcOff, kcOff + kvD * W, attOff, scOff,
                                     D, W, cacheLen + 1, H, groups);
            InferOps.dense(arena, attOff, D, 1, cproj_w, D, cproj_b, h2Off);
            InferOps.add(arena, xOff, h2Off, xOff, D, 0);
            if (Console.getEnv("MYP_DG2_DBG") == "1") {
                Console.writeString("    after attn-add x[0]=");
                Console.writeFloat(arena[xOff + 0]);
                Console.writeLine("");
            }
            InferOps.layerNorm(arena, xOff, ln2w, ln2b, xnOff, D, 1, eps);
            InferOps.dense(arena, xnOff, D, 1, cfc_w, 4 * D, cfc_b, h1Off);
            InferOps.gelu(arena, h1Off, h1Off, 4 * D);
            InferOps.dense(arena, h1Off, 4 * D, 1, mcproj_w, D, mcproj_b, h2Off);
            if (Console.getEnv("MYP_DG2_DBG") == "1") {
                Console.writeString("    post-mlp h2[0..5]=");
                int dc2 = 0;
                while (dc2 < 6) { Console.writeFloat(arena[h2Off + dc2]); dc2 = dc2 + 1; }
                Console.writeLine("");
            }
            InferOps.add(arena, xOff, h2Off, xOff, D, 0);
        }

        // 全部 6 层缓存左移一列（丢最旧）；k/v 共 2*kvD 行
        void shiftCache(float[] arena, int kcBase, int kvD, int W, int L) {
            int li = 0;
            while (li < L) {
                int kc = kcBase + li * 2 * kvD * W;
                int r = 0;
                while (r < 2 * kvD) {
                    int c = 0;
                    while (c < W - 1) {
                        arena[kc + r * W + c] = arena[kc + r * W + c + 1];
                        c = c + 1;
                    }
                    arena[kc + r * W + (W - 1)] = 0.0f;
                    r = r + 1;
                }
                li = li + 1;
            }
        }

        int argmax(float[] arena, int off, int n) {
            int bi = 0;
            double bv = arena[off + 0];
            int i = 1;
            while (i < n) {
                double v = arena[off + i];
                if (v > bv) { bv = v; bi = i; }
                i = i + 1;
            }
            return bi;
        }

        void loadBlock(float[] arena, int fd, int off, int n) {
            int i = 0;
            while (i < n) { arena[off + i] = float(readF32()); i = i + 1; }
        }

        double readF32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) return 0.0;
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }

        int readI32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0) b0 = 0;
            if (b1 < 0) b1 = 0;
            if (b2 < 0) b2 = 0;
            if (b3 < 0) b3 = 0;
            return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
        }
}

int main() {
    Distilgpt2Generate g = new Distilgpt2Generate();
    return 0;
}
