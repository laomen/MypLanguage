// bpe.myp — GPT-2 ByteLevel BPE 编码器（文本 → token id），纯 MYP 实现
//
// 三阶段（与 make_bpe_tables.py 的 Python 原型一致，已对拍 transformers）：
//   1) 字节编码：每字节 → 码点（bytes_to_unicode；空格 0x20 → 0x120 'Ġ' 等）。
//   2) 预分词：ASCII 等价扫描器复现 GPT-2 正则
//      's|'t|'re|'ve|'m|'ll|'d| ?\p{L}+| ?\p{N}+| ?[^\s\p{L}\p{N}]+|\s+(?!\S)|\s+
//      （Python re 的交替是「第一个匹配的替代」获胜，不是最长；if/elif 链复现）。
//   3) BPE 合并：反复合并 rank 最低的相邻 piece（merges 哈希表），查 vocab 得 id。
//
// 表（data/llm/，由 make_bpe_tables.py 生成，开放寻址 T=2^17，FNV-1a 哈希）：
//   bpe_merges_hash.bin / bpe_merges_rank.bin / bpe_merges_data.bin / bpe_merges_offs.bin
//   bpe_vocab_hash.bin  / bpe_vocab_id.bin    / bpe_vocab_data.bin  / bpe_vocab_offs.bin
// key 表示：每个码点 int16 LE 2 字节；merge pair = pack(A) + 0xFFFF + pack(B)。
//
// 用法：Bpe b = new Bpe(); b.load(); int n = b.encode(text, start, nBytes, outIds);
// 数据路径相对 examples/（./deeplearning/data/llm/...）。

import env;
import math;

class Bpe {
    action:
        @constructor Bpe() {
        }

        // ---- 加载表（须在 examples/ 下）----
        int load() {
            // 字节 → 码点（bytes_to_unicode 算法）
            int n = 0;
            int b = 0;
            while (b < 256) {
                int self = 0;
                if (b >= 33 && b <= 126) self = 1;
                if (b >= 161 && b <= 172) self = 1;
                if (b >= 174 && b <= 255) self = 1;
                if (self == 1) b2c_[b] = b;
                else { b2c_[b] = 256 + n; n = n + 1; }
                b = b + 1;
            }
            int fd = __myp_io_fopen("./deeplearning/data/llm/bpe_merges_hash.bin", "rb");
            if (fd < 0) { Console.writeLine("bpe_merges_hash.bin missing"); return -1; }
            int i = 0;
            while (i < T) { mergesHash_[i] = readI32(); i = i + 1; }
            __myp_io_fclose();
            fd = __myp_io_fopen("./deeplearning/data/llm/bpe_merges_rank.bin", "rb");
            if (fd < 0) return -1;
            i = 0;
            while (i < T) { mergesRank_[i] = readI32(); i = i + 1; }
            __myp_io_fclose();
            fd = __myp_io_fopen("./deeplearning/data/llm/bpe_merges_offs.bin", "rb");
            if (fd < 0) return -1;
            i = 0;
            while (i <= 50000) { mergesOffs_[i] = readI32(); i = i + 1; }
            __myp_io_fclose();
            fd = __myp_io_fopen("./deeplearning/data/llm/bpe_merges_data.bin", "rb");
            if (fd < 0) return -1;
            int v = __myp_io_read_byte();
            mergesDataLen_ = 0;
            while (v >= 0) { mergesData_[mergesDataLen_] = v; mergesDataLen_ = mergesDataLen_ + 1; v = __myp_io_read_byte(); }
            __myp_io_fclose();

            fd = __myp_io_fopen("./deeplearning/data/llm/bpe_vocab_hash.bin", "rb");
            if (fd < 0) return -1;
            i = 0;
            while (i < T) { vocabHash_[i] = readI32(); i = i + 1; }
            __myp_io_fclose();
            fd = __myp_io_fopen("./deeplearning/data/llm/bpe_vocab_id.bin", "rb");
            if (fd < 0) return -1;
            i = 0;
            while (i < T) { vocabId_[i] = readI32(); i = i + 1; }
            __myp_io_fclose();
            fd = __myp_io_fopen("./deeplearning/data/llm/bpe_vocab_offs.bin", "rb");
            if (fd < 0) return -1;
            i = 0;
            while (i <= 50257) { vocabOffs_[i] = readI32(); i = i + 1; }
            __myp_io_fclose();
            fd = __myp_io_fopen("./deeplearning/data/llm/bpe_vocab_data.bin", "rb");
            if (fd < 0) return -1;
            v = __myp_io_read_byte();
            vocabDataLen_ = 0;
            while (v >= 0) { vocabData_[vocabDataLen_] = v; vocabDataLen_ = vocabDataLen_ + 1; v = __myp_io_read_byte(); }
            __myp_io_fclose();
            return 0;
        }

        // ---- 字符类别（ASCII 等价）----
        int isLetter(int c) { return ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) ? 1 : 0; }
        int isDigit(int c) { return (c >= 48 && c <= 57) ? 1 : 0; }
        int isSpace(int c) { return (c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13) ? 1 : 0; }
        int isOther(int c) { return (isLetter(c) == 0 && isDigit(c) == 0 && isSpace(c) == 0) ? 1 : 0; }

        // ---- 预分词：复现 GPT-2 正则（ASCII；第一个匹配的替代获胜）----
        int nextTokenLen(int[] text, int n, int i) {
            if (text[i] == 39) {
                if (i + 1 < n && text[i + 1] == 115) return 2;   // 's
                if (i + 1 < n && text[i + 1] == 116) return 2;   // 't
                if (i + 2 < n && text[i + 1] == 114 && text[i + 2] == 101) return 3;  // 're
                if (i + 2 < n && text[i + 1] == 118 && text[i + 2] == 101) return 3;  // 've
                if (i + 1 < n && text[i + 1] == 109) return 2;   // 'm
                if (i + 2 < n && text[i + 1] == 108 && text[i + 2] == 108) return 3;  // 'll
                if (i + 1 < n && text[i + 1] == 100) return 2;   // 'd
            }
            // ?\p{L}+
            if (isLetter(text[i]) == 1) {
                int k = i;
                while (k < n && isLetter(text[k]) == 1) { k = k + 1; }
                return k - i;
            }
            if (i + 1 < n && text[i] == 32 && isLetter(text[i + 1]) == 1) {
                int k = i + 1;
                while (k < n && isLetter(text[k]) == 1) { k = k + 1; }
                return k - i;
            }
            // ?\p{N}+
            if (isDigit(text[i]) == 1) {
                int k = i;
                while (k < n && isDigit(text[k]) == 1) { k = k + 1; }
                return k - i;
            }
            if (i + 1 < n && text[i] == 32 && isDigit(text[i + 1]) == 1) {
                int k = i + 1;
                while (k < n && isDigit(text[k]) == 1) { k = k + 1; }
                return k - i;
            }
            // ?[^\s\p{L}\p{N}]+
            if (isOther(text[i]) == 1) {
                int k = i;
                while (k < n && isOther(text[k]) == 1) { k = k + 1; }
                return k - i;
            }
            if (i + 1 < n && text[i] == 32 && isOther(text[i + 1]) == 1) {
                int k = i + 1;
                while (k < n && isOther(text[k]) == 1) { k = k + 1; }
                return k - i;
            }
            // \s+(?!\S) 或 \s+：连续空白
            if (isSpace(text[i]) == 1) {
                int k = i;
                while (k < n && isSpace(text[k]) == 1) { k = k + 1; }
                return k - i;
            }
            return 1;
        }

        // ---- FNV-1a（复现 Python；码点按 int16 LE 两字节喂入）----
        long fnvFrom(int[] codes, int c0, int cn, long h) {
            int i = c0;
            while (i < c0 + cn) {
                int c = codes[i];
                h = ((h ^ long(c & 255)) * 16777619L) & 4294967295L;
                h = ((h ^ long((c >> 8) & 255)) * 16777619L) & 4294967295L;
                i = i + 1;
            }
            return h;
        }
        long fnvCodes(int[] codes, int c0, int cn) { return fnvFrom(codes, c0, cn, 0x811C9DC5L); }

        // ---- merges pair rank 查找（-1 不存在）----
        int pairRank(int[] pa, int a0, int an, int[] pb, int b0, int bn) {
            long h = fnvCodes(pa, a0, an);
            h = ((h ^ 255L) * 16777619L) & 4294967295L;   // 0xFFFF 的 int16 LE = 0xFF 0xFF
            h = ((h ^ 255L) * 16777619L) & 4294967295L;
            h = fnvFrom(pb, b0, bn, h);
            int hv = int(h & 2147483647L);
            int slot = hv % T;
            int guard = 0;
            while (guard < T) {
                int hv2 = mergesHash_[slot];
                if (hv2 == -1) return -1;
                if (hv2 == hv) {
                    int rank = mergesRank_[slot];
                    if (rank >= 0) {
                        int lo = mergesOffs_[rank];
                        int hi = mergesOffs_[rank + 1];
                        if (keyEqPair(pa, a0, an, pb, b0, bn, lo, hi - lo) == 1) return rank;
                    }
                }
                slot = slot + 1;
                if (slot >= T) slot = 0;
                guard = guard + 1;
            }
            return -1;
        }

        int keyEqPair(int[] pa, int a0, int an, int[] pb, int b0, int bn, int lo, int plen) {
            if (plen != 2 * (an + 1 + bn)) return 0;
            int pos = 0;
            int i = 0;
            while (i < an) {
                int c = pa[a0 + i];
                if (mergesData_[lo + pos] != (c & 255)) return 0;
                if (mergesData_[lo + pos + 1] != ((c >> 8) & 255)) return 0;
                pos = pos + 2;
                i = i + 1;
            }
            if (mergesData_[lo + pos] != 255 || mergesData_[lo + pos + 1] != 255) return 0;
            pos = pos + 2;
            i = 0;
            while (i < bn) {
                int c = pb[b0 + i];
                if (mergesData_[lo + pos] != (c & 255)) return 0;
                if (mergesData_[lo + pos + 1] != ((c >> 8) & 255)) return 0;
                pos = pos + 2;
                i = i + 1;
            }
            return 1;
        }

        // ---- vocab id 查找（-1 不存在）----
        int vocabLookup(int[] codes, int c0, int cn) {
            long h = fnvCodes(codes, c0, cn);
            int hv = int(h & 2147483647L);
            int slot = hv % T;
            int guard = 0;
            while (guard < T) {
                int hv2 = vocabHash_[slot];
                if (hv2 == -1) return -1;
                if (hv2 == hv) {
                    int id = vocabId_[slot];
                    if (id >= 0) {
                        int lo = vocabOffs_[id];
                        int hi = vocabOffs_[id + 1];
                        if (keyEqVocab(codes, c0, cn, lo, hi - lo) == 1) return id;
                    }
                }
                slot = slot + 1;
                if (slot >= T) slot = 0;
                guard = guard + 1;
            }
            return -1;
        }

        int keyEqVocab(int[] codes, int c0, int cn, int lo, int plen) {
            if (plen != 2 * cn) return 0;
            int i = 0;
            while (i < cn) {
                int c = codes[c0 + i];
                if (vocabData_[lo + 2 * i] != (c & 255)) return 0;
                if (vocabData_[lo + 2 * i + 1] != ((c >> 8) & 255)) return 0;
                i = i + 1;
            }
            return 1;
        }

        // ---- 编码主入口：text 字节数组（从 start 起 n 字节）→ out token ids；返回 id 数 ----
        int encode(int[] text, int start, int n, int[] out) {
            int[] codes = new int[n + 16];
            int[] pStart = new int[n + 16];
            int[] pLen = new int[n + 16];
            int nOut = 0;
            int i = start;
            int end = start + n;
            while (i < end) {
                int tl = nextTokenLen(text, end, i);
                int nCodes = 0;
                int j = i;
                while (j < i + tl) {
                    codes[nCodes] = b2c_[text[j]];
                    nCodes = nCodes + 1;
                    j = j + 1;
                }
                int np = nCodes;
                int k = 0;
                while (k < np) { pStart[k] = k; pLen[k] = 1; k = k + 1; }
                while (np > 1) {
                    int bestRank = 2000000000;
                    int bestJ = -1;
                    int k2 = 0;
                    while (k2 < np - 1) {
                        int r = pairRank(codes, pStart[k2], pLen[k2], codes, pStart[k2 + 1], pLen[k2 + 1]);
                        if (r >= 0 && r < bestRank) { bestRank = r; bestJ = k2; }
                        k2 = k2 + 1;
                    }
                    if (bestJ < 0) break;
                    pLen[bestJ] = pLen[bestJ] + pLen[bestJ + 1];
                    int k3 = bestJ + 1;
                    while (k3 < np - 1) {
                        pStart[k3] = pStart[k3 + 1];
                        pLen[k3] = pLen[k3 + 1];
                        k3 = k3 + 1;
                    }
                    np = np - 1;
                }
                int k4 = 0;
                while (k4 < np) {
                    int id = vocabLookup(codes, pStart[k4], pLen[k4]);
                    if (id >= 0) { out[nOut] = id; nOut = nOut + 1; }
                    k4 = k4 + 1;
                }
                i = i + tl;
            }
            return nOut;
        }

        int readI32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0) b0 = 0;
            if (b1 < 0) b1 = 0;
            if (b2 < 0) b2 = 0;
            if (b3 < 0) b3 = 0;
            return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
        }

    property:
        int T = 131072;
        int[131072] mergesHash_;
        int[131072] mergesRank_;
        int[50001] mergesOffs_;
        int[900000] mergesData_;
        int mergesDataLen_;
        int[131072] vocabHash_;
        int[131072] vocabId_;
        int[50258] vocabOffs_;
        int[700000] vocabData_;
        int vocabDataLen_;
        int[256] b2c_;
}
