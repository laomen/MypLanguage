// qwen2_chat.myp — 阶段5c5：Qwen2 端到端（文本 → MYP 编码 → KV-cache 生成 → 解码 → 文本）
//
// 全链路都在 MYP：
//   1) 读 qwen2_prompt.txt（UTF-8 用户输入）；
//   2) MYP 内组装 chat 模板字节（system/user/assistant 三段 + 特殊 token），
//      Qwen2Tokenizer 编码（特殊 token 切分 + BPE）→ prompt ids；
//   3) KV-cache 增量 decode（greedy argmax，遇 <|im_end|>=151645 停）生成回复；
//   4) 解码表（id → UTF-8）输出完整 chat 文本；
//   5) 与 transformers 参考（qwen2_ref_gen_ids.bin，同 prompt 的贪心生成）对拍。
//
// 运行（须在 examples/ 下；权重 1.98GB 加载 ~19s）：
//   deeplearning/infer/tools/onnxvenv/bin/python deeplearning/llm/extract_qwen2.py
//   echo -n "What is the capital of France?" > deeplearning/data/llm/qwen2_prompt.txt
//   ./build/mypc examples/deeplearning/llm/qwen2_chat.myp -o /tmp/q2chat --stdlib stdlib && /tmp/q2chat

import env;
import fmt;
import text;
import math;
import "../infer/ops.myp";
import "../infer/pb.myp";
import "par_ops.myp";
import "qwen2_tokenizer.myp";

class Qwen2Chat {
    action:
        @constructor Qwen2Chat() {
            int V = 151936; int H = 896; int L = 24; int QH = 14; int KVH = 2; int HD = 64;
            int FFN = 4864; int POS = 32768; int W = 2048; int groups = QH / KVH;
            int kvD = KVH * HD;
            int MAXGEN = 200;
            double EPS = 0.000001;
            int H2 = H * H;
            int KV = KVH * HD * H;
            int KB = KVH * HD;
            int F = FFN * H;
            int per = H + H2 + H + KV + KB + KV + KB + H2 + H + 3 * F;   // 14912384
            int half = HD / 2;

            int wteOff = 0;
            int base0 = V * H;
            int weightsEnd = base0 + L * per + H;
            int lnfOff = weightsEnd - H;
            int tokOff = weightsEnd;
            int xOff = tokOff + 1;
            int xnOff = xOff + H;
            int qOff = xnOff + H;
            int kOff = qOff + H;
            int vOff = kOff + KV;
            int ctxOff = vOff + KV;
            int gOff = ctxOff + H;
            int uOff = gOff + FFN;
            int hOff = uOff + FFN;
            int scOff = hOff + H;
            int logOff = scOff + W;
            int cosOff = logOff + V;
            int sinOff = cosOff + half;
            int fullCosOff = sinOff + half;
            int fullSinOff = fullCosOff + half * POS;
            int kcBase = fullSinOff + half * POS;
            int CAP = kcBase + L * 2 * kvD * W;
            float[] arena = new float[CAP];

            // ---- 加载权重 ----
            int fd = __myp_io_fopen("./deeplearning/data/llm/qwen2_weights.bin", "rb");
            if (fd < 0) { Console.writeLine("weights file missing"); return; }
            loadBlock(arena, fd, wteOff, weightsEnd);
            __myp_io_fclose();
            int fd0 = __myp_io_fopen("./deeplearning/data/llm/qwen2_cossin.bin", "rb");
            if (fd0 < 0) { Console.writeLine("cossin file missing"); return; }
            loadBlock(arena, fd0, fullCosOff, half * POS);
            loadBlock(arena, fd0, fullSinOff, half * POS);
            __myp_io_fclose();

            // ---- 分词器 + 解码表 ----
            Qwen2Tokenizer tk = new Qwen2Tokenizer();
            if (tk.load() < 0) { Console.writeLine("tokenizer load failed"); return; }
            int[] decOff = new int[151647];
            fd = __myp_io_fopen("./deeplearning/data/llm/qwen2_dec_offs.bin", "rb");
            if (fd < 0) { Console.writeLine("dec offs missing"); return; }
            int vi = 0;
            while (vi <= 151646) { decOff[vi] = readI32(); vi = vi + 1; }
            __myp_io_fclose();
            int[] decData = new int[1000000];
            int decLen = 0;
            fd = __myp_io_fopen("./deeplearning/data/llm/qwen2_dec_data.bin", "rb");
            if (fd < 0) { Console.writeLine("dec data missing"); return; }
            int vb = __myp_io_read_byte();
            while (vb >= 0) { decData[decLen] = vb; decLen = decLen + 1; vb = __myp_io_read_byte(); }
            __myp_io_fclose();

            // ---- 读用户输入 ----
            int[] text = new int[4096];
            int nText = 0;
            fd = __myp_io_fopen("./deeplearning/data/llm/qwen2_prompt.txt", "rb");
            if (fd < 0) { Console.writeLine("qwen2_prompt.txt missing"); return; }
            int ch = __myp_io_read_byte();
            while (ch >= 0 && nText < 4096) { text[nText] = ch; nText = nText + 1; ch = __myp_io_read_byte(); }
            __myp_io_fclose();
            Console.writeString("user input: ");
            ubyte[] ub0 = new ubyte[nText];
            int u0 = 0;
            while (u0 < nText) { ub0[u0] = ubyte(text[u0]); u0 = u0 + 1; }
            Console.writeString(str(ub0));
            Console.writeLine("");

            // ---- 组装 chat 模板字节 ----
            int[] chat = new int[8192];
            int nChat = 0;
            appendStr(chat, nChat, "<|im_start|>system\nYou are a helpful assistant.<|im_end|>\n");
            nChat = nChat + 58;
            appendStr(chat, nChat, "<|im_start|>user\n");
            nChat = nChat + 17;
            int uj = 0;
            while (uj < nText) { chat[nChat + uj] = text[uj]; uj = uj + 1; }
            nChat = nChat + nText;
            appendStr(chat, nChat, "<|im_end|>\n");
            nChat = nChat + 11;
            appendStr(chat, nChat, "<|im_start|>assistant\n");
            nChat = nChat + 22;

            // ---- MYP 编码 ----
            int[] prompt = new int[4096];
            int nPrompt = tk.encode(chat, 0, nChat, prompt);
            Console.writeString("MYP tokenize: " + Fmt.i(nChat) + " bytes -> " + Fmt.i(nPrompt) + " tokens");
            Console.writeLine("");

            // ---- 参考对拍（可选）：qwen2_ref_gen_ids.bin 前 nRefP 是 prompt ids ----
            int[] refIds = new int[512];
            int nRef = 0;
            fd = __myp_io_fopen("./deeplearning/data/llm/qwen2_ref_gen_ids.bin", "rb");
            if (fd >= 0) {
                nRef = readI32();
                int ri = 0;
                while (ri < nRef) { refIds[ri] = readI32(); ri = ri + 1; }
                __myp_io_fclose();
                int badP = 0;
                int rp = 0;
                while (rp < nPrompt) {
                    if (prompt[rp] != refIds[rp]) badP = badP + 1;
                    rp = rp + 1;
                }
                Console.writeString("TOKENIZE vs transformers prompt: mismatch=" + Fmt.i(badP));
                Console.writeLine("");
            }

            // ---- KV-cache 贪心生成 ----
            int[] winHist = new int[512];
            int cacheLen = 0;
            int step = 0;
            int total = 0;
            int eos = 151645;
            int done = 0;
            while (done == 0) {
                int tok = 0;
                if (step < nPrompt) tok = prompt[step];
                else tok = argmax(arena, logOff, V);
                winHist[step] = tok;
                arena[tokOff] = float(tok);
                InferOps.gatherRows(arena, wteOff, tokOff, xOff, V, H, 1);
                int a = 0;
                while (a < half) {
                    arena[cosOff + a] = arena[fullCosOff + a * POS + cacheLen];
                    arena[sinOff + a] = arena[fullSinOff + a * POS + cacheLen];
                    a = a + 1;
                }
                int li = 0;
                while (li < L) {
                    int base = base0 + li * per;
                    layerDecode(arena, base, cacheLen, xOff, xnOff, qOff, kOff, vOff, ctxOff, gOff, uOff, hOff, scOff,
                                cosOff, sinOff, kcBase + li * 2 * kvD * W, W, H, QH, KVH, HD, FFN, groups, kvD, EPS);
                    li = li + 1;
                }
                InferOps.rmsNorm(arena, xOff, lnfOff, xOff, H, 1, EPS);
                ParOps.matmul(arena, xOff, H, 1, wteOff, V, logOff);
                cacheLen = cacheLen + 1;
                step = step + 1;
                total = step;
                if (step >= nPrompt && tok == eos) done = 1;
                if (step >= nPrompt && step >= nPrompt + MAXGEN) done = 1;
            }

            // ---- 生成对拍 ----
            if (nRef > 0) {
                int bad = 0;
                int ck = 0;
                while (ck < nRef) {
                    if (winHist[ck] != refIds[ck]) bad = bad + 1;
                    ck = ck + 1;
                }
                Console.writeString("GENERATE vs transformers: mismatch=" + Fmt.i(bad));
                Console.writeLine("");
                if (bad == 0) Console.writeLine("QWEN2 CHAT OK");
                else Console.writeLine("QWEN2 CHAT FAIL");
            } else {
                Console.writeLine("QWEN2 CHAT DONE (no reference)");
            }

            // ---- 解码输出完整 chat 文本 ----
            Console.writeString("==== chat output ====");
            Console.writeLine("");
            int totBytes = 0;
            int t2 = 0;
            while (t2 < total) {
                int id = winHist[t2];
                if (id >= 0 && id <= 151645) totBytes = totBytes + (decOff[id + 1] - decOff[id]);
                t2 = t2 + 1;
            }
            ubyte[] outBytes = new ubyte[totBytes];
            int oi = 0;
            t2 = 0;
            while (t2 < total) {
                int id = winHist[t2];
                if (id >= 0 && id <= 151645) {
                    int j = decOff[id];
                    while (j < decOff[id + 1]) { outBytes[oi] = ubyte(decData[j]); oi = oi + 1; j = j + 1; }
                }
                t2 = t2 + 1;
            }
            Console.writeString(str(outBytes));
            Console.writeLine("");
        }

        // 追加字符串字节到缓冲
        void appendStr(int[] buf, int off, string s) {
            ubyte[] b = bytes(s);
            int n = Str.len(s);
            int i = 0;
            while (i < n) { buf[off + i] = int(b[i]); i = i + 1; }
        }

        void layerDecode(float[] arena, int base, int cacheLen,
                         int xOff, int xnOff, int qOff, int kOff, int vOff, int ctxOff, int gOff, int uOff, int hOff, int scOff,
                         int cosOff, int sinOff, int kcOff, int W, int H, int QH, int KVH, int HD, int FFN,
                         int groups, int kvD, double eps) {
            int ln1 = base;
            int q = base + H;
            int qb = base + H + H * H;
            int k = base + H + H * H + H;
            int kb = base + H + H * H + H + KVH * HD * H;
            int v = kb + KVH * HD;
            int vb = v + KVH * HD * H;
            int o = vb + KVH * HD;
            int ln2 = o + H * H;
            int gate = ln2 + H;
            int up = gate + FFN * H;
            int down = up + FFN * H;

            InferOps.rmsNorm(arena, xOff, ln1, xnOff, H, 1, eps);
            ParOps.dense(arena, xnOff, H, 1, q, H, qb, qOff);
            ParOps.dense(arena, xnOff, H, 1, k, KVH * HD, kb, kOff);
            ParOps.dense(arena, xnOff, H, 1, v, KVH * HD, vb, vOff);
            InferOps.rope(arena, qOff, cosOff, sinOff, H, 1, QH);
            InferOps.rope(arena, kOff, cosOff, sinOff, KVH * HD, 1, KVH);
            int r = 0;
            while (r < kvD) {
                arena[kcOff + r * W + cacheLen] = arena[kOff + r];
                arena[kcOff + kvD * W + r * W + cacheLen] = arena[vOff + r];
                r = r + 1;
            }
            InferOps.attentionCached(arena, qOff, kcOff, kcOff + kvD * W, ctxOff, scOff,
                                     H, W, cacheLen + 1, QH, groups);
            ParOps.matmul(arena, ctxOff, H, 1, o, H, hOff);
            InferOps.add(arena, xOff, hOff, xOff, H, 0);
            InferOps.rmsNorm(arena, xOff, ln2, xnOff, H, 1, eps);
            ParOps.matmul(arena, xnOff, H, 1, gate, FFN, gOff);
            ParOps.matmul(arena, xnOff, H, 1, up, FFN, uOff);
            silu(arena, gOff, gOff, FFN);
            mulOp(arena, gOff, uOff, gOff, FFN);
            ParOps.matmul(arena, gOff, FFN, 1, down, H, hOff);
            InferOps.add(arena, xOff, hOff, xOff, H, 0);
        }

        void silu(float[] arena, int inOff, int outOff, int n) {
            int i = 0;
            while (i < n) {
                double x = double(arena[inOff + i]);
                double e = Math.exp(0.0 - x);
                arena[outOff + i] = float(x / (1.0 + e));
                i = i + 1;
            }
        }

        void mulOp(float[] arena, int aOff, int bOff, int outOff, int n) {
            int i = 0;
            while (i < n) {
                arena[outOff + i] = arena[aOff + i] * arena[bOff + i];
                i = i + 1;
            }
        }

        int argmax(float[] arena, int off, int n) {
            int bi = 0;
            double bv = arena[off + 0];
            int i = 1;
            while (i < n) {
                double v = arena[off + i];
                if (v > bv) { bv = v; bi = i; }
                i = i + 1;
            }
            return bi;
        }

        void loadBlock(float[] arena, int fd, int off, int n) {
            int i = 0;
            while (i < n) { arena[off + i] = float(readF32()); i = i + 1; }
        }

        double readF32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) return 0.0;
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }

        int readI32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0) b0 = 0;
            if (b1 < 0) b1 = 0;
            if (b2 < 0) b2 = 0;
            if (b3 < 0) b3 = 0;
            return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
        }
}

int main() {
    Qwen2Chat c = new Qwen2Chat();
    return 0;
}
