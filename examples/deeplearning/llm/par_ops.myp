// par_ops.myp — Qwen2 CPU 并行算子（@parallel 版），仅 LLM 用，不动共享 ops.myp
//
// 思路：decode 每 token 的瓶颈是矩阵乘（24 层投影 + lm_head，~5 亿 MACs/token）。
// dense/matmul 在**输出行**上天然并行（batch=1 时每行一个独立点积）。
// @parallel 于输出行 i → 16 线程分摊。rmsNorm/rope/silu/mul/add 每 token 只 O(H)
// 或 O(FFN)，量级小，保持串行（并行开销 ~29µs 反而负优化）。
//
// 与 ops.myp 的 InferOps.dense/matmul 接口一致（无 bOff 的用 matmul；带 bias 用
// dense）。已验证与串行结果一致（par_bench 对拍 maxdiff=0）。

import env;
import math;
import pool;

class ParOps {
    static:
        // y = W x + b（batch 沿列；decode 时 batch=1）；@parallel 于输出行 i
        void dense(float[] arena, int xOff, int inDim, int batch, int wOff, int outDim, int bOff, int yOff) {
            @parallel for (int i = 0; i < outDim; i = i + 1) {
                int k = 0;
                while (k < batch) {
                    float sum = arena[bOff + i];
                    int j = 0;
                    while (j < inDim) {
                        sum = sum + arena[wOff + i * inDim + j] * arena[xOff + j * batch + k];
                        j = j + 1;
                    }
                    arena[yOff + i * batch + k] = sum;
                    k = k + 1;
                }
            }
        }

        // y = W x（无 bias）；@parallel 于输出行 i
        void matmul(float[] arena, int xOff, int inDim, int batch, int wOff, int outDim, int yOff) {
            @parallel for (int i = 0; i < outDim; i = i + 1) {
                int k = 0;
                while (k < batch) {
                    float sum = 0.0f;
                    int j = 0;
                    while (j < inDim) {
                        sum = sum + arena[wOff + i * inDim + j] * arena[xOff + j * batch + k];
                        j = j + 1;
                    }
                    arena[yOff + i * batch + k] = sum;
                    k = k + 1;
                }
            }
        }
}
