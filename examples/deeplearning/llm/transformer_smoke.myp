// transformer_smoke.myp — 阶段5：小 GPT 前向在 MYP 跑通（CPU，直接内核拼装）
//
// 模型：2 层小 GPT（V=32, D=64, H=4, dh=16, S=16, ffn=128），随机权重。
//   Embedding → [RMSNorm → QKV → 缩放点积注意力(因果) → 残差 → RMSNorm → FFN(silu)
//              → 残差]×2 → LM head → logits [V,S]。
// 用 InferOps 直连内核（gatherRows/rmsNorm/attention/dense/silu/add），不经图；
// 与 numpy 参考（llm/make_gpt_smoke_ref.py 导出的 logits）逐元素对拍。
//
// 运行（须在 examples/ 下）：
//   deeplearning/infer/tools/onnxvenv/bin/python deeplearning/llm/make_gpt_smoke_ref.py
//   ./build/mypc examples/deeplearning/llm/transformer_smoke.myp -o /tmp/tr_smoke --stdlib stdlib && /tmp/tr_smoke

import env;
import fmt;
import text;
import math;
import "../infer/ops.myp";
import "../infer/pb.myp";   // F32（读 f32 LE 位型）

class TransformerSmoke {
    action:
        @constructor TransformerSmoke() {
            int V = 32; int D = 64; int H = 4; int S = 16; int ffn = 128; int L = 2;

            // ---- arena 布局（权重 + 激活，特征行×序列列）----
            int eOff = 0;
            int l0g1 = eOff + V * D;
            int l0qkvw = l0g1 + D;
            int l0qkvb = l0qkvw + 3 * D * D;
            int l0g2 = l0qkvb + 3 * D;
            int l0w1 = l0g2 + D;
            int l0b1 = l0w1 + ffn * D;
            int l0w2 = l0b1 + ffn;
            int l0b2 = l0w2 + D * ffn;
            int l1g1 = l0b2 + D;
            int l1qkvw = l1g1 + D;
            int l1qkvb = l1qkvw + 3 * D * D;
            int l1g2 = l1qkvb + 3 * D;
            int l1w1 = l1g2 + D;
            int l1b1 = l1w1 + ffn * D;
            int l1w2 = l1b1 + ffn;
            int l1b2 = l1w2 + D * ffn;
            int wout = l1b2 + D;
            int bout = wout + V * D;
            int xOff = bout + V;
            int xnOff = xOff + D * S;
            int qkvOff = xnOff + D * S;
            int attOff = qkvOff + 3 * D * S;
            int scOff = attOff + D * S;
            int h1Off = scOff + S * S;
            int h2Off = h1Off + ffn * S;
            int logOff = h2Off + D * S;
            int idOff = logOff + V * S;
            int CAP = idOff + S;
            float[] arena = new float[CAP];

            // ---- 读权重（float32 LE）到 arena ----
            int fd = __myp_io_fopen("./deeplearning/data/gpt_smoke_weights.bin", "rb");
            if (fd < 0) { Console.writeLine("weight file missing"); return; }
            loadBlock(arena, fd, eOff, V * D);
            loadBlock(arena, fd, l0g1, D);
            loadBlock(arena, fd, l0qkvw, 3 * D * D);
            loadBlock(arena, fd, l0qkvb, 3 * D);
            loadBlock(arena, fd, l0g2, D);
            loadBlock(arena, fd, l0w1, ffn * D);
            loadBlock(arena, fd, l0b1, ffn);
            loadBlock(arena, fd, l0w2, D * ffn);
            loadBlock(arena, fd, l0b2, D);
            loadBlock(arena, fd, l1g1, D);
            loadBlock(arena, fd, l1qkvw, 3 * D * D);
            loadBlock(arena, fd, l1qkvb, 3 * D);
            loadBlock(arena, fd, l1g2, D);
            loadBlock(arena, fd, l1w1, ffn * D);
            loadBlock(arena, fd, l1b1, ffn);
            loadBlock(arena, fd, l1w2, D * ffn);
            loadBlock(arena, fd, l1b2, D);
            loadBlock(arena, fd, wout, V * D);
            loadBlock(arena, fd, bout, V);
            __myp_io_fclose();

            // ---- token ids（与参考一致，float 编码）----
            arena[idOff + 0] = 1.0f; arena[idOff + 1] = 3.0f; arena[idOff + 2] = 5.0f; arena[idOff + 3] = 7.0f;
            arena[idOff + 4] = 2.0f; arena[idOff + 5] = 4.0f; arena[idOff + 6] = 6.0f; arena[idOff + 7] = 8.0f;
            arena[idOff + 8] = 0.0f; arena[idOff + 9] = 9.0f; arena[idOff + 10] = 11.0f; arena[idOff + 11] = 13.0f;
            arena[idOff + 12] = 15.0f; arena[idOff + 13] = 17.0f; arena[idOff + 14] = 19.0f; arena[idOff + 15] = 21.0f;

            // ---- 前向 ----
            InferOps.gatherRows(arena, eOff, idOff, xOff, V, D, S);
            fwdLayer(arena, l0g1, l0qkvw, l0qkvb, l0g2, l0w1, l0b1, l0w2, l0b2,
                     xOff, xnOff, qkvOff, attOff, scOff, h1Off, h2Off, D, S, H, ffn);
            fwdLayer(arena, l1g1, l1qkvw, l1qkvb, l1g2, l1w1, l1b1, l1w2, l1b2,
                     xOff, xnOff, qkvOff, attOff, scOff, h1Off, h2Off, D, S, H, ffn);
            InferOps.dense(arena, xOff, D, S, wout, V, bout, logOff);

            // ---- 对拍参考 logits ----
            float[] refLog = new float[V * S];
            int fd2 = __myp_io_fopen("./deeplearning/data/gpt_smoke_logits.bin", "rb");
            if (fd2 < 0) { Console.writeLine("logits file missing"); return; }
            loadBlock(refLog, fd2, 0, V * S);
            __myp_io_fclose();

            double maxDiff = 0.0;
            int i = 0;
            while (i < V * S) {
                double d = Math.abs(double(arena[logOff + i]) - double(refLog[i]));
                if (d > maxDiff) maxDiff = d;
                i = i + 1;
            }
            Console.writeString("max logit diff = ");
            Console.writeFloat(maxDiff);
            Console.writeLine("");
            Console.writeString("logits[0..3] = ");
            Console.writeFloat(arena[logOff + 0]);
            Console.writeString(", ");
            Console.writeFloat(arena[logOff + 1]);
            Console.writeString(", ");
            Console.writeFloat(arena[logOff + 2]);
            Console.writeString(", ");
            Console.writeFloat(arena[logOff + 3]);
            Console.writeLine("");
            if (maxDiff < 1.0e-3) Console.writeLine("TRANSFORMER SMOKE OK");
            else Console.writeLine("TRANSFORMER SMOKE FAIL");
        }

        // 读 N 个 float32（LE）写入 arena[off+i]
        void loadBlock(float[] arena, int fd, int off, int n) {
            int i = 0;
            while (i < n) {
                arena[off + i] = float(readF32());
                i = i + 1;
            }
        }

        double readF32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) return 0.0;
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }

        // 一层：RMSNorm → QKV → attention(因果) → 残差 → RMSNorm → FFN(silu) → 残差
        void fwdLayer(float[] arena, int g1, int qkvw, int qkvb, int g2, int w1, int b1, int w2, int b2,
                      int xOff, int xnOff, int qkvOff, int attOff, int scOff, int h1Off, int h2Off,
                      int D, int S, int H, int ffn) {
            InferOps.rmsNorm(arena, xOff, g1, xnOff, D, S, 1.0e-6);
            InferOps.dense(arena, xnOff, D, S, qkvw, 3 * D, qkvb, qkvOff);
            InferOps.attention(arena, qkvOff, qkvOff + D * S, qkvOff + 2 * D * S, attOff, scOff, D, S, H, 1, 1);
            InferOps.add(arena, xOff, attOff, xOff, D * S, 0);
            InferOps.rmsNorm(arena, xOff, g2, xnOff, D, S, 1.0e-6);
            InferOps.dense(arena, xnOff, D, S, w1, ffn, b1, h1Off);
            InferOps.silu(arena, h1Off, h1Off, ffn * S);
            InferOps.dense(arena, h1Off, ffn, S, w2, D, b2, h2Off);
            InferOps.add(arena, xOff, h2Off, xOff, D * S, 0);
        }
}

int main() {
    TransformerSmoke t = new TransformerSmoke();
    return 0;
}
