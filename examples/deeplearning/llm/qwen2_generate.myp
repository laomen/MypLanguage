// qwen2_generate.myp — 阶段5c5：Qwen2-0.5B-Instruct 真实文本生成（KV cache 增量 decode + 字节解码）
//
// 流程：
//   1) 读 data/llm/qwen2_weights.bin（1.98GB，含 q/k/v bias + final_norm，extract_qwen2.py 导出）；
//   2) 读 prompt ids（qwen2_prompt_ids.bin，chat 模板，26 token，extract_qwen2.py 用
//      AutoTokenizer 编码）；
//   3) KV cache 增量 decode（Qwen2：RMSNorm + q/k/v 投影(bias) + RoPE(预计算表) +
//      GQA attention(14Q/2KV, groups=7) + SwiGLU MLP；argmax 采样）生成到 EOS/上限；
//   4) 与 transformers 贪心参考（qwen2_ref_gen_ids.bin）对拍；
//   5) 用解码表（qwen2_dec_offs.bin + qwen2_dec_data.bin，id → UTF-8 字节）输出完整文本。
//
// 运行（须在 examples/ 下；权重 1.98GB 加载 ~19s）：
//   deeplearning/infer/tools/onnxvenv/bin/python deeplearning/llm/extract_qwen2.py
//   ./build/mypc examples/deeplearning/llm/qwen2_generate.myp -o /tmp/q2gen --stdlib stdlib && /tmp/q2gen

import env;
import fmt;
import text;
import math;
import "../infer/ops.myp";
import "../infer/pb.myp";
import "par_ops.myp";

class Qwen2Generate {
    action:
        @constructor Qwen2Generate() {
            int V = 151936; int H = 896; int L = 24; int QH = 14; int KVH = 2; int HD = 64;
            int FFN = 4864; int POS = 32768; int W = 2048; int groups = QH / KVH;
            int kvD = KVH * HD;
            int MAXGEN = 256;
            double EPS = 0.000001;
            int H2 = H * H;
            int KV = KVH * HD * H;
            int KB = KVH * HD;
            int F = FFN * H;
            int per = H + H2 + H + KV + KB + KV + KB + H2 + H + 3 * F;   // 14912384
            int half = HD / 2;

            int wteOff = 0;
            int base0 = V * H;
            int weightsEnd = base0 + L * per + H;
            int lnfOff = weightsEnd - H;
            int tokOff = weightsEnd;
            int xOff = tokOff + 1;                 // [H,1]
            int xnOff = xOff + H;
            int qOff = xnOff + H;                  // [H,1]
            int kOff = qOff + H;                   // [KVH*HD,1]
            int vOff = kOff + KV;
            int ctxOff = vOff + KV;
            int gOff = ctxOff + H;                 // [FFN,1]
            int uOff = gOff + FFN;
            int hOff = uOff + FFN;
            int scOff = hOff + H;                  // [W] 注意力分数
            int logOff = scOff + W;                // [V]
            int cosOff = logOff + V;               // [half,1] 工作表
            int sinOff = cosOff + half;
            int fullCosOff = sinOff + half;        // [half, POS]
            int fullSinOff = fullCosOff + half * POS;
            int kcBase = fullSinOff + half * POS;  // 每层 [kvD,W] K + [kvD,W] V
            int CAP = kcBase + L * 2 * kvD * W;
            float[] arena = new float[CAP];

            // ---- 加载权重 ----
            int fd = __myp_io_fopen("./deeplearning/data/llm/qwen2_weights.bin", "rb");
            if (fd < 0) { Console.writeLine("weights file missing"); return; }
            loadBlock(arena, fd, wteOff, weightsEnd);
            __myp_io_fclose();

            // ---- RoPE cos/sin 完整表 ----
            int fd0 = __myp_io_fopen("./deeplearning/data/llm/qwen2_cossin.bin", "rb");
            if (fd0 < 0) { Console.writeLine("cossin file missing"); return; }
            loadBlock(arena, fd0, fullCosOff, half * POS);
            loadBlock(arena, fd0, fullSinOff, half * POS);
            __myp_io_fclose();

            // ---- prompt ids（int32 count + ids）----
            int[] prompt = new int[512];
            int nPrompt = 0;
            int fd2 = __myp_io_fopen("./deeplearning/data/llm/qwen2_prompt_ids.bin", "rb");
            if (fd2 < 0) { Console.writeLine("prompt file missing"); return; }
            nPrompt = readI32();
            int pi = 0;
            while (pi < nPrompt) { prompt[pi] = readI32(); pi = pi + 1; }
            __myp_io_fclose();

            // ---- 解码表（id → UTF-8 字节）----
            int[] decOff = new int[151647];
            int fd3 = __myp_io_fopen("./deeplearning/data/llm/qwen2_dec_offs.bin", "rb");
            if (fd3 < 0) { Console.writeLine("dec offs missing"); return; }
            int vi = 0;
            while (vi <= 151646) { decOff[vi] = readI32(); vi = vi + 1; }
            __myp_io_fclose();
            int[] decData = new int[1000000];
            int decLen = 0;
            int fd4 = __myp_io_fopen("./deeplearning/data/llm/qwen2_dec_data.bin", "rb");
            if (fd4 < 0) { Console.writeLine("dec data missing"); return; }
            int vb = __myp_io_read_byte();
            while (vb >= 0) { decData[decLen] = vb; decLen = decLen + 1; vb = __myp_io_read_byte(); }
            __myp_io_fclose();

            // ---- transformers 贪心参考 ids（可选）----
            int[] refIds = new int[512];
            int nRef = 0;
            int fd5 = __myp_io_fopen("./deeplearning/data/llm/qwen2_ref_gen_ids.bin", "rb");
            if (fd5 >= 0) {
                nRef = readI32();
                int ri = 0;
                while (ri < nRef) { refIds[ri] = readI32(); ri = ri + 1; }
                __myp_io_fclose();
            }

            // ---- 生成循环（到 EOS=151645 或 MAXGEN）----
            int[] winHist = new int[512];
            int cacheLen = 0;
            int step = 0;
            int total = nPrompt;
            int eos = 151645;
            int done = 0;
            while (done == 0) {
                int tok = 0;
                if (step < nPrompt) tok = prompt[step];
                else tok = argmax(arena, logOff, V);
                winHist[step] = tok;

                // embed：x = wte[tok]（Qwen2 无位置嵌入；RoPE 处理位置）
                arena[tokOff] = float(tok);
                InferOps.gatherRows(arena, wteOff, tokOff, xOff, V, H, 1);

                // RoPE 工作表：当前 cacheLen 位置的 cos/sin [half,1]
                int a = 0;
                while (a < half) {
                    arena[cosOff + a] = arena[fullCosOff + a * POS + cacheLen];
                    arena[sinOff + a] = arena[fullSinOff + a * POS + cacheLen];
                    a = a + 1;
                }

                // 24 层
                int li = 0;
                while (li < L) {
                    int base = base0 + li * per;
                    layerDecode(arena, base, cacheLen, xOff, xnOff, qOff, kOff, vOff, ctxOff, gOff, uOff, hOff, scOff,
                                cosOff, sinOff, kcBase + li * 2 * kvD * W, W, H, QH, KVH, HD, FFN, groups, kvD, EPS);
                    li = li + 1;
                }

                // final_norm + lm_head（wte tied）
                InferOps.rmsNorm(arena, xOff, lnfOff, xOff, H, 1, EPS);
                ParOps.matmul(arena, xOff, H, 1, wteOff, V, logOff);
                cacheLen = cacheLen + 1;
                step = step + 1;
                total = step;
                if (Console.getEnv("MYP_Q2G_DBG") == "1" && step >= nPrompt && step <= nPrompt + 2) {
                    Console.writeString("step " + Fmt.i(step) + " tok=" + Fmt.i(tok) + " argmax=" + Fmt.i(argmax(arena, logOff, V)));
                    Console.writeString("  lg[785]=");
                    Console.writeFloat(arena[logOff + 785]);
                    Console.writeString("  lg[13]=");
                    Console.writeFloat(arena[logOff + 13]);
                    Console.writeLine("");
                }

                if (step >= nPrompt && tok == eos) done = 1;
                if (step >= nPrompt && step >= nPrompt + MAXGEN) done = 1;
            }

            // ---- 对拍 transformers ----
            if (nRef > 0) {
                int bad = 0;
                int ck = 0;
                while (ck < nRef) {
                    if (winHist[ck] != refIds[ck]) bad = bad + 1;
                    ck = ck + 1;
                }
                Console.writeString("token mismatch vs transformers: ");
                Console.write(bad);
                Console.writeString("  (ref n=" + Fmt.i(nRef) + ", mine n=" + Fmt.i(total) + ")");
                Console.writeLine("");
                if (bad == 0) Console.writeLine("QWEN2 GENERATE OK");
                else Console.writeLine("QWEN2 GENERATE FAIL");
            } else {
                Console.writeLine("QWEN2 GENERATE DONE (no reference)");
            }

            // ---- 解码输出完整文本（prompt + 生成）----
            Console.writeString("==== generated text ====");
            Console.writeLine("");
            int totBytes = 0;
            int t2 = 0;
            while (t2 < total) {
                int id = winHist[t2];
                if (id >= 0 && id <= 151645) totBytes = totBytes + (decOff[id + 1] - decOff[id]);
                t2 = t2 + 1;
            }
            ubyte[] outBytes = new ubyte[totBytes];
            int oi = 0;
            t2 = 0;
            while (t2 < total) {
                int id = winHist[t2];
                if (id >= 0 && id <= 151645) {
                    int j = decOff[id];
                    while (j < decOff[id + 1]) { outBytes[oi] = ubyte(decData[j]); oi = oi + 1; j = j + 1; }
                }
                t2 = t2 + 1;
            }
            Console.writeString(str(outBytes));
            Console.writeLine("");
        }

        // Qwen2 单层增量 decode：xOff=[H,1] 就地更新；k/v 追加缓存列 cacheLen
        void layerDecode(float[] arena, int base, int cacheLen,
                         int xOff, int xnOff, int qOff, int kOff, int vOff, int ctxOff, int gOff, int uOff, int hOff, int scOff,
                         int cosOff, int sinOff, int kcOff, int W, int H, int QH, int KVH, int HD, int FFN,
                         int groups, int kvD, double eps) {
            int ln1 = base;
            int q = base + H;
            int qb = base + H + H * H;
            int k = base + H + H * H + H;
            int kb = base + H + H * H + H + KVH * HD * H;
            int v = kb + KVH * HD;
            int vb = v + KVH * HD * H;
            int o = vb + KVH * HD;
            int ln2 = o + H * H;
            int gate = ln2 + H;
            int up = gate + FFN * H;
            int down = up + FFN * H;

            InferOps.rmsNorm(arena, xOff, ln1, xnOff, H, 1, eps);
            ParOps.dense(arena, xnOff, H, 1, q, H, qb, qOff);
            ParOps.dense(arena, xnOff, H, 1, k, KVH * HD, kb, kOff);
            ParOps.dense(arena, xnOff, H, 1, v, KVH * HD, vb, vOff);
            // 先 RoPE 再缓存（缓存的是旋转后的 k；v 不旋转）
            InferOps.rope(arena, qOff, cosOff, sinOff, H, 1, QH);
            InferOps.rope(arena, kOff, cosOff, sinOff, KVH * HD, 1, KVH);
            int r = 0;
            while (r < kvD) {
                arena[kcOff + r * W + cacheLen] = arena[kOff + r];
                arena[kcOff + kvD * W + r * W + cacheLen] = arena[vOff + r];
                r = r + 1;
            }
            InferOps.attentionCached(arena, qOff, kcOff, kcOff + kvD * W, ctxOff, scOff,
                                     H, W, cacheLen + 1, QH, groups);
            ParOps.matmul(arena, ctxOff, H, 1, o, H, hOff);
            InferOps.add(arena, xOff, hOff, xOff, H, 0);
            InferOps.rmsNorm(arena, xOff, ln2, xnOff, H, 1, eps);
            ParOps.matmul(arena, xnOff, H, 1, gate, FFN, gOff);
            ParOps.matmul(arena, xnOff, H, 1, up, FFN, uOff);
            silu(arena, gOff, gOff, FFN);
            mulOp(arena, gOff, uOff, gOff, FFN);
            ParOps.matmul(arena, gOff, FFN, 1, down, H, hOff);
            InferOps.add(arena, xOff, hOff, xOff, H, 0);
        }

        // SiLU(x) = x·sigmoid(x)
        void silu(float[] arena, int inOff, int outOff, int n) {
            int i = 0;
            while (i < n) {
                double x = double(arena[inOff + i]);
                double e = Math.exp(0.0 - x);
                arena[outOff + i] = float(x / (1.0 + e));
                i = i + 1;
            }
        }

        // 逐元素乘
        void mulOp(float[] arena, int aOff, int bOff, int outOff, int n) {
            int i = 0;
            while (i < n) {
                arena[outOff + i] = arena[aOff + i] * arena[bOff + i];
                i = i + 1;
            }
        }

        int argmax(float[] arena, int off, int n) {
            int bi = 0;
            double bv = arena[off + 0];
            int i = 1;
            while (i < n) {
                double v = arena[off + i];
                if (v > bv) { bv = v; bi = i; }
                i = i + 1;
            }
            return bi;
        }

        void loadBlock(float[] arena, int fd, int off, int n) {
            int i = 0;
            while (i < n) { arena[off + i] = float(readF32()); i = i + 1; }
        }

        double readF32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) return 0.0;
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }

        int readI32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0) b0 = 0;
            if (b1 < 0) b1 = 0;
            if (b2 < 0) b2 = 0;
            if (b3 < 0) b3 = 0;
            return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
        }
}

int main() {
    Qwen2Generate g = new Qwen2Generate();
    return 0;
}
