// distilgpt2_forward.myp — 阶段5c：distilgpt2 真实权重前向装配 + 对拍权威参考
//
// 从 data/llm/distilgpt2_weights.bin（extract_distilgpt2.py 导出，328MB）装配 6 层
// GPT-2 前向（LayerNorm + c_attn → attention(12头,因果) → c_proj → 残差 → LayerNorm
// → c_fc(gelu) → mlp_c_proj → 残差）×6 + 最终 ln_f + lm_head(wte tied)，与参考
// logits（data/llm/distilgpt2_ref_logits.bin）对拍。
//
// 参考 logits 由 extract_distilgpt2.py 用 numpy 复刻前向生成（含 ln_f），已与
// transformers GPT2LMHeadModel 权威输出验证一致（maxdiff≈6e-5，argmax=198）。
// 注：用户导出的 ONNX（distilgpt2_onnx/model.onnx）权重 bit 级一致，但其 unfused
// 图 + KV-cache 处理有 bug（onnxruntime argmax=464 与 transformers=198 不符），故
// 不作为参考。
//
// 运行（须在 examples/ 下；权重 328MB 首次加载较慢）：
//   deeplearning/infer/tools/onnxvenv/bin/python deeplearning/llm/extract_distilgpt2.py
//   ./build/mypc examples/deeplearning/llm/distilgpt2_forward.myp -o /tmp/dgpt_fwd --stdlib stdlib && /tmp/dgpt_fwd

import env;
import fmt;
import text;
import math;
import "../infer/ops.myp";
import "../infer/pb.myp";

class Distilgpt2Forward {
    action:
        @constructor Distilgpt2Forward() {
            int V = 50257; int D = 768; int L = 6; int S = 8; int H = 12; int POS = 1024;
            int perLayer = 7087872;

            int wteOff = 0;
            int wpeOff = wteOff + V * D;
            // wte + wpe + 6层 + ln_f(w+b)：81,911,040 + 1536 = 81,912,576
            int weightsEnd = wpeOff + POS * D + L * perLayer + 1536;
            int lnfw = weightsEnd - 1536;
            int lnfb = lnfw + 768;
            int xOff = weightsEnd;
            int xnOff = xOff + D * S;
            int qkvOff = xnOff + D * S;
            int attOff = qkvOff + 3 * D * S;
            int hOff = attOff + D * S;
            int h2Off = hOff + 4 * D * S;
            int scOff = h2Off + D * S;
            int logOff = scOff + S * S;
            int idOff = logOff + V;
            int xLastOff = idOff + S;
            int refOff = xLastOff + D;
            int CAP = refOff + V;
            float[] arena = new float[CAP];

            // ---- 加载权重（327MB，逐字节 f32 LE）----
            long t0 = __myp_now_ms();
            int fd = __myp_io_fopen("./deeplearning/data/llm/distilgpt2_weights.bin", "rb");
            if (fd < 0) { Console.writeLine("weights file missing"); return; }
            loadBlock(arena, fd, wteOff, weightsEnd);
            __myp_io_fclose();
            long t1 = __myp_now_ms();
            Console.writeString("weights loaded in ");
            Console.write(t1 - t0);
            Console.writeString("ms");
            Console.writeLine("");
            if (Console.getEnv("MYP_DG_DBG") == "1") {
                int l0base = wpeOff + POS * D;
                Console.writeString("wte[0..3]=");
                int q = 0; while (q < 4) { Console.writeFloat(arena[wteOff + q]); Console.writeString(" "); q = q + 1; }
                Console.writeLine("");
                Console.writeString("wte[50256][0]=");
                Console.writeFloat(arena[wteOff + 50256 * 768]);
                Console.writeLine("");
                Console.writeString("wpe[0..3]=");
                q = 0; while (q < 4) { Console.writeFloat(arena[wpeOff + q]); Console.writeString(" "); q = q + 1; }
                Console.writeLine("");
                Console.writeString("l0 ln1w[0]=");
                Console.writeFloat(arena[l0base + 0]);
                Console.writeLine("");
                Console.writeString("l0 cattn_w[0..2]=");
                q = 0; while (q < 3) { Console.writeFloat(arena[l0base + 1536 + q]); Console.writeString(" "); q = q + 1; }
                Console.writeLine("");
            }

            // ---- 参考 logits ----
            int fd2 = __myp_io_fopen("./deeplearning/data/llm/distilgpt2_ref_logits.bin", "rb");
            if (fd2 < 0) { Console.writeLine("ref file missing"); return; }
            loadBlock(arena, fd2, refOff, V);
            __myp_io_fclose();

            // ---- prompt（与 extract 脚本一致）----
            int[] ids = new int[8];
            ids[0] = 15496; ids[1] = 11; ids[2] = 318; ids[3] = 257;
            ids[4] = 2051; ids[5] = 13; ids[6] = 50256; ids[7] = 50256;
            int p = 0;
            while (p < S) { arena[idOff + p] = float(ids[p]); p = p + 1; }

            // ---- 前向 ----
            InferOps.gatherRows(arena, wteOff, idOff, xOff, V, D, S);
            // + 位置编码 wpe[0..S-1]
            int pp = 0;
            while (pp < S) {
                int dd = 0;
                while (dd < D) {
                    arena[xOff + dd * S + pp] = arena[xOff + dd * S + pp] + arena[wpeOff + pp * D + dd];
                    dd = dd + 1;
                }
                pp = pp + 1;
            }
            if (Console.getEnv("MYP_DG_DBG") == "1") {
                Console.writeString("emb x[0..5]=");
                int qq = 0; while (qq < 6) { Console.writeFloat(arena[xOff + qq * S + 0]); Console.writeString(" "); qq = qq + 1; }
                Console.writeLine("");
            }
            int li = 0;
            while (li < L) {
                int base = wpeOff + POS * D + li * perLayer;
                layerForward(arena, base, xOff, xnOff, qkvOff, attOff, hOff, h2Off, scOff, D, S, H);
                if (Console.getEnv("MYP_DG_DBG") == "1" && li == 0) {
                    Console.writeString("l0 x[tok0][0..5]=");
                    int qq = 0; while (qq < 6) { Console.writeFloat(arena[xOff + qq * S + 0]); Console.writeString(" "); qq = qq + 1; }
                    Console.writeLine("");
                    Console.writeString("l0 x[tok0][760..767]=");
                    qq = 760; while (qq < 768) { Console.writeFloat(arena[xOff + qq * S + 0]); Console.writeString(" "); qq = qq + 1; }
                    Console.writeLine("");
                }
                li = li + 1;
            }
            // lm_head（最后 token）：复制末列 → ln_f → matmul(wte, tied)
            int c = 0;
            while (c < D) { arena[xLastOff + c] = arena[xOff + c * S + (S - 1)]; c = c + 1; }
            InferOps.layerNorm(arena, xLastOff, lnfw, lnfb, xLastOff, D, 1, 1.0e-5);
            InferOps.matmul(arena, xLastOff, D, 1, wteOff, V, logOff);

            // ---- 对拍 ----
            double maxAbs = 0.0;
            double maxRel = 0.0;
            int argmaxA = 0; int argmaxB = 0;
            double bv = arena[logOff + 0]; double rv = arena[refOff + 0];
            int i = 1;
            while (i < V) {
                double a = arena[logOff + i]; double r = arena[refOff + i];
                if (a > bv) { bv = a; argmaxA = i; }
                if (r > rv) { rv = r; argmaxB = i; }
                double ad = Math.abs(a - r);
                if (ad > maxAbs) maxAbs = ad;
                double rd = ad / (1.0 + Math.abs(r));
                if (rd > maxRel) maxRel = rd;
                i = i + 1;
            }
            Console.writeString("logits maxAbsDiff=");
            Console.writeFloat(maxAbs);
            Console.writeString("  maxRelDiff=");
            Console.writeFloat(maxRel);
            Console.writeLine("");
            Console.writeString("argmax MYP=");
            Console.write(argmaxA);
            Console.writeString("  onnx=");
            Console.write(argmaxB);
            Console.writeLine("");
            Console.writeString("MYP logits[0..5]=");
            int k = 0;
            while (k < 6) { Console.writeFloat(arena[logOff + k]); Console.writeString(" "); k = k + 1; }
            Console.writeLine("");
            if (maxRel < 2.0e-2) Console.writeLine("DISTILGPT2 FORWARD OK");
            else Console.writeLine("DISTILGPT2 FORWARD FAIL");
        }

        // 一层 GPT-2：LayerNorm → c_attn → attention(12头,因果) → c_proj → 残差 →
        // LayerNorm → c_fc(gelu) → mlp_c_proj → 残差
        void layerForward(float[] arena, int base, int xOff, int xnOff, int qkvOff, int attOff,
                          int hOff, int h2Off, int scOff, int D, int S, int H) {
            int ln1w = base;
            int ln1b = base + 768;
            int cattn_w = base + 1536;
            int cattn_b = base + 1771008;
            int cproj_w = base + 1773312;
            int cproj_b = base + 2363136;
            int ln2w = base + 2363904;
            int ln2b = base + 2364672;
            int cfc_w = base + 2365440;
            int cfc_b = base + 4724736;
            int mcproj_w = base + 4727808;
            int mcproj_b = base + 7087104;

            InferOps.layerNorm(arena, xOff, ln1w, ln1b, xnOff, D, S, 1.0e-5);
            InferOps.dense(arena, xnOff, D, S, cattn_w, 3 * D, cattn_b, qkvOff);
            InferOps.attention(arena, qkvOff, qkvOff + D * S, qkvOff + 2 * D * S, attOff, scOff, D, S, H, 1, 1);
            if (Console.getEnv("MYP_DG_DBG") == "1") {
                Console.writeString("  xn[0..5]=");
                int qq = 0; while (qq < 6) { Console.writeFloat(arena[xnOff + qq * S + 0]); Console.writeString(" "); qq = qq + 1; }
                Console.writeLine("");
                Console.writeString("  qkv[0..5]=");
                qq = 0; while (qq < 6) { Console.writeFloat(arena[qkvOff + qq * S + 0]); Console.writeString(" "); qq = qq + 1; }
                Console.writeLine("");
                Console.writeString("  att[0..5]=");
                qq = 0; while (qq < 6) { Console.writeFloat(arena[attOff + qq * S + 0]); Console.writeString(" "); qq = qq + 1; }
                Console.writeLine("");
            }
            InferOps.dense(arena, attOff, D, S, cproj_w, D, cproj_b, h2Off);
            InferOps.add(arena, xOff, h2Off, xOff, D * S, 0);
            InferOps.layerNorm(arena, xOff, ln2w, ln2b, xnOff, D, S, 1.0e-5);
            InferOps.dense(arena, xnOff, D, S, cfc_w, 4 * D, cfc_b, hOff);
            InferOps.gelu(arena, hOff, hOff, 4 * D * S);
            InferOps.dense(arena, hOff, 4 * D, S, mcproj_w, D, mcproj_b, h2Off);
            InferOps.add(arena, xOff, h2Off, xOff, D * S, 0);
        }

        void loadBlock(float[] arena, int fd, int off, int n) {
            int i = 0;
            while (i < n) { arena[off + i] = float(readF32()); i = i + 1; }
        }

        double readF32() {
            int b0 = __myp_io_read_byte();
            int b1 = __myp_io_read_byte();
            int b2 = __myp_io_read_byte();
            int b3 = __myp_io_read_byte();
            if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) return 0.0;
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }
}

int main() {
    Distilgpt2Forward f = new Distilgpt2Forward();
    return 0;
}
