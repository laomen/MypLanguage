import sdl;

class App {
    action:
        @startup void run() {
            int result = SDL.open("MYP SDL Demo", 800, 600);
            if (result != 0) {
                return;
            }
            int bx = 200;
            int by = 200;
            int bsize = 60;

            while (SDL.running()) {
                SDL.clear(20, 24, 82, 255);
                SDL.drawRect(30, 30, 120, 80, 255, 50, 50, 255);
                SDL.drawOutline(30, 30, 120, 80, 100, 255, 100, 255);
                SDL.drawCircle(650, 100, 60, 0, 200, 200, 255);
                SDL.drawLine(30, 30, 770, 570, 255, 255, 0, 255);

                int key = SDL.getKey();
                if (key == 82) { by = by - 5; }
                if (key == 81) { by = by + 5; }
                if (key == 80) { bx = bx - 5; }
                if (key == 79) { bx = bx + 5; }
                if (bx < 0) { bx = 0; }
                if (by < 0) { by = 0; }
                if (bx > 740) { bx = 740; }
                if (by > 540) { by = 540; }

                SDL.drawRect(bx, by, bsize, bsize, 255, 165, 0, 255);
                SDL.drawOutline(bx, by, bsize, bsize, 255, 255, 255, 255);

                if (key == 41) {
                    SDL.close();
                    return;
                }
                SDL.present();
                SDL.delay(16);
            }
            SDL.close();
        }
}

int main() {
    App app = new App();
    return 0;
}
