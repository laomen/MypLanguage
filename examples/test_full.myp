import env;
import sensor;

class TemperatureSensor {
    action:
        void init(int id);
        float readValue();
    event:
        valueRead(float temp);
        thresholdExceeded(float value);
    property:
        int sensorId;
        float threshold;
        float lastValue;
        string name;
        bool enabled;
    interface class ISensor;
}

class Display {
    action:
        void showTemperature(float temp);
        void showWarning(string msg);
    event:
        displayUpdated();
    property:
        string title;
}

int main(int argc, string[] argv) {
    TemperatureSensor ts;
    Display disp @thread;

    int count = 0;
    double pi = 3.14;
    string msg = "hello world";
    bool flag = true;

    if (count < 10) {
        count = count + 1;
    }

    while (flag) {
        flag = false;
    }

    for (int i = 0; i < 100; i = i + 1) {
        ts.sensorId = i;
    }

    mapping() {
        ts.valueRead -> disp.showTemperature;
        ts.thresholdExceeded -> disp.showWarning;
    }

    return 0;
}
