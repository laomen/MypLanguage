// runtime_myp/regex.myp — POSIX 正则层 MYP 化：shadow C bridge regex_bridge.c 的
// myp_regex_compile / myp_regex_match / myp_regex_free。
//
// 设计：de-gcc ≠ 去 glibc——MYP 直接 ffi 调 glibc regex.h（regcomp/regexec/
// regfree），消除「用 gcc 现编译 regex_bridge.c」这一步；运行时仍用 -lc。
//   - regex_t 是 glibc 不透明结构（x86-64 ≈72B）；不猜 sizeof——直接 libc
//     malloc 512B 安全缓冲（regcomp 只写内部字段，512 充裕且不踩 arena）。
//   - handle = 缓冲地址（同 C bridge 的 (intptr_t)re）。compile 失败返回 0。
//   - REG_EXTENDED=1；regexec nmatch=0/pmatch=NULL/eflags=0（仅判是否匹配）。

// libc
ffi long malloc(long size);
ffi void free(long p);
ffi int regcomp(long preg, string pattern, int cflags);
ffi int regexec(long preg, string s, long nmatch, long pmatch, int eflags);
ffi void regfree(long preg);

// C: int64_t myp_regex_compile(const char* pattern) —— 失败返回 0
long myp_regex_compile(string pattern) {
    long re = malloc(512);
    if (re == 0) return 0;
    int ret = regcomp(re, pattern, 1);   // REG_EXTENDED
    if (ret != 0) {
        free(re);
        return 0;
    }
    return re;
}

// C: int32_t myp_regex_match(int64_t handle, const char* s)
int myp_regex_match(long handle, string s) {
    if (handle == 0) return 0;
    int ret = regexec(handle, s, 0, 0, 0);
    return (ret == 0) ? 1 : 0;
}

// C: void myp_regex_free(int64_t handle)
void myp_regex_free(long handle) {
    if (handle == 0) return;
    regfree(handle);
    free(handle);
}
