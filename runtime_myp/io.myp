// runtime_myp/io.myp — 文件 I/O 层 MYP 化（#16）：raw syscall 实现 myp_io_*。
// shadow C runtime 的文件 I/O（File 类经 __myp_io_* 内建 → myp_io_*）。
//
// 设计（与 C 版对齐）：
//   - 句柄表 64 槽，每槽 16B [fd:i64 @0][pending:i64 @8]（fd=-1 空闲；
//     pending=-1 无预读，>=0 预读字节——has_next/read 的 peek）。进程级 @static。
//   - 自旋锁用 __myp_atomic_add_i32_addr（atomicrmw 返回旧值，0=获取）。
//   - **myp_io_cur（当前句柄）= MYP 每线程表**（#42 去 C TLS）：MYP 无 TLS，且
//     clone 线程共享父 TLS → C __thread myp_io_cur 对 MYP @thread 实际是**共享**
//     （并发文件 I/O 会串号）。改用 gettid(186) 键控的 IoCur 表：append-only
//     （线程首设句柄时登记），每线程只写自己的槽 → get 无锁扫描、set 追加用票号锁。
//   - 所有文件操作 raw syscall：open=2 / read=0 / write=1 / lseek=8 / close=3。
//   - mode 串 → open flags；新建文件权限 0644（0x1A4）。
//   - 每次 I/O 用 arena scratch 缓冲（bump 不归还，I/O 量小可接受）。

// 跨模块调用
ffi long myp_arena_alloc(long size);
ffi void myp_arena_reclaim_raw(long addr);
ffi string myp_alloc(long size);
ffi int myp_strlen(string s);

@static class Io {
    property:
        long table = 0;    // fd 表基址（arena 64*16，0=未初始化）
        long lock = 0;     // 自旋锁字地址（arena）
        long feof = 0;     // int[64] feof 标志（0=未撞 EOF，1=已撞；C !feof 语义）
}

// ---- 每线程当前句柄（MYP 无 TLS → gettid 键控表）----
@static class IoCur {
    property:
        long tids = 0;   // long[64]: 线程 gettid
        long vals = 0;   // int[64]: 每线程当前句柄
        long count = 0;  // int: 登记线程数（arena 字）
        long lockS = 0;  // int: 票号锁 serving
        long lockN = 0;  // int: 票号锁 next
}
void ioCurInit() {
    if (IoCur.tids == 0) {
        IoCur.tids = myp_arena_alloc(64 * 8);
        IoCur.vals = myp_arena_alloc(64 * 4);
        IoCur.count = myp_arena_alloc(4);
        IoCur.lockS = myp_arena_alloc(4);
        IoCur.lockN = myp_arena_alloc(4);
        // ⚠️ arena 非零初始化——计数/票号锁必须清零（同 event.myp evInit 教训）
        __myp_mem_store_i32(IoCur.count, 0);
        __myp_mem_store_i32(IoCur.lockS, 0);
        __myp_mem_store_i32(IoCur.lockN, 0);
    }
}
// 当前线程在表中的槽（未登记 → -1）；gettid 表 append-only → 无锁扫描安全
int ioCurSlot() {
    long my = __myp_syscall(186, 0, 0, 0, 0, 0, 0);   // gettid
    int n = __myp_mem_load_i32(IoCur.count);
    for (int i = 0; i < n; i = i + 1)
        if (__myp_mem_load_i64(IoCur.tids + long(i) * 8) == my) return i;
    return -1;
}
// C: int32_t myp_io_cur_get(void)
int myp_io_cur_get() {
    ioCurInit();
    // 单线程快路径：仅 1 个已登记线程时，当前线程必为该线程（File API 每次操作先
    // select→cur_set 登记）→ 免 gettid syscall。file_io 每行 write_line 2 次
    // cur_get（ioCurFd+handle）——gettid 曾占 99.8% syscall（200 万次）。
    int n = __myp_mem_load_i32(IoCur.count);
    if (n == 1) return __myp_mem_load_i32(IoCur.vals);
    int s = ioCurSlot();
    if (s < 0) return 0;
    return __myp_mem_load_i32(IoCur.vals + long(s) * 4);
}
// C: void myp_io_cur_set(int32_t h)
void myp_io_cur_set(int h) {
    ioCurInit();
    long my = __myp_syscall(186, 0, 0, 0, 0, 0, 0);
    int s = ioCurSlot();
    if (s >= 0) { __myp_mem_store_i32(IoCur.vals + long(s) * 4, h); return; }
    // 未登记 → 票号锁内追加（再查一次防并发追加竞态）
    int tk = __myp_atomic_add_i32_addr(IoCur.lockN, 1);
    for (;;) {
        if (__myp_atomic_load_i32_addr(IoCur.lockS) == tk) break;
        __myp_syscall(202, IoCur.lockS, 128, __myp_atomic_load_i32_addr(IoCur.lockS), 0, 0, 0);
    }
    int n = __myp_mem_load_i32(IoCur.count);
    if (n < 64) {
        int found = -1;
        for (int i = 0; i < n; i = i + 1)
            if (__myp_mem_load_i64(IoCur.tids + long(i) * 8) == my) { found = i; break; }
        if (found < 0) {
            found = n;
            __myp_mem_store_i64(IoCur.tids + long(found) * 8, my);
            __myp_mem_store_i32(IoCur.count, n + 1);
        }
        __myp_mem_store_i32(IoCur.vals + long(found) * 4, h);
    }
    __myp_atomic_add_i32_addr(IoCur.lockS, 1);
    __myp_syscall(202, IoCur.lockS, 129, 2147483647, 0, 0, 0);
}

long ioLockAddr() {
    if (Io.lock == 0) {
        long p = myp_arena_alloc(8);
        if (p == 0) return 0;
        __myp_mem_store_i32(p, 0);
        Io.lock = p;
    }
    return Io.lock;
}
void ioLock() {
    long l = ioLockAddr();
    if (l == 0) return;
    while (__myp_atomic_add_i32_addr(l, 1) != 0) { }
}
void ioUnlock() {
    long l = Io.lock;
    if (l != 0) __myp_atomic_store_i32_addr(l, 0);
}
// ---- 每句柄读缓冲（file_io 性能：readLine/read_byte 不再逐字节 syscall）----
// 每句柄 4096B arena 缓冲（惰性分配、进程级复用）；readLine/read_byte/readAll
// 先消费缓冲，耗尽才批量 read（1 次 syscall 读 4096）。IoBuf 表 @static 进程级
//（与 Io.table 同构）。⚠️ 依赖 Io.feof（ioTable 分配）；arena 非零初始化→全表清零。
@static class IoBuf {
    property:
        long base = 0;   // long[64]: 每句柄读缓冲地址（arena 4096B，0=未分配）
        long pos = 0;    // long[64]: 读缓冲内位置
        long len = 0;    // long[64]: 读缓冲内有效字节数
        long wbase = 0;  // long[64]: 每句柄写缓冲地址（arena 4096B，0=未分配）
        long wpos = 0;   // long[64]: 写缓冲内待冲刷字节数
        long scratch = 0;// long[64]: 每句柄行拼接复用缓冲（arena 4096B，0=未分配）
}
void ioBufInit() {
    if (IoBuf.base == 0) {
        IoBuf.base = myp_arena_alloc(64 * 8);
        IoBuf.pos = myp_arena_alloc(64 * 8);
        IoBuf.len = myp_arena_alloc(64 * 8);
        IoBuf.wbase = myp_arena_alloc(64 * 8);
        IoBuf.wpos = myp_arena_alloc(64 * 8);
        IoBuf.scratch = myp_arena_alloc(64 * 8);
        for (int i = 0; i < 64; i = i + 1) {
            __myp_mem_store_i64(IoBuf.base + long(i) * 8, 0);
            __myp_mem_store_i64(IoBuf.pos + long(i) * 8, 0);
            __myp_mem_store_i64(IoBuf.len + long(i) * 8, 0);
            __myp_mem_store_i64(IoBuf.wbase + long(i) * 8, 0);
            __myp_mem_store_i64(IoBuf.wpos + long(i) * 8, 0);
            __myp_mem_store_i64(IoBuf.scratch + long(i) * 8, 0);
        }
    }
}
// 确保句柄读缓冲存在（惰性分配 4096B，进程级复用），返回地址。
long ioBufEnsure(int handle) {
    ioBufInit();
    long b = __myp_mem_load_i64(IoBuf.base + long(handle) * 8);
    if (b == 0) {
        b = myp_arena_alloc(4096);
        if (b != 0) __myp_mem_store_i64(IoBuf.base + long(handle) * 8, b);
    }
    return b;
}
// 确保句柄行拼接复用缓冲（惰性分配 4096B，进程级复用；readLine 不再每次
// myp_arena_alloc(4096)+reclaim——file_io 200k 行省 200k 次 4KB 分配）。
long ioScratchEnsure(int handle) {
    ioBufInit();
    long b = __myp_mem_load_i64(IoBuf.scratch + long(handle) * 8);
    if (b == 0) {
        b = myp_arena_alloc(4096);
        if (b != 0) __myp_mem_store_i64(IoBuf.scratch + long(handle) * 8, b);
    }
    return b;
}
// 填满句柄缓冲；返回本次读入字节数（0 = EOF/错误，feof 置位）。
int ioBufFill(int handle, long fd) {
    long b = ioBufEnsure(handle);
    if (b == 0) return 0;
    long r = __myp_syscall(0, fd, b, 4096, 0, 0, 0);
    if (r <= 0) {
        if (Io.feof != 0) __myp_mem_store_i32(Io.feof + long(handle) * 4, 1);
        return 0;
    }
    __myp_mem_store_i64(IoBuf.pos + long(handle) * 8, 0);
    __myp_mem_store_i64(IoBuf.len + long(handle) * 8, r);
    return int(r);
}
// 复位句柄读缓冲（fopen/fclose/seek 后缓冲失效）
void ioBufReset(int handle) {
    ioBufInit();
    __myp_mem_store_i64(IoBuf.pos + long(handle) * 8, 0);
    __myp_mem_store_i64(IoBuf.len + long(handle) * 8, 0);
    __myp_mem_store_i64(IoBuf.wpos + long(handle) * 8, 0);
}
// ---- 写缓冲（file_io 性能：write_line 不再每行 1 syscall + 分配拷贝）----
// 每句柄 4096B 写缓冲，追加满才 flush。flush 时机：缓冲满 / fclose / seek /
// 同句柄读前（ioFlush 无 wpos 时零开销）。
long ioWbufEnsure(int handle) {
    ioBufInit();
    long b = __myp_mem_load_i64(IoBuf.wbase + long(handle) * 8);
    if (b == 0) {
        b = myp_arena_alloc(4096);
        if (b != 0) __myp_mem_store_i64(IoBuf.wbase + long(handle) * 8, b);
    }
    return b;
}
// 冲刷句柄写缓冲（write 剩余字节到 fd）；无待刷则零开销返回。
void ioFlush(int handle, long fd) {
    ioBufInit();
    long wp = __myp_mem_load_i64(IoBuf.wpos + long(handle) * 8);
    if (wp <= 0) return;
    long b = __myp_mem_load_i64(IoBuf.wbase + long(handle) * 8);
    long off = 0;
    while (off < wp) {
        long r = __myp_syscall(1, fd, b + off, wp - off, 0, 0, 0);
        if (r <= 0) break;
        off = off + r;
    }
    __myp_mem_store_i64(IoBuf.wpos + long(handle) * 8, 0);
}
// 追加 len 字节到写缓冲（满则先冲刷；大块 >4096 直写）。
void ioWriteBuf(int handle, long fd, long data, long len) {
    if (len <= 0 || fd == -1) return;
    long b = ioWbufEnsure(handle);
    long wp = __myp_mem_load_i64(IoBuf.wpos + long(handle) * 8);
    if (wp + len > 4096) {
        ioFlush(handle, fd);
        wp = __myp_mem_load_i64(IoBuf.wpos + long(handle) * 8);
        if (len > 4096) {
            __myp_syscall(1, fd, data, len, 0, 0, 0);   // 大块直写
            return;
        }
    }
    __myp_memcpy(b + wp, data, len);
    __myp_mem_store_i64(IoBuf.wpos + long(handle) * 8, wp + len);
}
// 追加 1 字节到写缓冲（write_line 的 \n / write_byte）。
void ioWriteByte(int handle, long fd, int c) {
    long b = ioWbufEnsure(handle);
    long wp = __myp_mem_load_i64(IoBuf.wpos + long(handle) * 8);
    if (wp >= 4096) { ioFlush(handle, fd); wp = 0; }
    __myp_mem_store_i8(b + wp, c);
    __myp_mem_store_i64(IoBuf.wpos + long(handle) * 8, wp + 1);
}

// 从缓冲读一行到 scratch（cap 容量上限），返回长度 n（0 = EOF）。EOF 置 feof。
long ioReadLineInto(int handle, long fd, long scratch, long cap) {
    ioBufInit();
    long pos = __myp_mem_load_i64(IoBuf.pos + long(handle) * 8);
    long blen = __myp_mem_load_i64(IoBuf.len + long(handle) * 8);
    long b = ioBufEnsure(handle);   // fill 惰性分配一次，base 地址不变，循环外取
    long n = 0;
    for (;;) {
        if (pos >= blen) {
            if (ioBufFill(handle, fd) == 0) break;   // EOF/错误
            pos = __myp_mem_load_i64(IoBuf.pos + long(handle) * 8);
            blen = __myp_mem_load_i64(IoBuf.len + long(handle) * 8);
        }
        int c = __myp_mem_load_i8(b + pos);
        pos = pos + 1;
        if (c == 10) break;          // \n 不包含
        if (n >= cap) break;         // 行上限（对齐旧 4096）
        __myp_mem_store_i8(scratch + n, c);
        n = n + 1;
    }
    __myp_mem_store_i64(IoBuf.pos + long(handle) * 8, pos);
    __myp_mem_store_i64(IoBuf.len + long(handle) * 8, blen);
    return n;
}
// 从缓冲连续读 max 字节到 dst（必要时填充；pend 已由调用方消费）。返回读入数。
long ioBufReadN(int handle, long fd, long dst, long max, long pend) {
    ioBufInit();
    long pos = __myp_mem_load_i64(IoBuf.pos + long(handle) * 8);
    long blen = __myp_mem_load_i64(IoBuf.len + long(handle) * 8);
    long n = 0;
    if (pend >= 0) { __myp_mem_store_i8(dst, int(pend)); n = 1; }
    while (n < max) {
        if (pos >= blen) {
            if (ioBufFill(handle, fd) == 0) break;
            pos = __myp_mem_load_i64(IoBuf.pos + long(handle) * 8);
            blen = __myp_mem_load_i64(IoBuf.len + long(handle) * 8);
        }
        long b = __myp_mem_load_i64(IoBuf.base + long(handle) * 8);
        long take = blen - pos;
        if (take > max - n) take = max - n;
        __myp_memcpy(dst + n, b + pos, take);
        pos = pos + take;
        n = n + take;
    }
    __myp_mem_store_i64(IoBuf.pos + long(handle) * 8, pos);
    __myp_mem_store_i64(IoBuf.len + long(handle) * 8, blen);
    return n;
}

// 初始化 fd 表（全 -1）
long ioTable() {
    if (Io.table == 0) {
        long p = myp_arena_alloc(64 * 16);
        if (p == 0) return 0;
        for (int i = 0; i < 64; i = i + 1) {
            __myp_mem_store_i64(p + i * 16, -1);
            __myp_mem_store_i64(p + i * 16 + 8, -1);
        }
        Io.table = p;
        long f = myp_arena_alloc(64 * 4);
        if (f != 0) {
            for (int i = 0; i < 64; i = i + 1) __myp_mem_store_i32(f + i * 4, 0);
        }
        Io.feof = f;
    }
    return Io.table;
}
// 当前句柄的 fd（无表/非法/槽空闲 → -1）
long ioCurFd() {
    int handle = myp_io_cur_get();
    long t = Io.table;
    if (t == 0) return -1;
    if (handle < 1 || handle >= 64) return -1;
    return __myp_mem_load_i64(t + handle * 16);
}
// 写 n 字节到 fd，返回 0/-1
int ioWriteN(long fd, long buf, long n) {
    if (fd == -1) return -1;
    long r = __myp_syscall(1, fd, buf, n, 0, 0, 0);
    return r == n ? 0 : -1;
}
// mode 串 → open flags（r/w/a，+ 加 RDWR；raw fd 本身即二进制）
long ioModeFlags(string mode) {
    long p = __myp_str_ptr(mode);
    int c0 = __myp_mem_load_i8(p);
    int hasPlus = 0;
    long i = 0;
    while (1) {
        int c = __myp_mem_load_i8(p + i);
        if (c == 0) break;
        if (c == '+') hasPlus = 1;
        i = i + 1;
    }
    if (c0 == 'w') {
        if (hasPlus != 0) return 0x242;   // O_RDWR|O_CREAT|O_TRUNC
        return 0x241;                      // O_WRONLY|O_CREAT|O_TRUNC
    }
    if (c0 == 'a') {
        if (hasPlus != 0) return 0x442;   // O_RDWR|O_CREAT|O_APPEND
        return 0x441;                      // O_WRONLY|O_CREAT|O_APPEND
    }
    if (hasPlus != 0) return 2;            // r+ → O_RDWR
    return 0;                              // r → O_RDONLY
}

// C: int32_t myp_io_fopen(const char* path, const char* mode) —— 打开并设为当前
int myp_io_fopen(string path, string mode) {
    long flags = ioModeFlags(mode);
    long fd = __myp_syscall(2, __myp_str_ptr(path), flags, 420, 0, 0, 0);  // open, 0644
    if (fd < 0) return -1;
    ioLock();
    long t = ioTable();
    if (t == 0) { __myp_syscall(3, fd, 0, 0, 0, 0, 0); ioUnlock(); return -1; }
    int slot = -1;
    for (int i = 1; i < 64; i = i + 1) {
        if (__myp_mem_load_i64(t + i * 16) == -1) { slot = i; break; }
    }
    if (slot < 0) { __myp_syscall(3, fd, 0, 0, 0, 0, 0); ioUnlock(); return -1; }
    __myp_mem_store_i64(t + slot * 16, fd);
    __myp_mem_store_i64(t + slot * 16 + 8, -1);
    if (Io.feof != 0) __myp_mem_store_i32(Io.feof + long(slot) * 4, 0);   // 新开清 feof
    ioBufReset(slot);   // 新开句柄清读缓冲状态（复用旧 4KB 块）
    ioUnlock();
    myp_io_cur_set(slot);
    return 0;
}

// C: int32_t myp_io_current_handle(void)
int myp_io_current_handle() { return myp_io_cur_get(); }

// C: void myp_io_select(int32_t handle) —— 切换当前活动文件
void myp_io_select(int handle) {
    if (handle < 1 || handle >= 64) return;
    // 快路径：已是当前句柄则跳过（连续 readLine/write 同句柄省自旋锁+查表）
    if (myp_io_cur_get() == handle) return;
    ioLock();
    long t = Io.table;
    long ok = 0;
    if (t != 0) {
        if (__myp_mem_load_i64(t + handle * 16) != -1) ok = 1;
    }
    ioUnlock();
    if (ok != 0) myp_io_cur_set(handle);
}

// C: void myp_io_fclose(void) —— 关闭当前并清槽
void myp_io_fclose() {
    int handle = myp_io_cur_get();
    myp_io_cur_set(0);
    ioLock();
    long t = Io.table;
    long fd = -1;
    if (t != 0 && handle >= 1 && handle < 64) {
        fd = __myp_mem_load_i64(t + handle * 16);
        ioFlush(handle, fd);
        __myp_mem_store_i64(t + handle * 16, -1);
        __myp_mem_store_i64(t + handle * 16 + 8, -1);
        ioBufReset(handle);
    }
    ioUnlock();
    if (fd != -1) __myp_syscall(3, fd, 0, 0, 0, 0, 0);
}

// 空串（fresh rc=1，EOF/错误返回值；codegen retain-on-return 会把 myp_alloc 的
// rc=0 补成 1，与 C 的 myp_strdup("") 一致）
string ioEmptyStr() {
    string e = myp_alloc(1);
    __myp_mem_store_i8(__myp_str_ptr(e), 0);
    return e;
}
// 指定句柄读一行（含 pending 处理）；供当前句柄与 coro 读共用
string ioReadLineHandle(int handle) {
    long t = Io.table;
    if (t == 0 || handle < 1 || handle >= 64) return ioEmptyStr();
    long fd = __myp_mem_load_i64(t + handle * 16);
    if (fd == -1) return ioEmptyStr();
    ioFlush(handle, fd);   // 读前冲刷写缓冲（r+/w+ 切换正确性；无 wpos 零开销）
    long pend = __myp_mem_load_i64(t + handle * 16 + 8);
    __myp_mem_store_i64(t + handle * 16 + 8, -1);
    long buf = ioScratchEnsure(handle);   // 复用行拼接缓冲（不每次 4KB 分配）
    long n = 0;
    if (pend >= 0 && pend != 10) { __myp_mem_store_i8(buf, int(pend)); n = 1; }
    n = n + ioReadLineInto(handle, fd, buf + n, 4096 - n);   // 缓冲读（耗尽才批量 syscall）
    string s = myp_alloc(n + 1);
    long dp = __myp_str_ptr(s);
    __myp_memcpy(dp, buf, n);
    __myp_mem_store_i8(dp + n, 0);
    return s;
}
// 指定句柄读全文件（从当前位置到 EOF，字节级；lseek 取大小后分块读）
string ioReadAllHandle(int handle) {
    long t = Io.table;
    if (t == 0 || handle < 1 || handle >= 64) return ioEmptyStr();
    long fd = __myp_mem_load_i64(t + handle * 16);
    if (fd == -1) return ioEmptyStr();
    ioFlush(handle, fd);   // 读前冲刷写缓冲
    // pending 先消费
    long pend = __myp_mem_load_i64(t + handle * 16 + 8);
    __myp_mem_store_i64(t + handle * 16 + 8, -1);
    // 缓冲中未消费字节（read ahead 已把 OS 位置推前）——读全文件必须先并入
    ioBufInit();
    long pos = __myp_mem_load_i64(IoBuf.pos + long(handle) * 8);
    long blen = __myp_mem_load_i64(IoBuf.len + long(handle) * 8);
    long buffered = blen - pos;
    if (buffered < 0) buffered = 0;
    // 当前位置 → 文件尾 → 回当前位置
    long cur = __myp_syscall(8, fd, 0, 1, 0, 0, 0);    // SEEK_CUR
    long end = __myp_syscall(8, fd, 0, 2, 0, 0, 0);    // SEEK_END
    if (end < 0 || cur < 0) {
        // 流式（lseek 失败）：缓冲 + 连续读（上限 64KB）
        long cap = 65536;
        long buf = myp_arena_alloc(cap + 1);
        long n = ioBufReadN(handle, fd, buf, cap, pend);
        __myp_mem_store_i8(buf + n, 0);
        string s = myp_alloc(n + 1);
        __myp_memcpy(__myp_str_ptr(s), buf, n);
        __myp_mem_store_i8(__myp_str_ptr(s) + n, 0);
        myp_arena_reclaim_raw(buf);
        return s;
    }
    __myp_syscall(8, fd, cur, 0, 0, 0, 0);             // 回当前位置
    long remaining = end - cur;
    if (remaining < 0) remaining = 0;
    long cap = buffered + remaining + 1;
    if (pend >= 0) cap = cap + 1;
    long buf = myp_arena_alloc(cap + 1);
    long n = 0;
    if (pend >= 0) { __myp_mem_store_i8(buf, int(pend)); n = 1; }
    if (buffered > 0) {
        long bb = __myp_mem_load_i64(IoBuf.base + long(handle) * 8);
        __myp_memcpy(buf + n, bb + pos, buffered);
        n = n + buffered;
        __myp_mem_store_i64(IoBuf.pos + long(handle) * 8, 0);   // 缓冲已消费
        __myp_mem_store_i64(IoBuf.len + long(handle) * 8, 0);
    }
    while (n < cap - 1) {
        long r = __myp_syscall(0, fd, buf + n, cap - 1 - n, 0, 0, 0);
        if (r <= 0) {
            if (Io.feof != 0) __myp_mem_store_i32(Io.feof + long(handle) * 4, 1);
            break;
        }
        n = n + r;
    }
    __myp_mem_store_i8(buf + n, 0);
    string s = myp_alloc(n + 1);
    __myp_memcpy(__myp_str_ptr(s), buf, n);
    __myp_mem_store_i8(__myp_str_ptr(s) + n, 0);
    myp_arena_reclaim_raw(buf);
    return s;
}

// ---- 协程异步文件读（§五-5 P3）——raw addr 变体（供 coro.myp exec worker 用）----
// worker 线程做阻塞读，结果经 coro execResult 跨线程投递。**不落 string 局部**
// （worker 函数退出会 release → 悬垂）；直接建 12B 头 {len,rc=0,type_id} + 字节，
// 返回 data 地址（long）。协程侧 __myp_addr_to_str(r) return retain(+1) → rc=1。
long ioAllocRaw(int n) {
    long base = myp_arena_alloc(12 + n + 1);
    if (base == 0) return 0;
    __myp_mem_store_i32(base, n);        // len（不含 NUL）
    __myp_mem_store_i32(base + 4, 0);    // rc=0
    __myp_mem_store_i32(base + 8, -2);   // type_id STR（0xFFFFFFFE）
    return base + 12;
}
long execIoReadLineRaw(int handle) {
    long t = Io.table;
    if (t == 0 || handle < 1 || handle >= 64) return 0;
    long fd = __myp_mem_load_i64(t + handle * 16);
    if (fd == -1) return 0;
    long pend = __myp_mem_load_i64(t + handle * 16 + 8);
    __myp_mem_store_i64(t + handle * 16 + 8, -1);
    long buf = myp_arena_alloc(4096);
    long n = 0;
    if (pend >= 0 && pend != 10) { __myp_mem_store_i8(buf, int(pend)); n = 1; }
    n = n + ioReadLineInto(handle, fd, buf + n, 4096 - n);   // 缓冲读
    long dp = ioAllocRaw(int(n));
    if (dp == 0) return 0;
    __myp_memcpy(dp, buf, n);
    __myp_mem_store_i8(dp + n, 0);
    myp_arena_reclaim_raw(buf);
    return dp;
}
long execIoReadAllRaw(int handle) {
    long t = Io.table;
    if (t == 0 || handle < 1 || handle >= 64) return 0;
    long fd = __myp_mem_load_i64(t + handle * 16);
    if (fd == -1) return 0;
    // pending 先消费
    long pend = __myp_mem_load_i64(t + handle * 16 + 8);
    __myp_mem_store_i64(t + handle * 16 + 8, -1);
    // 缓冲中未消费字节（read ahead）——读全文件必须先并入
    ioBufInit();
    long pos = __myp_mem_load_i64(IoBuf.pos + long(handle) * 8);
    long blen = __myp_mem_load_i64(IoBuf.len + long(handle) * 8);
    long buffered = blen - pos;
    if (buffered < 0) buffered = 0;
    // 当前位置 → 文件尾 → 回当前位置
    long cur = __myp_syscall(8, fd, 0, 1, 0, 0, 0);    // SEEK_CUR
    long end = __myp_syscall(8, fd, 0, 2, 0, 0, 0);    // SEEK_END
    if (end < 0 || cur < 0) {
        // 流式：缓冲 + 连续读（上限 64KB）
        long cap = 65536;
        long buf = myp_arena_alloc(cap + 1);
        long n = ioBufReadN(handle, fd, buf, cap, pend);
        __myp_mem_store_i8(buf + n, 0);
        long dp = ioAllocRaw(int(n));
        if (dp == 0) return 0;
        __myp_memcpy(dp, buf, n);
        __myp_mem_store_i8(dp + n, 0);
        myp_arena_reclaim_raw(buf);
        return dp;
    }
    __myp_syscall(8, fd, cur, 0, 0, 0, 0);             // 回当前位置
    long remaining = end - cur;
    if (remaining < 0) remaining = 0;
    long cap = buffered + remaining + 1;
    if (pend >= 0) cap = cap + 1;
    long buf = myp_arena_alloc(cap + 1);
    long n = 0;
    if (pend >= 0) { __myp_mem_store_i8(buf, int(pend)); n = 1; }
    if (buffered > 0) {
        long bb = __myp_mem_load_i64(IoBuf.base + long(handle) * 8);
        __myp_memcpy(buf + n, bb + pos, buffered);
        n = n + buffered;
        __myp_mem_store_i64(IoBuf.pos + long(handle) * 8, 0);
        __myp_mem_store_i64(IoBuf.len + long(handle) * 8, 0);
    }
    while (n < cap - 1) {
        long r = __myp_syscall(0, fd, buf + n, cap - 1 - n, 0, 0, 0);
        if (r <= 0) {
            if (Io.feof != 0) __myp_mem_store_i32(Io.feof + long(handle) * 4, 1);
            break;
        }
        n = n + r;
    }
    __myp_mem_store_i8(buf + n, 0);
    long dp = ioAllocRaw(int(n));
    if (dp == 0) return 0;
    __myp_memcpy(dp, buf, n);
    __myp_mem_store_i8(dp + n, 0);
    myp_arena_reclaim_raw(buf);
    return dp;
}

// C: const char* myp_io_read_line(void) —— 当前句柄读一行
string myp_io_read_line() {
    return ioReadLineHandle(myp_io_cur_get());
}

// C: void myp_io_write(const char* text)
void myp_io_write(string text) {
    long fd = ioCurFd();
    if (fd == -1) return;
    int handle = myp_io_cur_get();
    long len = myp_strlen(text);
    ioWriteBuf(handle, fd, __myp_str_ptr(text), len);   // 写缓冲（满才 flush）
}

// C: void myp_io_write_line(const char* text)
void myp_io_write_line(string text) {
    long fd = ioCurFd();
    if (fd == -1) return;
    int handle = myp_io_cur_get();
    ioWriteBuf(handle, fd, __myp_str_ptr(text), myp_strlen(text));
    ioWriteByte(handle, fd, 10);   // \n 追加到缓冲
}

// C: int32_t myp_io_has_next(void) —— feof 语义（C：!feof，不探测；读操作撞 EOF 置 feof）
int myp_io_has_next() {
    int handle = myp_io_cur_get();
    long t = Io.table;
    if (t == 0 || handle < 1 || handle >= 64) return 0;
    long fd = __myp_mem_load_i64(t + handle * 16);
    if (fd == -1) return 0;
    if (Io.feof == 0) return 1;   // 无 feof 表 → 视为未 EOF（保守）
    return __myp_mem_load_i32(Io.feof + long(handle) * 4) == 0 ? 1 : 0;
}

// C: int32_t myp_io_read_byte(void) —— 含 pending
int myp_io_read_byte() {
    int handle = myp_io_cur_get();
    long t = Io.table;
    if (t == 0 || handle < 1 || handle >= 64) return -1;
    long fd = __myp_mem_load_i64(t + handle * 16);
    if (fd == -1) return -1;
    ioFlush(handle, fd);   // 读前冲刷写缓冲
    long pend = __myp_mem_load_i64(t + handle * 16 + 8);
    if (pend >= 0) {
        __myp_mem_store_i64(t + handle * 16 + 8, -1);
        return int(pend);
    }
    // 每句柄缓冲取字节（耗尽才批量 read）
    ioBufInit();
    long pos = __myp_mem_load_i64(IoBuf.pos + long(handle) * 8);
    long blen = __myp_mem_load_i64(IoBuf.len + long(handle) * 8);
    for (;;) {
        if (pos >= blen) {
            if (ioBufFill(handle, fd) == 0) return -1;   // EOF（feof 已置）
            pos = __myp_mem_load_i64(IoBuf.pos + long(handle) * 8);
            blen = __myp_mem_load_i64(IoBuf.len + long(handle) * 8);
        }
        long b = __myp_mem_load_i64(IoBuf.base + long(handle) * 8);
        int c = __myp_mem_load_i8(b + pos);
        pos = pos + 1;
        __myp_mem_store_i64(IoBuf.pos + long(handle) * 8, pos);
        __myp_mem_store_i64(IoBuf.len + long(handle) * 8, blen);
        return c;
    }
}

// C: int32_t myp_io_read_i32be(void) —— 大端 4 字节
int myp_io_read_i32be() {
    int b0 = myp_io_read_byte();
    int b1 = myp_io_read_byte();
    int b2 = myp_io_read_byte();
    int b3 = myp_io_read_byte();
    if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) return -1;
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

// C: int32_t myp_io_write_byte(int32_t c)
int myp_io_write_byte(int c) {
    long fd = ioCurFd();
    if (fd == -1) return -1;
    int handle = myp_io_cur_get();
    ioWriteByte(handle, fd, c & 0xFF);
    return 0;
}

// C: int32_t myp_io_write_i32be(int32_t val)
int myp_io_write_i32be(int val) {
    long fd = ioCurFd();
    if (fd == -1) return -1;
    int handle = myp_io_cur_get();
    long scratch = myp_arena_alloc(4);
    __myp_mem_store_i8(scratch, (val >> 24) & 0xFF);
    __myp_mem_store_i8(scratch + 1, (val >> 16) & 0xFF);
    __myp_mem_store_i8(scratch + 2, (val >> 8) & 0xFF);
    __myp_mem_store_i8(scratch + 3, val & 0xFF);
    ioWriteBuf(handle, fd, scratch, 4);
    myp_arena_reclaim_raw(scratch);
    return 0;
}

// C: int32_t myp_io_write_double(double val)
int myp_io_write_double(double val) {
    long fd = ioCurFd();
    if (fd == -1) return -1;
    int handle = myp_io_cur_get();
    long scratch = myp_arena_alloc(8);
    __myp_mem_store_double(scratch, val);
    ioWriteBuf(handle, fd, scratch, 8);
    myp_arena_reclaim_raw(scratch);
    return 0;
}

// C: double myp_io_read_double(void) —— 经缓冲 read_byte 逐字节（大端序拼接原语保持）
double myp_io_read_double() {
    long scratch = myp_arena_alloc(8);
    int ok = 1;
    for (int i = 0; i < 8; i = i + 1) {
        int b = myp_io_read_byte();
        if (b < 0) { ok = 0; break; }
        __myp_mem_store_i8(scratch + i, b);
    }
    if (ok == 0) { myp_arena_reclaim_raw(scratch); return 0.0; }
    double v = __myp_mem_load_double(scratch);
    myp_arena_reclaim_raw(scratch);
    return v;
}

// C: int32_t myp_io_seek(int32_t offset, int32_t whence)
int myp_io_seek(int offset, int whence) {
    int handle = myp_io_cur_get();
    long t = Io.table;
    if (t == 0 || handle < 1 || handle >= 64) return -1;
    long fd = __myp_mem_load_i64(t + handle * 16);
    if (fd == -1) return -1;
    __myp_mem_store_i64(t + handle * 16 + 8, -1);   // seek 后清 pending
    ioFlush(handle, fd);                             // seek 前冲刷写缓冲（文件位置正确）
    ioBufReset(handle);                              // seek 后缓冲失效 → 复位
    long r = __myp_syscall(8, fd, offset, whence, 0, 0, 0);   // lseek
    return r < 0 ? -1 : 0;
}

// ---- 协程异步文件读（§五-5 P3）----
// C: char* myp_coro_file_read_line(int io_handle) / myp_coro_file_read_all(int)
// **定义在 coro.myp**（async exec worker：park + worker 线程读 + resume；非协程
// 同步回退）。此处不定义——io.myp 只提供 raw 读原语（execIoReadLineRaw/AllRaw）。

// ---- stdin 读一行（#42 薄层：shadow C myp_read_line；codegen 内建 __myp_read_line）----
// C: const char* myp_read_line(void) —— 读 fd 0 至 '\n' 或 EOF（上限 255），返回
//    计数串（EOF 空行也返回空串；MYP 用空串替代 C NULL）。
string myp_read_line() {
    long buf = myp_arena_alloc(256);
    long n = 0;
    for (;;) {
        long r = __myp_syscall(0, 0, buf + n, 1, 0, 0, 0);   // read(fd0, &c, 1)
        if (r <= 0) break;                                    // EOF/错误
        int b = int(__myp_mem_load_i8(buf + n));
        if (b == 10) break;                                   // '\n'
        n = n + 1;
        if (n >= 255) break;
    }
    string s = myp_alloc(n + 1);
    __myp_memcpy(__myp_str_ptr(s), buf, n);
    __myp_mem_store_i8(__myp_str_ptr(s) + n, 0);
    myp_arena_reclaim_raw(buf);
    return s;
}
