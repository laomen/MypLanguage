// runtime_myp/base64.myp — base64 编解码 myp化（bridge base64_bridge.c 纯函数）。
// shadow 机制同 str.myp：MYP .o 置于 libmyp_rt.a 之前 + --allow-multiple-definition。
// 注意：bridge .c 不在 libmyp_rt.a 里——shadow 测试链接里这些符号必须由本模块提供
// （若缺会 undefined symbol）。验证见 runtime_myp/build.sh + rt_str_test.myp。

ffi string myp_alloc(long size);
ffi int myp_strlen(string s);

// Base64 表：A-Z(0..25) a-z(26..51) 0-9(52..61) '+'(62) '/'(63)
int myp_b64_char(int v) {
    if (v < 26) return 65 + v;
    if (v < 52) return 97 + (v - 26);
    if (v < 62) return 48 + (v - 52);
    if (v == 62) return 43;
    return 47;
}

// C: char* myp_base64_encode(const char* data)
string myp_base64_encode(string data) {
    int len = myp_strlen(data);
    int out_len = ((len + 2) / 3) * 4;
    string r = myp_alloc(out_len + 1);
    long dp = __myp_str_ptr(r);
    int i = 0;
    int o = 0;
    while (i < len) {
        int b0 = __myp_charcode(data, i);
        i = i + 1;
        int have_b1 = 0;
        int b1 = 0;
        if (i < len) { have_b1 = 1; b1 = __myp_charcode(data, i); i = i + 1; }
        int have_b2 = 0;
        int b2 = 0;
        if (i < len) { have_b2 = 1; b2 = __myp_charcode(data, i); i = i + 1; }
        __myp_mem_store_i8(dp + o, myp_b64_char(b0 >> 2)); o = o + 1;
        __myp_mem_store_i8(dp + o, myp_b64_char(((b0 & 3) << 4) | (b1 >> 4))); o = o + 1;
        if (have_b1 != 0) __myp_mem_store_i8(dp + o, myp_b64_char(((b1 & 15) << 2) | (b2 >> 6)));
        else __myp_mem_store_i8(dp + o, 61);   // '='
        o = o + 1;
        if (have_b2 != 0) __myp_mem_store_i8(dp + o, myp_b64_char(b2 & 63));
        else __myp_mem_store_i8(dp + o, 61);   // '='
        o = o + 1;
    }
    __myp_mem_store_i8(dp + out_len, 0);
    return r;
}

int myp_b64_index(int c) {
    if (c >= 65 && c <= 90) return c - 65;
    if (c >= 97 && c <= 122) return c - 97 + 26;
    if (c >= 48 && c <= 57) return c - 48 + 52;
    if (c == 43) return 62;    // '+'
    if (c == 47) return 63;    // '/'
    return 0;
}

// C: char* myp_base64_decode(const char* data)
string myp_base64_decode(string data) {
    int len = myp_strlen(data);
    if (len == 0) {
        string r = myp_alloc(1);
        __myp_mem_store_i8(__myp_str_ptr(r), 0);
        return r;
    }
    int pad = 0;
    if (__myp_charcode(data, len - 1) == 61) pad = pad + 1;      // '='
    if (len > 1 && __myp_charcode(data, len - 2) == 61) pad = pad + 1;
    int out_len = (len / 4) * 3 - pad;
    string r = myp_alloc(out_len + 1);
    long dp = __myp_str_ptr(r);
    int i = 0;
    int o = 0;
    while (i < len) {
        int c0 = 0;
        int c1 = 0;
        int c2 = 0;
        int c3 = 0;
        int nc = 0;
        while (nc < 4 && i < len && __myp_charcode(data, i) != 61) {
            int v = myp_b64_index(__myp_charcode(data, i));
            if (nc == 0) c0 = v;
            else if (nc == 1) c1 = v;
            else if (nc == 2) c2 = v;
            else c3 = v;
            nc = nc + 1;
            i = i + 1;
        }
        if (nc < 4) i = len;   // 遇 '=' 跳过剩余
        if (nc >= 2) { __myp_mem_store_i8(dp + o, (c0 << 2) | (c1 >> 4)); o = o + 1; }
        if (nc >= 3) { __myp_mem_store_i8(dp + o, ((c1 & 15) << 4) | (c2 >> 2)); o = o + 1; }
        if (nc >= 4) { __myp_mem_store_i8(dp + o, ((c2 & 3) << 6) | c3); o = o + 1; }
    }
    __myp_mem_store_i8(dp + out_len, 0);
    return r;
}
