// runtime_myp/thread.myp — 线程创建：pthread_create（glibc 建真 TLS，N×M:1 地基）。
// v3.15.77 起从裸 clone 改 pthread_create：
//   - 裸 clone（无 CLONE_SETTLS）子线程共享父 FS → thread_local/errno/栈金丝雀全
//     共享，无法 per-thread；pthread_create 由 glibc 一次性建栈/TLS/信号，子线程
//     拥有独立 TLS（N×M:1 协程表 per-thread 的前提）。
//   - 入口地址直接作为 pthread arg（rdi）传给 start routine——不再 Thr.entry 全局
//     + 握手（无竞态，天然 capture）。
//   - 子线程从 start routine return → glibc 收尾（清 TLS）；不再 syscall 60
//     （那是 exit 整个进程）。
//   - pthread 符号经 ffi 调 libpthread（-lpthread 已在 link.myp 链接，零新增 gcc）。
//   - @thread 实例走 C runtime myp_thread_create（本就 pthread）；此处把 MYP 侧
//     myp_thread_spawn（coro exec worker / event 循环 / pool worker）也统一到
//     pthread。

ffi int pthread_create(long tid, long attr, long start, long arg);
ffi long myp_arena_alloc(long size);

@static class Thr {
    property:
        long tidSlot = 0;   // pthread_t 输出槽（arena 8B；值忽略——pthread_create
                            // 的 thread 参数是必填输出，无条件写，不能传 NULL）
}

ffi void coroMarkMultiThread();   // coro.myp：@thread 出现 → 协程表转全局锁模式

// pthread start routine：arg = 用户入口地址。本函数是普通函数（有完整栈帧），
// 由 glibc 以标准 SysV 调用约定调用（栈/对齐/TLS 均已就绪）。返回 0 → 线程正常
// 结束（glibc 清 TLS）。不再 syscall 60（那是 exit 整个进程）。
long myp_thread_child_entry(long arg) {
    __myp_indirect_void(arg);     // 跑用户入口
    return 0;
}

// C 侧无同名函数——MYP 新建原语（shadow C myp_thread_spawn 语义；父线程创建，
// 子线程跑 entry）。失败返回 -1（pthread_create 错误码）。
long myp_thread_spawn(long entryAddr) {
    coroMarkMultiThread();        // 多线程模式开启（@thread 出现；M:1 快路径失效）
    if (Thr.tidSlot == 0) Thr.tidSlot = myp_arena_alloc(8);
    long r = pthread_create(Thr.tidSlot, 0, __myp_fn_addr("myp_thread_child_entry"), entryAddr);
    if (r != 0) return -1;
    return 0;
}
