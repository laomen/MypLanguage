// runtime_myp/uds.myp — Unix domain socket 层 MYP 化：shadow C bridge
// uds_bridge.c 的 9 个 myp_uds_*（Linux，AF_UNIX）。纯 syscall（socket 41 /
// bind 49 / listen 50 / accept 43 / connect 42 / sendto 44 / recvfrom 45 /
// close 3 / poll 7 / unlink 87），无 libc 包装、无 gcc。
//
// 关键布局：
//   - sockaddr_un = { sun_family:u16@0 (=AF_UNIX=1), sun_path[108]@2 } = 110B。
//     无 __myp_mem_store_i16 → family 用 2 个 i8（LE: 01 00）。
//   - pollfd = { fd:i32@0, events:i16@4, revents:i16@6 } = 8B。
//     POLLIN=1；revents 值都 <256（POLLIN=1/OUT=4/ERR=8/HUP=16/NVAL=32），
//     i8 读即可判非 0。
//   - send/recv 用 sendto/recvfrom（syscall 44/45，已连接流套接字 dest=NULL）。
//   - 返回字符串按实际长度构建（myp_alloc(n+1) → 头 len=n），同 C。

ffi int myp_strlen(string s);
ffi string myp_alloc(long size);
ffi long myp_arena_alloc(long size);

string udsEmpty() {
    string r = myp_alloc(1);
    __myp_mem_store_i8(__myp_str_ptr(r), 0);
    return r;
}

// 构造 sockaddr_un（110B：family u16@0 + path@2），返回缓冲地址
long udsAddr(string path) {
    long addr = myp_arena_alloc(110);
    __myp_mem_store_i8(addr, 1);       // sun_family = AF_UNIX = 1 (u16 LE)
    __myp_mem_store_i8(addr + 1, 0);
    int pl = myp_strlen(path);
    int cpl = (pl < 107) ? pl : 107;
    for (int i = 0; i < cpl; i = i + 1) {
        __myp_mem_store_i8(addr + 2 + i, __myp_charcode(path, i));
    }
    __myp_mem_store_i8(addr + 2 + cpl, 0);
    return addr;
}

void udsCloseFd(long fd) {
    if (fd >= 0) __myp_syscall(3, fd, 0, 0, 0, 0, 0);   // close
}

// C: int32_t myp_uds_server(const char* path) —— bind+listen；-2 bind/-3 listen
int myp_uds_server(string path) {
    if (myp_strlen(path) == 0) return -1;
    long fd = __myp_syscall(41, 1, 1, 0, 0, 0, 0);   // socket(AF_UNIX=1, SOCK_STREAM=1, 0)
    if (fd < 0) return -1;
    long addr = udsAddr(path);
    long rb = __myp_syscall(49, fd, addr, 110, 0, 0, 0);   // bind
    if (rb < 0) { udsCloseFd(fd); return -2; }
    long rl = __myp_syscall(50, fd, 10, 0, 0, 0, 0);       // listen(fd, 10)
    if (rl < 0) { udsCloseFd(fd); return -3; }
    return int(fd);
}

// C: int32_t myp_uds_accept(int32_t server_fd)
int myp_uds_accept(int server_fd) {
    long fd = __myp_syscall(43, server_fd, 0, 0, 0, 0, 0);   // accept(fd, NULL, NULL)
    return int(fd);
}

// C: int32_t myp_uds_connect(const char* path) —— -2 connect
int myp_uds_connect(string path) {
    if (myp_strlen(path) == 0) return -1;
    long fd = __myp_syscall(41, 1, 1, 0, 0, 0, 0);
    if (fd < 0) return -1;
    long addr = udsAddr(path);
    long rc = __myp_syscall(42, fd, addr, 110, 0, 0, 0);   // connect
    if (rc < 0) { udsCloseFd(fd); return -2; }
    return int(fd);
}

// C: int32_t myp_uds_send(int32_t fd, const char* data)
// BUG-150（修复）：sendto flags 加 MSG_NOSIGNAL(0x4000)——写已关闭的已连接
// Unix 流套接字默认 SIGPIPE 崩；服务端向已断客户端写即崩。加后返回 EPIPE 优雅处理。
int myp_uds_send(int fd, string data) {
    int len = myp_strlen(data);
    if (len == 0) return 0;
    long n = __myp_syscall(44, fd, __myp_str_ptr(data), len, 0x4000, 0, 0);   // sendto, MSG_NOSIGNAL
    return int(n);
}

// C: char* myp_uds_recv(int32_t fd, int32_t max_len) —— 按实收长度构建
string myp_uds_recv(int fd, int max_len) {
    if (max_len <= 0) max_len = 4096;
    string buf = myp_alloc(max_len + 1);
    long n = __myp_syscall(45, fd, __myp_str_ptr(buf), max_len, 0, 0, 0);   // recvfrom
    if (n <= 0) return udsEmpty();
    string r = myp_alloc(int(n) + 1);
    __myp_memcpy(__myp_str_ptr(r), __myp_str_ptr(buf), int(n));
    __myp_mem_store_i8(__myp_str_ptr(r) + int(n), 0);
    return r;
}

// C: char* myp_uds_recv_line(int32_t fd) —— 逐字节到 \n，剥 \r
// 字节透传：先累积到 arena 缓冲，最后一次性 memcpy 到 counted string。
// （旧实现逐字节 r = r + __myp_chr(c) 把字节当码点再 UTF-8 → 中文双重编码 mojibake）
string myp_uds_recv_line(int fd) {
    long b = myp_arena_alloc(8192);
    int pos = 0;
    while (pos < 8191) {
        long n = __myp_syscall(45, fd, b + pos, 1, 0, 0, 0);   // recvfrom 1 byte
        if (n <= 0) break;
        int c = __myp_mem_load_i8(b + pos);
        if (c == 10) break;           // '\n'
        if (c == 13) continue;        // 剥 '\r'（覆盖该字节）
        pos = pos + 1;
    }
    string r = myp_alloc(pos + 1);
    __myp_memcpy(__myp_str_ptr(r), b, pos);
    __myp_mem_store_i8(__myp_str_ptr(r) + pos, 0);
    return r;
}

// C: void myp_uds_close(int32_t fd)
void myp_uds_close(int fd) {
    udsCloseFd(fd);
}

// C: int32_t myp_uds_poll(int32_t* fds, int32_t count, int32_t timeout_ms)
// 返回首个就绪 fd 的索引；超时/无就绪 -1。
int myp_uds_poll(int[] fds, int count, int timeout_ms) {
    if (count <= 0) return -1;
    if (timeout_ms < 0) timeout_ms = 0;
    long pfds = myp_arena_alloc(count * 8);   // pollfd 8B：fd:i32@0 events:i16@4 revents:i16@6
    for (int i = 0; i < count; i = i + 1) {
        __myp_mem_store_i32(pfds + i * 8, fds[i]);
        __myp_mem_store_i8(pfds + i * 8 + 4, 1);   // events = POLLIN (i16 LE)
        __myp_mem_store_i8(pfds + i * 8 + 5, 0);
        __myp_mem_store_i8(pfds + i * 8 + 6, 0);   // revents = 0
        __myp_mem_store_i8(pfds + i * 8 + 7, 0);
    }
    long r = __myp_syscall(7, pfds, count, timeout_ms, 0, 0, 0);   // poll
    if (r <= 0) return -1;
    for (int i = 0; i < count; i = i + 1) {
        int rev = __myp_mem_load_i8(pfds + i * 8 + 6);   // revents 低字节（POLL* 值均 <256）
        if (rev != 0) return i;
    }
    return -1;
}

// C: void myp_uds_unlink(const char* path)
void myp_uds_unlink(string path) {
    if (myp_strlen(path) > 0) __myp_syscall(87, __myp_str_ptr(path), 0, 0, 0, 0, 0);   // unlink
}
