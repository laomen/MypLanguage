// runtime_myp/env.myp — 环境变量层 MYP 化：shadow C runtime 的 myp_env_get。
//
// 设计：
//   - **getenv 无 syscall 等价物**。/proc/self/environ 只反映**进程启动时**的
//     环境内存区（内核 mm->env_start 区域）：libc setenv 增/改导致 environ 缓冲
//     realloc 移动后，/proc/self/environ **看不到**新变量（实测：export 后 grep
//     不到）。故 MYP 版直接**遍历 libc 的 `environ` 全局**（char**，libc 导出
//     的弱符号 `environ@@GLIBC_2.2.5`）：
//     `__myp_fn_addr("environ")` 发射 `ptrtoint ptr @environ to i64`（数据符号
//     取址，复用 #25 的取址内建），链接时解析到 libc 的 environ → 与 C getenv
//     完全一致（含 setenv/unsetenv 的实时修改）。逐 char* 条目找 "NAME=VALUE"。
//   - ⚠️ **myp_env_set / myp_env_unset 保留 C**：setenv/unsetenv 是 libc 进程级
//     操作（修改 environ 缓冲、影响后续 execve 子进程），**无 syscall 等价物**，
//     无法在 MYP 内实现。MYP 只迁移读侧（get）；MYP get 走同一 environ → 天然一致。

ffi string myp_alloc(long size);
ffi int myp_strlen(string s);

// C: char* myp_env_get(const char* name) —— 未找到返回空串
string myp_env_get(string name) {
    // &environ（char***）→ *environ（char**，首个条目）
    long ep = __myp_mem_load_i64(__myp_fn_addr("environ"));
    if (ep == 0) {
        string e = myp_alloc(1);
        __myp_mem_store_i8(__myp_str_ptr(e), 0);
        return e;
    }
    int nl = myp_strlen(name);
    while (1) {
        long entry = __myp_mem_load_i64(ep);   // char* "NAME=VALUE"（NUL 结尾）
        if (entry == 0) break;
        // 找 '='（环境名不含 '='；无 '=' 视为无值条目跳过）
        long eq = 0;
        while (__myp_mem_load_i8(entry + eq) != '=' && __myp_mem_load_i8(entry + eq) != 0) eq = eq + 1;
        if (__myp_mem_load_i8(entry + eq) == '=' && eq == nl) {
            // 名字长度匹配 → 逐字节比较
            int matched = 1;
            for (int k = 0; k < nl; k = k + 1) {
                if (__myp_mem_load_i8(entry + k) != __myp_charcode(name, k)) {
                    matched = 0;
                    break;
                }
            }
            if (matched != 0) {
                long vp = entry + eq + 1;
                long len = 0;
                while (__myp_mem_load_i8(vp + len) != 0) len = len + 1;
                string s = myp_alloc(len + 1);
                __myp_memcpy(__myp_str_ptr(s), vp, len);
                __myp_mem_store_i8(__myp_str_ptr(s) + len, 0);
                return s;
            }
        }
        ep = ep + 8;
    }
    string e = myp_alloc(1);
    __myp_mem_store_i8(__myp_str_ptr(e), 0);
    return e;
}

// ---- 写侧（#42 薄层：shadow C myp_env_set/unset）。setenv/unsetenv 是 libc 进程级
// 操作（修改 environ 缓冲、影响后续 execve 子进程），无 syscall 等价物 → ffi 直调
// libc（去掉 C runtime 的包装符号，仍用 libc）。与读侧 myp_env_get 走同一 environ
// 天然一致。----
ffi int setenv(long name, long value, int overwrite);   // libc
ffi int unsetenv(long name);                            // libc
// C: int32_t myp_env_set(const char* name, const char* value)
int myp_env_set(string name, string value) {
    return setenv(__myp_str_ptr(name), __myp_str_ptr(value), 1);
}
// C: int32_t myp_env_unset(const char* name)
int myp_env_unset(string name) {
    return unsetenv(__myp_str_ptr(name));
}
