// runtime_myp/float.myp — runtime.c 浮点层 myp化（strtod 解析 + %g/%e/%f 格式化）。
// 符号名与 C runtime 一致；shadow 机制同 str.myp/num.myp（--shared 外部链接，
// 链接时置于 libmyp_rt.a 之前 + --allow-multiple-definition → MYP 定义优先）。
// 验证见 runtime_myp/build.sh + rt_float_test.myp（与 C 版输出字节对拍）。
//
// 覆盖（C runtime 对应）：
//   myp_atof / myp_str_to_double / myp_str_to_float —— strtod 语义解析
//     （跳过空白/可选符号/小数点/指数 e/E、0x 十六进制浮点（p 二进制指数）、
//     inf/infinity/nan；无有效数字回 0；溢出→±inf、下溢→0）
//   myp_to_string_double / myp_to_string_float —— %g（默认精度 6）
//   myp_fmt_double_f / myp_fmt_double_e / myp_fmt_double_g —— %.*f / %.*e / %.*g
//   myp_print_float —— %g 打印（Console.writeFloat 路径，不带换行）
//
// 算法：
//   十进制指数 X=floor(log10|v|)：log 粗估 + pow10 比较校正（±1）。
//   %g：X<-4 或 X>=prec 走 %e 风格（P 位有效数字 d.ddde±XX），否则 %f 风格
//     （prec-1-X 位小数）并去尾零/尾点。有效数字：|v|/10^(X-P+1) 缩放到
//     [10^(P-1),10^P) 后 round-half-even 取整（P<=15 时 q<10^15 精确整数）。
//   %e：归一化 m=a/10^X∈[1,10)，m*10^(P-1) 舍入取 P 位有效数字；指数至少 2 位。
//   %f：整数部分反复 /10 取数字（<2^53 精确）+ 小数部分反复 *10 取 prec+1 位
//     按第 prec+1 位进位（round-half-up，与 C 差异极小）。
//   解析：尾数 double 累加 + Math.pow(10, 指数) 缩放。
//
// 注意：函数体内不用字符串 == / < / Str.len（避免经 str.myp 的间接依赖与潜在
// 递归）；字符访问用 __myp_charcode，字符串构建用 myp_alloc + __myp_mem*。
// 精度：%g/%e 有效数字 P<=15 走 double 缩放快路径；P>15 与 %.f |v|>=2^53 走
// 大整数精确十进制展开（下方 exactDigits 区段）。

ffi string myp_alloc(long size);
ffi int myp_strlen(string s);

// ---- 精确十进制展开的状态（大整数区段）----
// BUG-151 同族（v3.15.233）：@thread——格式化 op 在多次 helper 调用间读写
// ExDig/ExSig；两线程并发格式化大 double（%.f |v|>=2^53 / P>15）会互相覆盖 → 错位
// 数字/错误指数。各线程 @thread 隔离。
@static @thread class ExDig {
    property:
        int intLen = 0;    // 整数部分位数（a<1 时为 0）
        int fracLen = 0;   // 小数部分位数（精确展开总位数）
}
@static @thread class ExSig {
    property:
        int X = 0;         // 十进制指数（exactSigDigits 输出）
}

// ---- 辅助 ----
// 10^k（double）
double myp_pow10(int k) {
    return __myp_math_pow(10.0, double(k));
}
// 2^k（double）
double myp_pow2(int k) {
    return __myp_math_pow(2.0, double(k));
}

// round-half-even（glibc %g 舍入）：x>=0
double myp_round_half_even(double x) {
    double f = __myp_math_floor(x);
    double frac = x - f;
    if (frac < 0.5) return f;
    if (frac > 0.5) return f + 1.0;
    long fi = long(f);
    if (fi % 2 == 0) return f;
    return f + 1.0;
}

// 非负 long → 十进制串
string itoaU(long v) {
    if (v == 0) {
        string z = myp_alloc(2);
        __myp_mem_store_i8(__myp_str_ptr(z), 48);
        __myp_mem_store_i8(__myp_str_ptr(z) + 1, 0);
        return z;
    }
    string tmp = myp_alloc(24);
    long tp = __myp_str_ptr(tmp);
    int pos = 22;
    while (v > 0) {
        pos = pos - 1;
        __myp_mem_store_i8(tp + long(pos), 48 + int(v % 10));
        v = v / 10;
    }
    int n = 22 - pos;
    string r = myp_alloc(n + 1);
    __myp_memcpy(__myp_str_ptr(r), tp + long(pos), n);
    __myp_mem_store_i8(__myp_str_ptr(r) + n, 0);
    return r;
}

// q（非负 long，<10^P）→ P 位数字串（前导补零）
string digitsOf(long q, int P) {
    string tmp = myp_alloc(P + 1);
    long tp = __myp_str_ptr(tmp);
    for (int k = P - 1; k >= 0; k = k - 1) {
        __myp_mem_store_i8(tp + long(k), 48 + int(q % 10));
        q = q / 10;
    }
    __myp_mem_store_i8(tp + long(P), 0);
    return tmp;
}

// 十进制指数 X=floor(log10(a))，a>0
int expBase10(double a) {
    double l = __myp_math_log(a);
    int X = int(__myp_math_floor(l / 2.302585092994046));
    if (a >= myp_pow10(X + 1)) X = X + 1;
    else if (a < myp_pow10(X)) X = X - 1;
    return X;
}

// 特殊值（nan/inf/±0）判定，返回 0=普通值
int specialKind(double v) {
    long bits = bitcast<long>(v);
    long em = 9218868437227405312;      // 0x7FF0000000000000
    long mm = 4503599627370495;         // 0x000FFFFFFFFFFFFF
    if ((bits & em) == em) {
        if ((bits & mm) != 0) return 2; // nan
        return 1;                       // inf
    }
    return 0;
}

// ---- 解析（strtod 语义）----
// C: double myp_atof(const char* s) —— strtod(s, NULL)
double myp_atof(string s) {
    int len = myp_strlen(s);
    int i = 0;
    while (i < len) {
        int c = __myp_charcode(s, i);
        if (c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12) i = i + 1;
        else break;
    }
    int neg = 0;
    if (i < len) {
        int c = __myp_charcode(s, i);
        if (c == 45) { neg = 1; i = i + 1; }      // '-'
        else if (c == 43) i = i + 1;              // '+'
    }
    // inf / infinity / nan（大小写不敏感）
    if (i < len && (__myp_charcode(s, i) == 105 || __myp_charcode(s, i) == 73)) {
        if (i + 2 < len && __myp_charcode(s, i + 1) == 110 && __myp_charcode(s, i + 2) == 102) {
            return neg != 0 ? -1.0 / 0.0 : 1.0 / 0.0;   // inf
        }
    }
    if (i < len && (__myp_charcode(s, i) == 110 || __myp_charcode(s, i) == 78)) {
        if (i + 2 < len && __myp_charcode(s, i + 1) == 97 && __myp_charcode(s, i + 2) == 110) {
            return 0.0 / 0.0;                            // nan
        }
    }
    // 0x 十六进制浮点（C99）：0x[hex].[hex]p[±]exp（2 的幂指数）
    if (i + 1 < len && __myp_charcode(s, i) == 48
        && (__myp_charcode(s, i + 1) == 120 || __myp_charcode(s, i + 1) == 88)) {
        int j = i + 2;
        long hm = 0;
        int hfrac = 0;
        int anyh = 0;
        while (j < len) {
            int c = __myp_charcode(s, j);
            int d = -1;
            if (c >= 48 && c <= 57) d = c - 48;
            else if (c >= 97 && c <= 102) d = c - 87;
            else if (c >= 65 && c <= 70) d = c - 55;
            if (d < 0) break;
            hm = hm * 16 + d;
            anyh = 1;
            j = j + 1;
        }
        if (j < len && __myp_charcode(s, j) == 46) {   // '.'
            j = j + 1;
            while (j < len) {
                int c = __myp_charcode(s, j);
                int d = -1;
                if (c >= 48 && c <= 57) d = c - 48;
                else if (c >= 97 && c <= 102) d = c - 87;
                else if (c >= 65 && c <= 70) d = c - 55;
                if (d < 0) break;
                hm = hm * 16 + d;
                hfrac = hfrac + 1;
                anyh = 1;
                j = j + 1;
            }
        }
        if (anyh == 0) return 0.0;
        int pexp = 0;
        int pneg = 0;
        if (j < len && (__myp_charcode(s, j) == 112 || __myp_charcode(s, j) == 80)) {   // p/P
            j = j + 1;
            if (j < len) {
                int c = __myp_charcode(s, j);
                if (c == 45) { pneg = 1; j = j + 1; }
                else if (c == 43) j = j + 1;
            }
            while (j < len) {
                int c = __myp_charcode(s, j);
                if (c < 48 || c > 57) break;
                pexp = pexp * 10 + (c - 48);
                j = j + 1;
            }
        }
        double v = double(hm);
        int shift = pexp - 4 * hfrac;
        if (pneg != 0) shift = -shift;
        if (shift > 0) v = v * myp_pow2(shift);
        else if (shift < 0) v = v / myp_pow2(-shift);
        if (neg != 0) v = -v;
        return v;
    }
    // 十进制
    double mant = 0.0;
    int any = 0;
    int frac = 0;
    while (i < len) {
        int c = __myp_charcode(s, i);
        if (c < 48 || c > 57) break;
        mant = mant * 10.0 + double(c - 48);
        any = 1;
        i = i + 1;
    }
    if (i < len && __myp_charcode(s, i) == 46) {   // '.'
        i = i + 1;
        while (i < len) {
            int c = __myp_charcode(s, i);
            if (c < 48 || c > 57) break;
            mant = mant * 10.0 + double(c - 48);
            frac = frac + 1;
            any = 1;
            i = i + 1;
        }
    }
    if (any == 0) return 0.0;    // 无有效数字
    int exp = 0;
    if (i < len) {
        int c = __myp_charcode(s, i);
        if (c == 101 || c == 69) {    // e/E
            i = i + 1;
            int eneg = 0;
            int anye = 0;
            if (i < len) {
                c = __myp_charcode(s, i);
                if (c == 45) { eneg = 1; i = i + 1; }
                else if (c == 43) i = i + 1;
            }
            while (i < len) {
                c = __myp_charcode(s, i);
                if (c < 48 || c > 57) break;
                exp = exp * 10 + (c - 48);
                anye = 1;
                i = i + 1;
            }
            if (eneg != 0 && anye != 0) exp = -exp;
        }
    }
    double v = mant;
    int es = exp - frac;
    if (es > 0) v = v * myp_pow10(es);
    else if (es < 0) v = v / myp_pow10(-es);
    if (neg != 0) v = -v;
    return v;
}
// C: double myp_str_to_double(const char* s)
double myp_str_to_double(string s) {
    return myp_atof(s);
}
// C: float myp_str_to_float(const char* s)
float myp_str_to_float(string s) {
    return float(myp_atof(s));
}

// ---- 格式化（%g / %e / %f）----
// %e 风格：a>0 归一化到 [1,10)，取 P 位有效数字（round-half-even），组装 d.ddde±XX。
// strip!=0（%g 的 %e 分支）：去尾零（glibc 1e100 → "1e+100" 而非 "1.00000e+100"）；
// strip==0（%.*e）：保留全部 P 位。指数绝对值至少 2 位（可达 3 位如 1e+308）。
string fmtSciBody(double a, int X, int P, int neg, int strip) {
    if (P > 15) P = 15;
    if (P < 1) P = 1;
    double m = a / myp_pow10(X);
    if (m >= 10.0) { m = m / 10.0; X = X + 1; }
    else if (m < 1.0) { m = m * 10.0; X = X - 1; }
    double scaled = m * myp_pow10(P - 1);
    long q = long(myp_round_half_even(scaled));
    if (q >= long(myp_pow10(P))) { q = q / 10; X = X + 1; }   // 舍入进位
    string digs = digitsOf(q, P);
    return assembleSci(digs, P, X, neg, strip);
}

// %f 风格（%g 用）：P 位有效数字，按 X 摆小数点，去尾零/尾点。
string fmtFixedG(double a, int X, int P, int neg) {
    if (P > 15) P = 15;
    if (P < 1) P = 1;
    double scaled = a / myp_pow10(X - P + 1);
    long q = long(myp_round_half_even(scaled));
    if (q >= long(myp_pow10(P))) { q = q / 10; X = X + 1; }
    string digs = digitsOf(q, P);
    return assembleFixed(digs, P, X, neg);
}

// C: char* myp_to_string_double(double val) —— %g（默认精度 6）
string myp_to_string_double(double v) {
    int k = specialKind(v);
    long bits = bitcast<long>(v);
    int neg = 0;
    if (bits < 0) neg = 1;
    if (k == 2) return "nan";
    if (k == 1) return neg != 0 ? "-inf" : "inf";
    double a = v;
    if (a < 0) a = -a;
    if (a == 0) return neg != 0 ? "-0" : "0";
    int X = expBase10(a);
    if (X < -4 || X >= 6) return fmtSciBody(a, X, 6, neg, 1);
    return fmtFixedG(a, X, 6, neg);
}
// C: char* myp_to_string_float(float val) —— %g（拓宽 double）
string myp_to_string_float(float f) {
    return myp_to_string_double(double(f));
}

// C: char* myp_fmt_double_g(double v, int32_t prec) —— %.*g
string myp_fmt_double_g(double v, int prec) {
    if (prec < 0) prec = 0;
    if (prec > 60) prec = 60;
    if (prec == 0) prec = 1;
    int k = specialKind(v);
    long bits = bitcast<long>(v);
    int neg = 0;
    if (bits < 0) neg = 1;
    if (k == 2) return "nan";
    if (k == 1) return neg != 0 ? "-inf" : "inf";
    double a = v;
    if (a < 0) a = -a;
    if (a == 0) return neg != 0 ? "-0" : "0";
    if (prec > 15) return fmtGExact(a, prec, neg);   // 高精度 → 大整数精确路径
    int X = expBase10(a);
    if (X < -4 || X >= prec) return fmtSciBody(a, X, prec, neg, 1);
    return fmtFixedG(a, X, prec, neg);
}

// C: char* myp_fmt_double_e(double v, int32_t prec) —— %.*e（小数点后 prec 位）
string myp_fmt_double_e(double v, int prec) {
    if (prec < 0) prec = 0;
    if (prec > 60) prec = 60;
    int k = specialKind(v);
    long bits = bitcast<long>(v);
    int neg = 0;
    if (bits < 0) neg = 1;
    if (k == 2) return "nan";
    if (k == 1) return neg != 0 ? "-inf" : "inf";
    double a = v;
    if (a < 0) a = -a;
    if (a == 0) {
        // 0.00...e+00（prec 位小数）
        string out = myp_alloc(prec + 8);
        long op = __myp_str_ptr(out);
        int oi = 0;
        if (neg != 0) { __myp_mem_store_i8(op, 45); oi = 1; }
        __myp_mem_store_i8(op + long(oi), 48); oi = oi + 1;   // '0'
        __myp_mem_store_i8(op + long(oi), 46); oi = oi + 1;   // '.'
        int j = 0;
        while (j < prec) { __myp_mem_store_i8(op + long(oi), 48); oi = oi + 1; j = j + 1; }
        __myp_mem_store_i8(op + long(oi), 101); oi = oi + 1;  // 'e'
        __myp_mem_store_i8(op + long(oi), 43); oi = oi + 1;   // '+'
        __myp_mem_store_i8(op + long(oi), 48); oi = oi + 1;   // '0'
        __myp_mem_store_i8(op + long(oi), 48); oi = oi + 1;   // '0'
        __myp_mem_store_i8(op + long(oi), 0);
        string r = myp_alloc(oi + 1);
        __myp_memcpy(__myp_str_ptr(r), op, oi);
        __myp_mem_store_i8(__myp_str_ptr(r) + oi, 0);
        return r;
    }
    if (prec > 14) return fmtESciExact(a, prec, neg);   // prec+1>15 → 精确路径
    int X = expBase10(a);
    return fmtSciBody(a, X, prec + 1, neg, 0);
}

// C: char* myp_fmt_double_f(double v, int32_t prec) —— %.*f（固定小数位）
string myp_fmt_double_f(double v, int prec) {
    if (prec < 0) prec = 0;
    if (prec > 60) prec = 60;
    int k = specialKind(v);
    long bits = bitcast<long>(v);
    int neg = 0;
    if (bits < 0) neg = 1;
    if (k == 2) return "nan";
    if (k == 1) return neg != 0 ? "-inf" : "inf";
    double a = v;
    if (a < 0) a = -a;
    // |v|>=2^53（expf>=1076）整数部分 double /10 丢位；prec>15 双精度不足 → 精确路径
    long ef = (bits >> 52) & 0x7FF;
    if (ef >= 1076 || prec > 15) return fmtFExact(v, prec);
    // 整数部分（double，反复 /10 取数字，<2^53 精确）
    double ip = __myp_math_floor(a);
    double fp = a - ip;
    string ibuf = myp_alloc(320);
    long ipb = __myp_str_ptr(ibuf);
    int ii = 0;
    if (ip == 0) {
        __myp_mem_store_i8(ipb, 48);
        ii = 1;
    } else {
        while (ip >= 1.0) {
            double d = ip - __myp_math_floor(ip / 10.0) * 10.0;
            __myp_mem_store_i8(ipb + long(ii), 48 + int(d));
            ii = ii + 1;
            ip = __myp_math_floor(ip / 10.0);
        }
    }
    // 小数部分：prec+1 位（多取 1 位用于舍入）
    string fbuf = myp_alloc(prec + 2);
    long fpb = __myp_str_ptr(fbuf);
    int fi = 0;
    while (fi < prec + 1) {
        fp = fp * 10.0;
        double d = __myp_math_floor(fp);
        __myp_mem_store_i8(fpb + long(fi), 48 + int(d));
        fi = fi + 1;
        fp = fp - d;
    }
    // 舍入（round-half-even，对齐 glibc）：看第 prec+1 位及其后残差
    int roundUp = 0;
    int rd = __myp_mem_load_i8(fpb + long(prec));
    if (rd > 53) roundUp = 1;                       // > '5' → 上舍入
    else if (rd == 53) {                            // == '5'：看残差是否精确 tie
        if (fp > 0.0) roundUp = 1;                  // 后续还有非零位 → 上舍入
        else {                                      // 精确 tie → round-half-even
            int lastDigit;
            if (prec > 0) lastDigit = __myp_mem_load_i8(fpb + long(prec - 1));
            else lastDigit = __myp_mem_load_i8(ipb);   // prec==0 → 整数部分个位
            if ((lastDigit - 48) % 2 == 1) roundUp = 1;   // 奇数 → 进（变偶）
        }
    }
    int carry = 0;
    if (roundUp != 0) {
        carry = 1;
        int j2 = prec - 1;
        while (j2 >= 0 && carry != 0) {
            int c = __myp_mem_load_i8(fpb + long(j2));
            if (c == 57) { __myp_mem_store_i8(fpb + long(j2), 48); j2 = j2 - 1; }
            else { __myp_mem_store_i8(fpb + long(j2), c + 1); carry = 0; }
        }
    }
    // 组装：[-]整数[.小数（prec 位）]（%.*f 的 prec==0 无小数点，glibc 一致）
    string out = myp_alloc(ii + prec + 5);   // +符号+进位(长度+1)+点+null 余量
    long op = __myp_str_ptr(out);
    int oi = 0;
    if (neg != 0) { __myp_mem_store_i8(op, 45); oi = 1; }
    // 整数部分（ii 个数字，反向在 ibuf[0..ii) → 正序写出）
    int t = ii - 1;
    while (t >= 0) {
        __myp_mem_store_i8(op + long(oi), __myp_mem_load_i8(ipb + long(t))); oi = oi + 1;
        t = t - 1;
    }
    if (carry != 0) {
        int start = 0;
        if (neg != 0) start = 1;
        int ci = oi - 1;
        int done = 0;
        while (ci >= start && done == 0) {
            int c = __myp_mem_load_i8(op + long(ci));
            if (c == 57) { __myp_mem_store_i8(op + long(ci), 48); ci = ci - 1; }
            else { __myp_mem_store_i8(op + long(ci), c + 1); done = 1; }
        }
        if (done == 0) {
            // 整数部分全 9 → 进位为 1 后全 0：整体右移一位（含最后一格）在 start
            // 处插 '1'，长度 +1（999+1 → "1000"）
            int idx = oi - 1;
            while (idx >= start) {
                __myp_mem_store_i8(op + long(idx + 1), __myp_mem_load_i8(op + long(idx)));
                idx = idx - 1;
            }
            __myp_mem_store_i8(op + long(start), 49);   // '1'
            oi = oi + 1;
        }
    }
    if (prec > 0) {
        __myp_mem_store_i8(op + long(oi), 46); oi = oi + 1;   // '.'
        int f2 = 0;
        while (f2 < prec) {
            __myp_mem_store_i8(op + long(oi), __myp_mem_load_i8(fpb + long(f2))); oi = oi + 1;
            f2 = f2 + 1;
        }
    }
    __myp_mem_store_i8(op + long(oi), 0);
    string r = myp_alloc(oi + 1);
    __myp_memcpy(__myp_str_ptr(r), op, oi);
    __myp_mem_store_i8(__myp_str_ptr(r) + oi, 0);
    return r;
}

// ==================== 精确十进制展开（%.f 大数 / %g·%e 高精度）====================
// double a>0 的精确值 = m×2^e（m=53bit 尾数，e=去偏指数）。用 uint32 大整数
// （小端词，≤40 词覆盖 subnormal 1074 位）展开精确十进制数字，支持：
//   - %.f |v|>=2^53 的整数部分（double 反复 /10 会丢低位）
//   - %.f / %g / %e 精度 >15（double 双精度不足以给第 16+ 位）
// 数字提取：e>=0 → m<<e 反复 /10；e<0 → int_part=m>>r、rem=m&(2^r-1)，
// 小数位每步 rem*10 取高 r 位（rem/2^r 十进制精确有限——分母只有 2 因子）。

// m（≤53 位）→ 大整数（2 词小端），返回有效词数
int bigInitM(uint[] w, long m) {
    w[0] = uint(m & 0xFFFFFFFF);
    if (m >= 4294967296) { w[1] = uint((m >> 32) & 0x1FFFFF); return 2; }
    return 1;
}

// w *= 10，返回新 len
int bigMul10(uint[] w, int len) {
    long carry = 0;
    for (int i = 0; i < len; i = i + 1) {
        long v = long(w[i]) * 10 + carry;
        w[i] = uint(v & 0xFFFFFFFF);
        carry = v >> 32;
    }
    if (carry != 0) { w[len] = uint(carry); len = len + 1; }
    return len;
}

// w /= 10（long division），返回余数 0..9；调用方自行收缩 len（顶词可能变 0）
int bigDiv10(uint[] w, int len) {
    long rem = 0;
    for (int i = len - 1; i >= 0; i = i - 1) {
        long cur = (rem << 32) | long(w[i]);
        w[i] = uint(cur / 10);
        rem = cur % 10;
    }
    return int(rem);
}

// w <<= bits（0..~1000），返回新 len
int bigShl(uint[] w, int len, int bits) {
    if (bits >= 32) {
        int ws = bits / 32;
        for (int i = len - 1; i >= 0; i = i - 1) w[i + ws] = w[i];
        for (int i = 0; i < ws; i = i + 1) w[i] = uint(0);
        len = len + ws;
        bits = bits % 32;
    }
    if (bits > 0) {
        long carry = 0;
        for (int i = 0; i < len; i = i + 1) {
            long v = (long(w[i]) << bits) | carry;
            w[i] = uint(v & 0xFFFFFFFF);
            carry = v >> 32;
        }
        if (carry != 0) { w[len] = uint(carry); len = len + 1; }
    }
    return len;
}

// w >>= bits（0..~1000），返回新 len（顶词变 0 收缩）
int bigShr(uint[] w, int len, int bits) {
    if (bits >= 32) {
        int ws = bits / 32;
        if (ws >= len) { len = 1; w[0] = uint(0); bits = 0; }
        else {
            for (int i = 0; i < len - ws; i = i + 1) w[i] = w[i + ws];
            for (int i = len - ws; i < len; i = i + 1) w[i] = uint(0);
            len = len - ws;
            bits = bits % 32;
        }
    }
    if (bits > 0) {
        for (int i = len - 1; i >= 0; i = i - 1) {
            uint hi = uint(0);
            if (i + 1 < len) hi = w[i + 1];
            w[i] = (w[i] >> bits) | (hi << (32 - bits));
        }
    }
    while (len > 1 && w[len - 1] == 0) len = len - 1;
    return len;
}

// w &= (2^r - 1)（保留低 r 位），返回新 len
int bigMaskLow(uint[] w, int len, int r) {
    int wi = 0;
    while (wi < len) {
        int bitLow = wi * 32;
        if (bitLow >= r) { w[wi] = uint(0); }
        else if (bitLow + 32 > r) {
            int keep = r - bitLow;   // 1..31
            uint mask = uint(0);
            for (int b = 0; b < keep; b = b + 1) mask = mask | (uint(1) << b);
            w[wi] = w[wi] & mask;
        }
        wi = wi + 1;
    }
    while (len > 1 && w[len - 1] == 0) len = len - 1;
    return len;
}

// 精确十进制展开 a>0 → 返回 整数位+小数位 拼接数字串（无小数点）；
// ExDig.intLen/fracLen 记录位数。
string exactDigits(double a) {
    long bits = bitcast<long>(a);
    long expf = (bits >> 52) & 0x7FF;
    long mf = bits & 0xFFFFFFFFFFFFF;
    long m;
    long e;
    if (expf == 0) { m = mf; e = -1074; }
    else { m = mf | 0x10000000000000; e = expf - 1075; }
    string buf = myp_alloc(1300);
    long bp = __myp_str_ptr(buf);
    int bl = 0;
    ExDig.intLen = 0;
    ExDig.fracLen = 0;
    uint[] w = new uint[40];
    uint[] w2 = new uint[40];
    if (e >= 0) {
        // 整数 a = m << e：反复 /10 出数字（反向暂存后反转）
        int len = bigInitM(w, m);
        len = bigShl(w, len, int(e));
        int ds = bl;
        while (!(len == 1 && w[0] == 0)) {
            int d = bigDiv10(w, len);
            while (len > 1 && w[len - 1] == 0) len = len - 1;
            __myp_mem_store_i8(bp + long(bl), 48 + d); bl = bl + 1;
        }
        if (bl == ds) { __myp_mem_store_i8(bp + long(bl), 48); bl = bl + 1; }   // a==0 不会到，防御
        int lo = ds;
        int hi2 = bl - 1;
        while (lo < hi2) {
            int c = __myp_mem_load_i8(bp + long(lo));
            __myp_mem_store_i8(bp + long(lo), __myp_mem_load_i8(bp + long(hi2)));
            __myp_mem_store_i8(bp + long(hi2), c);
            lo = lo + 1; hi2 = hi2 - 1;
        }
        ExDig.intLen = bl - ds;
        ExDig.fracLen = 0;
        string r = myp_alloc(bl + 1);
        __myp_memcpy(__myp_str_ptr(r), bp, bl);
        __myp_mem_store_i8(__myp_str_ptr(r) + bl, 0);
        return r;
    }
    // e < 0：int_part = m>>r，rem = m&(2^r-1)（r<53 时两者都是 long）
    long rl = -e;
    long intPart = 0;
    long remLong = m;
    if (rl < 53) {
        intPart = m >> int(rl);
        remLong = m & ((long(1) << int(rl)) - 1);
    }
    int is = bl;
    if (intPart != 0) {
        while (intPart > 0) {
            __myp_mem_store_i8(bp + long(bl), 48 + int(intPart % 10)); bl = bl + 1;
            intPart = intPart / 10;
        }
        int lo2 = is;
        int hi3 = bl - 1;
        while (lo2 < hi3) {
            int c = __myp_mem_load_i8(bp + long(lo2));
            __myp_mem_store_i8(bp + long(lo2), __myp_mem_load_i8(bp + long(hi3)));
            __myp_mem_store_i8(bp + long(hi3), c);
            lo2 = lo2 + 1; hi3 = hi3 - 1;
        }
        ExDig.intLen = bl - is;
    } else {
        ExDig.intLen = 0;
    }
    // 小数位：rem/2^r 精确有限展开——先 rem*=10 再取高 r 位（digit=floor(rem*10/2^r)）
    int len = bigInitM(w, remLong);
    while (true) {
        len = bigMul10(w, len);          // rem *= 10
        for (int ci = 0; ci < len; ci = ci + 1) w2[ci] = w[ci];
        int len2 = bigShr(w2, len, int(rl));
        int digit = int(w2[0]);
        __myp_mem_store_i8(bp + long(bl), 48 + digit); bl = bl + 1;
        ExDig.fracLen = ExDig.fracLen + 1;
        len = bigMaskLow(w, len, int(rl));   // newrem = rem & (2^r-1)
        if (len == 1 && w[0] == 0) break;    // rem==0 → 展开终止
    }
    string r2 = myp_alloc(bl + 1);
    __myp_memcpy(__myp_str_ptr(r2), bp, bl);
    __myp_mem_store_i8(__myp_str_ptr(r2) + bl, 0);
    return r2;
}

// 精确 P 位有效数字（round-half-even）+ 十进制指数 ExSig.X（a>0，P>=1）
string exactSigDigits(double a, int P) {
    string digs = exactDigits(a);
    int intLen = ExDig.intLen;
    int fracLen = ExDig.fracLen;
    int total = intLen + fracLen;
    int fs = 0;
    int X = 0;
    if (intLen > 0) { X = intLen - 1; fs = 0; }
    else {
        int z = 0;
        while (z < total && __myp_charcode(digs, z) == 48) z = z + 1;
        X = -z - 1;
        fs = z;
    }
    string out = myp_alloc(P + 2);
    long op = __myp_str_ptr(out);
    int k = 0;
    while (k < P) {
        int c = 48;
        if (fs + k < total) c = __myp_charcode(digs, fs + k);
        __myp_mem_store_i8(op + long(k), c);
        k = k + 1;
    }
    // 舍入（half-even）：第 P+1 位
    int roundUp = 0;
    if (fs + P < total) {
        int rd = __myp_charcode(digs, fs + P);
        if (rd > 53) roundUp = 1;
        else if (rd == 53) {
            if (fs + P + 1 < total) roundUp = 1;
            else if ((__myp_mem_load_i8(op + long(P - 1)) - 48) % 2 == 1) roundUp = 1;
        }
    }
    if (roundUp != 0) {
        int j = P - 1;
        int carry = 1;
        while (j >= 0 && carry != 0) {
            int c = __myp_mem_load_i8(op + long(j));
            if (c == 57) { __myp_mem_store_i8(op + long(j), 48); j = j - 1; }
            else { __myp_mem_store_i8(op + long(j), c + 1); carry = 0; }
        }
        if (carry != 0) {
            __myp_mem_store_i8(op, 49);
            for (int z2 = 1; z2 < P; z2 = z2 + 1) __myp_mem_store_i8(op + long(z2), 48);
            ExSig.X = X + 1;
        } else {
            ExSig.X = X;
        }
    } else {
        ExSig.X = X;
    }
    __myp_mem_store_i8(op + long(P), 0);
    return out;
}

// %e 组装：digs 为 P 位有效数字，X 十进制指数，neg 符号，strip 去尾零（%g）
string assembleSci(string digs, int P, int X, int neg, int strip) {
    int Peff = P;
    if (strip != 0) {
        int z = P - 1;
        while (z > 0) {
            if (__myp_charcode(digs, z) != 48) break;
            z = z - 1;
        }
        Peff = z + 1;
    }
    string out = myp_alloc(P + 20);
    long op = __myp_str_ptr(out);
    int oi = 0;
    if (neg != 0) { __myp_mem_store_i8(op, 45); oi = 1; }
    __myp_mem_store_i8(op + long(oi), __myp_charcode(digs, 0)); oi = oi + 1;
    if (Peff > 1) {
        __myp_mem_store_i8(op + long(oi), 46); oi = oi + 1;
        for (int k = 1; k < Peff; k = k + 1) {
            __myp_mem_store_i8(op + long(oi), __myp_charcode(digs, k)); oi = oi + 1;
        }
    }
    __myp_mem_store_i8(op + long(oi), 101); oi = oi + 1;   // 'e'
    int xa = X;
    if (xa < 0) { __myp_mem_store_i8(op + long(oi), 45); xa = -xa; oi = oi + 1; }
    else { __myp_mem_store_i8(op + long(oi), 43); oi = oi + 1; }
    if (xa < 10) {
        __myp_mem_store_i8(op + long(oi), 48); oi = oi + 1;
        __myp_mem_store_i8(op + long(oi), 48 + xa); oi = oi + 1;
    } else if (xa < 100) {
        __myp_mem_store_i8(op + long(oi), 48 + xa / 10); oi = oi + 1;
        __myp_mem_store_i8(op + long(oi), 48 + xa % 10); oi = oi + 1;
    } else {
        __myp_mem_store_i8(op + long(oi), 48 + xa / 100); oi = oi + 1;
        __myp_mem_store_i8(op + long(oi), 48 + (xa / 10) % 10); oi = oi + 1;
        __myp_mem_store_i8(op + long(oi), 48 + xa % 10); oi = oi + 1;
    }
    __myp_mem_store_i8(op + long(oi), 0);
    string r = myp_alloc(oi + 1);
    __myp_memcpy(__myp_str_ptr(r), op, oi);
    __myp_mem_store_i8(__myp_str_ptr(r) + oi, 0);
    return r;
}

// %f 组装（%g 的 %f 分支）：digs 为 P 位有效数字，X 十进制指数，按 X 摆小数点去尾零
string assembleFixed(string digs, int P, int X, int neg) {
    string out = myp_alloc(P + 20);
    long op = __myp_str_ptr(out);
    int oi = 0;
    if (neg != 0) { __myp_mem_store_i8(op, 45); oi = 1; }
    int hasDot = 0;
    if (X >= 0) {
        int ip = X + 1;
        if (ip > P) ip = P;
        int k = 0;
        while (k < ip) {
            __myp_mem_store_i8(op + long(oi), __myp_charcode(digs, k)); oi = oi + 1;
            k = k + 1;
        }
        if (ip < P) {
            __myp_mem_store_i8(op + long(oi), 46); oi = oi + 1;
            hasDot = 1;
            while (k < P) {
                __myp_mem_store_i8(op + long(oi), __myp_charcode(digs, k)); oi = oi + 1;
                k = k + 1;
            }
        }
    } else {
        __myp_mem_store_i8(op + long(oi), 48); oi = oi + 1;
        __myp_mem_store_i8(op + long(oi), 46); oi = oi + 1;
        hasDot = 1;
        int nz = -X - 1;
        int k = 0;
        while (k < nz) { __myp_mem_store_i8(op + long(oi), 48); oi = oi + 1; k = k + 1; }
        k = 0;
        while (k < P) {
            __myp_mem_store_i8(op + long(oi), __myp_charcode(digs, k)); oi = oi + 1;
            k = k + 1;
        }
    }
    if (hasDot != 0) {
        while (oi > 0) {
            int c = __myp_mem_load_i8(op + long(oi - 1));
            if (c == 48) oi = oi - 1;
            else break;
        }
        if (oi > 0 && __myp_mem_load_i8(op + long(oi - 1)) == 46) oi = oi - 1;
    }
    __myp_mem_store_i8(op + long(oi), 0);
    string r = myp_alloc(oi + 1);
    __myp_memcpy(__myp_str_ptr(r), op, oi);
    __myp_mem_store_i8(__myp_str_ptr(r) + oi, 0);
    return r;
}

// %g 精确路径（P>15）：P 位有效数字 + 分支 %e/%f
string fmtGExact(double a, int P, int neg) {
    string digs = exactSigDigits(a, P);
    int X = ExSig.X;
    if (X < -4 || X >= P) return assembleSci(digs, P, X, neg, 1);
    return assembleFixed(digs, P, X, neg);
}

// %e 精确路径（prec+1>15）：小数点后 prec 位
string fmtESciExact(double a, int prec, int neg) {
    string digs = exactSigDigits(a, prec + 1);
    return assembleSci(digs, prec + 1, ExSig.X, neg, 0);
}

// %.*f 精确路径（|v|>=2^53 或 prec>15）
string fmtFExact(double v, int prec) {
    long bits = bitcast<long>(v);
    int neg = 0;
    if (bits < 0) neg = 1;
    double a = v;
    if (a < 0) a = -a;
    if (a == 0) {
        string out = myp_alloc(prec + 4);
        long op = __myp_str_ptr(out);
        int oi = 0;
        if (neg != 0) { __myp_mem_store_i8(op, 45); oi = 1; }
        __myp_mem_store_i8(op + long(oi), 48); oi = oi + 1;
        if (prec > 0) {
            __myp_mem_store_i8(op + long(oi), 46); oi = oi + 1;
            for (int j = 0; j < prec; j = j + 1) { __myp_mem_store_i8(op + long(oi), 48); oi = oi + 1; }
        }
        __myp_mem_store_i8(op + long(oi), 0);
        string r = myp_alloc(oi + 1);
        __myp_memcpy(__myp_str_ptr(r), op, oi);
        __myp_mem_store_i8(__myp_str_ptr(r) + oi, 0);
        return r;
    }
    string digs = exactDigits(a);
    int intLen = ExDig.intLen;
    int fracLen = ExDig.fracLen;
    int total = intLen + fracLen;
    string out = myp_alloc(420 + prec);
    long op = __myp_str_ptr(out);
    int oi = 0;
    if (neg != 0) { __myp_mem_store_i8(op, 45); oi = 1; }
    int intStart = oi;
    if (intLen > 0) {
        for (int k = 0; k < intLen; k = k + 1) {
            __myp_mem_store_i8(op + long(oi), __myp_charcode(digs, k)); oi = oi + 1;
        }
    } else {
        __myp_mem_store_i8(op + long(oi), 48); oi = oi + 1;
    }
    // 舍入判定（half-even）：第 prec+1 个小数位
    int roundUp = 0;
    if (prec < fracLen) {
        int rd = __myp_charcode(digs, intLen + prec);
        if (rd > 53) roundUp = 1;
        else if (rd == 53) {
            if (intLen + prec + 1 < total) roundUp = 1;
            else if ((__myp_mem_load_i8(op + long(oi - 1)) - 48) % 2 == 1) roundUp = 1;
        }
    }
    // 写小数（prec 位，不足补零）
    if (prec > 0) {
        __myp_mem_store_i8(op + long(oi), 46); oi = oi + 1;
        int fi = 0;
        while (fi < prec) {
            int c = 48;
            if (intLen + fi < total) c = __myp_charcode(digs, intLen + fi);
            __myp_mem_store_i8(op + long(oi), c); oi = oi + 1;
            fi = fi + 1;
        }
    }
    // 进位
    if (roundUp != 0) {
        int ci = oi - 1;
        int done = 0;
        while (ci >= intStart && done == 0) {
            int c = __myp_mem_load_i8(op + long(ci));
            if (c == 57) { __myp_mem_store_i8(op + long(ci), 48); ci = ci - 1; }
            else { __myp_mem_store_i8(op + long(ci), c + 1); done = 1; }
        }
        if (done == 0) {
            int idx = oi - 1;
            while (idx >= intStart) {
                __myp_mem_store_i8(op + long(idx + 1), __myp_mem_load_i8(op + long(idx)));
                idx = idx - 1;
            }
            __myp_mem_store_i8(op + long(intStart), 49);
            oi = oi + 1;
        }
    }
    __myp_mem_store_i8(op + long(oi), 0);
    string r = myp_alloc(oi + 1);
    __myp_memcpy(__myp_str_ptr(r), op, oi);
    __myp_mem_store_i8(__myp_str_ptr(r) + oi, 0);
    return r;
}

// C: void myp_print_float(double val) —— %g 打印（Console.writeFloat 路径，不带换行）
void myp_print_float(double v) {
    __myp_print(myp_to_string_double(v));
}
