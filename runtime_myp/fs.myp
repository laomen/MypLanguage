// runtime_myp/fs.myp — 文件系统层 MYP 化（raw syscall）：shadow C runtime 的
// myp_fs_*（exists/is_dir/is_file/file_size/modified_time/list_count/list_get/
// dirname/basename/join/mkdir_p/remove_recursive）。符号名与 C 一致，--shared +
// 前置链接 → MYP 定义优先。
//
// 设计：
//   - stat 系列用 newfstatat = x86-64 syscall 262（AT_FDCWD=-100；lstat 用
//     AT_SYMLINK_NOFOLLOW=0x100）。内核 struct stat 144B：st_mode@24(u32)，
//     st_size@48(i64)，st_mtime@88(u64，秒)。S_IFMT=0xF000, S_IFDIR=0x4000,
//     S_IFREG=0x8000。
//   - 目录列表用 getdents64 = syscall 217：linux_dirent64
//     {d_ino@0, d_off@8, d_reclen@16(u16), d_type@18, d_name@19}，逐条跳过
//     "." / ".."。open(dir, O_RDONLY|O_DIRECTORY=0x10000)。
//   - mkdir=83（0755，EEXIST=17 视为成功）/ rmdir=84 / unlink=87 / open=2 /
//     close=3 / read=0。
//   - dirname/basename/join 纯字节操作（无 stdlib 依赖）；字符串用
//     myp_alloc(n+1)（len=n）+ memcpy + NUL（同 io.myp 模式）。

// alloc.myp（shadow 同伴模块）——跨模块 FFI
ffi long myp_arena_alloc(long size);
ffi string myp_alloc(long size);
ffi int myp_strlen(string s);

// 读 NUL 结尾 C 串（地址 p）→ 计数字符串（len=实际字节数，rc 由 return-retain 补 1）
string fsStrFrom(long p) {
    long n = 0;
    while (__myp_mem_load_i8(p + n) != 0) n = n + 1;
    string s = myp_alloc(n + 1);
    __myp_memcpy(__myp_str_ptr(s), p, n);
    __myp_mem_store_i8(__myp_str_ptr(s) + n, 0);
    return s;
}
// 空串（fresh rc=1，缺失/错误返回值；同 C 的 myp_strdup("")）
string fsEmpty() {
    string s = myp_alloc(1);
    __myp_mem_store_i8(__myp_str_ptr(s), 0);
    return s;
}

// newfstatat(dirfd=AT_FDCWD, path, buf, flags)；返回 0 成功 / -errno 失败
long fsStat(string path, long buf, long flags) {
    return __myp_syscall(262, -100, __myp_str_ptr(path), buf, flags, 0, 0);
}
// 模式类型判定
int fsIsDirMode(long mode) { return (int(mode & 0xF000) == 0x4000) ? 1 : 0; }
int fsIsRegMode(long mode) { return (int(mode & 0xF000) == 0x8000) ? 1 : 0; }

// C: int32_t myp_fs_exists(const char* path)
int myp_fs_exists(string path) {
    if (myp_strlen(path) == 0) return 0;
    long buf = myp_arena_alloc(144);
    if (buf == 0) return 0;
    return fsStat(path, buf, 0) == 0 ? 1 : 0;
}
// C: int32_t myp_fs_is_dir(const char* path)
int myp_fs_is_dir(string path) {
    if (myp_strlen(path) == 0) return 0;
    long buf = myp_arena_alloc(144);
    if (buf == 0) return 0;
    if (fsStat(path, buf, 0) != 0) return 0;
    return fsIsDirMode(__myp_mem_load_i32(buf + 24));
}
// C: int32_t myp_fs_is_file(const char* path)
int myp_fs_is_file(string path) {
    if (myp_strlen(path) == 0) return 0;
    long buf = myp_arena_alloc(144);
    if (buf == 0) return 0;
    if (fsStat(path, buf, 0) != 0) return 0;
    return fsIsRegMode(__myp_mem_load_i32(buf + 24));
}
// C: int64_t myp_fs_file_size(const char* path)
long myp_fs_file_size(string path) {
    if (myp_strlen(path) == 0) return 0;
    long buf = myp_arena_alloc(144);
    if (buf == 0) return 0;
    if (fsStat(path, buf, 0) != 0) return 0;
    return __myp_mem_load_i64(buf + 48);
}
// C: int64_t myp_fs_modified_time(const char* path) —— 毫秒
long myp_fs_modified_time(string path) {
    if (myp_strlen(path) == 0) return 0;
    long buf = myp_arena_alloc(144);
    if (buf == 0) return 0;
    if (fsStat(path, buf, 0) != 0) return 0;
    return __myp_mem_load_i64(buf + 88) * 1000;
}

// 目录条目迭代：对每个非 "."/".." 条目调用 cb(nameAddr)。返回命中数。
// fd 由调用方 open 传入（O_RDONLY|O_DIRECTORY）；返回前不 close（调用方负责）。
int fsDirEach(long fd, int wantIndex, int mode, long outName) {
    // mode: 0=只计数, 1=取第 wantIndex 个名写 outName
    long buf = myp_arena_alloc(8192);
    if (buf == 0) return -1;
    int count = 0;
    int found = 0;
    while (true) {
        long r = __myp_syscall(217, fd, buf, 8192, 0, 0, 0);   // getdents64
        if (r <= 0) break;
        long off = 0;
        while (off < r) {
            int reclen = (__myp_mem_load_i8(buf + off + 16) & 0xFF)
                         | ((__myp_mem_load_i8(buf + off + 17) & 0xFF) << 8);
            long name = buf + off + 19;
            int c0 = __myp_mem_load_i8(name);
            int c1 = __myp_mem_load_i8(name + 1);
            int c2 = __myp_mem_load_i8(name + 2);
            if (c0 == '.') {
                if (c1 == 0 || (c1 == '.' && c2 == 0)) {
                    off = off + reclen;
                    continue;   // 跳过 . / ..
                }
            }
            if (mode == 0) {
                count = count + 1;
            } else if (count == wantIndex) {
                __myp_mem_store_i64(outName, name);   // 把命中条目地址回传
                found = 1;
                return 1;
            } else {
                count = count + 1;
            }
            off = off + reclen;
        }
    }
    if (mode == 0) return count;
    return found;   // 0=越界/未命中
}

// C: int32_t myp_fs_list_count(const char* path)
int myp_fs_list_count(string path) {
    if (myp_strlen(path) == 0) return 0;
    long fd = __myp_syscall(2, __myp_str_ptr(path), 0x10000, 0, 0, 0, 0);  // open O_RDONLY|O_DIRECTORY
    if (fd < 0) return 0;
    int n = fsDirEach(fd, 0, 0, 0);
    __myp_syscall(3, fd, 0, 0, 0, 0, 0);
    if (n < 0) return 0;
    return n;
}
// C: char* myp_fs_list_get(const char* path, int32_t index) —— 空串越界
string myp_fs_list_get(string path, int index) {
    if (myp_strlen(path) == 0 || index < 0) return fsEmpty();
    long fd = __myp_syscall(2, __myp_str_ptr(path), 0x10000, 0, 0, 0, 0);
    if (fd < 0) return fsEmpty();
    long nameBuf = myp_arena_alloc(8);
    if (nameBuf == 0) { __myp_syscall(3, fd, 0, 0, 0, 0, 0); return fsEmpty(); }
    int hit = fsDirEach(fd, index, 1, nameBuf);
    __myp_syscall(3, fd, 0, 0, 0, 0, 0);
    if (hit != 1) return fsEmpty();
    return fsStrFrom(__myp_mem_load_i64(nameBuf));
}

// C: char* myp_fs_dirname(const char* path) —— 去掉最后一个 '/' 之后部分
// （无 '/' → "."；路径以 '/' 开头 → "/"）
string myp_fs_dirname(string path) {
    long p = __myp_str_ptr(path);
    long len = myp_strlen(path);
    long last = -1;
    for (long i = 0; i < len; i = i + 1) {
        if (__myp_mem_load_i8(p + i) == '/') last = i;
    }
    if (last < 0) {
        // 无斜杠 → "."
        string s = myp_alloc(2);
        __myp_mem_store_i8(__myp_str_ptr(s), '.');
        __myp_mem_store_i8(__myp_str_ptr(s) + 1, 0);
        return s;
    }
    if (last == 0) {
        // 根 → "/"
        string s = myp_alloc(2);
        __myp_mem_store_i8(__myp_str_ptr(s), '/');
        __myp_mem_store_i8(__myp_str_ptr(s) + 1, 0);
        return s;
    }
    string s = myp_alloc(last + 1);
    __myp_memcpy(__myp_str_ptr(s), p, last);
    __myp_mem_store_i8(__myp_str_ptr(s) + last, 0);
    return s;
}
// C: char* myp_fs_basename(const char* path) —— 最后一个 '/' 之后部分（无 '/' 全串）
string myp_fs_basename(string path) {
    long p = __myp_str_ptr(path);
    long len = myp_strlen(path);
    long last = -1;
    for (long i = 0; i < len; i = i + 1) {
        if (__myp_mem_load_i8(p + i) == '/') last = i;
    }
    long start = last + 1;
    long n = len - start;
    string s = myp_alloc(n + 1);
    __myp_memcpy(__myp_str_ptr(s), p + start, n);
    __myp_mem_store_i8(__myp_str_ptr(s) + n, 0);
    return s;
}
// C: char* myp_fs_join(const char* dir, const char* file) —— dir + "/" + file（防重斜杠）
string myp_fs_join(string dir, string file) {
    long dp = __myp_str_ptr(dir);
    long fp = __myp_str_ptr(file);
    long dl = myp_strlen(dir);
    long fl = myp_strlen(file);
    int needSep = 0;
    if (dl > 0 && __myp_mem_load_i8(dp + dl - 1) != '/') needSep = 1;
    string s = myp_alloc(dl + needSep + fl + 1);
    long sp = __myp_str_ptr(s);
    __myp_memcpy(sp, dp, dl);
    if (needSep != 0) __myp_mem_store_i8(sp + dl, '/');
    __myp_memcpy(sp + dl + needSep, fp, fl);
    __myp_mem_store_i8(sp + dl + needSep + fl, 0);
    return s;
}

// C: int32_t myp_fs_mkdir_p(const char* path) —— mkdir -p；0 成功 / -1 失败
int myp_fs_mkdir_p(string path) {
    long p = __myp_str_ptr(path);
    long len = myp_strlen(path);
    if (len == 0) return -1;
    // 去掉尾部连续 '/'（保留根）
    long end = len;
    while (end > 1 && __myp_mem_load_i8(p + end - 1) == '/') end = end - 1;
    // 用 arena 缓冲逐前缀累积（可写、NUL 结尾），每遇到 '/' 先 mkdir 前缀
    long buf = myp_arena_alloc(end + 1);
    if (buf == 0) return -1;
    long j = 0;
    long i = 0;
    if (__myp_mem_load_i8(p) == '/') {
        __myp_mem_store_i8(buf + j, '/');   // 根前缀
        j = 1;
        i = 1;
    }
    while (i < end) {
        int c = __myp_mem_load_i8(p + i);
        __myp_mem_store_i8(buf + j, c);
        j = j + 1;
        if (c == '/') {
            __myp_mem_store_i8(buf + j, 0);
            long r = __myp_syscall(83, buf, 493, 0, 0, 0, 0);   // mkdir(prefix, 0755=493)
            if (r != 0 && r != -17) return -1;                   // EEXIST=17 可接受
        }
        i = i + 1;
    }
    __myp_mem_store_i8(buf + j, 0);
    long r = __myp_syscall(83, buf, 493, 0, 0, 0, 0);
    if (r != 0 && r != -17) return -1;
    return 0;
}

// C: int32_t myp_fs_remove_recursive(const char* path) —— rm -rf；0 成功 / -1 失败
// 不存在视为成功；lstat 判定（符号链接到目录按文件处理，不递归）。
int myp_fs_remove_recursive(string path) {
    long p = __myp_str_ptr(path);
    long len = myp_strlen(path);
    if (len == 0) return -1;
    long buf = myp_arena_alloc(144);
    if (buf == 0) return -1;
    // lstat via newfstatat + AT_SYMLINK_NOFOLLOW
    long st = __myp_syscall(262, -100, p, buf, 0x100, 0, 0);
    if (st != 0) {
        if (st == -2) return 0;   // ENOENT → 成功
        return -1;
    }
    if (fsIsDirMode(__myp_mem_load_i32(buf + 24)) != 0) {
        long fd = __myp_syscall(2, p, 0x10000, 0, 0, 0, 0);
        if (fd < 0) return -1;
        // 收集条目名（join 后递归删除）
        long buf2 = myp_arena_alloc(8192);
        if (buf2 == 0) { __myp_syscall(3, fd, 0, 0, 0, 0, 0); return -1; }
        int fail = 0;
        while (true) {
            long r = __myp_syscall(217, fd, buf2, 8192, 0, 0, 0);
            if (r <= 0) break;
            long off = 0;
            while (off < r) {
                int reclen = (__myp_mem_load_i8(buf2 + off + 16) & 0xFF)
                             | ((__myp_mem_load_i8(buf2 + off + 17) & 0xFF) << 8);
                long name = buf2 + off + 19;
                int c0 = __myp_mem_load_i8(name);
                int c1 = __myp_mem_load_i8(name + 1);
                int c2 = __myp_mem_load_i8(name + 2);
                if (c0 == '.' && (c1 == 0 || (c1 == '.' && c2 == 0))) {
                    off = off + reclen;
                    continue;
                }
                string child = myp_fs_join(path, fsStrFrom(name));
                if (myp_fs_remove_recursive(child) != 0) { fail = 1; }
                off = off + reclen;
            }
        }
        __myp_syscall(3, fd, 0, 0, 0, 0, 0);
        if (fail != 0) return -1;
        long rr = __myp_syscall(84, p, 0, 0, 0, 0, 0);   // rmdir
        if (rr != 0) return -1;
        return 0;
    }
    long ur = __myp_syscall(87, p, 0, 0, 0, 0, 0);   // unlink
    return ur == 0 ? 0 : -1;
}
