// runtime_myp/num.myp — runtime.c 数字层 myp化（自举编译器编译，MYP 实现）。
// 符号名与 C runtime 一致；shadow 机制同 str.myp（链接时置于 libmyp_rt.a 之前
// + --allow-multiple-definition → MYP 定义优先）。验证见 runtime_myp/build.sh
// + rt_num_test.myp。
//
// 覆盖：整数解析（strtoll/strtoull base-0 语义：跳过空白、可选符号、0x 十六进制 /
// 0 八进制 / 十进制）+ 整数/布尔格式化（itoa，INT32/64_MIN、u32/u64 最大值安全）。
// float/double 解析（strtod/atof）与格式化（%g）依赖 libc，另立里程碑（TODO）。
//
// 注意：函数体内不得用字符串 == / < / Str.len（会递归调用自身/运行时）。

ffi string myp_alloc(long size);
ffi int myp_strlen(string s);

// strtoll/strtoull base-0 解析：跳过空白、可选符号、0x 十六进制 / 0 八进制 / 十进制。
// 返回 i64 位模式；无有效数字回 0。溢出按 i64 回绕（= strtoull 位语义；strtoll
// 超范围 C 会饱和——自举/常规输入都在范围内，差异可接受）。
long myp_parse_base0(string s) {
    int len = myp_strlen(s);
    int i = 0;
    while (i < len) {
        int c = __myp_charcode(s, i);
        if (c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12) i = i + 1;
        else break;
    }
    int neg = 0;
    if (i < len) {
        int c = __myp_charcode(s, i);
        if (c == 45) { neg = 1; i = i + 1; }     // '-'
        else if (c == 43) i = i + 1;             // '+'
    }
    int base = 10;
    if (i + 1 < len) {
        int c0 = __myp_charcode(s, i);
        int c1 = __myp_charcode(s, i + 1);
        if (c0 == 48 && (c1 == 120 || c1 == 88)) { base = 16; i = i + 2; }  // 0x/0X
        else if (c0 == 48) { base = 8; i = i + 1; }                          // 前导 0 → 八进制
    } else if (i < len && __myp_charcode(s, i) == 48) {
        base = 8;
        i = i + 1;
    }
    long v = 0;
    int any = 0;
    while (i < len) {
        int c = __myp_charcode(s, i);
        int d = -1;
        if (c >= 48 && c <= 57) d = c - 48;
        else if (base == 16 && c >= 97 && c <= 102) d = c - 87;   // a-f
        else if (base == 16 && c >= 65 && c <= 70) d = c - 55;    // A-F
        if (d < 0 || d >= base) break;
        v = v * base + d;
        any = 1;
        i = i + 1;
    }
    if (any == 0) return 0;
    if (neg != 0) v = -v;
    return v;
}

// C: int64_t myp_str_to_long(const char* s) —— strtoll base-0
long myp_str_to_long(string s) {
    return myp_parse_base0(s);
}

// C: int32_t myp_str_parse_int(const char* s) —— strtoll base-0，截 i32
int myp_str_parse_int(string s) {
    return int(myp_parse_base0(s));
}

// C: uint32_t myp_str_to_uint(const char* s) —— strtoull base-0，截 i32
int myp_str_to_uint(string s) {
    return int(myp_parse_base0(s));
}

// C: uint64_t myp_str_to_ulong(const char* s) —— strtoull base-0
long myp_str_to_ulong(string s) {
    return myp_parse_base0(s);
}

// C: int32_t myp_str_parse_int_opt(const char* s, bool* ok) —— strtoll base-0，
// *ok = 是否有有效数字（区分"合法 0"与"解析失败"）。编译器内建 `parseIntOpt(s)`
// 发射 `call i32 @myp_str_parse_int_opt(ptr %s, ptr %ok)`；MYP 版用 **long 参数**
// （指针地址承载）——ABI 兼容：ptr 与 i64 同为 64 位、rdi/rsi 传参，链接按名解析
// 到本定义，无需改编译器。s/ok 经 raw-memory 读写。
// 镜像 myp_parse_base0 的 base-0 语义 + 有效性跟踪（前导 '0' 八进制时 '0' 本身是
// 数字 → any=1，使 "0"/"077" 判有效）。
int myp_str_parse_int_opt(long s, long ok) {
    if (s == 0) {
        if (ok != 0) __myp_mem_store_i8(ok, 0);
        return 0;
    }
    long p = s;
    long i = 0;
    while (true) {
        int c = __myp_mem_load_i8(p + i);
        if (c == 0) break;
        if (c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12) i = i + 1;
        else break;
    }
    int neg = 0;
    int sc = __myp_mem_load_i8(p + i);
    if (sc == 45) { neg = 1; i = i + 1; }        // '-'
    else if (sc == 43) i = i + 1;                // '+'
    int base = 10;
    int any = 0;
    int c0 = __myp_mem_load_i8(p + i);
    int c1 = __myp_mem_load_i8(p + i + 1);
    if (c0 == 48 && (c1 == 120 || c1 == 88)) { base = 16; i = i + 2; }   // 0x/0X
    else if (c0 == 48) { base = 8; i = i + 1; any = 1; }                 // 前导 0 → 八进制（'0' 是数字）
    long v = 0;
    while (true) {
        int c = __myp_mem_load_i8(p + i);
        if (c == 0) break;
        int d = -1;
        if (c >= 48 && c <= 57) d = c - 48;
        else if (base == 16 && c >= 97 && c <= 102) d = c - 87;          // a-f
        else if (base == 16 && c >= 65 && c <= 70) d = c - 55;           // A-F
        if (d < 0 || d >= base) break;
        v = v * base + d;
        any = 1;
        i = i + 1;
    }
    if (ok != 0) __myp_mem_store_i8(ok, any != 0 ? 1 : 0);
    if (any == 0) return 0;
    if (neg != 0) v = -v;
    return int(v);
}

// ---- 格式化（itoa，2 位查表法；mirror runtime.c myp_itoa_common）----
// u 为无符号幅值（ulong 运算 → udiv/urem，INT64_MIN 位模式也能正确出数字）。
// v3.15.184：单次分配——先算位数直接填结果（消除 tmp 缓冲 myp_alloc(25)），
// strcat 热点（int→string 每转换省 1 次 arena 分配）。
string myp_itoa_common(ulong u, int neg) {
    // 位数（十进制）
    int n = 1;
    ulong t = u;
    while (t >= 10) { t = t / 10; n = n + 1; }
    int total = n;
    if (neg != 0) total = total + 1;
    string r = myp_alloc(total + 1);
    long rp = __myp_str_ptr(r);
    int pos = total;
    __myp_mem_store_i8(rp + pos, 0);   // 终止符
    // 从尾部 2 位一组填充（个位在前；最高位单个数字时只填一个）
    while (true) {
        ulong d = u % 100;
        u = u / 100;
        pos = pos - 1;
        __myp_mem_store_i8(rp + pos, 48 + int(d % 10));
        if (u == 0 && d < 10) break;   // 最高位单个数字（含 u==0 情况）
        pos = pos - 1;
        __myp_mem_store_i8(rp + pos, 48 + int(d / 10));
        if (u == 0) break;
    }
    if (neg != 0) {
        pos = pos - 1;
        __myp_mem_store_i8(rp + pos, 45);
    }
    return r;
}

// C: char* myp_to_string_i32(int32_t val)
string myp_to_string_i32(int val) {
    long a = long(val);
    int neg = 0;
    if (a < 0) { neg = 1; a = -a; }
    return myp_itoa_common(ulong(a), neg);
}

// C: char* myp_to_string_i64(int64_t val) —— INT64_MIN 安全（-a 回绕后按位重释为幅值）
string myp_to_string_i64(long val) {
    int neg = 0;
    long a = val;
    if (a < 0) { neg = 1; a = -a; }
    return myp_itoa_common(ulong(a), neg);
}

// string + int 组合（v3.15.185）：单次分配复制 prefix + 填整数十进制，替代
// myp_to_string_* + myp_strcat 两调用两分配（strcat 热点，追 Go Itoa 快路径）。
// signed=1 有符号（负号处理），0 无符号。
string myp_itoa_concat(string prefix, long val, int signed) {
    int plen = myp_strlen(prefix);   // O(1) 读头
    long u = long(val);
    int neg = 0;
    if (signed != 0 && u < 0) { neg = 1; u = -u; }
    int nd = 1;
    ulong t = ulong(u);
    while (t >= 10) { t = t / 10; nd = nd + 1; }
    int total = plen + nd + neg;
    string r = myp_alloc(total + 1);
    long rp = __myp_str_ptr(r);
    __myp_memcpy(rp, __myp_str_ptr(prefix), plen);
    int pos = total;
    __myp_mem_store_i8(rp + pos, 0);   // 终止符
    ulong uu = ulong(u);
    while (true) {
        ulong d = uu % 100;
        uu = uu / 100;
        pos = pos - 1;
        __myp_mem_store_i8(rp + pos, 48 + int(d % 10));
        if (uu == 0 && d < 10) break;
        pos = pos - 1;
        __myp_mem_store_i8(rp + pos, 48 + int(d / 10));
        if (uu == 0) break;
    }
    if (neg != 0) {
        pos = pos - 1;
        __myp_mem_store_i8(rp + pos, 45);
    }
    return r;
}

long myp_two_32() { return long(1) << 32; }

// B3 (v3.16.11): 扁平字符串拼接链单次分配。desc = n×16B 段描述符数组
// （codegen 生成，栈上，i64 对齐）：每段 {i64 kind; i64 val}：
//   kind 0 = string 段（val = data 地址；长度 O(1) 读 data-12 计数头）
//   kind 1 = 有符号 i64 段（val = 值，负号处理）
//   kind 2 = 无符号 i64 段（val = 位模式按无符号十进制）
// 返回新计数串（内容 = 各段顺序拼接；与 myp_itoa_concat/myp_strcat 语义一致）。
// 不消费/不 retain 各 string 段——调用方 fresh 临时照常语句末释放、字面量全局
// 不释放（同 strcat 借用）。替代 N 段链的 N 次分配+全量拷贝（strcat 热点）。
string myp_str_cat_parts(long n, long desc) {
    // pass 1：总长
    long total = 0;
    for (long i = 0; i < n; i = i + 1) {
        long k = __myp_mem_load_i64(desc + i * 16);
        long v = __myp_mem_load_i64(desc + i * 16 + 8);
        if (k == 0) {
            if (v != 0) total = total + long(__myp_mem_load_i32(v - 12));
        } else {
            long u = v;
            int neg = 0;
            if (k == 1 && u < 0) { neg = 1; u = -u; }
            ulong t = ulong(u);
            long nd = 1;
            while (t >= 10) { t = t / 10; nd = nd + 1; }
            total = total + nd + neg;
        }
    }
    string r = myp_alloc(total + 1);
    long rp = __myp_str_ptr(r);
    long pos = 0;
    for (long i = 0; i < n; i = i + 1) {
        long k = __myp_mem_load_i64(desc + i * 16);
        long v = __myp_mem_load_i64(desc + i * 16 + 8);
        if (k == 0) {
            if (v != 0) {
                long sl = long(__myp_mem_load_i32(v - 12));
                __myp_memcpy(rp + pos, v, sl);
                pos = pos + sl;
            }
        } else {
            long u = v;
            int neg = 0;
            if (k == 1 && u < 0) { neg = 1; u = -u; }
            ulong t = ulong(u);
            long nd = 1;
            while (t >= 10) { t = t / 10; nd = nd + 1; }
            long seg = nd + neg;
            ulong uu = ulong(u);
            long p = pos + seg;          // 段右端（排他）
            while (true) {
                ulong d = uu % 100;
                uu = uu / 100;
                p = p - 1;
                __myp_mem_store_i8(rp + p, 48 + int(d % 10));
                if (uu == 0 && d < 10) break;
                p = p - 1;
                __myp_mem_store_i8(rp + p, 48 + int(d / 10));
                if (uu == 0) break;
            }
            if (neg != 0) { p = p - 1; __myp_mem_store_i8(rp + p, 45); }
            pos = pos + seg;
        }
    }
    __myp_mem_store_i8(rp + total, 0);
    return r;
}

// C: char* myp_to_string_u32(uint32_t val) —— 位模式按无符号十进制
string myp_to_string_u32(int val) {
    long a = long(val);
    ulong u;
    if (a < 0) u = ulong(myp_two_32() + a);
    else u = ulong(a);
    return myp_itoa_common(u, 0);
}

// C: char* myp_to_string_u64(uint64_t val) —— 位模式按无符号十进制
string myp_to_string_u64(long val) {
    return myp_itoa_common(ulong(val), 0);
}

// C: char* myp_to_string_bool(int32_t val) —— "true"/"false"
string myp_to_string_bool(int val) {
    string s = "true";
    int l = 4;
    if (val == 0) { s = "false"; l = 5; }
    string r = myp_alloc(l + 1);
    __myp_memcpy(__myp_str_ptr(r), __myp_str_ptr(s), l);
    __myp_mem_store_i8(__myp_str_ptr(r) + l, 0);
    return r;
}

// C: char* myp_fmt_u64_base(int32_t v, int32_t base, int32_t upper)
//    —— v 的 32 位位型按无符号在给定进制(2..16)输出；upper=1 用大写 hex 数字。
//    Fmt.u/x/X/o/b 均走这里（0xFFFFFFFF → "ffffffff"）。
string myp_fmt_u64_base(int v, int base, int upper) {
    if (base < 2 || base > 16) base = 10;
    long a = long(v);
    ulong u;
    if (a < 0) u = ulong(myp_two_32() + a);
    else u = ulong(a);
    if (u == 0) {
        string r = myp_alloc(2);
        __myp_mem_store_i8(__myp_str_ptr(r), 48);
        __myp_mem_store_i8(__myp_str_ptr(r) + 1, 0);
        return r;
    }
    string tmp = myp_alloc(40);          // 32 位二进制最多 32 位 + 终止
    long tp = __myp_str_ptr(tmp);
    int pos = 39;
    int n = 0;
    while (u != 0) {
        int d = int(u % ulong(base));
        u = u / ulong(base);
        pos = pos - 1;
        if (d < 10) __myp_mem_store_i8(tp + pos, 48 + d);
        else __myp_mem_store_i8(tp + pos, (upper != 0 ? 65 : 97) + d - 10);
        n = n + 1;
    }
    string r = myp_alloc(n + 1);
    __myp_memcpy(__myp_str_ptr(r), tp + long(pos), n);
    __myp_mem_store_i8(__myp_str_ptr(r) + n, 0);
    return r;
}

// C: char* myp_f64_bits_hex(double v) —— 0x + 16 大写 hex（LLVM 文本 IR 浮点常量
// 格式，与 LLVM ConstantFP 打印一致）。自举 codegen 发射 double 常量时调用。
// 用 bitcast<T,U> 内建（LLVM bitcast 指令）取 64 位位型。
string myp_f64_bits_hex(double v) {
    long bits = bitcast<long>(v);
    ulong u = ulong(bits);
    string r = myp_alloc(19);            // "0x" + 16 hex + NUL
    long dp = __myp_str_ptr(r);
    __myp_mem_store_i8(dp, 48);          // '0'
    __myp_mem_store_i8(dp + 1, 120);     // 'x'
    for (int i = 0; i < 16; i = i + 1) {
        int shift = 60 - 4 * i;
        int d = int((u >> ulong(shift)) & 15);
        if (d < 10) __myp_mem_store_i8(dp + 2 + i, 48 + d);
        else __myp_mem_store_i8(dp + 2 + i, 55 + d);   // 'A'-'F'
    }
    __myp_mem_store_i8(dp + 18, 0);
    return r;
}

// C: char* myp_f32_bits_hex(float v) —— float 先精确拓宽为 double 再取 64 位位型
string myp_f32_bits_hex(float v) {
    double d = double(v);
    return myp_f64_bits_hex(d);
}
