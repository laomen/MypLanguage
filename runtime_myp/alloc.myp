// runtime_myp/alloc.myp — 内存核心 MYP 化（#13）：
// mmap bump arena + 分配/释放集群 shadow C runtime。shadow 机制同 str.myp
//（--shared 外部符号，链接时置于 libmyp_rt.a 前 → 定义优先）。
//
// MYP 对象布局与 C 一致（C 另有 16B 侵入链表 node——本模块跳过，C 链表恒空，
// 进程退出 myp_free_alloc_list_global 只清自己的空链表，无副作用）：
//   - 字符串/类对象：8B 头 { rc:u32, type_id:u32 } 在 data-8/data-4
//   - 数组/切片 backing：24B 头 { count:u64, elem_size:u32, pad:u32,
//     rc:u32, type_id:u32 }，rc/type_id 仍在 data-8/-4
//   - MYP_ARR_TYPE_ID=0xFFFFFFFF（int -1）；MYP_STR_TYPE_ID=0xFFFFFFFE（int -2）
//
// 类对象分支（weak 通知 + 每程序 __myp_release_table 分发）已全 MYP 化（2026-08-25）：
// `myp_release_class_obj_ex` 本模块实现——经 `__myp_rtable_addr`（取程序生成的
// @__myp_release_table 基址，外部引用 + 程序 .o 在前 → 程序表胜出）+
// `__myp_call_ptr`（间接调用表里的 destroy stub）绕过「MYP 无 extern 全局/裸函数指针
// 调用」缺口。weak 通知走 weak.myp（myp_weak_notify_death）。

// ---- mmap bump arena ----
// chunk 头 32B：[next:i64 @0][cap:i64 @8][used:i64 @16][pad @24]，data 从 +32
//（16 对齐）。mmap 页对齐 → data 16 对齐；每次分配再对齐到 16。超大分配独占
// 一块；bump 永不归还内存（进程退出由 OS 回收）——与 C 的 arena 模型一致。
// 跨模块调用：weak.myp 的死亡通知（null 观察此对象的弱槽）+ diag.myp 的
// type_live 计数与 fail_alloc 注入（包 B）
ffi int myp_weak_notify_death(string obj);
ffi void myp_type_live_inc(int tid);
ffi void myp_type_live_dec(int tid);
ffi void myp_fail_alloc_check();

@static class Arena {
    property:
        long cur = 0;      // 当前 chunk 头地址（0 = 未初始化）
        long head = 0;     // 首个 chunk（未来 bulk munmap）
        long cur_used = 0;
        long cur_cap = 0;
        long total_used = 0;    // 累计 bump 字节（诊断 myp_diag_arena_used 用）
        long last_base = 0;     // 最后一次分配的 bump 基址（字符串拼接原地扩展用）
        long last_aligned = 0;  // 最后一次分配的 16 对齐大小
}
@static class Live {
    property:
        long strings = 0;
        long objects = 0;
        long arrays = 0;
}

// C: myp_arena_bump_alloc —— 从 mmap bump arena 取 size 字节，返回 16 对齐地址。
// 失败（mmap 错误）返回 0。grow=1：新 chunk 按 2x 预留（字符串拼接增长用——回退
// 拷贝后需增长头，否则每涨 16B 就回退重拷整串 → O(N²)+内存爆炸）。
long myp_arena_alloc_ex(long size, int grow) {
    myp_fail_alloc_check();   // 包 B：确定性注入点（第 at 次 bump 分配）
    if (size < 1) size = 1;
    long a = size + 15;
    a = a - (a % 16);                    // 向上取整到 16
    if (Arena.cur == 0 || Arena.cur_used + a > Arena.cur_cap) {
        long cap = a;
        if (cap < 65536) cap = 65536;
        if (grow != 0 && a > 65536) cap = a * 2;   // 大分配倍增头（拼接增长）
        long c = __myp_syscall(9, 0, 32 + cap, 3, 0x22, -1, 0);  // mmap
        if (c == -1 || c == 0) return 0;  // OOM
        __myp_mem_store_i64(c, Arena.cur);     // next
        __myp_mem_store_i64(c + 8, cap);
        __myp_mem_store_i64(c + 16, 0);        // used
        if (Arena.cur == 0) Arena.head = c;
        Arena.cur = c;
        Arena.cur_used = 0;
        Arena.cur_cap = cap;
    }
    long p = Arena.cur + 32 + Arena.cur_used;
    Arena.last_base = p;
    Arena.last_aligned = a;
    Arena.cur_used = Arena.cur_used + a;
    Arena.total_used = Arena.total_used + a;
    return p;
}
long myp_arena_alloc(long size) { return myp_arena_alloc_ex(size, 0); }

// C: int64_t myp_diag_arena_reserved/used —— 诊断（Memory.arenaReserved/Used）。
// reserved：遍历 chunk 链表累计总预留。⚠️ 链方向 = 新→旧（新 chunk 的 next@0 指向
// 旧 chunk，`if (Arena.cur == 0) Arena.head = c` 只记最旧 chunk）→ 必须从 **Arena.cur
// （最新）** 走 next 链（C 版 `for (c = myp_arena_cur; c; c = c->next)`）。旧实现从
// head（最旧）走只统计第一个 chunk —— 多 chunk（如 evInit 一次 ~550KB）时 reserved
// 低估 → used > reserved 诊断误报（#41 暴露的潜伏 bug）。
// used：MYP arena 只维护 Arena.cur_used（当前 chunk）+ total_used（累计 bump），
// 不写每 chunk 的 used@16（C 版逐 chunk 读 used 字段——MYP 无此维护）→ 直接用
// total_used。bump 永不归还（region 自己管），total_used 即当前已用。
long myp_diag_arena_reserved() {
    long total = 0;
    long c = Arena.cur;
    while (c != 0) {
        total = total + __myp_mem_load_i64(c + 8);   // cap
        c = __myp_mem_load_i64(c);                   // next = 更旧 chunk
    }
    return total;
}
long myp_diag_arena_used() {
    return Arena.total_used;
}

// MYP 拼接层辅助（str.myp myp_str_append 原地扩展）：若 base 是 arena 最后一次
// 分配且当前 chunk 能扩展到 new_aligned 字节，则 bump 前移并返回 1，否则 0。
// base 是原始 bump 地址（字符串 = data-12）；new_aligned 为 16 对齐后的目标总大小。
int myp_arena_try_extend(long base, long newAligned) {
    if (Arena.cur == 0) return 0;
    if (Arena.last_base != base) return 0;
    long extra = newAligned - Arena.last_aligned;
    if (extra < 0) return 0;
    if (Arena.cur_used + extra > Arena.cur_cap) return 0;
    Arena.cur_used = Arena.cur_used + extra;
    Arena.total_used = Arena.total_used + extra;
    Arena.last_aligned = newAligned;
    return 1;
}

// ---- 分配器集群 ----
// C: void* myp_alloc(size_t size) —— 计数字符串 {rc=1, type_id=STR} + 字节
// 注意：MYP 分配器须符合自举 ARC 返回约定——`return __myp_addr_to_str(...)`
// 不是 fresh（内建不加 fresh temp）→ codegen 对 return 发射 retain-on-return
// (+1)。因此内部 rc 设 0，让该 retain 补成 1（等价正常代码 new 后 return 的净
// rc=1）。若设 1 会被 return 再 +1 → 净 rc=2（调用方 release 到 1 不归零=泄漏）。
string myp_alloc(long size) {
    long base = myp_arena_alloc(12 + size);
    if (base == 0) return "";   // OOM（MYP 惯例：空串替代 NULL）
    __myp_mem_store_i32(base, int(size - 1));   // len = size-1（不含 NUL，data-12）
    __myp_mem_store_i32(base + 4, 0);           // rc=0（return 时 retain-on-return → 1）
    __myp_mem_store_i32(base + 8, -2);          // type_id = 0xFFFFFFFE
    Live.strings = Live.strings + 1;
    return __myp_addr_to_str(base + 12);        // data
}

// 字符串拼接增长分配（str.myp myp_str_append 回退路径专用）：同 myp_alloc，但新
// chunk 按 2x 预留增长头——回退拷贝后的字符串仍需原地扩展（s=s+x 快路径），若
// chunk 刚好够则每涨 16B 回退重拷整串 → O(N²) + 内存爆炸（实测 500k 累积 7.5GB）。
// 2x 头 → 回退点几何递增（64K/128K/256K...）→ 摊销 O(N) 总拷贝。
string myp_alloc_str_grow(long size) {
    long base = myp_arena_alloc_ex(12 + size, 1);
    if (base == 0) return "";
    __myp_mem_store_i32(base, int(size - 1));
    __myp_mem_store_i32(base + 4, 0);
    __myp_mem_store_i32(base + 8, -2);
    Live.strings = Live.strings + 1;
    return __myp_addr_to_str(base + 12);
}

// C: void* myp_alloc_object(size_t size, uint32_t type_id)
string myp_alloc_object(long size, int type_id) {
    long base = myp_arena_alloc(8 + size);
    if (base == 0) return "";   // OOM
    __myp_mem_store_i32(base, 0);          // rc=0（return retain-on-return → 1）
    __myp_mem_store_i32(base + 4, type_id);
    Live.objects = Live.objects + 1;
    myp_type_live_inc(type_id);   // 包 B：per-type 计数
    return __myp_addr_to_str(base + 8);
}

// C: void* myp_alloc_class_array(uint64_t count, uint32_t elem_size)
string myp_alloc_class_array(long count, int elem_size) {
    long bytes = count * elem_size;
    long base = myp_arena_alloc(24 + bytes);
    if (base == 0) return "";   // OOM
    __myp_mem_store_i64(base, count);
    __myp_mem_store_i32(base + 8, elem_size);
    __myp_mem_store_i32(base + 12, 0);   // pad = CLASS（逐元素 release）
    __myp_mem_store_i32(base + 16, 0);   // rc=0（return retain-on-return → 1）
    __myp_mem_store_i32(base + 20, -1);  // type_id = 0xFFFFFFFF (ARR)
    Live.arrays = Live.arrays + 1;
    return __myp_addr_to_str(base + 24);
}

// C: void* myp_alloc_slice_backing(uint64_t count, uint32_t elem_size,
//                                  uint32_t elem_kind)
string myp_alloc_slice_backing(long count, int elem_size, int elem_kind) {
    long bytes = count * elem_size;
    long base = myp_arena_alloc(24 + bytes);
    if (base == 0) return "";   // OOM
    __myp_mem_store_i64(base, count);
    __myp_mem_store_i32(base + 8, elem_size);
    __myp_mem_store_i32(base + 12, elem_kind);   // pad = elem_kind
    __myp_mem_store_i32(base + 16, 0);   // rc=0（return retain-on-return → 1）
    __myp_mem_store_i32(base + 20, -1);
    Live.arrays = Live.arrays + 1;
    return __myp_addr_to_str(base + 24);
}

// ---- 释放 ----
// C: uint32_t myp_release(void* obj) —— fetch_sub 返回旧值；rc→0 按 type_id 分发。
// 类对象分支委托 C helper（weak 通知 + release_table + myp_free_object，
// myp_free_object 经 --allow-multiple-definition interpose 回本模块）。
int myp_release(string obj) {
    long addr = __myp_str_ptr(obj);
    if (addr == 0) return 0;
    int old = __myp_atomic_sub_i32_addr(addr - 8, 1);  // fetch_sub
    if (old == 0) { __myp_atomic_store_i32_addr(addr - 8, 0); return 0; }  // underflow 安全
    int nv = old - 1;
    if (nv != 0) return nv;
    int tid = __myp_mem_load_i32(addr - 4);
    if (tid == -1) {
        // 数组/切片 backing 头（data 相对偏移）：count@-24, elem_size@-16,
        // pad@-12, rc@-8, type_id@-4（pad 是 -12 非 -16，-16 是 elem_size！）
        long count = __myp_mem_load_i64(addr - 24);
        int elem_size = __myp_mem_load_i32(addr - 16);
        int pad = __myp_mem_load_i32(addr - 12);
        if (pad == 2) {   // 元素 = slice 胖指针 {data,len} → 释放 data
            for (long i = 0; i < count; i = i + 1) {
                long inner = __myp_mem_load_i64(addr + i * elem_size);
                myp_release(__myp_addr_to_str(inner));
            }
        } else if (pad == 0) {   // 元素 = 类引用 → 逐元素 release
            for (long i = 0; i < count; i = i + 1) {
                long inner = __myp_mem_load_i64(addr + i * 8);
                myp_release(__myp_addr_to_str(inner));
            }
        }
        // MYP_ARR_ELEM_SCALAR(pad==1)：无逐元素释放
        if (Live.arrays > 0) Live.arrays = Live.arrays - 1;
    } else if (tid == -2) {
        if (Live.strings > 0) Live.strings = Live.strings - 1;
    } else {
        // 类对象：先 MYP 弱通知（null 本注册表弱槽）。并发 weak_load 在锁内重新
        // bump rc → 返回 0（对象存活，新持有者负责释放）。存活则移交
        // myp_release_class_obj_ex 继续分发（其内部会再次 weak 通知，同 C 版语义）。
        if (myp_weak_notify_death(obj) == 0) {
            return __myp_atomic_load_i32_addr(addr - 8);
        }
        myp_release_class_obj_ex(obj);   // weak + release_table 分发 + free
    }
    return 0;
}

// C: void myp_free_object(void* obj) —— destroy stub 最终调用（interpose 到本
// 模块）。bump arena 不归还内存，仅维护存活计数。
void myp_free_object(string obj) {
    long addr = __myp_str_ptr(obj);
    if (addr == 0) return;
    int tid = __myp_mem_load_i32(addr - 4);
    if (Live.objects > 0) Live.objects = Live.objects - 1;
    myp_type_live_dec(tid);   // 包 B：per-type 计数回落
}

// C: void myp_release_class_obj_ex(void* obj) —— 类对象 rc→0 后的分发（原 C helper，
// 2026-08-25 全 MYP 化，不再委托 C）：weak 通知 → 查程序生成的 __myp_release_table
// [tid]（经 __myp_rtable_addr 外部引用）→ __myp_call_ptr 间接调 destroy stub（级联
// 释放引用字段 + 调 myp_free_object）；无 stub（tid<=0）→ 直接 myp_free_object。
// 并发 weak_load 在锁内重新 bump rc → 返回 0（对象存活，新持有者负责释放）。
void myp_release_class_obj_ex(string obj) {
    long addr = __myp_str_ptr(obj);
    if (addr == 0) return;
    if (myp_weak_notify_death(obj) == 0) return;   // 弱观察者存活 → 不释放
    int tid = __myp_mem_load_i32(addr - 4);
    if (tid > 0) {
        long table = __myp_rtable_addr();
        long stub = __myp_mem_load_i64(table + long(tid) * 8);
        if (stub != 0) {
            __myp_call_ptr(stub, obj);   // destroy stub（级联释放 + myp_free_object）
            return;
        }
    }
    myp_free_object(obj);
}

// ---- M9 诊断计数（进程级，替代 C TLS；仅计数，无 per-type）----
long myp_live_string_count() { return Live.strings; }
long myp_live_object_count() { return Live.objects; }
long myp_live_array_count() { return Live.arrays; }
long myp_live_total_count() { return Live.strings + Live.objects + Live.arrays; }

// ---- 进程退出清理（#42 薄层：shadow C myp_free_all 链，去掉 C 清理依赖）----
// C: void myp_arena_free_all(void) —— munmap 全部 bump arena chunk 并复位。
//    MYP 版**只复位 Arena 状态、不 munmap**：MYP arena 是进程级 mmap，进程退出时
//    OS 自动回收；退出时显式 munmap 会与 main epilogue 的 ARC release（codegen 在
//    myp_free_all 之后仍有释放）以及 C atexit 产生 UAF（实测 rt_str_test 段错误
//    139）。C 版对 C arena 的时序有 pthread-key 析构保证，MYP 无此保证 → reset-only。
void myp_arena_free_all() {
    Arena.cur = 0;
    Arena.head = 0;
    Arena.cur_used = 0;
    Arena.cur_cap = 0;
    Arena.total_used = 0;
    Arena.last_base = 0;
    Arena.last_aligned = 0;
}

// C: void myp_free_all(void) —— codegen 在 main() 退出 epilogue 调用；释放进程级
//    资源。MYP 版：级联释放 class slice backing → 释放 region chunk → munmap
//    bump arena。MYP 无 C 的 alloc 跟踪链表/weak 表/capture 缓冲 → 无需对应清理；
//    C 的 myp_restore_term/myp_arena_free_all/myp_free_alloc_list_global/
//    myp_weak_free_all/__myp_coro_cleanup_all 等只剩本函数调用 → 变死代码被
//    --gc-sections 剥离。
ffi void myp_release_class_slices_from_depth(long depth);   // region.myp
ffi void myp_region_free_all();                             // region.myp
ffi void myp_restore_term();                                // term.myp（raw 模式还原）
void myp_free_all() {
    myp_restore_term();
    myp_release_class_slices_from_depth(0);
    myp_region_free_all();
    myp_arena_free_all();
}
