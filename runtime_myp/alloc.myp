// runtime_myp/alloc.myp — 内存核心 MYP 化（#13）：
// mmap bump arena + 分配/释放集群 shadow C runtime。shadow 机制同 str.myp
//（--shared 外部符号，链接时置于 libmyp_rt.a 前 → 定义优先）。
//
// MYP 对象布局与 C 一致（C 另有 16B 侵入链表 node——本模块跳过，C 链表恒空，
// 进程退出 myp_free_alloc_list_global 只清自己的空链表，无副作用）：
//   - 字符串/类对象：8B 头 { rc:u32, type_id:u32 } 在 data-8/data-4
//   - 数组/切片 backing：24B 头 { count:u64, elem_size:u32, pad:u32,
//     rc:u32, type_id:u32 }，rc/type_id 仍在 data-8/-4
//   - MYP_ARR_TYPE_ID=0xFFFFFFFF（int -1）；MYP_STR_TYPE_ID=0xFFFFFFFE（int -2）
//
// 类对象分支（weak 通知 + 每程序 __myp_release_table 分发）已全 MYP 化（2026-08-25）：
// `myp_release_class_obj_ex` 本模块实现——经 `__myp_rtable_addr`（取程序生成的
// @__myp_release_table 基址，外部引用 + 程序 .o 在前 → 程序表胜出）+
// `__myp_call_ptr`（间接调用表里的 destroy stub）绕过「MYP 无 extern 全局/裸函数指针
// 调用」缺口。weak 通知走 weak.myp（myp_weak_notify_death）。

// ---- mmap bump arena ----
// chunk 头 32B：[next:i64 @0][cap:i64 @8][used:i64 @16][pad @24]，data 从 +32
//（16 对齐）。mmap 页对齐 → data 16 对齐；每次分配再对齐到 16。超大分配独占
// 一块；bump 永不归还内存（进程退出由 OS 回收）——与 C 的 arena 模型一致。
// 跨模块调用：weak.myp 的死亡通知（null 观察此对象的弱槽）+ diag.myp 的
// type_live 计数与 fail_alloc 注入（包 B）
ffi int myp_weak_notify_death(string obj);
ffi void myp_type_live_inc(int tid);
ffi void myp_type_live_dec(int tid);
ffi void myp_fail_alloc_check();

@static class Arena {
    property:
        long cur = 0;      // 全局最新 chunk（cycle collector 地址校验）
        long lockS = 0;    // 仅保护新 chunk 挂入全局链
}
@static @thread class ALocal {
    property:
        long cur = 0;      // 当前线程 chunk 头地址（0 = 未初始化）
        long cur_used = 0;
        long cur_cap = 0;
        long total_used = 0;    // 累计 bump 字节（诊断 myp_diag_arena_used 用）
        long last_base = 0;     // 最后一次分配的 header base（字符串拼接原地扩展用）
        long last_aligned = 0;  // 最后一次分配的 16 对齐大小
        long freeHead = 0;
        // size-class 分桶——2 幂大小类 (32..32768+，16 类) 各一空闲
        // 链表。块按 stored 归 class，分配按 req 的 class 起找（O(1) 链表头）。
        long[16] freeLists;
}
// Arena 自旋锁只保护新 chunk 挂入全局链；每线程 bump/free-list 在 ALocal 中无锁。
// 锁字 mmap 直分配（arena 锁不能依赖 arena）。用 atomic_add 返回旧值（0=获取），
// 临界区仅发布链表头数行，避免 futex wake syscall。
void arenaLockInit() {
    if (Arena.lockS == 0) {
        long p = __myp_syscall(9, 0, 4, 3, 0x22, -1, 0);
        if (p != -1 && p != 0) {
            __myp_mem_store_i32(p, 0);
            Arena.lockS = p;
        }
    }
}
void arenaLock() {
    arenaLockInit();
    if (Arena.lockS == 0) return;
    while (__myp_atomic_add_i32_addr(Arena.lockS, 1) != 0) { }
}
void arenaUnlock() {
    if (Arena.lockS == 0) return;
    __myp_atomic_store_i32_addr(Arena.lockS, 0);
}
// LIFO 回收：释放的块若是当前**最后一次 bump 分配**（ALocal.last_base 匹配）→ 回退
// cur_used/total_used（空间被下次分配复用）。纯 bump 不回收的高频临时分配模式
// （alloc_arr 的 `new T[n]` 循环、json 解析树、file_io 临时串）由此线性累积归零。
// last_base/last_aligned 属于当前线程 ALocal；只在 rc→0 释放路径调用。
// 释放回收：块若是当前**最后一次 bump 分配**（last_base 匹配，即 bump
// tail）→ LIFO 回退 cur_used（空间复用，高频临时分配如 alloc_arr 循环归零）；否则入
// **空闲链表**（首适复用，覆盖非 LIFO churn 如 json 解析树/文件 IO 临时串）。
// base0 = 块基址（含 8B total 前缀）。⚠️ 复用块（空闲链表弹出）last_base 置 0 → 禁
// LIFO（其不在 bump tail，回退会损坏 cur_used）——再释放时走空闲链表。
void arenaReclaim(long base0) {
    // ⚠️ LIFO 检查保持 `== base0`（last_base 是 header base=base0+8，永不匹配=死
    // 代码）：曾改成 `== base0+8` 让 LIFO 真正生效 → ch9 tryLock 状态损坏/ch11 挂起
    // （LIFO 回退 cur_used 后该空间被立即复用，若块仍被引用则破坏数据——跨分配序列
    // 下"last_base 匹配"不足以证明块确已死亡）。回收统一走**空闲链表**（首适复用；
    // alloc_arr 201MB→1.9MB / file_io 920MB→40MB / json 311MB→9.7MB 收益全部来自
    // 空闲链表，LIFO 非必要且有害，保持死代码）。
    if (ALocal.last_base == base0) {
        if (ALocal.cur_used >= ALocal.last_aligned) {
            ALocal.cur_used = ALocal.cur_used - ALocal.last_aligned;
            if (ALocal.total_used >= ALocal.last_aligned)
                ALocal.total_used = ALocal.total_used - ALocal.last_aligned;
        }
        ALocal.last_base = 0;
        ALocal.last_aligned = 0;
    } else {
        long total = __myp_mem_load_i64(base0);
        if (total > 0) {
            // size-class 分桶——块按 total 归对应 2 幂 class 链表
            long fidx = classOf(total);
            __myp_mem_store_i64(base0 + 8, total);       // freed: total@+8
            __myp_mem_store_i64(base0, ALocal.freeLists[fidx]);  // freed: next@+0
            ALocal.freeLists[fidx] = base0;
        }
    }
}
// ---- class arena（方案 A v3.15.179：类对象独立 arena，环收集 walk 免登记）----
// 全局 CArena 只持可枚举 chunk 链；CLocal 是每线程 bump+size-class 状态，
// **只**服务类对象（myp_alloc_object/free_object）。热路径无锁，仅新建 64KB
// chunk 挂入全局链时加锁。字符串/数组/raw 块仍在 Arena。
// 环收集 walk CArena 即可枚举全部类对象根——全是类对象无原始块污染（原始块
// 无 type_id 头，混在 Arena 里 walk 会出假根），免去 ccAllAdd 每次分配的登记
// （实测 5ms/百万）+ 收集期 allN 大遍历。
@static class CArena {
    property:
        long cur = 0;
        long lockS = 0;
}
@static @thread class CLocal {
    property:
        long cur = 0;
        long cur_used = 0;
        long cur_cap = 0;
        long total_used = 0;
        long last_base = 0;
        long last_aligned = 0;
        long freeHead = 0;
        long[16] freeLists;
}
void cArenaLockInit() {
    if (CArena.lockS == 0) {
        long p = __myp_syscall(9, 0, 4, 3, 0x22, -1, 0);
        if (p != -1 && p != 0) {
            __myp_mem_store_i32(p, 0);
            CArena.lockS = p;
        }
    }
}
void cArenaLock() {
    cArenaLockInit();
    if (CArena.lockS == 0) return;
    while (__myp_atomic_add_i32_addr(CArena.lockS, 1) != 0) { }
}
void cArenaUnlock() {
    if (CArena.lockS == 0) return;
    __myp_atomic_store_i32_addr(CArena.lockS, 0);
}

// 类对象分配：同 myp_arena_alloc_ex 但用 CArena（类对象无需 grow=2x，参数保留
// 结构一致）。返回 header base（base0+8）。
long myp_class_arena_alloc_ex(long size, int grow) {
    if (size < 1) size = 1;
    long req = size + 8 + 15;
    req = req - (req % 16);
    long cap = req;
    if (grow != 0) cap = req * 2;
    long idx = classOf(req);
    while (idx < 16) {
        long prev = 0;
        long cur = CLocal.freeLists[idx];
        while (cur != 0) {
            long stored = __myp_mem_load_i64(cur + 8);
            if (stored >= req) {
                long nxt = __myp_mem_load_i64(cur);
                if (prev == 0) CLocal.freeLists[idx] = nxt;
                else __myp_mem_store_i64(prev, nxt);
                __myp_mem_store_i64(cur, stored);
                CLocal.last_base = 0;
                CLocal.last_aligned = 0;
                return cur + 8;
            }
            prev = cur;
            cur = __myp_mem_load_i64(cur);
        }
        idx = idx + 1;
    }
    if (CLocal.cur == 0 || CLocal.cur_used + cap > CLocal.cur_cap) {
        long chunk = cap;
        if (chunk < 65536) chunk = 65536;
        long c = __myp_syscall(9, 0, 32 + chunk, 3, 0x22, -1, 0);
        if (c == -1 || c == 0) return 0;
        cArenaLock();
        __myp_mem_store_i64(c, CArena.cur);
        __myp_mem_store_i64(c + 8, chunk);
        __myp_mem_store_i64(c + 16, 0);
        CArena.cur = c;
        cArenaUnlock();
        CLocal.cur = c;
        CLocal.cur_used = 0;
        CLocal.cur_cap = chunk;
    }
    long p = CLocal.cur + 32 + CLocal.cur_used;
    __myp_mem_store_i64(p, cap);
    CLocal.last_base = p + 8;
    CLocal.last_aligned = cap;
    CLocal.cur_used = CLocal.cur_used + cap;
    CLocal.total_used = CLocal.total_used + cap;
    __myp_mem_store_i64(CLocal.cur + 16, CLocal.cur_used);   // chunk used@16（walk 精确边界）
    return p + 8;
}
long myp_class_arena_alloc(long size) { return myp_class_arena_alloc_ex(size, 0); }

// 类对象块回收进当前释放线程的本地 free-list；允许跨线程最后释放，不触碰分配
// 线程状态。chunk 映射仍由全局链持有，因此地址枚举和后续本线程复用都安全。
void cArenaReclaim(long base0) {
    if (CLocal.last_base == base0) {
        if (CLocal.cur_used >= CLocal.last_aligned) {
            CLocal.cur_used = CLocal.cur_used - CLocal.last_aligned;
            if (CLocal.total_used >= CLocal.last_aligned)
                CLocal.total_used = CLocal.total_used - CLocal.last_aligned;
        }
        CLocal.last_base = 0;
        CLocal.last_aligned = 0;
    } else {
        long total = __myp_mem_load_i64(base0);
        if (total > 0) {
            long fidx = classOf(total);
            __myp_mem_store_i64(base0 + 8, total);
            __myp_mem_store_i64(base0, CLocal.freeLists[fidx]);
            CLocal.freeLists[fidx] = base0;
        }
    }
}

@static class Live {
    property:
        long strings = 0;
        long objects = 0;
        long arrays = 0;
}

@static class WeakFast {
    property:
        int hasEntries = 0;
}

// Updated by weak.myp under its registry lock. Keeping the flag in this module
// lets the no-weak release path compile to one local load and branch.
void myp_weak_set_nonempty(int value) { WeakFast.hasEntries = value; }

// C: myp_arena_bump_alloc —— 从 mmap bump arena 取 size 字节（header+payload），
// **返回 header base**（块首 base0 前 8B 存 total 前缀）。失败返回 0。
// grow=1：块容量 2x（字符串拼接增长用——回退拷贝后需增长头，否则每涨 16B 就重拷
// 整串 → O(N²)+内存爆炸）。size-class 分桶复用（v3.15.177）。
// 2 幂大小类索引——req 归到最小 2 幂 ≥ req 的类（32..32768，idx 0..15）。
long classOf(long req) {
    long c = 32;
    long idx = 0;
    while (c < req && idx < 15) { c = c * 2; idx = idx + 1; }
    return idx;
}

long myp_arena_alloc_ex(long size, int grow) {
    myp_fail_alloc_check();   // 包 B：确定性注入点（第 at 次 bump 分配）
    if (size < 1) size = 1;
    long req = size + 8 + 15;
    req = req - (req % 16);       // 含 8B total 前缀，16 对齐
    long cap = req;
    if (grow != 0) cap = req * 2;   // 拼接增长 2x 块容量（几何）
    // size-class 复用：按 req 的 2 幂 class 起向上找，桶内 first-fit 遍历（同基线
    // freeHead 遍历但分桶更小 → 匹配更好 + 遍历更短）。
    long idx = classOf(req);
    while (idx < 16) {
        long prev = 0;
        long cur = ALocal.freeLists[idx];
        while (cur != 0) {
            long stored = __myp_mem_load_i64(cur + 8);
            if (stored >= req) {
                long nxt = __myp_mem_load_i64(cur);
                if (prev == 0) ALocal.freeLists[idx] = nxt;
                else __myp_mem_store_i64(prev, nxt);
                __myp_mem_store_i64(cur, stored);   // live: total@base0
                ALocal.last_base = 0;                // 复用块非 bump tail → 禁 LIFO
                ALocal.last_aligned = 0;
                return cur + 8;   // header base
            }
            prev = cur;
            cur = __myp_mem_load_i64(cur);
        }
        idx = idx + 1;
    }
    if (ALocal.cur == 0 || ALocal.cur_used + cap > ALocal.cur_cap) {
        long chunk = cap;
        if (chunk < 65536) chunk = 65536;
        long c = __myp_syscall(9, 0, 32 + chunk, 3, 0x22, -1, 0);  // mmap
        if (c == -1 || c == 0) return 0;  // OOM
        arenaLock();
        __myp_mem_store_i64(c, Arena.cur);     // next
        __myp_mem_store_i64(c + 8, chunk);
        __myp_mem_store_i64(c + 16, 0);        // used
        Arena.cur = c;
        arenaUnlock();
        ALocal.cur = c;
        ALocal.cur_used = 0;
        ALocal.cur_cap = chunk;
    }
    long p = ALocal.cur + 32 + ALocal.cur_used;
    __myp_mem_store_i64(p, cap);       // total@base0
    ALocal.last_base = p + 8;           // header base
    ALocal.last_aligned = cap;
    ALocal.cur_used = ALocal.cur_used + cap;
    ALocal.total_used = ALocal.total_used + cap;
    __myp_mem_store_i64(ALocal.cur + 16, ALocal.cur_used);
    return p + 8;   // header base
}
long myp_arena_alloc(long size) { return myp_arena_alloc_ex(size, 0); }

// C: myp_arena_reclaim_raw —— 回收 raw 块（myp_arena_alloc 返回值 = header base）。
// io.myp 的 per-call scratch 缓冲（readLine 4096 / write_line / read_byte 等）此前
// bump 永不归还 → file_io 读回 20 万行每行 4096B = ~819MB arena 泄漏。回收后经空闲
// 链表/LIFO 复用（block base0 = addr - 8）。⚠️ 调用方须确认块已无引用（数据已拷出）。
void myp_arena_reclaim_raw(long addr) {
    if (addr == 0) return;
    arenaReclaim(addr - 8);
}

// C: int64_t myp_diag_arena_reserved/used —— 诊断（Memory.arenaReserved/Used）。
// reserved/used 与 C runtime 一致，只报告当前线程 ALocal 链和累计 bump。
long myp_diag_arena_reserved() {
    long total = 0;
    long c = ALocal.cur;
    while (c != 0) {
        total = total + __myp_mem_load_i64(c + 8);   // cap
        c = __myp_mem_load_i64(c);                   // next = 更旧 chunk
    }
    return total;
}
long myp_diag_arena_used() {
    return ALocal.total_used;
}

// MYP 拼接层辅助（str.myp myp_str_append 原地扩展）：若 base 是 arena 最后一次
// 分配且当前 chunk 能扩展到 new_aligned 字节，则 bump 前移并返回 1，否则 0。
// base 是原始 bump 地址（字符串 = data-12）；new_aligned 为 16 对齐后的目标总大小。
int myp_arena_try_extend(long base, long newAligned) {
    if (ALocal.cur == 0) return 0;
    if (ALocal.last_base != base) return 0;
    long extra = newAligned - ALocal.last_aligned;
    if (extra < 0) return 0;
    if (ALocal.cur_used + extra > ALocal.cur_cap) return 0;
    ALocal.cur_used = ALocal.cur_used + extra;
    ALocal.total_used = ALocal.total_used + extra;
    ALocal.last_aligned = newAligned;
    __myp_mem_store_i64(base - 8, newAligned);   // 同步 8B total 前缀
    __myp_mem_store_i64(ALocal.cur + 16, ALocal.cur_used);
    return 1;
}

// ---- 分配器集群 ----
// C: void* myp_alloc(size_t size) —— 计数字符串 {rc=1, type_id=STR} + 字节
// 注意：MYP 分配器须符合自举 ARC 返回约定——`return __myp_addr_to_str(...)`
// 不是 fresh（内建不加 fresh temp）→ codegen 对 return 发射 retain-on-return
// (+1)。因此内部 rc 设 0，让该 retain 补成 1（等价正常代码 new 后 return 的净
// rc=1）。若设 1 会被 return 再 +1 → 净 rc=2（调用方 release 到 1 不归零=泄漏）。
string myp_alloc(long size) {
    // base = header base（myp_arena_alloc_ex 已加 8B total 前缀并返回 header base）。
    // total 供 myp_str_append 块内原地扩展（cap_data = total-20）与空闲链表/LIFO 回收。
    long base = myp_arena_alloc(12 + size);
    if (base == 0) return "";   // OOM（MYP 惯例：空串替代 NULL）
    __myp_mem_store_i32(base, int(size - 1));   // len = size-1（不含 NUL，data-12）
    __myp_mem_store_i32(base + 4, 0);           // rc=0（return 时 retain-on-return → 1）
    __myp_mem_store_i32(base + 8, -2);          // type_id = 0xFFFFFFFE
    Live.strings = Live.strings + 1;
    return __myp_addr_to_str(base + 12);        // data
}

// 字符串拼接增长分配（str.myp myp_str_append 回退路径专用）：同 myp_alloc，但 grow=1
// → 块容量 2x（几何增长）——s=s+i 慢路径每迭代重拷时，旧 s 块若容量够则块内扩展复用；
// 2x 头 → 扩展点几何递增 → 摊销 O(N) 拷贝 + O(peak) 内存（不再 O(N²) 爆炸）。
string myp_alloc_str_grow(long size) {
    long base = myp_arena_alloc_ex(12 + size, 1);
    if (base == 0) return "";
    __myp_mem_store_i32(base, int(size - 1));
    __myp_mem_store_i32(base + 4, 0);
    __myp_mem_store_i32(base + 8, -2);
    Live.strings = Live.strings + 1;
    return __myp_addr_to_str(base + 12);
}

// C: void* myp_alloc_object(size_t size, uint32_t type_id)
// v3.15.179 方案 A：从独立 class arena（CArena）分配 + **免 ccAllAdd 登记**
// （环收集改 walk CArena 找根，全是类对象无假根）。省登记 5ms/百万 +
// 收集期 allN 遍历。
string myp_alloc_object(long size, int type_id) {
    long base = myp_class_arena_alloc_ex(8 + size, 0);
    if (base == 0) return "";   // OOM
    __myp_mem_store_i32(base, 0);          // rc=0（return retain-on-return → 1）
    __myp_mem_store_i32(base + 4, type_id);
    Live.objects = Live.objects + 1;
    myp_type_live_inc(type_id);   // 包 B：per-type 计数
    // v3.15.172 自动收集水位：每 N 次类对象分配置 pending（==threshold 恰好一次），
    // 安全点 myp_cc_try_collect 消费。阈值<=0 关闭。热路径仅一次 add + 比较。
    CC.allocSinceCollect = CC.allocSinceCollect + 1;
    if (CC.threshold > 0 && CC.allocSinceCollect == CC.threshold) CC.pending = 1;
    return __myp_addr_to_str(base + 8);
}

// C: void* myp_alloc_class_array(uint64_t count, uint32_t elem_size)
string myp_alloc_class_array(long count, int elem_size) {
    long bytes = count * elem_size;
    long base = myp_arena_alloc(24 + bytes);
    if (base == 0) return "";   // OOM
    __myp_mem_store_i64(base, count);
    __myp_mem_store_i32(base + 8, elem_size);
    __myp_mem_store_i32(base + 12, 0);   // pad = CLASS（逐元素 release）
    __myp_mem_store_i32(base + 16, 0);   // rc=0（return retain-on-return → 1）
    __myp_mem_store_i32(base + 20, -1);  // type_id = 0xFFFFFFFF (ARR)
    Live.arrays = Live.arrays + 1;
    return __myp_addr_to_str(base + 24);
}

// C: void* myp_alloc_slice_backing(uint64_t count, uint32_t elem_size,
//                                  uint32_t elem_kind)
string myp_alloc_slice_backing(long count, int elem_size, int elem_kind) {
    long bytes = count * elem_size;
    long base = myp_arena_alloc(24 + bytes);
    if (base == 0) return "";   // OOM
    __myp_mem_store_i64(base, count);
    __myp_mem_store_i32(base + 8, elem_size);
    __myp_mem_store_i32(base + 12, elem_kind);   // pad = elem_kind
    __myp_mem_store_i32(base + 16, 0);   // rc=0（return retain-on-return → 1）
    __myp_mem_store_i32(base + 20, -1);
    Live.arrays = Live.arrays + 1;
    return __myp_addr_to_str(base + 24);
}

// ---- 环收集器（ARC + trial-deletion，Bacon-Rajan；v3.15.171）----
// 哲学：零用户操作 + 最少运行时内存操作——**零每次分配/释放开销**（无 alloc list、
// 无紫色追踪），仅在 myp_collect_cycles()（显式调用或 myp_free_all 退出自动）一次
// O(n) 扫描。
// 枚举（MYP arena 无 alloc list）：遍历 chunk 链表（新→旧，next@0）+ 每 chunk 内
// 块序列（base0 = chunk+32，块首 8B total 前缀，16 对齐顺序 bump）。空闲链表块
// base0+0 被 next 指针覆盖（total 移到 base0+8）→ 以 `total ∈ [16, chunk_cap]`
// 判别活块（活块 total 小对齐；空闲块 next 是 mmap 大地址，末节点为 0）。
// 模式：trial(markGray：rc--+cascade) / restore(scanBlack：rc+++cascade) /
// finalize(collectWhite：字段零操作+真实释放)。与 C 运行时语义一致。
@static class CC {
    property:
        int trial = 0;
        int restore = 0;
        int finalize = 0;
        long cap = 0;      // 哈希容量（2 的幂）
        long n = 0;        // 已用槽
        long[] keys;       // 对象 data 地址（0=空槽）
        int[] colors;      // 0=空, 1=灰, 2=黑, 3=白
        long allocSinceCollect = 0;   // v3.15.172：距上次收集的类对象分配数（水位）
        long threshold = 100000;      // 自动收集水位（每 N 次类对象分配；<=0 关闭）
        int pending = 0;              // 水位已到，待安全点收集
        long thrCount = 0;            // 活动 @thread/@parallel 计数地址（arena 4B，原子）
        int everThreaded = 0;         // 单调模式位：启动过 worker 后 ARC 永久走原子路径
        int depth = 0;                // v3.15.174：级联递归深度（深环栈溢出保护）
        int abort = 0;                // 深度超限 → 回滚放弃本次收集（不崩溃）
        int[] decs;                   // 每对象 trial 递减次数（平行 keys/colors；回滚用）
        long okHint = 0;              // v3.15.180：ccAddrOk 上次命中的 chunk 头（O(1) 快路径）
}

// 活动线程计数（原子，进程级，arena 4B 地址——mmap 零初始化）。⚠️ 空闲链表
// 复用返回**脏内存**（非 bump 尾部的旧数据）→ 必须显式清零（cc_auto4 实测 thr=32
// 导致守卫误判"有活动线程"而跳过收集）。
// @thread 体存活 / @parallel for 进行中 → >0 → 自动收集跳过（并发安全守卫）。
// 线程进入/退出经 myp_cc_thread_enter/exit（thread.myp / pool.myp 调）。
long ccThrCountAddr() {
    if (CC.thrCount == 0) {
        CC.thrCount = myp_arena_alloc(4);
        if (CC.thrCount != 0) __myp_mem_store_i32(CC.thrCount, 0);
    }
    return CC.thrCount;
}
void myp_arc_mark_threaded() { CC.everThreaded = 1; }
void myp_cc_thread_enter() {
    myp_arc_mark_threaded();           // 父线程在创建 worker 前切换为原子 ARC
    __myp_atomic_add_i32_addr(ccThrCountAddr(), 1);
}
void myp_cc_thread_exit() { __myp_atomic_add_i32_addr(ccThrCountAddr(), -1); }
int myp_cc_threads_active() { return __myp_atomic_load_i32_addr(ccThrCountAddr()); }

// 安全点自动触发（v3.15.172）：水位已到（pending）且无活动线程/并行 → 收集。
// 调用方（event_process_all / 显式 Memory.collectCyclesIfNeeded）须在安全点
// （主线程、无并发引用变更）。收集后复位水位。
void myp_cc_try_collect() {
    if (CC.pending == 0) return;
    if (myp_cc_threads_active() != 0) return;   // @thread/@parallel 活跃 → 跳过
    myp_collect_cycles();
    CC.pending = 0;
    CC.allocSinceCollect = 0;
}
void myp_cc_set_threshold(long n) { CC.threshold = n; }
long myp_cc_get_threshold() { return CC.threshold; }

void ccReset() {
    CC.n = 0;
    for (long i = 0; i < CC.cap; i = i + 1) {
        CC.keys[i] = 0;
        CC.colors[i] = 0;
        CC.decs[i] = 0;
    }
}

// v3.15.176: 预扩容 CC 哈希表——**trial 期禁止扩容**。ccInsert 扩容时
// `CC.keys = nk` 重赋值会 ARC 释放旧 keys 数组 → trial 模式 myp_release(旧数
// 组) → 嵌套 ccInsert → 污染正在构建的表（部分环对象丢失 → 多环漏收集，实测
// 50 环全收、1000 环只收 204）。收集前按根数预估容量，使 trial/restore 全程
// 不扩容。
void ccEnsureCap(long need) {
    if (CC.cap >= need) return;
    long nc = 256;
    while (nc < need) nc = nc * 2;
    long[] nk = new long[nc];
    int[] ncol = new int[nc];
    int[] ndec = new int[nc];
    CC.cap = nc;
    CC.keys = nk;
    CC.colors = ncol;
    CC.decs = ndec;
}

int ccLookup(long key) {
    if (CC.cap == 0) return 0;
    long mask = CC.cap - 1;
    long i = (key >> 4) & mask;
    while (CC.keys[i] != 0) {
        if (CC.keys[i] == key) return CC.colors[i];
        i = (i + 1) & mask;
    }
    return 0;
}

void ccSetColor(long key, int color) {
    if (CC.cap == 0) return;
    long mask = CC.cap - 1;
    long i = (key >> 4) & mask;
    while (CC.keys[i] != 0) {
        if (CC.keys[i] == key) { CC.colors[i] = color; return; }
        i = (i + 1) & mask;
    }
}

void ccInsert(long key, int color) {
    if (CC.n * 2 >= CC.cap) {
        long nc = CC.cap == 0 ? 256 : CC.cap * 2;
        long[] nk = new long[nc];
        int[] ncol = new int[nc];
        int[] ndec = new int[nc];
        long nmask = nc - 1;
        for (long i = 0; i < CC.cap; i = i + 1) {
            if (CC.keys[i] == 0) continue;
            long j = (CC.keys[i] >> 4) & nmask;
            while (nk[j] != 0) j = (j + 1) & nmask;
            nk[j] = CC.keys[i];
            ncol[j] = CC.colors[i];
            ndec[j] = CC.decs[i];
        }
        // ⚠️ 必须先置 CC.cap 再重赋值 CC.keys/CC.colors：重赋值会 ARC 释放旧数组
        // backing → trial 模式 myp_release(旧数组) → 嵌套 ccInsert；若 cap 未更新
        // 会再扩容 → 又释放 → 无限递归栈溢出（1000 环实测崩溃）。
        CC.cap = nc;
        CC.keys = nk;
        CC.colors = ncol;
        CC.decs = ndec;
    }
    long mask = CC.cap - 1;
    long i = (key >> 4) & mask;
    while (CC.keys[i] != 0) i = (i + 1) & mask;
    CC.keys[i] = key;
    CC.colors[i] = color;
    CC.decs[i] = 0;
    CC.n = CC.n + 1;
}

// trial 递减计数：对象每次被 trial 递减，decs[槽]++（深度超限回滚时按次数恢复 rc）。
// 前提：对象必已在哈希（ccInsert 后）。
void ccBumpDec(long key) {
    long mask = CC.cap - 1;
    long i = (key >> 4) & mask;
    while (CC.keys[i] != 0) {
        if (CC.keys[i] == key) { CC.decs[i] = CC.decs[i] + 1; return; }
        i = (i + 1) & mask;
    }
}

// 合法类 type_id？防 __myp_release_table 越界（STR=-2 / ARR=-1 是叶子，永不下表）。
// v3.15.175：`__myp_max_type_id` 改由程序生成（global i32，与 __myp_release_table
// 同为可写全局 → 外部引用链接解析正确；此前是 constant，链接错位读到垃圾值（如
// Box<Node> tid=6 > 假 maxv=3）→ 泛型实例对象被误拒 → 泛型环泄漏）。
int ccClassOk(int tid) {
    if (tid <= 0) return 0;
    if (tid > 1024) return 0;   // TLive 同界，防超大/脏 id
    long mx = __myp_fn_addr("__myp_max_type_id");
    if (mx == 0) return 0;
    int maxv = __myp_mem_load_i32(mx);
    if (tid <= maxv) return 1;
    return 0;
}

// 弱注册表守卫：trial/restore 期不扰动（finalize 期允许真实清槽）。weak.myp 用。
int myp_cc_active() {
    if (CC.trial == 1 || CC.restore == 1) return 1;
    return 0;
}

// v3.15.175: addr 是否在 arena 某 chunk 内（mmap 映射范围 [h+32, h+32+cap)）。
// 用 cap（chunk 容量）而非 used（chunk 头 used@16 不随 bump 更新，恒 0）。trial
// 级联释放字段前验证——max_type_id 修复后所有类参与 trial，暴露出个别对象持有
// 悬垂引用（如 File.path 指向已释放 string / AstInterface 字段指向已释放对象），
// 其内存已被复用/覆盖，直接读 header 会段错误。chunk 映射外（未映射地址）→ 0
// 跳过，不写无效内存；chunk 内但已释放/复用 → 后续 type_id 合法性检查挡。
// v3.15.176: 从 Arena.cur（最新 chunk）遍历——chunk 链表是反向的（cur 最新，
// next 指旧；head 最旧且 next=0），从 head 遍历只能到首 chunk，新 chunk 的对象
// 全被误判为悬垂 → 多环/多 chunk 时大规模漏收集（1000 环只收 204）。
// v3.15.179: 类对象现在在 CArena（字符串/数组/raw 仍在 Arena）→ 两处都查。
// v3.15.180: **O(1) 快路径**——缓存上次命中的 chunk + 先查最新 chunk。trial 级联
// 释放的对象地址通常连续/集中在最新 chunk（bump 顺序分配），命中率 ~99%，把
// 每次 trial release 的 O(chunk数) 线性遍历降到 O(1)（perf 实测此循环占
// myp_release 86%——leak_long 混合负载收集期每对象都遍历全 chunk 链）。
int ccAddrOk(long addr) {
    // 快路径 1：上次命中的 chunk（级联对象地址通常连续）
    if (CC.okHint != 0) {
        long cap = __myp_mem_load_i64(CC.okHint + 8);
        if (addr >= CC.okHint + 32 && addr < CC.okHint + 32 + cap) return 1;
    }
    // 快路径 2：最新 chunk（bump 当前分配点，多数活对象在此）
    if (CArena.cur != 0) {
        long cap = __myp_mem_load_i64(CArena.cur + 8);
        if (addr >= CArena.cur + 32 && addr < CArena.cur + 32 + cap) { CC.okHint = CArena.cur; return 1; }
    }
    if (Arena.cur != 0) {
        long cap = __myp_mem_load_i64(Arena.cur + 8);
        if (addr >= Arena.cur + 32 && addr < Arena.cur + 32 + cap) { CC.okHint = Arena.cur; return 1; }
    }
    // 慢路径：全 chunk 链遍历（命中的记入 hint）
    long h = CArena.cur;
    while (h != 0) {
        long cap = __myp_mem_load_i64(h + 8);
        if (addr >= h + 32 && addr < h + 32 + cap) { CC.okHint = h; return 1; }
        h = __myp_mem_load_i64(h);   // next
    }
    h = Arena.cur;
    while (h != 0) {
        long cap = __myp_mem_load_i64(h + 8);
        if (addr >= h + 32 && addr < h + 32 + cap) { CC.okHint = h; return 1; }
        h = __myp_mem_load_i64(h);   // next
    }
    return 0;
}

// 调 destroy stub（行为由 CC.trial/restore/finalize 模式决定）。
void ccCallStub(long addr, string obj) {
    int tid = __myp_mem_load_i32(addr - 4);
    if (ccClassOk(tid) == 0) return;
    long table = __myp_rtable_addr();
    long stub = __myp_mem_load_i64(table + long(tid) * 8);
    if (stub != 0) __myp_call_ptr(stub, obj);
}

// 数组/切片 backing 级联（trial/restore 模式）：逐元素 myp_release（按当前模式
// 递归，visited 守卫防共享元素重复级联）。pad==0 类元素 / pad==2 slice 元素；
// 标量(pad==1)无元素。头部：count@addr-24, elem_size@addr-16, pad@addr-12。
void ccArrayCascade(long addr) {
    long count = __myp_mem_load_i64(addr - 24);
    int elem_size = __myp_mem_load_i32(addr - 16);
    int pad = __myp_mem_load_i32(addr - 12);
    if (pad == 2) {   // 元素 = slice 胖指针 {data,len} → 释放内层 data
        for (long i = 0; i < count; i = i + 1) {
            long inner = __myp_mem_load_i64(addr + i * elem_size);
            myp_release(__myp_addr_to_str(inner));
        }
    } else if (pad == 0) {   // 元素 = 类引用 → 逐元素
        for (long i = 0; i < count; i = i + 1) {
            long inner = __myp_mem_load_i64(addr + i * 8);
            myp_release(__myp_addr_to_str(inner));
        }
    }
}

// 模式级联（trial/restore 统一入口）：class → destroy stub（递归字段）；
// 数组/切片 → 逐元素（v3.15.173 补数组环检测——环经 class→Node[]→Node→A
// 现在可回收）；字符串 → 无。
void ccCascade(long addr, string obj) {
    int tid = __myp_mem_load_i32(addr - 4);
    if (tid == -1) { ccArrayCascade(addr); return; }
    ccCallStub(addr, obj);
}

// C: void myp_collect_cycles(void) —— 回收引用环。安全点调用（无并发引用变更）：
// 显式 Memory.collectCycles() 或 myp_free_all（退出，工作线程已 join）。
void myp_collect_cycles() {
    // v3.15.179 方案 A：找根 = walk CArena（全是类对象，无原始块污染 → 无假根，
    // 免去 ccAllAdd 登记 + 收集期 allN 遍历）。块序列：base0=chunk+32，块首 8B
    // total 前缀，16 对齐顺序 bump。活块（total∈[16,2^30)）→ 类对象：
    // rc@base0+8, tid@base0+12, data=base0+16。空闲块（base0+0=next 指针，大地址
    // 或 0）→ 原 total 在 base0+8。⚠️ 不持锁：收集器内部 `new`（哈希扩容）会走
    // 分配器 → 嵌套自旋锁 → 死锁；收集器要求安全点（单线程）→ 无锁安全。
    long[] roots = new long[1024];
    long rootsCap = 1024;
    long nroot = 0;
    long h = CArena.cur;
    while (h != 0) {
        long cap = __myp_mem_load_i64(h + 8);
        long used = __myp_mem_load_i64(h + 16);   // bump 到哪（CArena 每次 bump 更新）
        if (used < 0 || used > cap) used = cap;   // 兜底
        long p = h + 32;
        long end = h + 32 + used;
        while (p < end) {
            long t0 = __myp_mem_load_i64(p);
            long total;
            if (t0 >= 16 && t0 < (1 << 30)) {
                total = t0;   // 活块
                int ctid = __myp_mem_load_i32(p + 12);
                if (ccClassOk(ctid) != 0) {
                    int rcv = __myp_atomic_load_i32_addr(p + 8);
                    if (rcv >= 1) {
                        if (nroot >= rootsCap) {
                            rootsCap = rootsCap * 2;
                            long[] nr = new long[rootsCap];
                            for (long j = 0; j < nroot; j = j + 1) nr[j] = roots[j];
                            roots = nr;
                        }
                        roots[nroot] = p + 16;   // data
                        nroot = nroot + 1;
                    }
                }
            } else {
                total = __myp_mem_load_i64(p + 8);   // 空闲块原 total
                if (total < 16 || total >= (1 << 30)) total = 16;   // 兜底
            }
            p = p + total;
        }
        h = __myp_mem_load_i64(h);   // next（更旧 chunk）
    }
    if (nroot == 0) return;

    // v3.15.176: 预扩容（trial 期不扩容，防嵌套污染）。trial 插入对象数 = 根 +
    // 级联字段/数组/字符串，可能远超根数；用 nroot（walk CArena 活类对象）2 倍 +
    // 余量，保证 ccInsert 的 `n*2 >= cap` 在 trial 全程不触发（实测 nroot*2 预估
    // 不足，1000 环只收 204；walk 根数精确后 nroot*2+256 通常足够，极端深链仍由
    // ccInsert 自身扩容兜底——trial 期扩容有嵌套污染风险，故预留足够余量）。
    ccEnsureCap(nroot * 2 + 256);
    ccReset();
    // markGray（trial=1：rc-- + 级联，不释放）
    CC.trial = 1;
    for (long i = 0; i < nroot; i = i + 1) {
        if (CC.abort != 0) break;
        long o = roots[i];
        if (ccLookup(o) == 0) {
            ccInsert(o, 1);
            ccCascade(o, __myp_addr_to_str(o));
        }
    }
    CC.trial = 0;
    if (CC.abort != 0) {
        // v3.15.174 深度超限：回滚 markGray（按 decs 恢复 rc）→ 放弃本次收集
        // （深环保守泄漏，但**不崩溃**；浅环正常收集）。复位水位避免每次重试浪费。
        for (long i = 0; i < CC.cap; i = i + 1) {
            if (CC.keys[i] != 0 && CC.decs[i] > 0) {
                __myp_atomic_add_i32_addr(CC.keys[i] - 8, CC.decs[i]);
            }
        }
        CC.abort = 0;
        CC.pending = 0;
        CC.allocSinceCollect = 0;
        ccReset();
        return;
    }
    // scan（restore=1：rc>0 者 rc++ + 级联标黑；rc==0 标白）
    CC.restore = 1;
    for (long i = 0; i < CC.cap; i = i + 1) {
        if (CC.keys[i] == 0 || CC.colors[i] != 1) continue;
        long o = CC.keys[i];
        if (__myp_atomic_load_i32_addr(o - 8) > 0) {
            ccSetColor(o, 2);   // 黑
            ccCascade(o, __myp_addr_to_str(o));   // restore 级联
        } else {
            ccSetColor(o, 3);   // 白
        }
    }
    CC.restore = 0;
    // collectWhite（finalize=1：字段零操作，真实释放白类对象；白字符串/数组直接回收）
    CC.finalize = 1;
    for (long i = 0; i < CC.cap; i = i + 1) {
        if (CC.keys[i] == 0 || CC.colors[i] != 3) continue;
        long o = CC.keys[i];
        int tid = __myp_mem_load_i32(o - 4);
        if (tid == -2) {
            // 白字符串：仅垃圾引用 → 直接回收
            if (Live.strings > 0) Live.strings = Live.strings - 1;
            arenaReclaim(o - 20);
        } else if (ccClassOk(tid) != 0) {
            ccCallStub(o, __myp_addr_to_str(o));   // finalize：清 weak + 释放
        } else if (tid == -1) {
            // 白数组/切片 backing：仅垃圾引用 → 回收（元素由各自 collectWhite 处理）
            if (Live.arrays > 0) Live.arrays = Live.arrays - 1;
            arenaReclaim(o - 32);   // 数组块 base0（含 8B total 前缀：data-24 头 base，base0=data-32）
        }
    }
    CC.finalize = 0;
    ccReset();
}

// ---- 释放 ----
// C: uint32_t myp_release(void* obj) —— fetch_sub 返回旧值；rc→0 按 type_id 分发。
// 类对象分支委托 C helper（weak 通知 + release_table + myp_free_object，
// myp_free_object 经 --allow-multiple-definition interpose 回本模块）。
int myp_release(string obj) {
    long addr = __myp_str_ptr(obj);
    if (addr == 0) return 0;
    // 环收集模式（见 myp_collect_cycles）。
    if (CC.finalize == 1) return 0;   // collectWhite：字段零操作（trial+restore 记账已含垃圾引用）
    if (CC.restore == 1) {            // scanBlack：撤销 trial 递减
        int col = ccLookup(addr);
        if (col == 0 || col == 2) return 0;   // 不在表 / 已黑
        __myp_atomic_add_i32_addr(addr - 8, 1);   // rc++
        if (col == 1) {               // 灰 → 黑 + 级联
            ccSetColor(addr, 2);
            ccCascade(addr, obj);
        } else if (col == 3) {        // 白 → 黑（活对象可达）
            ccSetColor(addr, 2);
        }
        return 0;
    }
    if (CC.trial == 1) {              // markGray：rc-- + 级联，不释放
        CC.depth = CC.depth + 1;
        if (CC.depth > 45000) {
            // v3.15.174 深环栈溢出保护：超限 → 停止深入，收集后回滚放弃（不崩溃）
            CC.abort = 1;
        } else {
            // v3.15.175：悬垂字段防御——max_type_id 修复后所有类参与 trial，暴露出
            // 个别对象持有悬垂引用（如 File.path 指向已释放 string / AstInterface
            // 字段指向已释放对象，内存被复用/覆盖）。释放前验证 addr 在 arena bump
            // 区（ccAddrOk）且 type_id 合法，无效即跳过——不写无效内存（rc--），
            // 避免 trial 阶段段错误。
            if (ccAddrOk(addr) == 0) {
                CC.depth = CC.depth - 1;
                return 0;   // 非 arena 活块（悬垂/复用）→ 跳过
            }
            int tid0 = __myp_mem_load_i32(addr - 4);
            if (tid0 != -1 && tid0 != -2 && ccClassOk(tid0) == 0) {
                CC.depth = CC.depth - 1;
                return 0;   // 脏 type_id → 悬垂/复用内存 → 跳过
            }
            __myp_atomic_sub_i32_addr(addr - 8, 1);   // rc--
            int wasNew = 0;
            if (ccLookup(addr) == 0) { ccInsert(addr, 1); wasNew = 1; }   // 灰
            ccBumpDec(addr);   // 记录递减次数（深度回滚时按次数恢复 rc）
            if (wasNew != 0) ccCascade(addr, obj);   // 首次级联（visited 守卫防共享重复）
        }
        CC.depth = CC.depth - 1;
        return 0;
    }
    int old;
    if (CC.everThreaded == 0) {
        old = __myp_mem_load_i32(addr - 8);
        if (old == 0) return 0;
        __myp_mem_store_i32(addr - 8, old - 1);
    } else {
        old = __myp_atomic_sub_i32_addr(addr - 8, 1);  // fetch_sub
        if (old == 0) { __myp_atomic_store_i32_addr(addr - 8, 0); return 0; }
    }
    int nv = old - 1;
    if (nv != 0) return nv;
    int tid = __myp_mem_load_i32(addr - 4);
    if (tid == -1) {
        // 数组/切片 backing 头（data 相对偏移）：count@-24, elem_size@-16,
        // pad@-12, rc@-8, type_id@-4（pad 是 -12 非 -16，-16 是 elem_size！）
        long count = __myp_mem_load_i64(addr - 24);
        int elem_size = __myp_mem_load_i32(addr - 16);
        int pad = __myp_mem_load_i32(addr - 12);
        if (pad == 2) {   // 元素 = slice 胖指针 {data,len} → 释放 data
            for (long i = 0; i < count; i = i + 1) {
                long inner = __myp_mem_load_i64(addr + i * elem_size);
                myp_release(__myp_addr_to_str(inner));
            }
        } else if (pad == 0) {   // 元素 = 类引用 → 逐元素 release
            for (long i = 0; i < count; i = i + 1) {
                long inner = __myp_mem_load_i64(addr + i * 8);
                myp_release(__myp_addr_to_str(inner));
            }
        }
        // MYP_ARR_ELEM_SCALAR(pad==1)：无逐元素释放
        if (Live.arrays > 0) Live.arrays = Live.arrays - 1;
        arenaReclaim(addr - 32);   // 数组块 base0（含 8B total 前缀：data-24 头 base，base0=data-32）
    } else if (tid == -2) {
        if (Live.strings > 0) Live.strings = Live.strings - 1;
        arenaReclaim(addr - 20);   // 字符串块 base0（含 8B total 前缀）
    } else {
        // 类对象：MYP 弱通知（快路径：弱表空直接返回 1=应释放）。返回 0 表示
        // 并发 weak_load 在锁内重新 bump rc（对象存活，新持有者负责释放）。
        // 存活则内联分发（不再委托 myp_release_class_obj_ex，消除其内部二次
        // weak 通知）：查 release_table → destroy stub 或直接 myp_free_object。
        if (WeakFast.hasEntries != 0 && myp_weak_notify_death(obj) == 0) {
            return __myp_atomic_load_i32_addr(addr - 8);
        }
        if (tid > 0) {
            long table = __myp_rtable_addr();
            long stub = __myp_mem_load_i64(table + long(tid) * 8);
            if (stub != 0) {
                __myp_call_ptr(stub, obj);   // destroy stub（级联释放 + myp_free_object）
                return 0;
            }
        }
        myp_free_object(obj);
    }
    return 0;
}

// C: void myp_free_object(void* obj) —— destroy stub 最终调用（interpose 到本
// 模块）。维护存活计数 + 类对象块回收（base0 = data-16，含 8B total 前缀；叶结点
// 无嵌套分配，arenaReclaim 安全）。
void myp_free_object(string obj) {
    long addr = __myp_str_ptr(obj);
    if (addr == 0) return;
    if (CC.trial == 1 || CC.restore == 1) return;   // 收集期 trial/restore 不真实释放
    // 栈上 class 的析构桩只释放字段；0x7ffffffe 标记禁止回收栈帧存储。
    if (__myp_mem_load_i32(addr - 8) == 2147483646) return;
    int tid = __myp_mem_load_i32(addr - 4);
    if (Live.objects > 0) Live.objects = Live.objects - 1;
    myp_type_live_dec(tid);   // 包 B：per-type 计数回落
    cArenaReclaim(addr - 16);   // 类对象块回 class arena（base0=data-16）
}


// C: void myp_release_class_obj_ex(void* obj) —— 类对象 rc→0 后的分发（原 C helper，
// 2026-08-25 全 MYP 化，不再委托 C）：weak 通知 → 查程序生成的 __myp_release_table
// [tid]（经 __myp_rtable_addr 外部引用）→ __myp_call_ptr 间接调 destroy stub（级联
// 释放引用字段 + 调 myp_free_object）；无 stub（tid<=0）→ 直接 myp_free_object。
// 并发 weak_load 在锁内重新 bump rc → 返回 0（对象存活，新持有者负责释放）。
void myp_release_class_obj_ex(string obj) {
    long addr = __myp_str_ptr(obj);
    if (addr == 0) return;
    if (myp_weak_notify_death(obj) == 0) return;   // 弱观察者存活 → 不释放
    int tid = __myp_mem_load_i32(addr - 4);
    if (tid > 0) {
        long table = __myp_rtable_addr();
        long stub = __myp_mem_load_i64(table + long(tid) * 8);
        if (stub != 0) {
            __myp_call_ptr(stub, obj);   // destroy stub（级联释放 + myp_free_object）
            return;
        }
    }
    myp_free_object(obj);
}

// ---- M9 诊断计数（进程级，替代 C TLS；仅计数，无 per-type）----
long myp_live_string_count() { return Live.strings; }
long myp_live_object_count() { return Live.objects; }
long myp_live_array_count() { return Live.arrays; }
long myp_live_total_count() { return Live.strings + Live.objects + Live.arrays; }

// ---- 进程退出清理（#42 薄层：shadow C myp_free_all 链，去掉 C 清理依赖）----
// C: void myp_arena_free_all(void) —— munmap 全部 bump arena chunk 并复位。
//    MYP 版**只复位 Arena 状态、不 munmap**：MYP arena 是进程级 mmap，进程退出时
//    OS 自动回收；退出时显式 munmap 会与 main epilogue 的 ARC release（codegen 在
//    myp_free_all 之后仍有释放）以及 C atexit 产生 UAF（实测 rt_str_test 段错误
//    139）。C 版对 C arena 的时序有 pthread-key 析构保证，MYP 无此保证 → reset-only。
void myp_arena_free_all() {
    Arena.cur = 0;
    ALocal.cur = 0;
    ALocal.cur_used = 0;
    ALocal.cur_cap = 0;
    ALocal.total_used = 0;
    ALocal.last_base = 0;
    ALocal.last_aligned = 0;
    ALocal.freeHead = 0;
    for (int i = 0; i < 16; i = i + 1) ALocal.freeLists[i] = 0;   // size-class
    // v3.15.179: class arena 一并复位
    CArena.cur = 0;
    CLocal.cur = 0;
    CLocal.cur_used = 0;
    CLocal.cur_cap = 0;
    CLocal.total_used = 0;
    CLocal.last_base = 0;
    CLocal.last_aligned = 0;
    CLocal.freeHead = 0;
    for (int i = 0; i < 16; i = i + 1) CLocal.freeLists[i] = 0;
}

// C: void myp_free_all(void) —— codegen 在 main() 退出 epilogue 调用；释放进程级
//    资源。MYP 版：级联释放 class slice backing → 释放 region chunk → munmap
//    bump arena。MYP 无 C 的 alloc 跟踪链表/weak 表/capture 缓冲 → 无需对应清理；
//    C 的 myp_restore_term/myp_arena_free_all/myp_free_alloc_list_global/
//    myp_weak_free_all/__myp_coro_cleanup_all 等只剩本函数调用 → 变死代码被
//    --gc-sections 剥离。
ffi void myp_release_class_slices_from_depth(long depth);   // region.myp
ffi void myp_region_free_all();                             // region.myp
ffi void myp_restore_term();                                // term.myp（raw 模式还原）
ffi void myp_mem_report();                                  // diag.myp（MYP_MEM_REPORT=1）
void myp_free_all() {
    // 先回收引用环（退出时安全点：工作线程已 join，main 局部 ARC 槽已释放）——
    // 之后 myp_mem_report 才只报真泄漏（环不算泄漏）。
    myp_collect_cycles();
    // MYP_MEM_REPORT=1 时先打泄漏报告（此时 main 局部 ARC 槽已释放 → 只剩泄漏/
    // 程序期对象；arena 尚未 reset，myp_type_name 的计数拷贝仍可分配）。
    myp_mem_report();
    myp_restore_term();
    myp_release_class_slices_from_depth(0);
    myp_region_free_all();
    myp_arena_free_all();
}

// ---- #47：C runtime 残留的 2 个纯逻辑函数（防御性平价；selfhost 不发射）----
// C: void myp_free(void* ptr) —— libc free。仅用于非 arena 指针（selfhost 不发射
// myp_free，MYP 分配走 arena/myp_alloc；防御性 shadow，同 C 语义）。
// ffi 名称即链接符号 → 用 libc 的 `free`。
ffi void free(long ptr);
void myp_free(long ptr) {
    if (ptr != 0) free(ptr);
}

// C: void myp_release_fixed_class_array(void* data, uint64_t count) —— 释放固定
// （栈）类数组的 count 个元素强引用槽；backing 栈缓冲不释放（同 C）。
// selfhost 不发射（固定类数组 ARC 由 generateArcSupport 内联）；防御性平价。
void myp_release_fixed_class_array(long data, long count) {
    if (data == 0) return;
    long i = 0;
    while (i < count) {
        long p = __myp_mem_load_i64(data + i * 8);
        if (p != 0) myp_release(__myp_addr_to_str(p));
        i = i + 1;
    }
}