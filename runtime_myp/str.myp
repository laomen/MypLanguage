// runtime_myp/str.myp — runtime.c 字符串层 myp化（自举编译器编译，MYP 实现）。
// 符号名与 C runtime 一致；链接时置于 libmyp_rt.a 之前 + --allow-multiple-definition
// → MYP 定义优先（shadow C 版本）。验证见 runtime_myp/build.sh + rt_str_test.myp。
//
// 内存暂用 C 分配器 myp_alloc（rc=1/type_id=STR 的计数字符串，返回数据指针）；
// 这是"逻辑 myp化"的中间态——分配器本身后续再移植（用 __myp_mem_* + mmap）。
// 注意：函数体内不得用字符串 == / < / Str.len（会递归调用自身/运行时）。

// C: void* myp_alloc(size_t) —— 计数字符串分配器（数据指针，8 字节头部在 data-8）
ffi string myp_alloc(long size);

// alloc.myp（shadow 同伴模块）——跨模块 FFI
ffi int myp_release(string obj);
ffi int myp_arena_try_extend(long base, long newAligned);
ffi string myp_alloc_str_grow(long size);   // 拼接回退用（2x 增长头，见 alloc.myp）

// C: int32_t myp_strlen(const char* s) —— 字符串头 len 字段（data-12，O(1)）
int myp_strlen(string s) {
    long a = __myp_str_ptr(s);
    if (a == 0) return 0;
    return __myp_mem_load_i32(a - 12);
}

// C: int32_t myp_str_eq(const char* a, const char* b) —— 内容相等（1/0）
int myp_str_eq(string a, string b) {
    int i = 0;
    while (true) {
        int ca = __myp_charcode(a, i);
        int cb = __myp_charcode(b, i);
        if (ca != cb) return 0;
        if (ca == 0) return 1;   // 都到结尾
        i = i + 1;
    }
}

// C: int32_t myp_str_cmp(const char* a, const char* b) —— strcmp 语义，归一 -1/0/1
int myp_str_cmp(string a, string b) {
    int i = 0;
    while (true) {
        int ca = __myp_charcode(a, i);
        int cb = __myp_charcode(b, i);
        if (ca != cb) {
            if (ca < cb) return -1;
            return 1;
        }
        if (ca == 0) return 0;   // 都到结尾，相等
        i = i + 1;
    }
}

// C: int32_t myp_str_contains(const char* s, const char* sub) —— strstr != NULL
int myp_str_contains(string s, string sub) {
    int sl = myp_strlen(s);
    int bl = myp_strlen(sub);
    if (bl == 0) return 1;
    if (bl > sl) return 0;
    for (int i = 0; i + bl <= sl; i = i + 1) {
        int matched = 1;
        for (int j = 0; j < bl; j = j + 1) {
            if (__myp_charcode(s, i + j) != __myp_charcode(sub, j)) { matched = 0; break; }
        }
        if (matched != 0) return 1;
    }
    return 0;
}

// C: int32_t myp_str_index_of(const char* s, const char* sub) —— 首位置，-1 无
int myp_str_index_of(string s, string sub) {
    int sl = myp_strlen(s);
    int bl = myp_strlen(sub);
    if (bl == 0) return 0;
    if (bl > sl) return -1;
    for (int i = 0; i + bl <= sl; i = i + 1) {
        int matched = 1;
        for (int j = 0; j < bl; j = j + 1) {
            if (__myp_charcode(s, i + j) != __myp_charcode(sub, j)) { matched = 0; break; }
        }
        if (matched != 0) return i;
    }
    return -1;
}

// C: int32_t myp_str_starts_with(const char* s, const char* prefix)
int myp_str_starts_with(string s, string prefix) {
    int sl = myp_strlen(s);
    int pl = myp_strlen(prefix);
    if (pl > sl) return 0;
    for (int i = 0; i < pl; i = i + 1) {
        if (__myp_charcode(s, i) != __myp_charcode(prefix, i)) return 0;
    }
    return 1;
}

// C: int32_t myp_str_ends_with(const char* s, const char* suffix)
int myp_str_ends_with(string s, string suffix) {
    int sl = myp_strlen(s);
    int sufl = myp_strlen(suffix);
    if (sufl > sl) return 0;
    for (int i = 0; i < sufl; i = i + 1) {
        if (__myp_charcode(s, sl - sufl + i) != __myp_charcode(suffix, i)) return 0;
    }
    return 1;
}

// C: int32_t myp_str_split_count(const char* s, const char* delim)
int myp_str_split_count(string s, string delim) {
    int sl = myp_strlen(s);
    int dl = myp_strlen(delim);
    if (dl == 0) return 0;
    int count = 0;
    int i = 0;
    while (i < sl) {
        int found = -1;
        for (int k = i; k + dl <= sl; k = k + 1) {
            int m = 1;
            for (int j = 0; j < dl; j = j + 1) {
                if (__myp_charcode(s, k + j) != __myp_charcode(delim, j)) { m = 0; break; }
            }
            if (m != 0) { found = k; break; }
        }
        if (found >= 0) {
            count = count + 1;
            i = found + dl;
        } else {
            count = count + 1;
            break;
        }
    }
    return count;
}

// C: int32_t myp_str_to_int(const char* s) —— 十进制 strtol(10)，无有效数字回 0
int myp_str_to_int(string s) {
    int sl = myp_strlen(s);
    int i = 0;
    while (i < sl) {
        int c = __myp_charcode(s, i);
        if (c == 32 || c == 9 || c == 10 || c == 13) i = i + 1;   // 空白
        else break;
    }
    int neg = 0;
    if (i < sl) {
        int c = __myp_charcode(s, i);
        if (c == 45) { neg = 1; i = i + 1; }   // '-'
        else if (c == 43) i = i + 1;           // '+'
    }
    long v = 0;
    int digits = 0;
    while (i < sl) {
        int c = __myp_charcode(s, i);
        if (c >= 48 && c <= 57) {
            v = v * 10 + (c - 48);
            digits = digits + 1;
            i = i + 1;
        } else break;
    }
    if (digits == 0) return 0;
    if (neg != 0) v = -v;
    return int(v);
}

// ---- 分配型：经 myp_alloc（C 分配器）建计数字符串，__myp_mem_* 写字节 ----

// C: char* myp_str_substring(const char* s, int32_t start, int32_t end)
string myp_str_substring(string s, int start, int end) {
    int len = myp_strlen(s);
    if (start < 0) start = 0;
    if (end > len) end = len;
    if (start >= end) {
        string r = myp_alloc(1);
        __myp_mem_store_i8(__myp_str_ptr(r), 0);
        return r;
    }
    int newLen = end - start;
    string r = myp_alloc(newLen + 1);
    __myp_memcpy(__myp_str_ptr(r), __myp_str_ptr(s) + long(start), newLen);
    __myp_mem_store_i8(__myp_str_ptr(r) + newLen, 0);
    return r;
}

// C: char* myp_str_to_upper(const char* s) —— ASCII a-z → A-Z
string myp_str_to_upper(string s) {
    int len = myp_strlen(s);
    string r = myp_alloc(len + 1);
    long dp = __myp_str_ptr(r);
    for (int i = 0; i < len; i = i + 1) {
        int c = __myp_charcode(s, i);
        if (c >= 97 && c <= 122) c = c - 32;
        __myp_mem_store_i8(dp + i, c);
    }
    __myp_mem_store_i8(dp + len, 0);
    return r;
}

// C: char* myp_str_to_lower(const char* s) —— ASCII A-Z → a-z
string myp_str_to_lower(string s) {
    int len = myp_strlen(s);
    string r = myp_alloc(len + 1);
    long dp = __myp_str_ptr(r);
    for (int i = 0; i < len; i = i + 1) {
        int c = __myp_charcode(s, i);
        if (c >= 65 && c <= 90) c = c + 32;
        __myp_mem_store_i8(dp + i, c);
    }
    __myp_mem_store_i8(dp + len, 0);
    return r;
}

// C: char* myp_str_trim(const char* s) —— 去首尾空白（空格/tab/LF/CR）
string myp_str_trim(string s) {
    int len = myp_strlen(s);
    int i = 0;
    while (i < len) {
        int c = __myp_charcode(s, i);
        if (c == 32 || c == 9 || c == 10 || c == 13) i = i + 1;
        else break;
    }
    int end = len;
    while (end > i) {
        int c = __myp_charcode(s, end - 1);
        if (c == 32 || c == 9 || c == 10 || c == 13) end = end - 1;
        else break;
    }
    int newLen = end - i;
    string r = myp_alloc(newLen + 1);
    __myp_memcpy(__myp_str_ptr(r), __myp_str_ptr(s) + long(i), newLen);
    __myp_mem_store_i8(__myp_str_ptr(r) + newLen, 0);
    return r;
}

// C: char* myp_str_split_get(const char* s, const char* delim, int32_t index)
//     —— 第 index 段；index<0 或超出返回空串。单次调用语义（非逐行循环）。
string myp_str_split_get(string s, string delim, int index) {
    int sl = myp_strlen(s);
    int dl = myp_strlen(delim);
    if (dl == 0 || index < 0) {
        string r = myp_alloc(1);
        __myp_mem_store_i8(__myp_str_ptr(r), 0);
        return r;
    }
    int start = 0;
    int cur = 0;
    int i = 0;
    while (i < sl) {
        int found = -1;
        for (int k = i; k + dl <= sl; k = k + 1) {
            int m = 1;
            for (int j = 0; j < dl; j = j + 1) {
                if (__myp_charcode(s, k + j) != __myp_charcode(delim, j)) { m = 0; break; }
            }
            if (m != 0) { found = k; break; }
        }
        if (found >= 0) {
            if (cur == index) {
                int len = found - start;
                string r = myp_alloc(len + 1);
                __myp_memcpy(__myp_str_ptr(r), __myp_str_ptr(s) + long(start), len);
                __myp_mem_store_i8(__myp_str_ptr(r) + len, 0);
                return r;
            }
            cur = cur + 1;
            start = found + dl;
            i = start;
        } else {
            if (cur == index) {
                int len = sl - start;
                string r = myp_alloc(len + 1);
                __myp_memcpy(__myp_str_ptr(r), __myp_str_ptr(s) + long(start), len);
                __myp_mem_store_i8(__myp_str_ptr(r) + len, 0);
                return r;
            }
            break;
        }
    }
    string r = myp_alloc(1);
    __myp_mem_store_i8(__myp_str_ptr(r), 0);
    return r;
}

// C: char* myp_str_replace(const char* s, const char* old_str, const char* new_str)
//     —— 仅替换首个匹配；未命中返回 s 的拷贝。
string myp_str_replace(string s, string old_str, string new_str) {
    int sl = myp_strlen(s);
    int pos = myp_str_index_of(s, old_str);
    if (pos < 0) {
        string r = myp_alloc(sl + 1);
        __myp_memcpy(__myp_str_ptr(r), __myp_str_ptr(s), sl);
        __myp_mem_store_i8(__myp_str_ptr(r) + sl, 0);
        return r;
    }
    int oldl = myp_strlen(old_str);
    int newl = myp_strlen(new_str);
    int total = sl - oldl + newl;
    string r = myp_alloc(total + 1);
    long dp = __myp_str_ptr(r);
    __myp_memcpy(dp, __myp_str_ptr(s), pos);
    __myp_memcpy(dp + long(pos), __myp_str_ptr(new_str), newl);
    __myp_memcpy(dp + long(pos) + newl, __myp_str_ptr(s) + long(pos + oldl), sl - pos - oldl);
    __myp_mem_store_i8(dp + total, 0);
    return r;
}

// C: char* myp_str_replace_all(const char* s, const char* old_str, const char* new_str)
//     —— 全部替换；old 为空或未命中返回 s 的拷贝。两趟（数次数 → 拼接）。
string myp_str_replace_all(string s, string old_str, string new_str) {
    int sl = myp_strlen(s);
    int oldl = myp_strlen(old_str);
    int newl = myp_strlen(new_str);
    // 空 old_str → 返回 s 拷贝（对齐 C：`!*old_str` 提前返回）。必须在 count 循环
    // 之前——oldl==0 时 `j < oldl` 循环不跑 → found=k=i → i 不前进 → 死循环。
    if (oldl == 0) {
        string r = myp_alloc(sl + 1);
        __myp_memcpy(__myp_str_ptr(r), __myp_str_ptr(s), sl);
        __myp_mem_store_i8(__myp_str_ptr(r) + sl, 0);
        return r;
    }
    int count = 0;
    int i = 0;
    while (i + oldl <= sl) {
        int found = -1;
        for (int k = i; k + oldl <= sl; k = k + 1) {
            int m = 1;
            for (int j = 0; j < oldl; j = j + 1) {
                if (__myp_charcode(s, k + j) != __myp_charcode(old_str, j)) { m = 0; break; }
            }
            if (m != 0) { found = k; break; }
        }
        if (found >= 0) { count = count + 1; i = found + oldl; }
        else break;
    }
    if (oldl == 0 || count == 0) {
        string r = myp_alloc(sl + 1);
        __myp_memcpy(__myp_str_ptr(r), __myp_str_ptr(s), sl);
        __myp_mem_store_i8(__myp_str_ptr(r) + sl, 0);
        return r;
    }
    int total = sl + count * (newl - oldl);
    string r = myp_alloc(total + 1);
    long dp = __myp_str_ptr(r);
    long w = 0;
    i = 0;
    while (i + oldl <= sl) {
        int found = -1;
        for (int k = i; k + oldl <= sl; k = k + 1) {
            int m = 1;
            for (int j = 0; j < oldl; j = j + 1) {
                if (__myp_charcode(s, k + j) != __myp_charcode(old_str, j)) { m = 0; break; }
            }
            if (m != 0) { found = k; break; }
        }
        if (found >= 0) {
            int clen = found - i;
            __myp_memcpy(dp + w, __myp_str_ptr(s) + long(i), clen);
            w = w + clen;
            __myp_memcpy(dp + w, __myp_str_ptr(new_str), newl);
            w = w + newl;
            i = found + oldl;
        } else {
            int rem = sl - i;
            __myp_memcpy(dp + w, __myp_str_ptr(s) + long(i), rem);
            w = w + rem;
            break;
        }
    }
    __myp_mem_store_i8(dp + total, 0);
    return r;
}

// C: char* myp_str_repeat(const char* s, int32_t count) —— count<=0 返回空串
string myp_str_repeat(string s, int count) {
    int sl = myp_strlen(s);
    if (count <= 0) {
        string r = myp_alloc(1);
        __myp_mem_store_i8(__myp_str_ptr(r), 0);
        return r;
    }
    int total = sl * count;
    string r = myp_alloc(total + 1);
    long dp = __myp_str_ptr(r);
    for (int i = 0; i < count; i = i + 1) {
        __myp_memcpy(dp + long(i) * sl, __myp_str_ptr(s), sl);
    }
    __myp_mem_store_i8(dp + total, 0);
    return r;
}

// C: char* myp_str_pad_left(const char* s, int32_t total_len, int32_t pad_char)
string myp_str_pad_left(string s, int total_len, int pad_char) {
    int sl = myp_strlen(s);
    if (sl >= total_len) {
        string r = myp_alloc(sl + 1);
        __myp_memcpy(__myp_str_ptr(r), __myp_str_ptr(s), sl);
        __myp_mem_store_i8(__myp_str_ptr(r) + sl, 0);
        return r;
    }
    int pad = total_len - sl;
    string r = myp_alloc(total_len + 1);
    long dp = __myp_str_ptr(r);
    for (int i = 0; i < pad; i = i + 1) __myp_mem_store_i8(dp + i, pad_char);
    __myp_memcpy(dp + long(pad), __myp_str_ptr(s), sl);
    __myp_mem_store_i8(dp + total_len, 0);
    return r;
}

// C: char* myp_str_pad_right(const char* s, int32_t total_len, int32_t pad_char)
string myp_str_pad_right(string s, int total_len, int pad_char) {
    int sl = myp_strlen(s);
    if (sl >= total_len) {
        string r = myp_alloc(sl + 1);
        __myp_memcpy(__myp_str_ptr(r), __myp_str_ptr(s), sl);
        __myp_mem_store_i8(__myp_str_ptr(r) + sl, 0);
        return r;
    }
    string r = myp_alloc(total_len + 1);
    long dp = __myp_str_ptr(r);
    __myp_memcpy(dp, __myp_str_ptr(s), sl);
    for (int i = 0; i < total_len - sl; i = i + 1) __myp_mem_store_i8(dp + sl + i, pad_char);
    __myp_mem_store_i8(dp + total_len, 0);
    return r;
}

// C: char* myp_str_reverse(const char* s)
string myp_str_reverse(string s) {
    int len = myp_strlen(s);
    string r = myp_alloc(len + 1);
    long dp = __myp_str_ptr(r);
    for (int i = 0; i < len; i = i + 1) {
        __myp_mem_store_i8(dp + i, __myp_charcode(s, len - 1 - i));
    }
    __myp_mem_store_i8(dp + len, 0);
    return r;
}

// C: char* myp_str_join(char** arr, int32_t n) —— 一次分配 + 两趟（先求总长再拷贝）。
// 数组参数 string[] data（自举 codegen varElemType 支持动态数组参数）。
string myp_str_join(string[] data, int n) {
    if (n <= 0) {
        string r = myp_alloc(1);
        __myp_mem_store_i8(__myp_str_ptr(r), 0);
        return r;
    }
    int total = 0;
    for (int i = 0; i < n; i = i + 1) {
        string e = data[i];
        total = total + myp_strlen(e);
    }
    string r = myp_alloc(total + 1);
    long dp = __myp_str_ptr(r);
    long w = 0;
    for (int i = 0; i < n; i = i + 1) {
        string e = data[i];
        int l = myp_strlen(e);
        __myp_memcpy(dp + w, __myp_str_ptr(e), l);
        w = w + l;
    }
    __myp_mem_store_i8(dp + total, 0);
    return r;
}

// C: char* myp_strcat(const char* a, const char* b) —— 通用拼接（codegen 对 s+t
// 发射 @myp_strcat；自举编译的程序里所有非 `s=s+x` 快路径拼接都走这里）。
string myp_strcat(string a, string b) {
    int la = myp_strlen(a);
    int lb = myp_strlen(b);
    string r = myp_alloc(la + lb + 1);
    long dp = __myp_str_ptr(r);
    __myp_memcpy(dp, __myp_str_ptr(a), la);
    __myp_memcpy(dp + long(la), __myp_str_ptr(b), lb);
    __myp_mem_store_i8(dp + long(la) + lb, 0);
    return r;
}

// C: char* myp_strdup(const char* s) —— 拷贝计数字符串（含 NUL）
string myp_strdup(string s) {
    int len = myp_strlen(s);
    string r = myp_alloc(len + 1);
    __myp_memcpy(__myp_str_ptr(r), __myp_str_ptr(s), len + 1);
    return r;
}

// C: char* myp_str_append(const char* s, const char* x) —— `s = s + x` 快路径。
// codegen 对 `s = s + x`（owned 局部 + 双字符串）发射 call @myp_str_append + 普通
// store（不 retain/release）——本函数消耗 s（调用方不再 release 旧值），返回新串。
// C 版用 realloc 原地扩展（rc==1 唯一时读假头 node = data-sizeof(node) 再 realloc）
// ——shadow 下内存是 arena → realloc 假头/崩溃（潜在 bug，shadow 用例未触发因
// `s=s+x` 快路径需 owned 局部）。MYP 版：若 s 唯一（rc==1）且是 arena 最后一次分配
// → bump 原地扩展（O(1) 均摊，避免 N² 累积）；否则回落手动拷贝（myp_alloc_str_grow
// 2x 增长头分配，不用 myp_strcat——其内部 releaseArcSlots 会扣一次 Live，我再 return
// 别名又扣一次 → 重复扣减；手动 alloc 的 rc 循环恰好 +1/-1 相抵）。
// ARC 约定（自举编译器）：`return <owned 局部 r>` = retain(r) + releaseArcSlots(r)
// → 净 rc=0（Live +1/-1 相抵）；`return <参数 s>` = 仅 retain（参数不被 releaseArcSlots
// 释放）→ 须先置 rc=0 让 retain 补成 1（原地路径返回的 s 仍归调用方槽持有）。
string myp_str_append(string s, string x) {
    long sp = __myp_str_ptr(s);
    long xp = __myp_str_ptr(x);
    if (sp == 0) {   // s null → dup x（fresh，rc=0 按约定，无 retain）
        if (xp == 0) {
            string r = myp_alloc(1);
            __myp_mem_store_i8(__myp_str_ptr(r), 0);
            return r;
        }
        return myp_strdup(x);
    }
    if (xp == 0) {
        __myp_atomic_store_i32_addr(sp - 8, 0);   // rc 1→0（return 参数仅 retain → 1）
        return s;
    }
    int la = myp_strlen(s);
    int lb = myp_strlen(x);
    if (sp != xp) {   // 自拼接（sp==xp）跳过原地扩展，走手动拷贝（保守，同 C）
        int rc = __myp_atomic_load_i32_addr(sp - 8);
        if (rc == 1) {
            // **块内原地扩展**（8B total 前缀 @data-20，cap_data = total-20）：唯一
            // （rc==1）且容量够 → 不论 bump-tail 位置直接在 s 数据区内写 → O(lb)
            // 均摊（几何增长）。根治 s=s+i 因 temp 破坏 try_extend（bump-tail 检查）
            // 导致的 O(N²) 分配/拷贝 + arena O(N²) 内存爆炸（纯 bump 不回收）。
            long capData = __myp_mem_load_i64(sp - 20) - 20;
            if (capData >= long(la) + long(lb) + 1) {
                __myp_memcpy(sp + long(la), xp, lb);
                __myp_mem_store_i8(sp + long(la) + lb, 0);
                __myp_mem_store_i32(sp - 12, la + lb);   // 更新 len 字段
                __myp_atomic_store_i32_addr(sp - 8, 0);  // rc 1→0（return 参数仅 retain → 1）
                return s;
            }
        }
    }
    // 手动拷贝慢路径（也覆盖自拼接）——r 由 myp_alloc_str_grow 建（2x 增长头），
    // return r 净 rc=0（同 myp_alloc 约定）
    string r = myp_alloc_str_grow(long(la) + long(lb) + 1);
    long dp = __myp_str_ptr(r);
    __myp_memcpy(dp, sp, la);
    __myp_memcpy(dp + long(la), xp, lb);
    __myp_mem_store_i8(dp + long(la) + lb, 0);
    myp_release(s);
    return r;
}

// C: int32_t myp_ord(const char* s) —— 首字符 ASCII 码（空回 0）
int myp_ord(string s) {
    return __myp_mem_load_i8(__myp_str_ptr(s));
}

// C: int32_t myp_charcode(const char* s, int32_t i) —— O(1) 第 i 字符码（i<0 回 0）
// 注意：不能经 __myp_charcode（该内建发射 call @myp_charcode → 本函数 → 无限递归）；
// 直接 raw-memory 读字节（= (unsigned char)s[i]，同 C 版无上界检查）。
int myp_charcode(string s, int i) {
    if (i < 0) return 0;
    return __myp_mem_load_i8(__myp_str_ptr(s) + i);
}

// C: const char* myp_chr(int32_t code) —— 码点 → 1-4 字节 UTF-8 计数字符串
//（非法码点 → 0xFFFD 替换符）
string myp_chr(int code) {
    if (code < 0 || code > 1114111) code = 65533;   // 0xFFFD
    int c0 = 0;
    int c1 = 0;
    int c2 = 0;
    int c3 = 0;
    int n = 0;
    if (code < 128) { c0 = code; n = 1; }
    else if (code < 2048) { c0 = 192 | (code >> 6); c1 = 128 | (code & 63); n = 2; }
    else if (code < 65536) { c0 = 224 | (code >> 12); c1 = 128 | ((code >> 6) & 63); c2 = 128 | (code & 63); n = 3; }
    else { c0 = 240 | (code >> 18); c1 = 128 | ((code >> 12) & 63); c2 = 128 | ((code >> 6) & 63); c3 = 128 | (code & 63); n = 4; }
    string r = myp_alloc(n + 1);
    long dp = __myp_str_ptr(r);
    __myp_mem_store_i8(dp, c0);
    if (n > 1) __myp_mem_store_i8(dp + 1, c1);
    if (n > 2) __myp_mem_store_i8(dp + 2, c2);
    if (n > 3) __myp_mem_store_i8(dp + 3, c3);
    __myp_mem_store_i8(dp + n, 0);
    return r;
}

// C: int32_t myp_str_hash(const char* s) —— djb2（uint32 回绕，掩 0x7FFFFFFF）
//（0xFFFFFFFF 超 int32 字面量 MYP 不解析 → 用 % 4294967296 做 32 位回绕）
int myp_str_hash(string s) {
    int len = myp_strlen(s);
    long hash = 5381;
    for (int i = 0; i < len; i = i + 1) {
        int c = __myp_charcode(s, i);
        hash = (hash * 33 + c) % 4294967296;
    }
    return int(hash & 2147483647);
}
