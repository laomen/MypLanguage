// runtime_myp/coro.myp — 协程核心 MYP 化（包 D Phase A 切片：单线程生命周期核心）。
// shadow C runtime 的 __myp_coro_*（编译器契约 27 个函数，见 CORO_DESIGN §2）。
// C 版用 __thread TLS（槽表/当前协程/entry args 均线程本地）；MYP 版用 @static
// 全局（进程级共享，非 TLS——已文档化限制，与 MYP @static 模型一致；多线程协程表
// 共享需自旋锁，见 CORO_DESIGN §5-6）。
//
// 本切片实现（生命周期核心）：
//   create / set_entry / set_entry_arg / get_entry_arg / yield / resume /
//   set_result / result / status / is_active / count / current_handle /
//   request_cancel / cancel_requested / cancel_clear / destroy / scheduler
//   （retired drain）+ trampoline（MYP try/catch 异常边界）。
// 未实现（Phase B/C，回落 C runtime 或 stub）：wait_event/sleep/wait_fd/wait_any/
//   wait_any_of（事件层）、frame_set/clear（ARC 帧表镜像，stub 空操作）、通道/未来、
//   exec worker。__myp_coro_* 若 MYP 未定义 → 链接回落 C runtime。
//
// 关键机制：
//   - myp_ctx_switch(save, load) 存/换 rsp —— ctx/retCtx 槽是**裸 arena 缓冲**
//     （base + slot*8），因为 ctx_switch 需要槽的**地址**（写入保存的 rsp）。
//   - 句柄 = {generation<<32 | slot}（代际防陈旧句柄别名新协程）。
//   - 栈：mmap 每协程；完成（trampoline）→ 退役列表（不能就地 munmap，正运行其
//     上）→ 下次 create/scheduler drain（munmap）。无栈池（Phase C）。
//   - trampoline 异常边界 = MYP try/catch（编译器发射 setjmp + myp_exception_push，
//     每协程进入时 push 自己的 jb；单线程同时只跑一个协程 → LIFO 栈顶恒为当前
//     协程边界）。
//   - entry args：@static long[16] 共享槽（同 C 线程本地共享；只在 entry 读一次）。

ffi long myp_arena_alloc(long size);
ffi int myp_strlen(string s);
ffi string myp_alloc(long size);
ffi void myp_event_process_all();   // C 事件系统（包 F 前保留 C；dispatch → MYP event_notify）
ffi long myp_now_ms();              // time.myp
ffi void myp_sleep_ms(long ms);     // time.myp（非协程 sleep 回退）
ffi int myp_release(string obj);    // alloc.myp（帧表 release；经 __myp_addr_to_str 桥接任意指针）
ffi long myp_thread_spawn(long entryAddr);   // thread.myp（clone 原语；async exec worker）
ffi void myp_pause();               // 自旋让步（weak.myp/内建）
ffi long pthread_self();             // libc：exec mailbox 的 owner 线程匹配（pump）
ffi long malloc(long size);          // libc：协程栈堆分配（C 平价快路径，小栈零 syscall）
ffi void free(long p);               // libc：栈池淘汰时释放
ffi long execIoReadLineRaw(int handle);      // io.myp（raw addr，无 string 局部）
ffi long execIoReadAllRaw(int handle);       // io.myp

// ---- 全局递归锁（@thread 并发协程表保护；coro_thread 竞态修复）----
// C 版用 __thread TLS 每线程独立协程表；MYP @static 全局共享 → 多线程并发操作
// 协程表会损坏（槽分配/current/退役竞态）。用**递归锁**（owner tid + depth）：
//   - resume 持锁跨 ctx_switch（协程一步运行期间独占全局）
//   - yield 递归重入不释放（由 resume 统一释放）→ 深度账目干净
// N×M:1 每线程表（v3.15.77）：协程表是 @static @thread（每线程一份），同一线程
// 独占访问无需互斥。coroLock/coroUnlock 保留为 no-op（40+ 调用点不变）；跨线程
// exec 结果走 CoroExec mailbox（自带自旋锁）。
void coroLock() { }
void coroUnlock() { }
void coroMarkMultiThread() { }   // 每线程表无全局锁，无需切换

// ---- 协程表（每线程 @static @thread；C 为 TLS）----
// 常量内联（MYP 无顶层 const；字面量）

@static @thread class CoroT {
    property:
        long ctxBase = 0;       // ctx 槽 arena 缓冲（CoroCap.coro*8；扩容时换新块+拷贝）
        long retCtxBase = 0;    // retCtx 槽 arena 缓冲
        long[] stack;       // 栈基址（mmap 预留+守护页）——动态扩容（解除 1024 上限）
        long[] stackSize;
        long[] fn;          // entry 函数地址
        long[] result;
        long[] yieldVal;
        long[] resumeVal;
        long[] execResult;      // §五-5 P3：async exec worker 结果（raw addr，跨线程投递）
        int[] active;
        int[] ready;
        int[] generation;
        int[] resultPending;
        int[] onFreeList;
        int[] discardResult;
        int[] cancelRequested;
        // Phase B：等待/唤醒状态
        int[] waitTimeout;       // 被调度器截止期唤醒（1=超时；wait_* 据此返回 -1）
        int[] lastWaitEventId;   // wait_any：唤醒的事件 id（-1=无）
        int[] lastWaitIndex;     // wait_any_of：唤醒的 spec 下标（-1=无）
        int count = 0;
        int current = -1;
        // 空闲槽复用列表
        int[] freeSlots;
        int freeCount = 0;
}
// ---- Phase B：等待表（wait_* 注册；C myp_coro_wait_t 的 @static 并行数组版）----
// kind：0=EVENT 1=TIMER(sleep) 2=FD 3=EXEC(未用)。waitIndex：>=0 waitAnyOf spec
// 下标；-1 普通等待；-2 waitAnyOf 总体超时标记。deadline=0 表示无截止期。
@static @thread class CoroW {
    property:
        int[] kind;
        int[] eventId;
        int[] fd;
        int[] fdEvents;     // POLLIN=1 POLLOUT=4
        long[] handle;
        int[] active;
        long[] deadline;
        int[] expired;
        long[] execResult;
        int[] waitIndex;
        int count = 0;
}
// ---- Phase B：帧表（ARC 镜像；每协程 ≤32 槽，扁平数组 coro*32+i；随 coro 扩容）----
@static @thread class CoroF {
    property:
        long[] slotId;     // CoroCap.coro*32（slot_id = alloca 地址，仅作键）
        long[] obj;        // 堆对象指针（release 目标）
        int[] count;
}
// ---- 容量跟踪（CoroT/CoroF 用 coro 容量；CoroW 独立 wait 容量）----
@static @thread class CoroCap {
    property:
        int coro = 0;
        int wait = 0;
}
// 数组扩容辅助：new 新容量 + 逐元素拷贝旧内容（低频/容量小，可接受）
long[] coroGrowLong(long[] src, int old, int nc) {
    long[] r = new long[nc];
    for (int i = 0; i < old; i = i + 1) r[i] = src[i];
    return r;
}
int[] coroGrowInt(int[] src, int old, int nc) {
    int[] r = new int[nc];
    for (int i = 0; i < old; i = i + 1) r[i] = src[i];
    return r;
}
// ---- Phase B：fd poll 缓冲（arena；8B×1024 pollfd）----
@static @thread class CoroPoll {
    property:
        long buf = 0;
        int inited = 0;
}
@static @thread class CoroArgs {
    property:
        long[16] args;    // entry 参数（this@0 + params@1..；共享槽，同 C 线程本地）
}
@static @thread class CoroRetired {
    property:
        long[] ptrs;     // 动态扩容（同 C realloc；退役栈只在安全点 drain 时释放）
        long[] sizes;
        int count = 0;
        int cap = 0;
}
void coroRetiredEnsure(int n) {
    if (CoroRetired.cap >= n) return;
    int nc = CoroRetired.cap == 0 ? 256 : CoroRetired.cap * 2;
    while (nc < n) nc = nc * 2;
    int old = CoroRetired.cap;
    CoroRetired.ptrs = coroGrowLong(CoroRetired.ptrs, old, nc);
    CoroRetired.sizes = coroGrowLong(CoroRetired.sizes, old, nc);
    CoroRetired.cap = nc;
}

// ---- 一次性状态初始化 ----
// ⚠️ 曾因 @static 属性默认值不生效（全局 zeroinitializer，v3.15.69 已修复）→
// CoroT.current `= -1` 从 0 起，0 恰等于首个协程槽号 → main（非协程）在 spawn 后
// 被误判为「在协程 0」→ 需 coroEnsureInit() 显式置 -1。现默认值由显式初始化器
// 生效，`CoroT.current = -1` 已回滚（初始值即 -1），仅保留惰性表分配。
@static @thread class CoroInit {
    property:
        int done = 0;
}
// CoroT/CoroF（per-coro×32）扩容到 ≥n 槽（初始 64，翻倍；CoroW 保持 ≥coro 容量）
void coroTEnsure(int n) {
    if (CoroCap.coro >= n) return;
    int nc = CoroCap.coro == 0 ? 64 : CoroCap.coro * 2;
    while (nc < n) nc = nc * 2;
    int old = CoroCap.coro;
    CoroT.stack = coroGrowLong(CoroT.stack, old, nc);
    CoroT.stackSize = coroGrowLong(CoroT.stackSize, old, nc);
    CoroT.fn = coroGrowLong(CoroT.fn, old, nc);
    CoroT.result = coroGrowLong(CoroT.result, old, nc);
    CoroT.yieldVal = coroGrowLong(CoroT.yieldVal, old, nc);
    CoroT.resumeVal = coroGrowLong(CoroT.resumeVal, old, nc);
    CoroT.execResult = coroGrowLong(CoroT.execResult, old, nc);
    CoroT.active = coroGrowInt(CoroT.active, old, nc);
    CoroT.ready = coroGrowInt(CoroT.ready, old, nc);
    CoroT.generation = coroGrowInt(CoroT.generation, old, nc);
    CoroT.resultPending = coroGrowInt(CoroT.resultPending, old, nc);
    CoroT.onFreeList = coroGrowInt(CoroT.onFreeList, old, nc);
    CoroT.discardResult = coroGrowInt(CoroT.discardResult, old, nc);
    CoroT.cancelRequested = coroGrowInt(CoroT.cancelRequested, old, nc);
    CoroT.waitTimeout = coroGrowInt(CoroT.waitTimeout, old, nc);
    CoroT.lastWaitEventId = coroGrowInt(CoroT.lastWaitEventId, old, nc);
    CoroT.lastWaitIndex = coroGrowInt(CoroT.lastWaitIndex, old, nc);
    CoroT.freeSlots = coroGrowInt(CoroT.freeSlots, old, nc);
    // CoroF（per-coro×32 扁平）
    CoroF.slotId = coroGrowLong(CoroF.slotId, old * 32, nc * 32);
    CoroF.obj = coroGrowLong(CoroF.obj, old * 32, nc * 32);
    CoroF.count = coroGrowInt(CoroF.count, old, nc);
    // ctx/retCtx arena 缓冲（换新块 + 拷贝旧值；ctx_switch 每次经 base+slot*8 取址）
    long nb = myp_arena_alloc(long(nc) * 8);
    if (CoroT.ctxBase != 0) __myp_memcpy(nb, CoroT.ctxBase, long(old) * 8);
    CoroT.ctxBase = nb;
    long nb2 = myp_arena_alloc(long(nc) * 8);
    if (CoroT.retCtxBase != 0) __myp_memcpy(nb2, CoroT.retCtxBase, long(old) * 8);
    CoroT.retCtxBase = nb2;
    CoroCap.coro = nc;
    coroWEnsure(nc);   // 等待表保持 ≥ coro 容量
}
// CoroW 扩容到 ≥n（可超 coro 容量：wait_any 一个协程可注册多条）
void coroWEnsure(int n) {
    if (CoroCap.wait >= n) return;
    int nc = CoroCap.wait == 0 ? 64 : CoroCap.wait * 2;
    while (nc < n) nc = nc * 2;
    int old = CoroCap.wait;
    CoroW.kind = coroGrowInt(CoroW.kind, old, nc);
    CoroW.eventId = coroGrowInt(CoroW.eventId, old, nc);
    CoroW.fd = coroGrowInt(CoroW.fd, old, nc);
    CoroW.fdEvents = coroGrowInt(CoroW.fdEvents, old, nc);
    CoroW.active = coroGrowInt(CoroW.active, old, nc);
    CoroW.expired = coroGrowInt(CoroW.expired, old, nc);
    CoroW.waitIndex = coroGrowInt(CoroW.waitIndex, old, nc);
    CoroW.handle = coroGrowLong(CoroW.handle, old, nc);
    CoroW.deadline = coroGrowLong(CoroW.deadline, old, nc);
    CoroW.execResult = coroGrowLong(CoroW.execResult, old, nc);
    CoroCap.wait = nc;
}

void coroEnsureInit() {
    if (CoroInit.done == 0) {
        CoroInit.done = 1;
        // CoroT.current 初始值 = -1 由 @static 默认值初始化器生效（v3.15.69 修复）。
    }
    coroTEnsure(64);   // 惰性分配协程/等待/帧表（初始 64，同 C MYP_CORO_INITIAL_CAPACITY）
}

// ---- myp_ctx_switch（内联汇编上下文切换，保留原实现）----
void myp_ctx_switch(long save, long load) {
    __myp_asm(
        "pushq %rbp; pushq %rbx; pushq %r12; pushq %r13; pushq %r14; pushq %r15; "
        + "leaq 1f(%rip), %rax; pushq %rax; movq %rsp, (%rdi); movq (%rsi), %rsp; "
        + "popq %rax; popq %r15; popq %r14; popq %r13; popq %r12; popq %rbx; popq %rbp; "
        + "jmpq *%rax; 1:",
        "{rdi},{rsi},~{rax},~{rbx},~{rcx},~{rdx},~{r8},~{r9},~{r10},~{r11},~{r12},"
        + "~{r13},~{r14},~{r15},~{rbp},~{memory}",
        save, load);
}

// ---- 内部辅助 ----
// ctx/retCtx arena 缓冲由 coroTEnsure 惰性分配 + 扩容（返回当前 base；调用方须已
// coroEnsureInit）
long coroCtxBase() {
    return CoroT.ctxBase;
}
long coroRetCtxBase() {
    return CoroT.retCtxBase;
}
int coroSlotOf(long h) { return int(h & 0xFFFFFFFF); }
int coroGenOf(long h) { return int(h >> 32); }
int coroHandleValid(long h) {
    int slot = coroSlotOf(h);
    int gen = coroGenOf(h);
    if (slot < 0 || slot >= CoroT.count) return 0;
    if (CoroT.generation[slot] != gen) return 0;
    return 1;
}
long coroMakeHandle(int slot) {
    if (slot < 0 || slot >= CoroT.count) return -1;
    return (long(CoroT.generation[slot]) << 32) | long(slot);
}
// 槽可复用：不活跃 且 无未读结果 且 不在列表 → 入空闲列表（M1）
void coroTryRecycle(int slot) {
    if (slot < 0 || slot >= CoroT.count) return;
    if (CoroT.active[slot] == 0 && CoroT.resultPending[slot] == 0 &&
        CoroT.onFreeList[slot] == 0) {
        CoroT.onFreeList[slot] = 1;
        if (CoroT.freeCount < 1024) {
            CoroT.freeSlots[CoroT.freeCount] = slot;
            CoroT.freeCount = CoroT.freeCount + 1;
        }
    }
}
int coroPopFree() {
    if (CoroT.freeCount <= 0) return -1;
    CoroT.freeCount = CoroT.freeCount - 1;
    int s = CoroT.freeSlots[CoroT.freeCount];
    if (s >= 0 && s < CoroT.count) CoroT.onFreeList[s] = 0;
    return s;
}
// ---- 动态栈：混合分配（Go 式增长，无拷贝/无编译器改动）----
// 预留量 = 栈增长上限。小栈（<128KB，显式 @coro(stack=N) 小值）走堆 malloc——C runtime
// 同款（glibc arena 出块零 syscall → spawn 快）；大栈/默认（≥128KB，1MB 动态栈）走
// mmap 懒提交（RSS 只算实际使用页）+ 底部 4KB PROT_NONE 守护页（真跑飞干净 SIGSEGV，
// 替代静默堆破坏，同 Go maxstacksize 语义）。阈值同 glibc MMAP_THRESHOLD。
// 常量（MYP 无顶层 const，内联字面量）：
//   DEFAULT=1MB(1048576)  MIN=64KB(65536)  MAX=64MB(67108864)  GUARD=4096
long coroReserveSize(long requested) {
    long reserve = 1048576;   // DEFAULT 1MB
    // 编译器无 @coro 注解时传 128KB（131072）→ 视为默认，给 1MB 动态余量；
    // 显式 @coro(stack=N)（≠128KB）尊重 N。
    if (requested > 0 && requested != 131072) reserve = requested;
    if (reserve < 65536) reserve = 65536;
    if (reserve > 67108864) reserve = 67108864;
    return reserve;
}
// 小栈：malloc（C 平价，arena 零 syscall）；大栈：mmap reserve+guard（懒提交 + 溢出保护）
long coroStackAlloc(long reserve) {
    if (reserve < 131072) return malloc(reserve);   // <128KB → 堆分配
    long total = reserve + 4096;
    long base = __myp_syscall(9, 0, total, 3, 0x4022, -1, 0);  // RW|NORESERVE|ANON|PRIVATE
    if (base == -1 || base == 0) return 0;
    __myp_syscall(10, base, 4096, 0, 0, 0, 0);   // mprotect 低 4KB PROT_NONE
    return base + 4096;
}
// ---- 栈池（C 平价：复用预留，避免 spawn/destroy churn）----
@static @thread class CoroStackPool {
    property:
        long[64] ptrs;     // 可用栈基址
        long[64] sizes;    // 可用尺寸（预留）
        long total = 0;    // 池内 VA 总字节
        int count = 0;
}
long coroStackTake(long reserve) {
    int best = -1;
    for (int i = 0; i < CoroStackPool.count; i = i + 1) {
        if (CoroStackPool.sizes[i] >= reserve &&
            (best < 0 || CoroStackPool.sizes[i] < CoroStackPool.sizes[best]))
            best = i;
    }
    if (best >= 0) {
        long p = CoroStackPool.ptrs[best];
        long s = CoroStackPool.sizes[best];
        CoroStackPool.ptrs[best] = CoroStackPool.ptrs[CoroStackPool.count - 1];
        CoroStackPool.sizes[best] = CoroStackPool.sizes[CoroStackPool.count - 1];
        CoroStackPool.total = CoroStackPool.total - s;
        CoroStackPool.count = CoroStackPool.count - 1;
        return p;
    }
    return coroStackAlloc(reserve);
}
// 回池（有界：64 项 / VA 128MB）或释放（小栈 free；大栈 munmap 含守护页）
void coroStackReturn(long ptr, long reserve) {
    if (CoroStackPool.count < 64 && CoroStackPool.total + reserve <= 134217728) {
        CoroStackPool.ptrs[CoroStackPool.count] = ptr;
        CoroStackPool.sizes[CoroStackPool.count] = reserve;
        CoroStackPool.total = CoroStackPool.total + reserve;
        CoroStackPool.count = CoroStackPool.count + 1;
        return;
    }
    if (reserve < 131072) { free(ptr); return; }   // 小栈：堆释放
    __myp_syscall(11, ptr - 4096, reserve + 4096, 0, 0, 0, 0);  // 大栈：munmap 含守护页
}
// 退役栈：trampoline 完成时登记（不能就地 munmap，正运行其上）→ 下次 create/
// scheduler drain 时回池/munmap。列表动态扩容（同 C realloc）——**绝不在 add
// 时释放栈**（trampoline 尚在该栈上运行；满时直接释放会被池复用 → 双重使用
// 损坏栈，coro_capacity 1500 驱动崩溃即此）。
void coroRetiredAdd(long ptr, long size) {
    if (CoroRetired.count >= CoroRetired.cap) coroRetiredEnsure(CoroRetired.count + 1);
    CoroRetired.ptrs[CoroRetired.count] = ptr;
    CoroRetired.sizes[CoroRetired.count] = size;
    CoroRetired.count = CoroRetired.count + 1;
}
void coroRetiredDrain() {
    int i = 0;
    while (i < CoroRetired.count) {
        coroStackReturn(CoroRetired.ptrs[i], CoroRetired.sizes[i]);
        i = i + 1;
    }
    CoroRetired.count = 0;
}
// ctx 初始化：top-64 保存块 [entry, 0,0,0,0,0,0]；入口 rsp%16==8（同 C myp_ctx_init）
void coroCtxInit(int slot) {
    long top = CoroT.stack[slot] + CoroT.stackSize[slot];
    top = top - (top % 16);
    long rsp = top - 64;
    long entry = __myp_fn_addr("__myp_coro_trampoline");
    __myp_mem_store_i64(rsp, entry);
    for (long i = 8; i <= 56; i = i + 8) __myp_mem_store_i64(rsp + i, 0);
    __myp_mem_store_i64(coroCtxBase() + long(slot) * 8, rsp);
}

// ---- 生命周期 ----
// C: int64_t __myp_coro_create(int64_t stack_bytes)
long __myp_coro_create(long stack_bytes) {
    coroLock();
    coroEnsureInit();
    coroRetiredDrain();
    // 动态栈：预留 = clamp(requested, 64KB, 64MB)；编译器默认 128KB（无 @coro）→
    // 提升到 1MB 默认预留（Go 式动态增长余量；RSS 按实际使用按需提交）。
    long size = coroReserveSize(stack_bytes > 0 ? stack_bytes : 131072);
    int idx = coroPopFree();
    if (idx < 0) {
        coroTEnsure(CoroT.count + 1);   // 解除 1024 上限：动态扩容
        idx = CoroT.count;
        CoroT.count = CoroT.count + 1;
    }
    CoroT.generation[idx] = CoroT.generation[idx] + 1;
    long st = coroStackTake(size);   // 栈池复用或 mmap 预留+守护页
    if (st == 0) { coroUnlock(); return -1; }
    CoroT.stack[idx] = st;
    CoroT.stackSize[idx] = size;
    coroCtxInit(idx);
    CoroT.active[idx] = 1;
    CoroT.ready[idx] = 1;
    CoroT.result[idx] = 0;
    CoroT.resultPending[idx] = 0;
    CoroT.onFreeList[idx] = 0;
    CoroT.discardResult[idx] = 0;
    CoroT.cancelRequested[idx] = 0;
    CoroT.yieldVal[idx] = 0;
    CoroT.resumeVal[idx] = 0;
    CoroT.waitTimeout[idx] = 0;
    CoroT.lastWaitEventId[idx] = -1;
    CoroT.lastWaitIndex[idx] = -1;
    CoroF.count[idx] = 0;      // 帧表重置（防槽复用时残留）
    long h = coroMakeHandle(idx);
    coroUnlock();
    return h;
}

// C: void __myp_coro_set_entry(int64_t handle, int64_t fn_ptr)
void __myp_coro_set_entry(long handle, long fn_ptr) {
    coroLock();
    if (coroHandleValid(handle) == 0) { coroUnlock(); return; }
    int idx = coroSlotOf(handle);
    CoroT.fn[idx] = fn_ptr;
    coroUnlock();
}

// C: void __myp_coro_set_entry_arg(int64_t idx, int64_t val)
void __myp_coro_set_entry_arg(long idx, long val) {
    coroLock();
    if (idx >= 0 && idx < 16) CoroArgs.args[int(idx)] = val;
    coroUnlock();
}
// C: int64_t __myp_coro_get_entry_arg(int64_t idx)
long __myp_coro_get_entry_arg(long idx) {
    coroLock();
    long r = 0;
    if (idx >= 0 && idx < 16) r = CoroArgs.args[int(idx)];
    coroUnlock();
    return r;
}

// C: int64_t __myp_coro_yield(int64_t val) —— 挂起当前协程，切回调用者
// 锁：**不加锁**——yield 只在 resume 持锁运行期间被调用（current>=0 保证），锁由
// resume 跨 ctx_switch 持有、resume post-switch 统一释放。若 yield 再加锁，每次
// yield 泄漏一层深度（单线程递归无感；跨线程 worker 的 coroLock 将永远等不到
// 释放 → 死锁，async_file 根因）。
long __myp_coro_yield(long val) {
    coroEnsureInit();
    if (CoroT.current < 0) return 0;
    int saved = CoroT.current;
    CoroT.yieldVal[saved] = val;
    CoroT.current = -1;
    myp_ctx_switch(coroCtxBase() + long(saved) * 8,
                   coroRetCtxBase() + long(saved) * 8);
    CoroT.current = saved;
    return CoroT.resumeVal[saved];
}

// C: int64_t __myp_coro_resume(int64_t handle, int64_t val) —— 恢复协程
// 锁：跨 ctx_switch 持锁（协程一步运行期间独占全局；yield 递归重入，由本函数
// 收尾释放）。
long __myp_coro_resume(long handle, long val) {
    coroLock();
    coroEnsureInit();
    if (coroHandleValid(handle) == 0) { coroUnlock(); return -1; }
    int idx = coroSlotOf(handle);
    if (CoroT.active[idx] == 0) { coroUnlock(); return -1; }
    CoroT.resumeVal[idx] = val;
    int saved = CoroT.current;
    CoroT.current = idx;
    myp_ctx_switch(coroRetCtxBase() + long(idx) * 8,
                   coroCtxBase() + long(idx) * 8);
    CoroT.current = saved;
    coroUnlock();
    return CoroT.yieldVal[idx];
}

// C: void __myp_coro_set_result(int64_t val) —— @coro 方法 return 存结果
void __myp_coro_set_result(long val) {
    coroLock();
    coroEnsureInit();
    if (CoroT.current >= 0 && CoroT.current < CoroT.count) {
        CoroT.result[CoroT.current] = val;
    }
    coroUnlock();
}

// C: int64_t __myp_coro_result(int64_t handle)
long __myp_coro_result(long handle) {
    coroLock();
    if (coroHandleValid(handle) == 0) { coroUnlock(); return 0; }
    int idx = coroSlotOf(handle);
    long r = CoroT.result[idx];
    CoroT.resultPending[idx] = 0;
    coroTryRecycle(idx);
    coroUnlock();
    return r;
}

// C: int64_t __myp_coro_is_active(int64_t handle)
long __myp_coro_is_active(long handle) {
    coroLock();
    if (coroHandleValid(handle) == 0) { coroUnlock(); return 0; }
    int idx = coroSlotOf(handle);
    long r = CoroT.active[idx] != 0 ? 1 : 0;
    coroUnlock();
    return r;
}

// C: int64_t __myp_coro_status(int64_t handle) —— -1 无效 / 0 完成 / 1 ready / 2 阻塞
long __myp_coro_status(long handle) {
    coroLock();
    if (coroHandleValid(handle) == 0) { coroUnlock(); return -1; }
    int idx = coroSlotOf(handle);
    long r;
    if (CoroT.active[idx] == 0) r = 0;
    else r = CoroT.ready[idx] != 0 ? 1 : 2;
    coroUnlock();
    return r;
}

// C: int64_t __myp_coro_count(void) —— 活跃协程数
long __myp_coro_count() {
    coroLock();
    int n = 0;
    for (int i = 0; i < CoroT.count; i = i + 1) {
        if (CoroT.active[i] != 0) n = n + 1;
    }
    coroUnlock();
    return n;
}

// C: int64_t __myp_coro_current_handle(void)
long __myp_coro_current_handle() {
    coroLock();
    coroEnsureInit();
    long r = coroMakeHandle(CoroT.current);
    coroUnlock();
    return r;
}

// ---- 协作式取消 ----
// C: void __myp_coro_request_cancel(int64_t handle)
void __myp_coro_request_cancel(long handle) {
    coroLock();
    if (coroHandleValid(handle) == 0) { coroUnlock(); return; }
    int idx = coroSlotOf(handle);
    CoroT.cancelRequested[idx] = 1;
    coroUnlock();
}
// C: int64_t __myp_coro_cancel_requested(void)
long __myp_coro_cancel_requested() {
    coroLock();
    coroEnsureInit();
    long r = 0;
    if (CoroT.current >= 0 && CoroT.current < CoroT.count) {
        r = CoroT.cancelRequested[CoroT.current] != 0 ? 1 : 0;
    }
    coroUnlock();
    return r;
}
// C: void __myp_coro_cancel_clear(void)
void __myp_coro_cancel_clear() {
    coroLock();
    coroEnsureInit();
    if (CoroT.current >= 0 && CoroT.current < CoroT.count) {
        CoroT.cancelRequested[CoroT.current] = 0;
    }
    coroUnlock();
}

// C: void __myp_coro_destroy(int64_t handle)
void __myp_coro_destroy(long handle) {
    coroLock();
    coroEnsureInit();
    if (coroHandleValid(handle) == 0) { coroUnlock(); return; }
    int idx = coroSlotOf(handle);
    if (CoroT.stack[idx] == 0) {
        // 已完成（栈已退役）：丢弃结果，槽可复用
        coroReleaseFrame(idx);
        CoroT.resultPending[idx] = 0;
        coroTryRecycle(idx);
        coroUnlock();
        return;
    }
    if (idx == CoroT.current) {
        // 不能释放当前运行协程的栈：标记 discard，trampoline 收尾时处理（先释放
        // 帧 ARC，body 返回后 trampoline 也释放——置空表防双重释放）
        coroReleaseFrame(idx);
        CoroT.active[idx] = 0;
        CoroT.ready[idx] = 0;
        CoroT.discardResult[idx] = 1;
        coroUnlock();
        return;
    }
    // 强制销毁挂起/活跃协程：释放帧 ARC（堆指针，栈未展开也安全）+ 清等待记录 +
    // 释放栈（退役列表，延迟 munmap）
    coroReleaseFrame(idx);
    coroWaitClearFor(idx);
    CoroT.active[idx] = 0;
    CoroT.ready[idx] = 0;
    coroRetiredAdd(CoroT.stack[idx], CoroT.stackSize[idx]);
    CoroT.stack[idx] = 0;
    CoroT.stackSize[idx] = 0;
    CoroT.resultPending[idx] = 0;
    coroTryRecycle(idx);
    coroUnlock();
}

// ---- Phase B：帧表（ARC 镜像，同 C §五-1 收尾）----
// @coro 体内每个存活 ARC 槽（局部类/接口/闭包）在 store 时把 {slot_id(alloca 地址,
// 仅作键), obj(堆对象指针)} 镜像进帧表；正常 release 时 frame_clear 移除。destroy/
// 未捕获异常路径（跳过了 epilogue 的释放）→ release 仍在表的 obj（堆指针，栈已
// 展开也安全）。每协程 ≤32 槽（满则放弃跟踪——同 C OOM 语义，防泄漏不防 UAF）。
void __myp_coro_frame_set(long slot_id, long obj) {
    coroEnsureInit();
    int cur = CoroT.current;
    if (cur < 0 || cur >= CoroT.count) return;
    if (slot_id == 0) return;
    int base = cur * 32;
    for (int i = 0; i < CoroF.count[cur]; i = i + 1) {
        if (CoroF.slotId[base + i] == slot_id) {
            CoroF.obj[base + i] = obj;   // 原地更新（无重复）
            return;
        }
    }
    if (CoroF.count[cur] >= 32) return;
    CoroF.slotId[base + CoroF.count[cur]] = slot_id;
    CoroF.obj[base + CoroF.count[cur]] = obj;
    CoroF.count[cur] = CoroF.count[cur] + 1;
}
void __myp_coro_frame_clear(long slot_id) {
    coroEnsureInit();
    int cur = CoroT.current;
    if (cur < 0 || cur >= CoroT.count) return;
    if (slot_id == 0) return;
    int base = cur * 32;
    for (int i = 0; i < CoroF.count[cur]; i = i + 1) {
        if (CoroF.slotId[base + i] == slot_id) {
            CoroF.slotId[base + i] = CoroF.slotId[base + CoroF.count[cur] - 1];
            CoroF.obj[base + i] = CoroF.obj[base + CoroF.count[cur] - 1];
            CoroF.count[cur] = CoroF.count[cur] - 1;
            return;
        }
    }
}
// release 帧表仍在表的 obj（destroy/异常收尾）
void coroReleaseFrame(int cur) {
    if (cur < 0 || cur >= CoroT.count) return;
    int base = cur * 32;
    for (int i = 0; i < CoroF.count[cur]; i = i + 1) {
        long o = CoroF.obj[base + i];
        if (o != 0) myp_release(__myp_addr_to_str(o));
    }
    CoroF.count[cur] = 0;
}

// ---- Phase B：等待表辅助 ----
// 动态扩容（CoroW 独立 cap，解除 1024 上限）；永不因满失败。
int coroWaitReserve() {
    return 0;
}
int coroWaitAdd(int kind, int eventId, int fd, int fdEvents, long handle,
                long deadline, int waitIndex) {
    coroWEnsure(CoroW.count + 1);
    int i = CoroW.count;
    CoroW.kind[i] = kind;
    CoroW.eventId[i] = eventId;
    CoroW.fd[i] = fd;
    CoroW.fdEvents[i] = fdEvents;
    CoroW.handle[i] = handle;
    CoroW.active[i] = 1;
    CoroW.deadline[i] = deadline;
    CoroW.expired[i] = 0;
    CoroW.execResult[i] = 0;
    CoroW.waitIndex[i] = waitIndex;
    CoroW.count = CoroW.count + 1;
    if (kind == 0) coroEvWaitAdd(eventId, pthread_self(), int(handle));
    return 0;
}
// 唤醒后清除某协程的其余等待记录（wait_any/any_of 只许一个 spec 唤醒）；
// 同时清全局事件等待者注册表（本线程 owner，防误清其它线程同号槽）。
void coroWaitClearFor(int cur) {
    for (int i = 0; i < CoroW.count; i = i + 1) {
        if (CoroW.active[i] != 0 && CoroW.handle[i] == long(cur))
            CoroW.active[i] = 0;
    }
    coroEvWaitClearFor(pthread_self(), cur);
}

// ---- 全局事件等待者注册表（跨线程 notify：需看到其它线程的 CoroW 事件等待者）----
// 动态扩容（同 CoroT/CoroW：不再写死 1024/64 上限；静默丢弃 → 丢失唤醒）。
@static class CoroEvW {
    property:
        int[] eid;       // event_id（扩容见 coroEvWEnsure）
        long[] owner;    // owner pthread_self()
        int[] slot;      // 协程槽（owner 表内）
        int[] active;
        int count = 0;
        int cap = 0;
        // 跨线程唤醒 mailbox（同 chanWake 模式；扩容见 coroEvWCwEnsure）
        long cwLock = 0;     // 自旋锁字地址（arena）
        long[] cwOwner;
        int[] cwSlot;
        int[] cwActive;
        int cwCount = 0;
        int cwCap = 0;
}
// 注册表扩容（初始 64，翻倍；只增不减）
void coroEvWEnsure(int n) {
    if (CoroEvW.cap >= n) return;
    int nc = CoroEvW.cap == 0 ? 64 : CoroEvW.cap * 2;
    while (nc < n) nc = nc * 2;
    int old = CoroEvW.cap;
    CoroEvW.eid = coroGrowInt(CoroEvW.eid, old, nc);
    CoroEvW.owner = coroGrowLong(CoroEvW.owner, old, nc);
    CoroEvW.slot = coroGrowInt(CoroEvW.slot, old, nc);
    CoroEvW.active = coroGrowInt(CoroEvW.active, old, nc);
    CoroEvW.cap = nc;
}
// 唤醒 mailbox 扩容（初始 64，翻倍；须在 cwLock 内调用——pump 并发读旧数组）
void coroEvWCwEnsure(int n) {
    if (CoroEvW.cwCap >= n) return;
    int nc = CoroEvW.cwCap == 0 ? 64 : CoroEvW.cwCap * 2;
    while (nc < n) nc = nc * 2;
    int old = CoroEvW.cwCap;
    CoroEvW.cwOwner = coroGrowLong(CoroEvW.cwOwner, old, nc);
    CoroEvW.cwSlot = coroGrowInt(CoroEvW.cwSlot, old, nc);
    CoroEvW.cwActive = coroGrowInt(CoroEvW.cwActive, old, nc);
    CoroEvW.cwCap = nc;
}
// 压缩注册表：drop inactive（唤醒/清除/超时过的记录）——防 count 无限增长
void coroEvWCompact() {
    if (CoroEvW.count == 0) return;
    int w = 0;
    for (int i = 0; i < CoroEvW.count; i = i + 1) {
        if (CoroEvW.active[i] != 0) {
            if (w != i) {
                CoroEvW.eid[w] = CoroEvW.eid[i];
                CoroEvW.owner[w] = CoroEvW.owner[i];
                CoroEvW.slot[w] = CoroEvW.slot[i];
                CoroEvW.active[w] = 1;
            }
            w = w + 1;
        }
    }
    CoroEvW.count = w;
}
void coroEvWaitAdd(int eid, long owner, int slot) {
    coroEvWCompact();                 // 先丢 inactive，再登记（count 有界）
    coroEvWEnsure(CoroEvW.count + 1); // 永不因满失败
    CoroEvW.eid[CoroEvW.count] = eid;
    CoroEvW.owner[CoroEvW.count] = owner;
    CoroEvW.slot[CoroEvW.count] = slot;
    CoroEvW.active[CoroEvW.count] = 1;
    CoroEvW.count = CoroEvW.count + 1;
}
void coroEvWaitClearFor(long owner, int slot) {
    for (int i = 0; i < CoroEvW.count; i = i + 1) {
        if (CoroEvW.active[i] != 0 && CoroEvW.owner[i] == owner && CoroEvW.slot[i] == slot)
            CoroEvW.active[i] = 0;
    }
}
void coroEvWakePush(long owner, int slot) {
    if (CoroEvW.cwLock == 0) {
        long p = myp_arena_alloc(8);
        if (p != 0) { __myp_mem_store_i32(p, 0); CoroEvW.cwLock = p; }
    }
    if (CoroEvW.cwLock != 0) {
        while (__myp_atomic_add_i32_addr(CoroEvW.cwLock, 1) != 0) { }
        coroEvWCwEnsure(CoroEvW.cwCount + 1);   // 锁内扩容（防 pump 并发迭代旧数组）
        CoroEvW.cwOwner[CoroEvW.cwCount] = owner;
        CoroEvW.cwSlot[CoroEvW.cwCount] = slot;
        CoroEvW.cwActive[CoroEvW.cwCount] = 1;
        CoroEvW.cwCount = CoroEvW.cwCount + 1;
        __myp_atomic_store_i32_addr(CoroEvW.cwLock, 0);
    }
}
// owner 调度器 pump：属于本线程的唤醒 → 本线程 CoroT.ready，压缩表
void coroEvWakePump() {
    if (CoroEvW.cwCount == 0 || CoroEvW.cwLock == 0) return;
    long me = pthread_self();
    while (__myp_atomic_add_i32_addr(CoroEvW.cwLock, 1) != 0) { }
    for (int i = 0; i < CoroEvW.cwCount; i = i + 1) {
        if (CoroEvW.cwActive[i] != 0 && CoroEvW.cwOwner[i] == me) {
            CoroEvW.cwActive[i] = 0;
            int hs = CoroEvW.cwSlot[i];
            if (hs >= 0 && hs < CoroT.count && CoroT.active[hs] != 0)
                CoroT.ready[hs] = 1;
        }
    }
    int w = 0;
    for (int i = 0; i < CoroEvW.cwCount; i = i + 1) {
        if (CoroEvW.cwActive[i] != 0) {
            if (w != i) {
                CoroEvW.cwOwner[w] = CoroEvW.cwOwner[i];
                CoroEvW.cwSlot[w] = CoroEvW.cwSlot[i];
                CoroEvW.cwActive[w] = 1;
            }
            w = w + 1;
        }
    }
    CoroEvW.cwCount = w;
    __myp_atomic_store_i32_addr(CoroEvW.cwLock, 0);
}
// ---- Phase B：fd poll（syscall 7；pollfd 8B = {fd i32@0, events i32@4}，revents
// 读回 +4 高 16 位）----
void coroPollFds() {
    int nfd = 0;
    for (int i = 0; i < CoroW.count; i = i + 1) {
        if (CoroW.active[i] != 0 && CoroW.kind[i] == 2) nfd = nfd + 1;
    }
    if (nfd == 0) return;
    // poll 缓冲随等待表扩容（≥1024；等待表已解除上限）
    if (CoroPoll.inited == 0 || CoroPoll.buf == 0) {
        CoroPoll.buf = myp_arena_alloc(1024 * 8);
        CoroPoll.inited = 1;
    }
    long base = CoroPoll.buf;
    int k = 0;
    for (int i = 0; i < CoroW.count; i = i + 1) {
        if (CoroW.active[i] != 0 && CoroW.kind[i] == 2) {
            // pollfd 8B：fd@0(i32) + events@4(i32，低 16 位，高 16 位=revents 先清 0)
            __myp_mem_store_i32(base + long(k) * 8, CoroW.fd[i]);
            __myp_mem_store_i32(base + long(k) * 8 + 4, CoroW.fdEvents[i]);
            k = k + 1;
        }
    }
    long r = __myp_syscall(7, base, long(nfd), 0, 0, 0, 0);
    if (r > 0) {
        for (int j = 0; j < nfd; j = j + 1) {
            long rev = __myp_mem_load_i32(base + long(j) * 8 + 4);
            rev = (rev >> 16) & 0xFFFF;   // revents
            if ((rev & (1 | 4 | 8 | 16)) != 0) {   // POLLIN|POLLOUT|POLLERR|POLLHUP
                // 找到对应的等待表记录（j 是 fd 等待的序号；线性反查）
                int wj = 0;
                int found = -1;
                for (int i = 0; i < CoroW.count && found < 0; i = i + 1) {
                    if (CoroW.active[i] != 0 && CoroW.kind[i] == 2) {
                        if (wj == j) found = i;
                        wj = wj + 1;
                    }
                }
                if (found >= 0) {
                    int hs = int(CoroW.handle[found]);
                    CoroW.active[found] = 0;
                    if (hs >= 0 && hs < CoroT.count && CoroT.active[hs] != 0) {
                        if (CoroW.waitIndex[found] >= 0)   // waitAnyOf
                            CoroT.lastWaitIndex[hs] = CoroW.waitIndex[found];
                        CoroT.ready[hs] = 1;
                    }
                }
            }
        }
    }
}

// ---- §五-5 P3 异步文件读 exec worker（MYP 版；shadow C myp_coro_file_read_*）----
// C 版用 pthread exec worker 池（读 C FILE*）；MYP io 层全接管 fd 表，C worker 的
// FILE* 恒空 → 本模块用 clone worker（thread.myp myp_thread_spawn）逐次执行阻塞读。
// 流程：协程内 await → park（ready=0，EXEC wait）→ 投递共享任务槽 + spawn worker
// （capture 握手）→ yield → worker 在独立线程阻塞读（io.myp execIoRead*Raw，返回
// raw addr，无 string 局部 → 无 ARC release）→ coroLock 内写 execResult + ready=1 →
// 调度器 resume 协程 → __myp_addr_to_str(retain +1 → rc=1) 返回。非协程同步回退。
// 跨线程 exec 投递 mailbox（进程级 @static；worker 写、owner 调度器 pump）。
// C runtime 同款模式：worker 只往 mailbox 写（带 owner 线程标记 + 自旋锁），
// 绝不碰 owner 的 per-thread 协程表；owner 调度器每轮 pump 属于本线程的结果
// 进自己的 CoroT.execResult + ready。
@static class CoroExec {
    property:
        long handle = 0;   // io_handle（任务槽）
        long op = 0;       // 0=readLine 1=readAll
        long coro = 0;     // 目标协程槽
        long captured = 0; // 握手：worker 已读任务槽（父才可覆盖/续跑）
        long ownerTid = 0; // owner 线程 pthread_self()（pump 匹配）
        // ---- mailbox（定容 16；exec 逐次投递，一次至多一个在途）----
        long mbLock = 0;   // 自旋锁字地址（arena）
        long[] mbOwner;    // 目标线程 pthread_self()
        long[] mbSlot;     // 目标协程槽
        long[] mbResult;   // raw result addr
        int[] mbActive;
        int mbCount = 0;
        int mbCap = 0;
}
void coroExecMailInit() {
    if (CoroExec.mbCap == 0) {
        CoroExec.mbCap = 16;
        CoroExec.mbOwner = new long[16];
        CoroExec.mbSlot = new long[16];
        CoroExec.mbResult = new long[16];
        CoroExec.mbActive = new int[16];
        CoroExec.mbCount = 0;
        long p = myp_arena_alloc(8);
        if (p != 0) { __myp_mem_store_i32(p, 0); CoroExec.mbLock = p; }
    }
}
void coroExecMailPush(long owner, long slot, long result) {
    coroExecMailInit();
    if (CoroExec.mbLock != 0) {
        while (__myp_atomic_add_i32_addr(CoroExec.mbLock, 1) != 0) { }
    }
    if (CoroExec.mbCount < CoroExec.mbCap) {
        CoroExec.mbOwner[CoroExec.mbCount] = owner;
        CoroExec.mbSlot[CoroExec.mbCount] = slot;
        CoroExec.mbResult[CoroExec.mbCount] = result;
        CoroExec.mbActive[CoroExec.mbCount] = 1;
        CoroExec.mbCount = CoroExec.mbCount + 1;
    }
    if (CoroExec.mbLock != 0) __myp_atomic_store_i32_addr(CoroExec.mbLock, 0);
}
// owner 调度器 pump：把属于本线程的结果写进本线程 CoroT.execResult + ready，压缩表。
void coroExecPump() {
    if (CoroExec.mbCap == 0) return;
    long me = pthread_self();
    if (CoroExec.mbLock != 0) {
        while (__myp_atomic_add_i32_addr(CoroExec.mbLock, 1) != 0) { }
    }
    for (int i = 0; i < CoroExec.mbCount; i = i + 1) {
        if (CoroExec.mbActive[i] != 0 && CoroExec.mbOwner[i] == me) {
            long slot = CoroExec.mbSlot[i];
            long res = CoroExec.mbResult[i];
            CoroExec.mbActive[i] = 0;
            int si = int(slot);
            if (si >= 0 && si < CoroT.count && CoroT.active[si] != 0) {
                CoroT.execResult[si] = res;
                CoroT.ready[si] = 1;
            }
        }
    }
    int w = 0;
    for (int i = 0; i < CoroExec.mbCount; i = i + 1) {
        if (CoroExec.mbActive[i] != 0) {
            if (w != i) {
                CoroExec.mbOwner[w] = CoroExec.mbOwner[i];
                CoroExec.mbSlot[w] = CoroExec.mbSlot[i];
                CoroExec.mbResult[w] = CoroExec.mbResult[i];
                CoroExec.mbActive[w] = 1;
            }
            w = w + 1;
        }
    }
    CoroExec.mbCount = w;
    if (CoroExec.mbLock != 0) __myp_atomic_store_i32_addr(CoroExec.mbLock, 0);
}
// worker 入口（pthread 子线程；先 capture 任务到局部 → captured=1 → 阻塞读 → 写 mailbox）
void coroExecWorker() {
    long h = CoroExec.handle;
    long op = CoroExec.op;
    long c = CoroExec.coro;
    long owner = CoroExec.ownerTid;
    CoroExec.captured = 1;
    long s = 0;
    if (op == 0) s = execIoReadLineRaw(int(h));
    else s = execIoReadAllRaw(int(h));
    coroExecMailPush(owner, c, s);   // 写 mailbox（不碰 owner 的 per-thread 表）
    // 无 string 局部 → 函数返回不释放任何串（s 是 long）
}
// 协程内异步文件读：park + worker 读 + resume；非协程同步回退。
string coroFileReadAsync(int io_handle, int op) {
    coroLock();
    coroEnsureInit();
    int cur = CoroT.current;
    if (cur < 0 || cur >= CoroT.count) {
        // 非协程：同步读（raw addr → 本函数 return retain(+1) → rc=1）
        coroUnlock();
        long s = 0;
        if (op == 0) s = execIoReadLineRaw(io_handle);
        else s = execIoReadAllRaw(io_handle);
        if (s == 0) return "";
        return __myp_addr_to_str(s);
    }
    // 注册 EXEC 等待（kind=3，无截止期）+ park
    coroWaitAdd(3, -1, -1, 0, long(cur), 0, -1);
    CoroT.ready[cur] = 0;
    CoroT.execResult[cur] = 0;
    // 投递 worker：共享任务槽（先置 captured=0）→ spawn → 等 capture 握手
    // （防本协程 yield 后另一协程覆盖槽而 worker 尚未读取）。
    CoroExec.handle = io_handle;
    CoroExec.op = op;
    CoroExec.coro = cur;
    CoroExec.ownerTid = pthread_self();   // owner 线程（pump 匹配）
    CoroExec.captured = 0;
    myp_thread_spawn(__myp_fn_addr("coroExecWorker"));
    coroUnlock();
    // 等 worker capture 任务（微秒级；worker 在独立线程启动）
    long guard = 0;
    while (CoroExec.captured == 0) {
        guard = guard + 1;
        if (guard > 100000000) break;
        myp_pause();
    }
    __myp_coro_yield(0);
    long r = CoroT.execResult[cur];
    if (r == 0) return "";   // worker 失败/EOF（raw 0）
    return __myp_addr_to_str(r);
}
// C: char* myp_coro_file_read_line(int io_handle) / myp_coro_file_read_all(int)
string myp_coro_file_read_line(int io_handle) {
    return coroFileReadAsync(io_handle, 0);
}
string myp_coro_file_read_all(int io_handle) {
    return coroFileReadAsync(io_handle, 1);
}

// C: void __myp_coro_scheduler(void) —— 合作式调度（Phase B：事件/截止期/fd 就绪
// 推进 + ready 快照 resume 一步）。
// 锁：表操作分段持锁；myp_event_process_all 在锁外调用（事件回调会走 coro API，
// 持 coroLock 时回调→递归可，但若另一线程持 evLock 等 coroLock 则反转死锁——
// 故事件处理绝不持 coroLock）。
void __myp_coro_scheduler() {
    coroEnsureInit();
    coroLock();
    coroRetiredDrain();
    // 压缩等待表：drop inactive（fd-poll/截止期/事件唤醒过的记录不再累积）
    if (CoroW.count > 0) {
        int w = 0;
        for (int i = 0; i < CoroW.count; i = i + 1) {
            if (CoroW.active[i] != 0) {
                if (w != i) {
                    CoroW.kind[w] = CoroW.kind[i];
                    CoroW.eventId[w] = CoroW.eventId[i];
                    CoroW.fd[w] = CoroW.fd[i];
                    CoroW.fdEvents[w] = CoroW.fdEvents[i];
                    CoroW.handle[w] = CoroW.handle[i];
                    CoroW.active[w] = CoroW.active[i];
                    CoroW.deadline[w] = CoroW.deadline[i];
                    CoroW.expired[w] = CoroW.expired[i];
                    CoroW.execResult[w] = CoroW.execResult[i];
                    CoroW.waitIndex[w] = CoroW.waitIndex[i];
                }
                w = w + 1;
            }
        }
        CoroW.count = w;
    }
    coroUnlock();
    // 处理事件队列（C myp_event_process_all → dispatch → MYP __myp_coro_event_notify
    // 重新 ready 事件等待者，本趟即可运行）。锁外：事件回调可能走 coro API。
    myp_event_process_all();
    coroLock();
    // 截止期过期：重新 ready + waitTimeout 标记（wait_event_timeout 区分超时 vs 到达）
    long now = myp_now_ms();
    for (int i = 0; i < CoroW.count; i = i + 1) {
        if (CoroW.active[i] != 0 && CoroW.deadline[i] > 0 && now >= CoroW.deadline[i]) {
            CoroW.active[i] = 0;
            int hs = int(CoroW.handle[i]);
            if (hs >= 0 && hs < CoroT.count && CoroT.active[hs] != 0) {
                if (CoroW.waitIndex[i] >= 0 && CoroW.kind[i] == 1) {
                    // waitAnyOf TIMER spec：它自己的截止期 → 报 spec 下标
                    CoroT.lastWaitIndex[hs] = CoroW.waitIndex[i];
                    CoroT.ready[hs] = 1;
                } else {
                    CoroT.waitTimeout[hs] = 1;   // 总体超时/普通等待
                    CoroT.ready[hs] = 1;
                }
            }
            if (CoroW.kind[i] == 0) coroEvWaitClearFor(pthread_self(), hs);   // 事件等待超时 → 清注册表
        }
    }
    // fd 就绪轮询（批量 poll 一次）
    coroPollFds();
    // 跨线程 exec 结果 pump：属于本线程的结果 → 本线程 CoroT.execResult + ready
    coroExecPump();
    // 跨线程 channel 唤醒 pump：属于本线程的唤醒 → 本线程 CoroT.ready
    chanWakePump();
    // 跨线程 event 唤醒 pump：属于本线程的唤醒 → 本线程 CoroT.ready
    coroEvWakePump();
    // 快照语义：遍历槽位，对 active && ready 的 resume 一步（本趟新增的 ready 协程
    // 高槽位不访问——与 C 快照近似；yield 保持 ready 的协程本趟不重入）。
    for (int i = 0; i < CoroT.count; i = i + 1) {
        if (CoroT.active[i] != 0 && CoroT.ready[i] != 0) {
            long h = coroMakeHandle(i);
            __myp_coro_resume(h, 0L);
        }
    }
    coroUnlock();
}

// ---- trampoline：协程栈首次进入的入口 ----
void __myp_coro_trampoline() {
    int id = CoroT.current;
    // 异常边界：MYP try/catch（编译器发射 setjmp + myp_exception_push/pop）。
    // 每协程进入时 push 自己的 jb → 单线程同时只跑一个协程 → LIFO 栈顶恒为
    // 当前协程边界（同 C trampoline 语义）。
    try {
        if (id >= 0 && id < CoroT.count && CoroT.fn[id] != 0) {
            __myp_indirect_void(CoroT.fn[id]);
        }
    } catch (string e) {
        // 未捕获异常：报告后正常收尾（不 abort 进程，同 C）
        string m = "uncaught exception in coroutine: " + e + "\n";
        __myp_syscall(1, 2, __myp_str_ptr(m), myp_strlen(m), 0, 0, 0);
    }
    // 收尾：释放帧 ARC（未捕获异常跳过了 epilogue 的释放）→ 退役栈（不能就地
    // munmap，正运行其上）→ 标记完成 → 切回调用者
    if (id >= 0 && id < CoroT.count) {
        coroReleaseFrame(id);
        coroRetiredAdd(CoroT.stack[id], CoroT.stackSize[id]);
        CoroT.stack[id] = 0;
        CoroT.active[id] = 0;
        CoroT.ready[id] = 0;
        if (CoroT.discardResult[id] != 0) {
            CoroT.discardResult[id] = 0;
            CoroT.resultPending[id] = 0;
        } else {
            CoroT.resultPending[id] = 1;
        }
        coroTryRecycle(id);
        CoroT.current = -1;
        myp_ctx_switch(coroCtxBase() + long(id) * 8,
                       coroRetCtxBase() + long(id) * 8);
    }
}

// ---- Phase B：事件/等待层（C4 + §五-5 P1/P2/P4）----
// 等待 = 注册等待表记录 + ready=0（park）+ __myp_coro_yield；唤醒由调度器驱动
// （事件 notify / 截止期过期 / fd poll 重新 ready）。park 后 resume 返回时必须
// 用 waitTimeout/lastWait* 区分「事件到达 vs 超时」。

// C: int64_t __myp_coro_wait_event_timeout(int64_t event_id, int64_t timeout_ms,
//                                         int64_t val)
// 阻塞至 event_id 触发（返回 resume 传入值）或 timeout_ms 超时（返回 -1）。
// 调度器驱动截止期；不调 scheduler 则定时等待表现为无限等待（同 C）。
// 锁：表操作持锁、yield 前释放（yield 自身递归锁由 resume 统一释放——协程在
// resume 锁下运行期间取锁必须在 yield 前配平，否则每轮泄漏一层深度）。
long __myp_coro_wait_event_timeout(long event_id, long timeout_ms, long val) {
    coroLock();
    coroEnsureInit();
    long deadline = 0;
    if (timeout_ms > 0) deadline = myp_now_ms() + timeout_ms;
    int cur = CoroT.current;
    if (cur >= 0 && cur < CoroT.count) {
        if (coroWaitAdd(0, int(event_id), -1, 0, long(cur), deadline, -1) == 0) {
            CoroT.ready[cur] = 0;   // park
        }
        CoroT.waitTimeout[cur] = 0;
        coroUnlock();
        long r = __myp_coro_yield(val);
        if (CoroT.waitTimeout[cur] != 0) {
            CoroT.waitTimeout[cur] = 0;
            return -1;
        }
        return r;
    }
    coroUnlock();
    return val;   // 非协程：不挂起，直接返回
}

// C: int64_t __myp_coro_wait_event(int64_t event_id, int64_t val)
long __myp_coro_wait_event(long event_id, long val) {
    return __myp_coro_wait_event_timeout(event_id, 0, val);
}

// C: int64_t __myp_coro_wait_any(const int64_t* ids, int64_t count, int64_t
//                                timeout_ms, int64_t val)
// 等任一事件触发：返回唤醒的事件 id，超时 -1。ids = 数组 data 指针（long）。
long __myp_coro_wait_any(long ids, long count, long timeout_ms, long val) {
    coroLock();
    coroEnsureInit();
    long deadline = 0;
    if (timeout_ms > 0) deadline = myp_now_ms() + timeout_ms;
    int cur = CoroT.current;
    if (cur >= 0 && cur < CoroT.count && ids != 0 && count > 0) {
        for (long i = 0; i < count; i = i + 1) {
            long ev = __myp_mem_load_i64(ids + i * 8);
            if (coroWaitAdd(0, int(ev), -1, 0, long(cur), deadline, -1) != 0) break;
        }
        CoroT.ready[cur] = 0;
        CoroT.lastWaitEventId[cur] = -1;
    }
    if (cur >= 0 && cur < CoroT.count) CoroT.waitTimeout[cur] = 0;
    coroUnlock();
    long r = __myp_coro_yield(val);
    if (cur >= 0 && cur < CoroT.count) {
        // 只许一个事件唤醒 waitAny——清除本协程其余等待记录（后续 fire 不再重 ready）
        coroWaitClearFor(cur);
        if (CoroT.waitTimeout[cur] != 0) {
            CoroT.waitTimeout[cur] = 0;
            return -1;
        }
        if (CoroT.lastWaitEventId[cur] >= 0) return long(CoroT.lastWaitEventId[cur]);
        return r;
    }
    return r;
}

// C: int64_t __myp_coro_wait_any_of(const int64_t* spec, int64_t count,
//                                   int64_t timeout_ms, int64_t val)
// 统一 waitAny：spec = 扁平 long[]（count*3 项）[kind,id,flag]；返回触发的 spec
// 下标（0 起），总体超时 -1，非协程 -2。
long __myp_coro_wait_any_of(long spec, long count, long timeout_ms, long val) {
    coroLock();
    coroEnsureInit();
    if (spec == 0 || count <= 0) { coroUnlock(); return -2; }
    int cur = CoroT.current;
    if (cur < 0 || cur >= CoroT.count) { coroUnlock(); return -2; }   // 非协程
    long now0 = myp_now_ms();
    long deadline = (timeout_ms > 0) ? now0 + timeout_ms : 0;
    for (long i = 0; i < count; i = i + 1) {
        long kind = __myp_mem_load_i64(spec + i * 24);
        long id = __myp_mem_load_i64(spec + i * 24 + 8);
        long flag = __myp_mem_load_i64(spec + i * 24 + 16);
        int wkind = int(kind);
        int wfdEvents = 0;
        if (wkind == 2) {
            if ((flag & 1) != 0) wfdEvents = wfdEvents | 1;   // POLLIN
            if ((flag & 2) != 0) wfdEvents = wfdEvents | 4;   // POLLOUT
        }
        long wdeadline = (wkind == 1) ? ((flag > 0) ? now0 + flag : 0) : deadline;
        int wev = (wkind == 0) ? int(id) : -1;
        int wfd = (wkind == 2) ? int(id) : -1;
        if (coroWaitAdd(wkind, wev, wfd, wfdEvents, long(cur), wdeadline, int(i)) != 0) break;
    }
    // 总体超时标记（kind=TIMER, waitIndex=-2）注册最后——平局时总体超时在后才输
    if (deadline > 0) coroWaitAdd(1, -1, -1, 0, long(cur), deadline, -2);
    CoroT.ready[cur] = 0;
    CoroT.lastWaitIndex[cur] = -1;
    CoroT.waitTimeout[cur] = 0;
    coroUnlock();
    long r = __myp_coro_yield(val);
    coroWaitClearFor(cur);
    if (CoroT.lastWaitIndex[cur] >= 0) return long(CoroT.lastWaitIndex[cur]);
    if (CoroT.waitTimeout[cur] != 0) {
        CoroT.waitTimeout[cur] = 0;
        return -1;
    }
    return r;
}

// C: int64_t __myp_coro_sleep(int64_t ms) —— 协程内定时挂起（不阻塞线程）；非协程
// 回退阻塞 myp_sleep_ms。
long __myp_coro_sleep(long ms) {
    coroLock();
    coroEnsureInit();
    if (ms <= 0) { coroUnlock(); return 0; }
    int cur = CoroT.current;
    if (cur < 0 || cur >= CoroT.count) {
        coroUnlock();
        myp_sleep_ms(ms);   // 非协程：阻塞回退
        return 0;
    }
    long deadline = myp_now_ms() + ms;
    if (coroWaitAdd(1, -1, -1, 0, long(cur), deadline, -1) == 0) {
        CoroT.ready[cur] = 0;   // park
        CoroT.waitTimeout[cur] = 0;
    }
    coroUnlock();
    __myp_coro_yield(0);
    return 0;
}

// C: int64_t __myp_coro_wait_fd(int64_t fd, int64_t want_read, int64_t want_write,
//                               int64_t timeout_ms) —— 就绪返回 1，超时 -1，非协程 0。
long __myp_coro_wait_fd(long fd, long want_read, long want_write, long timeout_ms) {
    coroLock();
    coroEnsureInit();
    int cur = CoroT.current;
    if (cur < 0 || cur >= CoroT.count) { coroUnlock(); return 0; }   // 非协程
    long deadline = 0;
    if (timeout_ms > 0) deadline = myp_now_ms() + timeout_ms;
    int events = 0;
    if (want_read != 0) events = events | 1;       // POLLIN
    if (want_write != 0) events = events | 4;      // POLLOUT
    if (coroWaitAdd(2, -1, int(fd), events, long(cur), deadline, -1) == 0) {
        CoroT.ready[cur] = 0;
        CoroT.waitTimeout[cur] = 0;
    }
    coroUnlock();
    __myp_coro_yield(0);
    if (CoroT.waitTimeout[cur] != 0) {
        CoroT.waitTimeout[cur] = 0;
        return -1;
    }
    return 1;   // fd 就绪（或手动 resume）
}

// ---- 事件唤醒（C myp_event_dispatch 调用；非 static 使 MYP 版可 shadow）----
// C: void __myp_coro_event_notify(int event_id) —— 重新 ready 等待该事件的协程。
// 本线程 CoroW 等待者直接 ready；全局注册表里的其它线程等待者 → 跨线程唤醒
// mailbox（owner 调度器 pump 后 resume）。
void __myp_coro_event_notify(long event_id) {
    for (int i = 0; i < CoroW.count; i = i + 1) {
        if (CoroW.active[i] != 0 && CoroW.eventId[i] == int(event_id)) {
            long h = CoroW.handle[i];
            CoroW.active[i] = 0;
            int hs = int(h);
            if (hs >= 0 && hs < CoroT.count && CoroT.active[hs] != 0) {
                CoroT.lastWaitEventId[hs] = int(event_id);   // wait_any
                if (CoroW.waitIndex[i] >= 0)                 // waitAnyOf
                    CoroT.lastWaitIndex[hs] = CoroW.waitIndex[i];
                CoroT.ready[hs] = 1;
            }
        }
    }
    // 全局注册表：同线程（防漏）直接 ready；跨线程 → mailbox
    long me = pthread_self();
    for (int i = 0; i < CoroEvW.count; i = i + 1) {
        if (CoroEvW.active[i] != 0 && CoroEvW.eid[i] == int(event_id)) {
            CoroEvW.active[i] = 0;
            if (CoroEvW.owner[i] == me) {
                int hs = CoroEvW.slot[i];
                if (hs >= 0 && hs < CoroT.count && CoroT.active[hs] != 0)
                    CoroT.ready[hs] = 1;
            } else {
                coroEvWakePush(CoroEvW.owner[i], CoroEvW.slot[i]);
            }
        }
    }
}

// ---- M9：协程资源诊断（包 B 依赖包 D 的部分）----
long myp_diag_coro_slots() { return CoroT.count; }
long myp_diag_coro_slot_capacity() { return CoroCap.coro; }
long myp_diag_coro_free_slots() { return CoroT.freeCount; }
// 栈池：真实统计（预留复用池；C 平价语义）
long myp_diag_stack_pool_count() { return CoroStackPool.count; }
long myp_diag_stack_pool_capacity() { return 64; }
long myp_diag_stack_pool_bytes() { return CoroStackPool.total; }
long myp_diag_stack_pool_max_bytes() { return 134217728; }
long myp_diag_retired_count() { return CoroRetired.count; }
long myp_diag_retired_bytes() {
    long s = 0;
    for (int i = 0; i < CoroRetired.count; i = i + 1) s = s + CoroRetired.sizes[i];
    return s;
}

// ============================================================
// Phase C：Channel（Go 风格有缓冲通道；C myp_channel_*，见 runtime.c §channel）
// 语义：协程内 send 缓冲满 → 挂起；recv 缓冲空 → 挂起；非协程满/空 → -1（不挂起）。
// 同步交接（rendezvous）：send/recv 完成后若调用方是协程 → 内联 resume 对端一步
// （省 scheduler 往返；深度守卫防递归失控）；否则只 ready=1 等下一轮调度。
// 表：@static 进程级（C 为 TLS——文档化限制，同协程表；多线程通道共享需自旋锁）。
// ============================================================
@static class Chan {
    property:
        long[256] buf;        // 环形缓冲基址（arena，capacity*8；0=未分配）
        int[256] capacity;
        int[256] head;
        int[256] count;
        int[256] closed;
        long[65536] recvW;    // 256 chan × 256 recv waiter（FIFO，扁平 [h*256+i]）
        long[65536] recvOwner; // 每 recv waiter 的 owner 线程 pthread_self()
        int[256] recvWc;
        long[65536] sendW;
        long[65536] sendOwner; // 每 send waiter 的 owner 线程 pthread_self()
        int[256] sendWc;
        long lastPopOwner = 0; // chanPop* 弹出的 waiter owner（chanWake* 读）
        int wakeDepth = 0;    // 同步交接递归深度守卫（同 C MYP_CHANNEL_WAKE_DEPTH_MAX=64）
        int used = 0;         // 已分配通道数
        // ---- 跨线程唤醒 mailbox（v3.15.79）：waiter owner ≠ 本线程 → 投递，owner
        //      调度器 pump 后在自己的 per-thread 表里 ready（不跨线程内联 resume）----
        long cwLock = 0;      // 自旋锁字地址（arena）
        long[64] cwOwner;     // 目标线程 pthread_self()
        long[64] cwSlot;      // 目标协程槽（owner 表内）
        int[64] cwActive;
        int cwCount = 0;
}

// pop first（FIFO）；同时记录弹出的 waiter owner（chanWake* 用它判断跨线程）
long chanPopRecv(int h) {
    if (Chan.recvWc[h] <= 0) return -1;
    long v = Chan.recvW[h * 256];
    Chan.lastPopOwner = Chan.recvOwner[h * 256];
    for (int i = 1; i < Chan.recvWc[h]; i = i + 1) {
        Chan.recvW[h * 256 + i - 1] = Chan.recvW[h * 256 + i];
        Chan.recvOwner[h * 256 + i - 1] = Chan.recvOwner[h * 256 + i];
    }
    Chan.recvWc[h] = Chan.recvWc[h] - 1;
    return v;
}
long chanPopSend(int h) {
    if (Chan.sendWc[h] <= 0) return -1;
    long v = Chan.sendW[h * 256];
    Chan.lastPopOwner = Chan.sendOwner[h * 256];
    for (int i = 1; i < Chan.sendWc[h]; i = i + 1) {
        Chan.sendW[h * 256 + i - 1] = Chan.sendW[h * 256 + i];
        Chan.sendOwner[h * 256 + i - 1] = Chan.sendOwner[h * 256 + i];
    }
    Chan.sendWc[h] = Chan.sendWc[h] - 1;
    return v;
}
// 跨线程唤醒 mailbox：chanWake* 发现 waiter owner ≠ 本线程 → 投递（owner 调度器 pump）
void chanWakePush(long owner, long slot) {
    if (Chan.cwLock == 0) {
        long p = myp_arena_alloc(8);
        if (p != 0) { __myp_mem_store_i32(p, 0); Chan.cwLock = p; }
    }
    if (Chan.cwLock != 0) {
        while (__myp_atomic_add_i32_addr(Chan.cwLock, 1) != 0) { }
    }
    if (Chan.cwCount < 64) {
        Chan.cwOwner[Chan.cwCount] = owner;
        Chan.cwSlot[Chan.cwCount] = slot;
        Chan.cwActive[Chan.cwCount] = 1;
        Chan.cwCount = Chan.cwCount + 1;
    }
    if (Chan.cwLock != 0) __myp_atomic_store_i32_addr(Chan.cwLock, 0);
}
// owner 调度器 pump：属于本线程的唤醒 → 本线程 CoroT.ready（本线程 resume），压缩表
void chanWakePump() {
    if (Chan.cwCount == 0) return;
    long me = pthread_self();
    if (Chan.cwLock == 0) return;
    while (__myp_atomic_add_i32_addr(Chan.cwLock, 1) != 0) { }
    for (int i = 0; i < Chan.cwCount; i = i + 1) {
        if (Chan.cwActive[i] != 0 && Chan.cwOwner[i] == me) {
            Chan.cwActive[i] = 0;
            int hs = int(Chan.cwSlot[i]);
            if (hs >= 0 && hs < CoroT.count && CoroT.active[hs] != 0)
                CoroT.ready[hs] = 1;
        }
    }
    int w = 0;
    for (int i = 0; i < Chan.cwCount; i = i + 1) {
        if (Chan.cwActive[i] != 0) {
            if (w != i) {
                Chan.cwOwner[w] = Chan.cwOwner[i];
                Chan.cwSlot[w] = Chan.cwSlot[i];
                Chan.cwActive[w] = 1;
            }
            w = w + 1;
        }
    }
    Chan.cwCount = w;
    __myp_atomic_store_i32_addr(Chan.cwLock, 0);
}
// 唤醒一个对端等待者；isRecv=1 唤醒 recv waiter（由 send 调），0 唤醒 send waiter。
// 同步交接：调用方是协程 → 内联 resume 对端一步；否则 ready=1 等 scheduler。
// 跨线程（waiter owner ≠ 本线程）→ 投递唤醒 mailbox，owner 调度器 pump 后 resume。
long chanWakeOne(int h, int isRecv) {
    long sl = isRecv != 0 ? chanPopRecv(h) : chanPopSend(h);
    if (sl < 0) return -1;
    long owner = Chan.lastPopOwner;
    int hs = int(sl);
    if (owner != pthread_self()) {
        chanWakePush(owner, sl);   // 跨线程：不能碰对方 per-thread 表 → mailbox
        return sl;
    }
    if (hs < 0 || hs >= CoroT.count || CoroT.active[hs] == 0) return sl;
    if (CoroT.current >= 0 && Chan.wakeDepth < 64) {
        Chan.wakeDepth = Chan.wakeDepth + 1;
        __myp_coro_resume(coroMakeHandle(hs), 0L);
        Chan.wakeDepth = Chan.wakeDepth - 1;
    } else {
        CoroT.ready[hs] = 1;
    }
    return sl;
}
// 只 ready（不内联 resume）——close/try 用：内联 resume 可能在关闭通道上跑无界
// 循环挂起调用者。跨线程同 mailbox。
long chanWakeReady(int h, int isRecv) {
    long sl = isRecv != 0 ? chanPopRecv(h) : chanPopSend(h);
    if (sl < 0) return sl;
    long owner = Chan.lastPopOwner;
    if (owner != pthread_self()) {
        chanWakePush(owner, sl);
        return sl;
    }
    if (int(sl) < CoroT.count && CoroT.active[int(sl)] != 0)
        CoroT.ready[int(sl)] = 1;
    return sl;
}

// C: int64_t myp_channel_create(int64_t capacity)
long myp_channel_create(int capacity) {
    int cap = capacity > 0 ? capacity : 1;
    for (int i = 0; i < 256; i = i + 1) {
        if (Chan.buf[i] == 0) {
            Chan.buf[i] = myp_arena_alloc(long(cap) * 8);
            if (Chan.buf[i] == 0) return -1;
            Chan.capacity[i] = cap;
            Chan.head[i] = 0;
            Chan.count[i] = 0;
            Chan.closed[i] = 0;
            Chan.recvWc[i] = 0;
            Chan.sendWc[i] = 0;
            if (i >= Chan.used) Chan.used = i + 1;
            return long(i);
        }
    }
    return -1;
}
// C: void myp_channel_destroy(int64_t handle)
void myp_channel_destroy(long handle) {
    int h = int(handle);
    if (h < 0 || h >= 256) return;
    if (Chan.buf[h] == 0) return;
    Chan.buf[h] = 0;          // arena 不真 free；标记槽可复用
    Chan.capacity[h] = 0;
    Chan.count[h] = 0;
    Chan.closed[h] = 1;
    Chan.recvWc[h] = 0;
    Chan.sendWc[h] = 0;
}
// C: int64_t myp_channel_send(int64_t handle, int64_t val) —— 0 成功；协程满挂起
int myp_channel_send(long handle, long val) {
    coroEnsureInit();
    int h = int(handle);
    if (h < 0 || h >= 256) return -1;
    if (Chan.buf[h] == 0 || Chan.closed[h] != 0) return -1;
    for (;;) {
        if (Chan.count[h] < Chan.capacity[h]) {
            int wpos = Chan.head[h] + Chan.count[h];
            if (wpos >= Chan.capacity[h]) wpos = wpos - Chan.capacity[h];
            __myp_mem_store_i64(Chan.buf[h] + long(wpos) * 8, val);
            Chan.count[h] = Chan.count[h] + 1;
            chanWakeOne(h, 1);   // 唤醒一个 recv waiter
            return 0;
        }
        int cur = CoroT.current;
        if (cur >= 0 && cur < CoroT.count && CoroT.active[cur] != 0) {
            if (Chan.sendWc[h] < 256) {
                Chan.sendW[h * 256 + Chan.sendWc[h]] = long(cur);
                Chan.sendOwner[h * 256 + Chan.sendWc[h]] = pthread_self();
                Chan.sendWc[h] = Chan.sendWc[h] + 1;
                CoroT.ready[cur] = 0;   // park
            }
            __myp_coro_yield(val);
            if (Chan.closed[h] != 0) return -1;
            // loop：重新校验（多生产者，空位可能被先 resume 者占用）
        } else {
            return -1;   // 非协程满缓冲
        }
    }
}
// C: int64_t myp_channel_recv(int64_t handle) —— 取出值；协程空挂起，非协程空 -1
long myp_channel_recv(long handle) {
    coroEnsureInit();
    int h = int(handle);
    if (h < 0 || h >= 256) return -1;
    if (Chan.buf[h] == 0) return -1;
    for (;;) {
        if (Chan.count[h] > 0) {
            long v = __myp_mem_load_i64(Chan.buf[h] + long(Chan.head[h]) * 8);
            int nh = Chan.head[h] + 1;
            if (nh >= Chan.capacity[h]) nh = 0;
            Chan.head[h] = nh;
            Chan.count[h] = Chan.count[h] - 1;
            chanWakeOne(h, 0);   // 唤醒一个 send waiter
            return v;
        }
        if (Chan.closed[h] != 0) return -1;
        int cur = CoroT.current;
        if (cur >= 0 && cur < CoroT.count && CoroT.active[cur] != 0) {
            if (Chan.recvWc[h] < 256) {
                Chan.recvW[h * 256 + Chan.recvWc[h]] = long(cur);
                Chan.recvOwner[h * 256 + Chan.recvWc[h]] = pthread_self();
                Chan.recvWc[h] = Chan.recvWc[h] + 1;
                CoroT.ready[cur] = 0;   // park
            }
            __myp_coro_yield(0);
            if (Chan.closed[h] != 0) return -1;
            // loop：重新校验（多消费者）
        } else {
            return -1;   // 非协程空缓冲
        }
    }
}
// C: int64_t myp_channel_try_send —— 非阻塞：0 成功，-1 满/关闭
int myp_channel_try_send(long handle, long val) {
    coroEnsureInit();
    int h = int(handle);
    if (h < 0 || h >= 256 || Chan.buf[h] == 0) return -1;
    if (Chan.closed[h] != 0 || Chan.count[h] >= Chan.capacity[h]) return -1;
    int wpos = Chan.head[h] + Chan.count[h];
    if (wpos >= Chan.capacity[h]) wpos = wpos - Chan.capacity[h];
    __myp_mem_store_i64(Chan.buf[h] + long(wpos) * 8, val);
    Chan.count[h] = Chan.count[h] + 1;
    chanWakeReady(h, 1);
    return 0;
}
// C: int64_t myp_channel_try_recv —— 非阻塞：取出值，-1 空/关闭
long myp_channel_try_recv(long handle) {
    coroEnsureInit();
    int h = int(handle);
    if (h < 0 || h >= 256 || Chan.buf[h] == 0) return -1;
    if (Chan.count[h] <= 0) return -1;
    long v = __myp_mem_load_i64(Chan.buf[h] + long(Chan.head[h]) * 8);
    int nh = Chan.head[h] + 1;
    if (nh >= Chan.capacity[h]) nh = 0;
    Chan.head[h] = nh;
    Chan.count[h] = Chan.count[h] - 1;
    chanWakeReady(h, 0);
    return v;
}
// C: int64_t myp_channel_size
int myp_channel_size(long handle) {
    coroEnsureInit();
    int h = int(handle);
    if (h < 0 || h >= 256 || Chan.buf[h] == 0) return -1;
    return Chan.count[h];
}
// C: void myp_channel_close —— 唤醒所有等待者（看到关闭状态）；只 ready 不内联
void myp_channel_close(long handle) {
    coroEnsureInit();
    int h = int(handle);
    if (h < 0 || h >= 256) return;
    if (Chan.buf[h] == 0) return;
    Chan.closed[h] = 1;
    while (Chan.sendWc[h] > 0) chanWakeReady(h, 0);
    while (Chan.recvWc[h] > 0) chanWakeReady(h, 1);
}

// ============================================================
// Phase C：Future/Promise（协程感知；C myp_future_* + myp_coro_{wait,wake}_future）
// 协程内 Future.get() 未 ready → park 协程（不阻塞线程）；同线程 set() 唤醒。
// 非协程未 ready → 自旋 + sleep 回退（MYP 无 pthread_cond；主用例 set 先于 get）。
// ============================================================
@static class Fut {
    property:
        int[64] used;
        int[64] ready;
        long[64] value;
        long[4096] coroW;    // 64 future × 64 coroutine waiter（扁平 [h*64+i]）
        int[64] coroWc;
}

// C: int myp_coro_am_i_coro(void)
int myp_coro_am_i_coro() {
    coroEnsureInit();
    return CoroT.current >= 0 ? 1 : 0;
}
// C: void myp_coro_wait_future(int32_t handle) —— park 当前协程直至 future ready
void myp_coro_wait_future(int handle) {
    coroEnsureInit();
    if (CoroT.current < 0) return;
    if (handle < 0 || handle >= 64 || Fut.used[handle] == 0) return;
    if (Fut.ready[handle] != 0) return;
    int cur = CoroT.current;
    if (Fut.coroWc[handle] < 64) {
        Fut.coroW[handle * 64 + Fut.coroWc[handle]] = long(cur);
        Fut.coroWc[handle] = Fut.coroWc[handle] + 1;
        CoroT.ready[cur] = 0;   // park
    }
    __myp_coro_yield(0);
}
// C: void myp_coro_wake_future(int32_t handle) —— re-ready 同线程等待者
void myp_coro_wake_future(int handle) {
    coroEnsureInit();
    if (handle < 0 || handle >= 64) return;
    for (int i = 0; i < Fut.coroWc[handle]; i = i + 1) {
        int hs = int(Fut.coroW[handle * 64 + i]);
        if (hs >= 0 && hs < CoroT.count && CoroT.active[hs] != 0)
            CoroT.ready[hs] = 1;
    }
    Fut.coroWc[handle] = 0;
}
// C: int32_t myp_future_create
int myp_future_create() {
    for (int i = 0; i < 64; i = i + 1) {
        if (Fut.used[i] == 0) {
            Fut.used[i] = 1;
            Fut.ready[i] = 0;
            Fut.value[i] = 0;
            Fut.coroWc[i] = 0;
            return i;
        }
    }
    return -1;
}
// C: void myp_future_set(int32_t handle, int32_t value)
void myp_future_set(int handle, int value) {
    if (handle < 0 || handle >= 64 || Fut.used[handle] == 0) return;
    Fut.value[handle] = long(value);
    Fut.ready[handle] = 1;
    myp_coro_wake_future(handle);   // 唤醒同线程协程等待者
}
// C: int32_t myp_future_get(int32_t handle)
int myp_future_get(int handle) {
    coroEnsureInit();
    if (handle < 0 || handle >= 64 || Fut.used[handle] == 0) return 0;
    if (Fut.ready[handle] != 0) return int(Fut.value[handle]);
    if (CoroT.current >= 0) {
        myp_coro_wait_future(handle);   // park；同线程 set 唤醒后 value 已就绪
        while (Fut.ready[handle] == 0) myp_sleep_ms(1);   // 防御
        return int(Fut.value[handle]);
    }
    // 非协程：自旋 + sleep 回退（MYP 无 pthread_cond）
    while (Fut.ready[handle] == 0) myp_sleep_ms(1);
    return int(Fut.value[handle]);
}
// C: void myp_future_destroy(int32_t handle)
void myp_future_destroy(int handle) {
    if (handle >= 0 && handle < 64 && Fut.used[handle] != 0) {
        Fut.used[handle] = 0;
    }
}
