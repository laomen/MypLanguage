// R3（roadmap §六 R3）：协程 spawn 时间 + 资源曲线。
// 批量 spawn 短协程（立即完成），测 N=1k/5k/10k/20k 时间曲线 + 协程槽容量 +
// 栈池字节（短协程栈归还栈池，槽复用 M1）。输出 "R3 <k> <v>"。
import env;
import memory;
import coro;

@coro(stack=16) long shortCoro(long tag) {
    // 无挂起：spawn 即运行到完成（测 spawn/回收开销，不含调度）
    return tag;
}

class Bench {
    action:
        @constructor Bench() {
            long[] ns = new long[4];
            ns[0] = 1000; ns[1] = 5000; ns[2] = 10000; ns[3] = 20000;
            for (int k = 0; k < 4; k = k + 1) {
                long n = ns[k];
                long t0 = __myp_now_ms();
                long acc = 0;
                for (long i = 0; i < n; i = i + 1) {
                    long h = shortCoro(i);
                    acc = acc + Coro.result(h);   // 读结果 → 槽回收（M1）
                }
                long t1 = __myp_now_ms();
                Console.writeString("R3 spawn_n=" + ("" + n) + " ms=" + ("" + (t1 - t0))
                    + " slots=" + ("" + Memory.coroSlotCount())
                    + " cap=" + ("" + Memory.coroSlotCapacity())
                    + " stackpool_bytes=" + ("" + Memory.stackPoolBytes())
                    + " acc=" + ("" + acc) + "\n");
            }
        }
}
int main() { Bench b = new Bench(); return 0; }
