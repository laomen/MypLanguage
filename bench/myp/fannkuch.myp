// bench/myp/fannkuch.myp — fannkuch-redux（Benchmarks Game 标准算法）
// N=12；verify = 最大翻转数（数学常数 3968050，与实现无关）。
// 测：排列 + 数组翻转 + 整型 ALU。
import env;
import time;

int fannkuch(int n) {
    int[] perm = new int[n];
    int[] perm1 = new int[n];
    int[] count = new int[n];
    int i = 0;
    while (i < n) { perm1[i] = i; i = i + 1; }
    int maxflips = 0;
    int r = n;
    while (true) {
        while (r != 1) { count[r - 1] = r; r = r - 1; }
        i = 0;
        while (i < n) { perm[i] = perm1[i]; i = i + 1; }
        int flips = 0;
        while (perm[0] != 0) {
            int k = perm[0];
            int a = 0;
            while (a <= k / 2) {
                int t = perm[a]; perm[a] = perm[k - a]; perm[k - a] = t;
                a = a + 1;
            }
            flips = flips + 1;
        }
        if (flips > maxflips) maxflips = flips;
        // 下一个排列（Johnson-Trotter 变体）
        while (true) {
            if (r == n) return maxflips;
            int perm0 = perm1[0];
            int i2 = 0;
            while (i2 < r) { perm1[i2] = perm1[i2 + 1]; i2 = i2 + 1; }
            perm1[r] = perm0;
            count[r] = count[r] - 1;
            if (count[r] > 0) break;
            r = r + 1;
        }
    }
}

class Bench {
    action:
        @constructor Bench() {
            int n = 11;
            long t0 = Time.nowMs();
            int v = fannkuch(n);
            long t1 = Time.nowMs();
            Console.writeString("verify ");
            Console.writeLong(v);
            Console.writeString("ms ");
            Console.writeLong(t1 - t0);
            Console.writeString("\n");
        }
}

int main() {
    Bench b = new Bench();
    return 0;
}
