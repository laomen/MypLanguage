// bench/myp/bst.myp — 二叉搜索树（数组节点 left/right/key，指针追逐）
// 262144 个随机键（LCG>>1, 0..2^30-1）插入 BST，中序遍历求和 + 有序性检查。
// verify = 键和 + 违序数×10^9（BST 正确时违序=0）。与 C++ 同算法同 LCG。
import env;
import time;

long bst(int n, int seed) {
    int[] key = new int[n];
    int[] left = new int[n];
    int[] right = new int[n];
    int[] stack = new int[n];
    long rng = seed;
    int root = -1;
    int i = 0;
    while (i < n) {
        rng = (rng * 1103515245L + 12345L) % 2147483648L;
        int k = rng >> 1;   // 0..2^30-1
        key[i] = k;
        left[i] = -1;
        right[i] = -1;
        if (root < 0) {
            root = i;
        } else {
            int cur = root;
            int done = 0;
            while (done == 0) {
                if (k <= key[cur]) {
                    if (left[cur] < 0) {
                        left[cur] = i;
                        done = 1;
                    } else {
                        cur = left[cur];
                    }
                } else {
                    if (right[cur] < 0) {
                        right[cur] = i;
                        done = 1;
                    } else {
                        cur = right[cur];
                    }
                }
            }
        }
        i = i + 1;
    }
    long sum = 0;
    int violations = 0;
    int sp = 0;
    int cur = root;
    int havePrev = 0;
    int prev = -1;
    while (cur >= 0 || sp > 0) {
        while (cur >= 0) {
            stack[sp] = cur;
            sp = sp + 1;
            cur = left[cur];
        }
        sp = sp - 1;
        cur = stack[sp];
        if (havePrev != 0 && key[prev] > key[cur]) violations = violations + 1;
        prev = cur;
        havePrev = 1;
        sum = sum + key[cur];
        cur = right[cur];
    }
    return sum + violations * 1000000000L;
}

class Bench {
    action:
        @constructor Bench() {
            long t0 = Time.nowMs();
            long v = bst(262144, 98765);
            long t1 = Time.nowMs();
            Console.writeString("verify ");
            Console.writeLong(v);
            Console.writeString("\nms ");
            Console.writeLong(t1 - t0);
            Console.writeString("\n");
        }
}

int main() {
    Bench b = new Bench();
    return 0;
}
