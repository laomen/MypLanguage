// bench/myp/kmp.myp — KMP 字符串匹配（失配表 + 单趟扫描，串模式）
// 32MB 文本 × 256 字节模式（均 LCG）；verify = 匹配次数。
// 与 C++ 同算法同 LCG。
import env;
import time;

long kmp(int n, int m, int seed) {
    uint8[] text = new uint8[n];
    uint8[] pat = new uint8[m];
    long rng = seed;
    int i = 0;
    while (i < n) {
        rng = (rng * 1103515245L + 12345L) % 2147483648L;
        text[i] = uint8((rng >> 16) & 0xFFL);
        i = i + 1;
    }
    i = 0;
    while (i < m) {
        rng = (rng * 1103515245L + 12345L) % 2147483648L;
        pat[i] = uint8((rng >> 16) & 0xFFL);
        i = i + 1;
    }
    int[] fail = new int[m];
    fail[0] = 0;
    int j = 0;
    i = 1;
    while (i < m) {
        while (j > 0 && pat[i] != pat[j]) j = fail[j - 1];
        if (pat[i] == pat[j]) j = j + 1;
        fail[i] = j;
        i = i + 1;
    }
    long count = 0;
    j = 0;
    i = 0;
    while (i < n) {
        while (j > 0 && text[i] != pat[j]) j = fail[j - 1];
        if (text[i] == pat[j]) j = j + 1;
        if (j == m) {
            count = count + 1;
            j = fail[j - 1];
        }
        i = i + 1;
    }
    return count;
}

class Bench {
    action:
        @constructor Bench() {
            long t0 = Time.nowMs();
            long v = kmp(33554432, 256, 98765);
            long t1 = Time.nowMs();
            Console.writeString("verify ");
            Console.writeLong(v);
            Console.writeString("\nms ");
            Console.writeLong(t1 - t0);
            Console.writeString("\n");
        }
}

int main() {
    Bench b = new Bench();
    return 0;
}
