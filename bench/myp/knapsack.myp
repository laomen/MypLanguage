// bench/myp/knapsack.myp — 0/1 背包（动态规划，1D 滚动数组 + 数据相关分支）
// N=10000 物品、容量 10000、重量 1..20、价值 1..1000；verify = dp[容量]。
// 与 C++ 同算法同 LCG。
import env;
import time;

long knapsack(int n, int cap, int seed) {
    int[] wt = new int[n];
    int[] val = new int[n];
    long rng = seed;
    int i = 0;
    while (i < n) {
        rng = (rng * 1103515245L + 12345L) % 2147483648L;
        wt[i] = (rng >> 16) % 20 + 1;    // 1..20
        rng = (rng * 1103515245L + 12345L) % 2147483648L;
        val[i] = (rng >> 16) % 1000 + 1; // 1..1000
        i = i + 1;
    }
    int[] dp = new int[cap + 1];
    i = 0;
    while (i < cap + 1) {
        dp[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        int w = cap;
        while (w >= wt[i]) {
            int cand = dp[w - wt[i]] + val[i];
            if (cand > dp[w]) dp[w] = cand;
            w = w - 1;
        }
        i = i + 1;
    }
    return dp[cap];
}

class Bench {
    action:
        @constructor Bench() {
            long t0 = Time.nowMs();
            long v = knapsack(10000, 10000, 13579);
            long t1 = Time.nowMs();
            Console.writeString("verify ");
            Console.writeLong(v);
            Console.writeString("\nms ");
            Console.writeLong(t1 - t0);
            Console.writeString("\n");
        }
}

int main() {
    Bench b = new Bench();
    return 0;
}
