// bench/myp/matmul.myp — 矩阵乘法 512×512 (double)
// 测：浮点乘加 + LLVM 是否保留自动向量化机会（C++ -O2 通常能向量化）。
// verify = 结果矩阵的迹
import env;
import time;

double matmulTrace(int n) {
    double[] A = new double[n * n];
    double[] B = new double[n * n];
    double[] C = new double[n * n];
    int i = 0;
    while (i < n * n) {
        A[i] = (i % 1000) * 1.0;
        B[i] = (i % 7) * 1.0;
        C[i] = 0.0;
        i = i + 1;
    }
    // 分块(blocked)矩阵乘：内层 jj 循环 C/B 连续 + A 元素不变 → 可向量化
    int BS = 64;
    int i0 = 0;
    while (i0 < n) {
        int j0 = 0;
        while (j0 < n) {
            int k0 = 0;
            while (k0 < n) {
                int i1 = i0;
                while (i1 < i0 + BS && i1 < n) {
                    int k1 = k0;
                    while (k1 < k0 + BS && k1 < n) {
                        double av = A[i1 * n + k1];
                        int j1 = j0;
                        while (j1 < j0 + BS && j1 < n) {
                            C[i1 * n + j1] = C[i1 * n + j1] + av * B[k1 * n + j1];
                            j1 = j1 + 1;
                        }
                        k1 = k1 + 1;
                    }
                    i1 = i1 + 1;
                }
                k0 = k0 + BS;
            }
            j0 = j0 + BS;
        }
        i0 = i0 + BS;
    }
    double trace = 0.0;
    i = 0;
    while (i < n) {
        trace = trace + C[i * n + i];
        i = i + 1;
    }
    return trace;
}

class Bench {
    action:
        @constructor Bench() {
            int n = 512;
            long t0 = Time.nowMs();
            double tr = matmulTrace(n);
            long t1 = Time.nowMs();
            Console.writeString("verify ");
            Console.writeFloat(tr);
            Console.writeString("ms ");
            Console.writeLong(t1 - t0);
            Console.writeString("\n");
        }
}

int main() {
    Bench b = new Bench();
    return 0;
}
