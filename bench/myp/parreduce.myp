// bench/myp/parreduce.myp — 并行归约（@parallel for，每线程独立槽位普通写）
// N=10^6 随机小整数（0..999，LCG），verify = 总和（无溢出，精确一致）。
// 每线程用 Parallel.workerId() 累加到自己专属槽位（workerId 恒定、槽位互斥 →
// 无竞争，普通 load-add-store 即可，无需原子），最后串行求和。
// 与 C++ std::thread 版同算法。
import env;
import pool;
import time;

long parreduce(int n, int seed) {
    int[] a = new int[n];
    long rng = seed;
    int i = 0;
    while (i < n) {
        rng = (rng * 1103515245L + 12345L) % 2147483648L;
        a[i] = int((rng >> 16) % 1000);
        i = i + 1;
    }
    // 分块并行：每线程一个连续块，局部 s 累加，块末写一次槽位（与 C++ std::thread 同构）。
    // 原逐元素 perThread[wid]+=a[j] 有缓存行乒乓（16 槽位同缓存行）+ 每元素内存访问 → 慢 ~3x。
    int nT = Parallel.threadCount();
    if (nT < 1) nT = 1;
    int chunk = (n + nT - 1) / nT;
    long[] perThread = new long[nT + 8];
    @parallel for (int k = 0; k < nT; k = k + 1) {
        int begin = k * chunk;
        int end = begin + chunk;
        if (end > n) end = n;
        long s = 0;
        int j = begin;
        while (j < end) {
            s = s + a[j];
            j = j + 1;
        }
        perThread[k] = s;
    }
    long sum = 0;
    i = 0;
    while (i < nT) {
        sum = sum + perThread[i];
        i = i + 1;
    }
    return sum;
}

class Bench {
    action:
        @constructor Bench() {
            long t0 = Time.nowMs();
            long v = parreduce(1000000, 24680);
            long t1 = Time.nowMs();
            Console.writeString("verify ");
            Console.writeLong(v);
            Console.writeString("\nms ");
            Console.writeLong(t1 - t0);
            Console.writeString("\n");
        }
}

int main() {
    Bench b = new Bench();
    return 0;
}
