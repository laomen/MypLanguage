// bench/myp/parreduce.myp — 并行归约（@parallel for，每线程独立槽位普通写）
// N=10^6 随机小整数（0..999，LCG），verify = 总和（无溢出，精确一致）。
// 每线程用 Parallel.workerId() 累加到自己专属槽位（workerId 恒定、槽位互斥 →
// 无竞争，普通 load-add-store 即可，无需原子），最后串行求和。
// 与 C++ std::thread 版同算法。
import env;
import pool;
import time;

long parreduce(int n, int seed) {
    int[] a = new int[n];
    long rng = seed;
    int i = 0;
    while (i < n) {
        rng = (rng * 1103515245L + 12345L) % 2147483648L;
        a[i] = int((rng >> 16) % 1000);
        i = i + 1;
    }
    int[] perThread = new int[64];
    i = 0;
    while (i < 64) {
        perThread[i] = 0;
        i = i + 1;
    }
    @parallel for (int j = 0; j < n; j = j + 1) {
        int wid = Parallel.workerId();
        perThread[wid] = perThread[wid] + a[j];
    }
    long sum = 0;
    i = 0;
    while (i < 64) {
        sum = sum + perThread[i];
        i = i + 1;
    }
    return sum;
}

class Bench {
    action:
        @constructor Bench() {
            long t0 = Time.nowMs();
            long v = parreduce(1000000, 24680);
            long t1 = Time.nowMs();
            Console.writeString("verify ");
            Console.writeLong(v);
            Console.writeString("\nms ");
            Console.writeLong(t1 - t0);
            Console.writeString("\n");
        }
}

int main() {
    Bench b = new Bench();
    return 0;
}
