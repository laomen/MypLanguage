// bench/myp/base64.myp — Base64 编码（字符映射 + 位打包，字符串处理）
// 8MB 字节流（LCG 高位）→ base64；verify = 输出字节和 + 采样字符×1000003。
// 与 C++ 同算法同 LCG。
import env;
import time;

long base64_bench(int n, int seed) {
    uint8[] in = new uint8[n];
    long rng = seed;
    int i = 0;
    while (i < n) {
        rng = (rng * 1103515245L + 12345L) % 2147483648L;
        in[i] = uint8((rng >> 16) & 0xFFL);   // 显式转换：long→uint8
        i = i + 1;
    }
    int outn = (n / 3) * 4;
    uint8[] out = new uint8[outn];
    // Base64 字母表（uint8[] 与 C++ 的 unsigned char 同宽；显式强转赋值）
    uint8[] B64 = new uint8[64];
    i = 0;
    while (i < 26) { B64[i] = uint8(65 + i); i = i + 1; }
    while (i < 52) { B64[i] = uint8(97 + i - 26); i = i + 1; }
    while (i < 62) { B64[i] = uint8(48 + i - 52); i = i + 1; }
    B64[62] = uint8(43);
    B64[63] = uint8(47);
    int j = 0;
    i = 0;
    while (i + 2 < n) {
        int b0 = int(in[i]);
        int b1 = int(in[i + 1]);
        int b2 = int(in[i + 2]);
        out[j] = uint8(B64[b0 >> 2]);
        out[j + 1] = uint8(B64[((b0 & 3) << 4) | (b1 >> 4)]);
        out[j + 2] = uint8(B64[((b1 & 15) << 2) | (b2 >> 6)]);
        out[j + 3] = uint8(B64[b2 & 63]);
        i = i + 3;
        j = j + 4;
    }
    long sum = 0;
    i = 0;
    while (i < outn) {
        sum = sum + long(out[i]);
        i = i + 1;
    }
    return sum + long(out[123456]) * 1000003L;
}

class Bench {
    action:
        @constructor Bench() {
            long t0 = Time.nowMs();
            long v = base64_bench(8388606, 24680);
            long t1 = Time.nowMs();
            Console.writeString("verify ");
            Console.writeLong(v);
            Console.writeString("\nms ");
            Console.writeLong(t1 - t0);
            Console.writeString("\n");
        }
}

int main() {
    Bench b = new Bench();
    return 0;
}
