// bench/myp/coro_switch.myp — 协程上下文切换吞吐（与 Go goroutine 对比）
// K=200 个 @coro，各 await M=10000 次 = 200 万次挂起/恢复（ucontext 交换）。
// 驱动逐个 Coro.resume；verify = Coro.count()（结束后应为 0）。
import env;
import coro;
import time;

class Worker {
    action:
        @coro(stack=64) void run(long m) {
            long j = 0;
            while (j < m) {
                await;
                j = j + 1;
            }
        }
}

long coroSwitch(int K, int M, int seed) {
    long[] h = new long[K];
    int i = 0;
    while (i < K) {
        Worker w = new Worker();
        h[i] = w.run(long(M));
        i = i + 1;
    }
    int step = 0;
    while (step < M) {
        i = 0;
        while (i < K) {
            Coro.resume(h[i], 0L);
            i = i + 1;
        }
        step = step + 1;
    }
    // 全部结束后应无活跃协程（正确性检查）；verify = 总切换次数（与 Go 一致）
    long left = Coro.count();
    if (left != 0L) return -1L;
    return long(K) * long(M);
}

class Bench {
    action:
        @constructor Bench() {
            long t0 = Time.nowMs();
            long v = coroSwitch(200, 10000, 1);
            long t1 = Time.nowMs();
            Console.writeString("verify ");
            Console.writeLong(v);
            Console.writeString("\nms ");
            Console.writeLong(t1 - t0);
            Console.writeString("\n");
        }
}

int main() {
    Bench b = new Bench();
    return 0;
}
