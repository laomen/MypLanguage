// bench/myp/sha256.myp — SHA-256 哈希（纯 MYP，uint32 原生 32 位语义）
// 测：位运算密集加密哈希（完全确定性，verify 完美对拍）。
// 消息 4MB（LCG 高位填充），verify = 哈希前 64 位（有符号 long）。
// 与旧版差异：uint32 的 >> 是逻辑右移、加减自动回绕、无需 mask，且
// (x>>n)|(x<<(32-n)) 会被 LLVM 识别为原生旋转（rorl/rorx）。
import env;
import time;

// 32 位循环右移（uint32 上 >> 是逻辑右移）
uint rotr(uint x, int n) {
    return (x >> n) | (x << (32 - n));
}

// SHA-256 主函数：返回 h0<<32|h1（有符号 long 作 verify）
long sha256(int msglen, int seed) {
    // 消息字节（0..255，uint 数组）
    uint[] msg = new uint[msglen];
    long rng = seed;
    int i = 0;
    while (i < msglen) {
        rng = (rng * 1103515245L + 12345L) % 2147483648L;
        msg[i] = (rng >> 16) & 0xFFL;   // long→uint 截断（值 0..255）
        i = i + 1;
    }
    // 填充：0x80 + 零 + 8 字节长度（bit 数）
    int total = msglen + 72;   // 留足：1(0x80)+pad+8，向上取整到 64 的倍数
    total = (total / 64) * 64;
    if (total < msglen + 9) total = total + 64;
    uint[] data = new uint[total];
    i = 0;
    while (i < msglen) {
        data[i] = msg[i];
        i = i + 1;
    }
    data[msglen] = 0x80u;
    i = msglen + 1;
    while (i < total - 8) {
        data[i] = 0u;
        i = i + 1;
    }
    long bitlen = msglen * 8L;
    data[total - 8] = (bitlen >> 56) & 0xFFL;
    data[total - 7] = (bitlen >> 48) & 0xFFL;
    data[total - 6] = (bitlen >> 40) & 0xFFL;
    data[total - 5] = (bitlen >> 32) & 0xFFL;
    data[total - 4] = (bitlen >> 24) & 0xFFL;
    data[total - 3] = (bitlen >> 16) & 0xFFL;
    data[total - 2] = (bitlen >> 8) & 0xFFL;
    data[total - 1] = bitlen & 0xFFL;

    // K 常量（64）与 H 初值（8）
    uint[] K = new uint[64];
    K[0] = 0x428a2f98u;  K[1] = 0x71374491u;  K[2] = 0xb5c0fbcfu;  K[3] = 0xe9b5dba5u;
    K[4] = 0x3956c25bu;  K[5] = 0x59f111f1u;  K[6] = 0x923f82a4u;  K[7] = 0xab1c5ed5u;
    K[8] = 0xd807aa98u;  K[9] = 0x12835b01u;  K[10] = 0x243185beu; K[11] = 0x550c7dc3u;
    K[12] = 0x72be5d74u; K[13] = 0x80deb1feu; K[14] = 0x9bdc06a7u; K[15] = 0xc19bf174u;
    K[16] = 0xe49b69c1u; K[17] = 0xefbe4786u; K[18] = 0x0fc19dc6u; K[19] = 0x240ca1ccu;
    K[20] = 0x2de92c6fu; K[21] = 0x4a7484aau; K[22] = 0x5cb0a9dcu; K[23] = 0x76f988dau;
    K[24] = 0x983e5152u; K[25] = 0xa831c66du; K[26] = 0xb00327c8u; K[27] = 0xbf597fc7u;
    K[28] = 0xc6e00bf3u; K[29] = 0xd5a79147u; K[30] = 0x06ca6351u; K[31] = 0x14292967u;
    K[32] = 0x27b70a85u; K[33] = 0x2e1b2138u; K[34] = 0x4d2c6dfcu; K[35] = 0x53380d13u;
    K[36] = 0x650a7354u; K[37] = 0x766a0abbu; K[38] = 0x81c2c92eu; K[39] = 0x92722c85u;
    K[40] = 0xa2bfe8a1u; K[41] = 0xa81a664bu; K[42] = 0xc24b8b70u; K[43] = 0xc76c51a3u;
    K[44] = 0xd192e819u; K[45] = 0xd6990624u; K[46] = 0xf40e3585u; K[47] = 0x106aa070u;
    K[48] = 0x19a4c116u; K[49] = 0x1e376c08u; K[50] = 0x2748774cu; K[51] = 0x34b0bcb5u;
    K[52] = 0x391c0cb3u; K[53] = 0x4ed8aa4au; K[54] = 0x5b9cca4fu; K[55] = 0x682e6ff3u;
    K[56] = 0x748f82eeu; K[57] = 0x78a5636fu; K[58] = 0x84c87814u; K[59] = 0x8cc70208u;
    K[60] = 0x90befffau; K[61] = 0xa4506cebu; K[62] = 0xbef9a3f7u; K[63] = 0xc67178f2u;

    uint h0 = 0x6a09e667u, h1 = 0xbb67ae85u, h2 = 0x3c6ef372u, h3 = 0xa54ff53au;
    uint h4 = 0x510e527fu, h5 = 0x9b05688cu, h6 = 0x1f83d9abu, h7 = 0x5be0cd19u;

    uint[] W = new uint[64];
    int blk = 0;
    while (blk < total / 64) {
        int base = blk * 64;
        i = 0;
        while (i < 16) {
            uint b0 = data[base + i * 4];
            uint b1 = data[base + i * 4 + 1];
            uint b2 = data[base + i * 4 + 2];
            uint b3 = data[base + i * 4 + 3];
            W[i] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
            i = i + 1;
        }
        i = 16;
        while (i < 64) {
            uint s0 = rotr(W[i - 15], 7) ^ rotr(W[i - 15], 18) ^ (W[i - 15] >> 3);
            uint s1 = rotr(W[i - 2], 17) ^ rotr(W[i - 2], 19) ^ (W[i - 2] >> 10);
            W[i] = W[i - 16] + s0 + W[i - 7] + s1;
            i = i + 1;
        }
        uint a = h0, b = h1, c = h2, d = h3, e = h4, f = h5, gg = h6, hh = h7;
        i = 0;
        while (i < 64) {
            uint S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            uint chh = (e & f) ^ ((e ^ 0xFFFFFFFFu) & gg);
            uint t1 = hh + S1 + chh + K[i] + W[i];
            uint S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            uint maj = (a & b) ^ (a & c) ^ (b & c);
            uint t2 = S0 + maj;
            hh = gg; gg = f; f = e;
            e = d + t1;
            d = c; c = b; b = a;
            a = t1 + t2;
            i = i + 1;
        }
        h0 = h0 + a;
        h1 = h1 + b;
        h2 = h2 + c;
        h3 = h3 + d;
        h4 = h4 + e;
        h5 = h5 + f;
        h6 = h6 + gg;
        h7 = h7 + hh;
        blk = blk + 1;
    }
    // 前 64 位作 verify（uint→long 经二元运算 ZExt，两语言打印一致）
    return h0 * 4294967296L + h1;
}

class Bench {
    action:
        @constructor Bench() {
            int msglen = 4194304;   // 4MB，让耗时可测（64KB 时两语言都 <1ms）
            long t0 = Time.nowMs();
            long v = sha256(msglen, 24680);
            long t1 = Time.nowMs();
            Console.writeString("verify ");
            Console.writeLong(v);
            Console.writeString("\nms ");
            Console.writeLong(t1 - t0);
            Console.writeString("\n");
        }
}

int main() {
    Bench b = new Bench();
    return 0;
}
