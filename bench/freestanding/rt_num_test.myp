// rt_num_test.myp — MYP 运行时数字层验证（runtime_myp/num.myp shadow C runtime）。
// 通过 parse* 内建 + to_string_* FFI 触发 num.myp 的符号，链接时 MYP 版本优先。
// 期望与 C 版本（strtoll/strtoull base-0 + itoa）一致。
import text;
import fmt;

// 直接调 to_string_*（精确验证边界，含 INT32/64_MIN、u32/u64 最大值）
ffi string myp_to_string_i32(int v);
ffi string myp_to_string_i64(long v);
ffi string myp_to_string_u32(int v);
ffi string myp_to_string_u64(long v);
ffi string myp_to_string_bool(int v);
ffi string myp_f64_bits_hex(double v);
ffi string myp_f32_bits_hex(float v);
ffi int myp_crc32(string s);

int main() {
    // parseLong（strtoll base-0：十进制/hex/八进制/负/空白/非法/空）
    if (parseLong("123") != 123) return 11;
    if (parseLong("0x1F") != 31) return 12;
    if (parseLong("0755") != 493) return 13;
    if (parseLong("-42") != -42) return 14;
    if (parseLong("  +7") != 7) return 15;
    if (parseLong("abc") != 0) return 16;
    if (parseLong("") != 0) return 17;
    if (parseLong("0x") != 0) return 18;
    // parseInt（strtoll base-0，截 i32）
    if (parseInt("0xFFFFFFFF") != -1) return 21;
    if (parseInt("1234567890") != 1234567890) return 22;
    // parseUint（strtoull base-0，截 i32）
    if (parseUint("0xFFFFFFFF") != -1) return 31;
    if (parseUint("42") != 42) return 32;
    // parseUlong（strtoull base-0）
    if (parseUlong("0xFFFFFFFF") != 4294967295) return 41;
    if (parseUlong("18446744073709551615") != -1) return 42;   // u64 最大值 → 位 -1
    // to_string_*（含边界）
    if (myp_to_string_i32(42) != "42") return 51;
    if (myp_to_string_i32(-42) != "-42") return 52;
    if (myp_to_string_i32(int(1) << 31) != "-2147483648") return 53;   // INT32_MIN
    if (myp_to_string_i64(0) != "0") return 61;
    if (myp_to_string_i64(-123) != "-123") return 62;
    if (myp_to_string_i64(long(1) << 63) != "-9223372036854775808") return 63;   // INT64_MIN
    if (myp_to_string_u32(-1) != "4294967295") return 71;   // u32 最大值
    if (myp_to_string_u32(0) != "0") return 72;
    if (myp_to_string_u64(-1) != "18446744073709551615") return 73;   // u64 最大值
    if (myp_to_string_u64(0) != "0") return 74;
    if (myp_to_string_bool(1) != "true") return 81;
    if (myp_to_string_bool(0) != "false") return 82;
    // 字符串拼接路径（真实用法：codegen 发射 myp_to_string_*）
    if ("" + 42 != "42") return 91;
    if ("" + 7 + "x" != "7x") return 92;
    if ("n=" + (-3) != "n=-3") return 93;
    // fmt 进制 → myp_fmt_u64_base（Fmt.u/x/X/o/b 位型无符号）
    if (Fmt.x(-1) != "ffffffff") return 101;
    if (Fmt.X(-1) != "FFFFFFFF") return 102;
    if (Fmt.o(-1) != "37777777777") return 103;
    if (Fmt.b(-1) != "11111111111111111111111111111111") return 104;
    if (Fmt.u(-1) != "4294967295") return 105;
    if (Fmt.x(0) != "0") return 106;
    if (Fmt.x(255) != "ff") return 107;
    if (Fmt.x(0x1F) != "1f") return 108;
    if (Fmt.X(0xABCD) != "ABCD") return 109;
    if (Fmt.u(42) != "42") return 110;
    if (Fmt.o(8) != "10") return 111;
    if (Fmt.b(5) != "101") return 112;
    // 浮点位型 → myp_f64_bits_hex / myp_f32_bits_hex（bitcast 取位）
    if (myp_f64_bits_hex(1.0) != "0x3FF0000000000000") return 121;
    if (myp_f64_bits_hex(-0.0) != "0x8000000000000000") return 122;
    if (myp_f64_bits_hex(0.0) != "0x0000000000000000") return 123;
    if (myp_f64_bits_hex(3.141592653589793) != "0x400921FB54442D18") return 124;
    if (myp_f64_bits_hex(-1.5) != "0xBFF8000000000000") return 125;
    if (myp_f32_bits_hex(1.0f) != "0x3FF0000000000000") return 126;   // float 先拓宽 double
    if (myp_f32_bits_hex(-0.0f) != "0x8000000000000000") return 127;
    // bytes 层 → myp_str_to_bytes / myp_bytes_to_str / myp_uint_to_bytes
    if (str(bytes("hello")) != "hello") return 131;
    if (str(bytes("")) != "") return 132;
    if (str(bytes("MYP")) != "MYP") return 133;
    ubyte[] bo = bytesOf(0x1234);
    if (int(bo[0]) != 52) return 134;    // 0x34 小端低位
    if (int(bo[1]) != 18) return 135;    // 0x12
    if (int(bo[2]) != 0) return 136;
    if (int(bo[3]) != 0) return 137;
    // crc32 → myp_crc32（zlib 标准向量，Fmt.x 看十六进制位型）
    if (Fmt.x(myp_crc32(""), 8) != "00000000") return 141;
    if (Fmt.x(myp_crc32("a"), 8) != "e8b7be43") return 142;
    if (Fmt.x(myp_crc32("hello"), 8) != "3610a686") return 143;
    if (Fmt.x(myp_crc32("123456789"), 8) != "cbf43926") return 144;
    // 加固：边缘用例
    if (parseLong("0XFF") != 255) return 151;      // 大写 hex
    if (parseLong("0") != 0) return 152;
    if (parseLong("-0x10") != -16) return 153;
    if (parseLong(" 123 ") != 123) return 154;
    if (myp_to_string_i64(-1) != "-1") return 155;
    if (myp_to_string_u64(long(1) << 63) != "9223372036854775808") return 156;  // u64 2^63
    if (myp_to_string_u32(2147483647) != "2147483647") return 157;
    return 0;
}
