// rt_str_test.myp — MYP 运行时字符串层验证（runtime_myp/str.myp shadow C runtime）。
// 通过 text.myp 的 Str 方法触发 myp_str_* FFI，链接时 MYP 版本优先
//（--allow-multiple-definition）。期望与 C 版本一致。
import text;
import base64;

// 直接调 ord/charcode/chr/strdup（Str.ord/chr 走 __myp_* 内建发射同名 runtime 调用）
ffi int myp_charcode(string s, int i);
ffi string myp_strdup(string s);
ffi void myp_retain(string s);
ffi int myp_obj_type_id(string s);

// ARC/核心层探针：retain 增量 + 对象 type_id 读取（shadow 真生效验证）
class ArcProbe {
    static:
        int run() {
            string s = myp_strdup("hi");
            int rc0 = __myp_mem_load_i32(__myp_str_ptr(s) - 8);
            myp_retain(s);
            int rc1 = __myp_mem_load_i32(__myp_str_ptr(s) - 8);
            if (rc1 != rc0 + 1) return 1;                 // retain → rc+1
            if (myp_obj_type_id(s) != -2) return 2;        // MYP_STR_TYPE_ID=0xFFFFFFFE
            return 0;
        }
}

// StringBuilder 实例方法不能在 main() 里直接调（direct call 限制）→ 包进 @static 方法。
class RtJoinProbe {
    static:
        int testJoin() {
            StringBuilder sb = new StringBuilder();
            sb.append("a");
            sb.append("b");
            sb.append("c");
            if (sb.toString() != "abc") return 1;
            if (sb.count() != 3) return 2;
            StringBuilder sb2 = new StringBuilder();
            if (sb2.toString() != "") return 3;
            return 0;
        }
}

// `s = s + x` 快路径（myp_str_append）验证：owned 局部 + 累积循环 → arena 原地扩展。
// 注意：main() 里不能直接做这种调用（direct call 限制）→ 包成 @static 方法。
class RtAppendProbe {
    static:
        int testAppend() {
            // 小累积（首轮字面量 → 慢路径，第 2 轮起 rc==1 且为最后分配 → 原地扩展）
            string acc = "";
            for (int i = 0; i < 2000; i = i + 1) acc = acc + "x";
            if (acc != Str.repeat("x", 2000)) return 1;
            if (Str.len(acc) != 2000) return 2;
            if (myp_charcode(acc, 0) != 120) return 3;      // 'x'
            if (myp_charcode(acc, 1999) != 120) return 4;
            // 自拼接 s = s + s（fallback 手动拷贝路径）
            string a = "ab";
            a = a + a;
            if (a != "abab") return 5;
            if (Str.len(a) != 4) return 6;
            // 多段拼接（字面量起始 → 首轮慢路径，后续快路径）
            string b = "hello";
            b = b + " ";
            b = b + "world";
            if (b != "hello world") return 7;
            if (Str.len(b) != 11) return 8;
            // 大累积（跨 arena chunk 边界的扩展，须经手动拷贝换 chunk 仍正确）
            string big = "";
            for (int j = 0; j < 40000; j = j + 1) big = big + "ab";
            if (Str.len(big) != 80000) return 9;
            if (myp_charcode(big, 0) != 97) return 10;      // 'a'
            if (myp_charcode(big, 79998) != 97) return 11;  // 末段首字符 'a'
            if (myp_charcode(big, 79999) != 98) return 12;  // 末字符 'b'
            // 空串 + 字面量（x 为静态常量，xp != sp，仍走拼接）
            string c = "";
            c = c + "hello";
            if (c != "hello") return 13;
            return 0;
        }
}

int main() {
    // == / != → myp_str_eq
    if (!("abc" == "abc")) return 1;
    if ("abc" == "abd") return 2;
    if ("abc" != "abc") return 3;
    if (!("" == "")) return 4;
    if ("abc" == "ab") return 5;
    // < <= > >= → myp_str_cmp（strcmp 语义）
    if ("abc" >= "abd") return 11;
    if ("abc" > "abc") return 12;
    if ("abd" < "abc") return 13;
    if ("abc" < "abc") return 14;
    if ("ab" > "abc") return 15;
    // Str.len → myp_strlen
    if (Str.len("hello") != 5) return 21;
    if (Str.len("") != 0) return 22;
    if (Str.len("MYP") != 3) return 23;
    // contains → myp_str_contains
    if (!Str.contains("hello world", "world")) return 31;
    if (Str.contains("hello", "xyz")) return 32;
    if (!Str.contains("hello", "")) return 33;
    if (Str.contains("ab", "abc")) return 34;
    // indexOf → myp_str_index_of
    if (Str.indexOf("hello", "ll") != 2) return 41;
    if (Str.indexOf("hello", "x") != -1) return 42;
    if (Str.indexOf("hello", "") != 0) return 43;
    // startsWith / endsWith
    if (!Str.startsWith("hello", "he")) return 51;
    if (Str.startsWith("hello", "lo")) return 52;
    if (!Str.endsWith("hello", "llo")) return 53;
    if (Str.endsWith("hello", "hel")) return 54;
    if (Str.startsWith("a", "ab")) return 55;
    // substring → myp_str_substring
    if (Str.substring("hello", 1, 4) != "ell") return 61;
    if (Str.substring("hello", 2, 2) != "") return 62;
    if (Str.substring("hello", 0, 99) != "hello") return 63;
    if (Str.substring("hello", -3, 2) != "he") return 64;
    // toUpper / toLower
    if (Str.toUpper("Hello") != "HELLO") return 71;
    if (Str.toLower("HeLLo") != "hello") return 72;
    if (Str.toUpper("a1B") != "A1B") return 73;
    // trim
    if (Str.trim("  hi  ") != "hi") return 81;
    if (Str.trim("\t\n hi \r") != "hi") return 82;
    if (Str.trim("plain") != "plain") return 83;
    // toInt → myp_str_to_int
    if (Str.toInt("123") != 123) return 91;
    if (Str.toInt("  -42 ") != -42) return 92;
    if (Str.toInt("abc") != 0) return 93;
    if (Str.toInt("0") != 0) return 94;
    // splitCount → myp_str_split_count
    if (Str.splitCount("a,b,c", ",") != 3) return 101;
    if (Str.splitCount("abc", ",") != 1) return 102;
    if (Str.splitCount("", ",") != 0) return 103;
    if (Str.splitCount("a,,b", ",") != 3) return 104;
    // splitGet → myp_str_split_get
    if (Str.splitGet("a,b,c", ",", 0) != "a") return 111;
    if (Str.splitGet("a,b,c", ",", 1) != "b") return 112;
    if (Str.splitGet("a,b,c", ",", 2) != "c") return 113;
    if (Str.splitGet("a,b,c", ",", 3) != "") return 114;
    if (Str.splitGet("a,b,c", ",", -1) != "") return 115;
    if (Str.splitGet("abc", ",", 0) != "abc") return 116;
    if (Str.splitGet(",b", ",", 0) != "") return 117;
    if (Str.splitGet(",b", ",", 1) != "b") return 118;
    // split（数组 = split_count + split_get）
    string[] parts = Str.split("a-b-c", "-");
    if (parts[0] != "a") return 121;
    if (parts[1] != "b") return 122;
    if (parts[2] != "c") return 123;
    // replace → myp_str_replace（首个匹配）
    if (Str.replace("hello world", "world", "MYP") != "hello MYP") return 131;
    if (Str.replace("hello", "x", "Y") != "hello") return 132;
    if (Str.replace("aaa", "a", "b") != "baa") return 133;
    if (Str.replace("hello", "ll", "") != "heo") return 134;
    // replaceAll → myp_str_replace_all
    if (Str.replaceAll("aaa", "a", "b") != "bbb") return 141;
    if (Str.replaceAll("hello", "l", "L") != "heLLo") return 142;
    if (Str.replaceAll("hello", "x", "Y") != "hello") return 143;
    if (Str.replaceAll("abcabc", "bc", "X") != "aXaX") return 144;
    if (Str.replaceAll("abab", "ab", "") != "") return 145;
    if (Str.replaceAll("hello", "", "X") != "hello") return 146;
    // repeat → myp_str_repeat
    if (Str.repeat("ab", 3) != "ababab") return 151;
    if (Str.repeat("ab", 0) != "") return 152;
    if (Str.repeat("x", 1) != "x") return 153;
    // padLeft / padRight（空格填充）
    if (Str.padLeft("ab", 5) != "   ab") return 161;
    if (Str.padRight("ab", 5) != "ab   ") return 162;
    if (Str.padLeft("abcdef", 5) != "abcdef") return 163;
    if (Str.padRight("abcdef", 5) != "abcdef") return 164;
    // reverse → myp_str_reverse
    if (Str.reverse("hello") != "olleh") return 171;
    if (Str.reverse("") != "") return 172;
    if (Str.reverse("a") != "a") return 173;
    // join → myp_str_join（经 StringBuilder.toString，静态方法包装）
    int jr = RtJoinProbe.testJoin();
    if (jr != 0) return 180 + jr;
    // concat → myp_strcat（codegen 对 s+t 发射；非 `s=s+x` 快路径）
    if ("ab" + "cd" != "abcd") return 191;
    if ("x" + "y" + "z" != "xyz") return 192;
    if ("" + "abc" != "abc") return 193;
    if ("abc" + "" != "abc") return 194;
    if ("a" + "b" + "c" + "d" + "e" != "abcde") return 195;
    if (("pre" + "fix") + "ed" != "prefixed") return 196;
    // ord / charcode / chr / strdup
    if (Str.ord("A") != 65) return 201;
    if (Str.ord("") != 0) return 202;
    if (myp_charcode("abc", 1) != 98) return 203;
    if (myp_charcode("abc", -1) != 0) return 204;
    if (Str.chr(65) != "A") return 205;
    if (Str.chr(0x4E2D) != "中") return 206;      // 3 字节 UTF-8（U+4E2D）
    if (Str.chr(-1) != "�") return 207;           // 非法码点 → 0xFFFD 替换符
    if (myp_strdup("hello") != "hello") return 208;
    if (myp_strdup("") != "") return 209;
    // base64 编解码（bridge 纯函数，MYP 模块提供符号）
    if (Base64.encode("hello") != "aGVsbG8=") return 221;
    if (Base64.encode("") != "") return 222;
    if (Base64.encode("a") != "YQ==") return 223;
    if (Base64.encode("ab") != "YWI=") return 224;
    if (Base64.encode("abc") != "YWJj") return 225;
    if (Base64.encode("MYP") != "TVlQ") return 226;
    if (Base64.decode("aGVsbG8=") != "hello") return 231;
    if (Base64.decode("YQ==") != "a") return 232;
    if (Base64.decode("YWI=") != "ab") return 233;
    if (Base64.decode("YWJj") != "abc") return 234;
    if (Base64.decode(Base64.encode("The quick brown fox 0123456789")) != "The quick brown fox 0123456789") return 235;
    // 加固：边缘用例（shadow 真生效后压一遍）
    if (Str.substring("abc", 3, 3) != "") return 251;
    if (Str.substring("abc", 2, 1) != "") return 252;
    if (Str.replace("abc", "", "X") != "Xabc") return 253;   // 空 old → 前缀插入
    if (Str.trim("   ") != "") return 254;                    // 纯空白 → 空
    if (Str.toInt("+42") != 42) return 255;
    if (Str.toInt("  0  ") != 0) return 256;
    if (Str.splitGet("a,b,", ",", 2) != "") return 257;       // 尾分隔符
    if (Str.startsWith("abc", "") != 1) return 258;            // 空前缀
    if (Str.endsWith("abc", "") != 1) return 259;
    if (Str.contains("abc", "") != 1) return 260;
    if (Str.cmp("abc", "abd") != -1) return 261;
    // 核心层 ARC 探针（raw-address 原子内建 + myp_retain/myp_obj_type_id）
    int arc = ArcProbe.run();
    if (arc != 0) return 270 + arc;
    // `s = s + x` 快路径（myp_str_append）：累积循环 + 自拼接 + 跨 chunk 大串
    int apr = RtAppendProbe.testAppend();
    if (apr != 0) return 280 + apr;
    return 0;
}
