// rt_hash_test.myp — MYP 运行时哈希层验证（runtime_myp/hash.myp：md5/sha1/sha256）。
// 已知标准向量对拍（sha256 已在 rt_num_test，这里补 md5/sha1 全向量）。
import text;

ffi string myp_hash_md5(string s);
ffi string myp_hash_sha1(string s);
ffi string myp_hash_sha256(string s);

int main() {
    // MD5 标准向量
    if (myp_hash_md5("") != "d41d8cd98f00b204e9800998ecf8427e") return 11;
    if (myp_hash_md5("abc") != "900150983cd24fb0d6963f7d28e17f72") return 12;
    if (myp_hash_md5("The quick brown fox jumps over the lazy dog")
        != "9e107d9d372bb6826bd81d3542a419d6") return 13;
    if (myp_hash_md5("12345678901234567890123456789012345678901234567890123456789012345678901234567890")
        != "57edf4a22be3c955ac49da2e2107b67a") return 14;
    // SHA-1 标准向量
    if (myp_hash_sha1("") != "da39a3ee5e6b4b0d3255bfef95601890afd80709") return 21;
    if (myp_hash_sha1("abc") != "a9993e364706816aba3e25717850c26c9cd0d89d") return 22;
    if (myp_hash_sha1("The quick brown fox jumps over the lazy dog")
        != "2fd4e1c67a2d28fced849ee1bb76e7391b93eb12") return 23;
    // 交叉一致：同一输入 md5/sha1/sha256 都是小写 32/40/64 位 hex
    if (Str.len(myp_hash_md5("hello")) != 32) return 31;
    if (Str.len(myp_hash_sha1("hello")) != 40) return 32;
    if (Str.len(myp_hash_sha256("hello")) != 64) return 33;
    return 0;
}
