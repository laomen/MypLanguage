// rt_gpu_test.myp — GPU 层 shadow 验证（#43 Stage A init/查询/内存 + #44 Stage B 内核）。
// 双模式：
//   - 无 MYP_GPU（shadow 套件默认）→ CPU 回退：vendor="cpu"、查询全 0、@gpu for
//     走 CPU 回退同结果。
//   - MYP_GPU=1（有 CUDA 驱动）→ 真 GPU：设备名/算力/显存 + 内存往返 + @gpu for
//     真实内核执行（load_kernel+launch+destroy）。
// exit 0 = 通过（两种模式各自断言一致）。
import env;
import math;

ffi int myp_gpu_device_count();
ffi long myp_gpu_device_memory();
ffi int myp_gpu_compute_capability();
ffi string myp_gpu_device_name();
ffi long myp_gpu_alloc(long sz);
ffi void myp_gpu_free(long p);
ffi void myp_gpu_to_device(long d, long s, long sz);
ffi void myp_gpu_to_host(long d, long s, long sz);
ffi int myp_gpu_sync_all();
ffi long myp_arena_alloc(long size);
ffi long myp_gpu_stream_create_h();
ffi int myp_gpu_stream_sync_h(long s);
ffi int myp_gpu_stream_destroy_h(long s);
ffi int myp_gpu_copy_h2d_async_d(long dev, long host, int srcOff, int dstOff, int len, long stream);
ffi int myp_gpu_copy_d2h_async_d(long host, long dev, int srcOff, int dstOff, int len, long stream);
ffi int myp_gpu_copy_d2d_async(long dst, long dstOff, long src, long srcOff, long bytes, long stream);
ffi long myp_gpu_event_create_h();
ffi int myp_gpu_event_record_h(long ev, long stream);
ffi int myp_gpu_event_sync_h(long ev);
ffi double myp_gpu_event_elapsed_ms(long evStart, long evEnd);
ffi int myp_gpu_event_destroy_h(long ev);
ffi int myp_gpu_graph_capture_begin(long stream);
ffi long myp_gpu_graph_capture_end(long stream);
ffi long myp_gpu_graph_instantiate(long graph);
ffi int myp_gpu_graph_launch(long exec, long stream);
ffi void myp_gpu_graph_destroy(long graph);
ffi void myp_gpu_graph_exec_destroy(long exec);

class GpuProbe {
    action:
        @constructor GpuProbe() {
            string vendor = __myp_gpu_vendor();
            int devs = myp_gpu_device_count();
            Console.writeString("vendor=" + vendor + " devs=");
            Console.write(devs);
            Console.writeString("\n");
            if (vendor == "cpu") {
                // CPU 回退：查询全 0；@gpu for CPU 回退同结果
                if (devs != 0) { Console.writeString("FAIL: cpu fallback devs\n"); return; }
                if (myp_gpu_device_memory() != 0) { Console.writeString("FAIL: cpu mem\n"); return; }
                if (myp_gpu_compute_capability() != 0) { Console.writeString("FAIL: cpu cap\n"); return; }
                if (__myp_gpu_mem_alignment() != 16) { Console.writeString("FAIL: align\n"); return; }
                if (runKernel() == 0) { Console.writeString("FAIL: cpu kernel\n"); return; }
                Console.writeString("GPU CPU-FALLBACK OK\n");
                return;
            }
            // 真 GPU：设备查询
            string name = myp_gpu_device_name();
            int cap = myp_gpu_compute_capability();
            long mem = myp_gpu_device_memory();
            Console.writeString("name=" + name + " cap=");
            Console.write(cap);
            Console.writeString(" memMB=");
            Console.write(int(mem / 1048576));
            Console.writeString("\n");
            if (devs < 1 || cap < 100 || mem <= 0 || name == "") { Console.writeString("FAIL: gpu query\n"); return; }
            // 内存往返：host buffer(arena) → device → host，验证内容
            long host = myp_arena_alloc(64);
            for (int i = 0; i < 16; i = i + 1)
                __myp_mem_store_i32(host + long(i) * 4, i * 3);
            long dev = myp_gpu_alloc(64);
            if (dev == 0) { Console.writeString("FAIL: gpu alloc\n"); return; }
            myp_gpu_to_device(dev, host, 64);
            long host2 = myp_arena_alloc(64);
            for (int i = 0; i < 16; i = i + 1) __myp_mem_store_i32(host2 + long(i) * 4, -1);
            myp_gpu_to_host(host2, dev, 64);
            myp_gpu_sync_all();
            int ok = 1;
            for (int i = 0; i < 16; i = i + 1) {
                if (__myp_mem_load_i32(host2 + long(i) * 4) != i * 3) { ok = 0; break; }
            }
            myp_gpu_free(dev);
            if (ok == 0) { Console.writeString("FAIL: gpu mem roundtrip\n"); return; }
            // Stage B：@gpu for 真实内核执行（load_kernel + launch + destroy）
            if (runKernel() == 0) { Console.writeString("FAIL: gpu kernel\n"); return; }
            // Stage C：流/事件/图/异步拷贝（真实 GPU）
            if (runStageC() == 0) { Console.writeString("FAIL: gpu stageC\n"); return; }
            Console.writeString("GPU OK\n");
        }
        // @gpu for 内核执行：data[i] = sqrt(4) + sin(1) → 2.8414709848078967
        // CPU 回退与真 GPU 同结果（codegen @gpu for 统一语义）。
        int runKernel() {
            long n = 128L;
            double[] data = new double[n];
            for (long i = 0L; i < n; i = i + 1L) data[i] = 4.0;
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = Math.sqrt(data[i]) + Math.sin(1.0);
            }
            double expect = 2.0 + 0.8414709848078965;
            for (long i = 0L; i < n; i = i + 1L) {
                double v = data[i];
                if (v < expect - 1e-9 || v > expect + 1e-9) return 0;
            }
            return 1;
        }
        // Stage C：流 + 事件 + CUDA Graph（真实 GPU 验证）。异步拷贝只验 C 平价
        // 返回 1（本机驱动 595.84 上 cuMemcpy*Async 恒 201，纯 C 复现，非迁移问题）。
        int runStageC() {
            long s = myp_gpu_stream_create_h();
            if (s == 0) return 0;
            if (myp_gpu_stream_sync_h(s) != 1) return 0;
            // 异步拷贝 C 平价
            long host = myp_arena_alloc(128);
            for (int i = 0; i < 16; i = i + 1)
                __myp_mem_store_double(host + long(i) * 8, double(i) * 2.5);
            long dev = myp_gpu_alloc(128);
            if (dev == 0) return 0;
            if (myp_gpu_copy_h2d_async_d(dev, host, 0, 0, 16, s) != 1) return 0;
            if (myp_gpu_copy_d2h_async_d(host, dev, 0, 0, 16, s) != 1) return 0;
            if (myp_gpu_copy_d2d_async(dev, 0, dev, 0, 128, s) != 1) return 0;
            // 事件
            long evA = myp_gpu_event_create_h();
            long evB = myp_gpu_event_create_h();
            if (evA == 0 || evB == 0) return 0;
            if (myp_gpu_event_record_h(evA, s) != 1) return 0;
            if (myp_gpu_event_record_h(evB, s) != 1) return 0;
            if (myp_gpu_event_sync_h(evB) != 1) return 0;
            double ms = myp_gpu_event_elapsed_ms(evA, evB);
            if (ms < 0.0) return 0;
            if (myp_gpu_event_destroy_h(evA) != 1 || myp_gpu_event_destroy_h(evB) != 1) return 0;
            // CUDA Graph（空捕获 → 实例化 → 重放；新流避免失败 async 污染）
            long s2 = myp_gpu_stream_create_h();
            if (s2 == 0) return 0;
            if (myp_gpu_graph_capture_begin(s2) != 1) return 0;
            long graph = myp_gpu_graph_capture_end(s2);
            if (graph == 0) return 0;
            long exec = myp_gpu_graph_instantiate(graph);
            if (exec == 0) return 0;
            if (myp_gpu_graph_launch(exec, s2) != 1) return 0;
            if (myp_gpu_stream_sync_h(s2) != 1) return 0;
            myp_gpu_graph_exec_destroy(exec);
            myp_gpu_graph_destroy(graph);
            myp_gpu_stream_destroy_h(s2);
            myp_gpu_free(dev);
            if (myp_gpu_stream_destroy_h(s) != 1) return 0;
            return 1;
        }
}

int main() {
    GpuProbe p = new GpuProbe();
    return 0;
}
