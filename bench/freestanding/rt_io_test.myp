// rt_io_test.myp — 文件 I/O 层 MYP 化（#16）验证：
// 写文本/行/字节/大端 int/double → 读回校验 → EOF 检测。
// File 类（stdlib io.myp）经 __myp_io_* 内建 → myp_io_*（io.myp shadow C）。
import io;

class IoProbe {
    static:
        int run() {
            // 写
            File w = new File();
            w.open("/tmp/rt_myp_io_test.txt", "w");
            w.writeLine("hello");
            w.writeLine("world");
            w.write("no-newline");
            w.writeByte(10);              // \n（终止 "no-newline"）
            w.writeI32BE(0x01020304);
            w.writeDouble(3.14159);
            w.writeByte(0xAA);            // marker（测 readByte）
            w.close();

            // 读回
            File r = new File();
            r.open("/tmp/rt_myp_io_test.txt", "r");
            string l1 = r.readLine();
            string l2 = r.readLine();
            string l3 = r.readLine();
            if (l1 != "hello") return 1;
            if (l2 != "world") return 2;
            if (l3 != "no-newline") return 3;
            int i32 = r.readI32BE();
            if (i32 != 0x01020304) return 4;
            double d = r.readDouble();
            double diff = d - 3.14159;
            if (diff < 0) diff = -diff;
            if (diff > 0.0001) return 5;
            int marker = r.readByte();
            if (marker != 0xAA) return 6;
            // hasNext 是 C `!feof` 语义：读走最后字节后 feof 尚未置位，须先越界
            // 读（撞 EOF 置 feof）再查 hasNext（read_byte 撞 EOF 返回 -1）。
            int eofProbe = r.readByte();
            if (eofProbe != -1) return 7;    // 应 EOF（-1）
            if (r.hasNext()) return 7;       // 应 EOF
            r.close();

            // readAll（修复：经 MYP fd 表同步读，C FILE* 空表问题）
            File a = new File();
            a.open("/tmp/rt_myp_io_all.txt", "w");
            a.writeLine("line1");
            a.writeLine("line2");
            a.write("tail");
            a.close();
            File b = new File();
            b.open("/tmp/rt_myp_io_all.txt", "r");
            string all = b.readAll();
            if (all != "line1\nline2\ntail") return 8;
            b.close();
            return 0;
        }
}
int main() { return IoProbe.run(); }
