// rt_pool_test.myp — @parallel for 线程池验证（runtime_myp/pool.myp，包 F，
// clone + futex 无 libc）：int/long 循环变量 + Atomic.addInt、多批次（deque 复用 +
// barrier 复位）、Parallel API。
// 返回码：0 = 全过；N = 第 N 项失败。
import pool;
import atomic;

class ParTest {
    static:
        int run() {
            // 小池（2 worker）确定性快
            Parallel.setThreads(2);

            // 1) int @parallel for：tally[i] += i → sum = 0+..+999 = 499500
            int[] tally = new int[1000];
            @parallel for (int i = 0; i < 1000; i = i + 1) {
                Atomic.addInt(tally, i, i);
            }
            int s = 0;
            for (int j = 0; j < 1000; j = j + 1) s = s + tally[j];
            if (s != 499500) return 1;

            // 2) long @parallel for
            int[] tally2 = new int[1000];
            @parallel for (long i = 0L; i < 1000L; i = i + 1L) {
                Atomic.addInt(tally2, int(i), int(i));
            }
            int s2 = 0;
            for (int j = 0; j < 1000; j = j + 1) s2 = s2 + tally2[j];
            if (s2 != 499500) return 2;

            // 3) 多批次：10 × @parallel for(100) → 每槽 +1 ×10 → 1000
            int[] tally3 = new int[100];
            for (int b = 0; b < 10; b = b + 1) {
                @parallel for (int i = 0; i < 100; i = i + 1) {
                    Atomic.addInt(tally3, i, 1);
                }
            }
            int s3 = 0;
            for (int j = 0; j < 100; j = j + 1) s3 = s3 + tally3[j];
            if (s3 != 1000) return 3;

            // 4) Parallel API
            if (Parallel.isActive() != 1) return 4;
            if (Parallel.workerCount() != 2) return 5;
            if (Parallel.threadCount() < 1) return 6;

            // 5) 高频小 n 微并行（防丢唤醒回归，v3.15.201）——复刻 /tmp/par_smalln：
            //    n=1..32 × 2000 次 1..32 元素微 @parallel。修复前 runtime_myp/pool.myp
            //    poolWorkerEntry 经 poolWorkWait()「先查空 deque 再快照 workSeq 去
            //    futex_wait」——发布者 ++/wake 后快照到新值 → futex_wait(值==期望) 真睡，
            //    块无人处理 → 主线程 barrier 永等 → 死锁 ~50% 复现。修复=worker 先快照
            //    workSeq 再查 deque。回归信号：池若回退此段会直接挂起（冒烟卡住即暴露）。
            float[] pa = new float[64];
            float[] pb = new float[64];
            int n5 = 1;
            while (n5 <= 32) {
                int k5 = 0;
                while (k5 < 64) { pa[k5] = float(k5 % 5); pb[k5] = 0.0f; k5 = k5 + 1; }
                int rep5 = 0;
                while (rep5 < 2000) {
                    @parallel for (int i = 0; i < n5; i = i + 1) { pb[i] = pa[i] * 1.0000001f + 0.5f; }
                    rep5 = rep5 + 1;
                }
                n5 = n5 + 1;
            }
            // 末轮 n5=32 覆写 pb[0..31] → 轻量校验（每 rep 同值覆盖，与 rep 数无关）
            int j5 = 0;
            while (j5 < 32) {
                float expect = float(j5 % 5) * 1.0000001f + 0.5f;
                if (pb[j5] != expect) return 7;
                j5 = j5 + 1;
            }

            return 0;
        }
}

int main() {
    return ParTest.run();
}
