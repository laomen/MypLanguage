// rt_net_test.myp — MYP 运行时 TCP 网络层验证（runtime_myp/net.myp shadow C bridge）。
// 覆盖：server/connect/accept 回环、客户端→服务端 send/recv、服务端→客户端
// recv_line（剥 \r\n）、主机解析失败 -2、连接拒绝 -3、set_nonblock。
// main 不允许直接调函数 → 包进 class static。
import env;

ffi int myp_net_server(int port);
ffi int myp_net_accept(int server_fd);
ffi int myp_net_connect(string host, int port);
ffi int myp_net_send(int fd, string data);
ffi string myp_net_recv(int fd, int max_len);
ffi string myp_net_recv_line(int fd);
ffi void myp_net_close(int fd);
ffi void myp_net_set_nonblock(int fd);

class NetProbe {
    static:
        int run() {
            int port = 18432;
            int srv = myp_net_server(port);
            if (srv < 0) return 11;
            int cli = myp_net_connect("127.0.0.1", port);
            if (cli < 0) return 12;
            int ac = myp_net_accept(srv);
            if (ac < 0) return 13;
            // 客户端 → 服务端（send/recv）
            if (myp_net_send(cli, "hello") != 5) return 14;
            if (myp_net_recv(ac, 100) != "hello") return 15;
            // 服务端 → 客户端（recv_line 剥 \n）
            if (myp_net_send(ac, "world\n") != 6) return 16;
            if (myp_net_recv_line(cli) != "world") return 17;
            // 错误路径：主机解析失败 / 连接拒绝
            if (myp_net_connect("no.such.host.invalid", port) != -2) return 21;
            if (myp_net_connect("127.0.0.1", 1) != -3) return 22;   // port 1 未监听
            // nonblock 设置（不崩溃即可）
            myp_net_set_nonblock(cli);
            // 清理
            myp_net_close(ac);
            myp_net_close(cli);
            myp_net_close(srv);
            return 0;
        }
}

int main() {
    return NetProbe.run();
}
