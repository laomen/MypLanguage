// math.myp — MYP 标准库：数学函数（静态类，无需实例化）
// __myp_math_* 是编译器内置函数（intrinsic），仅 stdlib 可用

class Math {
    static:
        // 常数
        double pi() { return 3.141592653589793; }
        double e() { return 2.718281828459045; }

        // 基本函数
        double sqrt(double v)   { return __myp_math_sqrt(v); }
        double abs(double v)    { return __myp_math_abs(v); }
        double floor(double v)  { return __myp_math_floor(v); }
        double ceil(double v)   { return __myp_math_ceil(v); }
        int trunc(double v)     { return __myp_trunc(v); }

        // 三角函数
        double sin(double v)    { return __myp_math_sin(v); }
        double cos(double v)    { return __myp_math_cos(v); }
        double tan(double v)    { return __myp_math_tan(v); }

        // 反三角函数
        double asin(double v)   { return __myp_math_asin(v); }
        double acos(double v)   { return __myp_math_acos(v); }
        double atan(double v)   { return __myp_math_atan(v); }
        double atan2(double y, double x) { return __myp_math_atan2(y, x); }

        // 双曲函数
        double sinh(double v)   { return __myp_math_sinh(v); }
        double cosh(double v)   { return __myp_math_cosh(v); }
        double tanh(double v)   { return __myp_math_tanh(v); }

        // 指数对数
        double exp(double v)    { return __myp_math_exp(v); }
        double log(double v)    { return __myp_math_log(v); }
        double pow(double base, double exp) { return __myp_math_pow(base, exp); }

        // 整数运算
        int absInt(int v)       { return __myp_math_abs_int(v); }
        int min(int a, int b)   { if (a < b) return a; return b; }
        int max(int a, int b)   { if (a > b) return a; return b; }
        long minLong(long a, long b)   { if (a < b) return a; return b; }
        long maxLong(long a, long b)   { if (a > b) return a; return b; }

        // 实用函数
        int clamp(int v, int lo, int hi) {
            if (v < lo) return lo;
            if (v > hi) return hi;
            return v;
        }
        double clampDouble(double v, double lo, double hi) {
            if (v < lo) return lo;
            if (v > hi) return hi;
            return v;
        }
        double lerp(double a, double b, double t) {
            return a + (b - a) * t;
        }
        double degToRad(double deg) { return deg * Math.pi() / 180.0; }
        double radToDeg(double rad) { return rad * 180.0 / Math.pi(); }
}
