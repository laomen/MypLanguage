// test.myp — MYP 标准库：测试断言工具
// 用法：
//   import test;
//   Test.assert(1 == 1);
//   Test.assertEq(2 + 2, 4);
//   Test.assertStrEq("hi", "hi");
//   Test.assertFloatEq(3.14, 3.14, 0.001);
//   Test.report("my_test", true);

class Test {
    static:
        // 布尔断言（可带自定义消息，失败时打印）
        void assert(bool cond, string msg = "") {
            if (msg == "") __myp_assert(cond);
            else __myp_assert_msg(cond, msg);
        }

        // 显式 true/false
        void assertTrue(bool cond, string msg = "") {
            if (msg == "") __myp_assert(cond);
            else __myp_assert_msg(cond, msg);
        }
        void assertFalse(bool cond, string msg = "") {
            if (msg == "") __myp_assert(!cond);
            else __myp_assert_msg(!cond, msg);
        }

        // 整数相等/不等断言（可带消息）
        void assertEq(int a, int b, string msg = "") {
            if (msg != "") __myp_test_set_msg(msg);
            __myp_assert_eq(a, b);
        }
        void assertNeq(int a, int b, string msg = "") {
            if (msg != "") __myp_test_set_msg(msg);
            __myp_assert_neq(a, b);
        }

        // 长整数相等/不等断言
        void assertLongEq(long a, long b, string msg = "") {
            if (msg != "") __myp_test_set_msg(msg);
            __myp_assert_long_eq(a, b);
        }
        void assertLongNeq(long a, long b) {
            __myp_assert_long_neq(a, b);
        }

        // 浮点相等断言（带容差）
        void assertFloatEq(double a, double b, double eps, string msg = "") {
            double diff = a - b;
            if (diff < 0.0) diff = -diff;
            if (msg != "") __myp_test_set_msg(msg);
            __myp_assert(diff <= eps);
        }
        void assertFloatNeq(double a, double b, double eps) {
            __myp_assert_float_neq(a, b, eps);
        }

        // 字符串相等断言（可带消息）
        void assertStrEq(string a, string b, string msg = "") {
            if (msg != "") __myp_test_set_msg(msg);
            __myp_assert_str_eq(a, b);
        }
        void assertStrNeq(string a, string b) {
            __myp_assert_str_neq(a, b);
        }

        // 空引用断言（泛型：任意 class 引用）
        void assertNull<T>(T p) {
            if (p == null) __myp_assert(true);
            else __myp_assert_null(p);
        }
        void assertNotNull<T>(T p) {
            if (p != null) __myp_assert(true);
            else __myp_assert_not_null(p);
        }

        // ---- 输出捕获（阶段 1）----
        // captureStart 后 Console.*（myp_print*）写入捕获缓冲而非 stdout；
        // captureEnd 停止捕获并返回捕获串。适合校验格式化/叙事型输出。
        void captureStart() {
            __myp_test_capture_start();
        }
        string captureEnd() {
            __myp_test_capture_stop();
            return __myp_test_capture_get();
        }
        // 捕获输出包含 expected 子串（自动停止捕获）
        void assertOutputContains(string expected, string msg = "") {
            __myp_test_capture_stop();
            bool ok = (__myp_test_capture_contains(expected) != 0);
            if (msg != "") __myp_test_set_msg(msg);
            __myp_assert(ok);
        }
        // 捕获输出精确等于 expected
        void assertOutputEq(string expected, string msg = "") {
            __myp_test_capture_stop();
            bool ok = (__myp_test_capture_eq(expected) != 0);
            if (msg != "") __myp_test_set_msg(msg);
            __myp_assert(ok);
        }

        // 强制失败（记录失败并打印消息，不中断后续测试）
        void fail(string msg) {
            __myp_test_fail_msg(msg);
        }

        // 报告测试结果
        void report(string name, bool passed) {
            __myp_test_report(name, passed);
        }
}
