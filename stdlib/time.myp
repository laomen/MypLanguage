// time.myp — MYP 标准库：时间与定时器
//
// 用法：
//   long t = Time.nowMs();
//   Time.sleep(1000);
//   Timer tmr = new Timer("myEvent", 500, 1000);

// ============================================================
// Time — 时间工具（静态类）
// ============================================================
class Time {
    static:
        // 当前系统时间（毫秒）
        long nowMs() {
            return __myp_now_ms();
        }

        // 休眠指定毫秒数
        void sleep(long ms) {
            __myp_sleep_ms(ms);
        }

        // 秒级工具
        long nowSec() { return __myp_now_ms() / 1000L; }
        void sleepSec(long s) { __myp_sleep_ms(s * 1000L); }

        // 毫秒→HMS 格式化（简易）
        string formatHMS(long ms) {
            long totalSec = ms / 1000L;
            long h = totalSec / 3600L;
            long m = (totalSec % 3600L) / 60L;
            long s = totalSec % 60L;
            string result = "";
            if (h < 10L) result = "0";
            result = result + h + ":";
            if (m < 10L) result = result + "0";
            result = result + m + ":";
            if (s < 10L) result = result + "0";
            result = result + s;
            return result;
        }
}


// ============================================================
// Timer — 单次/循环定时器
//   创建后自动注册事件回调。
//   delay_ms: 首次触发延迟
//   interval_ms: 重复间隔（0 表示只触发一次）
// ============================================================
class Timer {
    action:
        @constructor
        Timer(string eventName, long delayMs, long intervalMs) {
            id_ = __myp_timer_create(eventName, delayMs, intervalMs);
        }

        int getId() {
            return id_;
        }

    property:
        int id_;
}
