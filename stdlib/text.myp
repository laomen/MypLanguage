// text.myp — MYP 标准库：文本处理
//
// Str            — 字符串工具函数（静态类）
//   len/s contains/startsWith/endsWith/indexOf
//   substring/replace/toUpper/toLower/trim/split
//
// StringBuilder  — 字符串构建器（动态扩容）
//   将多个字符串片段收集后一次性拼接，减少中间对象。
//
// 用法：
//   Str.contains("hello", "ell");   // true
//   Str.toUpper("hello");           // "HELLO"
//   StringBuilder sb = new StringBuilder();
//   sb.append("Hello"); sb.append(" World");
//   string result = sb.toString();  // "Hello World"

// ---- FFI 声明：C 运行时字符串函数 ----
ffi int myp_strlen(string s);
ffi int myp_str_contains(string s, string sub);
ffi int myp_str_index_of(string s, string sub);
ffi int myp_str_starts_with(string s, string prefix);
ffi int myp_str_ends_with(string s, string suffix);
ffi string myp_str_substring(string s, int start, int end);
ffi string myp_str_replace(string s, string old_str, string new_str);
ffi string myp_str_to_upper(string s);
ffi string myp_str_to_lower(string s);
ffi string myp_str_trim(string s);
ffi int myp_str_split_count(string s, string delim);
ffi string myp_str_split_get(string s, string delim, int index);
ffi string myp_str_repeat(string s, int count);
ffi string myp_str_pad_left(string s, int total_len, int pad_char);
ffi string myp_str_pad_right(string s, int total_len, int pad_char);
ffi int myp_str_to_int(string s);
ffi string myp_str_reverse(string s);
ffi string myp_str_replace_all(string s, string old_str, string new_str);

// ============================================================
// Str — 字符串工具函数（静态类）
// ============================================================
class Str {
    static:
        // 字符串长度
        int len(string s) { return myp_strlen(s); }

        // 是否包含子串
        int contains(string s, string sub) { return myp_str_contains(s, sub); }

        // 子串首次出现位置（-1 表示未找到）
        int indexOf(string s, string sub) { return myp_str_index_of(s, sub); }

        // 是否以指定前缀开头
        int startsWith(string s, string prefix) { return myp_str_starts_with(s, prefix); }

        // 是否以指定后缀结尾
        int endsWith(string s, string suffix) { return myp_str_ends_with(s, suffix); }

        // 截取子串 [start, end)，end 不包含
        string substring(string s, int start, int end) {
            return myp_str_substring(s, start, end);
        }

        // 替换第一个匹配的子串
        string replace(string s, string old_str, string new_str) {
            return myp_str_replace(s, old_str, new_str);
        }

        // 转大写
        string toUpper(string s) { return myp_str_to_upper(s); }

        // 转小写
        string toLower(string s) { return myp_str_to_lower(s); }

        // 去除首尾空白
        string trim(string s) { return myp_str_trim(s); }

        // 按分隔符拆分
        int splitCount(string s, string delim) { return myp_str_split_count(s, delim); }
        string splitGet(string s, string delim, int index) { return myp_str_split_get(s, delim, index); }

        // 解析十进制整数（非数字前缀返回 0）
        int toInt(string s) { return myp_str_to_int(s); }

        // 按分隔符拆分为数组（动态分配，无 1024 上限）
        string[] split(string s, string delim) {
            int n = myp_str_split_count(s, delim);
            string[] parts = new string[n];
            for (int i = 0; i < n; i = i + 1) {
                parts[i] = myp_str_split_get(s, delim, i);
            }
            return parts;
        }

        // 重复字符串 n 次
        string repeat(string s, int n) { return myp_str_repeat(s, n); }

        // 左侧填充空格到指定长度
        string padLeft(string s, int totalLen) { return myp_str_pad_left(s, totalLen, 32); }

        // 右侧填充空格到指定长度
        string padRight(string s, int totalLen) { return myp_str_pad_right(s, totalLen, 32); }

        // 反转字符串
        string reverse(string s) { return myp_str_reverse(s); }

        // 词法比较（-1/0/1，纯 MYP 实现，用于排序）
        int cmp(string a, string b) {
            int la = myp_strlen(a);
            int lb = myp_strlen(b);
            int n = la;
            if (lb < n) n = lb;
            for (int i = 0; i < n; i = i + 1) {
                int ca = __myp_ord(myp_str_substring(a, i, i + 1));
                int cb = __myp_ord(myp_str_substring(b, i, i + 1));
                if (ca < cb) return -1;
                if (ca > cb) return 1;
            }
            if (la < lb) return -1;
            if (la > lb) return 1;
            return 0;
        }

        // 替换所有匹配的子串
        string replaceAll(string s, string oldStr, string newStr) {
            return myp_str_replace_all(s, oldStr, newStr);
        }
}

// ============================================================
// StringBuilder — 字符串构建器（动态扩容）
//   片段存于 string[]（惰性分配，容量翻倍增长），无固定上限。
//   参考 collections.ArrayList 的扩容模式。
// ============================================================
class StringBuilder {
    action:
        @constructor
        StringBuilder() {
            cnt_ = 0;
            cap_ = 0;
        }

        // 追加字符串（容量不足自动翻倍扩容）
        void append(string s) {
            if (data_ == null) { cap_ = 8; data_ = new string[cap_]; }
            if (cnt_ >= cap_) grow();
            data_[cnt_] = s;
            cnt_ = cnt_ + 1;
        }

        // 追加并换行
        void appendLine(string s) {
            append(s + "\n");
        }

        // 清空缓冲区
        void clear() {
            cnt_ = 0;
        }

        // 构建最终字符串（拼接所有片段）
        string toString() {
            string result = "";
            for (int i = 0; i < cnt_; i = i + 1) {
                result = result + data_[i];
            }
            return result;
        }

        int count() {
            return cnt_;
        }

    function:
        // 容量翻倍
        void grow() {
            int nc = cap_ * 2;
            string[] nd = new string[nc];
            for (int i = 0; i < cnt_; i = i + 1) nd[i] = data_[i];
            data_ = nd;
            cap_ = nc;
        }

    property:
        string[] data_;
        int cnt_;
        int cap_;
}
