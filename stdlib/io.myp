// io.myp — MYP 标准库：文件 I/O
// __myp_io_* 是编译器内置函数（intrinsic），仅 stdlib 可用
// 多文件支持：每个 File 持有独立句柄，操作前 select 切换当前文件。
import error;
import text;

// §五-5 P3 异步文件读（worker 线程执行器，跨线程投递结果）
ffi string myp_coro_file_read_line(int handle);
ffi string myp_coro_file_read_all(int handle);

class File {
    action:
        // 打开文件，返回 0 表示成功；失败抛 FileError（op/path）
        int open(string path, string mode) {
            int r = __myp_io_fopen(path, mode);
            if (r != 0) {
                FileError e = new FileError();
                e.setOp("open");
                e.setPath(path);
                throw e;
            }
            handle_ = __myp_io_current_handle();
            return r;
        }
        // 关闭文件
        void close() {
            __myp_io_select(handle_);
            __myp_io_fclose();
            handle_ = 0;
        }
        // 读取一行（不含换行符），返回空字符串表示结束
        string readLine() {
            __myp_io_select(handle_);
            return __myp_io_read_line();
        }
        // 读取整个文件（到 EOF；字节级，保留换行/结尾；无 NUL 限制的文本资产）
        // 注：不能用 __myp_chr(b) 逐字节拼——chr 按码点生成 UTF-8（0x80-0xFF 会
        // 扩展成多字节），破坏字节级 round-trip。改走 C 侧 memcpy 原样读取
        // （与 readAllAsync 同一实现；非协程下同步 fallback）。
        string readAll() {
            return myp_coro_file_read_all(handle_);
        }
        // ---- §五-5 P3 异步文件读（@coro 内 await；worker 线程执行阻塞 IO）----
        // 异步读一行（不含换行符）；EOF 返回空串
        @async string readLineAsync() {
            return myp_coro_file_read_line(handle_);
        }
        // 异步读整个文件（到 EOF）
        @async string readAllAsync() {
            return myp_coro_file_read_all(handle_);
        }
        // 写入文本（不含换行符）
        void write(string text) {
            __myp_io_select(handle_);
            __myp_io_write(text);
        }
        // 写入文本 + 换行
        void writeLine(string text) {
            __myp_io_select(handle_);
            __myp_io_write_line(text);
        }
        // 检查是否还有更多内容（返回 0=无，1=有）
        int hasNext() {
            __myp_io_select(handle_);
            return __myp_io_has_next();
        }
        // 读取一个字节（返回 -1 表示结束）
        int readByte() {
            __myp_io_select(handle_);
            return __myp_io_read_byte();
        }
        // 读取一个 32 位大端整数
        int readI32BE() {
            __myp_io_select(handle_);
            return __myp_io_read_i32be();
        }
        // 读取一个 64 位双精度浮点数
        double readDouble() {
            __myp_io_select(handle_);
            return __myp_io_read_double();
        }
        // 写入一个字节
        int writeByte(int v) {
            __myp_io_select(handle_);
            return __myp_io_write_byte(v);
        }
        // 写入一个 32 位大端整数
        int writeI32BE(int v) {
            __myp_io_select(handle_);
            return __myp_io_write_i32be(v);
        }
        // 写入一个 64 位双精度浮点数
        int writeDouble(double v) {
            __myp_io_select(handle_);
            return __myp_io_write_double(v);
        }
        // 定位到文件位置（whence: 0=SET, 1=CUR, 2=END）
        int seek(int offset, int whence) {
            __myp_io_select(handle_);
            return __myp_io_seek(offset, whence);
        }
    property:
        string path;
        bool isOpen;
        int handle_;
}
