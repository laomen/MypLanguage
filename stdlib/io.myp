// io.myp — MYP 标准库：文件 I/O
// __myp_io_* 是编译器内置函数（intrinsic），仅 stdlib 可用
import error;

class File {
    action:
        // 打开文件，返回 0 表示成功；失败抛 FileError（op/path）
        int open(string path, string mode) {
            int r = __myp_io_fopen(path, mode);
            if (r != 0) {
                FileError e = new FileError();
                e.setOp("open");
                e.setPath(path);
                throw e;
            }
            return r;
        }
        // 关闭文件
        void close() {
            __myp_io_fclose();
        }
        // 读取一行（不含换行符），返回空字符串表示结束
        string readLine() {
            return __myp_io_read_line();
        }
        // 写入文本（不含换行符）
        void write(string text) {
            __myp_io_write(text);
        }
        // 写入文本 + 换行
        void writeLine(string text) {
            __myp_io_write_line(text);
        }
        // 检查是否还有更多内容（返回 0=无，1=有）
        int hasNext() {
            return __myp_io_has_next();
        }
        // 读取一个字节（返回 -1 表示结束）
        int readByte() {
            return __myp_io_read_byte();
        }
        // 读取一个 32 位大端整数
        int readI32BE() {
            return __myp_io_read_i32be();
        }
        // 读取一个 64 位双精度浮点数
        double readDouble() {
            return __myp_io_read_double();
        }
        // 写入一个字节
        int writeByte(int v) {
            return __myp_io_write_byte(v);
        }
        // 写入一个 32 位大端整数
        int writeI32BE(int v) {
            return __myp_io_write_i32be(v);
        }
        // 写入一个 64 位双精度浮点数
        int writeDouble(double v) {
            return __myp_io_write_double(v);
        }
        // 定位到文件位置（whence: 0=SET, 1=CUR, 2=END）
        int seek(int offset, int whence) {
            return __myp_io_seek(offset, whence);
        }
    property:
        string path;
        bool isOpen;
}
