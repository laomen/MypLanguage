// mmap.myp — 内存映射文件（只读，零拷贝）
// ffi 薄包装 runtime_myp/mmap.myp：myp_file_size / myp_mmap_file / myp_munmap_file。
// 可移植：Windows/ARM 由对应 runtime 提供同名符号（本模块不碰 raw syscall）。
import env;

ffi long myp_file_size(string path);
ffi long myp_mmap_file(string path, long size);
ffi long myp_munmap_file(long addr, long size);

class MmapFile {
    action:
        @constructor MmapFile() { base_ = 0; size_ = 0; }

        // 打开并只读映射整个文件。返回 1=成功（失败 base()==0）。
        int open(string path) {
            long sz = myp_file_size(path);
            if (sz <= 0) return 0;
            long b = myp_mmap_file(path, sz);
            if (b <= 0) return 0;
            base_ = b;
            size_ = sz;
            return 1;
        }

        // 解除映射
        void close() {
            if (base_ > 0 && size_ > 0) { myp_munmap_file(base_, size_); }
            base_ = 0;
            size_ = 0;
        }

        long size() { return size_; }
        long base() { return base_; }

        // ---- O(1) 零拷贝读（越界返回 0）----
        int u8(long off) { if (off < 0 || off >= size_) return 0; return __myp_mem_load_i8(base_ + off) & 255; }
        int i32(long off) { if (off < 0 || off + 4 > size_) return 0; return __myp_mem_load_i32(base_ + off); }
        long i64(long off) { if (off < 0 || off + 8 > size_) return 0; return __myp_mem_load_i64(base_ + off); }
        double f64(long off) { if (off < 0 || off + 8 > size_) return 0.0; return __myp_mem_load_double(base_ + off); }

    property:
        long base_;
        long size_;
}
