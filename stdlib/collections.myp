// collections.myp — MYP 标准库：集合类型
//
// ArrayList<T>   — 动态数组（泛型，固定容量 1024）
// HashMap<K,V>   — 哈希表（线性探测，固定容量 1024）

// ============================================================
// ArrayList<T> — 动态数组（惰性分配 + 动态扩容）
//   首次 add 时分配，容量翻倍增长，无 1024 上限。
// ============================================================
class ArrayList<T> {
    action:
        void add(T val) {
            if (data_ == null) { cap_ = 8; data_ = new T[cap_]; }
            if (cnt_ >= cap_) grow();
            data_[cnt_] = val;
            cnt_ = cnt_ + 1;
        }

        T get(int index) {
            return data_[index];
        }

        void set(int index, T val) {
            data_[index] = val;
        }

        int size() {
            return cnt_;
        }

        bool isEmpty() {
            return cnt_ == 0;
        }

        void clear() {
            cnt_ = 0;
        }

    function:
        void grow() {
            int nc = cap_ * 2;
            T[] nd = new T[nc];
            for (int i = 0; i < cnt_; i = i + 1) nd[i] = data_[i];
            data_ = nd;
            cap_ = nc;
        }

    property:
        T[] data_;
        int cnt_;
        int cap_;
}


// ============================================================
// HashMap<K,V> — 哈希表（线性探测法）
//   惰性分配 + 动态扩容（75% 负载因子时翻倍重建）。
//   键必须支持 % 和 == 运算。
// ============================================================
class HashMap<K, V> {
    action:
        void put(K key, V val) {
            if (occupied_ == null) init(16);
            if (cnt_ + 1 > cap_ - cap_ / 4) grow();
            int idx = key % cap_;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) {
                    values_[idx] = val;
                    return;
                }
                idx = (idx + 1) % cap_;
                if (idx == start) {
                    grow();
                    put(key, val);
                    return;
                }
            }
            keys_[idx] = key;
            values_[idx] = val;
            occupied_[idx] = true;
            cnt_ = cnt_ + 1;
        }

        V get(K key, V default_val) {
            if (occupied_ == null) return default_val;
            int idx = key % cap_;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) {
                    return values_[idx];
                }
                idx = (idx + 1) % cap_;
                if (idx == start) return default_val;
            }
            return default_val;
        }

        bool contains(K key) {
            if (occupied_ == null) return false;
            int idx = key % cap_;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) return true;
                idx = (idx + 1) % cap_;
                if (idx == start) return false;
            }
            return false;
        }

        void remove(K key) {
            if (occupied_ == null) return;
            int idx = key % cap_;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) {
                    occupied_[idx] = false;
                    cnt_ = cnt_ - 1;
                    int next = (idx + 1) % cap_;
                    while (occupied_[next]) {
                        K re_key = keys_[next];
                        V re_val = values_[next];
                        occupied_[next] = false;
                        cnt_ = cnt_ - 1;
                        int ri = re_key % cap_;
                        while (occupied_[ri]) {
                            ri = (ri + 1) % cap_;
                        }
                        keys_[ri] = re_key;
                        values_[ri] = re_val;
                        occupied_[ri] = true;
                        cnt_ = cnt_ + 1;
                        next = (next + 1) % cap_;
                    }
                    return;
                }
                idx = (idx + 1) % cap_;
                if (idx == start) return;
            }
        }

        int size() { return cnt_; }
        bool isEmpty() { return cnt_ == 0; }
        void clear() {
            if (occupied_ == null) return;
            cnt_ = 0;
            for (int i = 0; i < cap_; i = i + 1) occupied_[i] = false;
        }

    function:
        void init(int n) {
            cap_ = n;
            cnt_ = 0;
            keys_ = new K[n];
            values_ = new V[n];
            occupied_ = new bool[n];
        }

        void grow() {
            int nc = cap_ * 2;
            K[] nk = new K[nc];
            V[] nv = new V[nc];
            bool[] no = new bool[nc];
            int old = cap_;
            for (int i = 0; i < old; i = i + 1) {
                if (occupied_[i]) {
                    int h = keys_[i] % nc;
                    while (no[h]) h = (h + 1) % nc;
                    nk[h] = keys_[i];
                    nv[h] = values_[i];
                    no[h] = true;
                }
            }
            keys_ = nk;
            values_ = nv;
            occupied_ = no;
            cap_ = nc;
        }

    property:
        K[] keys_;
        V[] values_;
        bool[] occupied_;
        int cnt_;
        int cap_;
}

// ============================================================
// Set<T> — 基于开放寻址哈希表的集合
//   惰性分配 + 动态扩容（75% 负载因子时翻倍重建）。
//   元素必须支持 % 和 == 运算。
// ============================================================
class Set<T> {
    action:
        void add(T val) {
            if (occupied_ == null) init(16);
            if (cnt_ + 1 > cap_ - cap_ / 4) grow();
            int idx = val % cap_;
            int start = idx;
            while (occupied_[idx]) {
                if (data_[idx] == val) return;
                idx = (idx + 1) % cap_;
                if (idx == start) {
                    grow();
                    add(val);
                    return;
                }
            }
            data_[idx] = val;
            occupied_[idx] = true;
            cnt_ = cnt_ + 1;
        }

        bool contains(T val) {
            if (occupied_ == null) return false;
            int idx = val % cap_;
            int start = idx;
            while (occupied_[idx]) {
                if (data_[idx] == val) return true;
                idx = (idx + 1) % cap_;
                if (idx == start) return false;
            }
            return false;
        }

        void remove(T val) {
            if (occupied_ == null) return;
            int idx = val % cap_;
            int start = idx;
            while (occupied_[idx]) {
                if (data_[idx] == val) {
                    occupied_[idx] = false;
                    cnt_ = cnt_ - 1;
                    int next = (idx + 1) % cap_;
                    while (occupied_[next]) {
                        T re_val = data_[next];
                        occupied_[next] = false;
                        cnt_ = cnt_ - 1;
                        int ri = re_val % cap_;
                        while (occupied_[ri]) {
                            ri = (ri + 1) % cap_;
                        }
                        data_[ri] = re_val;
                        occupied_[ri] = true;
                        cnt_ = cnt_ + 1;
                        next = (next + 1) % cap_;
                    }
                    return;
                }
                idx = (idx + 1) % cap_;
                if (idx == start) return;
            }
        }

        int size() { return cnt_; }
        bool isEmpty() { return cnt_ == 0; }
        void clear() {
            if (occupied_ == null) return;
            cnt_ = 0;
            for (int i = 0; i < cap_; i = i + 1) occupied_[i] = false;
        }

    function:
        void init(int n) {
            cap_ = n;
            cnt_ = 0;
            data_ = new T[n];
            occupied_ = new bool[n];
        }

        void grow() {
            int nc = cap_ * 2;
            T[] nd = new T[nc];
            bool[] no = new bool[nc];
            int old = cap_;
            for (int i = 0; i < old; i = i + 1) {
                if (occupied_[i]) {
                    int h = data_[i] % nc;
                    while (no[h]) h = (h + 1) % nc;
                    nd[h] = data_[i];
                    no[h] = true;
                }
            }
            data_ = nd;
            occupied_ = no;
            cap_ = nc;
        }

    property:
        T[] data_;
        bool[] occupied_;
        int cnt_;
        int cap_;
}


// ============================================================
// Deque<T> — 双端队列（循环缓冲区，动态扩容）
//   支持从两端添加/移除元素。
// ============================================================
class Deque<T> {
    action:
        // 从尾部添加
        void pushBack(T val) {
            if (data_ == null) { cap_ = 8; data_ = new T[cap_]; head_ = 0; tail_ = 0; cnt_ = 0; }
            if (cnt_ >= cap_) grow();
            data_[tail_] = val;
            tail_ = (tail_ + 1) % cap_;
            cnt_ = cnt_ + 1;
        }

        // 从头部添加
        void pushFront(T val) {
            if (data_ == null) { cap_ = 8; data_ = new T[cap_]; head_ = 0; tail_ = 0; cnt_ = 0; }
            if (cnt_ >= cap_) grow();
            head_ = (head_ - 1 + cap_) % cap_;
            data_[head_] = val;
            cnt_ = cnt_ + 1;
        }

        // 从头部移除并返回
        T popFront() {
            if (cnt_ <= 0) return data_[0];  // empty
            T val = data_[head_];
            head_ = (head_ + 1) % cap_;
            cnt_ = cnt_ - 1;
            return val;
        }

        // 从尾部移除并返回
        T popBack() {
            if (cnt_ <= 0) return data_[0];  // empty
            tail_ = (tail_ - 1 + cap_) % cap_;
            T val = data_[tail_];
            cnt_ = cnt_ - 1;
            return val;
        }

        // 查看头部元素（不移除）
        T front() { return data_[head_]; }

        // 查看尾部元素（不移除）
        T back() { return data_[(tail_ - 1 + cap_) % cap_]; }

        int size() { return cnt_; }
        bool isEmpty() { return cnt_ == 0; }
        void clear() {
            head_ = 0;
            tail_ = 0;
            cnt_ = 0;
        }

    function:
        void grow() {
            int nc = cap_ * 2;
            T[] nd = new T[nc];
            for (int i = 0; i < cnt_; i = i + 1) nd[i] = data_[(head_ + i) % cap_];
            data_ = nd;
            head_ = 0;
            tail_ = cnt_;
            cap_ = nc;
        }

    property:
        T[] data_;
        int head_;
        int tail_;
        int cnt_;
        int cap_;
}


// ============================================================
// Queue<T> — 先进先出队列（循环缓冲区，动态扩容）
// ============================================================
class Queue<T> {
    action:
        void enqueue(T val) {
            if (data_ == null) { cap_ = 8; data_ = new T[cap_]; head_ = 0; tail_ = 0; cnt_ = 0; }
            if (cnt_ >= cap_) grow();
            data_[tail_] = val;
            tail_ = (tail_ + 1) % cap_;
            cnt_ = cnt_ + 1;
        }

        T dequeue() {
            if (cnt_ <= 0) return data_[0];
            T val = data_[head_];
            head_ = (head_ + 1) % cap_;
            cnt_ = cnt_ - 1;
            return val;
        }

        T peek() { return data_[head_]; }
        int size() { return cnt_; }
        bool isEmpty() { return cnt_ == 0; }
        void clear() {
            head_ = 0;
            tail_ = 0;
            cnt_ = 0;
        }

    function:
        void grow() {
            int nc = cap_ * 2;
            T[] nd = new T[nc];
            for (int i = 0; i < cnt_; i = i + 1) nd[i] = data_[(head_ + i) % cap_];
            data_ = nd;
            head_ = 0;
            tail_ = cnt_;
            cap_ = nc;
        }

    property:
        T[] data_;
        int head_;
        int tail_;
        int cnt_;
        int cap_;
}


// ============================================================
// Stack<T> — 后进先出栈（动态扩容）
// ============================================================
class Stack<T> {
    action:
        void push(T val) {
            if (data_ == null) { cap_ = 8; data_ = new T[cap_]; }
            if (cnt_ >= cap_) grow();
            data_[cnt_] = val;
            cnt_ = cnt_ + 1;
        }

        T pop() {
            if (cnt_ <= 0) return data_[0];
            cnt_ = cnt_ - 1;
            return data_[cnt_];
        }

        T peek() { return data_[cnt_ - 1]; }
        int size() { return cnt_; }
        bool isEmpty() { return cnt_ == 0; }
        void clear() { cnt_ = 0; }

    function:
        void grow() {
            int nc = cap_ * 2;
            T[] nd = new T[nc];
            for (int i = 0; i < cnt_; i = i + 1) nd[i] = data_[i];
            data_ = nd;
            cap_ = nc;
        }

    property:
        T[] data_;
        int cnt_;
        int cap_;
}


// ============================================================
// PriorityQueue<T> — 优先队列（二叉最小堆，动态扩容）
// ============================================================
class PriorityQueue<T> {
    action:
        void push(T val) {
            if (data_ == null) { cap_ = 8; data_ = new T[cap_]; }
            if (cnt_ >= cap_) grow();
            data_[cnt_] = val;
            int i = cnt_;
            cnt_ = cnt_ + 1;
            while (i > 0) {
                int p = (i - 1) / 2;
                if (data_[p] < data_[i]) break;
                T tmp = data_[p]; data_[p] = data_[i]; data_[i] = tmp;
                i = p;
            }
        }

        T pop() {
            if (cnt_ <= 0) return data_[0];
            T result = data_[0];
            cnt_ = cnt_ - 1;
            data_[0] = data_[cnt_];
            int i = 0;
            while (true) {
                int smallest = i;
                int l = 2 * i + 1;
                int r = 2 * i + 2;
                if (l < cnt_ && data_[l] < data_[smallest]) smallest = l;
                if (r < cnt_ && data_[r] < data_[smallest]) smallest = r;
                if (smallest == i) break;
                T tmp = data_[i]; data_[i] = data_[smallest]; data_[smallest] = tmp;
                i = smallest;
            }
            return result;
        }

        T peek() { return data_[0]; }
        int size() { return cnt_; }
        void clear() { cnt_ = 0; }

    function:
        void grow() {
            int nc = cap_ * 2;
            T[] nd = new T[nc];
            for (int i = 0; i < cnt_; i = i + 1) nd[i] = data_[i];
            data_ = nd;
            cap_ = nc;
        }

    property:
        T[] data_;
        int cnt_;
        int cap_;
}


// ============================================================
// LinkedList<T> — 双向链表（惰性节点池 + 动态扩容）
// ============================================================
class LinkedList<T> {
    action:
        void addFirst(T val) {
            ensurePool();
            int idx = free_;
            free_ = next_[free_];
            data_[idx] = val;
            next_[idx] = head_;
            prev_[idx] = -1;
            if (head_ >= 0) prev_[head_] = idx;
            head_ = idx;
            if (tail_ < 0) tail_ = idx;
            cnt_ = cnt_ + 1;
        }

        void addLast(T val) {
            ensurePool();
            int idx = free_;
            free_ = next_[free_];
            data_[idx] = val;
            prev_[idx] = tail_;
            next_[idx] = -1;
            if (tail_ >= 0) next_[tail_] = idx;
            tail_ = idx;
            if (head_ < 0) head_ = idx;
            cnt_ = cnt_ + 1;
        }

        T removeFirst() {
            ensurePool();
            if (cnt_ <= 0) return data_[0];
            T val = data_[head_];
            int old = head_;
            head_ = next_[head_];
            if (head_ >= 0) prev_[head_] = -1;
            else tail_ = -1;
            next_[old] = free_;
            free_ = old;
            cnt_ = cnt_ - 1;
            return val;
        }

        T removeLast() {
            ensurePool();
            if (cnt_ <= 0) return data_[0];
            T val = data_[tail_];
            int old = tail_;
            tail_ = prev_[tail_];
            if (tail_ >= 0) next_[tail_] = -1;
            else head_ = -1;
            next_[old] = free_;
            free_ = old;
            cnt_ = cnt_ - 1;
            return val;
        }

        T getFirst() { ensurePool(); return data_[head_]; }
        T getLast() { ensurePool(); return data_[tail_]; }
        int size() { return cnt_; }
        void clear() {
            head_ = -1; tail_ = -1; cnt_ = 0;
            if (data_ != null) linkFree();
        }

    function:
        void ensurePool() {
            if (data_ == null) {
                pool_ = 8;
                data_ = new T[pool_];
                next_ = new int[pool_];
                prev_ = new int[pool_];
                head_ = -1;
                tail_ = -1;
                cnt_ = 0;
                linkFree();
                return;
            }
            if (free_ < 0) growPool();
        }

        void linkFree() {
            free_ = 0;
            for (int i = 0; i < pool_ - 1; i = i + 1) { next_[i] = i + 1; prev_[i] = -1; }
            next_[pool_ - 1] = -1;
            prev_[pool_ - 1] = -1;
        }

        void growPool() {
            int np = pool_ * 2;
            T[] nd = new T[np];
            int[] nn = new int[np];
            int[] nv = new int[np];
            for (int i = 0; i < pool_; i = i + 1) { nd[i] = data_[i]; nn[i] = next_[i]; nv[i] = prev_[i]; }
            data_ = nd;
            next_ = nn;
            prev_ = nv;
            int old = pool_;
            pool_ = np;
            for (int i = old; i < np - 1; i = i + 1) { next_[i] = i + 1; prev_[i] = -1; }
            next_[np - 1] = -1;
            prev_[np - 1] = -1;
            if (free_ < 0) {
                free_ = old;
            } else {
                int f = free_;
                while (next_[f] >= 0) f = next_[f];
                next_[f] = old;
            }
        }

    property:
        T[] data_;
        int[] next_;
        int[] prev_;
        int head_;
        int tail_;
        int cnt_;
        int free_;
        int pool_;
}


// ============================================================
// Sort — 排序与搜索算法（静态类）
// ============================================================
class Sort {
    static:
        void bubbleSort(int[] arr, int n) {
            for (int i = 0; i < n - 1; i = i + 1) {
                for (int j = 0; j < n - 1 - i; j = j + 1) {
                    if (arr[j] > arr[j + 1]) {
                        int tmp = arr[j]; arr[j] = arr[j + 1]; arr[j + 1] = tmp;
                    }
                }
            }
        }

        void selectionSort(int[] arr, int n) {
            for (int i = 0; i < n - 1; i = i + 1) {
                int minIdx = i;
                for (int j = i + 1; j < n; j = j + 1) {
                    if (arr[j] < arr[minIdx]) minIdx = j;
                }
                if (minIdx != i) {
                    int tmp = arr[i]; arr[i] = arr[minIdx]; arr[minIdx] = tmp;
                }
            }
        }

        int binarySearch(int[] arr, int n, int val) {
            int lo = 0;
            int hi = n - 1;
            while (lo <= hi) {
                int mid = lo + (hi - lo) / 2;
                if (arr[mid] == val) return mid;
                if (arr[mid] < val) lo = mid + 1;
                else hi = mid - 1;
            }
            return -1;
        }

        int linearSearch(int[] arr, int n, int val) {
            for (int i = 0; i < n; i = i + 1) {
                if (arr[i] == val) return i;
            }
            return -1;
        }

        int max(int[] arr, int n) {
            if (n <= 0) return 0;
            int v = arr[0];
            for (int i = 1; i < n; i = i + 1) {
                if (arr[i] > v) v = arr[i];
            }
            return v;
        }

        int min(int[] arr, int n) {
            if (n <= 0) return 0;
            int v = arr[0];
            for (int i = 1; i < n; i = i + 1) {
                if (arr[i] < v) v = arr[i];
            }
            return v;
        }

        void reverse(int[] arr, int n) {
            for (int i = 0; i < n / 2; i = i + 1) {
                int j = n - 1 - i;
                int tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
            }
        }
}


// ============================================================
// StrHashMap<V> — 字符串键哈希表（开放寻址，动态扩容）
//   使用 C 运行时的 DJB2 哈希函数。75% 负载因子时翻倍重建。
// ============================================================
ffi int myp_str_hash(string s);

class StrHashMap<V> {
    action:
        void put(string key, V val) {
            if (occupied_ == null) init(16);
            if (cnt_ + 1 > cap_ - cap_ / 4) grow();
            int h = myp_str_hash(key);
            int idx = h % cap_;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) {
                    values_[idx] = val;
                    return;
                }
                idx = (idx + 1) % cap_;
                if (idx == start) {
                    grow();
                    put(key, val);
                    return;
                }
            }
            keys_[idx] = key;
            values_[idx] = val;
            occupied_[idx] = true;
            cnt_ = cnt_ + 1;
        }

        V get(string key, V default_val) {
            if (occupied_ == null) return default_val;
            int h = myp_str_hash(key);
            int idx = h % cap_;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) {
                    return values_[idx];
                }
                idx = (idx + 1) % cap_;
                if (idx == start) return default_val;
            }
            return default_val;
        }

        int contains(string key) {
            if (occupied_ == null) return 0;
            int h = myp_str_hash(key);
            int idx = h % cap_;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) return 1;
                idx = (idx + 1) % cap_;
                if (idx == start) return 0;
            }
            return 0;
        }

        void remove(string key) {
            if (occupied_ == null) return;
            int h = myp_str_hash(key);
            int idx = h % cap_;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) {
                    occupied_[idx] = false;
                    cnt_ = cnt_ - 1;
                    int next = (idx + 1) % cap_;
                    while (occupied_[next]) {
                        string re_key = keys_[next];
                        V re_val = values_[next];
                        occupied_[next] = false;
                        cnt_ = cnt_ - 1;
                        int rh = myp_str_hash(re_key);
                        int ri = rh % cap_;
                        while (occupied_[ri]) {
                            ri = (ri + 1) % cap_;
                        }
                        keys_[ri] = re_key;
                        values_[ri] = re_val;
                        occupied_[ri] = true;
                        cnt_ = cnt_ + 1;
                        next = (next + 1) % cap_;
                    }
                    return;
                }
                idx = (idx + 1) % cap_;
                if (idx == start) return;
            }
        }

        int size() { return cnt_; }
        bool isEmpty() { return cnt_ == 0; }
        void clear() {
            if (occupied_ == null) return;
            cnt_ = 0;
            for (int i = 0; i < cap_; i = i + 1) occupied_[i] = false;
        }

    function:
        void init(int n) {
            cap_ = n;
            cnt_ = 0;
            keys_ = new string[n];
            values_ = new V[n];
            occupied_ = new bool[n];
        }

        void grow() {
            int nc = cap_ * 2;
            string[] nk = new string[nc];
            V[] nv = new V[nc];
            bool[] no = new bool[nc];
            int old = cap_;
            for (int i = 0; i < old; i = i + 1) {
                if (occupied_[i]) {
                    int h = myp_str_hash(keys_[i]) % nc;
                    while (no[h]) h = (h + 1) % nc;
                    nk[h] = keys_[i];
                    nv[h] = values_[i];
                    no[h] = true;
                }
            }
            keys_ = nk;
            values_ = nv;
            occupied_ = no;
            cap_ = nc;
        }

    property:
        string[] keys_;
        V[] values_;
        bool[] occupied_;
        int cnt_;
        int cap_;
}
