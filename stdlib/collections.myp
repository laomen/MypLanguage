// collections.myp — MYP 标准库：集合类型
//
// ArrayList<T>   — 动态数组（泛型，固定容量 1024）
// HashMap<K,V>   — 哈希表（线性探测，固定容量 1024）

// ============================================================
// ArrayList<T> — 动态数组
// ============================================================
class ArrayList<T> {
    action:
        @startup void init() {
            cnt_ = 0;
        }

        void add(T val) {
            data_[cnt_] = val;
            cnt_ = cnt_ + 1;
        }

        T get(int index) {
            return data_[index];
        }

        void set(int index, T val) {
            data_[index] = val;
        }

        int size() {
            return cnt_;
        }

        bool isEmpty() {
            return cnt_ == 0;
        }

        void clear() {
            cnt_ = 0;
        }

    property:
        T[1024] data_;
        int cnt_;
}


// ============================================================
// HashMap<K,V> — 哈希表（线性探测法）
//   固定容量 1024。键必须支持 % 和 == 运算。
// ============================================================
class HashMap<K, V> {
    action:
        @startup void init() {
            cnt_ = 0;
            for (int i = 0; i < 1024; i = i + 1) {
                occupied_[i] = false;
            }
        }

        void put(K key, V val) {
            int idx = key % 1024;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) {
                    values_[idx] = val;
                    return;
                }
                idx = (idx + 1) % 1024;
                if (idx == start) return;
            }
            keys_[idx] = key;
            values_[idx] = val;
            occupied_[idx] = true;
            cnt_ = cnt_ + 1;
        }

        V get(K key, V default_val) {
            int idx = key % 1024;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) {
                    return values_[idx];
                }
                idx = (idx + 1) % 1024;
                if (idx == start) return default_val;
            }
            return default_val;
        }

        bool contains(K key) {
            int idx = key % 1024;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) return true;
                idx = (idx + 1) % 1024;
                if (idx == start) return false;
            }
            return false;
        }

        void remove(K key) {
            int idx = key % 1024;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) {
                    occupied_[idx] = false;
                    cnt_ = cnt_ - 1;
                    int next = (idx + 1) % 1024;
                    while (occupied_[next]) {
                        K re_key = keys_[next];
                        V re_val = values_[next];
                        occupied_[next] = false;
                        cnt_ = cnt_ - 1;
                        int ri = re_key % 1024;
                        while (occupied_[ri]) {
                            ri = (ri + 1) % 1024;
                        }
                        keys_[ri] = re_key;
                        values_[ri] = re_val;
                        occupied_[ri] = true;
                        cnt_ = cnt_ + 1;
                        next = (next + 1) % 1024;
                    }
                    return;
                }
                idx = (idx + 1) % 1024;
                if (idx == start) return;
            }
        }

        int size() { return cnt_; }
        bool isEmpty() { return cnt_ == 0; }
        void clear() {
            cnt_ = 0;
            for (int i = 0; i < 1024; i = i + 1) {
                occupied_[i] = false;
            }
        }

    property:
        K[1024] keys_;
        V[1024] values_;
        bool[1024] occupied_;
        int cnt_;
}

// ============================================================
// Set<T> — 基于开放寻址哈希表的集合
//   固定容量 1024。元素必须支持 % 和 == 运算。
// ============================================================
class Set<T> {
    action:
        @startup void init() {
            cnt_ = 0;
            for (int i = 0; i < 1024; i = i + 1) {
                occupied_[i] = false;
            }
        }

        void add(T val) {
            int idx = val % 1024;
            int start = idx;
            while (occupied_[idx]) {
                if (data_[idx] == val) return;
                idx = (idx + 1) % 1024;
                if (idx == start) return;
            }
            data_[idx] = val;
            occupied_[idx] = true;
            cnt_ = cnt_ + 1;
        }

        bool contains(T val) {
            int idx = val % 1024;
            int start = idx;
            while (occupied_[idx]) {
                if (data_[idx] == val) return true;
                idx = (idx + 1) % 1024;
                if (idx == start) return false;
            }
            return false;
        }

        void remove(T val) {
            int idx = val % 1024;
            int start = idx;
            while (occupied_[idx]) {
                if (data_[idx] == val) {
                    occupied_[idx] = false;
                    cnt_ = cnt_ - 1;
                    int next = (idx + 1) % 1024;
                    while (occupied_[next]) {
                        T re_val = data_[next];
                        occupied_[next] = false;
                        cnt_ = cnt_ - 1;
                        int ri = re_val % 1024;
                        while (occupied_[ri]) {
                            ri = (ri + 1) % 1024;
                        }
                        data_[ri] = re_val;
                        occupied_[ri] = true;
                        cnt_ = cnt_ + 1;
                        next = (next + 1) % 1024;
                    }
                    return;
                }
                idx = (idx + 1) % 1024;
                if (idx == start) return;
            }
        }

        int size() { return cnt_; }
        bool isEmpty() { return cnt_ == 0; }
        void clear() {
            cnt_ = 0;
            for (int i = 0; i < 1024; i = i + 1) {
                occupied_[i] = false;
            }
        }

    property:
        T[1024] data_;
        bool[1024] occupied_;
        int cnt_;
}


// ============================================================
// Deque<T> — 双端队列（循环缓冲区，固定容量 1024）
//   支持从两端添加/移除元素。
// ============================================================
class Deque<T> {
    action:
        @startup void init() {
            head_ = 0;
            tail_ = 0;
            cnt_ = 0;
        }

        // 从尾部添加
        void pushBack(T val) {
            if (cnt_ >= 1024) return;
            data_[tail_] = val;
            tail_ = (tail_ + 1) % 1024;
            cnt_ = cnt_ + 1;
        }

        // 从头部添加
        void pushFront(T val) {
            if (cnt_ >= 1024) return;
            head_ = (head_ - 1 + 1024) % 1024;
            data_[head_] = val;
            cnt_ = cnt_ + 1;
        }

        // 从头部移除并返回
        T popFront() {
            if (cnt_ <= 0) return data_[0];  // empty
            T val = data_[head_];
            head_ = (head_ + 1) % 1024;
            cnt_ = cnt_ - 1;
            return val;
        }

        // 从尾部移除并返回
        T popBack() {
            if (cnt_ <= 0) return data_[0];  // empty
            tail_ = (tail_ - 1 + 1024) % 1024;
            T val = data_[tail_];
            cnt_ = cnt_ - 1;
            return val;
        }

        // 查看头部元素（不移除）
        T front() { return data_[head_]; }

        // 查看尾部元素（不移除）
        T back() { return data_[(tail_ - 1 + 1024) % 1024]; }

        int size() { return cnt_; }
        bool isEmpty() { return cnt_ == 0; }
        void clear() {
            head_ = 0;
            tail_ = 0;
            cnt_ = 0;
        }

    property:
        T[1024] data_;
        int head_;
        int tail_;
        int cnt_;
}


// ============================================================
// Queue<T> — 先进先出队列（循环缓冲区，固定容量 1024）
// ============================================================
class Queue<T> {
    action:
        @startup void init() {
            head_ = 0;
            tail_ = 0;
            cnt_ = 0;
        }

        void enqueue(T val) {
            if (cnt_ >= 1024) return;
            data_[tail_] = val;
            tail_ = (tail_ + 1) % 1024;
            cnt_ = cnt_ + 1;
        }

        T dequeue() {
            if (cnt_ <= 0) return data_[0];
            T val = data_[head_];
            head_ = (head_ + 1) % 1024;
            cnt_ = cnt_ - 1;
            return val;
        }

        T peek() { return data_[head_]; }
        int size() { return cnt_; }
        bool isEmpty() { return cnt_ == 0; }
        void clear() {
            head_ = 0;
            tail_ = 0;
            cnt_ = 0;
        }

    property:
        T[1024] data_;
        int head_;
        int tail_;
        int cnt_;
}


// ============================================================
// Stack<T> — 后进先出栈（固定容量 1024）
// ============================================================
class Stack<T> {
    action:
        @startup void init() {
            cnt_ = 0;
        }

        void push(T val) {
            if (cnt_ >= 1024) return;
            data_[cnt_] = val;
            cnt_ = cnt_ + 1;
        }

        T pop() {
            if (cnt_ <= 0) return data_[0];
            cnt_ = cnt_ - 1;
            return data_[cnt_];
        }

        T peek() { return data_[cnt_ - 1]; }
        int size() { return cnt_; }
        bool isEmpty() { return cnt_ == 0; }
        void clear() { cnt_ = 0; }

    property:
        T[1024] data_;
        int cnt_;
}


// ============================================================
// PriorityQueue<T> — 优先队列（二叉最小堆，固定容量 1024）
// ============================================================
class PriorityQueue<T> {
    action:
        @startup void init() {
            cnt_ = 0;
        }

        void push(T val) {
            if (cnt_ >= 1024) return;
            data_[cnt_] = val;
            int i = cnt_;
            cnt_ = cnt_ + 1;
            while (i > 0) {
                int p = (i - 1) / 2;
                if (data_[p] < data_[i]) break;
                T tmp = data_[p]; data_[p] = data_[i]; data_[i] = tmp;
                i = p;
            }
        }

        T pop() {
            if (cnt_ <= 0) return data_[0];
            T result = data_[0];
            cnt_ = cnt_ - 1;
            data_[0] = data_[cnt_];
            int i = 0;
            while (true) {
                int smallest = i;
                int l = 2 * i + 1;
                int r = 2 * i + 2;
                if (l < cnt_ && data_[l] < data_[smallest]) smallest = l;
                if (r < cnt_ && data_[r] < data_[smallest]) smallest = r;
                if (smallest == i) break;
                T tmp = data_[i]; data_[i] = data_[smallest]; data_[smallest] = tmp;
                i = smallest;
            }
            return result;
        }

        T peek() { return data_[0]; }
        int size() { return cnt_; }
        void clear() { cnt_ = 0; }

    property:
        T[1024] data_;
        int cnt_;
}


// ============================================================
// LinkedList<T> — 双向链表（固定节点池 256）
// ============================================================
class LinkedList<T> {
    action:
        @startup void init() {
            head_ = -1;
            tail_ = -1;
            cnt_ = 0;
            free_ = 0;
            for (int i = 0; i < 255; i = i + 1) {
                next_[i] = i + 1;
                prev_[i] = -1;
            }
            next_[255] = -1;
            prev_[255] = -1;
        }

        void addFirst(T val) {
            if (free_ < 0) return;
            int idx = free_;
            free_ = next_[free_];
            data_[idx] = val;
            next_[idx] = head_;
            prev_[idx] = -1;
            if (head_ >= 0) prev_[head_] = idx;
            head_ = idx;
            if (tail_ < 0) tail_ = idx;
            cnt_ = cnt_ + 1;
        }

        void addLast(T val) {
            if (free_ < 0) return;
            int idx = free_;
            free_ = next_[free_];
            data_[idx] = val;
            prev_[idx] = tail_;
            next_[idx] = -1;
            if (tail_ >= 0) next_[tail_] = idx;
            tail_ = idx;
            if (head_ < 0) head_ = idx;
            cnt_ = cnt_ + 1;
        }

        T removeFirst() {
            if (cnt_ <= 0) return data_[0];
            T val = data_[head_];
            int old = head_;
            head_ = next_[head_];
            if (head_ >= 0) prev_[head_] = -1;
            else tail_ = -1;
            next_[old] = free_;
            free_ = old;
            cnt_ = cnt_ - 1;
            return val;
        }

        T removeLast() {
            if (cnt_ <= 0) return data_[0];
            T val = data_[tail_];
            int old = tail_;
            tail_ = prev_[tail_];
            if (tail_ >= 0) next_[tail_] = -1;
            else head_ = -1;
            next_[old] = free_;
            free_ = old;
            cnt_ = cnt_ - 1;
            return val;
        }

        T getFirst() { return data_[head_]; }
        T getLast() { return data_[tail_]; }
        int size() { return cnt_; }
        void clear() {
            head_ = -1; tail_ = -1; cnt_ = 0; free_ = 0;
            for (int i = 0; i < 255; i = i + 1) { next_[i] = i + 1; prev_[i] = -1; }
            next_[255] = -1; prev_[255] = -1;
        }

    function:

    property:
        T[256] data_;
        int[256] next_;
        int[256] prev_;
        int head_;
        int tail_;
        int cnt_;
        int free_;
}


// ============================================================
// Sort — 排序与搜索算法（静态类）
// ============================================================
class Sort {
    static:
        void bubbleSort(int[] arr, int n) {
            for (int i = 0; i < n - 1; i = i + 1) {
                for (int j = 0; j < n - 1 - i; j = j + 1) {
                    if (arr[j] > arr[j + 1]) {
                        int tmp = arr[j]; arr[j] = arr[j + 1]; arr[j + 1] = tmp;
                    }
                }
            }
        }

        void selectionSort(int[] arr, int n) {
            for (int i = 0; i < n - 1; i = i + 1) {
                int minIdx = i;
                for (int j = i + 1; j < n; j = j + 1) {
                    if (arr[j] < arr[minIdx]) minIdx = j;
                }
                if (minIdx != i) {
                    int tmp = arr[i]; arr[i] = arr[minIdx]; arr[minIdx] = tmp;
                }
            }
        }

        int binarySearch(int[] arr, int n, int val) {
            int lo = 0;
            int hi = n - 1;
            while (lo <= hi) {
                int mid = lo + (hi - lo) / 2;
                if (arr[mid] == val) return mid;
                if (arr[mid] < val) lo = mid + 1;
                else hi = mid - 1;
            }
            return -1;
        }

        int linearSearch(int[] arr, int n, int val) {
            for (int i = 0; i < n; i = i + 1) {
                if (arr[i] == val) return i;
            }
            return -1;
        }

        int max(int[] arr, int n) {
            if (n <= 0) return 0;
            int v = arr[0];
            for (int i = 1; i < n; i = i + 1) {
                if (arr[i] > v) v = arr[i];
            }
            return v;
        }

        int min(int[] arr, int n) {
            if (n <= 0) return 0;
            int v = arr[0];
            for (int i = 1; i < n; i = i + 1) {
                if (arr[i] < v) v = arr[i];
            }
            return v;
        }

        void reverse(int[] arr, int n) {
            for (int i = 0; i < n / 2; i = i + 1) {
                int j = n - 1 - i;
                int tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
            }
        }
}


// ============================================================
// StrHashMap<V> — 字符串键哈希表（开放寻址，固定容量 1024）
//   使用 C 运行时的 DJB2 哈希函数。
// ============================================================
ffi int myp_str_hash(string s);

class StrHashMap<V> {
    action:
        @startup void init() {
            cnt_ = 0;
            for (int i = 0; i < 1024; i = i + 1) {
                occupied_[i] = false;
            }
        }

        void put(string key, V val) {
            int h = myp_str_hash(key);
            int idx = h % 1024;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) {
                    values_[idx] = val;
                    return;
                }
                idx = (idx + 1) % 1024;
                if (idx == start) return;
            }
            keys_[idx] = key;
            values_[idx] = val;
            occupied_[idx] = true;
            cnt_ = cnt_ + 1;
        }

        V get(string key, V default_val) {
            int h = myp_str_hash(key);
            int idx = h % 1024;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) {
                    return values_[idx];
                }
                idx = (idx + 1) % 1024;
                if (idx == start) return default_val;
            }
            return default_val;
        }

        int contains(string key) {
            int h = myp_str_hash(key);
            int idx = h % 1024;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) return 1;
                idx = (idx + 1) % 1024;
                if (idx == start) return 0;
            }
            return 0;
        }

        void remove(string key) {
            int h = myp_str_hash(key);
            int idx = h % 1024;
            int start = idx;
            while (occupied_[idx]) {
                if (keys_[idx] == key) {
                    occupied_[idx] = false;
                    cnt_ = cnt_ - 1;
                    int next = (idx + 1) % 1024;
                    while (occupied_[next]) {
                        string re_key = keys_[next];
                        V re_val = values_[next];
                        occupied_[next] = false;
                        cnt_ = cnt_ - 1;
                        int rh = myp_str_hash(re_key);
                        int ri = rh % 1024;
                        while (occupied_[ri]) {
                            ri = (ri + 1) % 1024;
                        }
                        keys_[ri] = re_key;
                        values_[ri] = re_val;
                        occupied_[ri] = true;
                        cnt_ = cnt_ + 1;
                        next = (next + 1) % 1024;
                    }
                    return;
                }
                idx = (idx + 1) % 1024;
                if (idx == start) return;
            }
        }

        int size() { return cnt_; }
        bool isEmpty() { return cnt_ == 0; }
        void clear() {
            cnt_ = 0;
            for (int i = 0; i < 1024; i = i + 1) {
                occupied_[i] = false;
            }
        }

    property:
        string[1024] keys_;
        V[1024] values_;
        bool[1024] occupied_;
        int cnt_;
}
