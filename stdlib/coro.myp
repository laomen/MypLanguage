// coro.myp — MYP 协程底层原语（基于 ucontext 用户态纤程）
// 语言层使用 @coro 方法 + await；这些 FFI 由编译器生成的代码调用。
//
// 用法（语言层，编译器自动生成 spawn）：
//   class Worker {
//       action:
//           @coro void run() {
//               Console.writeString("w1\n");
//               await;
//               Console.writeString("w2\n");
//           }
//   }
//   Worker w = new Worker();
//   int h = w.run();              // @coro 调用 → 创建并首启，返回 handle
//   __myp_coro_resume(h);         // 手动恢复

ffi long  __myp_coro_create();
ffi void  __myp_coro_set_entry(long handle, long fn_ptr);
ffi long  __myp_coro_yield(long val);              // 挂起并传出 val；恢复时返回传入值
ffi long  __myp_coro_resume(long handle, long val); // 恢复并传入 val；返回协程传出值
ffi long  __myp_coro_is_active(long handle);
ffi void  __myp_coro_destroy(long handle);
ffi void  __myp_coro_set_entry_arg(long idx, long val);
ffi long  __myp_coro_get_entry_arg(long idx);
ffi void  __myp_coro_set_result(long val);          // @coro 方法 return 存返回值
ffi long  __myp_coro_result(long handle);           // 取协程返回值
ffi void  __myp_coro_scheduler();                   // 自动调度：跑所有就绪协程各一步（C3）
ffi long  __myp_coro_wait_event(long event_id, long val); // 等待事件（C4，await event 展开）
