// coro.myp — MYP 协程（基于 ucontext 用户态纤程）
// 语言层使用 @coro 方法 + await；用户通过静态类 Coro 调用调度/生命周期原语。
// Coro 的方法是编译器内建（built-in）：方法体为空，codegen 直接生成底层调用，
// 因此 __myp_coro_* 完全不暴露给用户（符号未注册，调用即 undefined）。
//
// 用法（语言层，编译器自动生成 spawn）：
//   class Worker {
//       action:
//           @coro void run() {
//               Console.writeString("w1\n");
//               await;                    // 挂起
//               Console.writeString("w2\n");
//           }
//   }
//   Worker w = new Worker();
//   long h = w.run();                     // @coro 调用 → 创建并首启，返回 handle
//   Coro.resume(h, 0);                    // 手动恢复
//   Coro.scheduler();                     // 自动调度：所有就绪协程各一步

// 协程静态类：用户可见 API（方法体由编译器内建生成）
class Coro {
    static:
        // 自动调度：处理事件后对每个就绪协程 resume 一步（C3）
        void scheduler() {}
        // 挂起当前协程 ms 毫秒（§五-5 P1 定时器；不阻塞线程，非协程上下文退化为同步）
        long sleep(long ms) {}
        // 手动恢复协程并传入值；返回协程挂起时传出的值（结束则 0，无效 -1）
        long resume(long handle, long val) {}
        // 挂起当前协程并传出值；恢复时返回传入值（等价于 await 表达式）
        long yield(long val) {}
        // 协程是否仍活跃
        long isActive(long handle) {}
        // 当前正在执行的协程 handle（不在协程内返回 -1）
        long current() {}
        // 当前线程活跃（未结束）协程数
        long count() {}
        // 协程状态：-1 无效, 0 未活跃/结束, 1 就绪/运行, 2 等待事件
        long status(long handle) {}
        // 提前取消协程
        void destroy(long handle) {}
        // 取协程返回值（@coro 方法 return 存入）
        long result(long handle) {}
        // 等待事件（等价于 await ClassName.eventName 语法）
        long waitEvent(long eventId, long val) {}
        // 等待事件带超时（毫秒）：事件到达返回 resume 传入值，超时返回 -1
        long waitEventTimeout(long eventId, long timeoutMs, long val) {}
        // 等待任一事件触发：返回触发的事件 id，超时返回 -1
        // ids 为事件 id 数组（MYP 数组无长度跟踪，需显式传 count）
        long waitAny(long[] ids, long count, long timeoutMs, long val) {}
        // 协作式取消：请求协程在下一个 await/yield 后自行退出（可执行清理）
        // 与 destroy（强杀、不执行清理）不同
        void requestCancel(long handle) {}
        // 当前协程是否被请求取消（协程内检查；返回 1/0）
        long cancelRequested() {}
        // 清除当前协程的取消请求（处理后调用）
        void clearCancel() {}
}
