// env.myp — MYP 标准库：基本 I/O + 环境变量（静态类）
// __myp_* 是编译器内置函数（intrinsic），仅 stdlib 可用

// FFI 声明：环境变量
ffi string myp_env_get(string name);
ffi int myp_env_set(string name, string value);
ffi int myp_env_unset(string name);

class Console {
    static:
        void write(int v) {
            __myp_print_int(v);
        }
        void writeString(string s) {
            __myp_print(s);
        }
        void writeLine(string s) {
            __myp_println(s);
        }
        void writeLong(long v) {
            __myp_print_long(v);
        }
        void writeFloat(double v) {
            __myp_print_float(v);
            __myp_print("\n");
        }
        void writeBool(bool v) {
            __myp_print_bool(v);
            __myp_print("\n");
        }
        // Read a line of text from stdin
        string readString() {
            return __myp_read_line();
        }
        // Check if a key is available (non-blocking). Returns 1 if yes, 0 if no.
        int kbhit() {
            return __myp_kbhit();
        }
        // Read one character code (non-blocking, raw mode). Returns 0 if no key.
        int getch() {
            return __myp_getch();
        }
        // Flush stdout to ensure all buffered output appears
        void flush() {
            __myp_flush();
        }

        // ___ 环境变量 ___

        // 获取环境变量值（不存在返回空字符串）
        string getEnv(string name) {
            return myp_env_get(name);
        }

        // 设置环境变量（返回 0 成功）
        int setEnv(string name, string value) {
            return myp_env_set(name, value);
        }

        // 删除环境变量（返回 0 成功）
        int unsetEnv(string name) {
            return myp_env_unset(name);
        }
}

