// env.myp — MYP 标准库：基本 I/O（静态类）
// __myp_* 是编译器内置函数（intrinsic），仅 stdlib 可用

class Console {
    static:
        void write(int v) {
            __myp_print_int(v);
        }
        void writeString(string s) {
            __myp_print(s);
        }
        void writeLine(string s) {
            __myp_println(s);
        }
        void writeLong(long v) {
            __myp_print_long(v);
        }
        void writeFloat(double v) {
            __myp_print_float(v);
            __myp_print("\n");
        }
        void writeBool(bool v) {
            __myp_print_bool(v);
            __myp_print("\n");
        }
        // Read a line of text from stdin
        string readString() {
            return __myp_read_line();
        }
        // Check if a key is available (non-blocking). Returns 1 if yes, 0 if no.
        int kbhit() {
            return __myp_kbhit();
        }
        // Read one character code (non-blocking, raw mode). Returns 0 if no key.
        int getch() {
            return __myp_getch();
        }
        // Flush stdout to ensure all buffered output appears
        void flush() {
            __myp_flush();
        }
}

