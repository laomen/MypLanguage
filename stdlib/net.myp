// net.myp — MYP 标准库：TCP 网络通讯
//
// 用法：
//   // --- 服务器 ---
//   TcpServer server = new TcpServer(8080);
//   TcpClient client = new TcpClient();
//   int ret = server.accept(client);
//   string data = client.recvLine();
//   client.send("Hello!\n");
//   client.close();
//
//   // --- 客户端 ---
//   TcpClient c = new TcpClient();
//   int ret = c.connect("example.com", 80);
//   c.send("GET / HTTP/1.0\nHost: example.com\n\n");
//   string resp = c.recv(4096);
//   c.close();

import env;
import text;
import error;
import coro;    // §五-5 P2: Coro.waitFd（异步 socket 就绪等待）

// FFI 声明
ffi int myp_net_server(int port);
ffi int myp_net_accept(int server_fd);
ffi int myp_net_connect(string host, int port);
ffi int myp_net_send(int fd, string data);
ffi string myp_net_recv(int fd, int max_len);
ffi string myp_net_recv_line(int fd);
ffi void myp_net_close(int fd);
ffi void myp_net_set_nonblock(int fd);   // §五-5 P2

// ============================================================
// TcpServer — TCP 服务器
// ============================================================
class TcpServer {
    action:
        @constructor
        TcpServer(int port) {
            fd_ = myp_net_server(port);
        }

        // 接受客户端连接（阻塞，结果存入 client）
        int accept(TcpClient client) {
            int client_fd = myp_net_accept(fd_);
            client.setFd(client_fd);
            return client_fd >= 0 ? 0 : -1;
        }

        int getFd() { return fd_; }

        void close() {
            if (fd_ >= 0) {
                myp_net_close(fd_);
                fd_ = -1;
            }
        }

    property:
        int fd_;
}


// ============================================================
// TcpClient — TCP 客户端
// ============================================================
class TcpClient {
    action:
        @constructor
        TcpClient() {
            fd_ = -1;
        }

        // 连接到服务器，成功返回 0；失败抛 NetError（op/host/port）
        int connect(string host, int port) {
            fd_ = myp_net_connect(host, port);
            if (fd_ < 0) {
                NetError e = new NetError();
                e.setOp("connect");
                e.setHost(host);
                e.setPort(port);
                throw e;
            }
            return 0;
        }

        // 设置 fd（由 TcpServer.accept 调用）
        void setFd(int fd) {
            fd_ = fd;
        }

        // 发送字符串
        int send(string data) {
            return myp_net_send(fd_, data);
        }

        // 发送字符串 + 换行
        int sendLine(string data) {
            return myp_net_send(fd_, data + "\n");
        }

        // 接收最多 maxLen 字节
        string recv(int maxLen) {
            return myp_net_recv(fd_, maxLen);
        }

        // 接收一行（直到 \n，不含换行符）
        string recvLine() {
            return myp_net_recv_line(fd_);
        }

        // ---- §五-5 P2 异步 IO（@coro 内 await）----
        // 异步接收最多 maxLen 字节：fd 可读后非阻塞读；超时（ms>0）返回空串
        @async string recvAsync(int maxLen, long timeout = 0) {
            myp_net_set_nonblock(fd_);
            long r = Coro.waitFd(fd_, 1, 0, timeout);
            if (r == -1) return "";
            return myp_net_recv(fd_, maxLen);
        }

        // 异步接收一行（直到 \n）：逐字节非阻塞读；超时返回已收内容
        @async string recvLineAsync(long timeout = 0) {
            myp_net_set_nonblock(fd_);
            StringBuilder sb = new StringBuilder();
            while (true) {
                long r = Coro.waitFd(fd_, 1, 0, timeout);
                if (r == -1) return sb.toString();
                string ch = myp_net_recv(fd_, 1);
                if (Str.len(ch) == 0) break;            // EOF / 连接关闭
                int code = __myp_ord(ch);
                if (code == 10) break;                   // \n
                if (code != 13) sb.append(ch);           // 跳过 \r
            }
            return sb.toString();
        }

        // 异步发送整串：fd 可写后发送（非阻塞可能部分发送 → 循环补发）；超时返回已发字节
        @async int sendAsync(string data, long timeout = 0) {
            myp_net_set_nonblock(fd_);
            int total = 0;
            int len = Str.len(data);
            while (total < len) {
                long r = Coro.waitFd(fd_, 0, 1, timeout);
                if (r == -1) return total;
                int sent = myp_net_send(fd_, Str.substring(data, total, len));
                if (sent <= 0) return total;
                total = total + sent;
            }
            return total;
        }

        int getFd() { return fd_; }

        void close() {
            if (fd_ >= 0) {
                myp_net_close(fd_);
                fd_ = -1;
            }
        }

    property:
        int fd_;
}
