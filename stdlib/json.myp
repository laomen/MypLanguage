// json.myp — MYP 标准库：JSON 解析器
//
// 用法：
//   Json doc = new Json(jsonString);
//   string name = doc.getString("name");
//   int ver = doc.getInt("version");
//   doc.free();

import env;
import text;
import math;
import error;

// FFI 声明（handle 使用 long 存储指针）
ffi long myp_json_parse(string json_str);
ffi int myp_json_get_type(long handle, string path);
ffi string myp_json_get_string(long handle, string path);
ffi double myp_json_get_number(long handle, string path);
ffi int myp_json_get_bool(long handle, string path);
ffi int myp_json_array_length(long handle, string path);
ffi void myp_json_free(long handle);
// JsonEditor 编辑支持（v3.12.59）：遍历/修改/序列化
ffi int myp_json_child_count(long handle, string path);
ffi string myp_json_child_key(long handle, string path, int index);
ffi string myp_json_scalar(long handle, string path);
ffi int myp_json_set_value(long handle, string path, string raw);
ffi int myp_json_add_child(long handle, string path, string key, string raw);
ffi int myp_json_remove(long handle, string path);
ffi string myp_json_serialize(long handle);

// JSON 文档解析器
class Json {
    action:
        @constructor
        Json(string jsonStr) {
            handle_ = myp_json_parse(jsonStr);
            if (handle_ == 0L) {
                JsonError e = new JsonError();
                e.setLine(0);
                e.setCol(0);
                e.setDetail("invalid JSON input");
                throw e;
            }
        }

        int type(string path) {
            return myp_json_get_type(handle_, path);
        }

        string getString(string path) {
            return myp_json_get_string(handle_, path);
        }

        int getInt(string path) {
            double v = myp_json_get_number(handle_, path);
            return int(v);
        }

        double getDouble(string path) {
            return myp_json_get_number(handle_, path);
        }

        int getBool(string path) {
            return myp_json_get_bool(handle_, path);
        }

        int arrayLen(string path) {
            return myp_json_array_length(handle_, path);
        }

        // ---- JsonEditor 编辑支持 ----
        // 容器子节点数（对象键数 / 数组元素数；非容器返回 0）
        int childCount(string path) {
            return myp_json_child_count(handle_, path);
        }
        // 第 index 个子节点键名（对象返回键；数组返回 ""）
        string childKey(string path, int index) {
            return myp_json_child_key(handle_, path, index);
        }
        // 标量节点 → 显示/编辑文本（字符串去引号、数字原文、bool/null 关键字；容器返回 ""）
        string scalar(string path) {
            return myp_json_scalar(handle_, path);
        }
        // 把 path 标量改成 raw 解析出的值（数字/布尔/null/字符串）。返回 1=成功
        int setValue(string path, string raw) {
            return myp_json_set_value(handle_, path, raw);
        }
        // 容器 path 追加子节点：对象加 key=raw 标量，数组追加 raw 标量。返回 1=成功
        int addChild(string path, string key, string raw) {
            return myp_json_add_child(handle_, path, key, raw);
        }
        // 删除 path 指向的子节点（根不可删）。返回 1=成功
        int remove(string path) {
            return myp_json_remove(handle_, path);
        }
        // 整个文档美化序列化为字符串
        string serialize() {
            return myp_json_serialize(handle_);
        }

        void free() {
            if (handle_ != 0L) {
                myp_json_free(handle_);
                handle_ = 0L;
            }
        }

    static:
        // 把字符串转义为 JSON 字符串字面量内容（引号/反斜杠/换行/回车/制表）。
        // 供 @derive(Json) 生成的 toJson() 使用。
        // 注：用局部变量 r 累积（参数连续重赋值有 ARC use-after-free 既有 bug）。
        string escape(string s) {
            string r = Str.replaceAll(s, "\\", "\\\\");
            r = Str.replaceAll(r, "\"", "\\\"");
            r = Str.replaceAll(r, "\n", "\\n");
            r = Str.replaceAll(r, "\r", "\\r");
            r = Str.replaceAll(r, "\t", "\\t");
            return r;
        }

    property:
        long handle_;
}
