// cuda.myp — MYP 标准库：CUDA GPU 编程
//
// MYP 支持通过 @gpu for 语法将循环卸载到 NVIDIA GPU 执行。
// 本模块提供：
//   1. Cuda     —— GPU 设备信息查询
//   2. Device   —— 在 @gpu for 内核中可用的数学函数
//      （编译器自动映射到 CUDA libdevice，函数在 GPU 上以全精度执行）
//   3. Vectors  —— 基于 @gpu for 的向量化元素级运算与归约
//   4. Matrix   —— 二维数组元素级运算
//
// 用法：
//   // GPU 设备信息
//   int n = Cuda.count();                 // GPU 数量
//   string gpu = Cuda.name();             // GPU 名称
//   long mem = Cuda.memory();             // 显存字节数
//   int cc = Cuda.capability();           // 计算能力（如 860 = 8.6）
//
//   // 在 GPU 上并行执行循环
//   @gpu for (long i = 0L; i < n; i = i + 1L) {
//       data[i] = Device.sqrt(data[i]) + Device.sin(1.0);
//   }
//
//   // 向量化运算（自动使用 GPU）
//   Vectors.scale(data, 2.0, n);          // data[i] *= 2.0
//   Vectors.add(a, b, out, n);            // out[i] = a[i] + b[i]
//   double s = Vectors.sum(data, n);      // GPU 原子归约求和
//   double m = Vectors.mean(data, n);     // 均值
//
// 注意：
//   - @gpu for 需要 CUDA 驱动（libcuda.so.1）且设置环境变量 MYP_GPU=1
//   - 无 GPU 或未设置 MYP_GPU 时自动回退到 CPU 顺序执行（结果一致）
//   - 数学函数需要 CUDA libdevice（libdevice.10.bc），编译器在编译时自动链接
//   - 若 libdevice 不存在（设置 MYP_CUDA_LIBDEVICE 指定路径），
//     含数学函数的 @gpu for 会回退到 CPU 执行
//   - min/max/dot/transpose 等用 CPU 顺序实现（正确但非 GPU 加速）

import math;
import atomic;

class Cuda {
    static:
        // 常量：线程块大小（代码生成时使用的默认值）
        int blockSize() { return 256; }

        // GPU 是否可用（返回 1 表示可卸载内核，0 表示将使用 CPU）
        // 注意：实际 GPU 初始化在首个 @gpu for 处进行，此函数用于提前检测
        int available() {
            return __myp_cuda_available();
        }

        // ---- 设备信息（GPU 不可用时返回 0 / 空字符串）----

        // CUDA 设备数量
        int count() { return __myp_cuda_count(); }

        // GPU 名称（如 "NVIDIA GeForce RTX 4060"）
        string name() { return __myp_cuda_name(); }

        // GPU 全局显存（字节）
        long memory() { return __myp_cuda_memory(); }

        // 计算能力，如 8.6 → 860，9.0 → 900
        int capability() { return __myp_cuda_capability(); }

        // 流式多处理器（SM）数量
        int multiProcessors() { return __myp_cuda_multiprocessors(); }

        // 每线程块最大线程数
        int maxThreads() { return __myp_cuda_max_threads(); }

        // 线程束大小（通常 32）
        int warpSize() { return __myp_cuda_warp(); }
}

// Device 类 —— @gpu for 内核中的数学函数
// 在 @gpu for 块内调用这些函数时，编译器会将其映射到 CUDA libdevice 设备函数，
// 在 GPU 上以全精度（double）执行；在 CPU 上则调用标准数学库。
class Device {
    static:
        // 平方根
        double sqrt(double v)   { return Math.sqrt(v); }
        // 绝对值
        double abs(double v)    { return Math.abs(v); }
        // 向下取整
        double floor(double v)  { return Math.floor(v); }
        // 向上取整
        double ceil(double v)   { return Math.ceil(v); }
        // 截断取整（返回 int）
        int trunc(double v)     { return Math.trunc(v); }

        // 三角函数
        double sin(double v)    { return Math.sin(v); }
        double cos(double v)    { return Math.cos(v); }
        double tan(double v)    { return Math.tan(v); }

        // 反三角函数
        double asin(double v)   { return Math.asin(v); }
        double acos(double v)   { return Math.acos(v); }
        double atan(double v)   { return Math.atan(v); }
        double atan2(double y, double x) { return Math.atan2(y, x); }

        // 双曲函数
        double sinh(double v)   { return Math.sinh(v); }
        double cosh(double v)   { return Math.cosh(v); }
        double tanh(double v)   { return Math.tanh(v); }

        // 指数对数
        double exp(double v)    { return Math.exp(v); }
        double log(double v)    { return Math.log(v); }
        double pow(double base, double exp) { return Math.pow(base, exp); }
}

// Vectors 类 —— 基于 @gpu for 的向量化元素级运算
// 所有运算在 GPU 上并行执行（不可用时自动回退 CPU），结果与顺序执行一致。
class Vectors {
    static:
        // out[i] = a[i] + b[i]
        void add(double[] a, double[] b, double[] out, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                out[i] = a[i] + b[i];
            }
        }

        // out[i] = a[i] - b[i]
        void sub(double[] a, double[] b, double[] out, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                out[i] = a[i] - b[i];
            }
        }

        // out[i] = a[i] * b[i]
        void mul(double[] a, double[] b, double[] out, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                out[i] = a[i] * b[i];
            }
        }

        // data[i] = data[i] * s
        void scale(double[] data, double s, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = data[i] * s;
            }
        }

        // data[i] = data[i] + s
        void addScalar(double[] data, double s, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = data[i] + s;
            }
        }

        // data[i] = s
        void fill(double[] data, double s, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = s;
            }
        }

        // data[i] = Device.sqrt(data[i])
        void sqrt(double[] data, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = Device.sqrt(data[i]);
            }
        }

        // data[i] = Device.sin(data[i])
        void sin(double[] data, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = Device.sin(data[i]);
            }
        }

        // data[i] = Device.cos(data[i])
        void cos(double[] data, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = Device.cos(data[i]);
            }
        }

        // data[i] = Device.exp(data[i])
        void exp(double[] data, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = Device.exp(data[i]);
            }
        }

        // data[i] = Device.log(data[i])
        void log(double[] data, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = Device.log(data[i]);
            }
        }

        // data[i] = Device.pow(data[i], p)
        void pow(double[] data, double p, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = Device.pow(data[i], p);
            }
        }
        // data[i] = Device.tan(data[i])
        void tan(double[] data, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = Device.tan(data[i]);
            }
        }
        // data[i] = Device.abs(data[i])
        void abs(double[] data, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = Device.abs(data[i]);
            }
        }
        // data[i] = Device.floor(data[i])
        void floor(double[] data, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = Device.floor(data[i]);
            }
        }
        // data[i] = Device.ceil(data[i])
        void ceil(double[] data, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = Device.ceil(data[i]);
            }
        }
        // out[i] = a * x[i] + y[i]（SAXPY，BLAS 风格）
        void saxpy(double a, double[] x, double[] y, double[] out, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                out[i] = a * x[i] + y[i];
            }
        }
        // dst[i] = src[i]
        void copy(double[] dst, double[] src, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                dst[i] = src[i];
            }
        }
        // data[i] = -data[i]
        void negate(double[] data, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = 0.0 - data[i];
            }
        }
        // data[i] = clamp(data[i], lo, hi)
        void clamp(double[] data, double lo, double hi, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                double v = data[i];
                if (v < lo) v = lo;
                if (v > hi) v = hi;
                data[i] = v;
            }
        }

        // ---- 归约（sum/mean/variance/norm 用 GPU 原子累加，min/max/dot 为 CPU）----

        // sum = Σ a[i]（GPU 原子归约）
        double sum(double[] a, long n) {
            double[] acc = new double[1];
            acc[0] = 0.0;
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                Atomic.addDouble(acc, 0, a[i]);
            }
            return acc[0];
        }
        // mean = Σ a[i] / n（GPU 原子归约）
        double mean(double[] a, long n) {
            double[] acc = new double[1];
            acc[0] = 0.0;
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                Atomic.addDouble(acc, 0, a[i]);
            }
            return acc[0] / n;
        }
        // variance = Σ (a[i]-mean)^2 / n（GPU 原子归约，单遍）
        double variance(double[] a, long n) {
            double[] s = new double[1];
            double[] sq = new double[1];
            s[0] = 0.0;
            sq[0] = 0.0;
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                Atomic.addDouble(s, 0, a[i]);
                Atomic.addDouble(sq, 0, a[i] * a[i]);
            }
            double mean = s[0] / n;
            return sq[0] / n - mean * mean;
        }
        // stddev = sqrt(variance)（GPU 原子归约）
        double stddev(double[] a, long n) {
            double[] s = new double[1];
            double[] sq = new double[1];
            s[0] = 0.0;
            sq[0] = 0.0;
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                Atomic.addDouble(s, 0, a[i]);
                Atomic.addDouble(sq, 0, a[i] * a[i]);
            }
            double mean = s[0] / n;
            double var_val = sq[0] / n - mean * mean;
            return Math.sqrt(var_val);
        }
        // normSquared = Σ a[i]^2（GPU 原子归约）
        double normSquared(double[] a, long n) {
            double[] acc = new double[1];
            acc[0] = 0.0;
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                Atomic.addDouble(acc, 0, a[i] * a[i]);
            }
            return acc[0];
        }
        // norm = sqrt(Σ a[i]^2)（GPU 原子归约）
        double norm(double[] a, long n) {
            double[] acc = new double[1];
            acc[0] = 0.0;
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                Atomic.addDouble(acc, 0, a[i] * a[i]);
            }
            return Math.sqrt(acc[0]);
        }
        // 单位化：data[i] /= ||data||（先 GPU 求模，再 GPU 归一化）
        void normalize(double[] data, long n) {
            double[] acc = new double[1];
            acc[0] = 0.0;
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                Atomic.addDouble(acc, 0, data[i] * data[i]);
            }
            double d = Math.sqrt(acc[0]);
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = data[i] / d;
            }
        }
        // 最小值（CPU 顺序，正确但非 GPU 加速）
        double min(double[] a, long n) {
            double m = a[0];
            for (long i = 1L; i < n; i = i + 1L) {
                if (a[i] < m) m = a[i];
            }
            return m;
        }
        // 最大值（CPU 顺序）
        double max(double[] a, long n) {
            double m = a[0];
            for (long i = 1L; i < n; i = i + 1L) {
                if (a[i] > m) m = a[i];
            }
            return m;
        }
        // 内积 Σ a[i]*b[i]（GPU 原子归约）
        double dot(double[] a, double[] b, long n) {
            double[] acc = new double[1];
            acc[0] = 0.0;
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                double d = a[i] * b[i];
                Atomic.addDouble(acc, 0, d);
            }
            return acc[0];
        }
        // float 版内积（float 数组，双精度累加避免舍入）
        double dotF(float[] a, float[] b, long n) {
            double[] acc = new double[1];
            acc[0] = 0.0;
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                double d = a[i] * b[i];
                Atomic.addDouble(acc, 0, d);
            }
            return acc[0];
        }

        // ---- GPU 块归约（max/min/argmax）：GPU 每块取局部极值，CPU 扫描块表 ----
        // 归约块大小
        int blockSize() { return 256; }

        // 最大值（GPU 块归约）
        double max(double[] a, long n) {
            int bs = Vectors.blockSize();
            int blocks = int((n + bs - 1) / bs);
            double[] lm = new double[blocks];
            @gpu for (long p = 0L; p < blocks; p = p + 1L) {
                double b = a[p * bs];
                long j = 1L;
                while (j < bs) {
                    long idx = p * bs + j;
                    if (idx < n) { double v = a[idx]; if (v > b) b = v; }
                    j = j + 1L;
                }
                lm[p] = b;
            }
            double m = lm[0];
            long i = 1L;
            while (i < blocks) { if (lm[i] > m) m = lm[i]; i = i + 1L; }
            return m;
        }
        // float 版最大值
        float maxF(float[] a, long n) {
            int bs = Vectors.blockSize();
            int blocks = int((n + bs - 1) / bs);
            float[] lm = new float[blocks];
            @gpu for (long p = 0L; p < blocks; p = p + 1L) {
                float b = a[p * bs];
                long j = 1L;
                while (j < bs) {
                    long idx = p * bs + j;
                    if (idx < n) { float v = a[idx]; if (v > b) b = v; }
                    j = j + 1L;
                }
                lm[p] = b;
            }
            float m = lm[0];
            long i = 1L;
            while (i < blocks) { if (lm[i] > m) m = lm[i]; i = i + 1L; }
            return m;
        }
        // 最小值（GPU 块归约）
        double min(double[] a, long n) {
            int bs = Vectors.blockSize();
            int blocks = int((n + bs - 1) / bs);
            double[] lm = new double[blocks];
            @gpu for (long p = 0L; p < blocks; p = p + 1L) {
                double b = a[p * bs];
                long j = 1L;
                while (j < bs) {
                    long idx = p * bs + j;
                    if (idx < n) { double v = a[idx]; if (v < b) b = v; }
                    j = j + 1L;
                }
                lm[p] = b;
            }
            double m = lm[0];
            long i = 1L;
            while (i < blocks) { if (lm[i] < m) m = lm[i]; i = i + 1L; }
            return m;
        }
        // float 版最小值
        float minF(float[] a, long n) {
            int bs = Vectors.blockSize();
            int blocks = int((n + bs - 1) / bs);
            float[] lm = new float[blocks];
            @gpu for (long p = 0L; p < blocks; p = p + 1L) {
                float b = a[p * bs];
                long j = 1L;
                while (j < bs) {
                    long idx = p * bs + j;
                    if (idx < n) { float v = a[idx]; if (v < b) b = v; }
                    j = j + 1L;
                }
                lm[p] = b;
            }
            float m = lm[0];
            long i = 1L;
            while (i < blocks) { if (lm[i] < m) m = lm[i]; i = i + 1L; }
            return m;
        }
        // 最大值下标（GPU 块归约，返回首个达到最大值的下标）
        int argmax(double[] a, long n) {
            int bs = Vectors.blockSize();
            int blocks = int((n + bs - 1) / bs);
            double[] lm = new double[blocks];
            long[] li = new long[blocks];
            @gpu for (long p = 0L; p < blocks; p = p + 1L) {
                long bi = p * bs;
                double b = a[bi];
                long j = 1L;
                while (j < bs) {
                    long idx = p * bs + j;
                    if (idx < n) { double v = a[idx]; if (v > b) { b = v; bi = idx; } }
                    j = j + 1L;
                }
                lm[p] = b;
                li[p] = bi;
            }
            double m = lm[0];
            int bi = int(li[0]);
            long i = 1L;
            while (i < blocks) { if (lm[i] > m) { m = lm[i]; bi = int(li[i]); } i = i + 1L; }
            return bi;
        }
        // float 版最大值下标
        int argmaxF(float[] a, long n) {
            int bs = Vectors.blockSize();
            int blocks = int((n + bs - 1) / bs);
            float[] lm = new float[blocks];
            long[] li = new long[blocks];
            @gpu for (long p = 0L; p < blocks; p = p + 1L) {
                long bi = p * bs;
                float b = a[bi];
                long j = 1L;
                while (j < bs) {
                    long idx = p * bs + j;
                    if (idx < n) { float v = a[idx]; if (v > b) { b = v; bi = idx; } }
                    j = j + 1L;
                }
                lm[p] = b;
                li[p] = bi;
            }
            float m = lm[0];
            int bi = int(li[0]);
            long i = 1L;
            while (i < blocks) { if (lm[i] > m) { m = lm[i]; bi = int(li[i]); } i = i + 1L; }
            return bi;
        }
}

// Matrix 类 —— 矩阵元素级运算
// 矩阵用扁平行主序 double[] 表示（大小 rows*cols，元素 (i,j) 在索引 i*cols+j）。
// MYP 目前仅支持一维数组，因此用扁平数组 + 显式行列数。
class Matrix {
    static:
        // C = A + B（逐元素，GPU）
        void add(double[] a, double[] b, double[] c, long rows, long cols) {
            long total = rows * cols;
            @gpu for (long k = 0L; k < total; k = k + 1L) {
                c[k] = a[k] + b[k];
            }
        }
        // C = A - B（逐元素，GPU）
        void sub(double[] a, double[] b, double[] c, long rows, long cols) {
            long total = rows * cols;
            @gpu for (long k = 0L; k < total; k = k + 1L) {
                c[k] = a[k] - b[k];
            }
        }
        // C = A * B（逐元素，GPU）
        void mul(double[] a, double[] b, double[] c, long rows, long cols) {
            long total = rows * cols;
            @gpu for (long k = 0L; k < total; k = k + 1L) {
                c[k] = a[k] * b[k];
            }
        }
        // A = A * s（逐元素，GPU）
        void scale(double[] a, double s, long rows, long cols) {
            long total = rows * cols;
            @gpu for (long k = 0L; k < total; k = k + 1L) {
                a[k] = a[k] * s;
            }
        }
        // A = s（逐元素，GPU）
        void fill(double[] a, double s, long rows, long cols) {
            long total = rows * cols;
            @gpu for (long k = 0L; k < total; k = k + 1L) {
                a[k] = s;
            }
        }
        // 转置：T[i*rows+j] = A[j*cols+i]（CPU；A 为 rows×cols，T 为 cols×rows）
        void transpose(double[] a, double[] t, long rows, long cols) {
            for (long i = 0L; i < rows; i = i + 1L) {
                for (long j = 0L; j < cols; j = j + 1L) {
                    t[j * rows + i] = a[i * cols + j];
                }
            }
        }

        // C[m×n] = A[m×k] · B[k×n]（GPU GEMM，每线程算一个输出元素）
        // A/B/C 均行主序（row-major）
        void matmul(double[] a, double[] b, double[] c, long m, long n, long k) {
            long total = m * n;
            @gpu for (long idx = 0L; idx < total; idx = idx + 1L) {
                long i = idx / n;
                long j = idx % n;
                double s = 0.0;
                long t = 0L;
                while (t < k) {
                    s = s + a[i * k + t] * b[t * n + j];
                    t = t + 1L;
                }
                c[idx] = s;
            }
        }
        // float 版 GEMM（FP32 全速）
        void matmulF(float[] a, float[] b, float[] c, long m, long n, long k) {
            long total = m * n;
            @gpu for (long idx = 0L; idx < total; idx = idx + 1L) {
                long i = idx / n;
                long j = idx % n;
                float s = float(0.0);
                long t = 0L;
                while (t < k) {
                    s = s + a[i * k + t] * b[t * n + j];
                    t = t + 1L;
                }
                c[idx] = s;
            }
        }
}
