// memory.myp — MYP 标准库：动态内存管理（FFI 桥接 C 标准库）
//
// MYP 的 FFI 惯例：C 指针用 `long`（64 位）承载（同 json/regex 的 handle）。
// 直接调用 C 标准库的 malloc/free/realloc。
//
// 使用场景：
//   1. 确定性释放 —— arena 分配的 `new T[n]` 要等进程退出/@region 结束才回收，
//      生命周期明确的临时缓冲可用 Memory 手动即时释放，控制峰值内存。
//   2. FFI 指针互操作 —— 传给 C 库（SDL/net/GPU/第三方）的裸指针。
//   3. 字节缓冲 / 手动布局 —— 二进制协议、文件格式的原始缓冲区。
//
// 用法：
//   import memory;
//   long p = Memory.alloc(1024);       // 分配
//   Memory.free(p);                     // 释放
//   p = Memory.realloc(p, 2048);        // 重新分配
//
// 注：动态数组请用 `import collections` 的 `ArrayList<T>`（已支持自动扩容）；
// 本模块只负责裸内存管理，不提供容器类型。

import env;

// ---- FFI 声明：C 标准库内存函数（指针以 long 承载）----
ffi long malloc(long size);
ffi void free(long ptr);
ffi long realloc(long ptr, long new_size);
// ARC（§五-1）：当前线程存活（未释放）的 class 实例数——诊断用
ffi long myp_live_object_count();
// ---- M9 内存诊断 ----
ffi long myp_live_string_count();
ffi long myp_live_array_count();
ffi long myp_live_total_count();
ffi long myp_live_object_count_by_type(long typeId);
// RTTI：type_id → 类名（MYP 运行时 / C 运行时均提供；泄漏报告用）
ffi string myp_type_name(int typeId);
ffi long myp_diag_arena_reserved();
ffi long myp_diag_arena_used();
ffi long myp_diag_region_reserved();
ffi long myp_diag_region_used();
ffi long myp_diag_coro_slots();
ffi long myp_diag_coro_slot_capacity();
ffi long myp_diag_coro_free_slots();
ffi long myp_diag_stack_pool_count();
ffi long myp_diag_stack_pool_capacity();
ffi long myp_diag_stack_pool_bytes();
ffi long myp_diag_stack_pool_max_bytes();
ffi long myp_diag_retired_count();
ffi long myp_diag_retired_bytes();
// M9 分配失败注入（第 N 次分配 abort）与 strict 头校验开关
ffi void myp_fail_alloc_enable(long nth);
ffi void myp_fail_alloc_disable();
ffi long myp_fail_alloc_get();
ffi void myp_diag_set_strict(long on);
ffi long myp_diag_get_strict();
// 环收集（ARC trial-deletion）：回收引用环（自环/互引用）。安全点调用
// （单线程、无并发引用变更）。进程退出时自动触发（myp_free_all）；
// 本 FFI 供执行期显式调用（如事件循环空闲时）。
ffi void myp_collect_cycles();
// v3.15.172 自动触发：水位到（每 N 次类对象分配）且无活动 @thread/@parallel 时，
// 在事件循环安全点（myp_event_process_all）自动收集。collectCyclesIfNeeded 供
// 无事件循环的应用在自选安全点调用；setCollectThreshold 调水位（<=0 关闭）。
ffi void myp_cc_try_collect();
ffi void myp_cc_set_threshold(long n);
ffi long myp_cc_get_threshold();

// ============================================================
// 动态内存分配器
// ============================================================
class Memory {
    static:
        // 分配内存（返回指针，用 long 承载）
        long alloc(long size) {
            return malloc(size);
        }

        // 释放内存
        void free(long ptr) {
            free(ptr);
        }

        // 释放内存（别名）
        void release(long ptr) {
            free(ptr);
        }

        // 重新分配（扩容/缩容）
        long realloc(long ptr, long new_size) {
            return realloc(ptr, new_size);
        }

        // 当前线程存活的 class 实例数（ARC 诊断）
        long liveObjectCount() {
            return myp_live_object_count();
        }

        // ---- M9：内存诊断 ----
        // 存活计数（线程本地）：
        //   liveObjectCount         —— class 实例总数
        //   liveStringCount         —— 引用计数 string 数
        //   liveArrayCount          —— 引用计数数组/slice backing 数
        //   liveTotalCount          —— 三者之和
        //   liveObjectCountByType   —— 按运行时 type_id 的 class 实例数
        long liveStringCount() { return myp_live_string_count(); }
        long liveArrayCount() { return myp_live_array_count(); }
        long liveTotalCount() { return myp_live_total_count(); }
        long liveObjectCountByType(long typeId) {
            return myp_live_object_count_by_type(typeId);
        }

        // ---- MYP_MEM_REPORT：泄漏诊断 ----
        // 按 type_id 打印当前存活的 class 实例（跨线程累计；MYP 运行时为进程级
        // 计数）。进程退出时设环境变量 MYP_MEM_REPORT=1 会自动打印同款报告；
        // 本方法可在任意时刻做快照（stdout，@test 可捕获）。
        void memReport() {
            long total = 0L;
            Console.writeString("MYP memory report (live class instances):\n");
            for (int tid = 1; tid < 1024; tid = tid + 1) {
                long c = myp_live_object_count_by_type(tid);
                if (c <= 0L) continue;
                Console.writeString("  " + myp_type_name(tid) + ": " + c + "\n");
                total = total + c;
            }
            Console.writeString("  total: " + total + "\n");
        }

        // 环收集（v3.15.171）：回收引用环（自环/互引用）。安全点调用
        // （单线程、无并发引用变更）。进程退出自动触发（myp_free_all）。
        void collectCycles() {
            myp_collect_cycles();
        }

        // ---- v3.15.172：自动环收集（零用户操作）----
        // 每 N 次类对象分配（水位）在事件循环安全点自动收集。默认 100000，
        // <=0 关闭。事件循环（mapping/@coro 调度）自动触发；无事件循环的
        // 应用可在自选安全点调 collectCyclesIfNeeded()。
        // 并发守卫：有活动 @thread 体或 @parallel for 进行中时自动跳过
        // （此时收集不安全，回退显式 collectCycles 或退出自动）。
        void setCollectThreshold(long n) { myp_cc_set_threshold(n); }
        long collectThreshold() { return myp_cc_get_threshold(); }
        void collectCyclesIfNeeded() { myp_cc_try_collect(); }

        // 非 ARC bump arena（进程级字符串/数组历史分配）reserved/used 字节
        long arenaReservedBytes() { return myp_diag_arena_reserved(); }
        long arenaUsedBytes() { return myp_diag_arena_used(); }

        // ---- 环收集（v3.15.171）----
        // 回收引用环（自环/互引用环），ARC 无法处理的内存泄漏。零每次分配/释放
        // 开销；仅收集时一次 O(n) 扫描。进程退出时 myp_free_all 自动触发
        // （MYP_MEM_REPORT 报告此时只含真泄漏）；执行期可在安全点显式调用。
        // ⚠️ 须在无并发引用变更处调用（单线程阶段/空闲时）。
        void collectCycles() {
            myp_collect_cycles();
        }

        // @region arena reserved/used 字节（region 结束时回落）
        long regionReservedBytes() { return myp_diag_region_reserved(); }
        long regionUsedBytes() { return myp_diag_region_used(); }

        // 协程资源（线程本地）：槽容量 / 空闲槽 / 栈池 / 退役栈
        long coroSlotCount() { return myp_diag_coro_slots(); }
        long coroSlotCapacity() { return myp_diag_coro_slot_capacity(); }
        long coroFreeSlotCount() { return myp_diag_coro_free_slots(); }
        long stackPoolCount() { return myp_diag_stack_pool_count(); }
        long stackPoolCapacity() { return myp_diag_stack_pool_capacity(); }
        long stackPoolBytes() { return myp_diag_stack_pool_bytes(); }
        long stackPoolMaxBytes() { return myp_diag_stack_pool_max_bytes(); }
        long retiredCount() { return myp_diag_retired_count(); }
        long retiredBytes() { return myp_diag_retired_bytes(); }

        // 分配失败注入：第 nth 次分配（到达 runtime 分配器的）确定性 abort。
        // 0=关闭；也可用环境变量 MYP_FAIL_ALLOC=n 在启动时设置。
        void failAllocEnable(long nth) { myp_fail_alloc_enable(nth); }
        void failAllocDisable() { myp_fail_alloc_disable(); }
        long failAllocGet() { return myp_fail_alloc_get(); }

        // strict 头校验：release 下溢/重复释放/损坏头（非法 type_id）立即 abort
        // 并给出稳定诊断。debug/ASAN 构建默认开，release 默认关。
        void setStrictChecks(long on) { myp_diag_set_strict(on); }
        long getStrictChecks() { return myp_diag_get_strict(); }
}
