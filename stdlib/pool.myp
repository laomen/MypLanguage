// pool.myp — MYP 标准库：并行计算工具
// 提供 Parallel 静态类
// 配合 @parallel for 和 __myp_atomic_* 使用
//
// 用法:
//   import pool;
//   int n = Parallel.threadCount();
//   @parallel for (int i = 0; i < n; i = i + 1) { ... }

// 线程池运行时 FFI（work-stealing 线程池，见 src/runtime/runtime.c）
ffi int myp_pool_thread_count();   // 硬件并发线程数（sysconf _SC_NPROCESSORS_ONLN）
ffi int myp_pool_worker_id();      // 当前池 worker 索引（0..N-1，非池线程为 -1）

class Parallel {
    static:
        // 获取硬件并发线程数（sysconf _SC_NPROCESSORS_ONLN）
        int threadCount() { return myp_pool_thread_count(); }

        // 获取当前执行线程的池 worker 索引（0..N-1，非池线程为 -1）。
        // 在 @parallel for body 内调用可检测多线程是否真正启动。
        int workerId() { return myp_pool_worker_id(); }
}
