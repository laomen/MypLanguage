// random.myp — MYP 标准库：随机数
//
// 用法：
//   Random.init(12345);              // 设置种子
//   int r = Random.next();           // 0..RAND_MAX
//   int d = Random.below(6);         // 0..5
//   double u = Random.uniform();     // 0.0..1.0
//   double g = Random.gaussian();    // 标准正态分布
//   double r = Random.range(5.0, 10.0);   // [lo, hi) 均匀
//   double e = Random.exponential(2.0);   // 指数分布（均值 1/lambda）
//   int p = Random.poisson(3.0);          // 泊松分布整数
//   Random.shuffle(arr, n);          // 洗牌算法

import math;

// FFI 声明到 C 标准库的 rand/srand
ffi int rand();
ffi void srand(int seed);

class Random {
    static:
        // 初始化随机数种子
        void init(int seed) {
            srand(seed);
        }

        // 返回 [0, RAND_MAX] 范围内的随机整数
        int next() {
            return rand();
        }

        // 返回 [0, max) 范围内的随机整数
        int below(int max) {
            if (max <= 0) return 0;
            return rand() % max;
        }

        // 返回 [0.0, 1.0) 范围内的均匀分布浮点数
        double uniform() {
            return (rand() + 0.0) / 2147483647.0;
        }

        // 返回标准正态分布 N(0,1) 的随机数（Box-Muller 变换）
        double gaussian() {
            // Box-Muller: generate two uniforms, produce two normals
            double u1 = (rand() + 1.0) / 2147483648.0;
            double u2 = (rand() + 1.0) / 2147483648.0;
            return Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.pi() * u2);
        }

        // 返回 [lo, hi) 区间内的均匀分布浮点数
        double range(double lo, double hi) {
            return lo + (hi - lo) * Random.uniform();
        }

        // 返回指数分布 Exp(lambda)（均值 1/lambda）的随机数（逆变换采样）
        double exponential(double lambda) {
            double u = Random.uniform();
            if (u <= 0.0) u = 0.0000000001;   // 避免 log(0)
            return -Math.log(u) / lambda;
        }

        // 返回泊松分布 Poisson(lambda) 的随机整数（Knuth 算法）
        int poisson(double lambda) {
            double L = Math.exp(-lambda);
            int k = 0;
            double p = 1.0;
            while (p > L) {
                k = k + 1;
                p = p * Random.uniform();
            }
            return k - 1;
        }

        // Fisher-Yates 洗牌算法
        void shuffle(int[] arr, int n) {
            for (int i = n - 1; i > 0; i = i - 1) {
                int j = Random.below(i + 1);
                int tmp = arr[i];
                arr[i] = arr[j];
                arr[j] = tmp;
            }
        }
}
