// layers.myp — 组件化神经网络算子
//
// 每个算子是一个独立 class：
//   Dense     — 全连接层 y = Wx + b
//   Sigmoid   — 激活函数
//   LossMSE   — 均方误差损失

// ============================================================
// Dense — 全连接层
// ============================================================
class Dense {
    action:
        @startup void init() {}

        void configure(int nIn, int nOut) {
            nIn_ = nIn; nOut_ = nOut;
        }

        void initW() {
            double sc = Math.sqrt(6.0 / (nIn_ + nOut_));
            int i = 0;
            while (i < nIn_ * nOut_) {
                double r = ((i * 37 + 13) % 1000) / 1000.0;
                w_[i] = (r * 2.0 - 1.0) * sc;
                i = i + 1;
            }
            i = 0; while (i < nOut_) { b_[i] = 0.0; i = i + 1; }
        }

        void setInput(int idx, double v) { input_[idx] = v; }
        double getOutput(int idx) { return output_[idx]; }

        double getW(int i, int j) { return w_[i * nIn_ + j]; }
        void setW(int i, int j, double v) { w_[i * nIn_ + j] = v; }
        double getB(int idx) { return b_[idx]; }
        void setB(int idx, double v) { b_[idx] = v; }

        void forward() {
            int i = 0;
            while (i < nOut_) {
                double sum = b_[i];
                int j = 0; while (j < nIn_) {
                    sum = sum + w_[i * nIn_ + j] * input_[j];
                    j = j + 1;
                }
                output_[i] = sum;
                i = i + 1;
            }
        }

        int nIn() { return nIn_; }
        int nOut() { return nOut_; }

    property:
        int nIn_ = 0; int nOut_ = 0;
        double[1024] input_; double[1024] output_;
        double[65536] w_; double[1024] b_;
}


// ============================================================
// Sigmoid — 激活函数
// ============================================================
class Sigmoid {
    action:
        @startup void init() {}

        void configure(int n) { n_ = n; }
        void setInput(int idx, double v) { input_[idx] = v; }
        double getOutput(int idx) { return output_[idx]; }

        void forward() {
            int i = 0; while (i < n_) {
                double neg = 0.0 - input_[i];
                output_[i] = 1.0 / (1.0 + Math.exp(neg));
                i = i + 1;
            }
        }

    property:
        int n_ = 0;
        double[1024] input_; double[1024] output_;
}


// ============================================================
// LossMSE — 均方误差损失
// ============================================================
class LossMSE {
    action:
        @startup void init() {}

        double getLoss() { return loss_; }
        void compute(double pred, double target) {
            double diff = pred - target;
            loss_ = 0.5 * diff * diff;
        }

    property:
        double[1024] target_;
        double loss_;
}
