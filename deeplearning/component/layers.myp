// layers.myp — 组件化神经网络算子
//
// MYP 现已支持：
//   ✅ 公共属性 — 可直接读写 layer.output_[idx]
//   ✅ 数组参数 — 可直接传递 double[] 数组

// ============================================================
// Dense — 全连接层 y = Wx + b
// ============================================================
class Dense {
    action:
        void configure(int nIn, int nOut) {
            nIn_ = nIn; nOut_ = nOut;
        }

        void initW() {
            double sc = Math.sqrt(6.0 / (nIn_ + nOut_));
            int i = 0;
            while (i < nIn_ * nOut_) {
                double r = ((i * 37 + 13) % 1000) / 1000.0;
                w_[i] = (r * 2.0 - 1.0) * sc;
                i = i + 1;
            }
            i = 0; while (i < nOut_) { b_[i] = 0.0; i = i + 1; }
        }

        // 批量设置输入（直接传递数组）
        void setInputFrom(double[] src) {
            int i = 0; while (i < nIn_) { input_[i] = src[i]; i = i + 1; }
        }
        // 批量拷贝输出
        void copyOutputTo(double[] dst) {
            int i = 0; while (i < nOut_) { dst[i] = output_[i]; i = i + 1; }
        }

        double getW(int i, int j) { return w_[i * nIn_ + j]; }
        void setW(int i, int j, double v) { w_[i * nIn_ + j] = v; }
        double getB(int idx) { return b_[idx]; }
        void setB(int idx, double v) { b_[idx] = v; }
        void forward() {
            int i = 0;
            while (i < nOut_) {
                double sum = b_[i];
                int j = 0; while (j < nIn_) {
                    sum = sum + w_[i * nIn_ + j] * input_[j];
                    j = j + 1;
                }
                output_[i] = sum;
                i = i + 1;
            }
        }

    property:
        // 公共属性 — 可直接读写
        int nIn_ = 0; int nOut_ = 0;
        double[1024] input_; double[1024] output_;
        double[65536] w_; double[1024] b_;
}


// ============================================================
// Sigmoid — 激活函数（逐元素）
// ============================================================
class Sigmoid {
    action:
        void configure(int n) { n_ = n; }

        void setInputFrom(double[] src) {
            int i = 0; while (i < n_) { input_[i] = src[i]; i = i + 1; }
        }
        void copyOutputTo(double[] dst) {
            int i = 0; while (i < n_) { dst[i] = output_[i]; i = i + 1; }
        }

        void forward() {
            int i = 0; while (i < n_) {
                double neg = 0.0 - input_[i];
                output_[i] = 1.0 / (1.0 + Math.exp(neg));
                i = i + 1;
            }
        }

    property:
        int n_ = 0;
        double[1024] input_; double[1024] output_;
}
