// xor.myp — 组件化 XOR 训练示例
//
// MYP 现已支持：
//   ✅ 公共属性 — 同层内直接读写 input_[i] / output_[i]
//   ✅ 数组参数 — double[] 批量传递层间数据
//   ⚠ 跨类属性访问（o.w_[i]）仍需 getter/setter（编译器限制）
//
// 运行: ./build/mypc deeplearning/component/xor.myp
//        && ./deeplearning/component/xor.out

import env;
import math;
import "./layers.myp";

double sig(double x) {
    double neg = 0.0 - x;
    return 1.0 / (1.0 + Math.exp(neg));
}
double sig_d(double x) {
    double s = sig(x);
    return s * (1.0 - s);
}

class Trainer {
    action:
        @startup void run() {
            double[4] x0; x0[0]=0.0; x0[1]=0.0; x0[2]=1.0; x0[3]=1.0;
            double[4] x1; x1[0]=0.0; x1[1]=1.0; x1[2]=0.0; x1[3]=1.0;
            double[4] t; t[0]=0.0; t[1]=1.0; t[2]=1.0; t[3]=0.0;

            Console.writeLine("=== 组件化 XOR 训练 2->4->1 ===");

            Dense h = new Dense(2, 4); h.configure(2, 4);
            Sigmoid hs = new Sigmoid(4); hs.configure(4);
            Dense o = new Dense(4, 1); o.configure(4, 1);
            Sigmoid os = new Sigmoid(1); os.configure(1);
            h.initW(); o.initW();

            double lr = 0.5;
            int epochs = 5000;
            int ep = 0;

            while (ep < epochs) {
                int s = 0;
                while (s < 4) {
                    // 前向（直接读写公共属性 + 数组参数批量拷贝）
                    h.input_[0] = x0[s]; h.input_[1] = x1[s]; h.forward();
                    hs.setInputFrom(h.output_); hs.forward();
                    o.setInputFrom(hs.output_); o.forward();
                    os.input_[0] = o.output_[0]; os.forward();

                    // 反向（跨类权重访问用 getter/setter）
                    double pred = os.output_[0];
                    double d_out = (pred - t[s]) * sig_d(o.output_[0]);
                    int j = 0; while (j < 4) {
                        d_hid_[j] = d_out * o.getW(0, j) * sig_d(h.output_[j]);
                        j = j + 1;
                    }
                    j = 0; while (j < 4) {
                        o.setW(0, j, o.getW(0, j) - lr * d_out * hs.output_[j]);
                        j = j + 1;
                    }
                    o.setB(0, o.getB(0) - lr * d_out);
                    j = 0; while (j < 4) {
                        h.setW(0, j, h.getW(0, j) - lr * d_hid_[j] * x0[s]);
                        h.setW(1, j, h.getW(1, j) - lr * d_hid_[j] * x1[s]);
                        h.setB(j, h.getB(j) - lr * d_hid_[j]);
                        j = j + 1;
                    }
                    s = s + 1;
                }

                if (ep % 1000 == 0) {
                    Console.writeString("  Ep "); Console.writeLong(ep); Console.writeString(" -> ");
                    int t2 = 0; while (t2 < 4) {
                        h.input_[0]=x0[t2]; h.input_[1]=x1[t2]; h.forward();
                        hs.setInputFrom(h.output_); hs.forward();
                        o.setInputFrom(hs.output_); o.forward();
                        os.input_[0]=o.output_[0]; os.forward();
                        if (os.output_[0] >= 0.5) Console.writeString("1 "); else Console.writeString("0 ");
                        t2 = t2 + 1;
                    }
                    Console.writeLine("");
                }
                ep = ep + 1;
            }

            Console.writeLine("  最终输出:");
            int t2 = 0; while (t2 < 4) {
                h.input_[0]=x0[t2]; h.input_[1]=x1[t2]; h.forward();
                hs.setInputFrom(h.output_); hs.forward();
                o.setInputFrom(hs.output_); o.forward();
                os.input_[0]=o.output_[0]; os.forward();
                Console.writeString("  "); Console.writeFloat(x0[t2]);
                Console.writeString(", "); Console.writeFloat(x1[t2]);
                Console.writeString(" -> "); Console.writeFloat(os.output_[0]); Console.writeLine("");
                t2 = t2 + 1;
            }
        }

    property:
        double[4] d_hid_;
}

int main() {
    Trainer t = new Trainer();
    return 0;
}
