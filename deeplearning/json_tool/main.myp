// main.myp — Minimal inference framework demo
import env;
import "../infer/runtime.myp";
import "./demo_model.myp";

int expectXor(int x0, int x1) {
    if (x0 == x1) return 0;
    return 1;
}

class InferApp {
    action:
        @constructor InferApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(4096);

            XorDemo demo = new XorDemo();
            demo.build(rt);

            int pass = 0;
            int total = 4;

            int a0 = demo.infer(rt, 0.0, 0.0);
            demo.printProb(rt);
            if (a0 == expectXor(0, 0)) pass = pass + 1;

            int a1 = demo.infer(rt, 0.0, 1.0);
            demo.printProb(rt);
            if (a1 == expectXor(0, 1)) pass = pass + 1;

            int a2 = demo.infer(rt, 1.0, 0.0);
            demo.printProb(rt);
            if (a2 == expectXor(1, 0)) pass = pass + 1;

            int a3 = demo.infer(rt, 1.0, 1.0);
            demo.printProb(rt);
            if (a3 == expectXor(1, 1)) pass = pass + 1;

            Console.writeString("XOR accuracy: ");
            Console.writeLong(pass);
            Console.writeString("/");
            Console.writeLong(total);
            Console.writeLine("");
        }
}

int main() {
    InferApp app = new InferApp();
    return 0;
}
