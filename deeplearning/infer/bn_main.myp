// bn_main.myp — G3：BatchNormalization 端到端测试
// 1) bn_fold_test.onnx（Conv→BN→Relu）：验证 Conv+BN 融合（bnCount=1，BN 折叠进卷积权重，
//    随后 G1 再融合 Conv+ReLU → 单算子）。输出与 onnxruntime 参考逐元素对比。
// 2) bn_standalone_test.onnx（x→BN→Relu）：验证独立 BatchNormalization 算子（opKind 17）。
import env;
import cuda;
import "./pb.myp";
import "./runtime.myp";
import "./onnx_loader.myp";

class BNTestApp {
    action:
        @constructor BNTestApp() {
            // ---- 1) Conv→BN→Relu 融合 ----
            InferenceRuntime rt1 = new InferenceRuntime();
            rt1.init(1024);
            OnnxLoader l1 = new OnnxLoader();
            int ok1 = l1.load("./deeplearning/data/onnx/bn_fold_test.onnx", rt1);
            if (ok1 == 0) { Console.writeLine("fold load failed"); return; }
            Console.writeString("fold: bn_fused=");
            Console.writeLong(l1.bnCount());
            Console.writeString("  convRelu_fused=");
            Console.writeLong(l1.fuseCount());
            Console.writeString("  ops=");
            Console.writeLong(rt1.opCount());
            Console.writeLine("");
            int in1 = l1.tensorId("x");
            int out1 = l1.tensorId("y");
            if (in1 < 0 || out1 < 0) { Console.writeLine("fold tensor not found"); return; }
            double[] buf1 = new double[256];
            readF32("./deeplearning/data/onnx/bn_fold_input.f32", buf1, 192);
            int i = 0;
            while (i < 192) { rt1.setFlat(in1, i, buf1[i]); i = i + 1; }
            rt1.run();
            double max1 = compareRef(out1, rt1, "/tmp/bn_fold_ref.bin", 256);
            Console.writeString("fold max diff: ");
            Console.writeFloat(max1);
            if (max1 < 1.0e-3) Console.writeLine("  BN FOLD OK");
            else Console.writeLine("  BN FOLD MISMATCH");

            // ---- 2) 独立 BN ----
            InferenceRuntime rt2 = new InferenceRuntime();
            rt2.init(1024);
            OnnxLoader l2 = new OnnxLoader();
            int ok2 = l2.load("./deeplearning/data/onnx/bn_standalone_test.onnx", rt2);
            if (ok2 == 0) { Console.writeLine("standalone load failed"); return; }
            Console.writeString("standalone: bn_fused=");
            Console.writeLong(l2.bnCount());
            Console.writeString("  ops=");
            Console.writeLong(rt2.opCount());
            Console.writeLine("");
            int in2 = l2.tensorId("x");
            int out2 = l2.tensorId("y");
            if (in2 < 0 || out2 < 0) { Console.writeLine("standalone tensor not found"); return; }
            double[] buf2 = new double[128];
            readF32("./deeplearning/data/onnx/bn_std_input.f32", buf2, 64);
            i = 0;
            while (i < 64) { rt2.setFlat(in2, i, buf2[i]); i = i + 1; }
            rt2.run();
            double max2 = compareRef(out2, rt2, "/tmp/bn_std_ref.bin", 64);
            Console.writeString("standalone max diff: ");
            Console.writeFloat(max2);
            if (max2 < 1.0e-3) Console.writeLine("  BN STANDALONE OK");
            else Console.writeLine("  BN STANDALONE MISMATCH");

            // ---- 3) Conv→BN→Add→Relu（BN 仅与 Conv 融合、无 relu，接残差 Add）----
            // 回归 G4 修复：被 BN 融合的普通卷积不得错误套用 ReLU（nRelu_ 区分）
            InferenceRuntime rt3 = new InferenceRuntime();
            rt3.init(1024);
            OnnxLoader l3 = new OnnxLoader();
            int ok3 = l3.load("./deeplearning/data/onnx/bn_norelu_test.onnx", rt3);
            if (ok3 == 0) { Console.writeLine("bn_norelu load failed"); return; }
            Console.writeString("bn_norelu: bn_fused=");
            Console.writeLong(l3.bnCount());
            Console.writeString("  ops=");
            Console.writeLong(rt3.opCount());
            Console.writeLine("");
            int in3 = l3.tensorId("x");
            int out3 = l3.tensorId("y");
            if (in3 < 0 || out3 < 0) { Console.writeLine("bn_norelu tensor not found"); return; }
            double[] buf3 = new double[128];
            readF32("./deeplearning/data/onnx/bn_norelu_input.f32", buf3, 32);
            i = 0;
            while (i < 32) { rt3.setFlat(in3, i, buf3[i]); i = i + 1; }
            rt3.run();
            double max3 = compareRef(out3, rt3, "/tmp/bn_norelu_ref.bin", 32);
            Console.writeString("bn_norelu max diff: ");
            Console.writeFloat(max3);
            if (max3 < 1.0e-3) Console.writeLine("  BN NORELU OK");
            else Console.writeLine("  BN NORELU MISMATCH");
        }

        // 读 float32 二进制文件前 n 个到 out[]
        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        // 对比输出张量前 n 个元素与 float32 参考文件，返回最大绝对差
        double compareRef(int tid, InferenceRuntime rt, string path, int n) {
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                i = i + 1;
            }
            __myp_io_fclose();
            return maxD;
        }
}

int main() {
    BNTestApp app = new BNTestApp();
    return 0;
}
