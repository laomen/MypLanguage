// mnist_model.myp — Build MNIST 784->64->10 inference graph
import env;
import "./runtime.myp";

class MnistModel {
    action:
        void build(InferenceRuntime rt) {
            nIn = 784;
            nHid = 64;
            nOut = 10;

            inputTid = rt.addTensor(nIn, 1);
            w1Tid = rt.addTensor(nHid, nIn);
            b1Tid = rt.addTensor(nHid, 1);
            hTid = rt.addTensor(nHid, 1);
            hReluTid = rt.addTensor(nHid, 1);
            w2Tid = rt.addTensor(nOut, nHid);
            b2Tid = rt.addTensor(nOut, 1);
            logitsTid = rt.addTensor(nOut, 1);
            probTid = rt.addTensor(nOut, 1);

            rt.addDense(inputTid, w1Tid, b1Tid, hTid);
            rt.addRelu(hTid, hReluTid);
            rt.addDense(hReluTid, w2Tid, b2Tid, logitsTid);
            rt.addSoftmax(logitsTid, probTid);
        }

        void loadWeights(InferenceRuntime rt, double[] wh, double[] wo, double[] bh) {
            int i = 0;
            while (i < nHid * nIn) {
                rt.setFlat(w1Tid, i, wh[i]);
                i = i + 1;
            }

            i = 0;
            while (i < nOut * nHid) {
                rt.setFlat(w2Tid, i, wo[i]);
                i = i + 1;
            }

            i = 0;
            while (i < nHid) {
                rt.setFlat(b1Tid, i, bh[i]);
                i = i + 1;
            }

            i = 0;
            while (i < nOut) {
                rt.setFlat(b2Tid, i, bh[nHid + i]);
                i = i + 1;
            }
        }

        int infer(InferenceRuntime rt, double[] pixels, int baseOffset) {
            int j = 0;
            while (j < nIn) {
                rt.setFlat(inputTid, j, pixels[baseOffset + j]);
                j = j + 1;
            }
            rt.run();
            return rt.argmax1d(probTid);
        }

    property:
        int nIn;
        int nHid;
        int nOut;
        int inputTid;
        int w1Tid;
        int b1Tid;
        int hTid;
        int hReluTid;
        int w2Tid;
        int b2Tid;
        int logitsTid;
        int probTid;
}
