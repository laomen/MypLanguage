// gpu_ops.myp — GPU 算子（@gpu for 卸载 + M3 设备驻留，与 CPU 同一 arena 布局）
//
// 与 ops.myp 的 InferOps 语义一致，仅把 kernel 改为 @gpu for。
// - MYP_GPU=1 且有 CUDA 驱动时真正卸载到 GPU；
// - 否则 @gpu for 自动回退 CPU 顺序执行（结果一致）。
//
// M3 设备驻留（resident(a = dev)）：调用方（runGpu）先把整块 arena H2D 到
// GpuBufferF 一次，把 dev = arenaBuf.devicePtr() 传给每个算子；内核直接操作
// 设备内存，不再每个算子 H2D/D2H 整块搬运。循环上界 = work（实际输出数，
// 传输已跳过，无需再用足印上界）。
import env;
import math;
import atomic;

class GpuInferOps {
    static:
        // y = W x + b（batch 沿列；每线程算一个输出元素 + 串行归约 j）
        // n = arena 长度（传输范围），work = 有效输出数 = outDim*batch
        void dense(float[] a, int work, int xOff, int xRows, int wOff, int outDim, int batch, int bOff, int yOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long i = p / batch;
                    long k = p % batch;
                    float sum = a[bOff + i];
                    long j = 0L;
                    while (j < xRows) {
                        sum = sum + a[wOff + i * xRows + j] * a[xOff + j * batch + k];
                        j = j + 1L;
                    }
                    a[yOff + i * batch + k] = sum;
                }
            }
        }

        // y = W x（无偏置；batch 沿列）
        void matmul(float[] a, int work, int xOff, int xRows, int wOff, int outDim, int batch, int yOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long i = p / batch;
                    long k = p % batch;
                    float sum = 0.0f;
                    long j = 0L;
                    while (j < xRows) {
                        sum = sum + a[wOff + i * xRows + j] * a[xOff + j * batch + k];
                        j = j + 1L;
                    }
                    a[yOff + i * batch + k] = sum;
                }
            }
        }

        // 逐元素 ReLU
        void relu(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float v = a[inOff + p];
                    if (v > 0.0f) a[outOff + p] = v;
                    else a[outOff + p] = 0.0f;
                }
            }
        }

        // 逐元素 Sigmoid
        void sigmoid(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float x = a[inOff + p];
                    float e = float(Math.exp(0.0f - x));
                    a[outOff + p] = 1.0f / (1.0f + e);
                }
            }
        }

        // 每列一个样本，沿行 softmax（每线程重算列 max/sum）
        void softmax(float[] a, int work, int inOff, int outOff, int rows, int cols, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long i = p / cols;
                    long k = p % cols;
                    float m = a[inOff + 0 * cols + k];
                    long j = 1L;
                    while (j < rows) {
                        float v = a[inOff + j * cols + k];
                        if (v > m) m = v;
                        j = j + 1L;
                    }
                    float s = 0.0f;
                    j = 0L;
                    while (j < rows) {
                        s = s + float(Math.exp(a[inOff + j * cols + k] - m));
                        j = j + 1L;
                    }
                    a[outOff + i * cols + k] = float(Math.exp(a[inOff + i * cols + k] - m)) / s;
                }
            }
        }

        // 逐元素相加
        void add(float[] a, int work, int aOff, int bOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    a[outOff + p] = a[aOff + p] + a[bOff + p];
                }
            }
        }

        // ---- CNN：4D NCHW，每线程算一个输出元素 ----

        // 卷积（支持 group/strides/pads/dilations）
        // x: [N,C,H,W] flat N*C*H*W；w: [yC, C/group, kh, kw]；b: [yC]；y: [N,yC,yH,yW]
        void conv(float[] a, int work,
                  int xOff, int xN, int xC, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yH, int yW,
                  int kh, int kw,
                  int sh, int sw, int pt, int pb, int pl, int pr,
                  int dh, int dw, int group, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oc = (p / (yW * yH)) % yC;
                    long nn = p / (yW * yH * yC);
                    int cpg = xC / group;
                    int ocpg = yC / group;
                    long g = oc / ocpg;
                    int wc = cpg * kh * kw;
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + oc];   // 无偏置卷积（bOff=-1）
                    int ic = 0;
                    while (ic < cpg) {
                        long cIn = g * cpg + ic;
                        int ky = 0;
                        while (ky < kh) {
                            long iy = oy * sh - pt + ky * dh;
                            if (iy >= 0 && iy < xH) {
                                int kx = 0;
                                while (kx < kw) {
                                    long ix = ox * sw - pl + kx * dw;
                                    if (ix >= 0 && ix < xW) {
                                        sum = sum + a[xOff + nn * xC * xH * xW + cIn * xH * xW + iy * xW + ix]
                                                   * a[wOff + oc * wc + ic * kh * kw + ky * kw + kx];
                                    }
                                    kx = kx + 1;
                                }
                            }
                            ky = ky + 1;
                        }
                        ic = ic + 1;
                    }
                    a[yOff + p] = sum;
                }
            }
        }

        // ConvTranspose（转置卷积，group=1）：thread-per-output，权重 W[Cin,Cout,kh,kw]
        void convTranspose(float[] a, int work,
                  int xOff, int xN, int xC, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yH, int yW,
                  int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oc = (p / (yW * yH)) % yC;
                    long nn = p / (yW * yH * yC);
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + oc];
                    int ic = 0;
                    while (ic < xC) {
                        int ky = 0;
                        while (ky < kh) {
                            long inum = oy + pt - ky;
                            if (inum >= 0 && inum % sh == 0) {
                                long iy = inum / sh;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        long wnum = ox + pl - kx;
                                        if (wnum >= 0 && wnum % sw == 0) {
                                            long iw = wnum / sw;
                                            if (iw >= 0 && iw < xW) {
                                                sum = sum + a[xOff + nn * xC * xH * xW + ic * xH * xW + iy * xW + iw]
                                                           * a[wOff + ((ic * yC + oc) * kh + ky) * kw + kx];
                                            }
                                        }
                                        kx = kx + 1;
                                    }
                                }
                            }
                            ky = ky + 1;
                        }
                        ic = ic + 1;
                    }
                    a[yOff + p] = sum;
                }
            }
        }

        // Conv3D：thread-per-output（权重 [Cout,Cin,kd,kh,kw]）
        void conv3d(float[] a, int work,
                  int xOff, int xN, int xC, int xD, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yD, int yH, int yW,
                  int kd, int kh, int kw,
                  int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
                  int dd, int dh, int dw, int group, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oz = (p / (yW * yH)) % yD;
                    long oc = (p / (yW * yH * yD)) % yC;
                    long nn = p / (yW * yH * yD * yC);
                    int cpg = xC / group;
                    int ocpg = yC / group;
                    long g = oc / ocpg;
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + oc];
                    int ic = 0;
                    while (ic < cpg) {
                        long cIn = g * cpg + ic;
                        int kz = 0;
                        while (kz < kd) {
                            long iz = oz * sd - pdt + kz * dd;
                            if (iz >= 0 && iz < xD) {
                                int ky = 0;
                                while (ky < kh) {
                                    long iy = oy * sh - pt + ky * dh;
                                    if (iy >= 0 && iy < xH) {
                                        int kx = 0;
                                        while (kx < kw) {
                                            long ix = ox * sw - pl + kx * dw;
                                            if (ix >= 0 && ix < xW) {
                                                sum = sum + a[xOff + nn * xC * xD * xH * xW + cIn * xD * xH * xW + iz * xH * xW + iy * xW + ix]
                                                           * a[wOff + oc * (cpg * kd * kh * kw) + ic * kd * kh * kw + kz * kh * kw + ky * kw + kx];
                                            }
                                            kx = kx + 1;
                                        }
                                    }
                                    ky = ky + 1;
                                }
                            }
                            kz = kz + 1;
                        }
                        ic = ic + 1;
                    }
                    a[yOff + p] = sum;
                }
            }
        }

        // MaxPool3D：thread-per-output
        void maxpool3d(float[] a, int work,
                  int xOff, int xN, int xC, int xD, int xH, int xW,
                  int yOff, int yD, int yH, int yW,
                  int kd, int kh, int kw,
                  int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oz = (p / (yW * yH)) % yD;
                    long c = (p / (yW * yH * yD)) % xC;
                    long nn = p / (yW * yH * yD * xC);
                    float best = 0.0f - 1.0e30f;
                    int kz = 0;
                    while (kz < kd) {
                        long iz = oz * sd - pdt + kz;
                        if (iz >= 0 && iz < xD) {
                            int ky = 0;
                            while (ky < kh) {
                                long iy = oy * sh - pt + ky;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        long ix = ox * sw - pl + kx;
                                        if (ix >= 0 && ix < xW) {
                                            float v = a[xOff + nn * xC * xD * xH * xW + c * xD * xH * xW + iz * xH * xW + iy * xW + ix];
                                            if (v > best) best = v;
                                        }
                                        kx = kx + 1;
                                    }
                                }
                                ky = ky + 1;
                            }
                        }
                        kz = kz + 1;
                    }
                    a[yOff + p] = best;
                }
            }
        }

        // AveragePool3D：thread-per-output（支持各向异性核）
        void avgpool3d(float[] a, int work,
                  int xOff, int xN, int xC, int xD, int xH, int xW,
                  int yOff, int yD, int yH, int yW,
                  int kd, int kh, int kw,
                  int sd, int sh, int sw, int pdt, int pdb, int pt, int pb, int pl, int pr,
                  int cip, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oz = (p / (yW * yH)) % yD;
                    long c = (p / (yW * yH * yD)) % xC;
                    long nn = p / (yW * yH * yD * xC);
                    double sum = 0.0;
                    int cnt = 0;
                    int kz = 0;
                    while (kz < kd) {
                        long iz = oz * sd - pdt + kz;
                        if (iz >= 0 && iz < xD) {
                            int ky = 0;
                            while (ky < kh) {
                                long iy = oy * sh - pt + ky;
                                if (iy >= 0 && iy < xH) {
                                    int kx = 0;
                                    while (kx < kw) {
                                        long ix = ox * sw - pl + kx;
                                        if (ix >= 0 && ix < xW) {
                                            sum = sum + a[xOff + nn * xC * xD * xH * xW + c * xD * xH * xW + iz * xH * xW + iy * xW + ix];
                                            cnt = cnt + 1;
                                        }
                                        kx = kx + 1;
                                    }
                                }
                                ky = ky + 1;
                            }
                        }
                        kz = kz + 1;
                    }
                    int div = cnt;
                    if (cip == 1) div = kd * kh * kw;
                    if (div < 1) div = 1;
                    a[yOff + p] = float(sum / div);
                }
            }
        }

        // 融合 Conv+ReLU（G1）：卷积输出直接过 ReLU，不写回中间张量（少一次
        // kernel 启动 + 少一次中间张量读写）。参数与 conv 相同，y 处写 max(sum,0)。
        void convRelu(float[] a, int work,
                  int xOff, int xN, int xC, int xH, int xW,
                  int wOff, int bOff,
                  int yOff, int yC, int yH, int yW,
                  int kh, int kw,
                  int sh, int sw, int pt, int pb, int pl, int pr,
                  int dh, int dw, int group, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long oc = (p / (yW * yH)) % yC;
                    long nn = p / (yW * yH * yC);
                    int cpg = xC / group;
                    int ocpg = yC / group;
                    long g = oc / ocpg;
                    int wc = cpg * kh * kw;
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + oc];   // 无偏置卷积（bOff=-1）
                    int ic = 0;
                    while (ic < cpg) {
                        long cIn = g * cpg + ic;
                        int ky = 0;
                        while (ky < kh) {
                            long iy = oy * sh - pt + ky * dh;
                            if (iy >= 0 && iy < xH) {
                                int kx = 0;
                                while (kx < kw) {
                                    long ix = ox * sw - pl + kx * dw;
                                    if (ix >= 0 && ix < xW) {
                                        sum = sum + a[xOff + nn * xC * xH * xW + cIn * xH * xW + iy * xW + ix]
                                                   * a[wOff + oc * wc + ic * kh * kw + ky * kw + kx];
                                    }
                                    kx = kx + 1;
                                }
                            }
                            ky = ky + 1;
                        }
                        ic = ic + 1;
                    }
                    if (sum > 0.0f) a[yOff + p] = sum;
                    else a[yOff + p] = 0.0f;
                }
            }
        }

        // 最大池化：x: [N,C,H,W] → y: [N,C,yH,yW]
        void maxpool(float[] a, int work,
                     int xOff, int xN, int xC, int xH, int xW,
                     int yOff, int yH, int yW,
                     int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long c = (p / (yW * yH)) % xC;
                    long nn = p / (yW * yH * xC);
                    float best = 0.0f - 1.0e30f;
                    int ky = 0;
                    while (ky < kh) {
                        long iy = oy * sh - pt + ky;
                        if (iy >= 0 && iy < xH) {
                            int kx = 0;
                            while (kx < kw) {
                                long ix = ox * sw - pl + kx;
                                if (ix >= 0 && ix < xW) {
                                    float v = a[xOff + nn * xC * xH * xW + c * xH * xW + iy * xW + ix];
                                    if (v > best) best = v;
                                }
                                kx = kx + 1;
                            }
                        }
                        ky = ky + 1;
                    }
                    a[yOff + p] = best;
                }
            }
        }

        // AveragePool：x: [N,C,H,W] → y: [N,C,yH,yW]（thread-per-output；cip=count_include_pad）
        void avgpool(float[] a, int work,
                     int xOff, int xN, int xC, int xH, int xW,
                     int yOff, int yH, int yW,
                     int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr, int cip, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long ox = p % yW;
                    long oy = (p / yW) % yH;
                    long c = (p / (yW * yH)) % xC;
                    long nn = p / (yW * yH * xC);
                    float sum = 0.0f;
                    int cnt = 0;
                    int ky = 0;
                    while (ky < kh) {
                        long iy = oy * sh - pt + ky;
                        if (iy >= 0 && iy < xH) {
                            int kx = 0;
                            while (kx < kw) {
                                long ix = ox * sw - pl + kx;
                                if (ix >= 0 && ix < xW) {
                                    sum = sum + a[xOff + nn * xC * xH * xW + c * xH * xW + iy * xW + ix];
                                    cnt = cnt + 1;
                                }
                                kx = kx + 1;
                            }
                        }
                        ky = ky + 1;
                    }
                    if (cip == 1) cnt = kh * kw;
                    if (cnt > 0) a[yOff + p] = sum / cnt;
                    else a[yOff + p] = 0.0f;
                }
            }
        }

        // Pad：constant/reflect/edge（thread-per-output；mode 0=const,1=reflect,2=edge）
        void pad(float[] a, int work,
                 int xOff, int xN, int xC, int xH, int xW,
                 int yOff, int yN, int yC, int yH, int yW,
                 int pnB, int pcB, int phB, int pwB, int pnE, int pcE, int phE, int pwE,
                 int mode, double cval, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long w = p % yW;
                    long t = p / yW;
                    long h = t % yH;
                    t = t / yH;
                    long c = t % yC;
                    long n = t / yC;
                    long sn = n - pnB;
                    long sc = c - pcB;
                    long sh = h - phB;
                    long sw = w - pwB;
                    int inb = 1;
                    if (sn < 0 || sn >= xN) inb = 0;
                    if (sc < 0 || sc >= xC) inb = 0;
                    if (sh < 0 || sh >= xH) inb = 0;
                    if (sw < 0 || sw >= xW) inb = 0;
                    float v = 0.0f;
                    if (inb == 1) {
                        v = a[xOff + ((sn * xC + sc) * xH + sh) * xW + sw];
                    } else if (mode == 1) {
                        if (sn < 0) sn = 0L - sn;
                        if (sc < 0) sc = 0L - sc;
                        if (sh < 0) sh = 0L - sh;
                        if (sw < 0) sw = 0L - sw;
                        if (sn >= xN) sn = long(2 * (xN - 1)) - sn;
                        if (sc >= xC) sc = long(2 * (xC - 1)) - sc;
                        if (sh >= xH) sh = long(2 * (xH - 1)) - sh;
                        if (sw >= xW) sw = long(2 * (xW - 1)) - sw;
                        v = a[xOff + ((sn * xC + sc) * xH + sh) * xW + sw];
                    } else if (mode == 2) {
                        if (sn < 0) sn = 0L;
                        if (sc < 0) sc = 0L;
                        if (sh < 0) sh = 0L;
                        if (sw < 0) sw = 0L;
                        if (sn >= xN) sn = long(xN - 1);
                        if (sc >= xC) sc = long(xC - 1);
                        if (sh >= xH) sh = long(xH - 1);
                        if (sw >= xW) sw = long(xW - 1);
                        v = a[xOff + ((sn * xC + sc) * xH + sh) * xW + sw];
                    } else {
                        v = float(cval);
                    }
                    a[yOff + p] = v;
                }
            }
        }

        // Pad3D：thread-per-output（5D，10 个 pad）
        void pad3d(float[] a, int work,
                 int xOff, int xN, int xC, int xD, int xH, int xW,
                 int yOff, int yN, int yC, int yD, int yH, int yW,
                 int pnB, int pnE, int pcB, int pcE, int pdB, int pdE, int phB, int phE, int pwB, int pwE,
                 int mode, double cval, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long w = p % yW;
                    long t = p / yW;
                    long h = t % yH;
                    t = t / yH;
                    long d = t % yD;
                    t = t / yD;
                    long c = t % yC;
                    long n = t / yC;
                    long sn = n - pnB;
                    long sc = c - pcB;
                    long sd = d - pdB;
                    long sh = h - phB;
                    long sw = w - pwB;
                    int inb = 1;
                    if (sn < 0 || sn >= xN) inb = 0;
                    if (sc < 0 || sc >= xC) inb = 0;
                    if (sd < 0 || sd >= xD) inb = 0;
                    if (sh < 0 || sh >= xH) inb = 0;
                    if (sw < 0 || sw >= xW) inb = 0;
                    float v = 0.0f;
                    if (inb == 1) {
                        v = a[xOff + (((sn * xC + sc) * xD + sd) * xH + sh) * xW + sw];
                    } else if (mode == 1) {
                        if (sn < 0) sn = 0L - sn;
                        if (sc < 0) sc = 0L - sc;
                        if (sd < 0) sd = 0L - sd;
                        if (sh < 0) sh = 0L - sh;
                        if (sw < 0) sw = 0L - sw;
                        if (sn >= xN) sn = long(2 * (xN - 1)) - sn;
                        if (sc >= xC) sc = long(2 * (xC - 1)) - sc;
                        if (sd >= xD) sd = long(2 * (xD - 1)) - sd;
                        if (sh >= xH) sh = long(2 * (xH - 1)) - sh;
                        if (sw >= xW) sw = long(2 * (xW - 1)) - sw;
                        v = a[xOff + (((sn * xC + sc) * xD + sd) * xH + sh) * xW + sw];
                    } else if (mode == 2) {
                        if (sn < 0) sn = 0L;
                        if (sc < 0) sc = 0L;
                        if (sd < 0) sd = 0L;
                        if (sh < 0) sh = 0L;
                        if (sw < 0) sw = 0L;
                        if (sn >= xN) sn = long(xN - 1);
                        if (sc >= xC) sc = long(xC - 1);
                        if (sd >= xD) sd = long(xD - 1);
                        if (sh >= xH) sh = long(xH - 1);
                        if (sw >= xW) sw = long(xW - 1);
                        v = a[xOff + (((sn * xC + sc) * xD + sd) * xH + sh) * xW + sw];
                    } else {
                        v = float(cval);
                    }
                    a[yOff + p] = v;
                }
            }
        }

        // 全局平均池化：x: [N,C,H,W] → y: [N,C,1,1]（work = N*C）
        void gapool(float[] a, int work,
                    int xOff, int xN, int xC, int xH, int xW, int yOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % xC;
                    long nn = p / xC;
                    float sum = 0.0f;
                    int i = 0;
                    while (i < xH * xW) {
                        sum = sum + a[xOff + nn * xC * xH * xW + c * xH * xW + i];
                        i = i + 1;
                    }
                    a[yOff + p] = sum / float(xH * xW);
                }
            }
        }

        // Flatten：数据连续，直接拷贝
        void flatten(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    a[outOff + p] = a[inOff + p];
                }
            }
        }

        // ---- G2：NHWC 布局（x:[N,H,W,C] 行优先）----

        // NCHW→NHWC 转置：x:[N,C,H,W] → y:[N,H,W,C]（每线程一个元素）
        void transposeNCHW2NHWC(float[] a, int work,
                int xOff, int xN, int xC, int xH, int xW, int yOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % xC;
                    long h = (p / xC) % xH;
                    long w = (p / (xC * xH)) % xW;
                    long nn = p / (xC * xH * xW);
                    a[yOff + ((nn * xH + h) * xW + w) * xC + c] = a[xOff + ((nn * xC + c) * xH + h) * xW + w];
                }
            }
        }

        // NHWC 卷积：x:[N,H,W,Cin]，w:[Cout,KH,KW,Cin]，b:[Cout]，y:[N,Hout,Wout,Cout]
        // 每线程算一个输出元素（co,ox,oy,nn），串行归约 cpg*kh*kw
        void convNHWC(float[] a, int work,
                int xOff, int xN, int xH, int xW, int xC,
                int wOff, int bOff,
                int yOff, int yH, int yW, int yC,
                int kh, int kw,
                int sh, int sw, int pt, int pb, int pl, int pr,
                int dh, int dw, int group, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long co = p % yC;
                    long ox = (p / yC) % yW;
                    long oy = (p / (yC * yW)) % yH;
                    long nn = p / (yC * yW * yH);
                    int cpg = xC / group;
                    int ocpg = yC / group;
                    long g = co / ocpg;
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + co];   // 无偏置卷积（bOff=-1）
                    int ky = 0;
                    while (ky < kh) {
                        long iy = oy * sh - pt + ky * dh;
                        if (iy >= 0 && iy < xH) {
                            int kx = 0;
                            while (kx < kw) {
                                long ix = ox * sw - pl + kx * dw;
                                if (ix >= 0 && ix < xW) {
                                    int ic = 0;
                                    while (ic < cpg) {
                                        long cIn = g * cpg + ic;
                                        sum = sum + a[xOff + ((nn * xH + iy) * xW + ix) * xC + cIn]
                                                   * a[wOff + ((co * kh + ky) * kw + kx) * cpg + ic];
                                        ic = ic + 1;
                                    }
                                }
                                kx = kx + 1;
                            }
                        }
                        ky = ky + 1;
                    }
                    a[yOff + p] = sum;
                }
            }
        }

        // NHWC 卷积 + ReLU（G1 融合的 NHWC 对应）：y 处写 max(sum,0)
        void convNHWCRelu(float[] a, int work,
                int xOff, int xN, int xH, int xW, int xC,
                int wOff, int bOff,
                int yOff, int yH, int yW, int yC,
                int kh, int kw,
                int sh, int sw, int pt, int pb, int pl, int pr,
                int dh, int dw, int group, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long co = p % yC;
                    long ox = (p / yC) % yW;
                    long oy = (p / (yC * yW)) % yH;
                    long nn = p / (yC * yW * yH);
                    int cpg = xC / group;
                    int ocpg = yC / group;
                    long g = co / ocpg;
                    float sum = 0.0f;
                    if (bOff >= 0) sum = a[bOff + co];   // 无偏置卷积（bOff=-1）
                    int ky = 0;
                    while (ky < kh) {
                        long iy = oy * sh - pt + ky * dh;
                        if (iy >= 0 && iy < xH) {
                            int kx = 0;
                            while (kx < kw) {
                                long ix = ox * sw - pl + kx * dw;
                                if (ix >= 0 && ix < xW) {
                                    int ic = 0;
                                    while (ic < cpg) {
                                        long cIn = g * cpg + ic;
                                        sum = sum + a[xOff + ((nn * xH + iy) * xW + ix) * xC + cIn]
                                                   * a[wOff + ((co * kh + ky) * kw + kx) * cpg + ic];
                                        ic = ic + 1;
                                    }
                                }
                                kx = kx + 1;
                            }
                        }
                        ky = ky + 1;
                    }
                    if (sum > 0.0f) a[yOff + p] = sum;
                    else a[yOff + p] = 0.0f;
                }
            }
        }

        // NHWC 最大池化：x:[N,H,W,C] → y:[N,yH,yW,C]
        void maxpoolNHWC(float[] a, int work,
                int xOff, int xN, int xH, int xW, int xC,
                int yOff, int yH, int yW,
                int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % xC;
                    long ox = (p / xC) % yW;
                    long oy = (p / (xC * yW)) % yH;
                    long nn = p / (xC * yW * yH);
                    float best = 0.0f - 1.0e30f;
                    int ky = 0;
                    while (ky < kh) {
                        long iy = oy * sh - pt + ky;
                        if (iy >= 0 && iy < xH) {
                            int kx = 0;
                            while (kx < kw) {
                                long ix = ox * sw - pl + kx;
                                if (ix >= 0 && ix < xW) {
                                    float v = a[xOff + ((nn * xH + iy) * xW + ix) * xC + c];
                                    if (v > best) best = v;
                                }
                                kx = kx + 1;
                            }
                        }
                        ky = ky + 1;
                    }
                    a[yOff + p] = best;
                }
            }
        }

        // AveragePool（NHWC）：x:[N,H,W,C] → y:[N,yH,yW,C]
        void avgpoolNHWC(float[] a, int work,
                int xOff, int xN, int xH, int xW, int xC,
                int yOff, int yH, int yW,
                int kh, int kw, int sh, int sw, int pt, int pb, int pl, int pr, int cip, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % xC;
                    long ox = (p / xC) % yW;
                    long oy = (p / (xC * yW)) % yH;
                    long nn = p / (xC * yW * yH);
                    float sum = 0.0f;
                    int cnt = 0;
                    int ky = 0;
                    while (ky < kh) {
                        long iy = oy * sh - pt + ky;
                        if (iy >= 0 && iy < xH) {
                            int kx = 0;
                            while (kx < kw) {
                                long ix = ox * sw - pl + kx;
                                if (ix >= 0 && ix < xW) {
                                    sum = sum + a[xOff + ((nn * xH + iy) * xW + ix) * xC + c];
                                    cnt = cnt + 1;
                                }
                                kx = kx + 1;
                            }
                        }
                        ky = ky + 1;
                    }
                    if (cip == 1) cnt = kh * kw;
                    if (cnt > 0) a[yOff + p] = sum / cnt;
                    else a[yOff + p] = 0.0f;
                }
            }
        }

        // Pad（NHWC）：x:[N,H,W,C] → y:[N,yH,yW,C]
        void padNHWC(float[] a, int work,
                 int xOff, int xN, int xH, int xW, int xC,
                 int yOff, int yN, int yH, int yW, int yC,
                 int pnB, int phB, int pwB, int pcB, int pnE, int phE, int pwE, int pcE,
                 int mode, double cval, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % yC;
                    long t = p / yC;
                    long w = t % yW;
                    t = t / yW;
                    long h = t % yH;
                    long n = t / yH;
                    long sn = n - pnB;
                    long sc = c - pcB;
                    long sh = h - phB;
                    long sw = w - pwB;
                    int inb = 1;
                    if (sn < 0 || sn >= xN) inb = 0;
                    if (sc < 0 || sc >= xC) inb = 0;
                    if (sh < 0 || sh >= xH) inb = 0;
                    if (sw < 0 || sw >= xW) inb = 0;
                    float v = 0.0f;
                    if (inb == 1) {
                        v = a[xOff + ((sn * xH + sh) * xW + sw) * xC + sc];
                    } else if (mode == 1) {
                        if (sn < 0) sn = 0L - sn;
                        if (sc < 0) sc = 0L - sc;
                        if (sh < 0) sh = 0L - sh;
                        if (sw < 0) sw = 0L - sw;
                        if (sn >= xN) sn = long(2 * (xN - 1)) - sn;
                        if (sc >= xC) sc = long(2 * (xC - 1)) - sc;
                        if (sh >= xH) sh = long(2 * (xH - 1)) - sh;
                        if (sw >= xW) sw = long(2 * (xW - 1)) - sw;
                        v = a[xOff + ((sn * xH + sh) * xW + sw) * xC + sc];
                    } else if (mode == 2) {
                        if (sn < 0) sn = 0L;
                        if (sc < 0) sc = 0L;
                        if (sh < 0) sh = 0L;
                        if (sw < 0) sw = 0L;
                        if (sn >= xN) sn = long(xN - 1);
                        if (sc >= xC) sc = long(xC - 1);
                        if (sh >= xH) sh = long(xH - 1);
                        if (sw >= xW) sw = long(xW - 1);
                        v = a[xOff + ((sn * xH + sh) * xW + sw) * xC + sc];
                    } else {
                        v = float(cval);
                    }
                    a[yOff + p] = v;
                }
            }
        }

        // NHWC 全局平均池化：x:[N,H,W,C] → y:[N,C]（work = N*C）
        void gapoolNHWC(float[] a, int work,
                int xOff, int xN, int xH, int xW, int xC, int yOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % xC;
                    long nn = p / xC;
                    float sum = 0.0f;
                    int i = 0;
                    while (i < xH * xW) {
                        long h = i / xW;
                        long w = i % xW;
                        sum = sum + a[xOff + ((nn * xH + h) * xW + w) * xC + c];
                        i = i + 1;
                    }
                    a[yOff + p] = sum / float(xH * xW);
                }
            }
        }

        // ---- G3：BatchNormalization ----
        // 每线程一个元素；通道 = (p/(H*W))%C（NCHW）。eps 由宿主解析传入，
        // Math.sqrt → libdevice __nv_sqrt；内核局部用 float（与 ORT float32 输出一致，
        // 混型运算已支持，double 局部也可用但无需更高精度）。
        void batchnorm(float[] a, int work,
                       int xOff, int xN, int xC, int xH, int xW, int yOff,
                       int sOff, int bOff, int mOff, int vOff, double eps, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = (p / (xH * xW)) % xC;
                    float scale = a[sOff + c];
                    float mean = a[mOff + c];
                    float variance = a[vOff + c];
                    float bias = a[bOff + c];
                    float invStd = scale / float(Math.sqrt(float(variance) + float(eps)));
                    a[yOff + p] = float((a[xOff + p] - mean) * invStd + bias);
                }
            }
        }

        // G3：BatchNormalization（NHWC）：通道 = p % C
        void batchnormNHWC(float[] a, int work,
                           int xOff, int xN, int xH, int xW, int xC, int yOff,
                           int sOff, int bOff, int mOff, int vOff, double eps, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    long c = p % xC;
                    float scale = a[sOff + c];
                    float mean = a[mOff + c];
                    float variance = a[vOff + c];
                    float bias = a[bOff + c];
                    float invStd = scale / float(Math.sqrt(float(variance) + float(eps)));
                    a[yOff + p] = float((a[xOff + p] - mean) * invStd + bias);
                }
            }
        }

        // ---- G4：通用激活（逐元素，布局无关）----
        // ReLU6：y = min(max(x,0),6)
        void relu6(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float v = a[inOff + p];
                    if (v > 6.0f) v = 6.0f;
                    if (v < 0.0f) v = 0.0f;
                    a[outOff + p] = v;
                }
            }
        }
        // LeakyRelu：y = x>0 ? x : alpha*x
        void leakyrelu(float[] a, int work, int inOff, int outOff, double alpha, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float v = a[inOff + p];
                    if (v > 0.0f) a[outOff + p] = v;
                    else a[outOff + p] = float(alpha) * v;
                }
            }
        }
        // SiLU / Swish：y = x * sigmoid(x) = x / (1 + exp(-x))
        void silu(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float x = a[inOff + p];
                    float s = x / float(1.0 + Math.exp(0.0f - x));
                    a[outOff + p] = s;
                }
            }
        }
        // HardSwish：y = x * relu6(x+3) / 6
        void hardswish(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float x = a[inOff + p];
                    float r = x + 3.0f;
                    if (r < 0.0f) r = 0.0f;
                    if (r > 6.0f) r = 6.0f;
                    a[outOff + p] = x * r / 6.0f;
                }
            }
        }
        // Clip：y = clamp(x, min, max)；minOff/maxOff 为标量边界偏移（-1 = 不限）
        void clip(float[] a, int work, int inOff, int outOff, int minOff, int maxOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float v = a[inOff + p];
                    if (minOff >= 0 && v < a[minOff + 0]) v = a[minOff + 0];
                    if (maxOff >= 0 && v > a[maxOff + 0]) v = a[maxOff + 0];
                    a[outOff + p] = v;
                }
            }
        }

        // ---- F8：张量操作（Reshape / Concat / Transpose）----
        // Reshape：连续拷贝
        void copyFlat(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    a[outOff + p] = a[inOff + p];
                }
            }
        }
        // Concat：沿 axis 拼接 2-3 输入
        void concat(float[] a, int work, int off0, int off1, int off2, int offO,
                    int od0, int od1, int od2, int od3,
                    int ax0, int ax1, int ax2, int axis, int nIn, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int i = int(p);
                    int x3 = i % od3;
                    int t = i / od3;
                    int x2 = t % od2;
                    t = t / od2;
                    int x1 = t % od1;
                    int x0 = t / od1;
                    int ac = x3;
                    if (axis == 0) ac = x0;
                    else if (axis == 1) ac = x1;
                    else if (axis == 2) ac = x2;
                    int which = 0;
                    int local = ac;
                    int aLen = ax0;
                    if (local >= aLen) {
                        local = local - aLen;
                        which = 1;
                        aLen = ax1;
                        if (nIn >= 3 && local >= aLen) { local = local - aLen; which = 2; aLen = ax2; }
                    }
                    int inOff = off0;
                    if (which == 1) inOff = off1;
                    else if (which == 2) inOff = off2;
                    int inFlat = 0;
                    if (axis == 0) inFlat = ((local * od1 + x1) * od2 + x2) * od3 + x3;
                    else if (axis == 1) inFlat = ((x0 * aLen + local) * od2 + x2) * od3 + x3;
                    else if (axis == 2) inFlat = ((x0 * od1 + x1) * aLen + local) * od3 + x3;
                    else inFlat = ((x0 * od1 + x1) * od2 + x2) * aLen + local;
                    a[offO + i] = a[inOff + inFlat];
                }
            }
        }
        // Transpose：按 perm 转置 4D（pc = perm 元素数，0 = 缺省反转）
        void transpose(float[] a, int work, int offIn, int offOut,
                       int id0, int id1, int id2, int id3,
                       int p0, int p1, int p2, int p3, int pc, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int perm0 = p0, perm1 = p1, perm2 = p2, perm3 = p3;
                    if (pc == 0) { perm0 = 3; perm1 = 2; perm2 = 1; perm3 = 0; }
                    else if (pc == 1) { perm1 = 1; perm2 = 2; perm3 = 3; }
                    else if (pc == 2) { perm2 = 2; perm3 = 3; }
                    else if (pc == 3) { perm3 = 3; }
                    int od0 = id3, od1 = id3, od2 = id3, od3 = id3;
                    if (perm0 == 0) od0 = id0; else if (perm0 == 1) od0 = id1; else if (perm0 == 2) od0 = id2;
                    if (perm1 == 0) od1 = id0; else if (perm1 == 1) od1 = id1; else if (perm1 == 2) od1 = id2;
                    if (perm2 == 0) od2 = id0; else if (perm2 == 1) od2 = id1; else if (perm2 == 2) od2 = id2;
                    if (perm3 == 0) od3 = id0; else if (perm3 == 1) od3 = id1; else if (perm3 == 2) od3 = id2;
                    int inv0 = 3, inv1 = 3, inv2 = 3, inv3 = 3;
                    if (perm0 == 0) inv0 = 0; else if (perm1 == 0) inv0 = 1; else if (perm2 == 0) inv0 = 2;
                    if (perm0 == 1) inv1 = 0; else if (perm1 == 1) inv1 = 1; else if (perm2 == 1) inv1 = 2;
                    if (perm0 == 2) inv2 = 0; else if (perm1 == 2) inv2 = 1; else if (perm2 == 2) inv2 = 2;
                    if (perm0 == 3) inv3 = 0; else if (perm1 == 3) inv3 = 1; else if (perm2 == 3) inv3 = 2;
                    int i = int(p);
                    int o3 = i % od3;
                    int t = i / od3;
                    int o2 = t % od2;
                    t = t / od2;
                    int o1 = t % od1;
                    int o0 = t / od1;
                    int i0 = o3, i1 = o3, i2 = o3, i3 = o3;
                    if (inv0 == 0) i0 = o0; else if (inv0 == 1) i0 = o1; else if (inv0 == 2) i0 = o2;
                    if (inv1 == 0) i1 = o0; else if (inv1 == 1) i1 = o1; else if (inv1 == 2) i1 = o2;
                    if (inv2 == 0) i2 = o0; else if (inv2 == 1) i2 = o1; else if (inv2 == 2) i2 = o2;
                    if (inv3 == 0) i3 = o0; else if (inv3 == 1) i3 = o1; else if (inv3 == 2) i3 = o2;
                    int inFlat = ((i0 * id1 + i1) * id2 + i2) * id3 + i3;
                    a[offOut + i] = a[offIn + inFlat];
                }
            }
        }
        // Slice：沿任意轴切片（支持负 step 反向）；轴循环展开（GPU codegen 不支持内核内 while）
        void sliceOp(float[] a, int work, int offIn, int offOut,
                     int cnt, int id0, int id1, int id2, int id3,
                     int od0, int od1, int od2, int od3,
                     int ax0, int st0, int sp0, int ax1, int st1, int sp1,
                     int ax2, int st2, int sp2, int ax3, int st3, int sp3, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int i = int(p);
                    int x3 = i % od3;
                    int t = i / od3;
                    int x2 = t % od2;
                    t = t / od2;
                    int x1 = t % od1;
                    int x0 = t / od1;
                    int c0 = x0, c1 = x1, c2 = x2, c3 = x3;
                    int oc = x0; int ic = 0;
                    if (cnt >= 1) {
                        oc = x0;
                        if (ax0 == 0) oc = x0; else if (ax0 == 1) oc = x1; else if (ax0 == 2) oc = x2; else oc = x3;
                        ic = st0 + oc * sp0;
                        if (ax0 == 0) c0 = ic; else if (ax0 == 1) c1 = ic; else if (ax0 == 2) c2 = ic; else c3 = ic;
                    }
                    if (cnt >= 2) {
                        oc = x0;
                        if (ax1 == 0) oc = x0; else if (ax1 == 1) oc = x1; else if (ax1 == 2) oc = x2; else oc = x3;
                        ic = st1 + oc * sp1;
                        if (ax1 == 0) c0 = ic; else if (ax1 == 1) c1 = ic; else if (ax1 == 2) c2 = ic; else c3 = ic;
                    }
                    if (cnt >= 3) {
                        oc = x0;
                        if (ax2 == 0) oc = x0; else if (ax2 == 1) oc = x1; else if (ax2 == 2) oc = x2; else oc = x3;
                        ic = st2 + oc * sp2;
                        if (ax2 == 0) c0 = ic; else if (ax2 == 1) c1 = ic; else if (ax2 == 2) c2 = ic; else c3 = ic;
                    }
                    if (cnt >= 4) {
                        oc = x0;
                        if (ax3 == 0) oc = x0; else if (ax3 == 1) oc = x1; else if (ax3 == 2) oc = x2; else oc = x3;
                        ic = st3 + oc * sp3;
                        if (ax3 == 0) c0 = ic; else if (ax3 == 1) c1 = ic; else if (ax3 == 2) c2 = ic; else c3 = ic;
                    }
                    int inFlat = ((c0 * id1 + c1) * id2 + c2) * id3 + c3;
                    a[offOut + i] = a[offIn + inFlat];
                }
            }
        }

        // ---- F8：秩无关逐元素 / 规约 / 归一化 / 分割 / 上采样（GPU）----
        // Sub：y = a - b（bSize==1 标量；bSize==n 同尺寸；bSize==C 逐通道广播）
        void sub(float[] a, int work, int aOff, int bOff, int outOff, int bSize, int C, int S, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float bv = 0.0f;
                    if (bSize <= 1) bv = a[bOff + 0];
                    float v = a[aOff + p];
                    if (bSize <= 1) a[outOff + p] = v - bv;
                    else if (bSize == work) a[outOff + p] = v - a[bOff + p];
                    else a[outOff + p] = v - a[bOff + (int(p) / S) % C];
                }
            }
        }
        // Div：y = a / b
        void div(float[] a, int work, int aOff, int bOff, int outOff, int bSize, int C, int S, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float bv = 0.0f;
                    if (bSize <= 1) bv = a[bOff + 0];
                    float v = a[aOff + p];
                    if (bSize <= 1) a[outOff + p] = v / bv;
                    else if (bSize == work) a[outOff + p] = v / a[bOff + p];
                    else a[outOff + p] = v / a[bOff + (int(p) / S) % C];
                }
            }
        }
        // Mul：y = a * b
        void mul(float[] a, int work, int aOff, int bOff, int outOff, int bSize, int C, int S, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    float bv = 0.0f;
                    if (bSize <= 1) bv = a[bOff + 0];
                    float v = a[aOff + p];
                    if (bSize <= 1) a[outOff + p] = v * bv;
                    else if (bSize == work) a[outOff + p] = v * a[bOff + p];
                    else a[outOff + p] = v * a[bOff + (int(p) / S) % C];
                }
            }
        }
        // Sqrt：y = sqrt(x)
        void sqrt1(float[] a, int work, int inOff, int outOff, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    a[outOff + p] = float(Math.sqrt(a[inOff + p]));
                }
            }
        }
        // InstanceNormalization：逐 (n,c) 线程，S 上归约（float 累加）
        // 激进优化（2026-08-12）：3 阶段满并行，替代原"每通道 1 线程 × 串行 3 趟"
        // （原实现 work=N*C 个线程，每线程串行 3 趟 7M double → GPU 欠利用，占推理 87%）。
        //   P1：grid-stride 每线程寄存器累加 Σx → 每线程 1 次 double 原子入 sums[nc]
        //   P2：grid-stride 每线程寄存器累加 Σ(x-mean)² → 原子入 sqs[nc]
        //   Host：mean / invStd=scale/sqrt(var+eps)（每通道 nC 个）
        //   P3：thread-per-element 归一化（满并行）
        // 精度：保持 double 累加 + 两趟（与 CPU/ORT 一致）；仅求和顺序变（~1e-15）。
        // scale/bias 是只读 Constant，host arena 未被设备改写，可 host 读。
        // 激进优化（全 resident 单数组版，2026-08-12）：3 阶段满并行，替代原
        // "每通道 1 线程 × 串行 3 趟"（原 412ms/层，占推理 87%）。
        // 约束（已验证）：@gpu for 只能可靠使用"单数组 resident(a=dev)"；多数组/
        // 原子路径均坏。故 stats（partials/mean/invStd）写入 arena 尾部预留区 stOff，
        // 全部在设备上计算，host 不介入。精度：partial 存 float（均值误差~1e-7，
        // 因除以大 S 后被稀释），保持两趟 double 累加语义。
        // K1: grid-stride Σx → p1   K2: 每通道 Σp1 → mean
        // K3: grid-stride Σ(x-mean)² → p2   K4: 每通道 Σp2 → variance, invStd
        // K5: thread-per-element 归一化
        void instancenorm(float[] a, int work, int xOff, int sOff, int bOff, int yOff,
                          int N, int C, int S, double eps, long dev, int stOff) {
            int nC = work;
            long total = long(nC) * long(S);
            int pt = 512;                 // 每通道归约线程数
            long nTh = long(nC) * long(pt);
            int p1Off = stOff;
            int p2Off = stOff + nC * pt;
            int mnOff = stOff + 2 * nC * pt;
            int ivOff = mnOff + nC;
            // K1：grid-stride Σx → p1
            @gpu for (long p = 0L; p < nTh; p = p + 1L) resident(a = dev) {
                if (p < nTh) {
                    int nc1 = int(p / long(pt));
                    int b1 = int(p % long(pt));
                    long base1 = long(nc1) * long(S);
                    double acc1 = 0.0;
                    long q1 = base1 + long(b1);
                    while (q1 < base1 + long(S)) {
                        double xv1 = a[xOff + int(q1)];
                        acc1 = acc1 + xv1;
                        q1 = q1 + long(pt);
                    }
                    a[p1Off + nc1 * pt + b1] = float(acc1);
                }
            }
            // K2：每通道 mean = Σp1 / S
            @gpu for (long p = 0L; p < long(nC); p = p + 1L) resident(a = dev) {
                if (p < nC) {
                    int c2 = int(p);
                    double s2 = 0.0;
                    int b2 = 0;
                    while (b2 < pt) {
                        double v2 = a[p1Off + c2 * pt + b2];
                        s2 = s2 + v2;
                        b2 = b2 + 1;
                    }
                    a[mnOff + c2] = float(s2 / S);
                }
            }
            // K3：grid-stride Σ(x-mean)² → p2
            @gpu for (long p = 0L; p < nTh; p = p + 1L) resident(a = dev) {
                if (p < nTh) {
                    int nc3 = int(p / long(pt));
                    int b3 = int(p % long(pt));
                    long base3 = long(nc3) * long(S);
                    double mn3 = a[mnOff + nc3];
                    double acc3 = 0.0;
                    long q3 = base3 + long(b3);
                    while (q3 < base3 + long(S)) {
                        double xv3 = a[xOff + int(q3)];
                        double d3 = xv3 - mn3;
                        acc3 = acc3 + d3 * d3;
                        q3 = q3 + long(pt);
                    }
                    a[p2Off + nc3 * pt + b3] = float(acc3);
                }
            }
            // K4：每通道 variance / invStd = scale / sqrt(var+eps)
            @gpu for (long p = 0L; p < long(nC); p = p + 1L) resident(a = dev) {
                if (p < nC) {
                    int c4 = int(p);
                    double sq4 = 0.0;
                    int b4 = 0;
                    while (b4 < pt) {
                        double v4 = a[p2Off + c4 * pt + b4];
                        sq4 = sq4 + v4;
                        b4 = b4 + 1;
                    }
                    double variance = sq4 / S;
                    double scale = a[sOff + c4];
                    a[ivOff + c4] = float(scale / Math.sqrt(variance + eps));
                }
            }
            // K5：thread-per-element 归一化
            @gpu for (long p = 0L; p < total; p = p + 1L) resident(a = dev) {
                if (p < total) {
                    int nc5 = int(p / long(S));
                    int cc5 = nc5 % C;
                    double mn5 = a[mnOff + nc5];
                    double iv5 = a[ivOff + nc5];
                    double xv5 = a[xOff + int(p)];
                    double bias5 = a[bOff + cc5];
                    a[yOff + int(p)] = float((xv5 - mn5) * iv5 + bias5);
                }
            }
        }
        // ReduceMean 激进优化（全 resident 单数组版，2026-08-12）：并行归约替代
        // 原"单线程串行"（mode 0 原 1 线程串行 total；mode 1 原每通道 1 线程串行 S）。
        // stats 写入 arena 尾部预留区 stOff，全设备计算（单数组 resident，无原子）。
        void reduceMean(float[] a, int work, int inOff, int outOff, int mode,
                        int N, int C, int S, int total, int keepdims, long dev, int stOff) {
            if (mode == 0) {
                long totalL = long(total);
                int np = 1024;
                @gpu for (long p0 = 0L; p0 < long(np); p0 = p0 + 1L) resident(a = dev) {
                    if (p0 < np) {
                        double s0 = 0.0;
                        long q0 = p0;
                        while (q0 < totalL) {
                            double xv0 = a[inOff + int(q0)];
                            s0 = s0 + xv0;
                            q0 = q0 + long(np);
                        }
                        a[stOff + int(p0)] = float(s0);
                    }
                }
                @gpu for (long p1 = 0L; p1 < 1L; p1 = p1 + 1L) resident(a = dev) {
                    if (p1 < 1L) {
                        double sum = 0.0;
                        int i0 = 0;
                        while (i0 < np) {
                            double v0 = a[stOff + i0];
                            sum = sum + v0;
                            i0 = i0 + 1;
                        }
                        a[outOff + 0] = float(sum / totalL);
                    }
                }
            } else {
                int nC = N * C;
                long totalL = long(nC) * long(S);
                int pt = 512;
                long nTh = long(nC) * long(pt);
                @gpu for (long pp = 0L; pp < nTh; pp = pp + 1L) resident(a = dev) {
                    if (pp < nTh) {
                        int nc1 = int(pp / long(pt));
                        int b1 = int(pp % long(pt));
                        long base1 = long(nc1) * long(S);
                        double s1 = 0.0;
                        long q1 = base1 + long(b1);
                        while (q1 < base1 + long(S)) {
                            double xv1 = a[inOff + int(q1)];
                            s1 = s1 + xv1;
                            q1 = q1 + long(pt);
                        }
                        a[stOff + nc1 * pt + b1] = float(s1);
                    }
                }
                @gpu for (long pp2 = 0L; pp2 < long(nC); pp2 = pp2 + 1L) resident(a = dev) {
                    if (pp2 < nC) {
                        int c2 = int(pp2);
                        double s2 = 0.0;
                        int b2 = 0;
                        while (b2 < pt) {
                            double v2 = a[stOff + c2 * pt + b2];
                            s2 = s2 + v2;
                            b2 = b2 + 1;
                        }
                        a[outOff + c2] = float(s2 / S);
                    }
                }
            }
        }
        // Split：沿 axis 复制 [start, start+len)（5 维解码，2D 时 d4=1；od 内部推出）
        void splitOp(float[] a, int work, int offIn, int offOut,
                     int axis, int start, int len,
                     int d0, int d1, int d2, int d3, int d4, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int od0 = d0, od1 = d1, od2 = d2, od3 = d3, od4 = d4;
                    if (axis == 0) od0 = len;
                    else if (axis == 1) od1 = len;
                    else if (axis == 2) od2 = len;
                    else if (axis == 3) od3 = len;
                    else od4 = len;
                    int i = int(p);
                    int x4 = i % od4;
                    int t = i / od4;
                    int x3 = t % od3;
                    t = t / od3;
                    int x2 = t % od2;
                    t = t / od2;
                    int x1 = t % od1;
                    int x0 = t / od1;
                    int c0 = x0, c1 = x1, c2 = x2, c3 = x3, c4 = x4;
                    if (axis == 0) c0 = x0 + start;
                    else if (axis == 1) c1 = x1 + start;
                    else if (axis == 2) c2 = x2 + start;
                    else if (axis == 3) c3 = x3 + start;
                    else c4 = x4 + start;
                    int inFlat = (((c0 * d1 + c1) * d2 + c2) * d3 + c3) * d4 + c4;
                    a[offOut + i] = a[offIn + inFlat];
                }
            }
        }
        // Resize2D：nearest/bilinear（thread-per-output-element）
        void resize2d(float[] a, int work, int offIn, int offOut,
                      int N, int C, int inH, int inW, int outH, int outW,
                      int mode, int transform, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int i = int(p);
                    int x = i % outW;
                    int t = i / outW;
                    int y = t % outH;
                    t = t / outH;
                    int c = t % C;
                    int n = t / C;
                    float sy = 0.0f;
                    float sx = 0.0f;
                    if (transform == 0) {
                        if (outH > 1) sy = float(y) * float(inH - 1) / float(outH - 1);
                        if (outW > 1) sx = float(x) * float(inW - 1) / float(outW - 1);
                    } else if (transform == 2) {
                        sy = float(y) * float(inH) / float(outH);
                        sx = float(x) * float(inW) / float(outW);
                    } else {
                        sy = (float(y) + 0.5f) * float(inH) / float(outH) - 0.5f;
                        sx = (float(x) + 0.5f) * float(inW) / float(outW) - 0.5f;
                    }
                    int base = (n * C + c) * inH * inW;
                    int obase = (n * C + c) * outH * outW;
                    if (mode == 0) {
                        int iy = int(sy);
                        int ix = int(sx);
                        if (iy < 0) iy = 0;
                        if (iy >= inH) iy = inH - 1;
                        if (ix < 0) ix = 0;
                        if (ix >= inW) ix = inW - 1;
                        a[offOut + obase + y * outW + x] = a[offIn + base + iy * inW + ix];
                    } else {
                        int iy = int(sy);
                        int ix = int(sx);
                        float fy = sy - float(iy);
                        float fx = sx - float(ix);
                        if (iy < 0) { iy = 0; fy = 0.0f; }
                        if (iy >= inH - 1) { iy = inH - 1; fy = 0.0f; }
                        if (ix < 0) { ix = 0; fx = 0.0f; }
                        if (ix >= inW - 1) { ix = inW - 1; fx = 0.0f; }
                        int iy2 = iy + 1;
                        int ix2 = ix + 1;
                        if (iy2 >= inH) iy2 = inH - 1;
                        if (ix2 >= inW) ix2 = inW - 1;
                        float v00 = a[offIn + base + iy * inW + ix];
                        float v01 = a[offIn + base + iy * inW + ix2];
                        float v10 = a[offIn + base + iy2 * inW + ix];
                        float v11 = a[offIn + base + iy2 * inW + ix2];
                        float v = v00 * (1.0f - fx) * (1.0f - fy) + v01 * fx * (1.0f - fy) + v10 * (1.0f - fx) * fy + v11 * fx * fy;
                        a[offOut + obase + y * outW + x] = v;
                    }
                }
            }
        }

        // Resize3D：thread-per-output（trilinear/nearest）
        void resize3d(float[] a, int work, int offIn, int offOut,
                      int N, int C, int inD, int inH, int inW, int outD, int outH, int outW,
                      int mode, int transform, long dev) {
            @gpu for (long p = 0L; p < long(work); p = p + 1L) resident(a = dev) {
                if (p < work) {
                    int i = int(p);
                    int x = i % outW;
                    int t = i / outW;
                    int y = t % outH;
                    t = t / outH;
                    int z = t % outD;
                    t = t / outD;
                    int c = t % C;
                    int n = t / C;
                    float sz = 0.0f;
                    float sy = 0.0f;
                    float sx = 0.0f;
                    if (transform == 0) {
                        if (outD > 1) sz = float(z) * float(inD - 1) / float(outD - 1);
                        if (outH > 1) sy = float(y) * float(inH - 1) / float(outH - 1);
                        if (outW > 1) sx = float(x) * float(inW - 1) / float(outW - 1);
                    } else if (transform == 2) {
                        sz = float(z) * float(inD) / float(outD);
                        sy = float(y) * float(inH) / float(outH);
                        sx = float(x) * float(inW) / float(outW);
                    } else {
                        sz = (float(z) + 0.5f) * float(inD) / float(outD) - 0.5f;
                        sy = (float(y) + 0.5f) * float(inH) / float(outH) - 0.5f;
                        sx = (float(x) + 0.5f) * float(inW) / float(outW) - 0.5f;
                    }
                    int base = (n * C + c) * inD * inH * inW;
                    int obase = (n * C + c) * outD * outH * outW;
                    if (mode == 0) {
                        int iz = int(sz);
                        int iy = int(sy);
                        int ix = int(sx);
                        if (iz < 0) iz = 0;
                        if (iz >= inD) iz = inD - 1;
                        if (iy < 0) iy = 0;
                        if (iy >= inH) iy = inH - 1;
                        if (ix < 0) ix = 0;
                        if (ix >= inW) ix = inW - 1;
                        a[offOut + obase + z * outH * outW + y * outW + x] = a[offIn + base + iz * inH * inW + iy * inW + ix];
                    } else {
                        int iz = int(sz);
                        int iy = int(sy);
                        int ix = int(sx);
                        float fz = sz - float(iz);
                        float fy = sy - float(iy);
                        float fx = sx - float(ix);
                        if (iz < 0) { iz = 0; fz = 0.0f; }
                        if (iz >= inD - 1) { iz = inD - 1; fz = 0.0f; }
                        if (iy < 0) { iy = 0; fy = 0.0f; }
                        if (iy >= inH - 1) { iy = inH - 1; fy = 0.0f; }
                        if (ix < 0) { ix = 0; fx = 0.0f; }
                        if (ix >= inW - 1) { ix = inW - 1; fx = 0.0f; }
                        int iz2 = iz + 1; if (iz2 >= inD) iz2 = inD - 1;
                        int iy2 = iy + 1; if (iy2 >= inH) iy2 = inH - 1;
                        int ix2 = ix + 1; if (ix2 >= inW) ix2 = inW - 1;
                        float w000 = (1.0f - fx) * (1.0f - fy) * (1.0f - fz);
                        float w100 = fx * (1.0f - fy) * (1.0f - fz);
                        float w010 = (1.0f - fx) * fy * (1.0f - fz);
                        float w110 = fx * fy * (1.0f - fz);
                        float w001 = (1.0f - fx) * (1.0f - fy) * fz;
                        float w101 = fx * (1.0f - fy) * fz;
                        float w011 = (1.0f - fx) * fy * fz;
                        float w111 = fx * fy * fz;
                        float v = a[offIn + base + iz * inH * inW + iy * inW + ix] * w000
                                + a[offIn + base + iz * inH * inW + iy * inW + ix2] * w100
                                + a[offIn + base + iz * inH * inW + iy2 * inW + ix] * w010
                                + a[offIn + base + iz * inH * inW + iy2 * inW + ix2] * w110
                                + a[offIn + base + iz2 * inH * inW + iy * inW + ix] * w001
                                + a[offIn + base + iz2 * inH * inW + iy * inW + ix2] * w101
                                + a[offIn + base + iz2 * inH * inW + iy2 * inW + ix] * w011
                                + a[offIn + base + iz2 * inH * inW + iy2 * inW + ix2] * w111;
                        a[offOut + obase + z * outH * outW + y * outW + x] = v;
                    }
                }
            }
        }
}
