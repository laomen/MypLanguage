// mnist_main.myp — MNIST inference entry using InferenceRuntime
// 图结构由 models/mnist_model.json 描述，权重仍从二进制加载。
import env;
import "./runtime.myp";
import "./model_loader.myp";

class MnistInferApp {
    action:
        @constructor MnistInferApp() {
            loadTestImages();
            loadTestLabels();
            if (numTest <= 0) {
                Console.writeLine("No test samples loaded");
                return;
            }

            InferenceRuntime rt = new InferenceRuntime();
            rt.init(120000);

            ModelLoader loader = new ModelLoader();
            int ok = loader.load("./deeplearning/infer/models/mnist_model.json", rt);
            if (ok == 0) {
                Console.writeLine("model load failed (need deeplearning/data/mnist_weights.bin)");
                return;
            }
            int inputTid = loader.tensorId("input");
            int probTid = loader.tensorId("prob");

            int correct = 0;
            int s = 0;
            while (s < numTest) {
                int pred = infer(rt, inputTid, probTid, testPixels, s * 784);
                if (pred == testLabels[s]) correct = correct + 1;
                s = s + 1;
            }

            int pct = correct * 100 / numTest;
            Console.writeString("MNIST inference accuracy: ");
            Console.writeLong(pct);
            Console.writeString("% (");
            Console.writeLong(correct);
            Console.writeString("/");
            Console.writeLong(numTest);
            Console.writeLine(")");
        }

        void loadTestImages() {
            string p = "./deeplearning/data/t10k-images-idx3-ubyte/t10k-images.idx3-ubyte";
            int fd = __myp_io_fopen(p, "rb");
            if (fd < 0) { numTest = 0; return; }
            int magic = __myp_io_read_i32be();
            int count = __myp_io_read_i32be();
            int rows = __myp_io_read_i32be();
            int cols = __myp_io_read_i32be();
            if (count > 100) count = 100;
            numTest = count;

            int i = 0;
            while (i < count) {
                int j = 0;
                while (j < 784) {
                    int b = __myp_io_read_byte();
                    if (b < 0) { numTest = i; __myp_io_fclose(); return; }
                    testPixels[i * 784 + j] = b / 255.0;
                    j = j + 1;
                }
                i = i + 1;
            }
            __myp_io_fclose();
        }

        void loadTestLabels() {
            string p = "./deeplearning/data/t10k-labels-idx1-ubyte/t10k-labels.idx1-ubyte";
            int fd = __myp_io_fopen(p, "rb");
            if (fd < 0) { numTest = 0; return; }
            int magic = __myp_io_read_i32be();
            int count = __myp_io_read_i32be();
            if (count > numTest) count = numTest;

            int i = 0;
            while (i < count) {
                int b = __myp_io_read_byte();
                if (b < 0) break;
                testLabels[i] = b;
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int infer(InferenceRuntime rt, int inputTid, int probTid, double[] pixels, int baseOffset) {
            int j = 0;
            while (j < 784) {
                rt.setFlat(inputTid, j, pixels[baseOffset + j]);
                j = j + 1;
            }
            rt.run();
            return rt.argmax1d(probTid);
        }

    property:
        int numTest;
        double[78400] testPixels;
        int[100] testLabels;
}

int main() {
    MnistInferApp app = new MnistInferApp();
    return 0;
}
