// onnx_main.myp — 纯 MYP 直接读取真实 .onnx 并推理（Path B 验证）
// 加载 deeplearning/data/onnx/mnist_mlp.onnx（784→64→10 MLP），
// 在 MNIST 测试集上逐样本前向，计算准确率（应与 CPU 版 78% 一致）。
import env;
import "./runtime.myp";
import "./onnx_loader.myp";

class OnnxInferApp {
    action:
        @constructor OnnxInferApp() {
            loadTestImages();
            loadTestLabels();
            if (numTest <= 0) {
                Console.writeLine("No test samples loaded");
                return;
            }

            InferenceRuntime rt = new InferenceRuntime();
            rt.init(120000);

            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/mnist_mlp.onnx", rt);
            if (ok == 0) {
                Console.writeLine("onnx load failed");
                return;
            }

            int inputTid = loader.tensorId("data");
            int probTid = loader.tensorId("prob");
            if (inputTid < 0 || probTid < 0) {
                Console.writeLine("tensor not found");
                return;
            }

            int correct = 0;
            int s = 0;
            while (s < numTest) {
                int pred = infer(rt, inputTid, probTid, testPixels, s * 784);
                if (pred == testLabels[s]) correct = correct + 1;
                s = s + 1;
            }

            // 打印 sample 0 概率向量（对照 onnxruntime 参考输出）
            infer(rt, inputTid, probTid, testPixels, 0);
            Console.writeString("sample0 prob: ");
            int k = 0;
            while (k < 10) {
                Console.writeFloat(rt.getFlat(probTid, k));
                Console.writeString(" ");
                k = k + 1;
            }
            Console.writeLine("");

            int pct = correct * 100 / numTest;
            Console.writeString("ONNX MLP accuracy: ");
            Console.writeLong(pct);
            Console.writeString("% (");
            Console.writeLong(correct);
            Console.writeString("/");
            Console.writeLong(numTest);
            Console.writeLine(")");
        }

        int infer(InferenceRuntime rt, int inputTid, int probTid, double[] pixels, int baseOffset) {
            int j = 0;
            while (j < 784) {
                rt.setFlat(inputTid, j, pixels[baseOffset + j]);
                j = j + 1;
            }
            rt.run();
            return rt.argmax1d(probTid);
        }

        void loadTestImages() {
            string p = "./deeplearning/data/t10k-images-idx3-ubyte/t10k-images.idx3-ubyte";
            int fd = __myp_io_fopen(p, "rb");
            if (fd < 0) { numTest = 0; return; }
            int magic = __myp_io_read_i32be();
            int count = __myp_io_read_i32be();
            int rows = __myp_io_read_i32be();
            int cols = __myp_io_read_i32be();
            if (count > 100) count = 100;
            numTest = count;

            int i = 0;
            while (i < count) {
                int j = 0;
                while (j < 784) {
                    int b = __myp_io_read_byte();
                    if (b < 0) { numTest = i; __myp_io_fclose(); return; }
                    testPixels[i * 784 + j] = b / 255.0;
                    j = j + 1;
                }
                i = i + 1;
            }
            __myp_io_fclose();
        }

        void loadTestLabels() {
            string p = "./deeplearning/data/t10k-labels-idx1-ubyte/t10k-labels.idx1-ubyte";
            int fd = __myp_io_fopen(p, "rb");
            if (fd < 0) { numTest = 0; return; }
            int magic = __myp_io_read_i32be();
            int count = __myp_io_read_i32be();
            if (count > numTest) count = numTest;

            int i = 0;
            while (i < count) {
                int b = __myp_io_read_byte();
                if (b < 0) break;
                testLabels[i] = b;
                i = i + 1;
            }
            __myp_io_fclose();
        }

    property:
        int numTest;
        double[78400] testPixels;
        int[100] testLabels;
}

int main() {
    OnnxInferApp app = new OnnxInferApp();
    return 0;
}
