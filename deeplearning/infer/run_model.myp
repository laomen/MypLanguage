// run_model.myp — 通用推理 CLI：任意 JSON 模型 + 命令行输入 → 输出张量
//
// 构建：
//   ./build/mypc deeplearning/infer/run_model.myp -o /tmp/run_model --stdlib stdlib
// 用法：
//   /tmp/run_model <model.json> <inputName> <outputName> <rows> <cols> <v0> <v1> ...
// 示例（XOR，输入 (0,1) 期望输出 p0≈0.018 / p1≈0.982）：
//   /tmp/run_model deeplearning/infer/models/xor_model.json input prob 2 1 0.0 1.0
import args;
import env;
import text;
import "./runtime.myp";
import "./model_loader.myp";

// 简易 double 解析：支持 "-12.5" / "0.0" / "3"
double parseDouble(string s) {
    int i = 0;
    double sign = 1.0;
    if (Str.len(s) > 0 && Str.ord(Str.substring(s, 0, 1)) == 45) {
        sign = -1.0;
        i = 1;
    }
    double v = 0.0;
    double frac = 0.0;
    double div = 1.0;
    int inFrac = 0;
    while (i < Str.len(s)) {
        int c = Str.ord(Str.substring(s, i, i + 1));
        if (c == 46) { inFrac = 1; }
        else if (c >= 48 && c <= 57) {
            if (inFrac == 0) {
                v = v * 10.0 + (c - 48);
            } else {
                div = div * 10.0;
                frac = frac + (c - 48) / div;
            }
        }
        i = i + 1;
    }
    return (v + frac) * sign;
}

class RunModelApp {
    action:
        @constructor RunModelApp() {
            if (Args.count() < 6) {
                Console.writeLine("usage: run_model <model.json> <input> <output> <rows> <cols> <v0> <v1> ...");
                return;
            }
            string modelPath = Args.get(1);
            string inputName = Args.get(2);
            string outputName = Args.get(3);
            int rows = Str.toInt(Args.get(4));
            int cols = Str.toInt(Args.get(5));
            int nvals = Args.count() - 6;

            InferenceRuntime rt = new InferenceRuntime();
            rt.init(200000);

            ModelLoader loader = new ModelLoader();
            int ok = loader.load(modelPath, rt);
            if (ok == 0) {
                Console.writeLine("model load failed: " + modelPath);
                return;
            }

            int inTid = loader.tensorId(inputName);
            int outTid = loader.tensorId(outputName);
            if (inTid < 0 || outTid < 0) {
                Console.writeLine("tensor not found: " + inputName + " / " + outputName);
                return;
            }

            int total = rows * cols;
            int k = 0;
            while (k < nvals && k < total) {
                rt.setFlat(inTid, k, parseDouble(Args.get(6 + k)));
                k = k + 1;
            }

            rt.run();

            Console.writeString("output[" + outputName + "]:");
            Console.writeLine("");
            int n = rt.tensorSize(outTid);
            k = 0;
            while (k < n) {
                Console.writeFloat(rt.getFlat(outTid, k));
                Console.writeString(" ");
                k = k + 1;
            }
            Console.writeLine("");
        }
}

int main() {
    RunModelApp app = new RunModelApp();
    return 0;
}
