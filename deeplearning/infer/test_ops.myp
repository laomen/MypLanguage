// test_ops.myp — sigmoid / add 算子正确性验证（JSON 模型全链路）
// 期望：x=[0,1] → h=x → hs=sigmoid(x) → sum=2*sigmoid(x)
//   sigmoid(0)=0.5 → sum[0]=1.0
//   sigmoid(1)≈0.7310586 → sum[1]≈1.4621172
import env;
import math;
import "./runtime.myp";
import "./model_loader.myp";

class TestOpsApp {
    action:
        @constructor TestOpsApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(4096);

            ModelLoader loader = new ModelLoader();
            int ok = loader.load("./deeplearning/infer/models/sigmoid_model.json", rt);
            if (ok == 0) {
                Console.writeLine("ops test: FAIL (load)");
                return;
            }

            int xTid = loader.tensorId("x");
            int sumTid = loader.tensorId("sum");
            rt.setFlat(xTid, 0, 0.0);
            rt.setFlat(xTid, 1, 1.0);
            rt.run();

            double s0 = rt.getFlat(sumTid, 0);
            double s1 = rt.getFlat(sumTid, 1);
            double exp1 = 2.0 * (1.0 / (1.0 + Math.exp(-1.0)));

            int pass = 1;
            if (Math.abs(s0 - 1.0) > 1e-9) pass = 0;
            if (Math.abs(s1 - exp1) > 1e-9) pass = 0;

            Console.writeString("ops test (sigmoid+add): ");
            if (pass == 1) {
                Console.writeLine("PASS");
            } else {
                Console.writeLine("FAIL");
                Console.writeString("  sum[0]="); Console.writeFloat(s0); Console.writeLine("");
                Console.writeString("  sum[1]="); Console.writeFloat(s1); Console.writeLine("");
            }
        }
}

int main() {
    TestOpsApp app = new TestOpsApp();
    return 0;
}
