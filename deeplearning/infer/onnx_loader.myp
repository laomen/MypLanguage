// onnx_loader.myp — 纯 MYP ONNX 读取器（Path B）
// 运行时直接解析真实 .onnx（protobuf wire 格式）并构建到 InferenceRuntime。
//
// 支持算子：Gemm / MatMul / Add / Relu / Sigmoid / Softmax（全连接）+
//          Conv / MaxPool / GlobalAveragePool / Flatten（CNN）。
// 约定：
//  - batch=1 的 [1, F] 输入（ONNX 常规方向 [batch, features]）
//  - FC 激活张量按转置登记（[1, H] → [H, 1]），FC 权重按 [outDim, inDim] 转置写入，
//    偏置统一规整为 [outDim, 1]；CNN 张量按 4D NCHW 行优先直接登记
//  - 权重支持 float32 初值（raw_data / float_data）；float64 暂不支持
//  - arena 内存规划（first-fit 复用）由 load() 在 buildRuntime 前完成
import env;
import math;
import "./pb.myp";
import "./runtime.myp";

// 张量角色 kind 常量（MYP 无 const，用 static 方法）
class Kind {
    static:
        int FC_ACT() { return 0; }    // FC 激活（转置登记）
        int CNN_ACT() { return 1; }   // CNN 激活（NCHW 行优先）
        int FC_W() { return 2; }      // Gemm 权重
        int FC_B() { return 3; }      // Gemm 偏置
        int CNN_W() { return 4; }     // Conv 权重
        int CNN_B() { return 5; }     // Conv 偏置
        int FC_C() { return 6; }      // G2：折叠常量（直接拷贝，不转置）
}

class OnnxLoader {
    action:
        @constructor OnnxLoader() {
            pb_ = new PbReader();
        }

        // 从 .onnx 加载到运行时。成功返回 1，失败返回 0。
        int load(string path, InferenceRuntime rt) {
            if (readFile(path) == 0) return 0;
            if (fileLen_ <= 0) return 0;

            wCount_ = 0;
            nCount_ = 0;
            sCount_ = 0;
            tCount_ = 0;
            goCount_ = 0;
            fuseCount_ = 0;
            gapCount_ = 0;
            dceCount_ = 0;
            foldCount_ = 0;
            bnCount_ = 0;

            pb_.init(file_, fileLen_);
            if (parseModel(rt) == 0) return 0;
            // G2：常量折叠在形状推断前（Constant 节点 → 持久张量并标记死，否则 inferShapes 遇不支持算子失败）
            foldConstants();
            // 先推断形状（生成激活形状表），再分类角色（激活 kind 需形状存在）
            if (inferShapes() == 0) return 0;
            classifyShapes();
            // G3：Conv+BN 融合（在 G1 之前，折叠 BN 后 conv 直接接 relu 才可融合）
            fuseConvBN();
            // G1：Conv+ReLU 融合（在内存规划前，避免为被消掉的中间张量规划）
            fuseConvRelu();
            // G2：GAP+Flatten 融合（复用 nFused_/nFusedOut_ 机制）
            fuseGapFlatten();
            // G2：死算子消除（清理融合后/不可达节点）
            eliminateDeadNodes();
            // G2：布局变换 NCHW→NHWC（opt-in，MYP_LAYOUT_NHWC=1）
            if (doNHWC_ == 1) {
                if (layoutNHWC() == 0) return 0;
            }
            // 拓扑排序：布局变换在尾部追加转置节点，须先于消费者执行
            if (topoSort() == 0) return 0;
            if (Console.getEnv("MYP_NO_REUSE") == "1") noReuse_ = 1;   // 调试：禁用区域复用
            int peak = planMemory();
            if (peak <= 0) return 0;
            rt.resizeArena(peak);
            if (buildRuntime(rt) == 0) return 0;
            return 1;
        }

        // 名称 → 张量 id（找不到返回 -1）
        int tensorId(string name) {
            int i = 0;
            while (i < tCount_) {
                if (tName_[i] == name) return tId_[i];
                i = i + 1;
            }
            return -1;
        }

        // ---- 图统计（供 resnet_main 打印）----
        void setLayoutNHWC(int v) { doNHWC_ = v; }
        int doNHWC() { return doNHWC_; }
        int fuseCount() { return fuseCount_; }
        int gapCount() { return gapCount_; }
        int dceCount() { return dceCount_; }
        int foldCount() { return foldCount_; }
        int bnCount() { return bnCount_; }   // G3：Conv+BN 融合数
        int nodeCount() { return nCount_; }

    function:
        // 读文件字节到 file_（增长型缓冲，返回 1=成功）
        int readFile(string path) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return 0;
            int cap = 65536;
            file_ = new int[cap];
            fileLen_ = 0;
            while (true) {
                int b = __myp_io_read_byte();
                if (b < 0) break;
                if (fileLen_ >= cap) {
                    int ncap = cap * 2;
                    int[] nb = new int[ncap];
                    int i = 0;
                    while (i < fileLen_) { nb[i] = file_[i]; i = i + 1; }
                    file_ = nb;
                    cap = ncap;
                }
                file_[fileLen_] = b;
                fileLen_ = fileLen_ + 1;
            }
            __myp_io_fclose();
            return 1;
        }

        // ---- 顶层 ModelProto：只取 graph（field 8）----
        // ONNX ModelProto 字段号：graph = 7，opset_import = 8（勿记反）
        int parseModel(InferenceRuntime rt) {
            while (pb_.pos() < fileLen_) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 7) {
                    int l = pb_.readLen();
                    int po = pb_.payloadOff();
                    parseGraph(po, l);
                } else {
                    pb_.skipField();
                }
            }
            return 1;
        }

        // ---- GraphProto：node(1) / initializer(5) / input(11) / output(12) ----
        int parseGraph(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    parseNode(po, l);
                } else if (f == 5) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    parseTensor(po, l);
                } else if (f == 11 || f == 12) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    string nm = parseValueInfo(po, l);
                    // 记录图输出名（G1 融合安全：被 fused 的中间张量不能是图输出）
                    if (f == 12 && goCount_ < 64) { goName_[goCount_] = nm; goCount_ = goCount_ + 1; }
                } else {
                    pb_.skipField();
                }
            }
            return 1;
        }

        // ---- NodeProto ----
        int parseNode(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            nIn0_[nCount_] = ""; nIn1_[nCount_] = ""; nIn2_[nCount_] = "";
            nIn3_[nCount_] = ""; nIn4_[nCount_] = "";   // G3：BatchNorm 第 3/4 输入（mean/var）
            nOut0_[nCount_] = "";
            nConstVal_[nCount_] = 0;   // G2：Constant 节点 value 属性捕获标记
            nEpsInt_[nCount_] = 0;     // G3：BN epsilon 位型
            nHasEps_[nCount_] = 0;     // G3：1 = 有 epsilon 属性
            nAlphaInt_[nCount_] = 0;   // G4：LeakyRelu alpha 位型
            nHasAlpha_[nCount_] = 0;   // G4：1 = 有 alpha 属性
            nFused_[nCount_] = 0;      // G1/G2/G3：融合标记（parseNode 统一复位，勿在 pass 内盲清）
            nFusedBy_[nCount_] = -1;
            nFusedOut_[nCount_] = "";
            nRelu_[nCount_] = 0;       // G4：1 = Conv 与 Relu 融合（G1 设置）
            nNHWC_[nCount_] = 0;
            nTransB_[nCount_] = 0;
            nAxis_[nCount_] = -1;
            nSH_[nCount_] = 1; nSW_[nCount_] = 1;
            nPT_[nCount_] = 0; nPB_[nCount_] = 0; nPL_[nCount_] = 0; nPR_[nCount_] = 0;
            nDH_[nCount_] = 1; nDW_[nCount_] = 1;
            nGroup_[nCount_] = 1;
            nKH_[nCount_] = 0; nKW_[nCount_] = 0;
            int inIdx = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {           // input (string, repeated)
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    string s = pb_.readString(l);
                    if (inIdx == 0) nIn0_[nCount_] = s;
                    else if (inIdx == 1) nIn1_[nCount_] = s;
                    else if (inIdx == 2) nIn2_[nCount_] = s;
                    else if (inIdx == 3) nIn3_[nCount_] = s;
                    else if (inIdx == 4) nIn4_[nCount_] = s;
                    inIdx = inIdx + 1;
                } else if (f == 2) {    // output
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    nOut0_[nCount_] = pb_.readString(l);
                } else if (f == 3) {    // name
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    pb_.skipBytes(l);
                } else if (f == 4) {    // op_type
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    nType_[nCount_] = pb_.readString(l);
                } else if (f == 5) {    // attribute
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    parseAttr(po, l);
                } else {
                    pb_.skipField();
                }
            }
            nCount_ = nCount_ + 1;
            return 1;
        }

        // ---- AttributeProto：name(1) / int(3) / ints(8, 非打包) ----
        int parseAttr(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            string aname = "";
            int idx = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    aname = pb_.readString(l);
                } else if (f == 2) {    // f（float32 单值，如 BN epsilon / LeakyRelu alpha）
                    int bits = pb_.readU32();
                    if (aname == "epsilon") { nEpsInt_[nCount_] = bits; nHasEps_[nCount_] = 1; }
                    if (aname == "alpha") { nAlphaInt_[nCount_] = bits; nHasAlpha_[nCount_] = 1; }
                } else if (f == 3) {    // int64 单值（transB / axis / group）
                    int v = pb_.readVarint();
                    if (aname == "transB") nTransB_[nCount_] = v;
                    if (aname == "axis") nAxis_[nCount_] = v;
                    if (aname == "group") nGroup_[nCount_] = v;
                } else if (f == 8) {    // ints：非打包，每个 varint 一个字段
                    int v = pb_.readVarint();
                    if (aname == "strides") { if (idx == 0) nSH_[nCount_] = v; else nSW_[nCount_] = v; }
                    else if (aname == "pads") {
                        // pads = [top, left, bottom, right]（2D）
                        if (idx == 0) nPT_[nCount_] = v;
                        else if (idx == 1) nPL_[nCount_] = v;
                        else if (idx == 2) nPB_[nCount_] = v;
                        else nPR_[nCount_] = v;
                    }
                    else if (aname == "dilations") { if (idx == 0) nDH_[nCount_] = v; else nDW_[nCount_] = v; }
                    else if (aname == "kernel_shape") { if (idx == 0) nKH_[nCount_] = v; else nKW_[nCount_] = v; }
                    idx = idx + 1;
                } else if (f == 5) {    // t（Constant 节点的 value：TensorProto）记录字节，稍后折叠
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    nConstVal_[nCount_] = 1;
                    nConstOff_[nCount_] = po;
                    nConstLen_[nCount_] = l;
                    pb_.skipBytes(l);
                } else {
                    pb_.skipField();
                }
            }
            return 1;
        }

        // ---- TensorProto（initializer）----
        int parseTensor(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            int[] dims = new int[8];
            int dimCount = 0;
            int dt = 0;
            int payloadKind = 0;
            int payloadOff = 0;
            int payloadLen = 0;
            string nm = "";
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {           // dims：非打包，每个维度一个 varint 字段
                    if (dimCount < 8) { dims[dimCount] = pb_.readVarint(); dimCount = dimCount + 1; }
                    else { long v = pb_.readVarint64(); }
                } else if (f == 2) {    // data_type
                    dt = pb_.readVarint();
                } else if (f == 4 || f == 9) {  // float_data(4) / raw_data(9)：packed f32 字节
                    payloadKind = 1;
                    payloadLen = pb_.readLen();
                    payloadOff = pb_.payloadOff();
                    pb_.skipBytes(payloadLen);  // 前进游标，跳过 payload（仅记录偏移，稍后从 file_ 读取）
                } else if (f == 10) {   // double_data(10)：packed f64
                    payloadKind = 2;
                    payloadLen = pb_.readLen();
                    payloadOff = pb_.payloadOff();
                    pb_.skipBytes(payloadLen);
                } else if (f == 8) {    // name
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    nm = pb_.readString(l);
                } else {
                    pb_.skipField();
                }
            }
            // 登记 initializer（4D 维度；wRows/cols 保留为 [d0, prod(rest)] 视图）
            int rows = 1; int cols = 1;
            if (dimCount == 0) { rows = 1; cols = 1; }
            else if (dimCount == 1) { rows = dims[0]; cols = 1; }
            else if (dimCount == 2) { rows = dims[0]; cols = dims[1]; }
            else {
                rows = dims[0];
                cols = 1;
                int k = 1;
                while (k < dimCount) { cols = cols * dims[k]; k = k + 1; }
            }
            wName_[wCount_] = nm;
            wRows_[wCount_] = rows;
            wCols_[wCount_] = cols;
            wType_[wCount_] = dt;
            wKind_[wCount_] = payloadKind;
            wOff_[wCount_] = payloadOff;
            wLen_[wCount_] = payloadLen;
            wTrans_[wCount_] = 0;
            wBias_[wCount_] = 0;
            wRole_[wCount_] = 0;
            wBN_[wCount_] = 0;          // G3：BN 折叠标记（parseTensor 统一复位）
            wBNOnly_[wCount_] = 0;      // G4：1 = 由 BN 合成偏置（无原卷积偏置）
            wCount_ = wCount_ + 1;
            addShapeD(nm, dims, dimCount);
            return 1;
        }

        // ---- ValueInfoProto（graph input/output）：取 name + 形状，返回名字 ----
        string parseValueInfo(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            string nm = "";
            int[] dims = new int[8];
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    nm = pb_.readString(l);
                } else if (f == 2) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    dimCount = parseTypeShape(po, l, dims);
                } else {
                    pb_.skipField();
                }
            }
            addShapeD(nm, dims, dimCount);
            return nm;
        }

        // TypeProto → tensor_type → shape → dims（dim_param 视为 1）
        int parseTypeShape(int off, int len, int[] dims) {
            int end = off + len;
            pb_.seek(off);
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {   // tensor_type
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    dimCount = parseTensorType(po, l, dims);
                } else {
                    pb_.skipField();
                }
            }
            return dimCount;
        }

        int parseTensorType(int off, int len, int[] dims) {
            int end = off + len;
            pb_.seek(off);
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 2) {   // shape
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    dimCount = parseShape(po, l, dims);
                } else {
                    pb_.skipField();
                }
            }
            return dimCount;
        }

        int parseShape(int off, int len, int[] dims) {
            int end = off + len;
            pb_.seek(off);
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {   // dim
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    int v = parseDim(po, l);
                    if (dimCount < 8) { dims[dimCount] = v; dimCount = dimCount + 1; }
                } else {
                    pb_.skipField();
                }
            }
            return dimCount;
        }

        int parseDim(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            int v = 1;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) { v = pb_.readVarint(); }
                else if (f == 2) { int l = pb_.readLen(); int po = pb_.payloadOff(); pb_.skipBytes(l); }
                else { pb_.skipField(); }
            }
            if (v <= 0) v = 1;
            return v;
        }

        // ---- 形状表（4D 维度 + 角色 kind）----
        // kind：0=FC激活 1=CNN激活 2=FC权重 3=FC偏置 4=CNN权重 5=CNN偏置
        int shapeIdx(string name) {
            int i = 0;
            while (i < sCount_) {
                if (shName_[i] == name) return i;
                i = i + 1;
            }
            return -1;
        }
        int shapeKind(string name) {
            int i = shapeIdx(name);
            if (i < 0) return Kind.FC_ACT();
            return shKind_[i];
        }
        void setShapeKind(string name, int k) {
            int i = shapeIdx(name);
            if (i >= 0) shKind_[i] = k;
        }
        void addShapeD(string name, int[] dims, int dimCount) {
            int d0 = 1; int d1 = 1; int d2 = 1; int d3 = 1;
            if (dimCount >= 1) d0 = dims[0];
            if (dimCount >= 2) d1 = dims[1];
            if (dimCount >= 3) d2 = dims[2];
            if (dimCount >= 4) d3 = dims[3];
            addShapeD4(name, d0, d1, d2, d3);
        }
        void addShapeD4(string name, int d0, int d1, int d2, int d3) {
            if (shapeIdx(name) >= 0) return;
            shName_[sCount_] = name;
            shD0_[sCount_] = d0;
            shD1_[sCount_] = d1;
            shD2_[sCount_] = d2;
            shD3_[sCount_] = d3;
            shKind_[sCount_] = Kind.FC_ACT();
            shDead_[sCount_] = 0;
            shNHWC_[sCount_] = 0;
            sCount_ = sCount_ + 1;
        }

        // ---- 分类张量角色（权重/偏置/FC激活/CNN激活）----
        int classifyShapes() {
            // 1) 权重/偏置：由消费节点决定（初始器）
            int i = 0;
            while (i < nCount_) {
                string t = nType_[i];
                if (t == "Gemm") {
                    markFCWeight(nIn1_[i], nTransB_[i]);   // transB=1：wire=[N,K]；transB=0：wire=[K,N]
                    markFCBias(nIn2_[i]);
                } else if (t == "MatMul") {
                    markFCWeight(nIn1_[i], 0);             // MatMul 无 transB，wire=[K,N]
                } else if (t == "Conv") {
                    markCNNWeight(nIn1_[i]);
                    markCNNBias(nIn2_[i]);
                }
                i = i + 1;
            }
            // 2) 图输入（非初始器、非任何节点输出）：由首个消费者决定 4D/FC
            int si = 0;
            while (si < sCount_) {
                string nm = shName_[si];
                if (initIdx(nm) >= 0) { si = si + 1; continue; }
                if (isNodeOutput(nm) == 1) { si = si + 1; continue; }
                setShapeKind(nm, consumerKind(nm));
                si = si + 1;
            }
            // 3) 激活：按生产者传播（节点按拓扑序；死节点跳过）
            i = 0;
            while (i < nCount_) {
                string t = nType_[i];
                if (t == "") { i = i + 1; continue; }
                int k = Kind.FC_ACT();
                if (t == "Conv" || t == "MaxPool" || t == "GlobalAveragePool") k = Kind.CNN_ACT();
                else if (t == "Gemm" || t == "MatMul" || t == "Flatten") k = Kind.FC_ACT();
                else {
                    // Relu / Sigmoid / Softmax / Add：沿用主输入 kind
                    k = shapeKind(nIn0_[i]);
                }
                setShapeKind(nOut0_[i], k);
                i = i + 1;
            }
            return 1;
        }
        int isNodeOutput(string name) {
            int i = 0;
            while (i < nCount_) {
                if (nOut0_[i] == name) return 1;
                i = i + 1;
            }
            return 0;
        }
        // 图输入的角色：首个消费它的节点若是 CNN 算子 → CNN 激活
        int consumerKind(string name) {
            int i = 0;
            while (i < nCount_) {
                if (nIn0_[i] == name || nIn1_[i] == name || nIn2_[i] == name) {
                    string t = nType_[i];
                    if (t == "Conv" || t == "MaxPool" || t == "GlobalAveragePool" || t == "BatchNormalization") return Kind.CNN_ACT();
                    return Kind.FC_ACT();
                }
                i = i + 1;
            }
            return Kind.FC_ACT();
        }
        void markFCWeight(string name, int v) {
            int i = initIdx(name);
            if (i >= 0) { wTrans_[i] = v; wRole_[i] = 0; setShapeKind(name, Kind.FC_W()); }
        }
        void markFCBias(string name) {
            int i = initIdx(name);
            if (i >= 0) { wBias_[i] = 1; wRole_[i] = 1; setShapeKind(name, Kind.FC_B()); }
        }
        void markCNNWeight(string name) {
            int i = initIdx(name);
            if (i >= 0) { wRole_[i] = 2; setShapeKind(name, Kind.CNN_W()); }
        }
        void markCNNBias(string name) {
            int i = initIdx(name);
            if (i >= 0) { wRole_[i] = 3; setShapeKind(name, Kind.CNN_B()); }
        }
        int initIdx(string name) {
            int i = 0;
            while (i < wCount_) {
                if (wName_[i] == name) return i;
                i = i + 1;
            }
            return -1;
        }

        // ---- 形状推断（ONNX 空间；支持 FC + CNN）----
        int inferShapes() {
            int i = 0;
            while (i < nCount_) {
                string t = nType_[i];
                if (t == "") { i = i + 1; continue; }   // 死节点（折叠/融合消掉）跳过
                if (t == "Conv") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int w = shapeIdx(nIn1_[i]); if (w < 0) return 0;
                    int N = shD0_[a]; int H = shD2_[a]; int W = shD3_[a];
                    int yC = shD0_[w];
                    int kh = shD2_[w]; int kw = shD3_[w];
                    if (nKH_[i] > 0) kh = nKH_[i];
                    if (nKW_[i] > 0) kw = nKW_[i];
                    int yH = (H + nPT_[i] + nPB_[i] - nDH_[i] * (kh - 1) - 1) / nSH_[i] + 1;
                    int yW = (W + nPL_[i] + nPR_[i] - nDW_[i] * (kw - 1) - 1) / nSW_[i] + 1;
                    addShapeD4(nOut0_[i], N, yC, yH, yW);
                } else if (t == "MaxPool") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int N = shD0_[a]; int C = shD1_[a]; int H = shD2_[a]; int W = shD3_[a];
                    int kh = nKH_[i]; int kw = nKW_[i];
                    int yH = (H + nPT_[i] + nPB_[i] - kh) / nSH_[i] + 1;
                    int yW = (W + nPL_[i] + nPR_[i] - kw) / nSW_[i] + 1;
                    addShapeD4(nOut0_[i], N, C, yH, yW);
                } else if (t == "GlobalAveragePool") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    addShapeD4(nOut0_[i], shD0_[a], shD1_[a], 1, 1);
                } else if (t == "Flatten") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int f = shD1_[a] * shD2_[a] * shD3_[a];
                    addShapeD4(nOut0_[i], shD0_[a], f, 1, 1);
                } else if (t == "Gemm") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int w = shapeIdx(nIn1_[i]); if (w < 0) return 0;
                    int m = shD0_[a];                     // [M,K]
                    int n = shD0_[w];                     // transB=1: [N,K] → N=d0
                    if (nTransB_[i] == 0) n = shD1_[w];   // transB=0: [K,N] → N=d1
                    addShapeD4(nOut0_[i], m, n, 1, 1);
                } else if (t == "MatMul") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    int b = shapeIdx(nIn1_[i]); if (b < 0) return 0;
                    addShapeD4(nOut0_[i], shD0_[a], shD1_[b], 1, 1);
                } else if (t == "Add" || t == "Relu" || t == "Sigmoid" || t == "Softmax" || t == "BatchNormalization"
                           || t == "ReLU6" || t == "LeakyRelu" || t == "SiLU" || t == "HardSwish" || t == "Clip") {
                    int a = shapeIdx(nIn0_[i]); if (a < 0) return 0;
                    addShapeD4(nOut0_[i], shD0_[a], shD1_[a], shD2_[a], shD3_[a]);
                } else {
                    return 0;   // 不支持的算子
                }
                i = i + 1;
            }
            return 1;
        }

        // ---- G3：Conv+BN 融合（把 BatchNormalization 折叠进卷积权重/偏置）----
        // 模式 Conv → BatchNormalization（bn 输入[0]==conv 输出、conv 输出仅被该 bn 消费、
        // 非图输出）：把 BN per-channel 参数折进 conv——
        //   invStd[oc] = scale[oc] / sqrt(var[oc]+eps)
        //   W'[oc] = W[oc] * invStd[oc]；B'[oc] = (B_conv[oc]-mean[oc])*invStd[oc] + B_bn[oc]
        // 折叠在 writeWeight 时按 wBN_/wBNNode_ 应用（含 NHWC 转置路径，按 oc 缩放可交换）。
        // BN 节点标死、参数张量标死；conv 有效输出改写为 BN 输出（nFused_/nFusedOut_），
        // 使随后运行的 G1 能把 Conv→Relu 继续融合。
        int fuseConvBN() {
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] != "Conv") { i = i + 1; continue; }
                if (nFused_[i] == 1) { i = i + 1; continue; }
                if (isGraphOutput(nOut0_[i]) == 1) { i = i + 1; continue; }
                // 找以 conv 输出为输入[0]的 BN 节点
                int j = 0;
                while (j < nCount_) {
                    if (nType_[j] == "BatchNormalization" && nIn0_[j] == nOut0_[i]) break;
                    j = j + 1;
                }
                if (j >= nCount_) { i = i + 1; continue; }   // 无配对 BN，不融合
                // 安全：conv 输出仅被该 bn 消费（残差分支多消费者时跳过）
                int consumers = 0;
                int k = 0;
                while (k < nCount_) {
                    if (nType_[k] == "") { k = k + 1; continue; }
                    if (nIn0_[k] == nOut0_[i] || nIn1_[k] == nOut0_[i] || nIn2_[k] == nOut0_[i] || nIn3_[k] == nOut0_[i] || nIn4_[k] == nOut0_[i]) consumers = consumers + 1;
                    k = k + 1;
                }
                if (consumers != 1) { i = i + 1; continue; }
                // BN 4 参数必须是初始器
                if (initIdx(nIn1_[j]) < 0 || initIdx(nIn2_[j]) < 0 || initIdx(nIn3_[j]) < 0 || initIdx(nIn4_[j]) < 0) { i = i + 1; continue; }
                // 标记 conv 权重/偏置折叠（记录 BN 参数初始器下标 + BN 节点下标）
                int wi = initIdx(nIn1_[i]);
                int wb = initIdx(nIn2_[i]);
                if (wi >= 0) { wBN_[wi] = 1; wBNNode_[wi] = j; wBNScale_[wi] = initIdx(nIn1_[j]); wBNBias_[wi] = initIdx(nIn2_[j]); wBNMean_[wi] = initIdx(nIn3_[j]); wBNVar_[wi] = initIdx(nIn4_[j]); }
                if (wb >= 0) { wBN_[wb] = 1; wBNNode_[wb] = j; wBNScale_[wb] = initIdx(nIn1_[j]); wBNBias_[wb] = initIdx(nIn2_[j]); wBNMean_[wb] = initIdx(nIn3_[j]); wBNVar_[wb] = initIdx(nIn4_[j]); }
                else {
                    // G4：无卷积偏置的 Conv（真实模型常见）→ 由 BN 参数合成偏置
                    // b'[oc] = (0 - mean[oc])*invStd[oc] + bnBias[oc]（writeWeight 按 wBNOnly_ 计算）
                    int Cout = wRows_[wi];
                    string bname = nOut0_[i] + "#bnb";
                    int[] bdims = new int[1];
                    bdims[0] = Cout;
                    wName_[wCount_] = bname;
                    wRows_[wCount_] = Cout;
                    wCols_[wCount_] = 1;
                    wType_[wCount_] = 1;
                    wKind_[wCount_] = 1;
                    wOff_[wCount_] = 0;
                    wLen_[wCount_] = Cout * 4;   // 无源字节，仅用于 count
                    wTrans_[wCount_] = 0;
                    wBias_[wCount_] = 0;
                    wRole_[wCount_] = 3;
                    wBN_[wCount_] = 1;
                    wBNOnly_[wCount_] = 1;
                    wBNNode_[wCount_] = j;
                    wBNScale_[wCount_] = initIdx(nIn1_[j]);
                    wBNBias_[wCount_] = initIdx(nIn2_[j]);
                    wBNMean_[wCount_] = initIdx(nIn3_[j]);
                    wBNVar_[wCount_] = initIdx(nIn4_[j]);
                    wCount_ = wCount_ + 1;
                    addShapeD(bname, bdims, 1);
                    setShapeKind(bname, Kind.CNN_B());
                    nIn2_[i] = bname;
                }
                nFused_[i] = 1;
                nFusedOut_[i] = nOut0_[j];
                nType_[j] = "";
                markDeadTensor(nOut0_[i]);   // conv 中间输出
                // BN 参数不再被消费 → 标死（不分配/不登记/不写权重）
                if (liveConsumers(nIn1_[j]) == 0) markDeadTensor(nIn1_[j]);
                if (liveConsumers(nIn2_[j]) == 0) markDeadTensor(nIn2_[j]);
                if (liveConsumers(nIn3_[j]) == 0) markDeadTensor(nIn3_[j]);
                if (liveConsumers(nIn4_[j]) == 0) markDeadTensor(nIn4_[j]);
                bnCount_ = bnCount_ + 1;
                i = i + 1;
            }
            return 1;
        }
        // G3：BN 折叠 invStd[oc] = scale[oc] / sqrt(var[oc] + eps)
        double bnInvStd(int wi, int oc) {
            int j = wBNNode_[wi];
            double s = f32At(wOff_[wBNScale_[wi]] + oc * 4);
            double v = f32At(wOff_[wBNVar_[wi]] + oc * 4);
            double e = 1.0e-5;
            if (nHasEps_[j] == 1) e = F32.toDouble(nEpsInt_[j]);
            return s / Math.sqrt(v + e);
        }
        // G3：BN 折叠偏置 b'[oc] = (b[oc] - mean[oc]) * invStd[oc] + bnBias[oc]
        double bnFoldBias(int wi, int oc, double b) {
            int j = wBNNode_[wi];
            double m = f32At(wOff_[wBNMean_[wi]] + oc * 4);
            double bb = f32At(wOff_[wBNBias_[wi]] + oc * 4);
            return (b - m) * bnInvStd(wi, oc) + bb;
        }

        // ---- G1：图级 Conv+ReLU 融合（在 inferShapes 之后、planMemory 之前调用）----
        // 把 "Conv → Relu"（relu 输入 == conv 有效输出，且有效输出无其它消费者、非图输出）
        // 替换为单个 fused 算子：conv 输出直接过 relu，不写回中间张量（runtime opKind=11）。
        //  - nFused_[i] = 1：conv 节点 i 已融合，目标输出 = relu 输出（形状相同）
        //  - nFusedOut_[i]：融合后的输出张量名（relu 的输出）
        //  - nFusedBy_[j] = i：被消掉的 relu 节点 j 记录取代它的 conv 下标
        //  - nType_[j] = ""：relu 节点标记死，buildRuntime/planMemory 跳过
        // 注：以 effectiveOut 匹配（G3：BN 折叠后 conv 的有效输出是 BN 输出，relu 接在其后）；
        //     nFused_ 等在 parseNode 统一复位，本 pass 不再盲清（避免抹掉 G3 的 BN 融合标记）。
        int fuseConvRelu() {
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] != "Conv") { i = i + 1; continue; }
                string eff = effectiveOut(i);
                if (isGraphOutput(eff) == 1) { i = i + 1; continue; }   // 中间张量不能是图输出
                // 找以 conv 有效输出为输入的 Relu 节点
                int j = 0;
                while (j < nCount_) {
                    if (nType_[j] == "Relu" && nIn0_[j] == eff) break;
                    j = j + 1;
                }
                if (j >= nCount_) { i = i + 1; continue; }   // 无配对 relu，不融合
                // 安全条件：conv 有效输出只能被该 relu 消费（ResNet 残差分支有多消费者时跳过）
                int consumers = 0;
                int k = 0;
                while (k < nCount_) {
                    if (nType_[k] == "") { k = k + 1; continue; }
                    if (nIn0_[k] == eff || nIn1_[k] == eff || nIn2_[k] == eff || nIn3_[k] == eff || nIn4_[k] == eff) consumers = consumers + 1;
                    k = k + 1;
                }
                if (consumers != 1) { i = i + 1; continue; }
                nFused_[i] = 1;
                nFusedOut_[i] = nOut0_[j];
                nFusedBy_[j] = i;
                nRelu_[i] = 1;   // G4：标记 Conv+Relu 融合（与 BN 融合区分：buildRuntime 按此决定 convRelu）
                nType_[j] = "";
                markDeadTensor(nOut0_[i]);                    // 被消掉的中间张量：不再分配/登记
                if (eff != nOut0_[i]) markDeadTensor(eff);    // G3：BN 折叠场景，旧有效输出（BN 输出）也死
                fuseCount_ = fuseCount_ + 1;
                i = i + 1;
            }
            return 1;
        }
        int isGraphOutput(string name) {
            int i = 0;
            while (i < goCount_) {
                if (goName_[i] == name) return 1;
                i = i + 1;
            }
            return 0;
        }

        // ---- G2：GAP+Flatten 融合 ----
        // 把 "GlobalAveragePool → Flatten"（flatten 输入 == gap 输出，且 gap 输出仅被该
        // flatten 消费、非图输出、batch==1）替换为单个 fused 算子：GAP 直接写进 flatten 输出
        // 张量（[N,C]，FC 视角），消除一次 flatten 拷贝 + 中间张量 [N,C,1,1]。
        //  - 复用 nFused_[i]/nFusedOut_[i]：gap 节点输出改写为 flatten 输出名
        //  - nType_[j]=""：flatten 节点标记死；gap 中间张量 markDeadTensor（不再分配/登记）
        //  - 约束 batch==1：FC_ACT 转置登记（[N,C]→运行时 [C,N]）与 gapool 顺序写入
        //    仅在 N==1 时逐位一致（flat n*C+c == c*N+n）；N>1 需转置写，暂不融合。
        int fuseGapFlatten() {
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] != "GlobalAveragePool") { i = i + 1; continue; }
                if (isGraphOutput(nOut0_[i]) == 1) { i = i + 1; continue; }
                int s = shapeIdx(nOut0_[i]);
                if (s >= 0 && shD0_[s] != 1) { i = i + 1; continue; }   // batch!=1 跳过
                // 找以 gap 输出为输入的 Flatten 节点
                int j = 0;
                while (j < nCount_) {
                    if (nType_[j] == "Flatten" && nIn0_[j] == nOut0_[i]) break;
                    j = j + 1;
                }
                if (j >= nCount_) { i = i + 1; continue; }
                // 安全条件：gap 输出只能被该 flatten 消费
                int consumers = 0;
                int k = 0;
                while (k < nCount_) {
                    if (nType_[k] == "") { k = k + 1; continue; }
                    if (nIn0_[k] == nOut0_[i] || nIn1_[k] == nOut0_[i] || nIn2_[k] == nOut0_[i]) consumers = consumers + 1;
                    k = k + 1;
                }
                if (consumers != 1) { i = i + 1; continue; }
                nFused_[i] = 1;
                nFusedOut_[i] = nOut0_[j];
                nFusedBy_[j] = i;
                nType_[j] = "";
                markDeadTensor(nOut0_[i]);   // GAP 中间张量 [N,C,1,1] 不再分配
                gapCount_ = gapCount_ + 1;
                i = i + 1;
            }
            return 1;
        }

        // ---- G2：死算子消除（DCE）----
        // 反复删除输出不被任何活节点消费、且非图输出的节点（fixpoint）。
        // 融合节点用 effectiveOut（nFused_ 指向的真实输出）判定活性。
        int eliminateDeadNodes() {
            int changed = 1;
            while (changed == 1) {
                changed = 0;
                int i = 0;
                while (i < nCount_) {
                    if (nType_[i] == "") { i = i + 1; continue; }
                    string eff = effectiveOut(i);
                    if (eff == "") { i = i + 1; continue; }
                    if (isGraphOutput(eff) == 1) { i = i + 1; continue; }
                    if (liveConsumers(eff) == 0) {
                        if (nFused_[i] == 1) markDeadTensor(nOut0_[i]);
                        nType_[i] = "";
                        markDeadTensor(eff);
                        dceCount_ = dceCount_ + 1;
                        changed = 1;
                    }
                    i = i + 1;
                }
            }
            return 1;
        }
        // 融合节点的有效输出：nFused_=1 时是 nFusedOut_（被融合改写后的目标输出）
        string effectiveOut(int i) {
            if (nFused_[i] == 1) return nFusedOut_[i];
            return nOut0_[i];
        }
        int liveConsumers(string name) {
            int cnt = 0;
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] == "") { i = i + 1; continue; }
                if (nIn0_[i] == name || nIn1_[i] == name || nIn2_[i] == name || nIn3_[i] == name || nIn4_[i] == name) cnt = cnt + 1;
                i = i + 1;
            }
            return cnt;
        }

        // ---- G2：常量折叠（Constant 节点 → initializer）----
        // 在 inferShapes 之前运行：把 op_type=="Constant" 且 value 为 float 张量的节点
        // 折叠为持久张量（写权重表，wRole_=4 直接拷贝），节点标记死，输出形状登记 FC_C。
        // 消费者（Add/Relu 等逐元素算子）按 flat 读，无需改线。
        // 注：仅支持 FLOAT（raw_data/float_data）；double/int 常量暂不折叠（模型报不支持）。
        int foldConstants() {
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] == "Constant" && nConstVal_[i] == 1) {
                    int off = nConstOff_[i];
                    int len = nConstLen_[i];
                    int end = off + len;
                    pb_.seek(off);
                    int[] dims = new int[8];
                    int dimCount = 0;
                    int dt = 0;
                    int payloadKind = 0;
                    int payloadOff = 0;
                    int payloadLen = 0;
                    while (pb_.pos() < end) {
                        int f = pb_.nextTag();
                        if (f == -1) break;
                        if (f == 1) {
                            if (dimCount < 8) { dims[dimCount] = pb_.readVarint(); dimCount = dimCount + 1; }
                            else { long v = pb_.readVarint64(); }
                        } else if (f == 2) {
                            dt = pb_.readVarint();
                        } else if (f == 4 || f == 9) {
                            payloadKind = 1;
                            payloadLen = pb_.readLen();
                            payloadOff = pb_.payloadOff();
                            pb_.skipBytes(payloadLen);
                        } else if (f == 10) {
                            payloadKind = 2;
                            payloadLen = pb_.readLen();
                            payloadOff = pb_.payloadOff();
                            pb_.skipBytes(payloadLen);
                        } else {
                            pb_.skipField();
                        }
                    }
                    if (dt == 1 && payloadKind == 1) {   // FLOAT
                        int rows = 1; int cols = 1;
                        if (dimCount == 0) { rows = 1; cols = 1; }
                        else if (dimCount == 1) { rows = dims[0]; cols = 1; }
                        else if (dimCount == 2) { rows = dims[0]; cols = dims[1]; }
                        else {
                            rows = dims[0];
                            cols = 1;
                            int k = 1;
                            while (k < dimCount) { cols = cols * dims[k]; k = k + 1; }
                        }
                        wName_[wCount_] = nOut0_[i];
                        wRows_[wCount_] = rows;
                        wCols_[wCount_] = cols;
                        wType_[wCount_] = dt;
                        wKind_[wCount_] = payloadKind;
                        wOff_[wCount_] = payloadOff;
                        wLen_[wCount_] = payloadLen;
                        wTrans_[wCount_] = 0;
                        wBias_[wCount_] = 0;
                        wRole_[wCount_] = 4;      // 通用常量：直接拷贝
                        wNHWC_[wCount_] = 0;
                        wBN_[wCount_] = 0;          // G3：常量不折叠 BN
                        wBNOnly_[wCount_] = 0;
                        wCount_ = wCount_ + 1;
                        addShapeD(nOut0_[i], dims, dimCount);
                        setShapeKind(nOut0_[i], Kind.FC_C());
                        nType_[i] = "";
                        foldCount_ = foldCount_ + 1;
                    }
                }
                i = i + 1;
            }
            return 1;
        }

        // ---- G2：布局变换 NCHW→NHWC（opt-in，setLayoutNHWC(1) 开启）----
        // 把 CNN 主干（Conv/MaxPool/Add/Relu 链）切到 NHWC 布局：
        //  - 图输入/非 NHWC 生产者 → 插入 NCHW2NHWC 转置节点（运行时 opKind=12）
        //  - Conv 权重在装载时转置 [Cout,Cin,KH,KW]→[Cout,KH,KW,Cin]（wNHWC_ 标记）
        //  - NHWC 张量以 (N,H,W,C) 元数据登记（shNHWC_ 标记），NHWC 内核按此索引
        //  - GAP 为布局无关边界（读 NHWC 输入、产 [N,C] 输出），Flatten/Gemm 不受影响
        int layoutNHWC() {
            // Phase A：按拓扑序标记节点布局（nNHWC_）
            int i = 0;
            while (i < nCount_) {
                nNHWC_[i] = 0;
                string t = nType_[i];
                if (t == "Conv") nNHWC_[i] = 1;                       // 卷积主干始终 NHWC
                else if (t == "MaxPool" || t == "Add" || t == "Relu" || t == "BatchNormalization") {
                    int p0 = producerNHWC(nIn0_[i]);
                    int p1 = producerNHWC(nIn1_[i]);
                    if (p0 == 1 || p1 == 1) nNHWC_[i] = 1;
                } else if (t == "GlobalAveragePool") {
                    nNHWC_[i] = producerNHWC(nIn0_[i]);               // 输入侧 NHWC，输出为 NCHW 边界
                }
                i = i + 1;
            }
            // Phase A.5：NHWC 节点的输出张量登记为 NHWC（GAP 输出是边界，除外）
            i = 0;
            while (i < nCount_) {
                if (nNHWC_[i] == 1 && nType_[i] != "GlobalAveragePool") {
                    setShapeNHWC(effectiveOut(i));
                }
                i = i + 1;
            }
            // Phase B：确保 NHWC 节点的激活输入都在 NHWC（必要时插入转置节点）
            i = 0;
            while (i < nCount_) {
                string t = nType_[i];
                if (nNHWC_[i] == 1 && (t == "Conv" || t == "MaxPool" || t == "Add" || t == "Relu" || t == "GlobalAveragePool" || t == "BatchNormalization")) {
                    ensureNHWCInput(i, 0);
                    if (t == "Conv") markWeightNHWC(nIn1_[i]);
                    if (t == "Add") ensureNHWCInput(i, 1);
                }
                i = i + 1;
            }
            return 1;
        }
        // 张量生产节点是否 NHWC（融合节点看有效输出；图输入/初始器视为非 NHWC）
        int producerNHWC(string name) {
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] == "") { i = i + 1; continue; }
                string eff = nOut0_[i];
                if (nFused_[i] == 1) eff = nFusedOut_[i];
                if (eff == name) return nNHWC_[i];
                i = i + 1;
            }
            return 0;
        }
        // 确保节点的第 slot 个激活输入在 NHWC：若生产者非 NHWC 且非初始器 → 插入转置
        void ensureNHWCInput(int nodeIdx, int slot) {
            string nm;
            if (slot == 0) nm = nIn0_[nodeIdx];
            else nm = nIn1_[nodeIdx];
            if (nm == "") return;
            if (producerNHWC(nm) == 1) return;    // 已是 NHWC
            if (initIdx(nm) >= 0) return;         // 初始器（权重单独处理）
            string tname = nm + "#nhwc";
            if (shapeIdx(tname) < 0) {
                int s = shapeIdx(nm);
                if (s < 0) return;
                int N = shD0_[s]; int H = shD1_[s]; int W = shD2_[s]; int C = shD3_[s];
                addShapeD4(tname, N, H, W, C);              // [N,H,W,C] 形状
                setShapeKind(tname, Kind.CNN_ACT());
                shNHWC_[shapeIdx(tname)] = 1;
                // 追加 NCHW2NHWC 转置节点
                nType_[nCount_] = "NCHW2NHWC";
                nIn0_[nCount_] = nm;
                nOut0_[nCount_] = tname;
                nConstVal_[nCount_] = 0;
                nNHWC_[nCount_] = 1;
                nFused_[nCount_] = 0;
                nFusedBy_[nCount_] = -1;
                nFusedOut_[nCount_] = "";
                nCount_ = nCount_ + 1;
            }
            if (slot == 0) nIn0_[nodeIdx] = tname;
            else nIn1_[nodeIdx] = tname;
        }
        void markWeightNHWC(string name) {
            int wi = initIdx(name);
            if (wi >= 0) {
                wNHWC_[wi] = 1;
                setShapeNHWC(name);
            }
        }
        void markDeadTensor(string name) {
            int s = shapeIdx(name);
            if (s >= 0) shDead_[s] = 1;
        }
        void setShapeNHWC(string name) {
            int s = shapeIdx(name);
            if (s >= 0) shNHWC_[s] = 1;
        }

        // ---- 拓扑排序（Kahn）----
        // ONNX 节点列表本是拓扑序，但布局变换在尾部追加了 NCHW2NHWC 转置节点
        // （其输入是图输入/非 NHWC 生产者）。为保证转置先于消费者执行，
        // 用 Kahn 按数据依赖重排活节点到 planOrder_（死节点剔除）。
        // 输出以 effectiveOut 计（融合节点产出的是 nFusedOut_ 张量）。
        int topoSort() {
            int[] indeg = new int[512];
            int i = 0;
            while (i < nCount_) {
                indeg[i] = 0;
                if (nType_[i] == "") { i = i + 1; continue; }
                if (producerIdx(nIn0_[i]) >= 0) indeg[i] = indeg[i] + 1;
                if (producerIdx(nIn1_[i]) >= 0) indeg[i] = indeg[i] + 1;
                if (producerIdx(nIn2_[i]) >= 0) indeg[i] = indeg[i] + 1;
                i = i + 1;
            }
            planOrderCount_ = 0;
            int remaining = 0;
            i = 0;
            while (i < nCount_) { if (nType_[i] != "") remaining = remaining + 1; i = i + 1; }
            while (planOrderCount_ < remaining) {
                int picked = -1;
                i = 0;
                while (i < nCount_) {
                    if (nType_[i] != "" && indeg[i] == 0) { picked = i; i = nCount_; }
                    i = i + 1;
                }
                if (picked < 0) return 0;   // 有环
                planOrder_[planOrderCount_] = picked;
                planOrderCount_ = planOrderCount_ + 1;
                indeg[picked] = -1;
                string out = effectiveOut(picked);
                int j = 0;
                while (j < nCount_) {
                    if (nType_[j] == "" || indeg[j] < 0) { j = j + 1; continue; }
                    if (nIn0_[j] == out || nIn1_[j] == out || nIn2_[j] == out) indeg[j] = indeg[j] - 1;
                    j = j + 1;
                }
            }
            return 1;
        }
        int producerIdx(string name) {
            int i = 0;
            while (i < nCount_) {
                if (nType_[i] == "") { i = i + 1; continue; }
                if (effectiveOut(i) == name) return i;
                i = i + 1;
            }
            return -1;
        }

        // ---- 内存规划（first-fit 复用）：返回所需 arena 容量 ----
        // 生命周期以拓扑序位置计（topoSort 已重排，转置/融合节点位置正确）；
        // 死张量（shDead_）跳过不分配。
        int planMemory() {
            int si = 0;
            while (si < sCount_) { planProducer_[si] = -1; planLastUse_[si] = -1; planOff_[si] = 0; si = si + 1; }
            // producer = 产出该张量的节点在拓扑序中的位置（融合节点以 effectiveOut 计）
            int oi = 0;
            while (oi < planOrderCount_) {
                int ni = planOrder_[oi];
                int s = shapeIdx(effectiveOut(ni));
                if (s >= 0) planProducer_[s] = oi;
                oi = oi + 1;
            }
            // lastUse = 消费该张量的最大拓扑位置（活节点）
            oi = 0;
            while (oi < planOrderCount_) {
                int ni = planOrder_[oi];
                int a = shapeIdx(nIn0_[ni]); if (a >= 0 && oi > planLastUse_[a]) planLastUse_[a] = oi;
                int b = shapeIdx(nIn1_[ni]); if (b >= 0 && oi > planLastUse_[b]) planLastUse_[b] = oi;
                int c = shapeIdx(nIn2_[ni]); if (c >= 0 && oi > planLastUse_[c]) planLastUse_[c] = oi;
                oi = oi + 1;
            }
            // first-fit 分配（按形状表顺序 = 拓扑序）
            // persistent：权重 / 图输入 / 图输出（多 pass 需全程存活，区域不可复用）
            int rc = 0;
            int highWater = 0;
            si = 0;
            while (si < sCount_) {
                if (shDead_[si] == 1) { planOff_[si] = 0; si = si + 1; continue; }   // G2：死张量不分配
                int size = shD0_[si] * shD1_[si] * shD2_[si] * shD3_[si];
                int producer = planProducer_[si];
                int lastUse = planLastUse_[si];
                int persist = 0;
                if (producer < 0) persist = 1;            // 权重 / 图输入
                if (lastUse < 0) { persist = 1; lastUse = nCount_ - 1; }  // 图输出
                if (noReuse_ == 1) persist = 1;            // 调试：不复用
                int best = -1;
                if (persist == 0) {
                    int r = 0;
                    while (r < rc) {
                        if (planRPersist_[r] == 0 && planRLu_[r] < producer && planRSize_[r] >= size) { best = r; r = rc; }
                        r = r + 1;
                    }
                }
                int off = 0;
                if (best >= 0) {
                    off = planROff_[best];
                    planRSize_[best] = size;
                    planRLu_[best] = lastUse;
                } else {
                    off = highWater;
                    highWater = highWater + size;
                    planROff_[rc] = off;
                    planRSize_[rc] = size;
                    planRLu_[rc] = lastUse;
                    planRPersist_[rc] = persist;
                    rc = rc + 1;
                }
                planOff_[si] = off;
                si = si + 1;
            }
            return highWater;
        }

        // ---- 构建到运行时（按内存规划偏移登记；接线 FC + CNN）----
        int buildRuntime(InferenceRuntime rt) {
            // 1) 登记张量（按形状表顺序，用规划偏移；死张量跳过）
            int si = 0;
            while (si < sCount_) {
                if (shDead_[si] == 1) { si = si + 1; continue; }
                string nm = shName_[si];
                int kind = shKind_[si];
                int d0 = shD0_[si]; int d1 = shD1_[si]; int d2 = shD2_[si]; int d3 = shD3_[si];
                int off = planOff_[si];
                int tid = -1;
                if (kind == Kind.FC_ACT()) {
                    tid = rt.addTensorPlanned2(d1, d0, off);            // ONNX [M,N] → 运行时 [N,M]
                } else if (kind == Kind.FC_W()) {
                    int ii = initIdx(nm);
                    if (ii >= 0 && wTrans_[ii] == 1) tid = rt.addTensorPlanned2(d0, d1, off);   // [N,K]
                    else tid = rt.addTensorPlanned2(d1, d0, off);       // [K,N] → [N,K]
                } else if (kind == Kind.FC_B()) {
                    tid = rt.addTensorPlanned2(d0, 1, off);             // [N] → [N,1]
                } else if (kind == Kind.CNN_B()) {
                    tid = rt.addTensorPlanned2(d0, 1, off);             // [Cout] → [Cout,1]
                } else if (kind == Kind.FC_C()) {
                    tid = rt.addTensorPlanned2(d0, d1, off);            // G2：折叠常量，直接拷贝 [d0,d1]
                } else if (shNHWC_[si] == 1) {
                    tid = rt.addTensorPlanned4(d0, d2, d3, d1, off);    // G2：NHWC 激活 [N,H,W,C] / 权重 [Cout,KH,KW,Cin]
                } else {
                    tid = rt.addTensorPlanned4(d0, d1, d2, d3, off);    // CNN 权重/激活 NCHW
                }
                if (tid < 0) return 0;
                tName_[tCount_] = nm;
                tId_[tCount_] = tid;
                tCount_ = tCount_ + 1;
                si = si + 1;
            }
            // 2) 接线算子（按拓扑序：G2 转置节点先于消费者执行）
            int oi = 0;
            while (oi < planOrderCount_) {
                int ni = planOrder_[oi];
                string t = nType_[ni];
                if (t == "") { oi = oi + 1; continue; }   // 死节点跳过
                int a = tensorId(nIn0_[ni]);
                int out = tensorId(effectiveOut(ni));     // G2：融合节点用有效输出（nFusedOut_）
                if (a < 0 || out < 0) return 0;
                if (t == "Gemm") {
                    int w = tensorId(nIn1_[ni]);
                    int b = tensorId(nIn2_[ni]);
                    rt.addDense(a, w, b, out);
                } else if (t == "MatMul") {
                    int w = tensorId(nIn1_[ni]);
                    rt.addMatmul(a, w, out);
                } else if (t == "Add") {
                    int b = tensorId(nIn1_[ni]);
                    rt.addAdd(a, b, out);
                } else if (t == "Relu") {
                    rt.addRelu(a, out);
                } else if (t == "Sigmoid") {
                    rt.addSigmoid(a, out);
                } else if (t == "Softmax") {
                    rt.addSoftmax(a, out);
                } else if (t == "ReLU6") {
                    rt.addReLU6(a, out);
                } else if (t == "LeakyRelu") {
                    rt.addLeakyRelu(a, out, nAlphaInt_[ni], nHasAlpha_[ni]);
                } else if (t == "SiLU") {
                    rt.addSiLU(a, out);
                } else if (t == "HardSwish") {
                    rt.addHardSwish(a, out);
                } else if (t == "Clip") {
                    // G4：Clip（ReLU6=Clip(x,0,6)）；min/max 为标量输入（opset 11+）
                    rt.addClip(a, out, tensorId(nIn1_[ni]), tensorId(nIn2_[ni]));
                } else if (t == "Conv") {
                    int w = tensorId(nIn1_[ni]);
                    int b = tensorId(nIn2_[ni]);
                    if (nNHWC_[ni] == 1) {
                        // G2：NHWC 卷积（权重已在装载时转置 [Cout,KH,KW,Cin]）
                        if (nRelu_[ni] == 1) rt.addConvNHWCRelu(a, w, b, out, nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni], nDH_[ni], nDW_[ni], nGroup_[ni]);
                        else rt.addConvNHWC(a, w, b, out, nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni], nDH_[ni], nDW_[ni], nGroup_[ni]);
                    } else if (nRelu_[ni] == 1) {
                        // G1：融合 Conv+ReLU → 写 relu 输出（中间张量不写回）
                        rt.addConvRelu(a, w, b, out, nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni], nDH_[ni], nDW_[ni], nGroup_[ni]);
                    } else {
                        // G3：BN 折叠的普通卷积（可能无 relu，勿套 relu）
                        rt.addConv(a, w, b, out, nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni], nDH_[ni], nDW_[ni], nGroup_[ni]);
                    }
                } else if (t == "MaxPool") {
                    if (nNHWC_[ni] == 1) rt.addMaxPoolNHWC(a, out, nKH_[ni], nKW_[ni], nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni]);
                    else rt.addMaxPool(a, out, nKH_[ni], nKW_[ni], nSH_[ni], nSW_[ni], nPT_[ni], nPB_[ni], nPL_[ni], nPR_[ni]);
                } else if (t == "GlobalAveragePool") {
                    // G2：out 已是融合后的 flatten 输出（fuseGapFlatten 改写）；GAP 布局无关
                    if (nNHWC_[ni] == 1) rt.addGAPoolNHWC(a, out);
                    else rt.addGAPool(a, out);
                } else if (t == "NCHW2NHWC") {
                    rt.addTransposeNCHW2NHWC(a, out);   // G2：布局变换转置节点
                } else if (t == "Flatten") {
                    rt.addFlatten(a, out);
                } else if (t == "BatchNormalization") {
                    // G3：独立 BN（未与 Conv 融合）；eps 位型传给 runtime 在分发时解析
                    int sT = tensorId(nIn1_[ni]);
                    int bT = tensorId(nIn2_[ni]);
                    int mT = tensorId(nIn3_[ni]);
                    int vT = tensorId(nIn4_[ni]);
                    if (sT < 0 || bT < 0 || mT < 0 || vT < 0) return 0;
                    if (nNHWC_[ni] == 1) rt.addBatchNormNHWC(a, out, sT, bT, mT, vT, nEpsInt_[ni], nHasEps_[ni]);
                    else rt.addBatchNorm(a, out, sT, bT, mT, vT, nEpsInt_[ni], nHasEps_[ni]);
                } else {
                    return 0;
                }
                oi = oi + 1;
            }
            // 3) 写权重
            int wi = 0;
            while (wi < wCount_) {
                int tid = tensorId(wName_[wi]);
                if (tid < 0) { wi = wi + 1; continue; }
                writeWeight(rt, wi, tid);
                wi = wi + 1;
            }
            return 1;
        }

        void writeWeight(InferenceRuntime rt, int wi, int tid) {
            int off = wOff_[wi];
            int count = wLen_[wi] / 4;
            int j = 0;
            if (wRole_[wi] == 3) {
                // CNN 偏置：直接拷贝（G3：BN 折叠则应用偏置公式；G4：无原偏置卷积由 BN 合成）
                j = 0;
                while (j < count) {
                    double b = 0.0;
                    if (wBNOnly_[wi] == 0) b = f32At(off + j * 4);
                    double v = b;
                    if (wBN_[wi] == 1) v = bnFoldBias(wi, j, b);
                    rt.setFlat(tid, j, v);
                    j = j + 1;
                }
            } else if (wRole_[wi] == 2 && wNHWC_[wi] == 1) {
                // G2：CNN 权重 NHWC 转置 [Cout,Cin,KH,KW] → [Cout,KH,KW,Cin]
                // G3：BN 折叠按输出通道缩放（与转置可交换）
                int s = shapeIdx(wName_[wi]);
                int Cout = shD0_[s]; int Cin = shD1_[s]; int KH = shD2_[s]; int KW = shD3_[s];
                int co = 0;
                while (co < Cout) {
                    int ci = 0;
                    while (ci < Cin) {
                        int kh = 0;
                        while (kh < KH) {
                            int kw = 0;
                            while (kw < KW) {
                                int src = ((co * Cin + ci) * KH + kh) * KW + kw;
                                int dst = ((co * KH + kh) * KW + kw) * Cin + ci;
                                double v = f32At(off + src * 4);
                                if (wBN_[wi] == 1) v = v * bnInvStd(wi, co);
                                rt.setFlat(tid, dst, v);
                                kw = kw + 1;
                            }
                            kh = kh + 1;
                        }
                        ci = ci + 1;
                    }
                    co = co + 1;
                }
            } else if (wRole_[wi] == 2 || wRole_[wi] == 1 || wRole_[wi] == 4) {
                // CNN 权重 NCHW / FC 偏置 / G2 折叠常量：直接拷贝
                // G3：CNN 权重 BN 折叠按输出通道缩放
                j = 0;
                while (j < count) {
                    double v = f32At(off + j * 4);
                    if (wRole_[wi] == 2 && wBN_[wi] == 1) {
                        int perOc = count / wRows_[wi];
                        if (perOc < 1) perOc = 1;
                        v = v * bnInvStd(wi, j / perOc);
                    }
                    rt.setFlat(tid, j, v);
                    j = j + 1;
                }
            } else if (wTrans_[wi] == 1) {
                // FC 权重 transB=1：wire=[N,K] 直接拷贝
                j = 0;
                while (j < count) { rt.setFlat(tid, j, f32At(off + j * 4)); j = j + 1; }
            } else {
                // FC 权重 transB=0：wire=[K,N] 转置为 [N,K]
                int rows = wRows_[wi]; int cols = wCols_[wi];
                int k = 0;
                while (k < rows) {
                    int n = 0;
                    while (n < cols) {
                        rt.setFlat(tid, n * rows + k, f32At(off + (k * cols + n) * 4));
                        n = n + 1;
                    }
                    k = k + 1;
                }
            }
        }

        double f32At(int byteOff) {
            int b0 = file_[byteOff];
            int b1 = file_[byteOff + 1];
            int b2 = file_[byteOff + 2];
            int b3 = file_[byteOff + 3];
            int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            return F32.toDouble(bits);
        }

    property:
        int[] file_;
        int fileLen_;
        PbReader pb_;

        string[256] wName_;
        int[256] wRows_;
        int[256] wCols_;
        int[256] wType_;
        int[256] wKind_;
        int[256] wOff_;
        int[256] wLen_;
        int[256] wTrans_;
        int[256] wBias_;
        int[256] wRole_;
        int[256] wNHWC_;         // G2：1 = CNN 权重按 NHWC 转置装载
        int[256] wBN_;           // G3：1 = 该权重需 BN 折叠
        int[256] wBNNode_;       // G3：BN 节点下标（取 eps）
        int[256] wBNScale_;      // G3：BN scale 初始器下标
        int[256] wBNBias_;       // G3：BN bias 初始器下标
        int[256] wBNMean_;       // G3：BN mean 初始器下标
        int[256] wBNVar_;        // G3：BN var 初始器下标
        int[256] wBNOnly_;       // G4：1 = 由 BN 合成偏置（无原卷积偏置）
        int wCount_;

        string[512] nType_;
        string[512] nIn0_;
        string[512] nIn1_;
        string[512] nIn2_;
        string[512] nIn3_;   // G3：BatchNormalization 第 3 输入（mean）
        string[512] nIn4_;   // G3：BatchNormalization 第 4 输入（var）
        string[512] nOut0_;
        int[512] nTransB_;
        int[512] nAxis_;
        int[512] nSH_;
        int[512] nSW_;
        int[512] nPT_;
        int[512] nPB_;
        int[512] nPL_;
        int[512] nPR_;
        int[512] nDH_;
        int[512] nDW_;
        int[512] nGroup_;
        int[512] nKH_;
        int[512] nKW_;
        int[512] nEpsInt_;       // G3：BN epsilon 属性位型
        int[512] nHasEps_;       // G3：1 = 有 epsilon 属性
        int[512] nAlphaInt_;     // G4：LeakyRelu alpha 属性位型
        int[512] nHasAlpha_;     // G4：1 = 有 alpha 属性
        int[512] nFused_;        // G1：1 = Conv 已与 Relu 融合
        int[512] nFusedBy_;      // G1：被消掉的 Relu 记录取代它的 Conv 下标
        string[512] nFusedOut_;  // G1：fused Conv 的目标输出名（Relu 的输出）
        int[512] nRelu_;         // G4：1 = Conv 与 Relu 融合（G1 设置；与 BN 融合区分）
        int[512] nNHWC_;         // G2：1 = 节点在 NHWC 布局执行
        int[512] nConstVal_;     // G2：1 = Constant 节点有 value 属性
        int[512] nConstOff_;     // G2：Constant value TensorProto 偏移
        int[512] nConstLen_;     // G2：Constant value TensorProto 长度
        int nCount_;
        int fuseCount_;          // G1：Conv+ReLU 融合数
        int gapCount_;           // G2：GAP+Flatten 融合数
        int dceCount_;           // G2：死算子消除数
        int foldCount_;          // G2：常量折叠数
        int bnCount_;            // G3：Conv+BN 融合数
        int noReuse_;            // 调试：1 = 内存规划不复用区域（MYP_NO_REUSE=1）
        int doNHWC_;             // G2：布局变换开关（setLayoutNHWC）

        string[64] goName_;      // 图输出名（G1 融合安全）
        int goCount_;

        string[512] shName_;
        int[512] shD0_;
        int[512] shD1_;
        int[512] shD2_;
        int[512] shD3_;
        int[512] shKind_;
        int[512] shNHWC_;        // G2：1 = 张量以 NHWC (N,H,W,C) 登记
        int[512] shDead_;        // G2：1 = 死张量（不分配/不登记）
        int sCount_;

        int[512] planOff_;
        int[512] planProducer_;
        int[512] planLastUse_;
        int[512] planOrder_;        // G2：拓扑排序后的活节点下标（buildRuntime/planMemory 用）
        int planOrderCount_;
        int[512] planROff_;
        int[512] planRSize_;
        int[512] planRLu_;
        int[512] planRPersist_;

        string[512] tName_;
        int[512] tId_;
        int tCount_;
}
