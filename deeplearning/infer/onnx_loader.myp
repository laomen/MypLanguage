// onnx_loader.myp — 纯 MYP ONNX 读取器（Path B）—— G5 重构后为「薄解析器」
// 运行时直接解析真实 .onnx（protobuf wire 格式），填充通用图优化器 Graph（graph.myp），
// 再由 graph.optimize(rt) 跑完整 pass 管线并构建到 InferenceRuntime。
// 图 IR / 图 pass / 内存规划 / buildRuntime 已移至 graph.myp（格式无关通用组件）。
//
// 支持算子：Gemm / MatMul / Add / Relu / Sigmoid / Softmax（全连接）+
//          Conv / MaxPool / GlobalAveragePool / Flatten / BatchNormalization / 激活。
import env;
import math;
import "./pb.myp";
import "./runtime.myp";
import "./graph.myp";

class OnnxLoader {
    action:
        @constructor OnnxLoader() { pb_ = new PbReader(); }

        // 从 .onnx 加载到运行时。成功返回 1，失败返回 0。
        int load(string path, InferenceRuntime rt) {
            if (readFile(path) == 0) return 0;
            if (fileLen_ <= 0) return 0;
            g_ = new Graph();
            g_.setFile(file_, fileLen_);
            g_.resetCounts();
            if (doNHWC_ == 1) g_.setLayoutNHWC(1);
            pb_.init(file_, fileLen_);
            if (parseModel() == 0) return 0;
            return g_.optimize(rt);
        }

        // 名称 → 张量 id（找不到返回 -1）—— 委托 Graph
        int tensorId(string name) { return g_.tensorId(name); }
        void setLayoutNHWC(int v) { doNHWC_ = v; }
        int doNHWC() { return doNHWC_; }
        int fuseCount() { return g_.fuseCount(); }
        int gapCount() { return g_.gapCount(); }
        int dceCount() { return g_.dceCount(); }
        int foldCount() { return g_.foldCount(); }
        int bnCount() { return g_.bnCount(); }
        int nodeCount() { return g_.nodeCount(); }

    function:
        // 读文件字节到 file_（增长型缓冲，返回 1=成功）
        int readFile(string path) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return 0;
            int cap = 65536;
            file_ = new int[cap];
            fileLen_ = 0;
            while (true) {
                int b = __myp_io_read_byte();
                if (b < 0) break;
                if (fileLen_ >= cap) {
                    int ncap = cap * 2;
                    int[] nb = new int[ncap];
                    int i = 0;
                    while (i < fileLen_) { nb[i] = file_[i]; i = i + 1; }
                    file_ = nb;
                    cap = ncap;
                }
                file_[fileLen_] = b;
                fileLen_ = fileLen_ + 1;
            }
            __myp_io_fclose();
            return 1;
        }

        // ---- 顶层 ModelProto：只取 graph（field 7）----
        int parseModel() {
            while (pb_.pos() < fileLen_) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 7) {
                    int l = pb_.readLen();
                    int po = pb_.payloadOff();
                    parseGraph(po, l);
                } else {
                    pb_.skipField();
                }
            }
            return 1;
        }

        int parseGraph(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    parseNode(po, l);
                } else if (f == 5) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    parseTensor(po, l);
                } else if (f == 11 || f == 12) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    string nm = parseValueInfo(po, l);
                    // 记录图输出名（G1 融合安全：被 fused 的中间张量不能是图输出）
                    if (f == 12) g_.addGraphOutput(nm);
                } else {
                    pb_.skipField();
                }
            }
            return 1;
        }

        // ---- NodeProto：用 Graph 构建 API 填充 ----
        int parseNode(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            int ni = g_.beginNode();
            int inIdx = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {           // input (string, repeated)
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    string s = pb_.readString(l);
                    if (inIdx < 5) g_.nodeIn(ni, inIdx, s);
                    inIdx = inIdx + 1;
                } else if (f == 2) {    // output
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    g_.nodeOut(ni, pb_.readString(l));
                } else if (f == 3) {    // name
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    pb_.skipBytes(l);
                } else if (f == 4) {    // op_type
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    g_.nodeType(ni, pb_.readString(l));
                } else if (f == 5) {    // attribute
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    parseAttr(po, l, ni);
                } else {
                    pb_.skipField();
                }
            }
            g_.endNode();
            return 1;
        }

        // ---- AttributeProto：name(1) / f(2) / int(3) / ints(8) / t(5) ----
        // 映射到 Graph.NodeField（格式无关字段码）
        int parseAttr(int off, int len, int ni) {
            int end = off + len;
            pb_.seek(off);
            string aname = "";
            int idx = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    aname = pb_.readString(l);
                } else if (f == 2) {    // f（float32 单值，如 BN epsilon / LeakyRelu alpha）
                    int bits = pb_.readU32();
                    if (aname == "epsilon") { g_.nodeInt(ni, NodeField.EPS_INT(), bits); g_.nodeInt(ni, NodeField.HAS_EPS(), 1); }
                    if (aname == "alpha") { g_.nodeInt(ni, NodeField.ALPHA_INT(), bits); g_.nodeInt(ni, NodeField.HAS_ALPHA(), 1); }
                } else if (f == 3) {    // int64 单值（transB / axis / group）
                    int v = pb_.readVarint();
                    if (aname == "transB") g_.nodeInt(ni, NodeField.TRANSB(), v);
                    if (aname == "axis") g_.nodeInt(ni, NodeField.AXIS(), v);
                    if (aname == "group") g_.nodeInt(ni, NodeField.GROUP(), v);
                } else if (f == 8) {    // ints：非打包，每个 varint 一个字段
                    int v = pb_.readVarint();
                    if (aname == "strides") { if (idx == 0) g_.nodeInt(ni, NodeField.SH(), v); else g_.nodeInt(ni, NodeField.SW(), v); }
                    else if (aname == "pads") {
                        // pads = [top, left, bottom, right]（2D）
                        if (idx == 0) g_.nodeInt(ni, NodeField.PT(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.PL(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.PB(), v);
                        else g_.nodeInt(ni, NodeField.PR(), v);
                    }
                    else if (aname == "dilations") { if (idx == 0) g_.nodeInt(ni, NodeField.DH(), v); else g_.nodeInt(ni, NodeField.DW(), v); }
                    else if (aname == "kernel_shape") { if (idx == 0) g_.nodeInt(ni, NodeField.KH(), v); else g_.nodeInt(ni, NodeField.KW(), v); }
                    else if (aname == "perm") {   // F8：Transpose perm（ints 非打包）
                        if (idx == 0) g_.nodeInt(ni, NodeField.PERM0(), v);
                        else if (idx == 1) g_.nodeInt(ni, NodeField.PERM1(), v);
                        else if (idx == 2) g_.nodeInt(ni, NodeField.PERM2(), v);
                        else g_.nodeInt(ni, NodeField.PERM3(), v);
                        g_.nodeInt(ni, NodeField.PERM_N(), idx + 1);
                    }
                    idx = idx + 1;
                } else if (f == 5) {    // t（Constant 节点的 value：TensorProto）记录字节，稍后折叠
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    g_.nodeInt(ni, NodeField.CONST_VAL(), 1);
                    g_.nodeInt(ni, NodeField.CONST_OFF(), po);
                    g_.nodeInt(ni, NodeField.CONST_LEN(), l);
                    pb_.skipBytes(l);
                } else {
                    pb_.skipField();
                }
            }
            return 1;
        }

        // ---- TensorProto（initializer）----
        int parseTensor(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            int[] dims = new int[8];
            int dimCount = 0;
            int dt = 0;
            int payloadKind = 0;
            int payloadOff = 0;
            int payloadLen = 0;
            string nm = "";
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {           // dims：非打包，每个维度一个 varint 字段
                    if (dimCount < 8) { dims[dimCount] = pb_.readVarint(); dimCount = dimCount + 1; }
                    else { long v = pb_.readVarint64(); }
                } else if (f == 2) {    // data_type
                    dt = pb_.readVarint();
                } else if (f == 4 || f == 9) {  // float_data(4) / raw_data(9)：packed f32 字节
                    payloadKind = 1;
                    payloadLen = pb_.readLen();
                    payloadOff = pb_.payloadOff();
                    pb_.skipBytes(payloadLen);  // 前进游标，跳过 payload（仅记录偏移，稍后从 file_ 读取）
                } else if (f == 7) {   // int64_data(7)：packed varint（F8：Reshape shape / Slice 参数）
                    payloadKind = 3;
                    payloadLen = pb_.readLen();
                    payloadOff = pb_.payloadOff();
                    pb_.skipBytes(payloadLen);
                } else if (f == 10) {   // double_data(10)：packed f64
                    payloadKind = 2;
                    payloadLen = pb_.readLen();
                    payloadOff = pb_.payloadOff();
                    pb_.skipBytes(payloadLen);
                } else if (f == 8) {    // name
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    nm = pb_.readString(l);
                } else {
                    pb_.skipField();
                }
            }
            // 登记 initializer（4D 维度；wRows/cols 保留为 [d0, prod(rest)] 视图）
            int rows = 1; int cols = 1;
            if (dimCount == 0) { rows = 1; cols = 1; }
            else if (dimCount == 1) { rows = dims[0]; cols = 1; }
            else if (dimCount == 2) { rows = dims[0]; cols = dims[1]; }
            else {
                rows = dims[0];
                cols = 1;
                int k = 1;
                while (k < dimCount) { cols = cols * dims[k]; k = k + 1; }
            }
            g_.addWeight(nm, rows, cols, dt, payloadKind, payloadOff, payloadLen);
            g_.addShapeD(nm, dims, dimCount);
            return 1;
        }

        // ---- ValueInfoProto（graph input/output）：取 name + 形状，返回名字 ----
        string parseValueInfo(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            string nm = "";
            int[] dims = new int[8];
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    nm = pb_.readString(l);
                } else if (f == 2) {
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    dimCount = parseTypeShape(po, l, dims);
                } else {
                    pb_.skipField();
                }
            }
            g_.addShapeD(nm, dims, dimCount);
            return nm;
        }

        // TypeProto → tensor_type → shape → dims（dim_param 视为 1）
        int parseTypeShape(int off, int len, int[] dims) {
            int end = off + len;
            pb_.seek(off);
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {   // tensor_type
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    dimCount = parseTensorType(po, l, dims);
                } else {
                    pb_.skipField();
                }
            }
            return dimCount;
        }

        int parseTensorType(int off, int len, int[] dims) {
            int end = off + len;
            pb_.seek(off);
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 2) {   // shape
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    dimCount = parseShape(po, l, dims);
                } else {
                    pb_.skipField();
                }
            }
            return dimCount;
        }

        int parseShape(int off, int len, int[] dims) {
            int end = off + len;
            pb_.seek(off);
            int dimCount = 0;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) {   // dim
                    int l = pb_.readLen(); int po = pb_.payloadOff();
                    int v = parseDim(po, l);
                    if (dimCount < 8) { dims[dimCount] = v; dimCount = dimCount + 1; }
                } else {
                    pb_.skipField();
                }
            }
            return dimCount;
        }

        int parseDim(int off, int len) {
            int end = off + len;
            pb_.seek(off);
            int v = 1;
            while (pb_.pos() < end) {
                int f = pb_.nextTag();
                if (f == -1) break;
                if (f == 1) { v = pb_.readVarint(); }
                else if (f == 2) { int l = pb_.readLen(); int po = pb_.payloadOff(); pb_.skipBytes(l); }
                else { pb_.skipField(); }
            }
            if (v <= 0) v = 1;
            return v;
        }

    property:
        int[] file_;
        int fileLen_;
        PbReader pb_;
        Graph g_;
        int doNHWC_;
}
