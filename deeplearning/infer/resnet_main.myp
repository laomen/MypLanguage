// resnet_main.myp — 纯 MYP 读取真实 ResNet50 ONNX 并推理（CNN 验证）
// 输入：deeplearning/data/onnx/resnet_input.f32（1*3*224*224 个 float32，NCHW）
//       （由 tools/prep_imagenet_input.py 从真实图片预处理生成）
// 输出：top-5 类别 + ImageNet 标签 + 推理耗时
// GPU：设 MYP_GPU=1 且 CUDA 可用时用 runGpu()（FP32 内核），否则 CPU run()
import env;
import cuda;
import "./pb.myp";
import "./runtime.myp";
import "./onnx_loader.myp";

class ResnetInferApp {
    action:
        @constructor ResnetInferApp() {
            loadLabels();
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(1024);

            OnnxLoader loader = new OnnxLoader();
            // G2：布局变换 opt-in（MYP_LAYOUT_NHWC=1 切到 NHWC 布局）
            string lv = Console.getEnv("MYP_LAYOUT_NHWC");
            if (lv == "1") loader.setLayoutNHWC(1);
            int ok = loader.load("./deeplearning/data/onnx/gluon_resnet50_v1b_Opset16.onnx", rt);
            if (ok == 0) {
                Console.writeLine("onnx load failed");
                return;
            }

            // 图优化统计（G1/G2）
            Console.writeString("graph: layout=");
            if (loader.doNHWC() == 1) Console.writeString("NHWC");
            else Console.writeString("NCHW");
            Console.writeString("  nodes=");
            Console.writeLong(loader.nodeCount());
            Console.writeString("  ops=");
            Console.writeLong(rt.opCount());
            Console.writeString("  convRelu_fused=");
            Console.writeLong(loader.fuseCount());
            Console.writeString("  bn_fused=");
            Console.writeLong(loader.bnCount());
            Console.writeString("  gapFlatten_fused=");
            Console.writeLong(loader.gapCount());
            Console.writeString("  dce=");
            Console.writeLong(loader.dceCount());
            Console.writeString("  const_folded=");
            Console.writeLong(loader.foldCount());
            Console.writeLine("");

            int inputTid = loader.tensorId("x");
            int outTid = loader.tensorId("495");
            if (inputTid < 0 || outTid < 0) {
                Console.writeLine("tensor not found");
                return;
            }

            // 读输入：1*3*224*224 float32
            int n = 3 * 224 * 224;
            int fd = __myp_io_fopen("./deeplearning/data/onnx/resnet_input.f32", "rb");
            if (fd < 0) { Console.writeLine("no input file"); return; }
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) { Console.writeLine("input short"); __myp_io_fclose(); return; }
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                rt.setFlat(inputTid, i, F32.toDouble(bits));
                i = i + 1;
            }
            __myp_io_fclose();

            // 推理（GPU 可用且 MYP_GPU=1 时用 runGpu，否则 run）
            int useGpu = Cuda.available();
            Console.writeString("device: ");
            if (useGpu == 1) { Console.writeString(Cuda.name()); Console.writeString(" (GPU)"); }
            else { Console.writeString("CPU"); }
            Console.writeLine("");
            long t0 = __myp_now_ms();
            if (useGpu == 1) rt.runGpu();
            else rt.run();
            long t1 = __myp_now_ms();
            Console.writeString("ResNet50 inference: ");
            Console.writeLong(t1 - t0);
            Console.writeLine(" ms");
            Console.writeLine("");

            Console.writeLine("top-5:");
            // 输出 checksum（NCHW/NHWC 布局数值一致性粗查；须在 top-5 置哨兵前）
            double ssum = 0.0;
            int st = 0;
            while (st < 1000) {
                ssum = ssum + rt.getFlat(outTid, st);
                st = st + 1;
            }
            Console.writeString("output sum: ");
            Console.writeFloat(ssum);
            Console.writeLine("");
            int k = 0;
            while (k < 5) {
                int bi = -1;
                double bv = 0.0 - 1.0e30;
                int t = 0;
                while (t < 1000) {
                    double v = rt.getFlat(outTid, t);
                    if (v > bv) { bv = v; bi = t; }
                    t = t + 1;
                }
                if (bi < 0) break;
                Console.writeString("  #");
                Console.writeLong(k + 1);
                Console.writeString("  [");
                Console.writeLong(bi);
                Console.writeString("] ");
                Console.writeString(label(bi));
                Console.writeString("  (");
                Console.writeFloat(bv);
                Console.writeLine(")");
                rt.setFlat(outTid, bi, 0.0 - 1.0e30);
                k = k + 1;
            }
        }

        void loadLabels() {
            int fd = __myp_io_fopen("./deeplearning/data/imagenet/classes.txt", "r");
            if (fd < 0) { labelCount_ = 0; return; }
            labelCount_ = 0;
            while (labelCount_ < 1000) {
                string line = __myp_io_read_line();
                if (Str.len(line) == 0) break;
                labels_[labelCount_] = line;
                labelCount_ = labelCount_ + 1;
            }
            __myp_io_fclose();
        }

        string label(int c) {
            if (c >= 0 && c < labelCount_) return labels_[c];
            return "?";
        }

    property:
        string[1000] labels_;
        int labelCount_;
}

int main() {
    ResnetInferApp app = new ResnetInferApp();
    return 0;
}
