// ops2d_main.myp — F8：2D 补齐端到端测试（Sub/Div/Mul/Sqrt/ReduceMean/InstanceNorm/Resize）
// ops2d_test.onnx（opset14）：x[1,3,8,8] → InstanceNorm → Resize(nearest,asymmetric,2x)
//   → ReduceMean(spatial) → Sub(逐通道广播) → Mul → ReduceMean(all) → Sqrt → Div
// 输入 x 与 ORT 参考 y 由 tools/make_2dops_onnx.py 生成（data/onnx/）。
// 运行：./build/mypc deeplearning/infer_tests/ops2d_main.myp -o /tmp/o2 --stdlib stdlib && /tmp/o2
import env;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class Ops2dTestApp {
    action:
        @constructor Ops2dTestApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/ops2d_test.onnx", rt);
            if (ok == 0) { Console.writeLine("load failed"); return; }
            Console.writeString("graph: ops=");
            Console.writeLong(rt.opCount());
            Console.writeLine("");

            int inT = loader.tensorId("x");
            int outT = loader.tensorId("y");
            if (inT < 0 || outT < 0) { Console.writeLine("tensor not found"); return; }
            int nIn = rt.tensorSize(inT);
            double[] buf = new double[512];
            readF32("./deeplearning/data/onnx/ops2d_test.f32", buf, nIn);
            int i = 0;
            while (i < nIn) { rt.setFlat(inT, i, buf[i]); i = i + 1; }
            rt.run();
            int m = rt.tensorSize(outT);
            Console.writeString("out size=");
            Console.writeLong(m);
            Console.writeLine("");
            int okC = checkOut(rt, outT, "./deeplearning/data/onnx/ops2d_test_ort.bin", m);
            if (okC == 1) Console.writeLine("OPS2D ALL OK");
            else Console.writeLine("OPS2D MISMATCH");
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path, int n) {
            if (tid < 0) return 0;
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("max diff vs ORT: ");
            Console.writeFloat(maxD);
            if (maxD < 1.0e-4) { Console.writeLine("  OK"); return 1; }
            Console.writeLine("  MISMATCH");
            return 0;
        }
}

int main() {
    Ops2dTestApp app = new Ops2dTestApp();
    return 0;
}
