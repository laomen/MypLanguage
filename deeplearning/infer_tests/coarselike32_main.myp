// coarselike32_main.myp — 3D 中尺度（32³）回归测试：预处理 + Conv3D → InstanceNorm → ReLU → MaxPool3D
// coarselike32.onnx（opset12）：x[1,1,16,16,16] → Resize(16→32) → 归一化
//   → Conv3D(w[2,1,3,3,3]) → InstanceNorm → ReLU → MaxPool3D(k2,s2) → y[1,2,16,16,16]
// 模型/输入/ORT 参考由 tools/make_coarselike_onnx.py 生成：
//   COARSELIKE_IN_D=16 COARSELIKE_RES_D=32 COARSELIKE_TAG=32 python tools/make_coarselike_onnx.py
// 运行：./build/mypc --stdlib stdlib deeplearning/infer_tests/coarselike32_main.myp -o /tmp/c3 && /tmp/c3
import env;
import cuda;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class Coarselike32App {
    action:
        @constructor Coarselike32App() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(4096);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/coarselike32.onnx", rt);
            if (ok == 0) { Console.writeLine("load failed"); return; }
            Console.writeString("graph: ops=");
            Console.writeLong(rt.opCount());
            Console.writeLine("");

            int inT = loader.tensorId("x");
            int outT = loader.tensorId("y");
            if (inT < 0 || outT < 0) { Console.writeLine("tensor not found"); return; }
            int nIn = rt.tensorSize(inT);
            double[] buf = new double[nIn + 16];
            readF32("./deeplearning/data/onnx/coarselike32_in.f32", buf, nIn);
            int i = 0;
            while (i < nIn) { rt.setFlat(inT, i, buf[i]); i = i + 1; }

            // CPU
            rt.run();
            int m = rt.tensorSize(outT);
            Console.writeString("out size=");
            Console.writeLong(m);
            Console.writeLine("");
            int okC = checkOut(rt, outT, "./deeplearning/data/onnx/coarselike32_ort.bin", m);
            if (okC == 1) Console.writeLine("COARSELIKE CPU OK");
            else Console.writeLine("COARSELIKE CPU MISMATCH");

            // GPU
            if (Cuda.available() == 1) {
                i = 0;
                while (i < nIn) { rt.setFlat(inT, i, buf[i]); i = i + 1; }
                rt.runGpu();
                int okG = checkOut(rt, outT, "./deeplearning/data/onnx/coarselike32_ort.bin", m);
                if (okG == 1) Console.writeLine("COARSELIKE GPU OK");
                else Console.writeLine("COARSELIKE GPU MISMATCH");
            } else {
                Console.writeLine("COARSELIKE GPU SKIP (no device)");
            }
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            if (fd < 0) return;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                out[i] = F32.toDouble(bits);
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path, int n) {
            if (tid < 0) return 0;
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("max diff vs ORT: ");
            Console.writeFloat(maxD);
            if (maxD < 1.0e-4) { Console.writeLine("  OK"); return 1; }
            Console.writeLine("  MISMATCH");
            return 0;
        }
}

int main() {
    Coarselike32App app = new Coarselike32App();
    return 0;
}
