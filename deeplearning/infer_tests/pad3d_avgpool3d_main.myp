// pad3d_avgpool3d_main.myp — 3D 扩展：Pad3D + AveragePool3D（含各向异性核）
// pad3d_avgpool3d.onnx（opset12）：x[1,2,8,8,8] → Pad(constant, [1,1,1]) → [1,2,10,10,10]
//   → AveragePool(k2,s2) → y[1,2,5,5,5]；另 AveragePool(k[1,2,2],s[1,2,2]) → y2[1,2,8,4,4]
import env;
import cuda;
import "../infer/pb.myp";
import "../infer/runtime.myp";
import "../infer/onnx_loader.myp";

class Pad3dAvgpool3dApp {
    action:
        @constructor Pad3dAvgpool3dApp() {
            InferenceRuntime rt = new InferenceRuntime();
            rt.init(2048);
            OnnxLoader loader = new OnnxLoader();
            int ok = loader.load("./deeplearning/data/onnx/pad3d_avgpool3d.onnx", rt);
            if (ok == 0) { Console.writeLine("load failed"); return; }
            Console.writeString("graph: ops=");
            Console.writeLong(rt.opCount());
            Console.writeLine("");

            int inT = loader.tensorId("x");
            int yT = loader.tensorId("y");
            int y2T = loader.tensorId("y2");
            if (inT < 0 || yT < 0 || y2T < 0) { Console.writeLine("tensor not found"); return; }
            int nIn = rt.tensorSize(inT);
            double[] buf = new double[2048];
            readF32("./deeplearning/data/onnx/pad3d_avgpool3d_in.f32", buf, nIn);
            int i = 0;
            while (i < nIn) { rt.setFlat(inT, i, buf[i]); i = i + 1; }
            rt.run();
            int okC = checkOut(rt, yT, "./deeplearning/data/onnx/pad3d_avgpool3d_y.bin");
            int okC2 = checkOut(rt, y2T, "./deeplearning/data/onnx/pad3d_avgpool3d_y2.bin");
            if (okC == 1 && okC2 == 1) Console.writeLine("PAD3D+AVGPOOL3D CPU OK");
            else Console.writeLine("PAD3D+AVGPOOL3D CPU MISMATCH");

            // GPU
            if (Cuda.available() == 1) {
                i = 0;
                while (i < nIn) { rt.setFlat(inT, i, buf[i]); i = i + 1; }
                rt.runGpu();
                int okG = checkOut(rt, yT, "./deeplearning/data/onnx/pad3d_avgpool3d_y.bin");
                int okG2 = checkOut(rt, y2T, "./deeplearning/data/onnx/pad3d_avgpool3d_y2.bin");
                if (okG == 1 && okG2 == 1) Console.writeLine("PAD3D+AVGPOOL3D GPU OK");
                else Console.writeLine("PAD3D+AVGPOOL3D GPU MISMATCH");
            } else {
                Console.writeLine("PAD3D+AVGPOOL3D GPU SKIP");
            }
        }

        void readF32(string path, double[] out, int n) {
            int fd = __myp_io_fopen(path, "rb");
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                out[i] = F32.toDouble(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24));
                i = i + 1;
            }
            __myp_io_fclose();
        }

        int checkOut(InferenceRuntime rt, int tid, string path) {
            int n = rt.tensorSize(tid);
            int fd = __myp_io_fopen(path, "rb");
            double maxD = 0.0;
            int i = 0;
            while (i < n) {
                int b0 = __myp_io_read_byte();
                int b1 = __myp_io_read_byte();
                int b2 = __myp_io_read_byte();
                int b3 = __myp_io_read_byte();
                if (b0 < 0 || b3 < 0) break;
                int bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
                double rv = F32.toDouble(bits);
                double dv = rt.getFlat(tid, i) - rv;
                if (dv < 0.0) dv = 0.0 - dv;
                if (dv > maxD) maxD = dv;
                i = i + 1;
            }
            __myp_io_fclose();
            Console.writeString("max diff vs ORT: ");
            Console.writeFloat(maxD);
            if (maxD < 1.0e-4) { Console.writeLine("  OK"); return 1; }
            Console.writeLine("  MISMATCH");
            return 0;
        }
}

int main() {
    Pad3dAvgpool3dApp app = new Pad3dAvgpool3dApp();
    return 0;
}
