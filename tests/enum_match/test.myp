// 枚举 + 模式匹配验证
import env;

// 简单枚举
enum Color {
    Red; Green; Blue;
}

// 带数据的枚举
enum Option {
    Some(int value);
    None;
}

// 多属性的枚举
enum Shape {
    Circle(double radius);
    Rect(double width, double height);
}

class Main {
    action:
        @startup void run() {
            Console.writeString("[枚举验证]\n");

            // 1. 简单枚举
            Color c = Color.Red;
            match (c) {
                Color.Red => { Console.writeString("  Color: Red\n"); }
                Color.Green => { Console.writeString("  Color: Green\n"); }
                Color.Blue => { Console.writeString("  Color: Blue\n"); }
            }

            // 2. 所有变体
            Color c2 = Color.Green;
            match (c2) {
                Color.Red => { Console.writeString("  Color: Red\n"); }
                Color.Green => { Console.writeString("  Color: Green (correct)\n"); }
                Color.Blue => { Console.writeString("  Color: Blue\n"); }
            }

            // 3. 带数据的枚举
            Option opt = Option.Some(42);
            match (opt) {
                Option.Some(v) => { Console.writeString("  Option.Some: index=0 data(v)="); Console.write(v); Console.writeString("\n"); }
                Option.None => { Console.writeString("  Option.None\n"); }
            }

            // 4. 多属性枚举
            Shape s = Shape.Circle(5.0);
            match (s) {
                Shape.Circle(r) => { Console.writeString("  Shape: Circle variant=0 radius="); Console.writeFloat(r); Console.writeString("\n"); }
                Shape.Rect(w,h) => { Console.writeString("  Shape: Rect variant=1\n"); }
            }

            Console.writeString("[OK] 枚举验证通过\n");
        }
}

int main(){Main m=new Main();return 0;}
