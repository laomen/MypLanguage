// short_circuit: && / || 短路求值（编译器修复 §九-8）
// 验证：a 为 false/true 时不再求值 b（用副作用计数检测）
import env;

class T {
    action:
        int g() {
            gcount = gcount + 1;
            return 1;
        }
        int run() {
            // &&：lhs false → rhs 不求值
            gcount = 0;
            if (0 != 0 && g() != 0) Console.writeString("bad");
            Console.writeString("and_skip=" + gcount);
            // &&：lhs true → rhs 求值
            gcount = 0;
            if (1 != 0 && g() != 0) Console.writeString(" ok1");
            Console.writeString(" and_call=" + gcount);
            // ||：lhs true → rhs 不求值
            gcount = 0;
            if (1 != 0 || g() != 0) Console.writeString(" ok2");
            Console.writeString(" or_skip=" + gcount);
            // ||：lhs false → rhs 求值
            gcount = 0;
            if (0 != 0 || g() != 0) Console.writeString(" ok3");
            Console.writeString(" or_call=" + gcount);
            // 嵌套：a && b || c（|| 短路使 a&&b 不求值）
            gcount = 0;
            if (0 != 0 && g() != 0 || 1 != 0) Console.writeString(" ok4");
            Console.writeString(" nest_skip=" + gcount);
            Console.writeString("\n");
            return 0;
        }
    property:
        int gcount;
}

int pmRun() {
    T t = new T();
    return t.run();
}
int main() { int c = pmRun(); return c; }
