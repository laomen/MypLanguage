// 嵌套 struct 和返回 struct 测试
import env;

struct Inner {
    double val;
}

struct Outer {
    Inner inner;
    string label;

    Inner getInner() {
        return inner;
    }
}

class Main {
    action:
        @startup void run() {
            Outer o;
            o.label = "test";
            o.inner.val = 3.14;

            Console.writeString("label=");
            Console.writeString(o.label);
            Console.writeString(" inner.val=");
            Console.writeFloat(o.inner.val);

            // 调用 struct 方法返回 struct
            Inner i2 = o.getInner();
            Console.writeString(" returned.val=");
            Console.writeFloat(i2.val);

            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
