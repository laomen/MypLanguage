// Type inference: var keyword
import env;
import math;

class Main {
    action:
        @startup void run() {
            var x = 42;
            var y = 3.14;
            var s = "hello";
            var b = true;
            var sq = Math.sqrt(64.0);

            Console.writeString("x="); Console.write(x);
            Console.writeString(" y="); Console.writeFloat(y);
            Console.writeString(" s="); Console.writeString(s);
            Console.writeString(" b="); Console.writeBool(b);
            Console.writeString(" sq="); Console.writeFloat(sq);
            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
