// arc_throw: 异常/throw-catch 展开释放（§五-1 剩余项）
// 覆盖：throw 离开函数前释放本帧全部 ARC 槽；try 内槽由 dispatch 释放、外层槽保留
//       给 catch；catch 绑定对象（具体类 + Error 接口）作用域末释放；finally 传播
//       路径释放；正常 try 完成不误释放。
// 用 Memory.liveObjectCount() 观测各场景异常处理后回到基线（0 增量）。
import env;
import memory;
import error;

class Node {
    action:
        void setVal(int v) { val = v; }
        int getVal() { return val; }
    property:
        int val = 0;
}

class MyErr {
    interface class Error;
    action:
        @constructor MyErr() {}
        string message() { return "myerr"; }
}

// 1) 无同函数 try：throw 离开函数前释放本帧全部槽（a、b）
void throwsOut() {
    Node a = new Node();
    Node b = new Node();
    throw "out";
}

// 2) 有同函数 try：throw 在 try 内 → dispatch 释放 try 内槽，外层槽保留给 catch
int tryInner() {
    Node outer = new Node();
    try {
        Node inner = new Node();
        throw "boom";
    } catch (string s) {
        return outer.getVal();          // outer 必须仍存活（未被误释放）
    }
    return -1;
}

int pmRun() {
    long base = Memory.liveObjectCount();

    // 1) throwsOut → 本帧槽释放，catch 拿消息
    try { throwsOut(); } catch (string s) {
        Console.writeString("catch_out=" + s + " ");
    }
    long a1 = Memory.liveObjectCount() - base;
    Console.writeString("left1=" + a1 + "\n");

    // 2) tryInner → 内层槽释放、外层槽保留且正常释放
    int v2 = tryInner();
    Console.writeString("outer_alive=" + v2 + " ");
    long a2 = Memory.liveObjectCount() - base;
    Console.writeString("left2=" + a2 + "\n");

    // 3) 具体类 catch：绑定对象在所在块退出时释放
    long b3 = Memory.liveObjectCount();
    {
        try {
            throw new MyErr();
        } catch (MyErr e) {
            Console.writeString("caught=" + e.message() + " ");
        }
    }
    long a3 = Memory.liveObjectCount() - b3;
    Console.writeString("left3=" + a3 + "\n");

    // 4) Error 接口 catch：绑定对象（接口胖指针 index 0）块退出时释放
    long b4 = Memory.liveObjectCount();
    {
        try {
            throw new MyErr();
        } catch (Error e) {
            Console.writeString("iface=" + e.message() + " ");
        }
    }
    long a4 = Memory.liveObjectCount() - b4;
    Console.writeString("left4=" + a4 + "\n");

    // 5) finally 传播：无匹配 catch → finally 跑 → 重抛 → 外层 catch；内层槽（n5）释放
    long b5 = Memory.liveObjectCount();
    {
        try {
            try {
                Node n5 = new Node();
                throw new MyErr();
            } finally {
                Console.writeString("fin_run ");
            }
        } catch (MyErr e) {
            Console.writeString("recaught ");
        }
    }
    long a5 = Memory.liveObjectCount() - b5;
    Console.writeString("left5=" + a5 + "\n");

    // 6) 正常 try 完成：作用域退出正常释放，不误释放
    long b0 = Memory.liveObjectCount();
    {
        try {
            Node ok = new Node();
        } catch (string s) { }
    }
    long a6 = Memory.liveObjectCount() - b0;
    Console.writeString("left6=" + a6 + "\n");

    // 7) 别名抛出对象：throw e（e 为局部槽）→ retain 后展开释放槽，catch 取到存活对象
    long b7 = Memory.liveObjectCount();
    {
        try {
            Node x = new Node();
            x.setVal(42);
            throw x;                       // 别名 throw → 异常持有引用
        } catch (Node e) {
            Console.writeString("alias_throw=" + e.getVal() + " ");
        }
    }
    long a7 = Memory.liveObjectCount() - b7;
    Console.writeString("left7=" + a7 + "\n");

    // 8) 全量回到基线（函数顶层也无残留）
    long a8 = Memory.liveObjectCount() - base;
    Console.writeString("left8=" + a8 + "\n");

    Console.writeString("end\n");
    return 0;
}

int main() {
    return pmRun();
}
