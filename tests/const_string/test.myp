// const_string: 编译期字符串拼接/比较（此前落入 int 分支 → 垃圾 const →
// LLVM verify 崩溃；修复后正确求值）
import env;

const string A = "hi " + "x";           // "hi x"
const string B = "a" + "b" + "c";       // "abc"
const bool EQ = ("ab" + "c") == "abc";  // 编译期字符串相等
@eval string greet(string n) { return "hi " + n; }
const string C = greet("myp");          // "hi myp"

class Main {
    action:
        @constructor Main() {
            Console.writeString(A());
            Console.writeString("\n");
            Console.writeString(B());
            Console.writeString("\n");
            Console.writeString(C());
            Console.writeString("\n");
            Console.writeString(EQ() ? "EQ=ok" : "EQ=FAIL");
            Console.writeString("\n");
        }
}

int main(){ Main m = new Main(); return 0; }
