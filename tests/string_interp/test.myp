// 字符串插值测试
import env;

class Main {
    action:
        @startup void run() {
            string name = "MYP";
            int version = 24;
            double pi = 3.14;

            Console.writeString("Hello, ");
            Console.writeString(name);
            Console.writeString(" v");
            Console.write(version);
            Console.writeString(" pi=");
            Console.writeFloat(pi);
            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
