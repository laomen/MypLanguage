// char 类型测试
import env;

class Main {
    action:
        @startup void run() {
            char ch = 'A';
            Console.writeString("char: ");
            Console.write(ch);

            char nl = '\n';
            char tab = '\t';
            char quote = '"';
            char backslash = '\\';

            Console.writeString(" nl="); Console.write(nl);
            Console.writeString(" tab="); Console.write(tab);
            Console.writeString(" quote="); Console.write(quote);
            Console.writeString(" backslash="); Console.write(backslash);

            // char 参与算术
            char c2 = 'A';
            int ci = c2;
            Console.writeString(" char_to_int="); Console.write(ci);

            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
