import env;
import collections;

// Generic template-body type resolution: HashMap<int,string>.remove() runs a
// rehash loop with `V re_val = values_[next];`. If `V` (= string) is mis-typed
// as i32 in the template body, the rehash stores i32 into the string[] backing
// (pointer corruption). Regression: values must survive remove+rehash intact.

int runTest() {
    for (int round = 0; round < 20; round = round + 1) {
        HashMap<int, string> hm = new HashMap<int, string>();
        hm.put(1, "one");
        hm.put(2, "two");
        hm.put(3, "three");
        hm.put(4, "four");
        hm.put(5, "five");
        hm.remove(3);   // triggers the rehash loop (V re_val path)
        string g = hm.get(1, "");
        string g2 = hm.get(2, "");
        string g4 = hm.get(4, "");
        string g5 = hm.get(5, "");
        if (g != "one") return 1;
        if (g2 != "two") return 2;
        if (g4 != "four") return 4;
        if (g5 != "five") return 5;
    }
    Console.writeString("hashmap rehash ok\n");
    return 0;
}

int main() { int c = runTest(); return c; }
