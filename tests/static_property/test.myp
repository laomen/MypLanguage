// @static class property read/write through class name
import env;

@static class Config {
    property:
        double[] data;
        int count;
        string name;
}

class Main {
    action:
        @startup void run() {
            Config.data = new double[5];
            Config.data[0] = 3.14;
            Config.data[1] = 2.71;
            Config.count = 42;
            Config.name = "test";

            Console.writeString("name="); Console.writeString(Config.name);
            Console.writeString(" count="); Console.write(Config.count);
            Console.writeString(" d0="); Console.writeFloat(Config.data[0]);
            Console.writeString(" d1="); Console.writeFloat(Config.data[1]);
            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
