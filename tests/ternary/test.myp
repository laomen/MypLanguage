// Ternary operator ? :
import env;

class Main {
    action:
        @startup void run() {
            int a = 10;
            int b = 20;
            int max = a > b ? a : b;
            Console.writeString("max="); Console.write(max);

            int min = a < b ? a : b;
            Console.writeString(" min="); Console.write(min);

            string label = a > 0 ? "positive" : "non-positive";
            Console.writeString(" label="); Console.writeString(label);

            // nested ternary
            int x = -5;
            string sign = x > 0 ? "pos" : x < 0 ? "neg" : "zero";
            Console.writeString(" sign="); Console.writeString(sign);
            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
