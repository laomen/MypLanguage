// int ↔ long type compatibility (auto-promotion)
import env;

class Main {
    action:
        @startup void run() {
            // int → long promotion
            int a = 42;
            long b = a;        // implicit int→long
            Console.writeString("b="); Console.writeLong(b);

            // int + long = long
            long c = a + 100L;
            Console.writeString(" c="); Console.writeLong(c);

            // long function param with int arg
            long d = twice(a);
            Console.writeString(" d="); Console.writeLong(d);

            // mixed arithmetic
            long e = a * 10L + 5;
            Console.writeString(" e="); Console.writeLong(e);
            Console.writeString("\n");
        }
    function:
        long twice(long x) { return x * 2L; }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
