// date: 确定性字段（weekday/month 名）— 不依赖墙钟日期，保证 CI 稳定
import env;
import date;

class Main {
    action:
        @startup void run() {
            // weekday/month names（确定性，不随日期变化）
            Console.writeLine("wname=" + Date.weekdayName(0));
            Console.writeLine("wname=" + Date.weekdayName(1));
            Console.writeLine("wname=" + Date.weekdayName(6));
            Console.writeLine("mname=" + Date.monthName(1));
            Console.writeLine("mname=" + Date.monthName(12));
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
