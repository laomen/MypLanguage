// assoc_types: 关联类型（§三-5，additive）
// 覆盖：接口关联类型声明 `type Item;`、实现类绑定 `type Item = int;`、
// 直接引用绑定类型 `IntBox::Item`、接口方法参数/返回引用关联类型、
// 泛型类 `where T : I` 内用 `T::Item` 做返回/参数（实例化后绑定到具体类型）、
// 关联类型用于局部变量声明（负测试：实现类不绑定 → 报错）
import env;

interface Container {
    type Item;                    // 关联类型声明（抽象）
    bool contains(Item v);        // 方法引用关联类型
    Item getVal();                // 返回关联类型
}

class IntBox {
    interface class Container;
    type Item = int;              // 绑定 int
    action:
        bool contains(int v) { return v == val; }
        int getVal() { return val; }
    property: int val = 42;
}

class StrBox {
    interface class Container;
    type Item = string;           // 绑定 string
    action:
        bool contains(string v) { return v == val; }
        string getVal() { return val; }
    property: string val = "hi";
}

// 泛型类：T 约束为 Container，内部用 T::Item（实例化后绑定到 IntBox::Item / StrBox::Item）
class Processor<T where T : Container> {
    action:
        T::Item peek(T c) { return c.getVal(); }   // 返回关联类型
        bool check(T c, T::Item v) { return c.contains(v); }  // 参数用关联类型
}

int pmRun() {
    IntBox ib = new IntBox();
    StrBox sb = new StrBox();
    // 直接引用绑定类型：IntBox::Item ≡ int
    IntBox::Item x = 5;
    // 关联类型用于变量声明
    Container c = new IntBox();
    bool r1 = c.contains(x);
    // 泛型类实例化：T::Item 分别绑定 int / string
    Processor<IntBox> pi = new Processor<IntBox>();
    Processor<StrBox> ps = new Processor<StrBox>();
    int iv = pi.peek(ib);              // 42
    string sv = ps.peek(sb);           // "hi"
    bool r2 = pi.check(ib, 7);         // false（7 != 42）
    Console.writeString("x=" + x + " r1=" + (r1 ? "true" : "false") + "\n");
    Console.writeString("iv=" + iv + " sv=" + sv + " r2=" + (r2 ? "true" : "false") + "\n");
    return 0;
}
int main() { int c = pmRun(); return c; }
