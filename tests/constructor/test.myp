// M2: class 构造器绑定测试
// 验证: @constructor / 函数名==类名隐式构造器 / 重载 / 数字提升 / 泛型构造器
// legacy @startup 启动信号（@thread 线程入口）仍正常工作
import env;

class Window {
    action:
        @constructor
        void Window() {                     // 无参构造（显式 @constructor）
            x = 0; y = 0; w = 80; h = 24;
        }
        void Window(int px, int py, int pw, int ph) {   // 函数名==类名 → 隐式构造器
            x = px; y = py; w = pw; h = ph;
        }
        void show() {
            Console.write(x);
            Console.write(y);
            Console.write(w);
            Console.write(h);
        }
    property:
        int x;
        int y;
        int w;
        int h;
}

// 重载 + 数字提升（int 实参 → double 形参）
class Scale {
    action:
        @constructor
        void Scale(double v) { val = v; }
        void Scale() { val = 1.0; }
        double get() { return val; }
    property:
        double val;
}

// 泛型构造器：绑定单态化实例类（根治 @startup 分发 bug）
class Box<T> {
    action:
        @constructor
        void Box(T v) { data = v; }
        T get() { return data; }
    property:
        T data;
}

// struct action: 节 + 构造器（语法解析；函数式构造在 M3）
struct Vec2 {
    action:
        @constructor
        void Vec2(double px, double py) { x = px; y = py; }
        void Vec2() { x = 0; y = 0; }
        double lenSq() { return x * x + y * y; }
    double x;
    double y;
}

class Main {
    action:
        @startup void run() {
            Window a = new Window();
            a.show();                       // 0 0 80 24（无参构造）
            Window b = new Window(10, 5, 100, 50);
            b.show();                       // 10 5 100 50（重载构造）

            Scale s1 = new Scale();         // 无参 → 1.0
            Console.writeFloat(s1.get());
            Scale s2 = new Scale(3);        // int→double 提升
            Console.writeFloat(s2.get());

            Box<double> d = new Box<double>(1.5);
            Console.writeFloat(d.get());    // 1.5（泛型 double）
            Box<int> i = new Box<int>(7);
            Console.write(i.get());         // 7（泛型 int）

            Vec2 v;
            v.x = 3; v.y = 4;
            Console.writeString(" M2 constructor OK\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
