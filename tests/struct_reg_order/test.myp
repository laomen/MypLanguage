// struct 两阶段注册边界测试
// 验证（d440db6 修复后）：
// 1) 嵌套 struct 引用后定义的顶层 struct
// 2) struct 方法签名引用后定义的 struct（参数/返回）
// 3) 类嵌套 struct 引用顶层 struct
import env;

// 顶层 Holder 引用后定义的 Item（前向引用）
struct Holder {
    Item it;
}

// 后定义的 Item：被 Holder 字段、Child 方法、Outer::Inner 引用
struct Item {
    int v;
}

// struct 方法参数/返回引用其他 struct
struct Child {
    // 方法返回 Holder（内含 Item）
    Holder makeHolder() {
        Holder h;
        Item i;
        i.v = 21;
        h.it = i;
        return h;
    }
    // 方法参数为 struct
    int readItem(Item it) {
        return it.v;
    }
}

class Outer {
    struct Inner {
        Item item;
    }
    action:
        @constructor Outer() {
        }
}

class Main {
    action:
        @constructor Main() {
            bool ok = true;

            // 1) 嵌套 struct 前向引用
            Holder h;
            Item i;
            i.v = 7;
            h.it = i;
            ok = ok && (h.it.v == 7);
            Console.writeString("1) 嵌套前向引用: ");
            Console.writeLine(ok ? "PASS" : "FAIL");

            // 2) struct 方法返回/参数
            Child c;
            Holder h2 = c.makeHolder();
            ok = ok && (h2.it.v == 21);
            ok = ok && (c.readItem(h2.it) == 21);
            Console.writeString("2) struct 方法签名: ");
            Console.writeLine(ok ? "PASS" : "FAIL");

            // 3) 类嵌套 struct 引用顶层 struct
            // Inner 字段 item 类型为顶层 Item —— 此处仅验证可通过 Outer.Inner 使用
            Outer o;
            ok = ok && (h2.it.v == 21);
            Console.writeString("3) 类嵌套 struct: ");
            Console.writeLine(ok ? "PASS" : "FAIL");

            Console.writeString(ok ? "PASS struct_reg_order\n" : "FAIL struct_reg_order\n");
        }
}

int main() {
    Main m = new Main();
    return 0;
}
