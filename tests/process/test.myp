// process: run commands
import env;
import process;

class Main {
    action:
        @startup void run() {
            // run simple command
            int code = Process.run("echo myp_test > /dev/null");
            Console.writeString("code="); Console.write(code); Console.writeString("\n");

            // capture output
            string out = Process.output("echo hello_myp_test");
            Console.writeString("out="); Console.writeLine(out);

            // pid 只检查 >0（原始 PID 非确定，不打印，保证 CI 稳定）
            int pid = Process.getPid();
            Console.writeString("pid_gt0=");
            if (pid > 0) Console.writeString("1\n");
            else Console.writeString("0\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
