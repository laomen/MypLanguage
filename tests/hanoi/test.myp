// 汉诺塔 — 递归验证
// 验证：递归函数调用、函数参数传递、输出

import env;

// 递归汉诺塔
void hanoi(int n, string from, string to, string aux) {
    if(n == 1){
        __myp_print("  Move disk 1 from "); __myp_print(from);
        __myp_print(" to "); __myp_print(to); __myp_print("\n");
        return;
    }
    hanoi(n-1, from, aux, to);
    __myp_print("  Move disk "); __myp_print_int(n);
    __myp_print(" from "); __myp_print(from);
    __myp_print(" to "); __myp_print(to); __myp_print("\n");
    hanoi(n-1, aux, to, from);
}

// 递归阶乘
int fact(int n) {
    if(n <= 1) return 1;
    return n * fact(n-1);
}

// 递归斐波那契
int fib(int n) {
    if(n <= 1) return n;
    return fib(n-1) + fib(n-2);
}

class Main {
    action:
        @startup void run() {
            __myp_print("[递归验证]\n\n");

            // 1. 阶乘
            __myp_print("阶乘:\n");
            int i=1;
            while(i<=7){
                __myp_print("  "); __myp_print_int(i);
                __myp_print("! = "); __myp_print_int(fact(i));
                __myp_print("\n");
                i=i+1;
            }

            // 2. 斐波那契
            __myp_print("\n斐波那契:\n");
            i=1;
            while(i<=10){
                __myp_print("  fib("); __myp_print_int(i);
                __myp_print(") = "); __myp_print_int(fib(i));
                __myp_print("\n");
                i=i+1;
            }

            // 3. 汉诺塔（3层）
            __myp_print("\n汉诺塔(3层):\n");
            hanoi(3, "A", "C", "B");

            __myp_print("\n[OK] 递归验证通过\n");
        }
}

int main(){Main m=new Main();return 0;}
