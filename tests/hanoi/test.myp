// 汉诺塔 — 递归验证
// 验证：递归函数调用、函数参数传递、输出

import env;

// 递归汉诺塔
void hanoi(int n, string from, string to, string aux) {
    if(n == 1){
        Console.writeString("  Move disk 1 from "); Console.writeString(from);
        Console.writeString(" to "); Console.writeString(to); Console.writeString("\n");
        return;
    }
    hanoi(n-1, from, aux, to);
    Console.writeString("  Move disk "); Console.write(n);
    Console.writeString(" from "); Console.writeString(from);
    Console.writeString(" to "); Console.writeString(to); Console.writeString("\n");
    hanoi(n-1, aux, to, from);
}

// 递归阶乘
int fact(int n) {
    if(n <= 1) return 1;
    return n * fact(n-1);
}

// 递归斐波那契
int fib(int n) {
    if(n <= 1) return n;
    return fib(n-1) + fib(n-2);
}

class Main {
    action:
        @constructor Main() {
            Console.writeString("[递归验证]\n\n");

            // 1. 阶乘
            Console.writeString("阶乘:\n");
            int i=1;
            while(i<=7){
                Console.writeString("  "); Console.write(i);
                Console.writeString("! = "); Console.write(fact(i));
                Console.writeString("\n");
                i=i+1;
            }

            // 2. 斐波那契
            Console.writeString("\n斐波那契:\n");
            i=1;
            while(i<=10){
                Console.writeString("  fib("); Console.write(i);
                Console.writeString(") = "); Console.write(fib(i));
                Console.writeString("\n");
                i=i+1;
            }

            // 3. 汉诺塔（3层）
            Console.writeString("\n汉诺塔(3层):\n");
            hanoi(3, "A", "C", "B");

            Console.writeString("\n[OK] 递归验证通过\n");
        }
}

int main(){Main m=new Main();return 0;}
