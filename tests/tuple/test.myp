// tuple: 元组 + 解构（§三-2）——TUP-1（类型+字面量+声明式解构+多值返回）
// + TUP-2（赋值式解构 + 嵌套 + 字段访问 t.N）
// 覆盖：元组字面量、字段访问、声明式解构、赋值式解构、嵌套解构、多返回值、元组变量
import env;

// 多返回值：元组
(int, string) getPair() { return (1, "x"); }
(int, int) getTwo() { return (7, 9); }
((int, int), int) getNested() { return ((1, 2), 5); }

int pmRun() {
    // 元组字面量 + 元组变量 + 字段访问
    (int, int) t = (3, 4);
    int c = t.0;
    int d = t.1;
    // 声明式解构（多值返回）
    (int a, string b) = getPair();
    // 字段访问 + 多值返回
    (int, int) r = getTwo();
    int e = r.0;
    int f = r.1;
    // 赋值式解构（已有变量）
    int g; int h;
    (g, h) = getTwo();
    // 嵌套解构
    ((int p, int q), int z) = getNested();
    // 三元素元组
    (int, int, int) tri = (1, 2, 3);
    int w = tri.2;
    Console.writeString("a=" + a + " b=" + b + " c=" + c + " d=" + d + " e=" + e + " f=" + f);
    Console.writeString(" g=" + g + " h=" + h + " p=" + p + " q=" + q + " z=" + z + " w=" + w);
    Console.writeString("\n");
    return 0;
}
int main() { int c = pmRun(); return c; }
