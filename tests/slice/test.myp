// slice 类型回归测试 (P4a)
// 验证: 创建 / 下标读写 / size() / 传参 / 返回
import env;

// slice 作为参数 + 返回（值传递 fat pointer）
slice<double> sumSlice(slice<double> s) {
    int total = 0;
    int i = 0;
    while (i < s.size()) { total = total + 1; i = i + 1; }
    Console.writeString("[sum count] ");
    Console.write(total);
    Console.writeString("\n");
    return s;  // 返回 slice（逃逸 → 进程级）
}

class Main {
    action:
        @startup void run() {
            Console.writeString("[slice 测试]\n");

            // 1) 创建
            slice<double> s = new slice<double>(4);
            Console.writeString("size = ");
            Console.write(s.size());
            Console.writeString("\n");

            // 2) 下标写
            int i = 0;
            while (i < 4) { s[i] = (i + 1) * 1.5; i = i + 1; }

            // 3) 下标读
            Console.writeString("s = [");
            i = 0;
            while (i < s.size()) {
                Console.writeFloat(s[i]);
                if (i < s.size() - 1) Console.writeString(",");
                i = i + 1;
            }
            Console.writeString("]\n");

            // 4) 传参 + 返回
            slice<double> r = sumSlice(s);
            Console.writeString("returned size = ");
            Console.write(r.size());
            Console.writeString("\n");
            Console.writeString("r[2] = ");
            Console.writeFloat(r[2]);
            Console.writeString("\n");
        }
}
int main() { Main m = new Main(); return 0; }
