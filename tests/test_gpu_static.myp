// Minimal: static method with @gpu for capturing array param
import env;
import math;

class Foo {
    static:
        void scale(double[] data, double s, long n) {
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = data[i] * s;
            }
        }
}

class Tester {
    action:
        @constructor Tester() {
            long n = 64L;
            double[] d = new double[n];
            for (long i = 0L; i < n; i = i + 1L) d[i] = 1.0;
            Foo.scale(d, 2.0, n);
            Console.writeLine("d[0]=" + d[0] + " (expect 2)");
            long err = 0L;
            for (long i = 0L; i < n; i = i + 1L) {
                if (Math.abs(d[i] - 2.0) > 0.0001) err = err + 1L;
            }
            Console.writeLine("static gpu: " + (err == 0L ? "PASS" : "FAIL"));
        }
}

int main() {
    Tester t = new Tester();
    return 0;
}
