// arc: 引用计数内存管理（§五-1，additive）
// 覆盖：生命周期（局部实例离开作用域被释放）、级联释放（父对象销毁释放子对象）、
// 自赋值/别名安全、属性存储 retain（对象持有引用）、访问器返回+调用方释放（借用返回）、
// 大循环内临时对象释放（不累积）
// 用 Memory.liveObjectCount() 观测存活实例数（诊断辅助，见 docs/arc.md）
import env;
import memory;

class Node {
    action:
        void setNext(Node n) { next = n; }          // 属性存储 → retain(n)
        Node getNext() { return next; }              // 借用返回 → retain-at-return
        void setChild(Node c) { child = c; }
        void setParent(Node p) { parent = p; }
        int getVal() { return val; }
        void setVal(int v) { val = v; }
    property:
        Node next;
        Node child;
        Node parent;         // 环测试：parent 引用（非环，仅反指）
        int val = 0;
}

int pmRun() {
    long base = Memory.liveObjectCount();            // 基线（进程级对象已在全局/静态中）

    // --- 生命周期：作用域结束后实例释放 ---
    {
        Node a = new Node();
        Node b = new Node();
        long mid = Memory.liveObjectCount();
        Console.writeString("life: +2=" + (mid - base) + " ");
    }
    long after = Memory.liveObjectCount();
    Console.writeString("after_scope=" + (after - base) + "\n");

    // --- 级联释放：容器持有两个子对象，容器销毁时级联释放 ---
    long c1 = Memory.liveObjectCount();
    {
        Node box = new Node();
        Node c = new Node();
        Node d = new Node();
        box.setChild(c);      // box 持有 c（retain）
        box.setNext(d);       // box 持有 d（retain）
        long held = Memory.liveObjectCount() - c1;
        Console.writeString("cascade: +" + held + " ");
    }
    long c2 = Memory.liveObjectCount() - c1;
    Console.writeString("after_box=" + c2 + "\n");    // box 销毁 → 级联释放 c、d

    // --- 自赋值 / 别名 ---
    {
        Node x = new Node();
        x = x;                                       // 自赋值（retain-then-release，安全）
        Node y = x;                                  // 别名：y 也持有（retain）
        y.setVal(7);
        Console.writeString("alias: x=" + x.getVal() + " y=" + y.getVal() + " ");
    }
    long a2 = Memory.liveObjectCount() - base;
    Console.writeString("after_alias=" + a2 + "\n");  // x、y 都释放 → 0

    // --- 访问器借用返回 + 调用方释放 ---
    {
        Node head = new Node();
        Node mid2 = new Node();
        head.setNext(mid2);
        Node got = head.getNext();                   // 借用返回（retain-at-return）
        Console.writeString("accessor: got=" + (got == mid2 ? "same" : "diff") + " ");
    }
    long a3 = Memory.liveObjectCount() - base;
    Console.writeString("after_accessor=" + a3 + "\n");

    // --- 循环内临时对象不累积（每轮创建+释放） ---
    long before_loop = Memory.liveObjectCount();
    for (int i = 0; i < 1000; i = i + 1) {
        Node t = new Node();
        t.setVal(i);
    }
    long after_loop = Memory.liveObjectCount();
    Console.writeString("loop: before=" + (before_loop - base) + " after=" + (after_loop - base) + "\n");

    Console.writeString("arc all ok\n");
    return 0;
}
int main() { int c = pmRun(); return c; }
