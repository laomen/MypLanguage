// long literal suffix 'L' and long operations
import env;

class Main {
    action:
        @startup void run() {
            long a = 152917L;
            long b = 1000000000000L;
            long c = a + b;
            long d = b * 2L;

            Console.writeString("a="); Console.writeLong(a);
            Console.writeString(" b="); Console.writeLong(b);
            Console.writeString(" sum="); Console.writeLong(c);
            Console.writeString(" double="); Console.writeLong(d);

            // long in expressions
            long e = (10 * 20 + 5) * 1000L + 1L;
            Console.writeString(" expr="); Console.writeLong(e);
            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
