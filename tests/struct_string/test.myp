// struct + string 字段的值语义测试（ARC 拷贝正确性）
// 验证：含 string 字段的 struct 按值拷贝时字符串正确复制（互不影响），
// 且没有双重释放/泄漏（ASAN 下运行验证）。
import env;

struct Record {
    int id;
    string name;
}

// 按值返回含 string 的 struct
Record makeRecord(int id, string name) {
    Record r;
    r.id = id;
    r.name = name;
    return r;
}

class Main {
    action:
        @constructor Main() {
            bool ok = true;

            // 1) 赋值拷贝：改副本 string 不影响原值
            Record a = makeRecord(1, "alpha");
            Record b = a;
            b.name = "beta";
            ok = ok && (a.name == "alpha") && (b.name == "beta") && (a.id == 1) && (b.id == 1);
            Console.writeString("1) string 字段拷贝独立: ");
            Console.writeLine(ok ? "PASS" : "FAIL");

            // 2) 多次拷贝 + 覆盖（ARC 引用计数压力）
            Record c = a;
            Record d = c;
            Record e = d;
            e.name = "epsilon";
            c.name = "gamma";
            ok = ok && (a.name == "alpha") && (c.name == "gamma") && (d.name == "alpha") && (e.name == "epsilon");
            Console.writeString("2) 多重拷贝独立: ");
            Console.writeLine(ok ? "PASS" : "FAIL");

            // 3) struct 数组元素 string 字段独立
            Record[2] arr;
            arr[0] = makeRecord(10, "ten");
            arr[1] = makeRecord(20, "twenty");
            arr[0].name = "TEN";
            ok = ok && (arr[0].name == "TEN") && (arr[1].name == "twenty") && (arr[1].id == 20);
            Console.writeString("3) 数组元素 string 独立: ");
            Console.writeLine(ok ? "PASS" : "FAIL");

            Console.writeString(ok ? "PASS struct_string\n" : "FAIL struct_string\n");
        }
}

int main() {
    Main m = new Main();
    return 0;
}
