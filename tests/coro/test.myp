// tests/coro/test.myp — 协程 C1：@coro spawn + await + 手动 resume
// 覆盖：无参协程、带参协程（int/double）、is_active、多协程交错
import env;
import coro;

class Worker {
    property:
        string label_;
    action:
        void setLabel(string s) { label_ = s; }
        // 无参协程：两次挂起
        @coro void run() {
            Console.writeString(label_);
            Console.writeString(":1\n");
            await;
            Console.writeString(label_);
            Console.writeString(":2\n");
            await;
            Console.writeString(label_);
            Console.writeString(":3\n");
        }
        // 带参协程：int + double 参数通过入口槽传入
        @coro void report(int n, double x) {
            Console.writeString("report n=");
            Console.write(n);
            Console.writeString(" x=");
            Console.writeFloat(x);
            Console.writeString("\n");
            await;
            Console.writeString("report resumed\n");
        }
}

class Main {
    action:
        @startup void run() {
            // 1) 无参协程 + 多协程交错
            Worker a = new Worker();
            a.setLabel("A");
            Worker b = new Worker();
            b.setLabel("B");
            long ha = a.run();
            long hb = b.run();
            Console.writeString("---\n");
            __myp_coro_resume(ha);
            __myp_coro_resume(hb);
            __myp_coro_resume(ha);
            __myp_coro_resume(hb);
            __myp_coro_resume(ha);
            __myp_coro_resume(hb);

            // 2) 带参协程
            Worker c = new Worker();
            c.setLabel("C");
            long hc = c.report(42, 3.5);
            __myp_coro_resume(hc);

            // 3) is_active 生命周期
            Console.writeString("active1=");
            Console.write(__myp_coro_is_active(hc));
            Console.writeString("\n");

            // 4) 提前取消（未完成时 destroy）
            Worker d = new Worker();
            d.setLabel("D");
            long hd = d.run();
            __myp_coro_destroy(hd);
            Console.writeString("active2=");
            Console.write(__myp_coro_is_active(hd));
            Console.writeString("\n");

            Console.writeString("done\n");
        }
}

int main() {
    Main m = new Main();
    return 0;
}
