// tests/coro/test.myp — 协程：@coro spawn + await 挂起/恢复 + 值传递 + 返回值
// 覆盖：无参协程、带参协程（int/double）、多协程交错、is_active、destroy、
//       await 值传递（int v = await expr;）、Coro.result 返回值
import env;
import coro;

class Worker {
    property:
        string label_;
    action:
        void setLabel(string s) { label_ = s; }
        // 无参协程：两次挂起
        @coro void run() {
            Console.writeString(label_);
            Console.writeString(":1\n");
            await;
            Console.writeString(label_);
            Console.writeString(":2\n");
            await;
            Console.writeString(label_);
            Console.writeString(":3\n");
        }
        // 带参协程：int + double 参数通过入口槽传入
        @coro void report(int n, double x) {
            Console.writeString("report n=");
            Console.write(n);
            Console.writeString(" x=");
            Console.writeFloat(x);
            Console.writeString("\n");
            await;
            Console.writeString("report resumed\n");
        }
        // await 值传递：挂起传出 n*2；恢复后 v = resume 传入值
        @coro void echo(int n) {
            Console.writeString("echo start\n");
            int v = await n * 2;
            Console.writeString("echo v=");
            Console.write(v);
            Console.writeString("\n");
        }
        // 返回值：@coro 方法 return 存入结果槽
        @coro int compute() {
            await;
            return 42;
        }
}

class Main {
    action:
        @constructor void run() {
            // 1) 无参协程 + 多协程交错
            Worker a = new Worker();
            a.setLabel("A");
            Worker b = new Worker();
            b.setLabel("B");
            long ha = a.run();
            long hb = b.run();
            Console.writeString("---\n");
            Coro.resume(ha, 0);
            Coro.resume(hb, 0);
            Coro.resume(ha, 0);
            Coro.resume(hb, 0);
            Coro.resume(ha, 0);
            Coro.resume(hb, 0);

            // 2) 带参协程
            Worker c = new Worker();
            c.setLabel("C");
            long hc = c.report(42, 3.5);
            Coro.resume(hc, 0);

            // 3) await 值传递
            Worker e = new Worker();
            long he = e.echo(5);
            long out = Coro.resume(he, 100);
            Console.writeString("out=");
            Console.write(out);
            Console.writeString("\n");

            // 4) 返回值
            long hf = e.compute();
            Coro.resume(hf, 0);
            Console.writeString("result=");
            Console.write(Coro.result(hf));
            Console.writeString("\n");

            // 5) isActive 生命周期
            Console.writeString("active1=");
            Console.write(Coro.isActive(hc));
            Console.writeString("\n");

            // 6) 提前取消（未完成时 destroy）
            Worker d = new Worker();
            d.setLabel("D");
            long hd = d.run();
            Coro.destroy(hd);
            Console.writeString("active2=");
            Console.write(Coro.isActive(hd));
            Console.writeString("\n");

            Console.writeString("done\n");
        }
}

int main() {
    Main m = new Main();
    return 0;
}
