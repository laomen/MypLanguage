// 复合赋值运算符测试
import env;

class Main {
    action:
        @startup void run() {
            int x = 10;
            x += 5;
            Console.writeString("x+=5: "); Console.write(x);

            x -= 3;
            Console.writeString(" x-=3: "); Console.write(x);

            x *= 4;
            Console.writeString(" x*=4: "); Console.write(x);

            x /= 2;
            Console.writeString(" x/=2: "); Console.write(x);

            x %= 7;
            Console.writeString(" x%=7: "); Console.write(x);

            double y = 10.0;
            y += 3.5;
            Console.writeString(" y+=3.5: ");
            Console.writeFloat(y);

            y -= 2.0;
            Console.writeString(" y-=2.0: ");
            Console.writeFloat(y);

            y *= 2.0;
            Console.writeString(" y*=2.0: ");
            Console.writeFloat(y);

            y /= 4.0;
            Console.writeString(" y/=4.0: ");
            Console.writeFloat(y);

            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
