// time: Time.nowMs, Time.sleep
import env;
import time;

class Main {
    action:
        @startup void run() {
            long t0 = Time.nowMs();
            Time.sleep(10);
            long t1 = Time.nowMs();
            long dt = t1 - t0;
            // dt varies with sleep precision (10 or 11) — assert ranges, not exact value
            Console.writeString("ok="); Console.writeBool(dt > 0L);
            Console.writeString(" longEnough="); Console.writeBool(dt >= 10L);
            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
