// barrier: Barrier.create/wait/destroy
import env;
import barrier;
import atomic;

class Main {
    action:
        @startup void run() {
            int h = Barrier.create(1);  // self-only barrier
            int ok1 = Barrier.wait(h);
            Console.writeString("wait1="); Console.write(ok1);
            int ok2 = Barrier.wait(h);
            Console.writeString(" wait2="); Console.write(ok2);
            Barrier.destroy(h);
            Console.writeString(" barrier_ok\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
