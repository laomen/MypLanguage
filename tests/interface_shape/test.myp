// Interface 验证
// 验证：interface 声明、class 实现 interface、编译器接口完整性检查

import env; import math;

interface IShape {
    double area();
    double perimeter();
}

class Circle {
    interface class IShape;
    action:
        @constructor void run() { radius = 5.0; }
        double area() { return 3.14159 * radius * radius; }
        double perimeter() { return 2.0 * 3.14159 * radius; }
    property:
        double radius = 1.0;
}

class Rectangle {
    interface class IShape;
    action:
        @constructor void run() { width = 3.0; height = 4.0; }
        double area() { return width * height; }
        double perimeter() { return 2.0 * (width + height); }
    property:
        double width = 1.0;
        double height = 1.0;
}

// 如果取消注释 BadShape，编译器应报错（接口不完整）
// class BadShape { interface class IShape; action: void something() {} }

class Main {
    action:
        @constructor void run() {
            Console.writeString("[Interface 验证]\n");

            Circle c = new Circle();
            double ca = c.area();
            double cp = c.perimeter();
            Console.writeString("Circle: area="); Console.writeFloat(ca);
            Console.writeString(" perim="); Console.writeFloat(cp); Console.writeString("\n");

            Rectangle r = new Rectangle();
            double ra = r.area();
            double rp = r.perimeter();
            Console.writeString("Rect: area="); Console.writeFloat(ra);
            Console.writeString(" perim="); Console.writeFloat(rp); Console.writeString("\n");

            Console.writeString("[OK] Interface 验证通过\n");
        }
}

int main(){Main m=new Main();return 0;}
