// byte / short 类型测试
import env;

class Main {
    action:
        @startup void run() {
            byte b = 42;
            short s = 12345;
            int i_from_byte = b;
            int i_from_short = s;
            long l_from_byte = b;
            double d_from_byte = b;

            Console.writeString("byte="); Console.write(i_from_byte);
            Console.writeString(" short="); Console.write(i_from_short);
            Console.writeString(" byte->int="); Console.write(i_from_byte);
            Console.writeString(" byte->long="); Console.writeLong(l_from_byte);
            Console.writeString(" byte->double="); Console.writeFloat(d_from_byte);

            byte b2 = 0; b2 = 10;
            short s2 = 0; s2 = 5;
            int r = b2 + s2;
            Console.writeString(" byte+short="); Console.write(r);

            byte bx = 0; bx = 100;
            int bx2 = bx + 20;
            Console.writeString(" byte+const="); Console.write(bx2);

            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
