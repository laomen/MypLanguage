// test_example.myp — 测试框架示例
// 运行: ./build/mypc --test tests/test_example.myp && ./tests/test_example.out

import test;

// 基本断言测试
@test void test_assertions() {
    Test.assert(1 == 1);
    Test.assertEq(2 + 2, 4);
    Test.assertEq(100 - 1, 99);
    Test.assertStrEq("hello", "hello");
    Test.report("test_assertions", true);
}

// 数学运算测试
@test void test_math() {
    Test.assertEq(2 * 3, 6);
    Test.assertEq(10 / 2, 5);
    Test.assert(10 > 5);
    Test.assert(3 <= 3);
    Test.report("test_math", true);
}

// 字符串测试
@test void test_strings() {
    string a = "Hello";
    string b = "Hello";
    string c = "World";
    Test.assertStrEq(a, b);
    Test.assert(a != c);
    Test.assertStrEq(a + " " + c, "Hello World");
    Test.report("test_strings", true);
}

// 带返回值的测试函数
@test int test_return() {
    Test.assertEq(1 + 1, 2);
    Test.report("test_return", true);
    return 0;
}

class Node { action: @constructor Node() {} }

// 断言自定义消息（失败时打印 msg）
@test void test_messages() {
    Test.assert(1 + 1 == 2, "math broken");
    Test.assertTrue(5 > 3, "comparison broken");
    Test.assertFalse(1 > 2, "expected false");
    Test.report("test_messages", true);
}

// 扩展断言 API（long/float 不等、空引用、fail）
@test void test_ext_assertions() {
    Test.assertLongEq(10000000000L, 10000000000L);
    Test.assertLongNeq(1L, 2L);
    Test.assertFloatEq(3.14159, 3.14159, 0.001);
    Test.assertFloatNeq(1.0, 2.0, 0.001);
    Test.assertStrNeq("a", "b");
    Node p = new Node();
    Node n = null;
    Test.assertNotNull<Node>(p);
    Test.assertNull<Node>(n);
    Test.report("test_ext_assertions", true);
}
