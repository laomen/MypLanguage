// Test @gpu for math functions (libdevice linked)
import env;
import math;

class Tester {
    action:
        @startup void go() {
            // sin/cos/exp/log/pow via libdevice
            long n = 256L;
            double[] data = new double[256];
            for (long i = 0L; i < n; i = i + 1L) data[i] = 1.0;

            @gpu for (long i = 0L; i < n; i = i + 1L) {
                data[i] = Math.sqrt(data[i]) + Math.sin(1.0);
            }

            long err = 0L;
            for (long i = 0L; i < n; i = i + 1L) {
                double expected = 1.0 + Math.sin(1.0);
                if (Math.abs(data[i] - expected) > 0.0001) err = err + 1L;
            }
            Console.writeLine("math libdevice: " + (err == 0L ? "PASS" : "FAIL"));
        }
}

int main() {
    Tester t = new Tester();
    return 0;
}
