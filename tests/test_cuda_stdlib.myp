// Test the cuda.myp standard library
import env;
import math;
import cuda;

class Tester {
    action:
        @startup void go() {
            Console.writeLine("cuda available: " + Cuda.available());

            long n = 512L;
            double[] data = new double[n];

            // Vectors.scale
            for (long i = 0L; i < n; i = i + 1L) data[i] = 1.0;
            Vectors.scale(data, 2.0, n);
            Console.writeLine("scale[0]=" + data[0] + " (expect 2)");

            // Vectors.sqrt via libdevice
            Vectors.sqrt(data, n);
            Console.writeLine("sqrt[0]=" + data[0] + " (expect 1.414213)");

            // Vectors.sin via libdevice
            double[] a = new double[n];
            for (long i = 0L; i < n; i = i + 1L) a[i] = 1.0;
            Vectors.sin(a, n);
            Console.writeLine("sin[0]=" + a[0] + " (expect 0.84147)");

            // Device math inside @gpu for directly
            @gpu for (long i = 0L; i < n; i = i + 1L) {
                a[i] = Device.pow(a[i], 2.0) + Device.cos(0.0);
            }
            Console.writeLine("pow+cos[0]=" + a[0] + " (expect 1.70807)");

            // Vectors.add
            double[] b = new double[n];
            double[] out = new double[n];
            for (long i = 0L; i < n; i = i + 1L) { a[i] = 1.0; b[i] = 2.0; }
            Vectors.add(a, b, out, n);
            Console.writeLine("add[0]=" + out[0] + " (expect 3)");

            // Verify all elements are correct
            long err = 0L;
            for (long i = 0L; i < n; i = i + 1L) {
                if (Math.abs(out[i] - 3.0) > 0.0001) err = err + 1L;
            }
            Console.writeLine("cuda stdlib test: " + (err == 0L ? "PASS" : "FAIL"));
        }
}

int main() {
    Tester t = new Tester();
    return 0;
}
