// Atomic operations — standalone
import env;
import atomic;

class Main {
    action:
        @startup void run() {
            int[10] arr;
            double[5] darr;

            // addInt
            Atomic.addInt(arr, 0, 10);
            Atomic.addInt(arr, 1, 20);
            Atomic.addInt(arr, 0, 5);
            Console.writeString("arr[0]="); Console.write(arr[0]);
            Console.writeString(" arr[1]="); Console.write(arr[1]);

            // subInt
            Atomic.subInt(arr, 0, 3);
            Console.writeString(" sub="); Console.write(arr[0]);

            // addDouble
            Atomic.addDouble(darr, 0, 3.14);
            Atomic.addDouble(darr, 0, 2.86);
            Console.writeString(" darr[0]="); Console.writeFloat(darr[0]);

            // xchgInt
            int old = Atomic.xchgInt(arr, 0, 99);
            Console.writeString(" xchg_old="); Console.write(old);
            Console.writeString(" xchg_new="); Console.write(arr[0]);

            // loadInt / storeInt
            Atomic.storeInt(arr, 2, 42);
            int loaded = Atomic.loadInt(arr, 2);
            Console.writeString(" loaded="); Console.write(loaded);
            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
