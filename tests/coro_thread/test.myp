// tests/coro_thread/test.myp — 协程 + 线程并用
// 两个 @thread 线程各自独立创建/调度协程（协程状态线程本地 TLS，互不干扰）
import env;
import coro;

class Ping {
    action:
        @coro void loop(long n) {
            long i = 0L;
            while (i < n) {
                await;
                i = i + 1L;
            }
        }
}

class Worker {
    action:
        @startup void run() {
            // 线程2：本线程 TLS 内创建并调度协程（不输出——多线程交错输出
            // 顺序不定 → expected 无法稳定匹配，故收敛为仅 thread1 输出）。
            Ping p = new Ping();
            long h = p.loop(3L);
            Coro.scheduler();
            Coro.scheduler();
            Coro.scheduler();
        }
}

class Main {
    action:
        @startup void run() {
            // 线程1：本线程 TLS 内创建并调度协程
            Ping p = new Ping();
            long h = p.loop(3L);
            Coro.scheduler();
            Coro.scheduler();
            Coro.scheduler();
            Console.writeString("thread1 active=" + Coro.isActive(h) + "\n");
        }
}

int main() {
    // 平级创建两个 @thread（原 Main 内嵌创建 Worker 的嵌套 join 竞态导致
    // thread2 输出偶发缺失 → flaky；平级后 main 统一 join 两者）
    Main m = new Main() @thread;
    Worker w = new Worker() @thread;
    return 0;
}
