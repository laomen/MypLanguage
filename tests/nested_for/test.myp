// Nested for loops
import env;

class Main {
    action:
        @startup void run() {
            int sum = 0;
            for (int i = 0; i < 5; i = i + 1) {
                for (int j = 0; j < 5; j = j + 1) {
                    sum = sum + 1;
                }
            }
            Console.writeString("nested_sum="); Console.write(sum);

            // nested with break
            int partial = 0;
            for (int i = 0; i < 10; i = i + 1) {
                for (int j = 0; j < 10; j = j + 1) {
                    partial = partial + 1;
                    if (j >= 4) break;
                }
            }
            Console.writeString(" partial="); Console.write(partial);
            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
