// 显式类型转换：uint8(x) / byte(x) / long(x) / double(x) ...
//   - 从 long 计算值填充 uint8[]（此前无强转做不到）
//   - 宽→窄截断、double→int、int→uint 回绕
//   - float 变量作实参（float→double 提升）
import env;

class Main {
    action:
        @startup void run() {
            // 1) long 计算值填充 uint8[]（base64 场景的核心）
            long rng = 24680;
            rng = (rng * 1103515245L + 12345L) % 2147483648L;
            uint8[] in = new uint8[3];
            in[0] = uint8((rng >> 16) & 0xFFL);
            in[1] = uint8(190L);
            in[2] = uint8(255L);
            Console.writeString("u8:");
            Console.write(int(in[0])); Console.writeString(",");
            Console.write(int(in[1])); Console.writeString(",");
            Console.write(int(in[2])); Console.writeString("\n");
            // 2) 宽→窄显式截断
            byte b = byte(200L);
            int8 i8 = int8(-3);
            short s = short(100000L);
            Console.writeString("narrow:");
            Console.write(int(b)); Console.writeString(",");
            Console.write(int(i8)); Console.writeString(",");
            Console.write(int(s)); Console.writeString("\n");
            // 3) double→int、int→long、int→uint 回绕
            int x = int(3.99);
            long y = long(x);
            uint u = uint(-1);
            Console.writeString("conv:");
            Console.write(x); Console.writeString(",");
            Console.writeLong(y); Console.writeString(",");
            Console.writeLong(u); Console.writeString("\n");
            // 4) float 变量作实参（float→double 提升）
            float f = float(42.5);
            Console.writeString("f:"); Console.writeFloat(f); Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
