// 验证三个修复：break/continue、裸属性赋值、数组
// main 中只创建实例 + mapping，不调用任何方法
import env;

class Calculator {
    action:
        @startup void run() {
            count = 10;        // 裸属性赋值
            count = count + 1; // 裸属性读写
            resultReady(count); //  期望 11
            resultReady(sumTo(10)); // 期望 1+3+5+7+9 = 25
        }
        // 测试 break/continue
        int sumTo(int limit) {
            int total = 0;
            int i = 1;
            while (i <= 100) {
                if (i > limit) break;
                if (i % 2 == 0) { i = i + 1; continue; }
                total = total + i;
                i = i + 1;
            }
            return total;
        }
    event:
        resultReady(int v);
    property:
        int count;
}

mapping() {
    Calculator.resultReady -> Console.write;
}

int main() {
    Calculator calc = new Calculator();
    Console console = new Console();

    // main 只创建实例，所有逻辑通过 @startup + mapping 驱动
    return 0;
}
