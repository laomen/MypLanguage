// interface_default: trait 默认实现（§三-5，additive）
// 覆盖：接口方法带默认体（类可省略）、默认体内 this.method() 静态分派到具体类、
// 类覆盖默认、多实现类共享默认、纯签名方法仍强制实现（负测试）
import env;

interface IShape {
    double area();                      // 纯签名 → 实现类必须实现
    double perimeter();
    string describe() {                 // 默认实现 → 实现类可省略
        return "area=" + area() + " perim=" + perimeter();
    }
}

class Circle {
    interface class IShape;
    action:
        double area() { return 3.14 * r * r; }
        double perimeter() { return 2 * 3.14 * r; }
        // 未实现 describe() → 用 IShape.describe 默认实现（this.area → Circle_area）
    property: double r = 1.0;
}

class Square {
    interface class IShape;
    action:
        double area() { return side * side; }
        double perimeter() { return 4 * side; }
        string describe() { return "SQUARE(" + area() + ")"; }   // 覆盖默认
    property: double side = 3.0;
}

// 默认方法内部再调另一个默认方法：Triangle 省略 describe() 与 label()
interface INamed {
    string label() { return "unnamed"; }   // 默认
    string full() { return label() + "#" + label(); }  // 默认调用默认（本类也未覆盖）
}

class Triangle {
    interface class INamed;
    action:
        // 两个默认方法都省略 → 均用默认（label → "unnamed"）
}

int pmRun() {
    IShape c = new Circle();
    IShape s = new Square();
    INamed t = new Triangle();
    string cc = c.describe();
    string ss = s.describe();
    string tt = t.full();
    Console.writeString(cc + " | " + ss + " | " + tt);
    Console.writeString("\n");
    return 0;
}
int main() { int c = pmRun(); return c; }
