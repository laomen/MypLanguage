// stdlib_doc — 标准库文档示例回归测试（对应 docs/design.md §10.5–§10.12）
// 覆盖：math / text(Str,StringBuilder) / io(File) / fs / collections /
//       json / crypto(Crc32,Hash) / fmt / random
// 编译+运行：mypc tests/stdlib_doc/test.myp；输出与 tests/expected/stdlib_doc.expected 比对。

import env;
import math;
import text;
import fs;
import io;
import collections;
import json;
import crypto;
import fmt;
import random;

class StdlibDoc {
    action:
        @constructor StdlibDoc() {
            // ---- §10.5 math ----
            Console.writeString("math.sqrt=");
            Console.writeFloat(Math.sqrt(16.0));
            Console.writeString("math.abs=");
            Console.write(Math.abs(-5));
            Console.writeString("math.floor=");
            Console.writeFloat(Math.floor(3.7));
            Console.writeString("math.min=");
            Console.write(Math.min(3, 5));

            // ---- §10.6 text：Str / StringBuilder ----
            Console.writeString("str.len=");
            Console.write(Str.len("hello"));
            Console.writeString("str.toUpper=" + Str.toUpper("hi") + "\n");
            Console.writeString("str.substring=" + Str.substring("hello", 1, 3) + "\n");
            Console.writeString("str.split=");
            Console.write(Str.splitCount("a,b,c", ","));
            StringBuilder sb = new StringBuilder();
            sb.append("Hello"); sb.append(" World");
            Console.writeString("sb=" + sb.toString() + "\n");

            // ---- §10.7 io：File ----
            File f = new File();
            f.open("/tmp/myp_stdlib_doc.txt", "w");
            f.writeLine("hello file");
            f.close();
            File g = new File();
            g.open("/tmp/myp_stdlib_doc.txt", "r");
            Console.writeString("file=" + g.readLine() + "\n");
            g.close();

            // ---- §10.8 fs：Fs ----
            Console.writeString("fs.exists=");
            Console.write(Fs.exists("/tmp"));
            Console.writeString("fs.join=" + Fs.join("/tmp", "x.txt") + "\n");

            // ---- §10.9 collections：ArrayList / StrHashMap ----
            ArrayList<int> arr = new ArrayList<int>();
            arr.add(1); arr.add(2); arr.add(3);
            Console.writeString("al.size=");
            Console.write(arr.size());
            StrHashMap<int> m = new StrHashMap<int>();
            m.put("k", 7);
            Console.writeString("shm.get=");
            Console.write(m.get("k", 0));

            // ---- §10.10 json：Json ----
            Json doc = new Json("{\"name\":\"myp\",\"ver\":1}");
            Console.writeString("json.name=" + doc.getString("name") + "\n");
            Console.writeString("json.ver=");
            Console.write(doc.getInt("ver"));
            doc.free();

            // ---- §10.11 crypto / fmt ----
            Console.writeString("crc=" + Crc32.crc32Hex("hello") + "\n");
            Console.writeString("md5=" + Hash.md5("abc") + "\n");
            Console.writeString("fmt=" + Fmt.f(3.14159, 2) + "\n");
            Console.writeString("fmt.x=" + Fmt.x(255, 4) + "\n");

            // ---- §10.12 random ----
            Random.init(42);
            Console.writeString("rand.below=");
            Console.write(Random.below(100));
        }
}

int main() {
    StdlibDoc d = new StdlibDoc();
    return 0;
}
