// M3 — 声明式宏（macro AST 展开）
// 覆盖：表达式参数 / 语句参数 / 赋值参数 / 嵌套宏
import env;

macro repeat($n, $body) {
    for (int _i = 0; _i < $n; _i++) {
        $body
    }
}

macro addN($x, $n) {
    $x = $x + $n;
}

macro twice($body) {
    $body
    $body
}

macro log($a) {
    Console.writeString("v=");
    Console.write($a);
    Console.writeString("\n");
}

class Main {
    action:
        @startup void run() {
            int v = 0;
            repeat(3, v = v + 10);      // v = 30
            addN(v, 5);                 // v = 35
            twice(v = v + 1);           // 嵌套：v = 37
            log(v);                     // 表达式参数宏
        }
}

int main(){ Main m = new Main(); return 0; }
