// @threadpool — 线程池注解测试（4 个线程各打印一次）
// 注：pool 建在 Main @startup 里并等待，避免 main 返回时 worker 未跑完
//   （既有时序 flaky：期望 "wwww"，偶发 "www"）。
import env;
import time;

class Worker {
    action:
        @startup void run() {
            Console.writeString("w");
        }
}

class Main {
    action:
        @startup void run() {
            Worker[4] pool @threadpool;
            Time.sleep(100);   // 等 4 个 worker 打印完
            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
