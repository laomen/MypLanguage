// Struct 验证
// 验证：struct 定义、字段读写、struct 数组

import env;

struct Point {
    int x;
    int y;
    string name;
}

class Main {
    action:
        @startup void run() {
            Console.writeString("[Struct 验证]\n");

            Point p;
            p.x = 10;
            p.y = 20;
            p.name = "P1";
            Console.writeString("p = ("); Console.write(p.x);
            Console.writeString(","); Console.write(p.y);
            Console.writeString(") "); Console.writeString(p.name); Console.writeString("\n");

            // 字段运算
            int sum = p.x + p.y;
            Console.writeString("p.x + p.y = "); Console.write(sum); Console.writeString("\n");

            // 修改字段
            p.x = p.x * 2;
            Console.writeString("after p.x*2 = "); Console.write(p.x); Console.writeString("\n");

            // 多个 struct 独立
            Point q;
            q.x = 5;
            q.y = 15;
            q.name = "P2";
            Console.writeString("q = ("); Console.write(q.x);
            Console.writeString(","); Console.write(q.y);
            Console.writeString(") "); Console.writeString(q.name); Console.writeString("\n");

            // struct 字段拷贝
            Point r;
            r.x = p.x;
            r.y = q.y;
            r.name = "P3";
            Console.writeString("r.x = p.x = "); Console.write(r.x);
            Console.writeString(", r.y = q.y = "); Console.write(r.y);
            Console.writeString("\n");

            Console.writeString("[OK] Struct 验证通过\n");
        }
}

int main(){Main m=new Main();return 0;}
