// iface_upcast_chain: interface 转换从链式结果/字段（vtable 完整）→ @test
// 自举缺口（BUG-064，BUG-029/033/034 族）：upcastClsName 只处理 New/Identifier/
// this.field/Subscript，漏了 Call（顶层函数/方法/集合 get 返回）与 struct 变量
// .字段 → 具体类名解析不到 → vtable 槽 null → 派发段错误。
// 覆盖：new / 局部变量 / 顶层函数返回 / 方法返回 / 集合 get / struct 字段
import test;
import collections;

interface Shape { int area(); }
class Circle {
    interface class Shape;
    action: int area() { return 4; }
}
class Box {
    action:
        Circle make() { Circle c = new Circle(); return c; }
}
Circle factory() { Circle c = new Circle(); return c; }
struct HolderS { Circle c; }

// —— 1) new / 局部变量（基准，本就该过）——
@test void test_basic() {
    Shape s1 = new Circle();
    Test.assertEq(s1.area(), 4, "new upcast");
    Circle lc = new Circle();
    Shape s2 = lc;
    Test.assertEq(s2.area(), 4, "local upcast");
    Test.report("test_basic", true);
}

// —— 2) 顶层函数返回 → interface ——
@test void test_func_ret() {
    Shape s = factory();
    Test.assertEq(s.area(), 4, "func ret upcast");
    Test.report("test_func_ret", true);
}

// —— 3) 方法返回 → interface ——
@test void test_method_ret() {
    Box b = new Box();
    Shape s = b.make();
    Test.assertEq(s.area(), 4, "method ret upcast");
    Test.report("test_method_ret", true);
}

// —— 4) 集合 get 返回 → interface（泛型方法返回）——
@test void test_coll_get() {
    ArrayList<Circle> cs = new ArrayList<Circle>();
    Circle lc = new Circle();
    cs.add(lc);
    Shape s = cs.get(0);
    Test.assertEq(s.area(), 4, "coll get upcast");
    Test.report("test_coll_get", true);
}

// —— 5) struct 字段 → interface ——
@test void test_struct_field() {
    HolderS h;
    h.c = new Circle();
    Shape s = h.c;
    Test.assertEq(s.area(), 4, "struct field upcast");
    Test.report("test_struct_field", true);
}

// —— 6) 集合 get 结果 .struct字段 → interface（BUG-065，Member 对象是 Call）——
@test void test_coll_get_field() {
    ArrayList<HolderS> hs = new ArrayList<HolderS>();
    HolderS h;
    h.c = new Circle();
    hs.add(h);
    Shape s = hs.get(0).c;
    Test.assertEq(s.area(), 4, "coll get field upcast");
    Test.report("test_coll_get_field", true);
}

// —— 7) interface 参数从 call 结果 ——
class T2b {
    action:
        int takeShape(Shape s) { return s.area(); }
}
@test void test_iface_param() {
    T2b t = new T2b();
    Test.assertEq(t.takeShape(factory()), 4, "iface param from call");
    Circle lc = new Circle();
    Test.assertEq(t.takeShape(lc), 4, "iface param from local");
    Test.report("test_iface_param", true);
}

// —— 8) 返回 call 结果作 interface ——
class T2c {
    action:
        Shape makeShapeRet(Circle c) { return c; }
}
@test void test_iface_ret() {
    T2c t = new T2c();
    Circle lc = new Circle();
    Shape s = t.makeShapeRet(lc);
    Test.assertEq(s.area(), 4, "iface ret");
    Test.report("test_iface_ret", true);
}

// —— 9) interface 上下文（setter 实参/接口数组元素写/方法实参）+ 链式结果 ——
class HolderI {
    property: Shape s;
    action:
        void set(Shape v) { s = v; }
        Shape get() { return s; }
}
@test void test_iface_contexts() {
    HolderI hi = new HolderI();
    ArrayList<Circle> cs = new ArrayList<Circle>();
    Circle lc = new Circle();
    cs.add(lc);
    // setter 实参 = call 结果 / 集合 get
    hi.set(factory());
    Test.assertEq(hi.get().area(), 4, "setter from call");
    hi.set(cs.get(0));
    Test.assertEq(hi.get().area(), 4, "setter from coll get");
    // 接口数组元素写 = call 结果
    Shape[] arr = new Shape[2];
    arr[0] = factory();
    Test.assertEq(arr[0].area(), 4, "iface array elem");
    Test.report("test_iface_contexts", true);
}
