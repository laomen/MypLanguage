// cyclecollect_multi: 多环/大规模环收集（v3.15.176）——修复 ccAddrOk 从
// Arena.head（最旧 chunk，next=0）遍历只检查首 chunk → 多 chunk 时新对象全被
// 误判为悬垂跳过 rc-- → 多环大规模漏收集（实测 50 环全收、1000 环只收 204）。
// 修复：ccAddrOk 从 Arena.cur（最新 chunk）遍历（chunk 链表反向，cur.next=旧）。
// 覆盖：大量独立环显式收集 / 自动收集（水位）下多环回收。

import test;
import memory;
import rtti;

class Node {
    action:
        void setBox(Box<Node> b) { box = b; }
    property:
        Box<Node> box;
}

class Box<T> {
    action:
        void add(T v) {
            if (data_ == null) { data_ = new T[8]; }
            data_[cnt_] = v;
            cnt_ = cnt_ + 1;
        }
    property:
        T[] data_;
        int cnt_ = 0;
}

// 大量独立环（1000 个）显式收集 → 全部回收（修复前只收 ~204）。
@test void test_multi_cycle_collected() {
    int tid = 0;
    long before = 0;
    {
        Node tmp = new Node();
        tid = Rtti.typeId(tmp);
        before = Memory.liveObjectCountByType(tid);   // = 之前 + 1（tmp）
    }
    for (int i = 0; i < 1000; i = i + 1) {
        {
            Node a = new Node();
            Box<Node> b = new Box<Node>();
            b.add(a);
            a.setBox(b);
        }
    }
    Memory.collectCycles();
    Test.assertLongEq(Memory.liveObjectCountByType(tid), before - 1,
        "1000 independent Box<Node> cycles all collected (tmp freed)");
}

// 自动收集（水位 collectCyclesIfNeeded）下多环回收：循环制造环 + 自动收集，
// 结束后显式 collect 兜底，Node 应回落（修复前自动收集几乎不清环）。
@test void test_multi_auto_collected() {
    int tid = 0;
    long before = 0;
    {
        Node tmp = new Node();
        tid = Rtti.typeId(tmp);
        before = Memory.liveObjectCountByType(tid);   // = 之前 + 1（tmp）
    }
    for (int i = 0; i < 3000; i = i + 1) {
        {
            Node a = new Node();
            Box<Node> b = new Box<Node>();
            b.add(a);
            a.setBox(b);
        }
        Memory.collectCyclesIfNeeded();
    }
    Memory.collectCycles();
    Test.assertLongEq(Memory.liveObjectCountByType(tid), before - 1,
        "auto-collection keeps cycles bounded (all freed after final collect)");
}
