// manual_serde_derive.myp — @derive(Json) 派生序列化回归（v1）
// ---------------------------------------------------------------------------
// @derive(Json) 类注解 → 编译期自动生成 toJson()/fromJson()（标量/string/bool）。
// 需 import json（Json.escape + Json 路径查询）。oracle 与 selfhost 双端同步。
import test;
import json;
import text;

@derive(Json)
class Player {
    action:
        @constructor Player(string n, int h, double sc, bool al) {
            name = n; hp = h; score = sc; alive = al;
        }
        string getName() { return name; }
        int getHp() { return hp; }
        double getScore() { return score; }
        bool getAlive() { return alive; }
    property:
        string name;
        int hp;
        double score;
        bool alive;
}

@test void t_roundtrip() {
    Player p = new Player("A\"B\n", 100, 3.5, true);
    string j = p.toJson();
    // 转义正确：引号→\"，换行→\n
    Test.assertStrEq(j, "{\"name\":\"A\\\"B\\n\",\"hp\":100,\"score\":3.5,\"alive\":true}");
    Player q = new Player("", 0, 0.0, false);
    q.fromJson(j);
    Test.assertStrEq(q.getName(), "A\"B\n");
    Test.assertEq(q.getHp(), 100);
    Test.assertTrue(q.getAlive());
}

@test void t_json_valid() {
    Player p = new Player("plain", 7, 1.5, false);
    // toJson 输出应能被 json.myp 解析（合法 JSON）。
    Json doc = new Json(p.toJson());
    Test.assertEq(doc.getInt("hp"), 7);
    Test.assertStrEq(doc.getString("name"), "plain");
    Test.assertEq(doc.getBool("alive"), 0);
    doc.free();
}

// ---- P1 嵌套 @derive(Json) 类（v3.16.5）----
// 类属性类型为另一个 @derive(Json) 类 → toJson 递归调子 toJson；fromJson 先 new
// 子对象，再用 Json.subString(path) 取子树 JSON 交子 fromJson。多层嵌套 round-trip。

@derive(Json)
class NestedItem {
    action:
        string getName() { return name; }
        int getQty() { return qty; }
    property:
        string name;
        int qty;
}

@derive(Json)
class NestedOrder {
    action:
        string itemName() { return item.getName(); }
        int total() { return qty + item.getQty(); }
    property:
        NestedItem item;
        int qty;
}

@derive(Json)
class DeepWrap {
    property:
        NestedOrder order;
}

@test void t_nested_roundtrip() {
    NestedOrder o = new NestedOrder();
    o.fromJson("{\"item\":{\"name\":\"pear\",\"qty\":7},\"qty\":1}");
    string j = o.toJson();
    Test.assertStrEq(j, "{\"item\":{\"name\":\"pear\",\"qty\":7},\"qty\":1}");
    Test.assertStrEq(o.itemName(), "pear");
    Test.assertEq(o.total(), 8);
    // fromJson 已自动 new 嵌套子对象；round-trip 稳定
    NestedOrder o2 = new NestedOrder();
    o2.fromJson(j);
    Test.assertStrEq(o2.toJson(), j);
    // 输出是合法 JSON（可解析并读到嵌套字段）
    Json doc = new Json(j);
    Test.assertEq(doc.getInt("qty"), 1);
    Test.assertEq(doc.getInt("item.qty"), 7);
    Test.assertStrEq(doc.getString("item.name"), "pear");
    doc.free();
}

@test void t_deep_roundtrip() {
    DeepWrap w = new DeepWrap();
    w.fromJson("{\"order\":{\"item\":{\"name\":\"deep\",\"qty\":2},\"qty\":5}}");
    string j = w.toJson();
    Test.assertStrEq(j, "{\"order\":{\"item\":{\"name\":\"deep\",\"qty\":2},\"qty\":5}}");
    DeepWrap w2 = new DeepWrap();
    w2.fromJson(j);
    Test.assertStrEq(w2.toJson(), j);
    // 多层嵌套可路径读取
    Json doc = new Json(j);
    Test.assertStrEq(doc.getString("order.item.name"), "deep");
    doc.free();
}
