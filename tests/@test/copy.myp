// M4: copy() 深拷贝约定测试 → @test
// class 引用别名 vs 显式 copy()；struct copy() 深拷贝

import test;

class Image {
    action:
        @constructor
        Image(int w, int h) {
            width = w;
            height = h;
            data_ = new int[w * h];
        }
        Image copy() {
            Image c = new Image(width, height);
            for (int i = 0; i < width * height; i = i + 1) c.data_[i] = data_[i];
            return c;
        }
        int get(int i) { return data_[i]; }
        void set(int i, int v) { data_[i] = v; }
    property:
        int width;
        int height;
        int[] data_;
}

struct Buffer {
    action:
        @constructor
        Buffer(int n) { size = n; data = new int[n]; }
        Buffer copy() {
            Buffer c = Buffer(size);
            for (int i = 0; i < size; i = i + 1) c.data[i] = data[i];
            return c;
        }
    int size;
    int[] data;
}

@test void test_copy() {
    // class: 引用别名（不拷贝）
    Image a = new Image(4, 1);
    a.set(0, 42);
    Image b = a;
    b.set(0, 7);
    Test.assertEq(a.get(0), 7, "引用共享 a");

    // class: 显式深拷贝
    Image c = a.copy();
    c.set(0, 99);
    Test.assertEq(a.get(0), 7, "a 不受拷贝影响");
    Test.assertEq(c.get(0), 99, "c 深拷贝");

    // struct: 成员级拷贝（浅，共享数组）
    Buffer ba = Buffer(3);
    ba.data[0] = 5;
    Buffer bs = ba;
    bs.data[0] = 6;
    Test.assertEq(ba.data[0], 6, "struct 浅共享");

    // struct: 显式深拷贝
    Buffer bc = ba.copy();
    bc.data[0] = 8;
    Test.assertEq(ba.data[0], 6, "ba 不受影响");
    Test.assertEq(bc.data[0], 8, "bc 深拷贝");

    Test.report("test_copy", true);
}
