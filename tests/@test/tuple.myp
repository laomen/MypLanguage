// tuple: 元组 + 解构（§三-2）——TUP-1（类型+字面量+声明式解构+多值返回）
// + TUP-2（赋值式解构 + 嵌套 + 字段访问 t.N）→ 转 @test
import test;

// 多返回值：元组
(int, string) getPair() { return (1, "x"); }
(int, int) getTwo() { return (7, 9); }
((int, int), int) getNested() { return ((1, 2), 5); }

@test void test_tuple() {
    // 元组字面量 + 元组变量 + 字段访问
    (int, int) t = (3, 4);
    int c = t.0;
    int d = t.1;
    // 声明式解构（多值返回）
    (int a, string b) = getPair();
    // 字段访问 + 多值返回
    (int, int) r = getTwo();
    int e = r.0;
    int f = r.1;
    // 赋值式解构（已有变量）
    int g; int h;
    (g, h) = getTwo();
    // 嵌套解构
    ((int p, int q), int z) = getNested();
    // 三元素元组
    (int, int, int) tri = (1, 2, 3);
    int w = tri.2;
    // 值断言（原 expected: a=1 b=x c=3 d=4 e=7 f=9 g=7 h=9 p=1 q=2 z=5 w=3）
    Test.assertEq(a, 1, "a");
    Test.assertStrEq(b, "x", "b");
    Test.assertEq(c, 3, "c");
    Test.assertEq(d, 4, "d");
    Test.assertEq(e, 7, "e");
    Test.assertEq(f, 9, "f");
    Test.assertEq(g, 7, "g");
    Test.assertEq(h, 9, "h");
    Test.assertEq(p, 1, "p");
    Test.assertEq(q, 2, "q");
    Test.assertEq(z, 5, "z");
    Test.assertEq(w, 3, "w");
    Test.report("test_tuple", true);
}
