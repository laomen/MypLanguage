// rtti: 运行时类型信息 → @test
// 覆盖：typeId / typeOf / sameType；同类同 id；null → 0/""

import test;
import rtti;

class Tank {
    action:
        void setLabel(string v) { label = v; }
        void setHp(int v) { hp = v; }
    property:
        string label;
        int hp;
}

class Soldier {
    action:
        void setName(string v) { name = v; }
    property:
        string name;
}

class Sniper {
    action:
        void setRange(int v) { range = v; }
    property:
        int range;
}

@test void test_rtti() {
    Tank t = new Tank();
    t.setLabel("T-90"); t.setHp(100);
    Tank t2 = new Tank();
    Soldier s = new Soldier();
    s.setName("John");
    Sniper sn = new Sniper();
    sn.setRange(800);

    // typeOf → 类名
    string n1 = Rtti.typeOf<Tank>(t);
    string n2 = Rtti.typeOf<Soldier>(s);
    string n3 = Rtti.typeOf<Sniper>(sn);
    Test.assertStrEq(n1, "Tank", "typeOf Tank");
    Test.assertStrEq(n2, "Soldier", "typeOf Soldier");
    Test.assertStrEq(n3, "Sniper", "typeOf Sniper");

    // typeId：同类恒定、跨类不同
    int id1 = Rtti.typeId<Tank>(t);
    int id2 = Rtti.typeId<Tank>(t2);
    int id3 = Rtti.typeId<Soldier>(s);
    int id4 = Rtti.typeId<Sniper>(sn);
    Test.assertEq(id1, id2, "同类 id 相同");
    Test.assertNeq(id1, id3, "Tank/Soldier id 不同");
    Test.assertNeq(id1, id4, "Tank/Sniper id 不同");
    Test.assertNeq(id3, id4, "Soldier/Sniper id 不同");

    // sameType 正 / 反
    Test.assertEq(Rtti.sameType<Tank, Tank>(t, t2), 1, "same(t,t2)");
    Test.assertEq(Rtti.sameType<Tank, Soldier>(t, s), 0, "same(t,s)");
    Test.assertEq(Rtti.sameType<Soldier, Sniper>(s, sn), 0, "same(s,sn)");

    // null → typeId 0 / typeOf ""
    Tank nul = null;
    Test.assertEq(Rtti.typeId<Tank>(nul), 0, "null id=0");
    Test.assertStrEq(Rtti.typeOf<Tank>(nul), "", "null name=''");

    Test.report("test_rtti", true);
}
