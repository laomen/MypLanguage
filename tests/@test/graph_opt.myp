// graph_opt.myp — G2 图级优化回归测试
//   · NHWC 布局内核与 NCHW 等价性（转置 / 卷积 / 最大池化 / 全局平均池化）
//   · 纯 CPU（InferOps 直接调用），不依赖 GPU；GPU 路径经 ResNet50 端到端验证
import test;
import math;
import "../../deeplearning/infer/ops.myp";

// NCHW→NHWC 转置 + 卷积等价性（含权重转置）
@test void test_nhwc_conv() {
    int N = 1, C = 2, H = 4, W = 4, Cout = 3, KH = 3, KW = 3;
    int xN = N * C * H * W;
    int wN = Cout * C * KH * KW;
    float[] buf = new float[8192];
    int i = 0;
    while (i < xN) { buf[i] = float((i * 37) % 13) / float(10.0) - float(1.0); i = i + 1; }
    int wOff = 1024;
    i = 0;
    while (i < wN) { buf[wOff + i] = float((i * 11) % 7) / float(10.0) - float(0.5); i = i + 1; }
    int bOff = 2048;
    i = 0;
    while (i < Cout) { buf[bOff + i] = float(i) / float(10.0); i = i + 1; }
    int yOff = 3072;
    InferOps.conv(buf, 0, N, C, H, W, wOff, bOff, yOff, Cout, H, W, KH, KW,
                  1, 1, 1, 1, 1, 1, 1, 1, 1);
    int xnhwc = 4096;
    InferOps.transposeNCHW2NHWC(buf, 0, N, C, H, W, xnhwc);
    int wnhwc = 5120;
    int co = 0;
    while (co < Cout) {
        int ci = 0;
        while (ci < C) {
            int kh = 0;
            while (kh < KH) {
                int kw = 0;
                while (kw < KW) {
                    int src = ((co * C + ci) * KH + kh) * KW + kw;
                    int dst = ((co * KH + kh) * KW + kw) * C + ci;
                    buf[wnhwc + dst] = buf[wOff + src];
                    kw = kw + 1;
                }
                kh = kh + 1;
            }
            ci = ci + 1;
        }
        co = co + 1;
    }
    int ynhwc = 6144;
    InferOps.convNHWC(buf, xnhwc, N, H, W, C, wnhwc, bOff, ynhwc, H, W, Cout, KH, KW,
                      1, 1, 1, 1, 1, 1, 1, 1, 1);
    int n = 0;
    while (n < N) {
        int y = 0;
        while (y < H) {
            int x = 0;
            while (x < W) {
                int c = 0;
                while (c < Cout) {
                    int nid = ((n * H + y) * W + x) * Cout + c;
                    int cid = ((n * Cout + c) * H + y) * W + x;
                    Test.assertFloatEq(buf[ynhwc + nid], buf[yOff + cid], 1.0e-4, "nhwc conv");
                    c = c + 1;
                }
                x = x + 1;
            }
            y = y + 1;
        }
        n = n + 1;
    }
    Test.report("test_nhwc_conv", true);
}

// 转置往返：NCHW→NHWC→(手工逆)→NCHW 应还原
@test void test_nhwc_transpose() {
    int N = 2, C = 3, H = 4, W = 5;
    int xN = N * C * H * W;
    float[] buf = new float[4096];
    int i = 0;
    while (i < xN) { buf[i] = float((i * 7) % 11) / float(10.0); i = i + 1; }
    int xnhwc = 1024;
    InferOps.transposeNCHW2NHWC(buf, 0, N, C, H, W, xnhwc);
    // 手工逆：nchw[i] 应等于 nhwc[((n*H+h)*W+w)*C+c]
    int n = 0;
    while (n < N) {
        int c = 0;
        while (c < C) {
            int h = 0;
            while (h < H) {
                int w = 0;
                while (w < W) {
                    int nid = ((n * C + c) * H + h) * W + w;
                    int hwid = ((n * H + h) * W + w) * C + c;
                    Test.assertFloatEq(buf[xnhwc + hwid], buf[nid], 1.0e-6, "transpose rt");
                    w = w + 1;
                }
                h = h + 1;
            }
            c = c + 1;
        }
        n = n + 1;
    }
    Test.report("test_nhwc_transpose", true);
}

// NHWC 最大池化等价性
@test void test_nhwc_maxpool() {
    int N = 1, C = 4, H = 6, W = 6;
    int KH = 2, KW = 2, SH = 2, SW = 2;
    int yH = (H - KH) / SH + 1;
    int yW = (W - KW) / SW + 1;
    int xN = N * C * H * W;
    float[] buf = new float[8192];
    int i = 0;
    while (i < xN) { buf[i] = float((i * 13) % 17) / float(10.0) - float(0.5); i = i + 1; }
    int yOff = 2048;
    InferOps.maxpool(buf, 0, N, C, H, W, yOff, yH, yW, KH, KW, SH, SW, 0, 0, 0, 0);
    int xnhwc = 3072;
    InferOps.transposeNCHW2NHWC(buf, 0, N, C, H, W, xnhwc);
    int ynhwc = 4096;
    InferOps.maxpoolNHWC(buf, xnhwc, N, H, W, C, ynhwc, yH, yW, KH, KW, SH, SW, 0, 0, 0, 0);
    int n = 0;
    while (n < N) {
        int c = 0;
        while (c < C) {
            int y = 0;
            while (y < yH) {
                int x = 0;
                while (x < yW) {
                    int nid = ((n * yH + y) * yW + x) * C + c;
                    int cid = ((n * C + c) * yH + y) * yW + x;
                    Test.assertFloatEq(buf[ynhwc + nid], buf[yOff + cid], 1.0e-6, "nhwc maxpool");
                    x = x + 1;
                }
                y = y + 1;
            }
            c = c + 1;
        }
        n = n + 1;
    }
    Test.report("test_nhwc_maxpool", true);
}

// NHWC 全局平均池化等价性（输出 [N,C] flat 顺序一致）
@test void test_nhwc_gapool() {
    int N = 2, C = 5, H = 4, W = 4;
    int xN = N * C * H * W;
    float[] buf = new float[8192];
    int i = 0;
    while (i < xN) { buf[i] = float((i * 5) % 9) / float(10.0); i = i + 1; }
    int yOff = 2048;
    InferOps.gapool(buf, 0, N, C, H, W, yOff);
    int xnhwc = 3072;
    InferOps.transposeNCHW2NHWC(buf, 0, N, C, H, W, xnhwc);
    int ynhwc = 4096;
    InferOps.gapoolNHWC(buf, xnhwc, N, H, W, C, ynhwc);
    int n = 0;
    while (n < N) {
        int c = 0;
        while (c < C) {
            Test.assertFloatEq(buf[ynhwc + n * C + c], buf[yOff + n * C + c], 1.0e-6, "nhwc gapool");
            c = c + 1;
        }
        n = n + 1;
    }
    Test.report("test_nhwc_gapool", true);
}
