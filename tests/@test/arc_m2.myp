// arc_m2: ARC M-ARC-2 → @test
// T[] 元素 retain/覆盖释放 / 语句末临时释放 / return new 转移 / return 借用 / 循环临时零累积 / 批量摘链

import test;
import memory;

class Node {
    action:
        void setVal(int v) { val = v; }
        int getVal() { return val; }
        void setChild(Node c) { child = c; }      // 属性存储 → retain
        void consume(Node x) { child = x; }        // 存储参数 → retain
        Node makeChild(int v) { Node c = new Node(); c.setVal(v); return c; }  // 借用返回
        Node makeFresh(int v) { return new Node(); }  // return new → 转移
    property:
        Node child;
        int val = 0;
}

@test void test_arc_m2() {
    long base = Memory.liveObjectCount();
    Node host = new Node();

    // T[] 数组：别名入数组 retain，局部释放后元素仍存活
    {
        Node[] arr = new Node[2];
        {
            Node x = new Node();
            x.setVal(11);
            arr[0] = x;
        }
        int got = arr[0].getVal();
        Test.assertEq(got, 11, "arr_alias got");
        Node y = new Node();
        y.setVal(22);
        arr[0] = y;                  // retain(y) + release(旧 arr[0]=x)
        Test.assertEq(arr[0].getVal(), 22, "arr_overwrite");
    }

    // 语句末临时释放：new 作实参（consume 存储 retain）不累积
    for (int i = 0; i < 1000; i = i + 1) {
        host.consume(new Node());
    }
    long after_consume = Memory.liveObjectCount() - base;
    Test.assertEq(after_consume, 2, "temp_consume after=2");   // host + child

    // 纯丢弃临时：`new Node();` 语句 → 立即释放
    for (int i = 0; i < 1000; i = i + 1) {
        new Node();
    }
    long after_discard = Memory.liveObjectCount() - base;
    Test.assertEq(after_discard, 2, "temp_discard after=2");

    // return new → 转移（不泄漏）
    for (int i = 0; i < 1000; i = i + 1) {
        Node fresh = host.makeFresh(i);
    }
    long after_return = Memory.liveObjectCount() - base;
    Test.assertEq(after_return, 2, "return_new after=2");

    // return 借用（命名局部）→ retain-at-return + epilogue release 不泄漏
    for (int i = 0; i < 1000; i = i + 1) {
        Node c = host.makeChild(i);
    }
    long after_borrow = Memory.liveObjectCount() - base;
    Test.assertEq(after_borrow, 2, "return_borrow after=2");

    // tracking list：头/尾/中间节点均可 O(1) 摘链，批量释放后不残留
    long before_bulk = Memory.liveObjectCount();
    {
        Node[] bulk = new Node[256];
        for (int i = 0; i < 256; i = i + 1) {
            Node item = new Node();
            bulk[i] = item;
        }
        bulk[0] = null;
        bulk[255] = null;
        bulk[127] = null;
        for (int i = 0; i < 256; i = i + 1) bulk[i] = null;
    }
    long after_bulk = Memory.liveObjectCount() - before_bulk;
    Test.assertEq(after_bulk, 0, "tracking_unlink after=0");

    Test.report("test_arc_m2", true);
}
