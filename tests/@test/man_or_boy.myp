// Man or Boy 测试（Knuth 经典）：递归闭包 + 一等函数 thunk 参数 + 按引用捕获。
// 意义：验证语言能表达"递归闭包把自身作为 thunk 递归传递"（M-FN-2 __self +
// 命名 lambda 自引用），且 `nonlocal` 提供闭包按引用（共享可变）捕获——
// 标准 ALGOL 60 语义 `value k`（k 按值，每层 A 帧独立）+ 按名 thunk 得以自然书写。
//
//   - `nonlocal k;`：lambda B 按引用捕获外层函数 A 的参数 k，`k = k - 1` 直接改
//     共享 cell（无需 slice 盒/每帧副本）；递归 `A(k, B, ...)` 传 k 的值（每帧独立）
//   - x1..x5 为函数值（thunk），B 递归时把自身作为 x1 传递
//
// 标准结果（以 Go 参考实现为准——k 按值传参、闭包 b 按引用捕获 k 并 k--、
// 递归时传当前 k 的值）：
//   A(-1)=1 A(0)=1 A(1)=0 A(2)=-2 A(3)=0 A(4)=1 A(5)=0 A(6)=1
//   A(7)=-1 A(8)=-10 A(9)=-30 A(10)=-67
import test;

// 常量 thunk：返回 n（捕获 n）
(int) -> int K(int n) {
    return (int d) => { return n; };
}

int A(int k, (int) -> int x1, (int) -> int x2, (int) -> int x3, (int) -> int x4, (int) -> int x5) {
    (int) -> int B = (int d) => {
        nonlocal k;
        k = k - 1;
        return A(k, B, x1, x2, x3, x4);
    };
    if (k <= 0) return x4(0) + x5(0);
    return B(0);
}

@test void test_man_or_boy() {
    // A(n, K(1), K(-1), K(-1), K(1), K(0))，n = -1..10（下标 n+1）
    int[] exp = new int[12];
    exp[0]=1;  exp[1]=1;  exp[2]=0;  exp[3]=-2;
    exp[4]=0;  exp[5]=1;  exp[6]=0;  exp[7]=1;
    exp[8]=-1; exp[9]=-10; exp[10]=-30; exp[11]=-67;

    for (int n = -1; n <= 10; n = n + 1) {
        int r = A(n, K(1), K(-1), K(-1), K(1), K(0));
        Test.assertEq(r, exp[n + 1], "Man or Boy A(" + n + ")");
    }
    Test.report("test_man_or_boy", true);
}
