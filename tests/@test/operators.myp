// 算子系统回归测试 → @test
// 验证: struct 内算子(operator: 节 + @op) + 外部 @op 函数 + 内建并存
import test;

struct Vector3 {
    operator:
        @op("+") Vector3 add(Vector3 other) {
            Vector3 r;
            r.x_ = x_ + other.x_;
            r.y_ = y_ + other.y_;
            r.z_ = z_ + other.z_;
            return r;
        }
        @op("*") Vector3 mul(double s) {
            Vector3 r;
            r.x_ = x_ * s;
            r.y_ = y_ * s;
            r.z_ = z_ * s;
            return r;
        }
    double x_ = 0;
    double y_ = 0;
    double z_ = 0;
}

// 外部 @op: 内置数组类型 (double[] 逐元素加)
@op("+") double[] vecAdd(double[] A, double[] B) {
    int n = 4;
    double[] C = new double[n];
    int i = 0; while (i < n) { C[i] = A[i] + B[i]; i = i + 1; }
    return C;
}

// 外部 @op: 对称混合二元 (标量 * 向量)
@op("*") Vector3 vecMul(double s, Vector3 a) {
    Vector3 r;
    r.x_ = a.x_ * s;
    r.y_ = a.y_ * s;
    r.z_ = a.z_ * s;
    return r;
}

@test void test_operators() {
    // --- 1. struct 内算子 ---
    Vector3 v; v.x_ = 1; v.y_ = 2; v.z_ = 3;
    Vector3 u; u.x_ = 4; u.y_ = 5; u.z_ = 6;
    Vector3 w = v + u;         // @op("+") add → (5,7,9)
    Vector3 s = v * 2.0;       // @op("*") mul → (2,4,6)
    Test.assertFloatEq(w.x_, 5.0, 0.0001, "w.x");
    Test.assertFloatEq(w.y_, 7.0, 0.0001, "w.y");
    Test.assertFloatEq(w.z_, 9.0, 0.0001, "w.z");
    Test.assertFloatEq(s.x_, 2.0, 0.0001, "s.x");
    Test.assertFloatEq(s.y_, 4.0, 0.0001, "s.y");
    Test.assertFloatEq(s.z_, 6.0, 0.0001, "s.z");

    // --- 2. 外部算子 (内置数组类型) ---
    double[] A = new double[4];
    double[] B = new double[4];
    int i = 0; while (i < 4) { A[i] = i * 1.0; B[i] = 10.0; i = i + 1; }
    double[] C = A + B;        // @op("+") 外部函数 → [10,11,12,13]
    Test.assertFloatEq(C[0], 10.0, 0.0001, "C0");
    Test.assertFloatEq(C[1], 11.0, 0.0001, "C1");
    Test.assertFloatEq(C[2], 12.0, 0.0001, "C2");
    Test.assertFloatEq(C[3], 13.0, 0.0001, "C3");

    // --- 3. 外部对称混合二元 (s * v) ---
    Vector3 m = 3.0 * v;       // @op("*") 外部函数 → (3,6,9)
    Test.assertFloatEq(m.x_, 3.0, 0.0001, "m.x");
    Test.assertFloatEq(m.y_, 6.0, 0.0001, "m.y");
    Test.assertFloatEq(m.z_, 9.0, 0.0001, "m.z");

    // --- 4. 内建不受影响 ---
    double builtin = 2.0 + 3.0;
    Test.assertFloatEq(builtin, 5.0, 0.0001, "builtin");
    Test.report("test_operators", true);
}
