// const_string: 编译期字符串拼接/比较 → @test
import test;

const string A = "hi " + "x";           // "hi x"
const string B = "a" + "b" + "c";       // "abc"
const bool EQ = ("ab" + "c") == "abc";  // 编译期字符串相等
@eval string greet(string n) { return "hi " + n; }
const string C = greet("myp");          // "hi myp"

@test void test_const_string() {
    Test.assertStrEq(A(), "hi x", "A");
    Test.assertStrEq(B(), "abc", "B");
    Test.assertStrEq(C(), "hi myp", "C");
    Test.assert(EQ(), "EQ");
    Test.report("test_const_string", true);
}
