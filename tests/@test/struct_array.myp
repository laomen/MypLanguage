// struct 数组元素字段读写 → @test
// 覆盖：字段写、字段读、链式嵌套字段、整体元素拷贝、循环中下标字段

import test;

struct Vec {
    int x;
    int y;
    int z;
}

struct Inner {
    int a;
    int b;
}

struct Outer {
    Inner in;
    int tag;
}

int structArrayTest(int n, int seed) {
    Vec[] v = new Vec[n];
    v[5].x = 10;
    v[5].y = 20;
    v[5].z = 30;
    v[6].x = 1;
    v[6].y = 2;
    v[6].z = 3;
    int r = v[5].x + v[5].y + v[5].z;          // 60
    int r2 = v[5].x * v[6].y + v[6].z;         // 23
    int acc = 0;
    int i = 0;
    while (i < 10) {
        v[i].x = i;
        v[i].y = i * 2;
        acc = acc + v[i].x + v[i].y;
        i = i + 1;
    }
    Vec t;
    t.x = 100;
    t.y = 200;
    t.z = 300;
    v[7] = t;
    Vec u = v[7];
    Outer[] o = new Outer[4];
    o[2].in.a = 7;
    o[2].in.b = 8;
    o[2].tag = 9;
    int nest = o[2].in.a + o[2].in.b + o[2].tag; // 24
    return r + r2 + acc + u.x + u.y + u.z + nest;
}

@test void test_struct_array() {
    int v = structArrayTest(100, 1);
    Test.assertEq(v, 842, "structArrayTest 期望 842");
    Test.assertEq(v, 60 + 23 + 135 + 600 + 24, "分量之和");
    Test.report("test_struct_array", true);
}
