// act_opt.myp — G4：通用激活内核回归测试（与逐元素手工参考一致）
//   · relu6 / leakyrelu / silu / hardswish / clip
// 纯 CPU（InferOps 直接调用）；SiLU 手工参考（本环境 onnx/ort 未注册 SiLU schema，
// 无法用 onnxruntime 端到端对比，故在 @test 内验证；GPU 路径经 act_main 端到端验证）
import test;
import math;
import "../../examples/deeplearning/infer/ops.myp";

@test void test_act_relu6() {
    int n = 8;
    float[] buf = new float[4096];
    int i = 0;
    while (i < n) { buf[i] = float(-3 + i); i = i + 1; }   // [-3,-2,-1,0,1,2,3,4]
    InferOps.relu6(buf, 0, 16, n);
    i = 0;
    while (i < n) {
        double v = buf[i];
        double r = v;
        if (r > 6.0) r = 6.0;
        if (r < 0.0) r = 0.0;
        Test.assertFloatEq(buf[16 + i], r, 1.0e-6, "relu6");
        i = i + 1;
    }
    Test.report("test_act_relu6", true);
}

@test void test_act_leakyrelu() {
    int n = 8;
    float[] buf = new float[4096];
    int i = 0;
    while (i < n) { buf[i] = float(-3 + i); i = i + 1; }
    double alpha = 0.2;
    InferOps.leakyrelu(buf, 0, 16, n, alpha);
    i = 0;
    while (i < n) {
        double v = buf[i];
        double r = v;
        if (r <= 0.0) r = alpha * v;
        Test.assertFloatEq(buf[16 + i], r, 1.0e-6, "leakyrelu");
        i = i + 1;
    }
    Test.report("test_act_leakyrelu", true);
}

@test void test_act_silu() {
    int n = 8;
    float[] buf = new float[4096];
    int i = 0;
    while (i < n) { buf[i] = float(-3 + i); i = i + 1; }
    InferOps.silu(buf, 0, 16, n);
    i = 0;
    while (i < n) {
        double v = buf[i];
        double r = v / (1.0 + Math.exp(0.0 - v));
        Test.assertFloatEq(buf[16 + i], r, 1.0e-5, "silu");
        i = i + 1;
    }
    Test.report("test_act_silu", true);
}

@test void test_act_hardswish() {
    int n = 8;
    float[] buf = new float[4096];
    int i = 0;
    while (i < n) { buf[i] = float(-3 + i); i = i + 1; }
    InferOps.hardswish(buf, 0, 16, n);
    i = 0;
    while (i < n) {
        double v = buf[i];
        double r = v + 3.0;
        if (r < 0.0) r = 0.0;
        if (r > 6.0) r = 6.0;
        double y = v * r / 6.0;
        Test.assertFloatEq(buf[16 + i], y, 1.0e-5, "hardswish");
        i = i + 1;
    }
    Test.report("test_act_hardswish", true);
}

@test void test_act_clip() {
    int n = 8;
    float[] buf = new float[4096];
    int i = 0;
    while (i < n) { buf[i] = float(-3 + i); i = i + 1; }
    buf[100] = float(0.0);
    buf[101] = float(6.0);
    InferOps.clip(buf, 0, 16, n, 100, 101);
    i = 0;
    while (i < n) {
        double v = buf[i];
        if (v < 0.0) v = 0.0;
        if (v > 6.0) v = 6.0;
        Test.assertFloatEq(buf[16 + i], v, 1.0e-6, "clip");
        i = i + 1;
    }
    // 无上界（ReLU 式）：maxOff = -1
    InferOps.clip(buf, 0, 32, n, 100, -1);
    i = 0;
    while (i < n) {
        double v = buf[i];
        if (v < 0.0) v = 0.0;
        Test.assertFloatEq(buf[32 + i], v, 1.0e-6, "clip no-max");
        i = i + 1;
    }
    Test.report("test_act_clip", true);
}
