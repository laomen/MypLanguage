// member_chain: 方法调用结果上的链式访问 + 条件表达式 ARC 释放 → @test
// 覆盖：obj.method().field（此前 codegen fallback 丢字段 → LLVM verify 崩溃）；
// && / || / ternary 分支内创建类临时对象
import test;

struct Point {
    action: @constructor Point(int a, int b) { x = a; y = b; }
    int x;
    int y;
}

class W {
    action:
        void set(Point v) { p = v; }
        Point get() { return p; }
    property:
        Point p;
}

class Wrap<T> {
    action:
        void set(T v) { value = v; }
        T get() { return value; }
    property:
        T value;
}

@test void test_member_chain() {
    // 链式字段访问（非泛型 + 泛型）
    W w = new W(); w.set(Point(3, 4));
    W w2 = new W(); w2.set(Point(5, 6));
    int a = w.get().x;
    int b = w.get().y;

    Wrap<Point> wp = new Wrap<Point>(); wp.set(Point(7, 8));
    int c = wp.get().x;               // 泛型实例方法返回类的字段
    int d = wp.get().y;

    // && 短路 + 分支内临时对象
    bool e = w.get().x == 3 && w2.get().x == 5;
    bool f = w.get().x == 99 && w2.get().x == 5;   // 短路路径
    // || 短路
    bool g = w.get().x == 99 || w2.get().x == 5;
    // ternary 分支内字段访问 + 类结果
    int h = true ? w.get().x : w2.get().x;
    Point i = true ? Point(1, 1) : Point(2, 2);

    bool ok = a == 3 && b == 4 && c == 7 && d == 8 &&
              e && !f && g && h == 3 && i.x == 1;
    Test.assert(ok, "member_chain");
    Test.report("test_member_chain", true);
}
