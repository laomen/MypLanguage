// bn_opt.myp — G3：BatchNormalization 内核回归测试
//   · batchnorm（NCHW）与逐元素手工参考一致
//   · batchnormNHWC 与 NCHW 版等价（经转置）
// 纯 CPU（InferOps 直接调用）；GPU 路径经 bn_main 端到端验证
import test;
import math;
import "../../deeplearning/infer/ops.myp";

@test void test_batchnorm_nchw() {
    int N = 1, C = 3, H = 4, W = 4;
    int xN = N * C * H * W;
    float[] buf = new float[8192];
    int i = 0;
    while (i < xN) { buf[i] = float((i * 7) % 13) / float(10.0) - float(0.5); i = i + 1; }
    int sOff = 1024, bOff = 2048, mOff = 3072, vOff = 4096, yOff = 5120;
    i = 0;
    while (i < C) {
        buf[sOff + i] = float(1.0) + float(i) / float(10.0);
        buf[bOff + i] = float(i) / float(10.0);
        buf[mOff + i] = float(0.2) * float(i);
        buf[vOff + i] = float(0.5) + float(i) / float(10.0);
        i = i + 1;
    }
    double eps = 1.0e-5;
    InferOps.batchnorm(buf, 0, N, C, H, W, yOff, sOff, bOff, mOff, vOff, eps);
    int n = 0;
    while (n < N) {
        int c = 0;
        while (c < C) {
            double scale = buf[sOff + c];
            double mean = buf[mOff + c];
            double variance = buf[vOff + c];
            double bias = buf[bOff + c];
            double invStd = scale / Math.sqrt(variance + eps);
            int i2 = 0;
            while (i2 < H * W) {
                int idx = n * C * H * W + c * H * W + i2;
                double xv = buf[idx];
                double refv = (xv - mean) * invStd + bias;
                Test.assertFloatEq(buf[yOff + idx], refv, 1.0e-4, "batchnorm nchw");
                i2 = i2 + 1;
            }
            c = c + 1;
        }
        n = n + 1;
    }
    Test.report("test_batchnorm_nchw", true);
}

@test void test_batchnorm_nhwc() {
    int N = 1, C = 4, H = 3, W = 3;
    int xN = N * C * H * W;
    float[] buf = new float[8192];
    int i = 0;
    while (i < xN) { buf[i] = float((i * 11) % 17) / float(10.0) - float(0.5); i = i + 1; }
    int sOff = 1024, bOff = 2048, mOff = 3072, vOff = 4096;
    i = 0;
    while (i < C) {
        buf[sOff + i] = float(1.0) + float(i) / float(10.0);
        buf[bOff + i] = float(i) / float(10.0);
        buf[mOff + i] = float(0.3) * float(i);
        buf[vOff + i] = float(0.4) + float(i) / float(10.0);
        i = i + 1;
    }
    double eps = 1.0e-5;
    int yOffN = 5120;   // NCHW 结果
    InferOps.batchnorm(buf, 0, N, C, H, W, yOffN, sOff, bOff, mOff, vOff, eps);
    int xnhwc = 6144;
    InferOps.transposeNCHW2NHWC(buf, 0, N, C, H, W, xnhwc);
    int yOffH = 7168;   // NHWC 结果（x:[N,H,W,C]）
    InferOps.batchnormNHWC(buf, xnhwc, N, H, W, C, yOffH, sOff, bOff, mOff, vOff, eps);
    int n = 0;
    while (n < N) {
        int h = 0;
        while (h < H) {
            int w = 0;
            while (w < W) {
                int c = 0;
                while (c < C) {
                    int nid = ((n * H + h) * W + w) * C + c;
                    int cid = ((n * C + c) * H + h) * W + w;
                    Test.assertFloatEq(buf[yOffH + nid], buf[yOffN + cid], 1.0e-4, "batchnorm nhwc");
                    c = c + 1;
                }
                w = w + 1;
            }
            h = h + 1;
        }
        n = n + 1;
    }
    Test.report("test_batchnorm_nhwc", true);
}
