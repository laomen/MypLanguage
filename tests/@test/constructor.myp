// M2+M3: class 构造器绑定 + struct 函数式构造 → @test
// @constructor / 隐式构造器 / 重载 / 数字提升 / 泛型构造器 / struct 函数式构造

import test;

class Window {
    action:
        @constructor
        Window() {
            x = 0; y = 0; w = 80; h = 24;
        }
        void Window(int px, int py, int pw, int ph) {
            x = px; y = py; w = pw; h = ph;
        }
    property:
        int x;
        int y;
        int w;
        int h;
}

class Scale {
    action:
        @constructor
        Scale(double v) { val = v; }
        void Scale() { val = 1.0; }
        double get() { return val; }
    property:
        double val;
}

class Box<T> {
    action:
        @constructor
        Box(T v) { data = v; }
        T get() { return data; }
    property:
        T data;
}

struct Vec2 {
    action:
        @constructor
        Vec2(double px, double py) { x = px; y = py; }
        void Vec2() { x = 0; y = 0; }
        double lenSq() { return x * x + y * y; }
    double x;
    double y;
}

struct Vector3 {
    operator:
        @op("+") Vector3 add(Vector3 other) {
            return Vector3(x_ + other.x_, y_ + other.y_, z_ + other.z_);
        }
    action:
        @constructor
        Vector3(double a, double b, double c) { x_ = a; y_ = b; z_ = c; }
    double x_;
    double y_;
    double z_;
}

Vec2 makeVec(double a, double b) {
    return Vec2(a, b);
}

@test void test_constructor() {
    Window a = new Window();
    Test.assertEq(a.x, 0, "a.x"); Test.assertEq(a.y, 0, "a.y");
    Test.assertEq(a.w, 80, "a.w"); Test.assertEq(a.h, 24, "a.h");

    Window b = new Window(10, 5, 100, 50);
    Test.assertEq(b.x, 10, "b.x"); Test.assertEq(b.y, 5, "b.y");
    Test.assertEq(b.w, 100, "b.w"); Test.assertEq(b.h, 50, "b.h");

    Scale s1 = new Scale();
    Test.assertFloatEq(s1.get(), 1.0, 1e-9, "s1");
    Scale s2 = new Scale(3);           // int→double 提升
    Test.assertFloatEq(s2.get(), 3.0, 1e-9, "s2");

    Box<double> d = new Box<double>(1.5);
    Test.assertFloatEq(d.get(), 1.5, 1e-9, "泛型 double");
    Box<int> i = new Box<int>(7);
    Test.assertEq(i.get(), 7, "泛型 int");

    Vec2 v2 = Vec2(3.0, 4.0);
    Test.assertFloatEq(v2.x, 3.0, 1e-9, "v2.x");
    Vec2 vz = Vec2();
    Test.assertFloatEq(vz.x, 0.0, 1e-9, "vz.x");
    Vec2 w2;
    w2 = Vec2(1.0, 2.0);
    Test.assertFloatEq(w2.x, 1.0, 1e-9, "w2.x");
    Vec2 rv = makeVec(5.0, 6.0);
    Test.assertFloatEq(rv.y, 6.0, 1e-9, "rv.y");

    Vector3 va = Vector3(1, 2, 3);
    Vector3 vb = Vector3(4, 5, 6);
    Vector3 vc = va + vb;
    Test.assertFloatEq(vc.z_, 9.0, 1e-9, "vc.z_");

    Test.report("test_constructor", true);
}
