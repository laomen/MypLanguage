// arc_fn: ARC 闭包释放 → @test
// 闭包入函数值局部释放 / 别名共享 / 捕获 class 引用 / 循环零累积

import test;
import memory;

class Node {
    action:
        int getVal() { return val; }
        void setVal(int v) { val = v; }
    property:
        int val = 0;
}

@test void test_arc_fn() {
    long base = Memory.liveObjectCount();

    // 闭包入函数值局部：作用域退出释放闭包
    {
        (int) -> int f = (int x) => { return x * 2; };
        int r = f(21);
        Test.assertEq(r, 42, "fn_decl r");
    }
    long after_decl = Memory.liveObjectCount() - base;
    Test.assertEq(after_decl, 0, "after_decl=0");

    // 别名：g = f → 两局部共享闭包，各自释放 → 平衡
    {
        (int) -> int f = (int x) => { return x + 1; };
        (int) -> int g = f;
        int r = g(5);
        Test.assertEq(r, 6, "fn_alias r");
    }
    long after_alias = Memory.liveObjectCount() - base;
    Test.assertEq(after_alias, 0, "after_alias=0");

    // 捕获 class 引用：闭包 retain 自己的引用；外层局部释放后闭包仍可调用
    long before_cap = Memory.liveObjectCount();
    int captured_val = -1;
    {
        Node n = new Node();
        n.setVal(77);
        (int) -> int f = (int x) => { return x + n.getVal(); };
        captured_val = f(0);
    }
    long after_cap = Memory.liveObjectCount() - before_cap;
    Test.assertEq(captured_val, 77, "fn_capture val");
    Test.assertEq(after_cap, 0, "after_cap=0");

    // 循环内创建闭包 → 零累积
    for (int i = 0; i < 1000; i = i + 1) {
        (int) -> int f = (int x) => { return x + i; };
    }
    long after_loop = Memory.liveObjectCount() - base;
    Test.assertEq(after_loop, 0, "fn_loop after=0");

    Test.report("test_arc_fn", true);
}
