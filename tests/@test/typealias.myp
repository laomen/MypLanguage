// typealias: `type Name = Type;` 类型别名（§三-4）→ @test
// 覆盖：基本类型别名、别名套别名、定长数组别名、参数/返回/属性/局部变量使用别名
import test;

type MyInt = int;
type MyString = string;
type AliasAlias = MyInt;      // 别名套别名
type Int3 = int[3];           // 定长数组别名

@static class Calc {
    static:
        MyInt add(MyInt a, MyInt b) { return a + b; }
        MyString greet() { return "hi"; }
}

class Holder {
    action:
        void setV(int i, int x) { v[i] = x; }
        int sum() {
            int t = 0;
            for (int i = 0; i < 3; i = i + 1) t = t + v[i];
            return t;
        }
    property:
        Int3 v;
}

@test void test_typealias() {
    MyInt x = 3;
    MyInt y = Calc.add(x, 4);
    MyString s = Calc.greet();
    Holder h = new Holder();
    h.setV(0, 1);
    h.setV(1, 2);
    h.setV(2, 3);
    Test.assertStrEq(s, "hi", "s");
    Test.assertEq(y, 7, "y");
    Test.assertEq(h.sum(), 6, "sum");
    Test.report("test_typealias", true);
}
