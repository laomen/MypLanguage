// mapping where — 条件过滤（只转发 >= 3 的事件）→ @test
// 用输出捕获验证：v=5、v=3 出现，v=2 被过滤

import test;
import env;

mapping() {
    Main.emit where v >= 3 -> Printer.print;
}

class Printer {
    action:
        void print(int v) {
            Console.writeString("v=");
            Console.write(v);
            Console.writeString("\n");
        }
}

class Main {
    action:
        @constructor Main() {
            emit(5);
            emit(2);
            emit(3);
        }
    event:
        emit(int v);
}

@test void test_where_mapping() {
    Test.captureStart();
    Main m = new Main();
    Printer p = new Printer();
    Test.captureEnd();
    Test.assertOutputContains("v=5", "where 转发 5");
    Test.assertOutputContains("v=3", "where 转发 3");
    Test.report("test_where_mapping", true);
}
