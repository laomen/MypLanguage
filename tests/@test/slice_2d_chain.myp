// slice_2d_chain: 调用结果嵌套 slice 双下标 make2d()[i][j] → @test
// 自举缺口（BUG-061，BUG-059 姊妹）：slice<slice<int>> 返回后链式双下标，
// 内层下标 resolve 成 "slice" 但没记 setSliceElem（深层元素）→ 二级 [j] 取不到
// → 报 "expected numeric type, got 'array'"。sema 补 setSliceElem。
// 覆盖：顶层函数返回 2D 链式双下标 / 算术 / 单下标取行 / 方法返回 2D / 变量对照
import test;

slice<slice<int>> make2d(int n) {
    slice<slice<int>> rows = new slice<slice<int>>(n);
    int i = 0;
    while (i < n) {
        slice<int> row = new slice<int>(n);
        int j = 0;
        while (j < n) {
            row[j] = i * n + j;
            j = j + 1;
        }
        rows[i] = row;
        i = i + 1;
    }
    return rows;
}

class Grid {
    action:
        slice<slice<int>> get(int n) {
            return make2d(n);
        }
}

// —— 1) 顶层函数返回 2D：链式双下标 ——
@test void test_chain() {
    Test.assertEq(make2d(4)[2][3], 11, "2D[2][3]");
    Test.assertEq(make2d(4)[0][0], 0, "2D[0][0]");
    Test.assertEq(make2d(4)[3][3], 15, "2D[3][3]");
    Test.assertEq(make2d(5)[4][2], 22, "2D 5x5");
    Test.report("test_chain", true);
}

// —— 2) 链式双下标参与算术 ——
@test void test_arith() {
    Test.assertEq(make2d(4)[1][1] + make2d(4)[3][3], 20, "sum 5+15");
    Test.assertEq(make2d(4)[2][2] * 2, 20, "mul 10*2");
    Test.report("test_arith", true);
}

// —— 3) 单下标返回行（slice<int>），再取元素 ——
@test void test_row() {
    slice<int> row = make2d(4)[2];
    Test.assertEq(row[3], 11, "row[3]");
    Test.assertEq(row[0], 8, "row[0]");
    Test.report("test_row", true);
}

// —— 4) 方法返回 2D：链式双下标 ——
@test void test_method() {
    Grid g = new Grid();
    Test.assertEq(g.get(4)[2][3], 11, "method 2D");
    Test.assertEq(g.get(3)[1][2], 5, "method 3x3");
    Test.report("test_method", true);
}

// —— 5) 变量对照（nested_slice 已覆盖，此处确认调用结果等价）——
@test void test_var() {
    slice<slice<int>> rows = make2d(4);
    Test.assertEq(rows[2][3], 11, "var 2D");
    Test.assertEq(rows[3][3], 15, "var corner");
    Test.report("test_var", true);
}
