// arc_throw: 异常/throw-catch 展开释放 → @test
// throw 离开函数前释放本帧槽；try 内槽 dispatch 释放、外层保留；catch 绑定释放；
// finally 传播；正常 try 不误释放；别名抛出对象

import test;
import memory;
import error;

class Node {
    action:
        void setVal(int v) { val = v; }
        int getVal() { return val; }
    property:
        int val = 0;
}

class MyErr {
    interface class Error;
    action:
        @constructor MyErr() {}
        string message() { return "myerr"; }
}

void throwsOut() {
    Node a = new Node();
    Node b = new Node();
    throw "out";
}

int tryInner() {
    Node outer = new Node();
    try {
        Node inner = new Node();
        throw "boom";
    } catch (string s) {
        return outer.getVal();
    }
    return -1;
}

@test void test_arc_throw() {
    long base = Memory.liveObjectCount();

    // 1) throwsOut → 本帧槽释放，catch 拿消息
    string caught_out = "";
    try { throwsOut(); } catch (string s) { caught_out = s; }
    Test.assertStrEq(caught_out, "out", "catch_out");
    long a1 = Memory.liveObjectCount() - base;
    Test.assertEq(a1, 0, "left1=0");

    // 2) tryInner → 内层槽释放、外层槽保留且正常释放
    int v2 = tryInner();
    Test.assertEq(v2, 0, "outer_alive");
    long a2 = Memory.liveObjectCount() - base;
    Test.assertEq(a2, 0, "left2=0");

    // 3) 具体类 catch：绑定对象在所在块退出时释放
    long b3 = Memory.liveObjectCount();
    string c3 = "";
    {
        try {
            throw new MyErr();
        } catch (MyErr e) {
            c3 = e.message();
        }
    }
    Test.assertStrEq(c3, "myerr", "caught");
    long a3 = Memory.liveObjectCount() - b3;
    Test.assertEq(a3, 0, "left3=0");

    // 4) Error 接口 catch：绑定对象（接口胖指针）块退出时释放
    long b4 = Memory.liveObjectCount();
    string c4 = "";
    {
        try {
            throw new MyErr();
        } catch (Error e) {
            c4 = e.message();
        }
    }
    Test.assertStrEq(c4, "myerr", "iface");
    long a4 = Memory.liveObjectCount() - b4;
    Test.assertEq(a4, 0, "left4=0");

    // 5) finally 传播：无匹配 catch → finally 跑 → 重抛 → 外层 catch
    long b5 = Memory.liveObjectCount();
    int fin_run = 0;
    int recaught = 0;
    {
        try {
            try {
                Node n5 = new Node();
                fin_run = 1;
                throw new MyErr();
            } finally {
                fin_run = fin_run + 1;
            }
        } catch (MyErr e) {
            recaught = 1;
        }
    }
    Test.assertEq(fin_run, 2, "fin_run");
    Test.assertEq(recaught, 1, "recaught");
    long a5 = Memory.liveObjectCount() - b5;
    Test.assertEq(a5, 0, "left5=0");

    // 6) 正常 try 完成：不误释放
    long b0 = Memory.liveObjectCount();
    {
        try {
            Node ok = new Node();
        } catch (string s) { }
    }
    long a6 = Memory.liveObjectCount() - b0;
    Test.assertEq(a6, 0, "left6=0");

    // 7) 别名抛出对象：catch 取到存活对象
    long b7 = Memory.liveObjectCount();
    int alias_val = -1;
    {
        try {
            Node x = new Node();
            x.setVal(42);
            throw x;
        } catch (Node e) {
            alias_val = e.getVal();
        }
    }
    Test.assertEq(alias_val, 42, "alias_throw");
    long a7 = Memory.liveObjectCount() - b7;
    Test.assertEq(a7, 0, "left7=0");

    // 8) 全量回到基线
    long a8 = Memory.liveObjectCount() - base;
    Test.assertEq(a8, 0, "left8=0");

    Test.report("test_arc_throw", true);
}
