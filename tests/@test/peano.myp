// peano: 皮亚诺算术（递归 class 表示自然数）→ 移植自 go/test/peano.go
// 覆盖：递归引用类（property 指向自身类型）、null 哨兵（zero）、
//       深递归 add/mul/fact、class 实例的 ARC 释放、count 计数
// 期望：add/mul/fact 结果与 Go 测试一致（0/1/3/4/7/12/.../120）
import test;

// Go 里是 `type Number *Number`（递归指针）；MYP 用递归 class 引用（可空）。
class Number {
    action:
        @constructor Number(Number n) { next = n; }
        Number getNext() { return next; }
    property:
        Number next;
}

Number zero() { return null; }
bool is_zero(Number x) { return x == null; }
Number add1(Number x) { return new Number(x); }
Number sub1(Number x) { return x.getNext(); }

Number add(Number x, Number y) {
    if (is_zero(y)) return x;
    return add(add1(x), sub1(y));
}
Number mul(Number x, Number y) {
    if (is_zero(x) || is_zero(y)) return zero();
    return add(mul(x, sub1(y)), x);
}
Number fact(Number n) {
    if (is_zero(n)) return add1(zero());
    return mul(fact(sub1(n)), n);
}

Number gen(int n) {
    if (n > 0) return add1(gen(n - 1));
    return zero();
}
int count(Number x) {
    if (is_zero(x)) return 0;
    return count(sub1(x)) + 1;
}

void check(Number x, int expected, string tag) {
    int c = count(x);
    Test.assertEq(c, expected, tag);
}

@test void test_peano() {
    // 基本
    check(zero(), 0, "zero");
    check(add1(zero()), 1, "add1 zero");
    check(gen(10), 10, "gen 10");

    // add
    check(add(gen(3), zero()), 3, "add g3 0");
    check(add(zero(), gen(4)), 4, "add 0 g4");
    check(add(gen(3), gen(4)), 7, "add g3 g4");

    // mul
    check(mul(zero(), zero()), 0, "mul 0 0");
    check(mul(gen(3), zero()), 0, "mul g3 0");
    check(mul(zero(), gen(4)), 0, "mul 0 g4");
    check(mul(gen(3), add1(zero())), 3, "mul g3 1");
    check(mul(add1(zero()), gen(4)), 4, "mul 1 g4");
    check(mul(gen(3), gen(4)), 12, "mul g3 g4");

    // fact（0!..5!，对应 Go 的 results 表）
    check(fact(zero()), 1, "fact 0");
    check(fact(add1(zero())), 1, "fact 1");
    check(fact(gen(5)), 120, "fact 5");

    Test.report("test_peano", true);
}
