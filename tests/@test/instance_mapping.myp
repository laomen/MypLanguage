// 实例级 mapping（函数内局部）→ @test

import test;
import env;

class Printer {
    action:
        void print(int v) {
            Console.writeString("v=");
            Console.write(v);
            Console.writeString("\n");
        }
}

class Main {
    action:
        @constructor Main() {
            Printer p;
            mapping() {
                Main.fire -> Printer.print;
            }
            fire(42);
            fire(99);
        }
    event:
        fire(int v);
}

@test void test_instance_mapping() {
    Test.captureStart();
    Main m = new Main();
    Printer p2;
    Test.captureEnd();
    Test.assertOutputContains("v=42", "fire 42");
    Test.assertOutputContains("v=99", "fire 99");
    Test.report("test_instance_mapping", true);
}
