// 管道 (|>) 回归测试 — 算子组件流水线
// 设计规范见 docs/operators.md (P3)
// 验证: 实例管道 / 类名实例化 / 左结合链式

import env;
import setops;

class ScaleOp {
    interface class SetOp;
    action:
        void setK(double k) { k_ = k; }
        double[] transform(double[] A) {
            int n = 4;
            double[] B = new double[n];
            int i = 0; while (i < n) { B[i] = A[i] * k_; i = i + 1; }
            return B;
        }
    property:
        double k_ = 1.0;
}

class OffsetOp {
    interface class SetOp;
    action:
        double[] transform(double[] A) {
            int n = 4;
            double[] B = new double[n];
            int i = 0; while (i < n) { B[i] = A[i] + 1.0; i = i + 1; }
            return B;
        }
}

class Main {
    action:
        @startup void run() {
            Console.writeString("[管道测试]\n");

            double[] A = new double[4];
            int i = 0; while (i < 4) { A[i] = i * 1.0; i = i + 1; }   // [0,1,2,3]

            // 1) 实例管道: A |> scale  = A*2 → [0,2,4,6]
            ScaleOp scale = new ScaleOp();
            scale.setK(2.0);
            double[] B = A |> scale;
            Console.writeString("A|>scale = [");
            i = 0; while (i < 4) { Console.writeFloat(B[i]); if (i < 3) Console.writeString(","); i = i + 1; }
            Console.writeString("]\n");

            // 2) 类名实例化: A |> ScaleOp (新实例)
            double[] C = A |> ScaleOp;
            Console.writeString("A|>ScaleOp = [");
            i = 0; while (i < 4) { Console.writeFloat(C[i]); if (i < 3) Console.writeString(","); i = i + 1; }
            Console.writeString("]\n");

            // 3) 链式: A |> scale |> off  = (A*2)+1 → [1,3,5,7]
            OffsetOp off = new OffsetOp();
            double[] D = A |> scale |> off;
            Console.writeString("A|>scale|>off = [");
            i = 0; while (i < 4) { Console.writeFloat(D[i]); if (i < 3) Console.writeString(","); i = i + 1; }
            Console.writeString("]\n");
        }
}
int main() { Main m = new Main(); return 0; }
