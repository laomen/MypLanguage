// BUG-031 复现：跨线程多 @thread 目标事件无限重投
// ---------------------------------------------------------------------------
// mapping 把同一事件路由到多个 @thread 目标（AppA/AppB 各在独立线程）时，
// 事件被无限重复投递（各目标收到 5 万+ 次），正常应各收到 1 次。
// 运行（预期挂起/超时）：./build/mypc tests/known_bugs/cross_thread_multi_target.myp
//   -o /tmp/cross_thread_multi_target && timeout 3 /tmp/cross_thread_multi_target
//   （输出 A recv 7 / B recv 7 大量重复）
// 对照组（正常）：非 @thread 目标（同线程）各收 1 次；单 @thread 目标正常。
import env;
import fmt;
import timeline;

class Svc {
    event: Life(int v);
    action:
        void onC(int seq, int op, int v) { Life(v); }
}

class AppA {
    action: void onLife(int v) { Console.writeLine("A recv " + Fmt.i(v)); }
}

class AppB {
    action: void onLife(int v) { Console.writeLine("B recv " + Fmt.i(v)); }
}

mapping() {
    Driver.Cmd -> Svc.onC;
    Svc.Life -> AppA.onLife;
    Svc.Life -> AppB.onLife;
}

class Driver {
    event: Cmd(int seq, int op, int v);
    action: void go(int v) { Cmd(2, 1, v); }
}

class Boot {
    action:
        @constructor Boot() {
            Svc svc = new Svc() @thread;
            AppA a = new AppA() @thread;
            AppB b = new AppB() @thread;
            Driver d = new Driver();
            Timeline tl = new Timeline();
            tl.sleep(50);
            d.go(7);
            tl.sleep(100);
            Console.writeLine("done");
        }
}

int main() { Boot bb = new Boot(); return 0; }
