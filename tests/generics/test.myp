// 泛型验证 (Monomorphization)
import env;

class Box<T> {
    action:
        void set(T val) { value = val; }
        T get() { return value; }
    property:
        T value;
}

class Main {
    action:
        @constructor Main() {
            Console.writeString("[泛型验证]\n");

            Box<int> bi = new Box<int>();
            bi.set(42);
            int vi = bi.get();
            Console.writeString("  Box<int>: "); Console.write(vi); Console.writeString("\n");

            Box<double> bd = new Box<double>();
            bd.set(3.14);
            double vd = bd.get();
            Console.writeString("  Box<double>: "); Console.writeFloat(vd); Console.writeString("\n");

            Console.writeString("[OK] 泛型验证通过\n");
        }
}

int main(){Main m=new Main();return 0;}
