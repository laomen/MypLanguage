// BUG-020 复现：class 含泛型类属性（Option/ArrayList 等）时，方法内 `this.prop`
// 在 sema 被解析为「泛型实例类」→ `class 'Option_int_inst' has no member 'v'`
// （读和写都受影响；struct 泛型字段不受影响）。
import test;
import option;

class H {
    action:
        void setV(int s) { this.v = s; }
        int getV() { return this.v; }
    property:
        int v;
        Option<int> o;
}

@test void t() {
    H h = new H();
    h.setV(5);
    Test.assertEq(h.getV(), 5);
}
