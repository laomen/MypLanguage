// BUG-003: 泛型函数/方法 T=string 时，< > 比较按指针而非内容（结果依赖内存布局）
// 复现：tests/generic_traits 回归失败（`s=b` 实得 `s=a`，`Util.clamp("b","a","c")`）。
// 根因：泛型实例化为 string 时，string < > 未走 myp_str_cmp（按内容），退化为按
//       指针地址比较 → 同一逻辑调用在不同文件/字面量布局下结果不同；本文件稳定失败。
// 对照：非泛型 string 比较恒正确（myp_str_cmp 路径，probe p25 10/10 绿）。
// 当前状态: 🟥 未修复 —— 本文件断言稳定失败（min/clamp 返回错误分支）。
// 修复后: 本文件全部转绿，exit 0；tests/generic_traits 回归同时转绿。
import test;

T min<T where T : Ordered>(T a, T b) { if (a < b) return a; return b; }

class Util {
    static:
        T clamp<T where T : Ordered>(T v, T lo, T hi) {
            if (v < lo) return lo;
            if (v > hi) return hi;
            return v;
        }
}

@test void test_generic_string_cmp() {
    // 泛型 T=string 比较（bug 路径）：结果依赖字面量内存布局，本文件稳定失败
    Test.assertStrEq(min("b", "a"), "a", "min lit b,a");
    Test.assertStrEq(min("a", "b"), "a", "min lit a,b");
    Test.assertStrEq(Util.clamp("b", "a", "c"), "b", "clamp lit mid");
    Test.assertStrEq(Util.clamp("z", "a", "c"), "c", "clamp lit hi");

    // 变量实参（同样可被指针比较影响 → 也可能失败）
    string p = "b"; string q = "a"; string r = "c";
    Test.assertStrEq(min(p, q), "a", "min var b,a");
    Test.assertStrEq(Util.clamp(p, q, r), "b", "clamp var mid");
    Test.report("test_generic_string_cmp", true);
}
