// BUG-024 复现：同一文件经不同相对路径（含 `..`）导入不去重 → duplicate 声明
//   main 直接 import "./helper.myp" 且 import "./sub/sub.myp"（sub 内部
//   import "../helper.myp" 同一文件）→ normalizePath 不解析 `..`，两个路径
//   规范化后不同（/mod/helper.myp vs /mod/sub/../helper.myp）→ 双重载入 →
//   duplicate class name / duplicate function name。
import test;
import "./helper.myp";       // 直接相对导入
import "./sub/sub.myp";      // 递归导入同一文件（经 ../helper.myp）

@test void t() {
    Helper h;
    Test.assertEq(h.twice(5), 10, "helper");
    Sub s;
    Test.assertEq(s.useHelper(3), 6, "sub 内递归 helper");
}
