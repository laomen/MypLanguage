// M2 — 泛型约束（where T : Interface）
// 正例：DrawList<Circle> 满足 `T where T : Shape`
import env;

interface Shape {
    int area();
}

class Circle {
    interface class Shape;
    action:
        int area() { return radius * radius; }
    property:
        int radius;
}

class DrawList<T where T : Shape> {
    action:
        int count() { return 0; }
}

class Main {
    action:
        @startup void run() {
            DrawList<Circle> dl = new DrawList<Circle>();
            Console.writeString("generic constraint OK count=");
            Console.write(dl.count());
            Console.writeString("\n");
        }
}

int main(){ Main m = new Main(); return 0; }
