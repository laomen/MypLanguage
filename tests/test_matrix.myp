// Test Matrix (flat row-major) operations
import env;
import math;
import cuda;

class Tester {
    action:
        @startup void go() {
            long rows = 4L;
            long cols = 4L;
            long total = rows * cols;
            double[] a = new double[total];
            double[] b = new double[total];
            double[] c = new double[total];
            for (long i = 0L; i < total; i = i + 1L) { a[i] = 1.0; b[i] = 2.0; c[i] = 9.0; }

            Matrix.add(a, b, c, rows, cols);
            Console.writeLine("add[0]=" + c[0] + " (expect 3)");
            Console.writeLine("add[15]=" + c[15] + " (expect 3)");

            Matrix.sub(a, b, c, rows, cols);
            Console.writeLine("sub[0]=" + c[0] + " (expect -1)");

            Matrix.mul(a, b, c, rows, cols);
            Console.writeLine("mul[0]=" + c[0] + " (expect 2)");

            Matrix.scale(a, 5.0, rows, cols);
            Console.writeLine("scale[0]=" + a[0] + " (expect 5)");

            Matrix.fill(c, 7.0, rows, cols);
            Console.writeLine("fill[0]=" + c[0] + " (expect 7)");

            // transpose: 2x3 A → 3x2 T
            double[] A = new double[6];
            double[] T = new double[6];
            for (long i = 0L; i < 6L; i = i + 1L) A[i] = i;
            Matrix.transpose(A, T, 2L, 3L);
            // A = [0 1 2; 3 4 5], T = [0 3; 1 4; 2 5]
            Console.writeLine("transpose[0]=" + T[0] + " (expect 0)");
            Console.writeLine("transpose[1]=" + T[1] + " (expect 3)");
            Console.writeLine("transpose[3]=" + T[3] + " (expect 4)");
            Console.writeLine("transpose[5]=" + T[5] + " (expect 5)");

            long err = 0L;
            if (Math.abs(c[0] - 7.0) > 0.0001) err = err + 1L;
            if (Math.abs(a[0] - 5.0) > 0.0001) err = err + 1L;
            Console.writeLine("matrix test: " + (err == 0L ? "PASS" : "FAIL"));
        }
}

int main() {
    Tester t = new Tester();
    return 0;
}
