// function: section — internal methods
import env;

class Calculator {
    action:
        int compute(int n) {
            return helper(n) + 1;
        }
    function:
        int helper(int n) {     // not part of event system
            return n * n;
        }
}

class Main {
    action:
        @startup void run() {
            Calculator c = new Calculator();
            int r = c.compute(5);
            Console.writeString("result="); Console.write(r);
            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    Calculator c2;
    return 0;
}
