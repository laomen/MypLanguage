// P2/P0 §5.1：bit + bitvector<N> 核心（索引/位运算/与 uint 互转）。
// bitvector<N> 底层 = LLVM iN（N=8/16/32/64），bitvector<8> 即 u8 位视图。
import env;

class Main {
    action:
        @startup void run() {
            // ---- bit：bit(x) = x≠0 ----
            bit b1 = bit(7);
            bit b2 = bit(0);
            bit b3 = bit(0.0);
            bit b4 = bit(2.5);
            Console.writeBool(b1);
            Console.writeString("\n");
            Console.writeBool(b2);
            Console.writeString("\n");
            Console.writeBool(b3);
            Console.writeString("\n");
            Console.writeBool(b4);
            Console.writeString("\n");
            // bool→bit 隐式；bit→bool 隐式；!bit
            bit b5 = true;
            Console.writeBool(b5);
            Console.writeString("\n");
            bool bb = b1;
            Console.writeBool(bb);
            Console.writeString("\n");
            Console.writeBool(!b2);
            Console.writeString("\n");
            // bit 进布尔上下文
            Console.writeBool(b1 && !b2);
            Console.writeString("\n");
            Console.writeBool(b2 || b1);
            Console.writeString("\n");
            // bit → int = 0/1
            Console.writeLong(int(b1));
            Console.writeString("\n");
            Console.writeLong(int(b2));
            Console.writeString("\n");

            // ---- bitvector<N>：声明 + 转换 ----
            bitvector<8> v8 = bitvector<8>(0xB5);       // 1011 0101
            bitvector<32> v32 = bitvector<32>(0xDEADBEEF);
            // bitvector<N>(uint) 位保持
            Console.writeLong(uint(v32));               // 3735928559
            Console.writeString("\n");
            // uint(bv) 直通（零扩展）
            Console.writeLong(uint(v8));                // 181
            Console.writeString("\n");
            // byte(bv) 取低 8 位
            Console.writeLong(byte(v8));                // -75（0xB5 有符号 i8）
            Console.writeString("\n");
            // 16/64 位
            bitvector<16> v16 = bitvector<16>(0xCAFE);
            Console.writeLong(uint(v16));               // 51966
            Console.writeString("\n");
            bitvector<64> v64 = bitvector<64>(0x1122334455667788L);
            Console.writeLong(uint(v64));               // 0x55667788 截断 → 1432778632
            Console.writeString("\n");

            // ---- 索引 v[i] : bit ----
            Console.writeBool(v8[0]);   // 1
            Console.writeString("\n");
            Console.writeBool(v8[1]);   // 0
            Console.writeString("\n");
            Console.writeBool(v8[7]);   // 1
            Console.writeString("\n");
            Console.writeBool(v8[2]);   // 1
            Console.writeString("\n");

            // ---- 位运算 & | ^ << >> ----
            bitvector<8> m = bitvector<8>(0x0F);
            Console.writeLong(uint(v8 & m));    // 0x05 = 5
            Console.writeString("\n");
            Console.writeLong(uint(v8 | m));    // 0xBF = 191
            Console.writeString("\n");
            Console.writeLong(uint(v8 ^ m));    // 0xBA = 186
            Console.writeString("\n");
            Console.writeLong(uint(v8 << 2));   // 0xD4 = 212
            Console.writeString("\n");
            Console.writeLong(uint(v8 >> 3));   // 0x16 = 22
            Console.writeString("\n");

            // ---- == / != ----
            Console.writeBool(v8 == v8);
            Console.writeString("\n");
            Console.writeBool(v8 == m);
            Console.writeString("\n");
            Console.writeBool(v8 != m);
            Console.writeString("\n");

            // ---- 组合：位视图读写常用模式 ----
            bitvector<8> flags = bitvector<8>(0);
            flags = flags | bitvector<8>(1 << 3);   // 置位 bit3
            Console.writeBool(flags[3]);
            Console.writeString("\n");
            Console.writeBool(flags[0]);
            Console.writeString("\n");
            Console.writeLong(uint(flags));          // 8
            Console.writeString("\n");

            // ---- §5.1 补全：~ 一元取反 ----
            Console.writeLong(~0);                   // -1
            Console.writeString("\n");
            Console.writeLong(~0x0F);                // -16
            Console.writeString("\n");
            Console.writeLong(uint(~v8));            // ~0x5A... v8=0xB5 → ~0xB5&0xFF=0x4A=74
            Console.writeString("\n");
            bitvector<32> inv32 = bitvector<32>(0x0F0F0F0F);
            Console.writeLong(uint(~inv32));         // 0xF0F0F0F0 = 4042322160
            Console.writeString("\n");

            // ---- §5.1 补全：写索引 v[i] = x（读-改-写）----
            bitvector<8> f = bitvector<8>(0);
            f[0] = true;
            f[3] = true;
            f[7] = true;
            Console.writeBool(f[0]);                 // true
            Console.writeString("\n");
            Console.writeBool(f[3]);                 // true
            Console.writeString("\n");
            Console.writeBool(f[1]);                 // false
            Console.writeString("\n");
            Console.writeLong(uint(f));              // 0b10001001 = 0x89 = 137
            Console.writeString("\n");
            f[0] = false;
            Console.writeLong(uint(f));              // 0x88 = 136
            Console.writeString("\n");
            // ~ 与索引组合
            Console.writeBool((~f)[7]);              // ~0x88=0x77, bit7=0 → false
            Console.writeString("\n");

            Console.writeString("BITVECTOR_OK\n");
        }
}
int main() {
    Main m = new Main() @thread;
    return 0;
}
