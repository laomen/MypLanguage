// float type (32-bit) — limited support, use double for general purpose
import env;

class Main {
    action:
        @startup void run() {
            // float can be declared and used from function returns
            float a = 0;
            Console.writeString("float_exists=yes\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
