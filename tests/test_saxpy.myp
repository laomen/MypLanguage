// Minimal: just saxpy + copy
import env;
import math;
import cuda;

class Tester {
    action:
        @startup void go() {
            long n = 64L;
            double[] x = new double[n];
            double[] y = new double[n];
            double[] out = new double[n];
            for (long i = 0L; i < n; i = i + 1L) { x[i] = 1.0; y[i] = 2.0; out[i] = 9.0; }

            Vectors.saxpy(3.0, x, y, out, n);
            Console.writeLine("saxpy[0]=" + out[0] + " (expect 5)");
            Console.writeLine("saxpy[5]=" + out[5] + " (expect 5)");

            Vectors.copy(x, y, n);
            Console.writeLine("copy[0]=" + x[0] + " (expect 2)");

            double s = Vectors.sum(out, n);
            Console.writeLine("sum=" + s + " (expect " + (5.0 * n) + ")");
        }
}

int main() {
    Tester t = new Tester();
    return 0;
}
