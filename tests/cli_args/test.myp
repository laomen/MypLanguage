// 命令行参数验证
// 验证：main(int argc, string[] argv) 参数传递
// 用编译时参数测试

import env;

class Main {
    action:
        @startup void run() {
            __myp_print("[命令行参数验证]\n");
            __myp_print("  此测试验证 main(argc, argv) 语法编译通过\n");
            __myp_print("  编译: OK\n");
            __myp_print("[OK] main(argc, argv) 验证通过\n");
        }
}

int main(int argc, string[] argv) {
    // argc/argv 直接来自 C 运行时
    // 单元测试只验证编译通过和链接正确
    Main m = new Main();
    return 0;
}
