// 异常处理测试 (try/catch + __myp_throw)
import env;
import error;

// 子函数 throw → 父 catch（跨函数 longjmp）
void risky() {
    Console.writeString("risky_enter\n");
    __myp_throw("deep_error");
}

// 对象异常（标准异常来自 stdlib/error.myp：FileError/ParseError 等）

class Main {
    action:
        @startup void run() {
            // 1. try 无异常
            try {
                Console.writeString("try_ok\n");
            } catch (string e) {
                Console.writeString("should_not_catch\n");
            }
            Console.writeString("after_try_ok\n");

            // 2. try 捕获 throw
            try {
                __myp_throw("error!");
                Console.writeString("should_not_reach\n");
            } catch (string e) {
                Console.writeString("caught=");
                Console.writeString(e);
                Console.writeString("\n");
            }
            Console.writeString("after_catch\n");

            // 3. try/finally (无 catch)
            try {
                Console.writeString("try_finally\n");
            } finally {
                Console.writeString("finally_ok\n");
            }

            // 4. 嵌套 try：内层 throw → 内层 catch（近者捕获）
            try {
                Console.writeString("nest_outer_try\n");
                try {
                    __myp_throw("inner_err");
                } catch (string e) {
                    Console.writeString("nest_inner_caught=");
                    Console.writeString(e);
                    Console.writeString("\n");
                }
                Console.writeString("nest_outer_continue\n");
            } catch (string e) {
                Console.writeString("nest_outer_caught\n");
            }

            // 5. 内层 try 正常结束 → 外层 throw → 外层 catch（回归：曾死循环）
            try {
                Console.writeString("stale_outer_try\n");
                try {
                    Console.writeString("stale_inner_ok\n");
                } catch (string e) {
                    Console.writeString("stale_inner_catch\n");
                }
                __myp_throw("stale_outer_err");
            } catch (string e) {
                Console.writeString("stale_outer_caught=");
                Console.writeString(e);
                Console.writeString("\n");
            }

            // 6. 跨函数 throw：子函数 throw → 父 catch
            try {
                Console.writeString("cross_outer_try\n");
                risky();
                Console.writeString("cross_outer_after\n");
            } catch (string e) {
                Console.writeString("cross_caught=");
                Console.writeString(e);
                Console.writeString("\n");
            }

            // 7. 对象异常：typed catch 分发
            try {
                FileError f = new FileError();
                f.setPath("cfg.myp");
                throw f;
            } catch (FileError e) {
                Console.writeString("obj_file=");
                Console.writeString(e.message());
                Console.writeString("\n");
            } catch (ParseError e) {
                Console.writeString("obj_parse\n");
            } catch (e) {
                Console.writeString("obj_other\n");
            }

            // 8. 对象异常 → 第二个 catch
            try {
                ParseError p = new ParseError();
                p.setLine(42);
                throw p;
            } catch (FileError e) {
                Console.writeString("obj_wrong\n");
            } catch (ParseError e) {
                Console.writeString("obj_parse=");
                Console.writeString(e.message());
                Console.writeString("\n");
            }

            // 9. rethrow：内层不匹配 → 外层捕获
            try {
                try {
                    ParseError p = new ParseError();
                    p.setLine(7);
                    throw p;
                } catch (FileError e) {
                    Console.writeString("obj_inner_wrong\n");
                }
                Console.writeString("obj_inner_continue\n");
            } catch (ParseError e) {
                Console.writeString("obj_rethrow=");
                Console.writeString(e.message());
                Console.writeString("\n");
            } catch (e) {
                Console.writeString("obj_rethrow_catchall\n");
            }

            // 10. throw string → catch (e) 兜底
            try {
                throw "simple_err";
            } catch (FileError e) {
                Console.writeString("obj_wrong2\n");
            } catch (e) {
                Console.writeString("obj_catchall=");
                Console.writeString(e);
                Console.writeString("\n");
            }

            // 11. finally 传播：无 catch 时异常也执行 finally 再 rethrow
            try {
                try {
                    throw "fin_prop";
                } finally {
                    Console.writeString("fin_inner\n");
                }
                Console.writeString("fin_after\n");
            } catch (e) {
                Console.writeString("fin_outer=");
                Console.writeString(e);
                Console.writeString("\n");
            }

            // 12. catch (Error e) 接口匹配：FileError 命中，e.message() 接口分发
            try {
                throw new FileError();
            } catch (Error e) {
                Console.writeString("iface_file=");
                Console.writeString(e.message());
                Console.writeString("\n");
            }

            // 13. catch (Error e) 接口匹配：ParseError 命中
            try {
                throw new ParseError();
            } catch (Error e) {
                Console.writeString("iface_parse=");
                Console.writeString(e.message());
                Console.writeString("\n");
            }

            // 14. string 异常不匹配 catch (Error e) → 落到 catch (e)
            try {
                throw "iface_str";
            } catch (Error e) {
                Console.writeString("iface_wrong\n");
            } catch (e) {
                Console.writeString("iface_catchall=");
                Console.writeString(e);
                Console.writeString("\n");
            }

            // 15. 顺序：具体类优先于 Error 接口
            try {
                throw new ParseError();
            } catch (FileError e) {
                Console.writeString("iface_ord_wrong\n");
            } catch (Error e) {
                Console.writeString("iface_ord=");
                Console.writeString(e.message());
                Console.writeString("\n");
            }

            // 16. 标准异常 IOError：精确匹配 + message 聚合
            try {
                IOError e = new IOError();
                e.setOp("write");
                e.setDetail("disk full");
                throw e;
            } catch (IOError e) {
                Console.writeString("std_io=");
                Console.writeString(e.message());
                Console.writeString("\n");
            }

            // 17. 标准异常 NetError：int 属性参与 message
            try {
                NetError e = new NetError();
                e.setOp("connect");
                e.setHost("10.0.0.1");
                e.setPort(8080);
                throw e;
            } catch (NetError e) {
                Console.writeString("std_net=");
                Console.writeString(e.message());
                Console.writeString("\n");
            }

            // 18. 标准异常 JsonError + ArgumentError
            try {
                JsonError e = new JsonError();
                e.setLine(3);
                e.setCol(7);
                e.setDetail("unexpected token");
                throw e;
            } catch (JsonError e) {
                Console.writeString("std_json=");
                Console.writeString(e.message());
                Console.writeString("\n");
            }
            try {
                ArgumentError e = new ArgumentError();
                e.setArg("n");
                e.setDetail("must be positive");
                throw e;
            } catch (ArgumentError e) {
                Console.writeString("std_arg=");
                Console.writeString(e.message());
                Console.writeString("\n");
            }

            // 19. 标准异常 MathError + IndexError
            try {
                MathError e = new MathError();
                e.setOp("div");
                e.setDetail("by zero");
                throw e;
            } catch (MathError e) {
                Console.writeString("std_math=");
                Console.writeString(e.message());
                Console.writeString("\n");
            }
            try {
                IndexError e = new IndexError();
                e.setIndex(5);
                e.setSize(3);
                throw e;
            } catch (IndexError e) {
                Console.writeString("std_idx=");
                Console.writeString(e.message());
                Console.writeString("\n");
            }

            // 20. catch (Error e) 统一捕获标准异常（接口分发 message）
            try {
                NetError e = new NetError();
                e.setOp("send");
                e.setHost("example.com");
                e.setPort(443);
                throw e;
            } catch (Error e) {
                Console.writeString("std_iface=");
                Console.writeString(e.message());
                Console.writeString("\n");
            }

            // 21. FileError 精确 vs Error 兜底顺序
            try {
                FileError e = new FileError();
                e.setOp("open");
                e.setPath("/no/such/file");
                throw e;
            } catch (IOError e) {
                Console.writeString("std_wrong\n");
            } catch (FileError e) {
                Console.writeString("std_file=");
                Console.writeString(e.message());
                Console.writeString("\n");
            }
            Console.writeString("done\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
