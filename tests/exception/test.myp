// 异常处理测试 (try/catch + __myp_throw)
import env;
import error;

// 子函数 throw → 父 catch（跨函数 longjmp）
void risky() {
    Console.writeString("risky_enter\n");
    __myp_throw("deep_error");
}

// 对象异常（实现 Error 接口）
class FileError {
    interface class Error;
    action:
        string message() { return "file: " + path_; }
        void setPath(string p) { path_ = p; }
    property:
        string path_;
}
class ParseError {
    interface class Error;
    action:
        string message() { return "parse: " + line_; }
        void setLine(int l) { line_ = l; }
    property:
        int line_;
}

class Main {
    action:
        @startup void run() {
            // 1. try 无异常
            try {
                Console.writeString("try_ok\n");
            } catch (string e) {
                Console.writeString("should_not_catch\n");
            }
            Console.writeString("after_try_ok\n");

            // 2. try 捕获 throw
            try {
                __myp_throw("error!");
                Console.writeString("should_not_reach\n");
            } catch (string e) {
                Console.writeString("caught=");
                Console.writeString(e);
                Console.writeString("\n");
            }
            Console.writeString("after_catch\n");

            // 3. try/finally (无 catch)
            try {
                Console.writeString("try_finally\n");
            } finally {
                Console.writeString("finally_ok\n");
            }

            // 4. 嵌套 try：内层 throw → 内层 catch（近者捕获）
            try {
                Console.writeString("nest_outer_try\n");
                try {
                    __myp_throw("inner_err");
                } catch (string e) {
                    Console.writeString("nest_inner_caught=");
                    Console.writeString(e);
                    Console.writeString("\n");
                }
                Console.writeString("nest_outer_continue\n");
            } catch (string e) {
                Console.writeString("nest_outer_caught\n");
            }

            // 5. 内层 try 正常结束 → 外层 throw → 外层 catch（回归：曾死循环）
            try {
                Console.writeString("stale_outer_try\n");
                try {
                    Console.writeString("stale_inner_ok\n");
                } catch (string e) {
                    Console.writeString("stale_inner_catch\n");
                }
                __myp_throw("stale_outer_err");
            } catch (string e) {
                Console.writeString("stale_outer_caught=");
                Console.writeString(e);
                Console.writeString("\n");
            }

            // 6. 跨函数 throw：子函数 throw → 父 catch
            try {
                Console.writeString("cross_outer_try\n");
                risky();
                Console.writeString("cross_outer_after\n");
            } catch (string e) {
                Console.writeString("cross_caught=");
                Console.writeString(e);
                Console.writeString("\n");
            }

            // 7. 对象异常：typed catch 分发
            try {
                FileError f = new FileError();
                f.setPath("cfg.myp");
                throw f;
            } catch (FileError e) {
                Console.writeString("obj_file=");
                Console.writeString(e.message());
                Console.writeString("\n");
            } catch (ParseError e) {
                Console.writeString("obj_parse\n");
            } catch (e) {
                Console.writeString("obj_other\n");
            }

            // 8. 对象异常 → 第二个 catch
            try {
                ParseError p = new ParseError();
                p.setLine(42);
                throw p;
            } catch (FileError e) {
                Console.writeString("obj_wrong\n");
            } catch (ParseError e) {
                Console.writeString("obj_parse=");
                Console.writeString(e.message());
                Console.writeString("\n");
            }

            // 9. rethrow：内层不匹配 → 外层捕获
            try {
                try {
                    ParseError p = new ParseError();
                    p.setLine(7);
                    throw p;
                } catch (FileError e) {
                    Console.writeString("obj_inner_wrong\n");
                }
                Console.writeString("obj_inner_continue\n");
            } catch (ParseError e) {
                Console.writeString("obj_rethrow=");
                Console.writeString(e.message());
                Console.writeString("\n");
            } catch (e) {
                Console.writeString("obj_rethrow_catchall\n");
            }

            // 10. throw string → catch (e) 兜底
            try {
                throw "simple_err";
            } catch (FileError e) {
                Console.writeString("obj_wrong2\n");
            } catch (e) {
                Console.writeString("obj_catchall=");
                Console.writeString(e);
                Console.writeString("\n");
            }
            Console.writeString("done\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
