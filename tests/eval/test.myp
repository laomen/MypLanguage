// M1 — @eval 编译期求值 + 顶层 const 折叠
import env;

// @eval 纯函数：递归斐波那契，编译期求值
@eval int fib(int n) {
    if (n < 2) return n;
    return fib(n - 1) + fib(n - 2);
}

// @eval 函数互调 + 编译期常量引用
@eval int triple(int n) {
    return 3 * n;
}

// 编译期常量：const 初始化在编译期求值
const int FIB10 = fib(10);        // 55
const int FIB20 = fib(20);        // 6765
const double HALF = 10.0 / 4;     // 2.5
const bool BIG = FIB10() > 50;    // 引用前一个 const（FIB10() 调用）
const int T5 = triple(FIB10());   // @eval 互调 + const 引用参数 → 165
const long BIGL = 100000L * 10L;  // 1000000

class Main {
    action:
        @constructor void run() {
            Console.writeString("FIB10=");
            Console.write(FIB10());
            Console.writeString(" FIB20=");
            Console.write(FIB20());
            Console.writeString("\nHALF=");
            Console.writeFloat(HALF());
            Console.writeString(" BIG=");
            Console.writeBool(BIG());
            Console.writeString(" T5=");
            Console.write(T5());
            Console.writeString(" BIGL=");
            Console.writeLong(BIGL());
            Console.writeString("\n");
        }
}

int main(){ Main m = new Main(); return 0; }
