// option: Option<T> 可空值容器 + `T?` 语法糖（§三-1，additive）
import env;
import option;

@static class T {
    static:
        int run() {
            // none / some + 门控访问
            Option<int> none = new Option<int>();
            Option<int> some = new Option<int>(42);
            if (none.isNone() && some.isSome()) Console.writeString("ok1");
            else Console.writeString("bad1");
            Console.writeString(" get=" + some.get());
            // getOr 安全默认值
            Console.writeString(" noneOr=" + none.getOr(7) + " someOr=" + some.getOr(7));
            // set/clear 变异
            none.set(5);
            if (none.isSome()) Console.writeString(" set=" + none.get());
            none.clear();
            if (none.isNone()) Console.writeString(" cleared");
            // 字符串 Option
            Option<string> s = new Option<string>("hi");
            Console.writeString(" s=" + s.getOr("default"));
            // `T?` 语法糖 ≡ Option<T>（类型位置；new 用显式 Option<T>(...)）
            int? n = new Option<int>();
            int? v = new Option<int>(99);
            if (n.isNone() && v.isSome()) Console.writeString(" sugar=" + v.get());
            string? sv = new Option<string>("world");
            Console.writeString(" " + sv.get());
            Console.writeString("\n");
            return 0;
        }
}

int pmRun() { return T.run(); }
int main() { int c = pmRun(); return c; }
