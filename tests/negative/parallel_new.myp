// Negative: class allocation inside @gpu for body.
// The GPU kernel path (NVPTX) has no host heap — `new` is rejected at compile
// time. (@parallel for, a CPU thread-pool body, DOES support `new` since
// v3.13.x.)
import env;
import gpu;

class Node {
    property:
        int val = 0;
}

class Main {
    action:
        @startup void run() {
            int n = 8;
            @gpu for (int i = 0; i < n; i = i + 1) {
                // ERROR: 'new' not supported inside @gpu for body
                Node t = new Node();
                t.val = i;
            }
        }
}

int main(){ Main m = new Main() @thread; return 0; }
