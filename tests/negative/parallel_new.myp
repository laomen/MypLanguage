// Negative: @parallel for body containing unsupported constructs.
// The kernel path supports numeric/array computation only — class allocation,
// class-instance field access and string concatenation previously produced
// silent garbage (e.g. `new Node()` → null, field writes dropped → wrong
// results) or LLVM verify crashes. Now rejected at compile time.
import env;
import pool;

class Node {
    property:
        int val = 0;
}

class Main {
    action:
        @startup void run() {
            int n = 8;
            @parallel for (int i = 0; i < n; i = i + 1) {
                // ERROR: 'new' not supported inside @parallel for body
                Node t = new Node();
                t.val = i;
            }
        }
}

int main(){ Main m = new Main() @thread; return 0; }
