// §3.7 block(n) 约束负测试：非 32 倍数 / 超 1024 / 非 @gpu for 用 block → 编译报错
// EXPECT ERROR: 'block(...)' size must be a multiple of 32
class Main {
    action:
        @startup void go() {
            long n = 128L;
            double[] out = new double[n];
            @gpu for (long i = 0L; i < n; i = i + 1L) block(100) {
                out[i] = double(i);
            }
        }
}
int main() { Main m = new Main() @thread; return 0; }
