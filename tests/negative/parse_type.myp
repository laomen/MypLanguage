// "takes exactly one argument"。合法：parseInt("123")/parseLong("9")/parseIntOpt
// (s)（返回 (int,bool) 元组）。
import env;

class T2 {
    action:
        @constructor T2() {
            int a = parseInt(123);
        }
}
