// （"constant expression type mismatch: got type 'ptr' but expected 'i32'"，
// 非干净诊断）。
class T {
    action:
        void takeInt(int v) { }
        void takeStr(string v) { }
        @constructor T() {
            takeInt("hello");
        }
}
int main(){return 0;}
