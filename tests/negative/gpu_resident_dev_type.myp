// BUG-109 负向：@gpu for resident(arr = dev) 子句 device 指针须 long 漏校验。
// 镜像 C++ visitGpuForStmt "resident device-pointer variable 'X' must be 'long'"。
// EXPECT ERROR: resident device-pointer variable 'da' must be 'long'
import env;
class T2 {
    action:
        @constructor T2() {
            float[] a = new float[64];
            int da = 5;
            @gpu for (long k = 0L; k < 10L; k = k + 1L) resident(a = da) {
                a[k] = a[k] + 1.0f;
            }
            Console.writeString("A\n");
        }
}
int main(){T2 t=new T2();return 0;}
