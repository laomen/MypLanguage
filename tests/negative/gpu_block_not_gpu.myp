// §3.7 block(n) 约束负测试：非 @gpu for 用 block(...) → 编译报错
// EXPECT ERROR: 'block(...)' is only valid on '@gpu for'
class Main {
    action:
        @startup void go() {
            long n = 128L;
            long s = 0L;
            for (long i = 0L; i < n; i = i + 1L) block(128) {
                s = s + i;
            }
        }
}
int main() { Main m = new Main() @thread; return 0; }
