// must have integer type" 崩。C++ visitThrowStmt 报
// "throw requires a string or class instance, got 'byte'"。
// 合法：throw "msg" / throw e（类实例）/ catch 内 throw;（见 throw_rethrow_ok
// 正向侧）。
import env;

class T2 {
    action:
        @constructor T2() {
            throw 5;
        }
}
