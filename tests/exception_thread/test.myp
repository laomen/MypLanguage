// @thread 线程内异常：子线程 handler 栈独立，线程内 try/catch 捕获
// 确定性：Worker 直接在 main 里 spawn → 句柄进 main 的 threadHandles_，
// main 收尾 stop+join 等待 Worker 完整跑完 startup（输出不再竞态）。
import env;

class Worker {
    action:
        @startup void run() {
            try {
                __myp_throw("worker_err");
            } catch (e) {
                Console.writeString("thr_caught=");
                Console.writeString(e);
                Console.writeString("\n");
            }
            Console.writeString("thr_done\n");
        }
}

int main() {
    Worker w = new Worker() @thread;
    return 0;
}
