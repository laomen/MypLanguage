// @startup = 启动信号（@thread 线程入口）；构造器 = 初始化（new 时自动调用）
// 验证: 构造器在 new 时同步调用；@startup 只在 @thread 实例的线程启动时执行
import env;

class Worker {
    action:
        @constructor
        void Worker() {
            Console.writeString("worker_ctor\n");
        }
        @startup void run() {           // 启动信号：线程入口
            Console.writeString("worker_startup\n");
        }
}

class Plain {
    action:
        @constructor
        void Plain() {
            Console.writeString("plain_ctor\n");
        }
}

int main() {
    Plain p = new Plain();              // 非 @thread：仅构造器
    Worker w = new Worker() @thread;    // @thread：构造器 + @startup 线程入口
    return 0;
}

