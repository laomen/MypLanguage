// 数组下标窄整数符号扩展 bug 回归测试
//
// 背景：`cnt[msg[i]]` 中 msg[i] 是 uint8（i8）。生成数组下标 GEP 时若把 i8 索引
// 直接塞给 LLVM GEP，会被**符号扩展**——字节值 >=128（如 190=0xBE 作为 i8=-66）
// 变成负下标 → 计数丢失 + 越界写（段错误）。huffman 基准暴露此 bug。
// 本测试覆盖：uint8[]（i8）、uint16[]（i16）作读+写下标 + int 控制组。
import env;

class Main {
    action:
        @startup void run() {
            // 用例1：uint8[]（i8）元素作读+写下标，值 >=128
            uint8[] msg = new uint8[6];
            msg[0] = 59u; msg[1] = 190u; msg[2] = 128u;
            msg[3] = 255u; msg[4] = 7u;  msg[5] = 200u;
            int[] cnt = new int[256];
            int i = 0;
            while (i < 6) {
                cnt[msg[i]] = cnt[msg[i]] + 1;
                i = i + 1;
            }
            Console.writeString("u8:");
            Console.write(cnt[7]); Console.writeString(",");
            Console.write(cnt[59]); Console.writeString(",");
            Console.write(cnt[128]); Console.writeString(",");
            Console.write(cnt[190]); Console.writeString(",");
            Console.write(cnt[200]); Console.writeString(",");
            Console.write(cnt[255]); Console.writeString("\n");

            // 用例2：uint16[]（i16）元素作下标，值 > 32767
            uint16[] h = new uint16[3];
            h[0] = 40000u; h[1] = 5000u; h[2] = 65000u;
            int[] cnth = new int[65536];
            i = 0;
            while (i < 3) {
                cnth[h[i]] = cnth[h[i]] + 1;
                i = i + 1;
            }
            Console.writeString("u16:");
            Console.write(cnth[40000]); Console.writeString(",");
            Console.write(cnth[5000]); Console.writeString(",");
            Console.write(cnth[65000]); Console.writeString("\n");

            // 用例3：int 下标控制组（回归）
            int[] a = new int[10];
            a[5] = 42;
            Console.writeString("int:");
            Console.write(a[5]); Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
