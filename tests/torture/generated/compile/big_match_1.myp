            }
            return r;
        }
        @constructor T1() {
            int acc = 0;
            E1 e0 = E1.V0;
            E1 e1 = E1.V59;
            acc = acc + this.pick(e0) + this.pick(e1);
        }
}
int main() { T1 t = new T1(); return 0; }
