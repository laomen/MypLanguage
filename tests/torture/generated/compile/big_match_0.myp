                E0.V39 => { r = 118; }
            }
            return r;
        }
        @constructor T0() {
            int acc = 0;
            E0 e0 = E0.V0;
            E0 e1 = E0.V39;
            acc = acc + this.pick(e0) + this.pick(e1);
        }
}
int main() { T0 t = new T0(); return 0; }
