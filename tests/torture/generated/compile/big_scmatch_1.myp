import env;
// big_scmatch_1 : 大整型字面量 match 分发（60 臂 + _ 通配）
class T1 {
    action:
        int pick(int v) {
            int r = 0;
            match (v) {
                0 => { r = 1; }
                1 => { r = 4; }
                2 => { r = 7; }
                3 => { r = 10; }
                4 => { r = 13; }
                5 => { r = 16; }
                6 => { r = 19; }
                7 => { r = 22; }
                8 => { r = 25; }
                9 => { r = 28; }
                10 => { r = 31; }
                11 => { r = 34; }
                12 => { r = 37; }
                13 => { r = 40; }
                14 => { r = 43; }
                15 => { r = 46; }
                16 => { r = 49; }
                17 => { r = 52; }
                18 => { r = 55; }
                19 => { r = 58; }
                20 => { r = 61; }
                21 => { r = 64; }
                22 => { r = 67; }
                23 => { r = 70; }
                24 => { r = 73; }
                25 => { r = 76; }
                26 => { r = 79; }
                27 => { r = 82; }
                28 => { r = 85; }
                29 => { r = 88; }
                30 => { r = 91; }
                31 => { r = 94; }
                32 => { r = 97; }
                33 => { r = 100; }
                34 => { r = 103; }
                35 => { r = 106; }
                36 => { r = 109; }
                37 => { r = 112; }
                38 => { r = 115; }
                39 => { r = 118; }
                40 => { r = 121; }
                41 => { r = 124; }
                42 => { r = 127; }
                43 => { r = 130; }
                44 => { r = 133; }
                45 => { r = 136; }
                46 => { r = 139; }
                47 => { r = 142; }
                48 => { r = 145; }
                49 => { r = 148; }
                50 => { r = 151; }
                51 => { r = 154; }
                52 => { r = 157; }
                53 => { r = 160; }
                54 => { r = 163; }
                55 => { r = 166; }
                56 => { r = 169; }
                57 => { r = 172; }
                58 => { r = 175; }
                59 => { r = 178; }
                _ => { r = -1; }
            }
            return r;
        }
        @constructor T1() {
            int acc = 0;
            acc = acc + this.pick(0) + this.pick(59) + this.pick(-7);
        }
}
int main() { T1 t = new T1(); return 0; }
