import env;
// deep_nest_5 : 深度 20 表达式嵌套（仅编译压力）
class T5 {
    static:
        long f(long v) {
            long e = v; e = (e + 0) * 2 - (e % 3); e = (e + 1) * 2 - (e % 4); e = (e + 2) * 2 - (e % 5); e = (e + 3) * 2 - (e % 6); e = (e + 4) * 2 - (e % 7); e = (e + 5) * 2 - (e % 8); e = (e + 6) * 2 - (e % 9); e = (e + 0) * 2 - (e % 10); e = (e + 1) * 2 - (e % 11); e = (e + 2) * 2 - (e % 12); e = (e + 3) * 2 - (e % 13); e = (e + 4) * 2 - (e % 3); e = (e + 5) * 2 - (e % 4); e = (e + 6) * 2 - (e % 5); e = (e + 0) * 2 - (e % 6); e = (e + 1) * 2 - (e % 7); e = (e + 2) * 2 - (e % 8); e = (e + 3) * 2 - (e % 9); e = (e + 4) * 2 - (e % 10); e = (e + 5) * 2 - (e % 11); return e;
        }
    action:
        @constructor T5() { long r = T5.f(1); }
}
int main() { T5 t = new T5(); return 0; }
