import env;
// str_3 : 字符串操作自验证（seed=410）
class T3 {
    action:
        @constructor T3() {
            string s = "torture-3-" + 3 + "-suffix";
            if (s + "" != s) { Console.writeString("FAIL concat\n"); return; }
            long acc = 0;
            for (int k = 0; k < 100; k = k + 1) acc = acc + myp_strlen("x" + k);
            Console.writeString("PASS str_3 (len=" + myp_strlen(s) + " acc=" + acc + ")\n");
        }
}
ffi int myp_strlen(string s);
int main() { T3 t = new T3(); return 0; }
