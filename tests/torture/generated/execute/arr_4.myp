import env;
// arr_4 : 数组翻转两次 = 恒等（seed=541）
class T4 {
    action:
        @constructor T4() {
            int n = 12;
            long[] a = new long[n];
            for (int k = 0; k < n; k = k + 1) a[k] = long(k * 59);
            for (int k = 0; k < n / 2; k = k + 1) {
                long t = a[k]; a[k] = a[n - 1 - k]; a[n - 1 - k] = t;
            }
            for (int k = 0; k < n / 2; k = k + 1) {
                long t = a[k]; a[k] = a[n - 1 - k]; a[n - 1 - k] = t;
            }
            int bad = 0;
            for (int k = 0; k < n; k = k + 1) if (a[k] != long(k * 59)) bad = 1;
            if (bad != 0) { Console.writeString("FAIL arr\n"); return; }
            Console.writeString("PASS arr_4 (n=" + n + ")\n");
        }
}
int main() { T4 t = new T4(); return 0; }
