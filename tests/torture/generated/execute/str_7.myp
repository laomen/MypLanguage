import env;
// str_7 : 字符串操作自验证（seed=934）
class T7 {
    action:
        @constructor T7() {
            string s = "torture-7-" + 7 + "-suffix";
            if (s + "" != s) { Console.writeString("FAIL concat\n"); return; }
            long acc = 0;
            for (int k = 0; k < 100; k = k + 1) acc = acc + myp_strlen("x" + k);
            Console.writeString("PASS str_7 (len=" + myp_strlen(s) + " acc=" + acc + ")\n");
        }
}
ffi int myp_strlen(string s);
int main() { T7 t = new T7(); return 0; }
