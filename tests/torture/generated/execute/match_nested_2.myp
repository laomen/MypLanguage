import env;
// match_nested_2 : 嵌套 match 自验证
class T2 {
    action:
        string pick(int a, int b) {
            string r = "";
            match (a) {
                0 => {
                    match (b) {
                        0 => { r = "00"; }
                        1 => { r = "01"; }
                        _ => { r = "0x"; }
                    }
                }
                1 => {
                    match (b) {
                        0 => { r = "10"; }
                        _ => { r = "1x"; }
                    }
                }
                _ => { r = "o"; }
            }
            return r;
        }
        @constructor T2() {
            int ok = 0;
            ok = ok + (this.pick(0, 0) == "00" ? 1 : 0);
            ok = ok + (this.pick(0, 1) == "01" ? 1 : 0);
            ok = ok + (this.pick(0, 9) == "0x" ? 1 : 0);
            ok = ok + (this.pick(1, 0) == "10" ? 1 : 0);
            ok = ok + (this.pick(1, 9) == "1x" ? 1 : 0);
            ok = ok + (this.pick(7, 7) == "o" ? 1 : 0);
            if (ok != 6) { Console.writeString("FAIL match_nested_2 ok=" + ok + "\n"); return; }
            Console.writeString("PASS match_nested_2\n");
        }
}
int main() { T2 t = new T2(); return 0; }
