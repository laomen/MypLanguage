import env;
// arr_0 : 数组翻转两次 = 恒等（seed=17）
class T0 {
    action:
        @constructor T0() {
            int n = 8;
            long[] a = new long[n];
            for (int k = 0; k < n; k = k + 1) a[k] = long(k * 20);
            for (int k = 0; k < n / 2; k = k + 1) {
                long t = a[k]; a[k] = a[n - 1 - k]; a[n - 1 - k] = t;
            }
            for (int k = 0; k < n / 2; k = k + 1) {
                long t = a[k]; a[k] = a[n - 1 - k]; a[n - 1 - k] = t;
            }
            int bad = 0;
            for (int k = 0; k < n; k = k + 1) if (a[k] != long(k * 20)) bad = 1;
            if (bad != 0) { Console.writeString("FAIL arr\n"); return; }
            Console.writeString("PASS arr_0 (n=" + n + ")\n");
        }
}
int main() { T0 t = new T0(); return 0; }
