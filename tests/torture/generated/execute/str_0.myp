import env;
// str_0 : 字符串操作自验证（seed=17）
class T0 {
    action:
        @constructor T0() {
            string s = "torture-0-" + 0 + "-suffix";
            if (s + "" != s) { Console.writeString("FAIL concat\n"); return; }
            long acc = 0;
            for (int k = 0; k < 100; k = k + 1) acc = acc + myp_strlen("x" + k);
            Console.writeString("PASS str_0 (len=" + myp_strlen(s) + " acc=" + acc + ")\n");
        }
}
ffi int myp_strlen(string s);
int main() { T0 t = new T0(); return 0; }
