import env;
// arr_7 : 数组翻转两次 = 恒等（seed=934）
class T7 {
    action:
        @constructor T7() {
            int n = 15;
            long[] a = new long[n];
            for (int k = 0; k < n; k = k + 1) a[k] = long(k * 64);
            for (int k = 0; k < n / 2; k = k + 1) {
                long t = a[k]; a[k] = a[n - 1 - k]; a[n - 1 - k] = t;
            }
            for (int k = 0; k < n / 2; k = k + 1) {
                long t = a[k]; a[k] = a[n - 1 - k]; a[n - 1 - k] = t;
            }
            int bad = 0;
            for (int k = 0; k < n; k = k + 1) if (a[k] != long(k * 64)) bad = 1;
            if (bad != 0) { Console.writeString("FAIL arr\n"); return; }
            Console.writeString("PASS arr_7 (n=" + n + ")\n");
        }
}
int main() { T7 t = new T7(); return 0; }
