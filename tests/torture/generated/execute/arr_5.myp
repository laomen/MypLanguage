import env;
// arr_5 : 数组翻转两次 = 恒等（seed=672）
class T5 {
    action:
        @constructor T5() {
            int n = 13;
            long[] a = new long[n];
            for (int k = 0; k < n; k = k + 1) a[k] = long(k * 93);
            for (int k = 0; k < n / 2; k = k + 1) {
                long t = a[k]; a[k] = a[n - 1 - k]; a[n - 1 - k] = t;
            }
            for (int k = 0; k < n / 2; k = k + 1) {
                long t = a[k]; a[k] = a[n - 1 - k]; a[n - 1 - k] = t;
            }
            int bad = 0;
            for (int k = 0; k < n; k = k + 1) if (a[k] != long(k * 93)) bad = 1;
            if (bad != 0) { Console.writeString("FAIL arr\n"); return; }
            Console.writeString("PASS arr_5 (n=" + n + ")\n");
        }
}
int main() { T5 t = new T5(); return 0; }
