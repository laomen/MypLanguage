import env;
// str_4 : 字符串操作自验证（seed=541）
class T4 {
    action:
        @constructor T4() {
            string s = "torture-4-" + 4 + "-suffix";
            if (s + "" != s) { Console.writeString("FAIL concat\n"); return; }
            long acc = 0;
            for (int k = 0; k < 100; k = k + 1) acc = acc + myp_strlen("x" + k);
            Console.writeString("PASS str_4 (len=" + myp_strlen(s) + " acc=" + acc + ")\n");
        }
}
ffi int myp_strlen(string s);
int main() { T4 t = new T4(); return 0; }
