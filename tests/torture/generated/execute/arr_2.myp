import env;
// arr_2 : 数组翻转两次 = 恒等（seed=279）
class T2 {
    action:
        @constructor T2() {
            int n = 10;
            long[] a = new long[n];
            for (int k = 0; k < n; k = k + 1) a[k] = long(k * 88);
            for (int k = 0; k < n / 2; k = k + 1) {
                long t = a[k]; a[k] = a[n - 1 - k]; a[n - 1 - k] = t;
            }
            for (int k = 0; k < n / 2; k = k + 1) {
                long t = a[k]; a[k] = a[n - 1 - k]; a[n - 1 - k] = t;
            }
            int bad = 0;
            for (int k = 0; k < n; k = k + 1) if (a[k] != long(k * 88)) bad = 1;
            if (bad != 0) { Console.writeString("FAIL arr\n"); return; }
            Console.writeString("PASS arr_2 (n=" + n + ")\n");
        }
}
int main() { T2 t = new T2(); return 0; }
