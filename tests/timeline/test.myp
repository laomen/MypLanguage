// timeline: Timeline.sleep/now/elapsed
import env;
import timeline;

class Main {
    action:
        @startup void run() {
            Timeline tl;
            long t0 = tl.now();
            tl.sleep(5);
            long t1 = tl.now();
            long dt = tl.elapsed(t0);
            // dt varies with sleep precision (5 or 6) — assert ranges, not exact value
            Console.writeString("ok="); Console.writeBool(dt > 0L);
            Console.writeString(" longEnough="); Console.writeBool(dt >= 5L);
            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
