// @parallel for — 数据并行测试（含多线程启动检测）
import env;
import atomic;
import math;
import pool;

class Main {
    action:
        @startup void run() {
            int n = 1000;
            double[100] tally;
            @parallel for (int i = 0; i < n; i = i + 1) {
                double val = Math.sin(i * 0.1) + 1.0;
                int idx = i % 100;
                Atomic.addDouble(tally, idx, val);
            }
            double sum = 0.0;
            for (int j = 0; j < 100; j = j + 1)
                sum = sum + tally[j];
            Console.writeString("parallel_sum=");
            Console.writeFloat(sum);
            Console.writeString("\n");

            // ===== 多线程启动检测 =====
            // 每个迭代把执行它的 worker 索引写入独立槽位（迭代互斥，无竞争），
            // 循环结束后统计不同 worker 数 —— >= 2 说明 @parallel for 真正并行执行
            // （多核机器上稳定为 YES；单核机器池仅 1 线程则无法并行）
            int[4096] tidSlot;
            @parallel for (int i = 0; i < 4096; i = i + 1) {
                tidSlot[i] = Parallel.workerId();
            }
            int distinct = 0;
            for (int i = 0; i < 4096; i = i + 1) {
                int tid = tidSlot[i];
                int already = 0;
                for (int k = 0; k < i; k = k + 1) {
                    if (tidSlot[k] == tid) { already = 1; break; }
                }
                if (already == 0) distinct = distinct + 1;
            }
            if (distinct >= 2) {
                Console.writeString("multithread=YES\n");
            } else {
                Console.writeString("multithread=NO\n");
            }

            // 验证变量捕获（外层变量）
            double scale = 2.0;
            double[10] capTest;
            @parallel for (int i = 0; i < 10; i = i + 1) {
                Atomic.addDouble(capTest, i, i * scale);
            }
            double capSum = 0.0;
            for (int j = 0; j < 10; j = j + 1)
                capSum = capSum + capTest[j];
            Console.writeString("capture_sum=");
            Console.writeFloat(capSum);
            Console.writeString("\n");
        }
}

int main() {
    Main m = new Main() @thread;
    return 0;
}
