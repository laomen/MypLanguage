// for_in: §四-2 集合迭代（for-in）回归测试
// 覆盖：固定数组 / 显式类型 / 集合类(ArrayList size+get 协议) / slice /
//       range(右开) / 无括号形式 / break+continue / 嵌套 / 类元素 ARC 零泄漏
import env;
import collections;

import memory;

class Node {
    action:
    @constructor Node(int v) {
        val = v;
    }
    int getVal() {
        return val;
    }
    void setVal(int v) {
        val = v;
    }
    property: int val = 0;
}

class Main {
    action:
    @startup void run() {
        Console.writeString("[for_in]\n");
        // 1) 固定数组 for-in（无类型）
        int[ 4 ] arr;
        arr [ 0 ] = 1;
        arr [ 1 ] = 2;
        arr [ 2 ] = 3;
        arr [ 3 ] = 4;
        int sum = 0;
        for (x in arr) {
            sum += x;
        }
        Console.writeString("arr_sum=");
        Console.write(sum);
        Console.writeString(" ");
        // 2) 显式类型元素
        for (int x in arr) Console.writeString("" + x);
        Console.writeString(" ");
        // 3) 集合类 ArrayList（size/get 协议）
        ArrayList < int > list = new ArrayList < int > ();
        list.add(10);
        list.add(20);
        list.add(30);
        for (x in list) {
            Console.writeString("" + x);
        }
        Console.writeString(" ");
        // 4) 无括号 for x in ...
        for (x in arr) {
            Console.writeString("" + x);
        }
        Console.writeString(" ");
        // 5) range（右开：0..5 → 0,1,2,3,4）
        for (i in 0 .. 5) {
            Console.writeString("" + i);
        }
        Console.writeString(" ");
        // 6) slice
        slice < int > sl = new slice < int > (3);
        sl [ 0 ] = 7;
        sl [ 1 ] = 8;
        sl [ 2 ] = 9;
        for (x in sl) {
            Console.writeString("" + x);
        }
        Console.writeString(" ");
        // 7) break + continue
        for (x in arr) {
            if (x == 2) {
                continue;
            }
            if (x == 4) {
                break;
            }
            Console.writeString("" + x);
        }
        Console.writeString(" ");
        // 8) 嵌套 range
        for (i in 0 .. 2) {
            for (j in 0 .. 2) {
                Console.writeString("" + (i * 3 + j));
            }
        }
        Console.writeString("\n");
        // 9) 类元素 for-in：ARC 零泄漏（循环变量作用域末释放）
        Node [ 3 ] nodes;
        nodes [ 0 ] = new Node(10);
        nodes [ 1 ] = new Node(20);
        nodes [ 2 ] = new Node(30);
        long b = Memory.liveObjectCount();
        {
            for (n in nodes) Console.writeString("" + n.getVal());
        }
        long a = Memory.liveObjectCount();
        Console.writeString(" arr_leak=" + (a - b));
        Console.writeString(" ");
        // 10) 集合类元素 for-in：借用 retain → 释放
        ArrayList < Node > nl = new ArrayList < Node > ();
        nl.add(new Node(100));
        nl.add(new Node(200));
        long c = Memory.liveObjectCount();
        {
            for (n in nl) Console.writeString("" + n.getVal());
        }
        long d = Memory.liveObjectCount();
        Console.writeString(" list_leak=" + (d - c));
        Console.writeString(" ");
        // 11) 字符串集合
        ArrayList < string > strs = new ArrayList < string > ();
        strs.add("alpha");
        strs.add("beta");
        for (s in strs) {
            Console.writeString(s);
            Console.writeString(",");
        }
        Console.writeString("\n");
        // 12) lambda 捕获固定数组 + lambda 内 for-in（按值深拷贝捕获）
        (int) -> int sumArr = (int mul) => {
            int s = 0;
            for (x in arr) {
                s += x * mul;
            }
            return s;
        }
        ;
        Console.writeString("caparr=");
        Console.write(sumArr(10));
        Console.writeString("\n");
    }
}
int main() {
    Main m = new Main()
    @thread;
    return 0;
}
