// rtti: 运行时类型信息（§五-4）Rtti.typeId / typeOf / sameType
// 覆盖：不同类 → 不同 type_id/类名；同类实例 id 相同；sameType 正/反；null → 0/""
import env;
import rtti;

class Tank {
    action:
        void setLabel(string v) { label = v; }
        void setHp(int v) { hp = v; }
    property:
        string label;
        int hp;
}

class Soldier {
    action:
        void setName(string v) { name = v; }
    property:
        string name;
}

class Sniper {
    action:
        void setRange(int v) { range = v; }
    property:
        int range;
}

int pmRun() {
    Tank t = new Tank();
    t.setLabel("T-90"); t.setHp(100);
    Tank t2 = new Tank();
    Soldier s = new Soldier();
    s.setName("John");
    Sniper sn = new Sniper();
    sn.setRange(800);

    // typeOf → 类名
    string n1 = Rtti.typeOf<Tank>(t);
    string n2 = Rtti.typeOf<Soldier>(s);
    string n3 = Rtti.typeOf<Sniper>(sn);
    Console.writeString("typeOf: " + n1 + " / " + n2 + " / " + n3);
    Console.writeString("\n");

    // typeId：同类恒定、跨类不同
    int id1 = Rtti.typeId<Tank>(t);
    int id2 = Rtti.typeId<Tank>(t2);
    int id3 = Rtti.typeId<Soldier>(s);
    int id4 = Rtti.typeId<Sniper>(sn);
    Console.writeString("typeId: t=" + id1 + " t2=" + id2 + " s=" + id3 + " sn=" + id4);
    Console.writeString("\n");

    // sameType 正 / 反
    Console.writeString("same(t,t2)=" + Rtti.sameType<Tank, Tank>(t, t2));
    Console.writeString(" same(t,s)=" + Rtti.sameType<Tank, Soldier>(t, s));
    Console.writeString(" same(s,sn)=" + Rtti.sameType<Soldier, Sniper>(s, sn));
    Console.writeString("\n");

    // null → typeId 0 / typeOf ""
    Tank nul = null;
    Console.writeString("null: id=" + Rtti.typeId<Tank>(nul) + " name='" + Rtti.typeOf<Tank>(nul) + "'");
    Console.writeString("\n");
    return 0;
}

int main() { int c = pmRun(); return c; }
