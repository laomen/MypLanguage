// 并行计数器 — 验证 @thread 多线程
// Worker A 和 Worker B 在各自线程中独立计数
// 输出交替出现证明真正的并发执行

import env;
import time;

class CounterA {
    action:
        @startup void run() {
            int i=0;
            while(i<10){
                Console.writeString("[A] count=");
                Console.write(i);
                Time.sleep(10);
                i=i+1;
            }
            Console.writeString("[A] DONE\n");
            done();
        }
    event:
        done();
}

class CounterB {
    action:
        @startup void run() {
            int i=0;
            while(i<10){
                Console.writeString("  [B] count=");
                Console.write(i);
                Time.sleep(10);
                i=i+1;
            }
            Console.writeString("  [B] DONE\n");
            done();
        }
    event:
        done();
}

class Main {
    action:
        @startup void run() {
            Console.writeString("[Main] Starting two threads...\n");
            CounterA a = new CounterA() @thread;
            CounterB b = new CounterB() @thread;

            // 等待线程完成（给线程时间执行）
            Time.sleep(300);
            Console.writeString("[Main] Both threads completed\n");
        }
}

int main() { Main m = new Main(); return 0; }
