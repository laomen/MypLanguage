// 线程池演示 — @threadpool 并行工作
// 创建 4 个工作线程，每个独立计数，证明线程池并发

import env;
import time;

class PoolWorker {
    action:
        @startup void run() {
            // 每个 worker 独立计数
            int i=1;
            while(i<=5){
                Console.writeString("  [pool#");
                Console.write(id);
                Console.writeString("] step ");
                Console.write(i);
                Console.writeString("\n");
                Time.sleep(30);
                i=i+1;
            }
            Console.writeString("  [pool#");
            Console.write(id);
            Console.writeString("] DONE\n");
            done();
        }
    event:
        done();
    property:
        int id=0;
}

class Main {
    action:
        @startup void run() {
            Console.writeString("[Main] Starting thread pool...\n");
            // 创建线程池（4个线程），每个独立运行
            PoolWorker[4] pool @threadpool;

            // 给线程一些时间运行
            Time.sleep(500);
            Console.writeString("[Main] Pool done\n");
        }
}

int main(){Main m=new Main();return 0;}
